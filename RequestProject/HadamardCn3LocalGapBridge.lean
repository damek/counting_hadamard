    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (i : Fin n) :
    triangleEdge12 τ hτ ∈ Cn3Torus.edgesIncident n i ↔
      i = triangleV1 τ ∨ i = triangleV2 τ := by
  simpa [triangleEdge12, triangleV1, triangleV2, eq_comm, or_left_comm, or_comm] using
    (Cn3Torus.mem_edgesIncident_iff (i := i) (e := triangleEdge12 τ hτ))

