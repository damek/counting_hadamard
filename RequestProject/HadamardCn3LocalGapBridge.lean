/-- Uniform weighted cubic `L²` bound against the quartic exponential core
weight. -/
lemma cubicT_sq_quarticWeight_core_bound_uniform :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, ∀ t : ℝ, 1 ≤ t →
        (dim n : ℝ) / t ≤ Cn3Torus.delta ^ (2 : Nat) →
