                  * ((∑ ξ : TriangleChoice n, s ξ)
                      * ((∑ ξ : TriangleChoice n, s ξ)
                          * ∑ ξ : TriangleChoice n, s ξ)) := hprod4

lemma cubicT_fourth_full_gaussian_integrable
    (n : ℕ) (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat)
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  classical
  let Q : Finset (TriangleQuadruple n) := Finset.univ
  have hquad_int :
      ∀ q ∈ Q,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          triangleChoiceMonomial (triangleQuad1 q) mu
            * triangleChoiceMonomial (triangleQuad2 q) mu
            * triangleChoiceMonomial (triangleQuad3 q) mu
            * triangleChoiceMonomial (triangleQuad4 q) mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
    intro q hq
    exact triangleChoiceQuadruple_integrable q t ht
  have hsum_int :
      MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
        Finset.sum Q (fun q =>
          triangleChoiceMonomial (triangleQuad1 q) mu
            * triangleChoiceMonomial (triangleQuad2 q) mu
            * triangleChoiceMonomial (triangleQuad3 q) mu
            * triangleChoiceMonomial (triangleQuad4 q) mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    exact MeasureTheory.integrable_finset_sum Q (fun q hq => hquad_int q hq)
  refine hsum_int.congr ?_
  exact Filter.Eventually.of_forall (fun mu => by
    let e : ℝ := Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
    have hsum :
        Finset.sum Q (fun q =>
          triangleChoiceMonomial (triangleQuad1 q) mu
            * triangleChoiceMonomial (triangleQuad2 q) mu
            * triangleChoiceMonomial (triangleQuad3 q) mu
            * triangleChoiceMonomial (triangleQuad4 q) mu)
          = (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat) := by
      simpa [Q] using (cubicT_pow_four_eq_sum_triangleQuadruples (n := n) (mu := mu)).symm
    have hsum_mul :
        Finset.sum Q (fun q =>
          triangleChoiceMonomial (triangleQuad1 q) mu
            * triangleChoiceMonomial (triangleQuad2 q) mu
            * triangleChoiceMonomial (triangleQuad3 q) mu
            * triangleChoiceMonomial (triangleQuad4 q) mu
            * e)
          = (Finset.sum Q (fun q =>
              triangleChoiceMonomial (triangleQuad1 q) mu
                * triangleChoiceMonomial (triangleQuad2 q) mu
                * triangleChoiceMonomial (triangleQuad3 q) mu
                * triangleChoiceMonomial (triangleQuad4 q) mu)) * e := by
      rw [Finset.sum_mul]
    calc
      Finset.sum Q (fun q =>
          triangleChoiceMonomial (triangleQuad1 q) mu
            * triangleChoiceMonomial (triangleQuad2 q) mu
            * triangleChoiceMonomial (triangleQuad3 q) mu
            * triangleChoiceMonomial (triangleQuad4 q) mu
            * e)
        = (Finset.sum Q (fun q =>
            triangleChoiceMonomial (triangleQuad1 q) mu
              * triangleChoiceMonomial (triangleQuad2 q) mu
              * triangleChoiceMonomial (triangleQuad3 q) mu
              * triangleChoiceMonomial (triangleQuad4 q) mu)) * e := hsum_mul
      _ = (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat) * e := by rw [hsum]
      _ = (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat)
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by rfl)

