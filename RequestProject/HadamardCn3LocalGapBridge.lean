    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    quinticMomentTupleMultiplicity
        (quinticThreeOneOneTuple
          (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ))
      = quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge12 := by
  funext x
  by_cases hx12 : x = triangleEdge12 τ hτ
  · subst x
    rw [quinticThreeOneOneTuple_multiplicity_e]
    · exact (quinticTriangleRepeatMultiplicity_edge12_self τ hτ).symm
    · exact triangleEdge12_ne_13 τ hτ
    · exact triangleEdge12_ne_23 τ hτ
  · by_cases hx13 : x = triangleEdge13 τ hτ
    · subst x
      rw [quinticThreeOneOneTuple_multiplicity_u]
      · exact (quinticTriangleRepeatMultiplicity_edge12_other13 τ hτ).symm
      · exact triangleEdge12_ne_13 τ hτ
      · exact triangleEdge13_ne_23 τ hτ
    · by_cases hx23 : x = triangleEdge23 τ hτ
      · subst x
        rw [quinticThreeOneOneTuple_multiplicity_v]
        · exact (quinticTriangleRepeatMultiplicity_edge12_other23 τ hτ).symm
        · exact triangleEdge12_ne_23 τ hτ
        · exact triangleEdge13_ne_23 τ hτ
      · have hxnotq :
            x ∉ quinticMomentTupleSupport
              (quinticThreeOneOneTuple
                (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)) := by
          rw [quinticThreeOneOneTuple_support
            (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)]
          · simp [hx12, hx13, hx23]
          · exact triangleEdge12_ne_13 τ hτ
          · exact triangleEdge12_ne_23 τ hτ
          · exact triangleEdge13_ne_23 τ hτ
        have hxnotr : x ∉ triangleEdgeSet τ hτ := by
          simp [triangleEdgeSet, hx12, hx13, hx23]
        have hx0 :
            quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge12 x = 0 := by
          simp [quinticTriangleRepeatMultiplicity, edgePowMultiplicity, hx12, hx13, hx23]
        rw [quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support
            (quinticThreeOneOneTuple
              (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)) hxnotq,
          hx0]

