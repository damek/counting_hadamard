private lemma quinticThreeOneOneTuple_support {n : ℕ}
    (e u v : Cn3Torus.Edge n) (heu : e ≠ u) (hev : e ≠ v) (huv : u ≠ v) :
    quinticMomentTupleSupport (quinticThreeOneOneTuple e u v) = ({e, u, v} : Finset (Cn3Torus.Edge n)) := by
