              * triangleChoiceMonomial (triangleQuad4 q) mu)
            = (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat) := by
        simpa [Q] using (cubicT_pow_four_eq_sum_triangleQuadruples (n := n) (mu := mu)).symm
      have hsum_mul :
          Finset.sum Q (fun q =>
            triangleChoiceMonomial (triangleQuad1 q) mu
              * triangleChoiceMonomial (triangleQuad2 q) mu
              * triangleChoiceMonomial (triangleQuad3 q) mu
              * triangleChoiceMonomial (triangleQuad4 q) mu
              * e)
            = (Finset.sum Q (fun q =>
                triangleChoiceMonomial (triangleQuad1 q) mu
                  * triangleChoiceMonomial (triangleQuad2 q) mu
                  * triangleChoiceMonomial (triangleQuad3 q) mu
                  * triangleChoiceMonomial (triangleQuad4 q) mu)) * e := by
        rw [Finset.sum_mul]
      calc
        (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat) * e
          = (Finset.sum Q (fun q =>
              triangleChoiceMonomial (triangleQuad1 q) mu
                * triangleChoiceMonomial (triangleQuad2 q) mu
                * triangleChoiceMonomial (triangleQuad3 q) mu
                * triangleChoiceMonomial (triangleQuad4 q) mu)) * e := by
                  rw [← hsum]
        _ = Finset.sum Q (fun q =>
              triangleChoiceMonomial (triangleQuad1 q) mu
                * triangleChoiceMonomial (triangleQuad2 q) mu
                * triangleChoiceMonomial (triangleQuad3 q) mu
                * triangleChoiceMonomial (triangleQuad4 q) mu
                * e) := by
                  rw [hsum_mul]
        _ = Finset.sum Q (fun q =>
              triangleChoiceMonomial (triangleQuad1 q) mu
                * triangleChoiceMonomial (triangleQuad2 q) mu
                * triangleChoiceMonomial (triangleQuad3 q) mu
                * triangleChoiceMonomial (triangleQuad4 q) mu
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
                  rfl)
  have hterm :
      ∀ q ∈ Q,
        ∫ mu : Cn3Torus.Edge n → ℝ,
            triangleChoiceMonomial (triangleQuad1 q) mu
              * triangleChoiceMonomial (triangleQuad2 q) mu
              * triangleChoiceMonomial (triangleQuad3 q) mu
              * triangleChoiceMonomial (triangleQuad4 q) mu
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
          ≤ if triangleQuadrupleEven q then M else 0 := by
    intro q hq
    by_cases heven : triangleQuadrupleEven q
    · simpa [M, heven] using triangleChoiceQuadruple_gaussian_bound_of_even q t ht heven
    · have hzero := triangleChoiceQuadruple_gaussian_zero_of_not_even q t heven
      rw [if_neg heven, hzero]
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          Finset.sum Q (fun q =>
            triangleChoiceMonomial (triangleQuad1 q) mu
              * triangleChoiceMonomial (triangleQuad2 q) mu
              * triangleChoiceMonomial (triangleQuad3 q) mu
              * triangleChoiceMonomial (triangleQuad4 q) mu
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := hrewrite
    _ = Finset.sum Q (fun q =>
          ∫ mu : Cn3Torus.Edge n → ℝ,
            triangleChoiceMonomial (triangleQuad1 q) mu
              * triangleChoiceMonomial (triangleQuad2 q) mu
              * triangleChoiceMonomial (triangleQuad3 q) mu
              * triangleChoiceMonomial (triangleQuad4 q) mu
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
            rw [MeasureTheory.integral_finset_sum Q hquad_int]
    _ ≤ Finset.sum Q (fun q => if triangleQuadrupleEven q then M else 0) := by
          refine Finset.sum_le_sum ?_
          intro q hq
          exact hterm q hq
    _ = Finset.sum (triangleEvenQuadruples n) (fun _ => M) := by
          change
            Finset.sum (Finset.univ : Finset (TriangleQuadruple n))
              (fun q => if triangleQuadrupleEven q then M else 0)
              = Finset.sum (triangleEvenQuadruples n) (fun _ => M)
          rw [triangleEvenQuadruples, Finset.sum_filter]
    _ = ((triangleEvenQuadruples n).card : ℝ) * M := by
          rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ ((7 : ℝ) * (6 : ℝ) ^ (12 : Nat) * (n : ℝ) ^ (6 : Nat)) * M := by
          have hcount_even :
              ((triangleEvenQuadruples n).card : ℝ)
                ≤ (7 * (6 : ℝ) ^ (12 : Nat)) * (n : ℝ) ^ (6 : Nat) := by
            by_cases hn0 : n = 0
            · subst hn0
              simp [triangleEvenQuadruples, TriangleQuadruple, TriangleChoice,
                triangleTriples, IsTriangleTriple]
            · exact triangleEvenQuadruples_card_le_n_six n (Nat.succ_le_of_lt (Nat.pos_of_ne_zero hn0))
          refine mul_le_mul_of_nonneg_right hcount_even ?_
          have henv_one : 1 ≤ gaussianEvenMomentEnvelope 6 := gaussianEvenMomentEnvelope_one_le 6
          have hgauss_nonneg : 0 ≤ gaussianF (dim n) t := by
            exact Real.rpow_nonneg (by positivity) _
          positivity
    _ = (((7 : ℝ) * (6 : ℝ) ^ (12 : Nat) * gaussianEvenMomentEnvelope 6 ^ 6)
            * (n : ℝ) ^ (6 : Nat) / t ^ (6 : Nat))
          * gaussianF (dim n) t := by
            unfold M
            ring

private theorem cubic_core_fourth_moment_bound_uniform :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, ∀ t : ℝ, 1 ≤ t →
        ∫ mu : Cn3Torus.Edge n → ℝ,
            (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
          ≤ (C * (n : ℝ) ^ (6 : Nat) / t ^ (6 : Nat)) * gaussianF (dim n) t := by
  refine ⟨(7 : ℝ) * (6 : ℝ) ^ (12 : Nat) * gaussianEvenMomentEnvelope 6 ^ 6, ?_, ?_⟩
  · have henv_one : 1 ≤ gaussianEvenMomentEnvelope 6 := gaussianEvenMomentEnvelope_one_le 6
    positivity
  · intro n t ht
    simpa using cubicT_fourth_full_gaussian_bound_explicit n t ht

private theorem cubic_core_fourth_moment_bound_core :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, ∀ t : ℝ, 1 ≤ t →
        ∫ mu in edgeCoreRegion n t,
            (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
          ≤ (C * (n : ℝ) ^ (6 : Nat) / t ^ (6 : Nat)) * gaussianF (dim n) t := by
  rcases cubic_core_fourth_moment_bound_uniform with ⟨C, hCpos, hC⟩
  refine ⟨C, hCpos, ?_⟩
  intro n t ht
  have ht_pos : 0 < t := by linarith
  let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat)
      * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  have hf_nonneg :
      ∀ mu : Cn3Torus.Edge n → ℝ, 0 ≤ f mu := by
    intro mu
    dsimp [f]
    positivity
  have hf_int : MeasureTheory.Integrable f :=
    cubicT_fourth_full_gaussian_integrable n t ht_pos
  have hA_meas : MeasurableSet (edgeCoreRegion n t) := measurableSet_edgeCoreRegion n t
  have hind_int : MeasureTheory.Integrable (Set.indicator (edgeCoreRegion n t) f) := by
    exact hf_int.indicator hA_meas
  have hmono_ae :
      ∀ᵐ mu : Cn3Torus.Edge n → ℝ ∂MeasureTheory.volume,
        Set.indicator (edgeCoreRegion n t) f mu ≤ f mu := by
    exact Filter.Eventually.of_forall (fun mu => by
      by_cases hmu : mu ∈ edgeCoreRegion n t
      · simp [Set.indicator, hmu]
      · simp [Set.indicator, hmu, hf_nonneg mu])
  have hset_le_full :
      ∫ mu in edgeCoreRegion n t, f mu ≤ ∫ mu : Cn3Torus.Edge n → ℝ, f mu := by
    have hmono' := MeasureTheory.integral_mono_ae hind_int hf_int hmono_ae
    simpa [f, hA_meas, MeasureTheory.integral_indicator] using hmono'
  calc
    ∫ mu in edgeCoreRegion n t,
        (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ ∫ mu : Cn3Torus.Edge n → ℝ, f mu := hset_le_full
    _ ≤ (C * (n : ℝ) ^ (6 : Nat) / t ^ (6 : Nat)) * gaussianF (dim n) t := hC n t ht

/-- On the dynamic core, the cubic oscillatory factor admits the explicit second-order
expansion with a fourth-moment remainder. This is the first quantitative theorem that
uses the new `T^4` machinery. -/
theorem cubic_core_second_order_gap_uniform :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, ∀ t : ℝ, 1 ≤ t →
        |(∫ mu in edgeCoreRegion n t,
            Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
              * Real.cos (4 * t * cubicT n (matrixOfEdge n mu)))
          - (coreMass (dim n) t
              - (8 : ℝ) * t ^ (2 : Nat)
                  * ∫ mu in edgeCoreRegion n t,
                      (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
                        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))|
          ≤ (C * (n : ℝ) ^ (6 : Nat) / t ^ (2 : Nat)) * gaussianF (dim n) t := by
  rcases cubic_core_fourth_moment_bound_core with ⟨C4, hC4_pos, hC4⟩
  have hC_pos : 0 < ((256 / 24 : ℝ) * C4) := by
    positivity
  refine ⟨((256 / 24 : ℝ) * C4), hC_pos, ?_⟩
  intro n t ht
  have ht_pos : 0 < t := by linarith
  let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n t
  let osc : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      * Real.cos (4 * t * cubicT n (matrixOfEdge n mu))
  let gauss : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  let quad : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (8 : ℝ) * t ^ (2 : Nat)
      * ((cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
  let rem : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu => osc mu - (gauss mu - quad mu)
  let f4 : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat)
      * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  have hgauss_int : MeasureTheory.Integrable gauss := by
    simpa [gauss, mul_assoc] using gaussian_integrable_edge n (2 * t) (by positivity)
  have hquad_int : MeasureTheory.IntegrableOn quad core := by
    have hbase_int :
        MeasureTheory.Integrable
          (fun mu : Cn3Torus.Edge n → ℝ =>
            (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
      simpa using cubicT_sq_gaussian_integrable_edge n t ht_pos
    simpa [quad, MeasureTheory.IntegrableOn, mul_assoc, mul_left_comm, mul_comm] using
      (hbase_int.const_mul ((8 : ℝ) * t ^ (2 : Nat))).integrableOn
  have hosc_int : MeasureTheory.IntegrableOn osc core := by
    have hosc_cont : Continuous osc := by
      have hcubic0 :
          Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
            cubicT n (matrixOfEdge n mu)) :=
        (continuous_cubicT n).comp (continuous_matrixOfEdge n)
      have hcubic :
          Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
            ((4 : ℝ) * t) * cubicT n (matrixOfEdge n mu)) :=
        continuous_const.mul hcubic0
      have hgauss_cont :
          Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
            Real.exp (-((2 * t) * Cn3Torus.sqNormEdge n mu))) := by
        exact Real.continuous_exp.comp
          ((continuous_const.mul (Cn3Torus.continuous_sqNormEdge n)).neg)
      change Continuous
        (fun mu : Cn3Torus.Edge n → ℝ =>
          Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) *
            Real.cos (4 * t * cubicT n (matrixOfEdge n mu)))
      simpa [mul_assoc] using
        (show Continuous
          (fun mu : Cn3Torus.Edge n → ℝ =>
            Real.exp (-((2 * t) * Cn3Torus.sqNormEdge n mu)) *
              Real.cos (((4 : ℝ) * t) * cubicT n (matrixOfEdge n mu))) from
          hgauss_cont.mul (Real.continuous_cos.comp hcubic))
    have hbound :
        ∀ᵐ mu : Cn3Torus.Edge n → ℝ ∂MeasureTheory.volume,
          ‖osc mu‖ ≤ gauss mu := by
      exact Filter.Eventually.of_forall (fun mu => by
        have hgauss_nonneg : 0 ≤ gauss mu := by
          dsimp [gauss]
          positivity
        have hcos :
            |Real.cos (4 * t * cubicT n (matrixOfEdge n mu))| ≤ 1 := by
          exact Real.abs_cos_le_one _
        have hnorm :
            ‖osc mu‖ = gauss mu * |Real.cos (4 * t * cubicT n (matrixOfEdge n mu))| := by
          rw [Real.norm_eq_abs]
          dsimp [osc, gauss]
          rw [abs_mul, abs_of_nonneg hgauss_nonneg]
        rw [hnorm]
        calc
          gauss mu * |Real.cos (4 * t * cubicT n (matrixOfEdge n mu))|
              ≤ gauss mu * 1 := by
                exact mul_le_mul_of_nonneg_left hcos hgauss_nonneg
          _ = gauss mu := by ring)
    simpa [MeasureTheory.IntegrableOn] using
      (MeasureTheory.Integrable.mono' hgauss_int hosc_cont.aestronglyMeasurable hbound).integrableOn
  have hf4_int : MeasureTheory.Integrable f4 := by
    simpa [f4] using cubicT_fourth_full_gaussian_integrable n t ht_pos
  have hrem_sm : MeasureTheory.AEStronglyMeasurable rem := by
    have hgauss_cont_raw :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
          Real.exp (-((2 * t) * Cn3Torus.sqNormEdge n mu))) := by
      exact Real.continuous_exp.comp
        ((continuous_const.mul (Cn3Torus.continuous_sqNormEdge n)).neg)
    have hgauss_cont : Continuous gauss := by
      simpa [gauss, mul_assoc] using hgauss_cont_raw
    have hquad_cont : Continuous quad := by
      have hcubic0 :
          Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
            cubicT n (matrixOfEdge n mu)) :=
        (continuous_cubicT n).comp (continuous_matrixOfEdge n)
      have hsq :
          Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
            (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)) := hcubic0.pow 2
      have hgauss0 :
          Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
            Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
        simpa [mul_assoc] using hgauss_cont_raw
      change Continuous
        (fun mu : Cn3Torus.Edge n → ℝ =>
          (8 : ℝ) * t ^ (2 : Nat) *
            ((cubicT n (matrixOfEdge n mu)) ^ (2 : Nat) *
              Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)))
      exact continuous_const.mul (hsq.mul hgauss0)
    have hosc_cont : Continuous osc := by
      have hcubic0 :
          Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
            cubicT n (matrixOfEdge n mu)) :=
        (continuous_cubicT n).comp (continuous_matrixOfEdge n)
      have hcubic :
          Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
            ((4 : ℝ) * t) * cubicT n (matrixOfEdge n mu)) :=
        continuous_const.mul hcubic0
      change Continuous
        (fun mu : Cn3Torus.Edge n → ℝ =>
          Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) *
            Real.cos (4 * t * cubicT n (matrixOfEdge n mu)))
      simpa [mul_assoc] using
        (show Continuous
          (fun mu : Cn3Torus.Edge n → ℝ =>
            Real.exp (-((2 * t) * Cn3Torus.sqNormEdge n mu)) *
              Real.cos (((4 : ℝ) * t) * cubicT n (matrixOfEdge n mu))) from
          hgauss_cont_raw.mul (Real.continuous_cos.comp hcubic))
    change MeasureTheory.AEStronglyMeasurable
      (fun mu : Cn3Torus.Edge n → ℝ => osc mu - (gauss mu - quad mu))
    simpa [rem] using
      (hosc_cont.sub (hgauss_cont.sub hquad_cont)).aestronglyMeasurable
  have hrem_bound_point :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        ‖rem mu‖ ≤ ((256 / 24 : ℝ) * t ^ (4 : Nat)) * f4 mu := by
    intro mu
    let u : ℝ := 4 * t * cubicT n (matrixOfEdge n mu)
    have hgauss_nonneg : 0 ≤ gauss mu := by
      dsimp [gauss]
      positivity
    have hu4 :
        |u| ^ (4 : Nat) = u ^ (4 : Nat) := by
      calc
        |u| ^ (4 : Nat) = (|u| ^ (2 : Nat)) ^ (2 : Nat) := by ring
        _ = (u ^ (2 : Nat)) ^ (2 : Nat) := by rw [sq_abs]
        _ = u ^ (4 : Nat) := by ring
    have hcos :
        |Real.cos u - (1 - u ^ (2 : Nat) / 2)| ≤ u ^ (4 : Nat) / 24 := by
      have hraw := abs_cos_sub_one_add_sq_div_two_le_pow_four_div_twentyfour u
      simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm, hu4] using hraw
    have hu_sq :
        u ^ (2 : Nat)
          = (16 : ℝ) * t ^ (2 : Nat) * (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat) := by
      dsimp [u]
      ring
    have hmain :
        rem mu
          = gauss mu * (Real.cos u - (1 - u ^ (2 : Nat) / 2)) := by
      dsimp [rem, osc, gauss, quad, u]
      ring
    have hu_four_expand :
        u ^ (4 : Nat)
          = (256 : ℝ) * t ^ (4 : Nat) * (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat) := by
      dsimp [u]
      ring
    rw [hmain, Real.norm_eq_abs, abs_mul, abs_of_nonneg hgauss_nonneg]
    calc
      gauss mu * |Real.cos u - (1 - u ^ (2 : Nat) / 2)|
        ≤ gauss mu * (u ^ (4 : Nat) / 24) := by
            exact mul_le_mul_of_nonneg_left hcos hgauss_nonneg
      _ = ((256 / 24 : ℝ) * t ^ (4 : Nat)) * f4 mu := by
            dsimp [f4, gauss]
            rw [hu_four_expand]
            ring
  have hrem_bound :
      ∀ᵐ mu : Cn3Torus.Edge n → ℝ ∂MeasureTheory.volume,
        ‖rem mu‖ ≤ ((256 / 24 : ℝ) * t ^ (4 : Nat)) * f4 mu := by
    exact Filter.Eventually.of_forall hrem_bound_point
  have hrem_int : MeasureTheory.IntegrableOn rem core := by
    simpa [MeasureTheory.IntegrableOn] using
      (MeasureTheory.Integrable.mono'
        (((hf4_int.const_mul ((256 / 24 : ℝ) * t ^ (4 : Nat)))))
        hrem_sm hrem_bound).integrableOn
  have hgauss_eq :
      ∫ mu in core, gauss mu = coreMass (dim n) t := by
    dsimp [core, gauss]
    simpa using (coreMass_eq_edgeCoreRegion_gaussian_integral n t).symm
  have hquad_eq :
      ∫ mu in core, quad mu
        = (8 : ℝ) * t ^ (2 : Nat)
            * ∫ mu in core,
                (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
                  * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
    rw [MeasureTheory.integral_const_mul]
  have htarget :
      (∫ mu in core, osc mu)
        - (coreMass (dim n) t
            - (8 : ℝ) * t ^ (2 : Nat)
                * ∫ mu in core,
                    (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
                      * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
      = ∫ mu in core, rem mu := by
    have hsub1 :
        ∫ mu in core, (osc mu - (gauss mu - quad mu))
          = (∫ mu in core, osc mu) - ∫ mu in core, (gauss mu - quad mu) := by
      simpa using
        (MeasureTheory.integral_sub hosc_int (hgauss_int.integrableOn.sub hquad_int))
    have hsub2 :
        ∫ mu in core, (gauss mu - quad mu)
          = (∫ mu in core, gauss mu) - ∫ mu in core, quad mu := by
      simpa using
        (MeasureTheory.integral_sub hgauss_int.integrableOn hquad_int)
    symm
    calc
      ∫ mu in core, rem mu
          = ∫ mu in core, (osc mu - (gauss mu - quad mu)) := by rfl
      _ = (∫ mu in core, osc mu) - ∫ mu in core, (gauss mu - quad mu) := hsub1
      _ = (∫ mu in core, osc mu) - ((∫ mu in core, gauss mu) - ∫ mu in core, quad mu) := by
            rw [hsub2]
      _ = (∫ mu in core, osc mu)
            - (coreMass (dim n) t
                - (8 : ℝ) * t ^ (2 : Nat)
                    * ∫ mu in core,
                        (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
                          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
            rw [hgauss_eq, hquad_eq]
  have hrem_bound_int :
      ∫ mu in core, ‖rem mu‖
        ≤ ((256 / 24 : ℝ) * t ^ (4 : Nat))
            * ∫ mu in core, f4 mu := by
    have hleft_int : MeasureTheory.IntegrableOn (fun mu => ‖rem mu‖) core := hrem_int.norm
    have hmono :
        (fun mu : Cn3Torus.Edge n → ℝ => ‖rem mu‖)
          ≤ᶠ[MeasureTheory.ae (MeasureTheory.volume.restrict core)]
            (fun mu => ((256 / 24 : ℝ) * t ^ (4 : Nat)) * f4 mu) := by
      exact Filter.Eventually.of_forall hrem_bound_point
    have hright_int :
        MeasureTheory.IntegrableOn
          (fun mu => ((256 / 24 : ℝ) * t ^ (4 : Nat)) * f4 mu) core := by
      simpa [MeasureTheory.IntegrableOn] using
        ((hf4_int.const_mul ((256 / 24 : ℝ) * t ^ (4 : Nat)))).integrableOn
    calc
      ∫ mu in core, ‖rem mu‖
        ≤ ∫ mu in core, ((256 / 24 : ℝ) * t ^ (4 : Nat)) * f4 mu := by
            exact MeasureTheory.integral_mono_ae hleft_int hright_int hmono
      _ = ((256 / 24 : ℝ) * t ^ (4 : Nat)) * ∫ mu in core, f4 mu := by
            rw [MeasureTheory.integral_const_mul]
  have habs_int :
      |∫ mu in core, rem mu| ≤ ∫ mu in core, ‖rem mu‖ := by
    simpa using
      (MeasureTheory.norm_integral_le_integral_norm (μ := MeasureTheory.volume.restrict core)
        (f := rem))
  calc
    |(∫ mu in edgeCoreRegion n t,
        Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
          * Real.cos (4 * t * cubicT n (matrixOfEdge n mu)))
      - (coreMass (dim n) t
          - (8 : ℝ) * t ^ (2 : Nat)
              * ∫ mu in edgeCoreRegion n t,
                  (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
                    * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))|
      = |∫ mu in core, rem mu| := by
          simpa [core, osc] using congrArg abs htarget
    _ ≤ ∫ mu in core, ‖rem mu‖ := habs_int
    _ ≤ ((256 / 24 : ℝ) * t ^ (4 : Nat)) * ∫ mu in core, f4 mu := hrem_bound_int
    _ ≤ ((256 / 24 : ℝ) * t ^ (4 : Nat))
          * ((C4 * (n : ℝ) ^ (6 : Nat) / t ^ (6 : Nat)) * gaussianF (dim n) t) := by
            exact mul_le_mul_of_nonneg_left (hC4 n t ht) (by positivity)
    _ = (((256 / 24 : ℝ) * C4) * (n : ℝ) ^ (6 : Nat) / t ^ (2 : Nat))
          * gaussianF (dim n) t := by
          field_simp [ht_pos.ne']

private lemma quinticTriangleRepeatMultiplicity_injective {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    Function.Injective (quinticTriangleRepeatMultiplicity τ hτ) := by
  intro s s' hss
  cases s with
  | edge12 =>
      cases s' with
      | edge12 => rfl
      | edge13 =>
          exfalso
          have h := congrFun hss (triangleEdge12 τ hτ)
          have h' : (3 : ℕ) = 1 := by
            simpa [quinticTriangleRepeatMultiplicity_edge12_self,
              quinticTriangleRepeatMultiplicity_edge13_other12] using h
          omega
      | edge23 =>
          exfalso
          have h := congrFun hss (triangleEdge12 τ hτ)
          have h' : (3 : ℕ) = 1 := by
            simpa [quinticTriangleRepeatMultiplicity_edge12_self,
              quinticTriangleRepeatMultiplicity_edge23_other12] using h
          omega
  | edge13 =>
      cases s' with
      | edge12 =>
          exfalso
          have h := congrFun hss (triangleEdge13 τ hτ)
          have h' : (3 : ℕ) = 1 := by
            simpa [quinticTriangleRepeatMultiplicity_edge13_self,
              quinticTriangleRepeatMultiplicity_edge12_other13] using h
          omega
      | edge13 => rfl
      | edge23 =>
          exfalso
          have h := congrFun hss (triangleEdge13 τ hτ)
          have h' : (3 : ℕ) = 1 := by
            simpa [quinticTriangleRepeatMultiplicity_edge13_self,
              quinticTriangleRepeatMultiplicity_edge23_other13] using h
          omega
  | edge23 =>
      cases s' with
      | edge12 =>
          exfalso
          have h := congrFun hss (triangleEdge23 τ hτ)
          have h' : (3 : ℕ) = 1 := by
            simpa [quinticTriangleRepeatMultiplicity_edge23_self,
              quinticTriangleRepeatMultiplicity_edge12_other23] using h
          omega
      | edge13 =>
          exfalso
          have h := congrFun hss (triangleEdge23 τ hτ)
          have h' : (3 : ℕ) = 1 := by
            simpa [quinticTriangleRepeatMultiplicity_edge23_self,
              quinticTriangleRepeatMultiplicity_edge13_other23] using h
          omega
      | edge23 => rfl

