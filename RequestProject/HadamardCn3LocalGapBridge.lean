/-- A weighted radial fifth-moment bound against the quartic exponential core
weight. This is the shared quantitative input behind the refined quintic bridge. -/
lemma sqNorm_pow_five_quarticWeight_core_bound
    (n : ℕ) (t : ℝ) (ht : 1 ≤ t)
    (hbox : (dim n : ℝ) / t ≤ Cn3Torus.delta ^ (2 : Nat))
    (hsmall8 : (8 : ℝ) * ((dim n : ℝ) / t) ≤ 1 / 2)
    (hcube : (n : ℝ) * (((dim n : ℝ) / t) ^ (2 : Nat)) ≤ 1) :
    ∃ C : ℝ, 0 < C ∧
      ∫ mu in edgeCoreRegion n t,
          Cn3Torus.sqNormEdge n mu ^ (5 : Nat)
            * Real.exp
              (-2 * t * Cn3Torus.sqNormEdge n mu
                + 4 * t * quarticCorr n (matrixOfEdge n mu))
        ≤ (C / t ^ (5 : Nat)) * gaussianF (dim n) t := by
  obtain ⟨Crad, hCrad_pos, hrad⟩ := gaussian_radial_moments_edge n 10
  let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n t
  let μ : MeasureTheory.Measure (Cn3Torus.Edge n → ℝ) := MeasureTheory.volume.restrict core
  let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Cn3Torus.sqNormEdge n mu ^ (5 : Nat) * Real.exp (-t * Cn3Torus.sqNormEdge n mu)
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp (-t * Cn3Torus.sqNormEdge n mu
      + 4 * t * quarticCorr n (matrixOfEdge n mu))
  have hmeas : MeasurableSet core := measurableSet_edgeCoreRegion n t
  have hf_cont : Continuous f := by
    have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [f]
    fun_prop
  have hg_cont : Continuous g := by
    have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    have hquart :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
      (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
    dsimp [g]
    fun_prop
  have hf_sq_cont : Continuous (fun x => f x ^ (2 : Nat)) := hf_cont.pow 2
  have hg_sq_cont : Continuous (fun x => g x ^ (2 : Nat)) := hg_cont.pow 2
  have hf_sq_int : MeasureTheory.Integrable (fun x => f x ^ (2 : Nat)) μ := by
    simpa [μ, core, MeasureTheory.IntegrableOn] using
      ((hf_sq_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox))
  have hg_sq_int : MeasureTheory.Integrable (fun x => g x ^ (2 : Nat)) μ := by
    simpa [μ, core, MeasureTheory.IntegrableOn] using
      ((hg_sq_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox))
  have hf_ae : MeasureTheory.AEStronglyMeasurable f μ := hf_cont.aestronglyMeasurable
  have hg_ae : MeasureTheory.AEStronglyMeasurable g μ := hg_cont.aestronglyMeasurable
  have hf_nonneg : 0 ≤ᵐ[μ] f := Filter.Eventually.of_forall (fun x => by
    dsimp [f]
    exact mul_nonneg
      (pow_nonneg (Cn3Torus.sqNormEdge_nonneg n x) _)
      (le_of_lt (Real.exp_pos _)))
  have hg_nonneg : 0 ≤ᵐ[μ] g := Filter.Eventually.of_forall (fun x => by
    dsimp [g]
    exact le_of_lt (Real.exp_pos _))
  have hcs := cs_helper μ hf_ae hg_ae hf_nonneg hg_nonneg hf_sq_int hg_sq_int
  have hleft_eq :
      ∫ x, f x * g x ∂μ
        = ∫ mu in core,
            Cn3Torus.sqNormEdge n mu ^ (5 : Nat)
              * Real.exp
                (-2 * t * Cn3Torus.sqNormEdge n mu
                  + 4 * t * quarticCorr n (matrixOfEdge n mu)) := by
    simp [μ]
    refine MeasureTheory.integral_congr_ae ?_
    exact Filter.Eventually.of_forall (fun x => by
      dsimp [f, g]
      rw [mul_assoc, ← Real.exp_add]
      congr 1
      ring)
  have hAeq :
      ∫ x, f x ^ (2 : Nat) ∂μ
        = ∫ mu in core,
            Cn3Torus.sqNormEdge n mu ^ (10 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
    simp [μ]
    refine MeasureTheory.integral_congr_ae ?_
    exact Filter.Eventually.of_forall (fun x => by
      dsimp [f]
      rw [pow_two]
      calc
        (Cn3Torus.sqNormEdge n x ^ (5 : Nat) * Real.exp (-t * Cn3Torus.sqNormEdge n x))
            * (Cn3Torus.sqNormEdge n x ^ (5 : Nat) * Real.exp (-t * Cn3Torus.sqNormEdge n x))
          = Cn3Torus.sqNormEdge n x ^ (10 : Nat)
              * (Real.exp (-t * Cn3Torus.sqNormEdge n x)
                  * Real.exp (-t * Cn3Torus.sqNormEdge n x)) := by
                ring
        _ = Cn3Torus.sqNormEdge n x ^ (10 : Nat)
              * Real.exp (-(2 * t * Cn3Torus.sqNormEdge n x)) := by
                rw [← Real.exp_add]
                congr 1
                ring)
  have hBeq :
      ∫ x, g x ^ (2 : Nat) ∂μ
        = ∫ mu in core,
            Real.exp
              (-2 * t * Cn3Torus.sqNormEdge n mu
                + 8 * t * quarticCorr n (matrixOfEdge n mu)) := by
    simp [μ]
    refine MeasureTheory.integral_congr_ae ?_
    exact Filter.Eventually.of_forall (fun x => by
      dsimp [g]
      rw [pow_two, ← Real.exp_add]
      congr 1
      ring)
  have hA :
      ∫ x, f x ^ (2 : Nat) ∂μ ≤ (Crad / t ^ (10 : Nat)) * gaussianF (dim n) t := by
    rw [hAeq]
    have hfull := hrad t ht
    have hnonneg :
        0 ≤ᵐ[MeasureTheory.volume]
          fun mu : Cn3Torus.Edge n → ℝ =>
            Cn3Torus.sqNormEdge n mu ^ (10 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) :=
      Filter.Eventually.of_forall (fun x => by positivity)
    have hint :
        MeasureTheory.Integrable
          (fun mu : Cn3Torus.Edge n → ℝ =>
            Cn3Torus.sqNormEdge n mu ^ (10 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
      have ht_pos : 0 < t := by linarith
      simpa using sqNorm_moment_gaussian_integrable_edge n 10 (by positivity) t ht_pos
    have hset_le :
        ∫ mu in core,
            Cn3Torus.sqNormEdge n mu ^ (10 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
          ≤ ∫ mu : Cn3Torus.Edge n → ℝ,
              Cn3Torus.sqNormEdge n mu ^ (10 : Nat)
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
      simpa [core] using MeasureTheory.setIntegral_le_integral hint hnonneg
    exact le_trans hset_le hfull
  have hB :
      ∫ x, g x ^ (2 : Nat) ∂μ ≤ Real.exp 32 * gaussianF (dim n) t := by
    rw [hBeq]
    simpa [core] using quarticCore_exp8_integral_le_gaussianF n t ht hsmall8 hcube
  refine ⟨Real.sqrt Crad * Real.sqrt (Real.exp 32), ?_, ?_⟩
  · positivity
  · rw [← hleft_eq]
    have hA_nonneg : 0 ≤ ∫ x, f x ^ (2 : Nat) ∂μ := by
      exact MeasureTheory.integral_nonneg_of_ae (Filter.Eventually.of_forall (fun x => by
        dsimp [f]
        positivity))
    have hB_nonneg : 0 ≤ ∫ x, g x ^ (2 : Nat) ∂μ := by
      exact MeasureTheory.integral_nonneg_of_ae (Filter.Eventually.of_forall (fun x => by
        dsimp [g]
        positivity))
    have hA_rpow :
        (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
          ≤ ((Crad / t ^ (10 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ)) := by
      exact Real.rpow_le_rpow hA_nonneg hA (by norm_num)
    have hB_rpow :
        (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
          ≤ (Real.exp 32 * gaussianF (dim n) t) ^ (1 / (2 : ℝ)) := by
      exact Real.rpow_le_rpow hB_nonneg hB (by norm_num)
    have hA_bound_nonneg :
        0 ≤ ((Crad / t ^ (10 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ)) := by
      have hA_base_nonneg : 0 ≤ (Crad / t ^ (10 : Nat)) * gaussianF (dim n) t := by
        apply mul_nonneg
        · positivity
        · exact Real.rpow_nonneg (by positivity) _
      exact Real.rpow_nonneg hA_base_nonneg _
    have hB_factor_nonneg :
        0 ≤ (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
      exact Real.rpow_nonneg hB_nonneg _
    calc
      ∫ x, f x * g x ∂μ
        ≤ (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
            * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := hcs
      _ ≤ ((Crad / t ^ (10 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ))
            * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
              exact mul_le_mul_of_nonneg_right hA_rpow hB_factor_nonneg
      _ ≤ ((Crad / t ^ (10 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ))
            * (Real.exp 32 * gaussianF (dim n) t) ^ (1 / (2 : ℝ)) := by
              exact mul_le_mul_of_nonneg_left hB_rpow hA_bound_nonneg
      _ = (Real.sqrt Crad * Real.sqrt (Real.exp 32) / t ^ (5 : Nat))
            * gaussianF (dim n) t := by
              let G : ℝ := gaussianF (dim n) t
              let u : ℝ := 1 / t ^ (5 : Nat)
              have hG_nonneg : 0 ≤ G := by
                dsimp [G]
                exact Real.rpow_nonneg (by positivity) _
              have hu_nonneg : 0 ≤ u := by
                dsimp [u]
                positivity
              have hu_sq : u ^ (2 : Nat) = 1 / t ^ (10 : Nat) := by
                dsimp [u]
                ring
              have hArew :
                  (Crad / t ^ (10 : Nat)) * G = Crad * u ^ (2 : Nat) * G := by
                rw [hu_sq]
                ring
              have hCu_nonneg : 0 ≤ Crad * u ^ (2 : Nat) := by
                exact mul_nonneg hCrad_pos.le (by positivity)
              have hu_sq_nonneg : 0 ≤ u ^ (2 : Nat) := by positivity
              rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow]
              calc
                Real.sqrt ((Crad / t ^ (10 : Nat)) * G) * Real.sqrt (Real.exp 32 * G)
                  = Real.sqrt (Crad * u ^ (2 : Nat) * G) * Real.sqrt (Real.exp 32 * G) := by
                      rw [hArew]
                _ = ((Real.sqrt (Crad * u ^ (2 : Nat))) * Real.sqrt G)
                    * (Real.sqrt (Real.exp 32) * Real.sqrt G) := by
                      rw [show Crad * u ^ (2 : Nat) * G = (Crad * u ^ (2 : Nat)) * G by ring]
                      rw [Real.sqrt_mul hCu_nonneg G]
                      rw [show Real.exp 32 * G = (Real.exp 32) * G by ring]
                      rw [Real.sqrt_mul (show 0 ≤ Real.exp 32 by positivity) G]
                _ = ((Real.sqrt Crad * u) * Real.sqrt G)
                    * (Real.sqrt (Real.exp 32) * Real.sqrt G) := by
                      rw [Real.sqrt_mul hCrad_pos.le (u ^ (2 : Nat)), Real.sqrt_sq_eq_abs, abs_of_nonneg hu_nonneg]
                _ = Real.sqrt Crad * Real.sqrt (Real.exp 32)
                    * (u * (Real.sqrt G * Real.sqrt G)) := by
                      ring
                _ = Real.sqrt Crad * Real.sqrt (Real.exp 32) * (u * G) := by
                      congr 2
                      nlinarith [Real.sq_sqrt hG_nonneg]
                _ = (Real.sqrt Crad * Real.sqrt (Real.exp 32) / t ^ (5 : Nat)) * G := by
                      dsimp [u]
                      ring
                _ = (Real.sqrt Crad * Real.sqrt (Real.exp 32) / t ^ (5 : Nat))
                      * gaussianF (dim n) t := by
                      rfl

/-- Uniform weighted quintic `L²` bound against the quartic exponential core
weight. -/
lemma quinticP5_sq_quarticWeight_core_bound_uniform :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, ∀ t : ℝ, 1 ≤ t →
        (dim n : ℝ) / t ≤ Cn3Torus.delta ^ (2 : Nat) →
        (8 : ℝ) * ((dim n : ℝ) / t) ≤ 1 / 2 →
        (n : ℝ) * (((dim n : ℝ) / t) ^ (2 : Nat)) ≤ 1 →
        ∫ mu in edgeCoreRegion n t,
            (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
              * Real.exp
                (-2 * t * Cn3Torus.sqNormEdge n mu
                  + 4 * t * quarticCorr n (matrixOfEdge n mu))
          ≤ (C / t ^ (5 : Nat)) * gaussianF (dim n) t := by
  obtain ⟨Cq, hCq_pos, hq⟩ := quinticP5_pointwise_bound_uniform
  obtain ⟨Crad, hCrad_pos, hrad⟩ := sqNorm_pow_five_quarticWeight_core_bound
  refine ⟨Cq ^ (2 : Nat) * Crad, by positivity, ?_⟩
  intro n t ht hbox hsmall8 hcube
  have hrad' := hrad n t ht hbox hsmall8 hcube
  have hpoint :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
            * Real.exp
              (-2 * t * Cn3Torus.sqNormEdge n mu
                + 4 * t * quarticCorr n (matrixOfEdge n mu))
          ≤
        (Cq ^ (2 : Nat))
          * (Cn3Torus.sqNormEdge n mu ^ (5 : Nat)
              * Real.exp
                (-2 * t * Cn3Torus.sqNormEdge n mu
                  + 4 * t * quarticCorr n (matrixOfEdge n mu))) := by
    intro mu
    have hq_mu :
        |quinticP5 n (matrixOfEdge n mu)|
          ≤ Cq * Cn3Torus.sqNormEdge n mu ^ (5 / 2 : ℝ) := by
      simpa [sNorm_eq_sqNormEdge] using hq n (matrixOfEdge n mu)
    have hsq_mu :
        (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
          ≤ Cq ^ (2 : Nat) * Cn3Torus.sqNormEdge n mu ^ (5 : Nat) := by
      have habs_sq :
          (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
            = |quinticP5 n (matrixOfEdge n mu)| ^ (2 : Nat) := by
        symm
        simpa using (sq_abs (quinticP5 n (matrixOfEdge n mu)))
      rw [habs_sq]
      have hq_sq := sq_le_sq.mpr hq_mu
      have hs_nonneg : 0 ≤ Cn3Torus.sqNormEdge n mu := by positivity
      have hrpow :
          (Cn3Torus.sqNormEdge n mu ^ (5 / 2 : ℝ)) ^ (2 : Nat)
            = Cn3Torus.sqNormEdge n mu ^ (5 : Nat) := by
        rw [show ((2 : Nat) : ℝ) = (2 : ℝ) by norm_num, Real.rpow_natCast,
          ← Real.rpow_mul hs_nonneg]
        norm_num
      calc
        |quinticP5 n (matrixOfEdge n mu)| ^ (2 : Nat)
          ≤ (Cq * Cn3Torus.sqNormEdge n mu ^ (5 / 2 : ℝ)) ^ (2 : Nat) := hq_sq
        _ = Cq ^ (2 : Nat) * Cn3Torus.sqNormEdge n mu ^ (5 : Nat) := by
