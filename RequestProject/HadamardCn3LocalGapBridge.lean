private lemma quarticCycleSupport_injective {n : ℕ}
    (ξ ξ' : SimpleCycle4Index n × QuarticCycleShape)
    (hξ : IsSimpleCycle4Index ξ.1) (hξ' : IsSimpleCycle4Index ξ'.1)
    (hS : quarticCycleSupport ξ.1 hξ ξ.2 = quarticCycleSupport ξ'.1 hξ' ξ'.2) :
    ξ = ξ' := by
  have hsubset : quarticVertices ξ.1 ⊆ quarticVertices ξ'.1 := by
    intro v hv
    have hv' :
        v = quarticV1 ξ.1 ∨ v = quarticV2 ξ.1 ∨ v = quarticV3 ξ.1 ∨ v = quarticV4 ξ.1 := by
            simpa [quarticVertices] using hv
    rcases hv' with rfl | rfl | rfl | rfl
    · cases ξ using Prod.rec with
      | _ σ s =>
          cases s
          · have he : quarticEdge12 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.first := by
              simp [quarticCycleSupport]
            have he' : quarticEdge12 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
              exact he
            exact left_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
          · have he : quarticEdge12 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.second := by
              simp [quarticCycleSupport]
            have he' : quarticEdge12 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
              exact he
            exact left_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
          · have he : quarticEdge13 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.third := by
              simp [quarticCycleSupport]
            have he' : quarticEdge13 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
              exact he
            exact left_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
    · cases ξ using Prod.rec with
      | _ σ s =>
          cases s
          · have he : quarticEdge12 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.first := by
              simp [quarticCycleSupport]
            have he' : quarticEdge12 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
              exact he
            exact right_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
          · have he : quarticEdge12 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.second := by
              simp [quarticCycleSupport]
            have he' : quarticEdge12 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
