private lemma triangleChoiceMultiplicity_total_degree {n : ℕ}
    (ξ : TriangleChoice n) :
    (∑ e : Cn3Torus.Edge n, triangleChoiceMultiplicity ξ e) = 3 := by
  calc
    (∑ e : Cn3Torus.Edge n, triangleChoiceMultiplicity ξ e)
      = (∑ e : Cn3Torus.Edge n,
          edgePowMultiplicity (triangleEdge12 ξ.1 (triangleChoice_valid ξ)) 1 e)
        + (∑ e : Cn3Torus.Edge n,
            edgePowMultiplicity (triangleEdge13 ξ.1 (triangleChoice_valid ξ)) 1 e)
        + (∑ e : Cn3Torus.Edge n,
            edgePowMultiplicity (triangleEdge23 ξ.1 (triangleChoice_valid ξ)) 1 e) := by
            simp [triangleChoiceMultiplicity, Finset.sum_add_distrib, add_assoc]
    _ = 1 + 1 + 1 := by
          rw [sum_edgePowMultiplicity, sum_edgePowMultiplicity, sum_edgePowMultiplicity]
    _ = 3 := by norm_num

private lemma cubicT_matrixOfEdge_eq_sum_triangleChoices (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    cubicT n (matrixOfEdge n mu)
      = ∑ ξ : TriangleChoice n, triangleChoiceMonomial ξ mu := by
  calc
    cubicT n (matrixOfEdge n mu)
      = Finset.sum (triangleTriples n) (fun τ => triangleMonomialOn mu τ) := by
          exact cubicT_matrixOfEdge_eq_sum_triangleTriples n mu
    _ = ∑ ξ : TriangleChoice n, triangleChoiceMonomial ξ mu := by
          symm
          simpa [triangleChoiceMonomial, triangleMonomialOn, triangleChoice_valid] using
            (Finset.sum_attach (s := triangleTriples n)
              (f := fun τ => triangleMonomialOn mu τ))

private lemma triangleChoiceMultiplicity_odd_of_mem_support {n : ℕ}
    (ξ : TriangleChoice n) {e : Cn3Torus.Edge n}
    (he : e ∈ triangleChoiceSupport ξ) :
    Odd (triangleChoiceMultiplicity ξ e) := by
  have h12 : triangleEdge12 ξ.1 (triangleChoice_valid ξ) ≠ triangleEdge13 ξ.1 (triangleChoice_valid ξ) :=
    triangleEdge12_ne_13 ξ.1 (triangleChoice_valid ξ)
  have h13 : triangleEdge12 ξ.1 (triangleChoice_valid ξ) ≠ triangleEdge23 ξ.1 (triangleChoice_valid ξ) :=
    triangleEdge12_ne_23 ξ.1 (triangleChoice_valid ξ)
  have h23 : triangleEdge13 ξ.1 (triangleChoice_valid ξ) ≠ triangleEdge23 ξ.1 (triangleChoice_valid ξ) :=
    triangleEdge13_ne_23 ξ.1 (triangleChoice_valid ξ)
  rcases (by simpa [triangleChoiceSupport, triangleEdgeSet] using he) with rfl | rfl | rfl
  · refine ⟨0, ?_⟩
    simp [triangleChoiceMultiplicity, edgePowMultiplicity, h12, h12.symm, h13, h13.symm]
  · refine ⟨0, ?_⟩
    simp [triangleChoiceMultiplicity, edgePowMultiplicity, h12, h12.symm, h23, h23.symm]
  · refine ⟨0, ?_⟩
    simp [triangleChoiceMultiplicity, edgePowMultiplicity, h13, h13.symm, h23, h23.symm]

private lemma triangleQuadrupleMultiplicity_total_degree {n : ℕ}
    (q : TriangleQuadruple n) :
    (∑ e : Cn3Torus.Edge n, triangleQuadrupleMultiplicity q e) = 2 * 6 := by
  calc
    (∑ e : Cn3Torus.Edge n, triangleQuadrupleMultiplicity q e)
      = (∑ e : Cn3Torus.Edge n, triangleChoiceMultiplicity (triangleQuad1 q) e)
          + (∑ e : Cn3Torus.Edge n, triangleChoiceMultiplicity (triangleQuad2 q) e)
          + (∑ e : Cn3Torus.Edge n, triangleChoiceMultiplicity (triangleQuad3 q) e)
          + (∑ e : Cn3Torus.Edge n, triangleChoiceMultiplicity (triangleQuad4 q) e) := by
            simp [triangleQuadrupleMultiplicity, Finset.sum_add_distrib, add_assoc]
    _ = 3 + 3 + 3 + 3 := by
          rw [triangleChoiceMultiplicity_total_degree, triangleChoiceMultiplicity_total_degree,
            triangleChoiceMultiplicity_total_degree, triangleChoiceMultiplicity_total_degree]
    _ = 2 * 6 := by norm_num

private lemma triangleQuadrupleMonomial_eq_coordMonomial {n : ℕ}
    (q : TriangleQuadruple n) (mu : Cn3Torus.Edge n → ℝ) :
    triangleChoiceMonomial (triangleQuad1 q) mu
        * triangleChoiceMonomial (triangleQuad2 q) mu
        * triangleChoiceMonomial (triangleQuad3 q) mu
        * triangleChoiceMonomial (triangleQuad4 q) mu
      = coordMonomial (triangleQuadrupleMultiplicity q) mu := by
  let m₁ := triangleChoiceMultiplicity (triangleQuad1 q)
  let m₂ := triangleChoiceMultiplicity (triangleQuad2 q)
  let m₃ := triangleChoiceMultiplicity (triangleQuad3 q)
  let m₄ := triangleChoiceMultiplicity (triangleQuad4 q)
  calc
    triangleChoiceMonomial (triangleQuad1 q) mu
        * triangleChoiceMonomial (triangleQuad2 q) mu
        * triangleChoiceMonomial (triangleQuad3 q) mu
        * triangleChoiceMonomial (triangleQuad4 q) mu
      = ((coordMonomial m₁ mu * coordMonomial m₂ mu) * coordMonomial m₃ mu)
          * coordMonomial m₄ mu := by
            simp [m₁, m₂, m₃, m₄, triangleChoiceMonomial_eq_coordMonomial, mul_assoc]
    _ = (coordMonomial (m₁ + m₂) mu * coordMonomial m₃ mu) * coordMonomial m₄ mu := by
          simpa [Pi.add_apply] using
            congrArg (fun z : ℝ => (z * coordMonomial m₃ mu) * coordMonomial m₄ mu)
              (coordMonomial_mul m₁ m₂ mu)
    _ = coordMonomial ((m₁ + m₂) + m₃) mu * coordMonomial m₄ mu := by
          simpa [Pi.add_apply] using
            congrArg (fun z : ℝ => z * coordMonomial m₄ mu)
              (coordMonomial_mul (m₁ + m₂) m₃ mu)
    _ = coordMonomial (((m₁ + m₂) + m₃) + m₄) mu := by
          simpa [Pi.add_apply] using
            (coordMonomial_mul ((m₁ + m₂) + m₃) m₄ mu)
    _ = coordMonomial (triangleQuadrupleMultiplicity q) mu := by
          simp [triangleQuadrupleMultiplicity, m₁, m₂, m₃, m₄, add_assoc]

private lemma triangleChoiceQuadruple_integrable {n : ℕ}
    (q : TriangleQuadruple n) (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      triangleChoiceMonomial (triangleQuad1 q) mu
        * triangleChoiceMonomial (triangleQuad2 q) mu
        * triangleChoiceMonomial (triangleQuad3 q) mu
        * triangleChoiceMonomial (triangleQuad4 q) mu
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  have hdeg :
      (∑ e : Cn3Torus.Edge n, triangleQuadrupleMultiplicity q e) = 2 * 6 :=
    triangleQuadrupleMultiplicity_total_degree q
  have hbase :
      MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
        coordMonomial (triangleQuadrupleMultiplicity q) mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) :=
    edge_coordMonomial_integrable (triangleQuadrupleMultiplicity q) 6 (by norm_num) hdeg t ht
  refine hbase.congr ?_
  exact Filter.Eventually.of_forall (fun mu => by
    simpa [mul_assoc] using
      (congrArg
        (fun z : ℝ => z * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
        (triangleQuadrupleMonomial_eq_coordMonomial q mu)).symm)

private lemma triangleChoiceQuadruple_gaussian_zero_of_not_even {n : ℕ}
    (q : TriangleQuadruple n) (t : ℝ) (hnot : ¬ triangleQuadrupleEven q) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        triangleChoiceMonomial (triangleQuad1 q) mu
          * triangleChoiceMonomial (triangleQuad2 q) mu
          * triangleChoiceMonomial (triangleQuad3 q) mu
          * triangleChoiceMonomial (triangleQuad4 q) mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = 0 := by
  classical
  have hodd :
      ∃ e : Cn3Torus.Edge n, Odd (triangleQuadrupleMultiplicity q e) := by
    by_contra hno
    apply hnot
    intro e
    rcases Nat.even_or_odd (triangleQuadrupleMultiplicity q e) with he | ho
    · exact he
    · exact False.elim (hno ⟨e, ho⟩)
  rcases hodd with ⟨e, he⟩
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        triangleChoiceMonomial (triangleQuad1 q) mu
          * triangleChoiceMonomial (triangleQuad2 q) mu
          * triangleChoiceMonomial (triangleQuad3 q) mu
          * triangleChoiceMonomial (triangleQuad4 q) mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial (triangleQuadrupleMultiplicity q) mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              refine MeasureTheory.integral_congr_ae ?_
              exact Filter.Eventually.of_forall (fun mu => by
                simpa [mul_assoc] using
                  congrArg
                    (fun z : ℝ => z * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
                    (triangleQuadrupleMonomial_eq_coordMonomial q mu))
    _ = 0 := gaussian_edge_coordMonomial_odd_zero e (triangleQuadrupleMultiplicity q) t he

private lemma triangleChoiceQuadruple_gaussian_bound_of_even {n : ℕ}
    (q : TriangleQuadruple n) (t : ℝ) (ht : 1 ≤ t)
    (heven : triangleQuadrupleEven q) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        triangleChoiceMonomial (triangleQuad1 q) mu
          * triangleChoiceMonomial (triangleQuad2 q) mu
          * triangleChoiceMonomial (triangleQuad3 q) mu
          * triangleChoiceMonomial (triangleQuad4 q) mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ (gaussianEvenMomentEnvelope 6 ^ 6 / t ^ (6 : Nat)) * gaussianF (dim n) t := by
  have hdeg :
      (∑ e : Cn3Torus.Edge n, triangleQuadrupleMultiplicity q e) = 2 * 6 :=
    triangleQuadrupleMultiplicity_total_degree q
  have hbound := gaussian_edge_even_coordMonomial_bound (triangleQuadrupleMultiplicity q) 6 hdeg heven t ht
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        triangleChoiceMonomial (triangleQuad1 q) mu
          * triangleChoiceMonomial (triangleQuad2 q) mu
          * triangleChoiceMonomial (triangleQuad3 q) mu
          * triangleChoiceMonomial (triangleQuad4 q) mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial (triangleQuadrupleMultiplicity q) mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              refine MeasureTheory.integral_congr_ae ?_
              exact Filter.Eventually.of_forall (fun mu => by
                simpa [mul_assoc] using
                  congrArg
                    (fun z : ℝ => z * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
                    (triangleQuadrupleMonomial_eq_coordMonomial q mu))
    _ ≤ (gaussianEvenMomentEnvelope 6 ^ 6 / t ^ (6 : Nat)) * gaussianF (dim n) t := hbound

private lemma triangleChoiceSupport_incident_card_eq_two {n : ℕ}
    (ξ : TriangleChoice n) {i : Fin n} (hi : i ∈ triangleChoiceVertices ξ) :
    2 ≤ ((triangleChoiceSupport ξ).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
  rcases (by simpa [triangleChoiceVertices, triangleVertices] using hi) with rfl | rfl | rfl
  · have hsub :
        ({triangleEdge12 ξ.1 (triangleChoice_valid ξ), triangleEdge13 ξ.1 (triangleChoice_valid ξ)}
            : Finset (Cn3Torus.Edge n)) ⊆
          (triangleChoiceSupport ξ).filter
            (fun e => e ∈ Cn3Torus.edgesIncident n (triangleV1 ξ.1)) := by
      intro e he
      rcases (by simpa using he) with rfl | rfl
      · exact Finset.mem_filter.mpr
          ⟨by simp [triangleChoiceSupport, triangleEdgeSet],
            by
              simpa [triangleEdge12, triangleV1, triangleV2, eq_comm, or_left_comm, or_comm] using
                ((Cn3Torus.mem_edgesIncident_iff
                  (i := triangleV1 ξ.1)
                  (e := triangleEdge12 ξ.1 (triangleChoice_valid ξ))).2 (Or.inl rfl))⟩
      · exact Finset.mem_filter.mpr
          ⟨by simp [triangleChoiceSupport, triangleEdgeSet],
            by
              simpa [triangleEdge13, triangleV1, triangleV3, eq_comm, or_left_comm, or_comm] using
                ((Cn3Torus.mem_edgesIncident_iff
                  (i := triangleV1 ξ.1)
                  (e := triangleEdge13 ξ.1 (triangleChoice_valid ξ))).2 (Or.inl rfl))⟩
    have hcard :
        2 ≤ ({triangleEdge12 ξ.1 (triangleChoice_valid ξ), triangleEdge13 ξ.1 (triangleChoice_valid ξ)}
          : Finset (Cn3Torus.Edge n)).card := by
      simp [triangleEdge12_ne_13 ξ.1 (triangleChoice_valid ξ)]
    exact le_trans hcard (Finset.card_le_card hsub)
  · have hsub :
        ({triangleEdge12 ξ.1 (triangleChoice_valid ξ), triangleEdge23 ξ.1 (triangleChoice_valid ξ)}
            : Finset (Cn3Torus.Edge n)) ⊆
          (triangleChoiceSupport ξ).filter
            (fun e => e ∈ Cn3Torus.edgesIncident n (triangleV2 ξ.1)) := by
      intro e he
      rcases (by simpa using he) with rfl | rfl
      · exact Finset.mem_filter.mpr
          ⟨by simp [triangleChoiceSupport, triangleEdgeSet],
            by
              simpa [triangleEdge12, triangleV1, triangleV2, eq_comm, or_left_comm, or_comm] using
                ((Cn3Torus.mem_edgesIncident_iff
                  (i := triangleV2 ξ.1)
                  (e := triangleEdge12 ξ.1 (triangleChoice_valid ξ))).2 (Or.inr rfl))⟩
      · exact Finset.mem_filter.mpr
          ⟨by simp [triangleChoiceSupport, triangleEdgeSet],
            by
              simpa [triangleEdge23, triangleV2, triangleV3, eq_comm, or_left_comm, or_comm] using
                ((Cn3Torus.mem_edgesIncident_iff
                  (i := triangleV2 ξ.1)
                  (e := triangleEdge23 ξ.1 (triangleChoice_valid ξ))).2 (Or.inl rfl))⟩
    have hcard :
        2 ≤ ({triangleEdge12 ξ.1 (triangleChoice_valid ξ), triangleEdge23 ξ.1 (triangleChoice_valid ξ)}
          : Finset (Cn3Torus.Edge n)).card := by
      simp [triangleEdge12_ne_23 ξ.1 (triangleChoice_valid ξ)]
    exact le_trans hcard (Finset.card_le_card hsub)
  · have hsub :
        ({triangleEdge13 ξ.1 (triangleChoice_valid ξ), triangleEdge23 ξ.1 (triangleChoice_valid ξ)}
            : Finset (Cn3Torus.Edge n)) ⊆
          (triangleChoiceSupport ξ).filter
            (fun e => e ∈ Cn3Torus.edgesIncident n (triangleV3 ξ.1)) := by
      intro e he
      rcases (by simpa using he) with rfl | rfl
      · exact Finset.mem_filter.mpr
          ⟨by simp [triangleChoiceSupport, triangleEdgeSet],
            by
              simpa [triangleEdge13, triangleV1, triangleV3, eq_comm, or_left_comm, or_comm] using
                ((Cn3Torus.mem_edgesIncident_iff
                  (i := triangleV3 ξ.1)
                  (e := triangleEdge13 ξ.1 (triangleChoice_valid ξ))).2 (Or.inr rfl))⟩
      · exact Finset.mem_filter.mpr
          ⟨by simp [triangleChoiceSupport, triangleEdgeSet],
            by
              simpa [triangleEdge23, triangleV2, triangleV3, eq_comm, or_left_comm, or_comm] using
                ((Cn3Torus.mem_edgesIncident_iff
                  (i := triangleV3 ξ.1)
                  (e := triangleEdge23 ξ.1 (triangleChoice_valid ξ))).2 (Or.inr rfl))⟩
    have hcard :
        2 ≤ ({triangleEdge13 ξ.1 (triangleChoice_valid ξ), triangleEdge23 ξ.1 (triangleChoice_valid ξ)}
          : Finset (Cn3Torus.Edge n)).card := by
      simp [triangleEdge13_ne_23 ξ.1 (triangleChoice_valid ξ)]
    exact le_trans hcard (Finset.card_le_card hsub)

private lemma triangleQuadrupleMultiplicity_pos_of_mem_support {n : ℕ}
    (q : TriangleQuadruple n) {e : Cn3Torus.Edge n}
    (he : e ∈ triangleQuadrupleSupport q) :
    0 < triangleQuadrupleMultiplicity q e := by
  rcases (by simpa [triangleQuadrupleSupport] using he) with he₁ | he₂ | he₃ | he₄
  · rcases triangleChoiceMultiplicity_odd_of_mem_support (triangleQuad1 q) he₁ with ⟨k, hk⟩
    have hpos : 0 < triangleChoiceMultiplicity (triangleQuad1 q) e := by
      rw [hk]
      omega
    have hle : triangleChoiceMultiplicity (triangleQuad1 q) e ≤ triangleQuadrupleMultiplicity q e := by
      dsimp [triangleQuadrupleMultiplicity]
      omega
    exact lt_of_lt_of_le hpos hle
  · rcases triangleChoiceMultiplicity_odd_of_mem_support (triangleQuad2 q) he₂ with ⟨k, hk⟩
    have hpos : 0 < triangleChoiceMultiplicity (triangleQuad2 q) e := by
      rw [hk]
      omega
    have hle : triangleChoiceMultiplicity (triangleQuad2 q) e ≤ triangleQuadrupleMultiplicity q e := by
      dsimp [triangleQuadrupleMultiplicity]
      omega
    exact lt_of_lt_of_le hpos hle
  · rcases triangleChoiceMultiplicity_odd_of_mem_support (triangleQuad3 q) he₃ with ⟨k, hk⟩
    have hpos : 0 < triangleChoiceMultiplicity (triangleQuad3 q) e := by
      rw [hk]
      omega
    have hle : triangleChoiceMultiplicity (triangleQuad3 q) e ≤ triangleQuadrupleMultiplicity q e := by
      dsimp [triangleQuadrupleMultiplicity]
      omega
    exact lt_of_lt_of_le hpos hle
  · rcases triangleChoiceMultiplicity_odd_of_mem_support (triangleQuad4 q) he₄ with ⟨k, hk⟩
    have hpos : 0 < triangleChoiceMultiplicity (triangleQuad4 q) e := by
      rw [hk]
      omega
    have hle : triangleChoiceMultiplicity (triangleQuad4 q) e ≤ triangleQuadrupleMultiplicity q e := by
      dsimp [triangleQuadrupleMultiplicity]
      omega
    exact lt_of_lt_of_le hpos hle

private lemma triangleQuadrupleSupport_card_le_six_of_even {n : ℕ}
    (q : TriangleQuadruple n) (heven : triangleQuadrupleEven q) :
    (triangleQuadrupleSupport q).card ≤ 6 := by
  have hsum :
      (∑ e : Cn3Torus.Edge n, triangleQuadrupleMultiplicity q e) = 12 := by
    simpa using triangleQuadrupleMultiplicity_total_degree q
  have hlower :
      2 * (triangleQuadrupleSupport q).card
        ≤ ∑ e : Cn3Torus.Edge n, triangleQuadrupleMultiplicity q e := by
    calc
      2 * (triangleQuadrupleSupport q).card
        = ∑ e : Cn3Torus.Edge n, if e ∈ triangleQuadrupleSupport q then 2 else 0 := by
            rw [Nat.mul_comm]
            simp
      _ ≤ ∑ e : Cn3Torus.Edge n, triangleQuadrupleMultiplicity q e := by
            refine Finset.sum_le_sum ?_
            intro e he
            by_cases hemem : e ∈ triangleQuadrupleSupport q
            · rcases heven e with ⟨k, hk⟩
              have hpos : 0 < triangleQuadrupleMultiplicity q e :=
                triangleQuadrupleMultiplicity_pos_of_mem_support q hemem
              simp [hemem]
              rw [hk] at hpos ⊢
              omega
            · simp [hemem]
  have : 2 * (triangleQuadrupleSupport q).card ≤ 12 := by simpa [hsum] using hlower
  omega

private lemma triangleQuadruple_incident_card_ge_two_of_mem_vertices {n : ℕ}
    (q : TriangleQuadruple n) (heven : triangleQuadrupleEven q)
    {i : Fin n} (hi : i ∈ triangleQuadrupleVertices q) :
    2 ≤ ((triangleQuadrupleSupport q).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
  rcases (by simpa [triangleQuadrupleVertices] using hi) with hi₁ | hi₂ | hi₃ | hi₄
  · have hsub := (triangleChoiceSupport_subset_quadrupleSupport q).1
    have hmono :
        ((triangleChoiceSupport (triangleQuad1 q)).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card
          ≤ ((triangleQuadrupleSupport q).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
      exact Finset.card_mono (Finset.filter_subset_filter (fun e => e ∈ Cn3Torus.edgesIncident n i) hsub)
    exact le_trans (triangleChoiceSupport_incident_card_eq_two (triangleQuad1 q) hi₁) hmono
  · have hsub := (triangleChoiceSupport_subset_quadrupleSupport q).2.1
    have hmono :
        ((triangleChoiceSupport (triangleQuad2 q)).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card
          ≤ ((triangleQuadrupleSupport q).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
      exact Finset.card_mono (Finset.filter_subset_filter (fun e => e ∈ Cn3Torus.edgesIncident n i) hsub)
    exact le_trans (triangleChoiceSupport_incident_card_eq_two (triangleQuad2 q) hi₂) hmono
  · have hsub := (triangleChoiceSupport_subset_quadrupleSupport q).2.2.1
    have hmono :
        ((triangleChoiceSupport (triangleQuad3 q)).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card
          ≤ ((triangleQuadrupleSupport q).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
      exact Finset.card_mono (Finset.filter_subset_filter (fun e => e ∈ Cn3Torus.edgesIncident n i) hsub)
    exact le_trans (triangleChoiceSupport_incident_card_eq_two (triangleQuad3 q) hi₃) hmono
  · have hsub := (triangleChoiceSupport_subset_quadrupleSupport q).2.2.2
    have hmono :
        ((triangleChoiceSupport (triangleQuad4 q)).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card
          ≤ ((triangleQuadrupleSupport q).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
      exact Finset.card_mono (Finset.filter_subset_filter (fun e => e ∈ Cn3Torus.edgesIncident n i) hsub)
    exact le_trans (triangleChoiceSupport_incident_card_eq_two (triangleQuad4 q) hi₄) hmono

private lemma triangleQuadrupleVertices_card_le_support_card_of_even {n : ℕ}
    (q : TriangleQuadruple n) (heven : triangleQuadrupleEven q) :
    (triangleQuadrupleVertices q).card ≤ (triangleQuadrupleSupport q).card := by
  have hverts :
      2 * (triangleQuadrupleVertices q).card
        ≤ ∑ i : Fin n,
            ((triangleQuadrupleSupport q).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
    calc
      2 * (triangleQuadrupleVertices q).card
        = ∑ i : Fin n, if i ∈ triangleQuadrupleVertices q then 2 else 0 := by
            rw [Nat.mul_comm]
            simp
      _ ≤ ∑ i : Fin n,
            ((triangleQuadrupleSupport q).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
            refine Finset.sum_le_sum ?_
            intro i hi
            by_cases himem : i ∈ triangleQuadrupleVertices q
            · simpa [himem] using triangleQuadruple_incident_card_ge_two_of_mem_vertices q heven himem
            · simp [himem]
  have hsum := sum_filter_card_edgesIncident_eq_two_mul_card_aux (triangleQuadrupleSupport q)
  have : 2 * (triangleQuadrupleVertices q).card ≤ 2 * (triangleQuadrupleSupport q).card := by
    simpa [hsum] using hverts
  omega

private lemma triangleEvenQuadruples_eq_biUnion_activeFibers (n : ℕ) :
