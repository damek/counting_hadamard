              * Real.exp
                (-2 * t * Cn3Torus.sqNormEdge n mu
                  + 4 * t * quarticCorr n (matrixOfEdge n mu))
          ≤ (C * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * gaussianF (dim n) t := by
  obtain ⟨Ccub4, hCcub4_pos, hcub4⟩ := cubic_core_fourth_moment_bound_core
  refine ⟨Real.sqrt Ccub4 * Real.sqrt (Real.exp 32), by positivity, ?_⟩
  intro n t ht hbox hsmall8 hcube
  let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n t
  let μ : MeasureTheory.Measure (Cn3Torus.Edge n → ℝ) := MeasureTheory.volume.restrict core
  let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
      * Real.exp (-t * Cn3Torus.sqNormEdge n mu)
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp (-t * Cn3Torus.sqNormEdge n mu
      + 4 * t * quarticCorr n (matrixOfEdge n mu))
  have hf_cont : Continuous f := by
    have hcub :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
      (continuous_cubicT n).comp (continuous_matrixOfEdge n)
    have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [f]
    fun_prop
  have hg_cont : Continuous g := by
    have hquart :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
      (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
    have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [g]
    fun_prop
  have hf_sq_cont : Continuous (fun x => f x ^ (2 : Nat)) := hf_cont.pow 2
  have hg_sq_cont : Continuous (fun x => g x ^ (2 : Nat)) := hg_cont.pow 2
  have hf_sq_int : MeasureTheory.Integrable (fun x => f x ^ (2 : Nat)) μ := by
    simpa [μ, core, MeasureTheory.IntegrableOn] using
      ((hf_sq_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox))
  have hg_sq_int : MeasureTheory.Integrable (fun x => g x ^ (2 : Nat)) μ := by
    simpa [μ, core, MeasureTheory.IntegrableOn] using
      ((hg_sq_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox))
  have hf_ae : MeasureTheory.AEStronglyMeasurable f μ := hf_cont.aestronglyMeasurable
  have hg_ae : MeasureTheory.AEStronglyMeasurable g μ := hg_cont.aestronglyMeasurable
  have hf_nonneg : 0 ≤ᵐ[μ] f := Filter.Eventually.of_forall (fun x => by
    dsimp [f]
    positivity)
  have hg_nonneg : 0 ≤ᵐ[μ] g := Filter.Eventually.of_forall (fun x => by
    dsimp [g]
    positivity)
  have hcs := cs_helper μ hf_ae hg_ae hf_nonneg hg_nonneg hf_sq_int hg_sq_int
  have hleft_eq :
      ∫ x, f x * g x ∂μ
        = ∫ mu in core,
            (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
              * Real.exp
                (-2 * t * Cn3Torus.sqNormEdge n mu
                  + 4 * t * quarticCorr n (matrixOfEdge n mu)) := by
    simp [μ]
    refine MeasureTheory.integral_congr_ae ?_
    exact Filter.Eventually.of_forall (fun x => by
      dsimp [f, g]
      rw [mul_assoc, ← Real.exp_add]
      congr 1
      ring)
  have hAeq :
      ∫ x, f x ^ (2 : Nat) ∂μ
        = ∫ mu in core,
