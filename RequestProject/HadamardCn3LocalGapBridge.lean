  by_cases hxe : x = e
  · subst hxe
    simp [quinticMomentTupleSupport, quinticThreeOneOneTuple_multiplicity_e, heu, hev]
  · by_cases hxu : x = u
    · subst hxu
      simp [quinticMomentTupleSupport, quinticThreeOneOneTuple_multiplicity_u, heu, huv]
    · by_cases hxv : x = v
      · subst hxv
        simp [quinticMomentTupleSupport, quinticThreeOneOneTuple_multiplicity_v, hev, huv]
      · simp [quinticMomentTupleSupport, quinticThreeOneOneTuple,
          quinticMomentTupleMultiplicity_apply, hxe, hxu, hxv]

private lemma quinticMomentTupleMultiplicity_eq_threeOneOneTuple_of_support_eq_values {n : ℕ}
    (p : EdgeQuintuple n) (e0 u0 v0 : Cn3Torus.Edge n)
    (hsupp : quinticMomentTupleSupport p = ({e0, u0, v0} : Finset (Cn3Torus.Edge n)))
    (he3 : quinticMomentTupleMultiplicity p e0 = 3)
    (hu1 : quinticMomentTupleMultiplicity p u0 = 1)
    (hv1 : quinticMomentTupleMultiplicity p v0 = 1)
    (heu : e0 ≠ u0) (hev : e0 ≠ v0) (huv : u0 ≠ v0) :
    quinticMomentTupleMultiplicity p = quinticMomentTupleMultiplicity (quinticThreeOneOneTuple e0 u0 v0) := by
  funext x
  by_cases hxe : x = e0
  · subst x
    rw [he3, quinticThreeOneOneTuple_multiplicity_e e0 u0 v0 heu hev]
  · by_cases hxu : x = u0
    · subst x
      rw [hu1, quinticThreeOneOneTuple_multiplicity_u e0 u0 v0 heu huv]
    · by_cases hxv : x = v0
      · subst x
        rw [hv1, quinticThreeOneOneTuple_multiplicity_v e0 u0 v0 hev huv]
      · have hxnot : x ∉ quinticMomentTupleSupport p := by
          have hxnot' : x ∉ ({e0, u0, v0} : Finset (Cn3Torus.Edge n)) := by
            simp [hxe, hxu, hxv]
          simpa [hsupp] using hxnot'
        have hxnotq : x ∉ quinticMomentTupleSupport (quinticThreeOneOneTuple e0 u0 v0) := by
          rw [quinticThreeOneOneTuple_support e0 u0 v0 heu hev huv]
          simp [hxe, hxu, hxv]
        rw [quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support p hxnot,
          quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support
            (quinticThreeOneOneTuple e0 u0 v0) hxnotq]

