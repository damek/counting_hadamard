/-!
## Local-Gap Bridge Layer

This file contains the shared local-gap support used by both the residual and fixed-`n`
modules.

The first public theorems a reader should inspect are:

- `gaussianScale_eq_texPrefactor_mul_gaussianF`
- `exactCore_correctedCore_gap_abs_le_gaussianF_short`
- `correctedCore_quarticCore_gap_abs_le_gaussianF_short`
- `quarticCore_cubicCore_gap_abs_le_gaussianF_short`

Most other declarations here are implementation detail for those bridge statements or
for downstream residual/fixed-`n` estimates.
-/

/-- The Gaussian normalizer factors exactly as the tex prefactor times `gaussianF`. -/
lemma gaussianScale_eq_texPrefactor_mul_gaussianF
    (n : ℕ) (hn : 2 ≤ n) (t : ℝ) (ht : 0 < t) :
    Cn3Torus.texPrefactor n * gaussianF (dim n) t = gaussianScale n t := by
  unfold Cn3Torus.texPrefactor gaussianF gaussianScale dim
  set d : ℕ := Cn3Torus.d n
  set a : ℝ := (d : ℝ) / 2
  have hsub : n ≤ 2 * Nat.choose n 2 := by
    rcases eq_or_lt_of_le hn with h2 | h3
    · simpa [h2]
    · exact Cn3Torus.n_le_two_mul_d n (Nat.succ_le_of_lt h3)
  have hExp : ((2 * Nat.choose n 2 - n + 1 : Nat) : ℤ) = (2 * ↑(Nat.choose n 2) - ↑n + 1 : ℤ) := by
    rw [Nat.cast_add, Nat.cast_sub hsub, Nat.cast_one]
    norm_num
  rw [← hExp, zpow_natCast]
  have h2pi_nonneg : 0 ≤ (2 * Real.pi : ℝ) := by positivity [Real.pi_pos]
  have hcoeff : ((2 * Real.pi : ℝ) ^ d) = (4 * Real.pi ^ (2 : Nat)) ^ a := by
    calc
      ((2 * Real.pi : ℝ) ^ d) = (2 * Real.pi : ℝ) ^ (d : ℝ) := by
        symm
        simpa using (Real.rpow_natCast (2 * Real.pi : ℝ) d)
      _ = (2 * Real.pi : ℝ) ^ (2 * a) := by
        have : (d : ℝ) = 2 * a := by
          dsimp [a]
          ring
        rw [this]
      _ = (((2 * Real.pi : ℝ) ^ (2 : Nat)) ^ a) := by
        simpa using (Real.rpow_natCast_mul h2pi_nonneg 2 a)
      _ = (4 * Real.pi ^ (2 : Nat)) ^ a := by
        congr 1
        ring
  rw [hcoeff]
  have hA_nonneg : 0 ≤ Real.pi / (2 * t) := by positivity [Real.pi_pos, ht]
  have hB_nonneg : 0 ≤ 4 * Real.pi ^ (2 : Nat) := by positivity [Real.pi_pos]
  have hdivpow :
      (Real.pi / (2 * t)) ^ a / (4 * Real.pi ^ (2 : Nat)) ^ a
        = ((Real.pi / (2 * t)) / (4 * Real.pi ^ (2 : Nat))) ^ a := by
    exact (Real.div_rpow hA_nonneg hB_nonneg a).symm
  calc
    2 ^ (2 * Nat.choose n 2 - n + 1 : Nat) / (4 * Real.pi ^ (2 : Nat)) ^ a
        * (Real.pi / (2 * t)) ^ a
      = 2 ^ (2 * Nat.choose n 2 - n + 1 : Nat)
          * ((Real.pi / (2 * t)) ^ a / (4 * Real.pi ^ (2 : Nat)) ^ a) := by
            ring
    _ = 2 ^ (2 * Nat.choose n 2 - n + 1 : Nat)
          * (((Real.pi / (2 * t)) / (4 * Real.pi ^ (2 : Nat))) ^ a) := by
            rw [hdivpow]
    _ = 2 ^ (2 * Nat.choose n 2 - n + 1 : Nat) * ((8 * Real.pi * t) ^ (-a)) := by
          congr 1
          have hbase :
              (Real.pi / (2 * t)) / (4 * Real.pi ^ (2 : Nat)) = (8 * Real.pi * t)⁻¹ := by
            field_simp [Real.pi_ne_zero, ht.ne']
            ring
          rw [hbase]
          rw [Real.inv_rpow (show 0 ≤ 8 * Real.pi * t by positivity [Real.pi_pos, ht]), Real.rpow_neg]
          positivity [Real.pi_pos, ht]
    _ = 2 ^ (2 * Nat.choose n 2 - n + 1 : Nat)
          * (8 * Real.pi * t) ^ (((-(Nat.choose n 2 : ℝ)) / 2)) := by
          have hneg : (-a : ℝ) = (-(Nat.choose n 2 : ℝ)) / 2 := by
            simp [a, d, Cn3Torus.d]
            ring
          rw [hneg]

/-- The truncated Gaussian mass is nonnegative. -/
private lemma coreMass_nonneg (d : ℕ) (t : ℝ) : 0 ≤ coreMass d t := by
  unfold coreMass
  exact MeasureTheory.integral_nonneg (fun x => by
    by_cases hx : (∑ i : Fin d, x i ^ (2 : Nat)) ≤ (d : ℝ) / t
    · simp [hx]
      positivity
    · simp [hx])

/-- The inner-core Gaussian mass is bounded above by the full Gaussian mass. -/
lemma coreMass_le_gaussianF (n : ℕ) (t : ℝ) (ht : 0 < t) :
    coreMass (dim n) t ≤ gaussianF (dim n) t := by
  let S : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n t
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  have hS : MeasurableSet S := by
    simpa [S] using measurableSet_edgeCoreRegion n t
  have hg_int : MeasureTheory.Integrable g := by
    simpa [g, mul_assoc] using gaussian_integrable_edge n (2 * t) (by positivity)
  have hg_ind : MeasureTheory.Integrable (Set.indicator S g) := hg_int.indicator hS
  have hpoint :
      ∀ᵐ mu : Cn3Torus.Edge n → ℝ ∂MeasureTheory.volume, Set.indicator S g mu ≤ g mu := by
    exact Filter.Eventually.of_forall (fun mu => by
      by_cases hmu : mu ∈ S
      · simp [S, g, hmu]
      · simp [S, g, hmu]
        positivity)
  have hmono :
      ∫ mu : Cn3Torus.Edge n → ℝ, Set.indicator S g mu
        ≤ ∫ mu : Cn3Torus.Edge n → ℝ, g mu := by
    exact MeasureTheory.integral_mono_ae hg_ind hg_int hpoint
  have hcore :
      coreMass (dim n) t = ∫ mu : Cn3Torus.Edge n → ℝ, Set.indicator S g mu := by
    calc
      coreMass (dim n) t = ∫ mu in edgeCoreRegion n t, g mu := by
        simpa [g] using (coreMass_eq_edgeCoreRegion_gaussian_integral n t)
      _ = ∫ mu : Cn3Torus.Edge n → ℝ, Set.indicator S g mu := by
        symm
        simpa [S, g] using
          (MeasureTheory.integral_indicator (μ := MeasureTheory.volume) (f := g) hS)
  have hfull : ∫ mu : Cn3Torus.Edge n → ℝ, g mu = gaussianF (dim n) t := by
    simpa [g] using gaussian_integral_formula_edge n (2 * t) (by positivity)
  rw [hcore]
  simpa [hfull] using hmono

/-- The edge-space dimension is at most quadratic in `n`. -/
private lemma dim_le_sq (n : ℕ) : (dim n : ℝ) ≤ (n : ℝ) ^ (2 : Nat) := by
  unfold dim
  exact_mod_cast (Nat.choose_le_pow n 2)

/-- For `n ≥ 3`, the edge-space dimension is at least linear in `n`. -/
private lemma half_n_le_dim (n : ℕ) (hn : 3 ≤ n) : (n : ℝ) / 2 ≤ (dim n : ℝ) := by
  have hnat : n ≤ 2 * Nat.choose n 2 := Cn3Torus.n_le_two_mul_d n hn
  have hreal : (n : ℝ) ≤ 2 * (dim n : ℝ) := by
    simpa [dim, two_mul] using (show (n : ℝ) ≤ ((2 * Nat.choose n 2 : ℕ) : ℝ) by exact_mod_cast hnat)
  nlinarith

/-- For `n ≥ 3`, the edge-space dimension is at least one. -/
lemma one_le_dim_of_three_le (n : ℕ) (hn : 3 ≤ n) : 1 ≤ dim n := by
  have hnd : n ≤ 2 * dim n := Cn3Torus.n_le_two_mul_d n hn
  have hone : 1 ≤ n := by omega
  have htwo : 1 ≤ 2 * dim n := le_trans hone hnd
  have hdim_ne : dim n ≠ 0 := by
    intro hdim0
    simp [hdim0] at htwo
  exact Nat.succ_le_of_lt (Nat.pos_of_ne_zero hdim_ne)

/-- For `n ≥ 2`, the edge-space dimension is at least one. -/
private lemma one_le_dim_of_two_le (n : ℕ) (hn : 2 ≤ n) : 1 ≤ dim n := by
  have hchoose_pos : 0 < Nat.choose n 2 := Nat.choose_pos hn
  exact Nat.succ_le_of_lt hchoose_pos

/-- For `n ≥ 3`, the edge-space dimension is at least `3`. -/
private lemma n_sq_le_four_mul_dim {n : ℕ} (hn : 2 ≤ n) :
    (n : ℝ) ^ (2 : Nat) ≤ 4 * (dim n : ℝ) := by
  have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := by positivity
  have hn_le_twice : (n : ℝ) ≤ 2 * ((n : ℝ) - 1) := by
    have hn_two : (2 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    nlinarith
  calc
    (n : ℝ) ^ (2 : Nat)
      = (n : ℝ) * (n : ℝ) := by ring
    _ ≤ (n : ℝ) * (2 * ((n : ℝ) - 1)) := by
          gcongr
    _ = 4 * (dim n : ℝ) := by
          simp [dim, Nat.cast_choose_two]
          ring

/-- The standard annulus factor `exp(-dim/8)` is at most `exp(-n^2/32)` once
`n ≥ 2`. -/
lemma exp_neg_dim_over_eight_le_exp_neg_nsq_div_thirty_two {n : ℕ} (hn : 2 ≤ n) :
    Real.exp (-((dim n : ℝ) / 8)) ≤ Real.exp (-((n : ℝ) ^ (2 : Nat) / 32)) := by
  have hn_sq : (n : ℝ) ^ (2 : Nat) ≤ 4 * (dim n : ℝ) := n_sq_le_four_mul_dim hn
  have hineq : -((dim n : ℝ) / 8) ≤ -((n : ℝ) ^ (2 : Nat) / 32) := by
    nlinarith
  exact Real.exp_le_exp.mpr hineq

/-- A generic conversion from exponential decay in `dim n` to exponential decay in `n²`,
using `dim n ≥ n² / 4`. -/
lemma exp_neg_c_mul_dim_le_exp_neg_c_div_four_mul_nsq
    {n : ℕ} (hn : 2 ≤ n) {c : ℝ} (hc : 0 ≤ c) :
    Real.exp (-(c * (dim n : ℝ)))
      ≤ Real.exp (-((c / 4) * (n : ℝ) ^ (2 : Nat))) := by
  have hn_sq : (n : ℝ) ^ (2 : Nat) ≤ 4 * (dim n : ℝ) := n_sq_le_four_mul_dim hn
  have hineq : -(c * (dim n : ℝ)) ≤ -((c / 4) * (n : ℝ) ^ (2 : Nat)) := by
    nlinarith
  exact Real.exp_le_exp.mpr hineq

/-- At the `t \ge C n^3` scale, the core parameter `dim / t` is `O(1 / (Cn))`. -/
private lemma dim_div_t_le_inv_C_mul_inv_n
    (n t : ℕ) {C : ℝ}
    (hC_pos : 0 < C) (hn_pos : 0 < n)
    (ht : (t : ℝ) ≥ C * (n : ℝ) ^ (3 : Nat)) :
    (dim n : ℝ) / (t : ℝ) ≤ 1 / (C * (n : ℝ)) := by
  have hbase_pos : 0 < C * (n : ℝ) ^ (3 : Nat) := by positivity
  have ht_pos : (0 : ℝ) < (t : ℝ) := by
    linarith
  have htn :
      1 / (t : ℝ) ≤ 1 / (C * (n : ℝ) ^ (3 : Nat)) := by
    exact one_div_le_one_div_of_le hbase_pos ht
  calc
    (dim n : ℝ) / (t : ℝ)
      = (dim n : ℝ) * (1 / (t : ℝ)) := by field_simp [ht_pos.ne']
    _ ≤ (dim n : ℝ) * (1 / (C * (n : ℝ) ^ (3 : Nat))) := by
          gcongr
    _ ≤ (n : ℝ) ^ (2 : Nat) * (1 / (C * (n : ℝ) ^ (3 : Nat))) := by
          gcongr
          exact dim_le_sq n
    _ = 1 / (C * (n : ℝ)) := by
          field_simp [hC_pos.ne', (show (n : ℝ) ≠ 0 by exact_mod_cast hn_pos.ne')]

/-- At the `t \ge C n^3` scale, `dim / t` is `O(1/C)`. -/
lemma dim_div_t_le_inv_C
    (n t : ℕ) {C : ℝ}
    (hC_pos : 0 < C) (hC_one : 1 ≤ C) (hn_pos : 0 < n)
    (ht : (t : ℝ) ≥ C * (n : ℝ) ^ (3 : Nat)) :
    (dim n : ℝ) / (t : ℝ) ≤ 1 / C := by
  have hn_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_pos
  calc
    (dim n : ℝ) / (t : ℝ) ≤ 1 / (C * (n : ℝ)) :=
      dim_div_t_le_inv_C_mul_inv_n n t hC_pos hn_pos ht
    _ ≤ 1 / C := by
          have hden : C ≤ C * (n : ℝ) := by nlinarith
          exact one_div_le_one_div_of_le (by positivity) hden

/-- At the `t \ge C n^3` scale, the quartic `n (dim/t)^2` parameter is `O(1/C)`. -/
lemma n_mul_sq_dim_div_t_le_inv_C
    (n t : ℕ) {C : ℝ}
    (hC_pos : 0 < C) (hC_one : 1 ≤ C) (hn_pos : 0 < n)
    (ht : (t : ℝ) ≥ C * (n : ℝ) ^ (3 : Nat)) :
    (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ 1 / C := by
  have hn_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_pos
  have hmain :=
    dim_div_t_le_inv_C_mul_inv_n n t hC_pos hn_pos ht
  calc
    (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))
      ≤ (n : ℝ) * (1 / (C * (n : ℝ))) ^ (2 : Nat) := by
          gcongr
    _ = 1 / (C ^ (2 : Nat) * (n : ℝ)) := by
          field_simp [hC_pos.ne', (show (n : ℝ) ≠ 0 by exact_mod_cast hn_pos.ne')]
    _ ≤ 1 / C := by
          have hden : C ≤ C ^ (2 : Nat) * (n : ℝ) := by
            have hC_sq : C ≤ C ^ (2 : Nat) := by
              nlinarith [hC_one]
            nlinarith
          exact one_div_le_one_div_of_le (by positivity) hden

/-- At the `t \ge C n^3` scale, the cubic bridge parameter `n^3/t` is `O(1/C)`. -/
lemma n_cube_div_t_le_inv_C
    (n t : ℕ) {C : ℝ}
    (hC_pos : 0 < C) (hn_pos : 0 < n)
    (ht : (t : ℝ) ≥ C * (n : ℝ) ^ (3 : Nat)) :
    (n : ℝ) ^ (3 : Nat) / (t : ℝ) ≤ 1 / C := by
  have ht_pos : (0 : ℝ) < (t : ℝ) := by
    have hmain : 0 < C * (n : ℝ) ^ (3 : Nat) := by positivity
    linarith
  have htn :
      1 / (t : ℝ) ≤ 1 / (C * (n : ℝ) ^ (3 : Nat)) := by
    exact one_div_le_one_div_of_le (by positivity) ht
  calc
    (n : ℝ) ^ (3 : Nat) / (t : ℝ)
      = (n : ℝ) ^ (3 : Nat) * (1 / (t : ℝ)) := by field_simp [ht_pos.ne']
    _ ≤ (n : ℝ) ^ (3 : Nat) * (1 / (C * (n : ℝ) ^ (3 : Nat))) := by
          gcongr
    _ = 1 / C := by
          field_simp [hC_pos.ne', (show (n : ℝ) ≠ 0 by exact_mod_cast hn_pos.ne')]

namespace CoordSplit

variable {α : Type*} [Fintype α] [DecidableEq α]

/-- The distinguished coordinate sub-singleton. Using `abbrev` keeps the standard
subtype instances available without extra boilerplate. -/
private abbrev CoordEq (a0 : α) := {a : α // a = a0}

/-- The complement of the distinguished coordinate. -/
private abbrev CoordNe (a0 : α) := {a : α // a ≠ a0}

/-- The singleton fiber over the distinguished coordinate is equivalent to `Unit`. -/
private def coordEqEquivUnit (a0 : α) : CoordEq a0 ≃ Unit where
  toFun _ := ()
  invFun _ := ⟨a0, rfl⟩
  left_inv := by
    intro a
    rcases a with ⟨a, rfl⟩
    rfl
  right_inv := by
    intro u
    cases u
    rfl

/-- Split a finite coordinate family into one distinguished coordinate and the rest. -/
private def splitAt (a0 : α) : (α → ℝ) ≃ᵐ ℝ × (CoordNe a0 → ℝ) := by
  let e : α ≃ CoordEq a0 ⊕ CoordNe a0 :=
    (Equiv.sumCompl (fun a : α => a = a0)).symm
  let reindex1 : (α → ℝ) ≃ᵐ (CoordEq a0 ⊕ CoordNe a0 → ℝ) :=
    MeasurableEquiv.piCongrLeft (fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ) e
  let reindex2 : (CoordEq a0 ⊕ CoordNe a0 → ℝ) ≃ᵐ (CoordEq a0 → ℝ) × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.sumPiEquivProdPi (fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ)
  let reindex3 : (CoordEq a0 → ℝ) × (CoordNe a0 → ℝ) ≃ᵐ (Unit → ℝ) × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.prodCongr
      (MeasurableEquiv.piCongrLeft (fun _ : Unit => ℝ) (coordEqEquivUnit a0))
      (MeasurableEquiv.refl (CoordNe a0 → ℝ))
  let reindex4 : (Unit → ℝ) × (CoordNe a0 → ℝ) ≃ᵐ ℝ × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.prodCongr (MeasurableEquiv.funUnique Unit ℝ)
      (MeasurableEquiv.refl (CoordNe a0 → ℝ))
  exact reindex1.trans (reindex2.trans (reindex3.trans reindex4))

private lemma splitAt_fst (a0 : α) (x : α → ℝ) :
    (splitAt a0 x).1 = x a0 := by
  unfold splitAt
  let e : α ≃ CoordEq a0 ⊕ CoordNe a0 :=
    (Equiv.sumCompl (fun a : α => a = a0)).symm
  let reindex1 : (α → ℝ) ≃ᵐ (CoordEq a0 ⊕ CoordNe a0 → ℝ) :=
    MeasurableEquiv.piCongrLeft (fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ) e
  let reindex2 : (CoordEq a0 ⊕ CoordNe a0 → ℝ) ≃ᵐ (CoordEq a0 → ℝ) × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.sumPiEquivProdPi (fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ)
  let reindex3 : (CoordEq a0 → ℝ) × (CoordNe a0 → ℝ) ≃ᵐ (Unit → ℝ) × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.prodCongr
      (MeasurableEquiv.piCongrLeft (fun _ : Unit => ℝ) (coordEqEquivUnit a0))
      (MeasurableEquiv.refl (CoordNe a0 → ℝ))
  let reindex4 : (Unit → ℝ) × (CoordNe a0 → ℝ) ≃ᵐ ℝ × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.prodCongr (MeasurableEquiv.funUnique Unit ℝ)
      (MeasurableEquiv.refl (CoordNe a0 → ℝ))
  have h1 : reindex1 x (Sum.inl ⟨a0, rfl⟩) = x a0 := by
    simpa [reindex1] using
      (Equiv.piCongrLeft_apply
        (P := fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ) e x (Sum.inl ⟨a0, rfl⟩))
  have h2 : (reindex2 (reindex1 x)).1 ⟨a0, rfl⟩ = reindex1 x (Sum.inl ⟨a0, rfl⟩) := by
    simp [reindex2, MeasurableEquiv.sumPiEquivProdPi]
  have h3 :
      (reindex3 (reindex2 (reindex1 x))).1 PUnit.unit = (reindex2 (reindex1 x)).1 ⟨a0, rfl⟩ := by
    simpa [reindex3] using
      (Equiv.piCongrLeft_apply
        (P := fun _ : Unit => ℝ) (coordEqEquivUnit a0) ((reindex2 (reindex1 x)).1) PUnit.unit)
  have h4 :
      (reindex4 (reindex3 (reindex2 (reindex1 x)))).1
        = (reindex3 (reindex2 (reindex1 x))).1 PUnit.unit := by
    change (MeasurableEquiv.funUnique Unit ℝ) ((reindex3 (reindex2 (reindex1 x))).1) = _
    rfl
  calc
    (reindex4 (reindex3 (reindex2 (reindex1 x)))).1
        = (reindex3 (reindex2 (reindex1 x))).1 PUnit.unit := h4
    _ = (reindex2 (reindex1 x)).1 ⟨a0, rfl⟩ := h3
    _ = reindex1 x (Sum.inl ⟨a0, rfl⟩) := h2
    _ = x a0 := h1

private lemma splitAt_snd (a0 : α) (x : α → ℝ) (aa : CoordNe a0) :
    (splitAt a0 x).2 aa = x aa.1 := by
  unfold splitAt
  let e : α ≃ CoordEq a0 ⊕ CoordNe a0 :=
    (Equiv.sumCompl (fun a : α => a = a0)).symm
  let reindex1 : (α → ℝ) ≃ᵐ (CoordEq a0 ⊕ CoordNe a0 → ℝ) :=
    MeasurableEquiv.piCongrLeft (fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ) e
  let reindex2 : (CoordEq a0 ⊕ CoordNe a0 → ℝ) ≃ᵐ (CoordEq a0 → ℝ) × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.sumPiEquivProdPi (fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ)
  let reindex3 : (CoordEq a0 → ℝ) × (CoordNe a0 → ℝ) ≃ᵐ (Unit → ℝ) × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.prodCongr
      (MeasurableEquiv.piCongrLeft (fun _ : Unit => ℝ) (coordEqEquivUnit a0))
      (MeasurableEquiv.refl (CoordNe a0 → ℝ))
  let reindex4 : (Unit → ℝ) × (CoordNe a0 → ℝ) ≃ᵐ ℝ × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.prodCongr (MeasurableEquiv.funUnique Unit ℝ)
      (MeasurableEquiv.refl (CoordNe a0 → ℝ))
  have h1 : reindex1 x (Sum.inr aa) = x aa.1 := by
    simpa [reindex1] using
      (Equiv.piCongrLeft_apply
        (P := fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ) e x (Sum.inr aa))
  have h2 : (reindex2 (reindex1 x)).2 aa = reindex1 x (Sum.inr aa) := by
    simp [reindex2, MeasurableEquiv.sumPiEquivProdPi]
  have h3 : (reindex3 (reindex2 (reindex1 x))).2 aa = (reindex2 (reindex1 x)).2 aa := by
    rfl
  have h4 : (reindex4 (reindex3 (reindex2 (reindex1 x)))).2 aa = (reindex3 (reindex2 (reindex1 x))).2 aa := by
    rfl
  calc
    (reindex4 (reindex3 (reindex2 (reindex1 x)))).2 aa
        = (reindex3 (reindex2 (reindex1 x))).2 aa := h4
    _ = (reindex2 (reindex1 x)).2 aa := h3
    _ = reindex1 x (Sum.inr aa) := h2
    _ = x aa.1 := h1

private lemma splitAt_measurePreserving (a0 : α) :
    MeasureTheory.MeasurePreserving (splitAt a0) MeasureTheory.volume MeasureTheory.volume := by
  unfold splitAt
  let e : α ≃ CoordEq a0 ⊕ CoordNe a0 :=
    (Equiv.sumCompl (fun a : α => a = a0)).symm
  let reindex1 : (α → ℝ) ≃ᵐ (CoordEq a0 ⊕ CoordNe a0 → ℝ) :=
    MeasurableEquiv.piCongrLeft (fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ) e
  let reindex2 : (CoordEq a0 ⊕ CoordNe a0 → ℝ) ≃ᵐ (CoordEq a0 → ℝ) × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.sumPiEquivProdPi (fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ)
  let reindex3 : (CoordEq a0 → ℝ) × (CoordNe a0 → ℝ) ≃ᵐ (Unit → ℝ) × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.prodCongr
      (MeasurableEquiv.piCongrLeft (fun _ : Unit => ℝ) (coordEqEquivUnit a0))
      (MeasurableEquiv.refl (CoordNe a0 → ℝ))
  let reindex4 : (Unit → ℝ) × (CoordNe a0 → ℝ) ≃ᵐ ℝ × (CoordNe a0 → ℝ) :=
    MeasurableEquiv.prodCongr (MeasurableEquiv.funUnique Unit ℝ)
      (MeasurableEquiv.refl (CoordNe a0 → ℝ))
  have hpres1 :
      MeasureTheory.MeasurePreserving reindex1 MeasureTheory.volume MeasureTheory.volume := by
    simpa [reindex1] using
      (MeasureTheory.volume_measurePreserving_piCongrLeft
        (fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ) e)
  have hpres2 :
      MeasureTheory.MeasurePreserving reindex2 MeasureTheory.volume MeasureTheory.volume := by
    simpa [reindex2] using
      (MeasureTheory.volume_measurePreserving_sumPiEquivProdPi
        (fun _ : CoordEq a0 ⊕ CoordNe a0 => ℝ))
  have hpres3 :
      MeasureTheory.MeasurePreserving reindex3 MeasureTheory.volume MeasureTheory.volume := by
    simpa [reindex3, MeasurableEquiv.prodCongr] using
      ((MeasureTheory.volume_measurePreserving_piCongrLeft
          (fun _ : Unit => ℝ) (coordEqEquivUnit a0)).prod
        (MeasureTheory.MeasurePreserving.id
          (MeasureTheory.volume : MeasureTheory.Measure (CoordNe a0 → ℝ))))
  have hpres4 :
      MeasureTheory.MeasurePreserving reindex4 MeasureTheory.volume MeasureTheory.volume := by
    simpa [reindex4, MeasurableEquiv.prodCongr] using
      (volume_measurePreserving_funUnique_real.prod
        (MeasureTheory.MeasurePreserving.id
          (MeasureTheory.volume : MeasureTheory.Measure (CoordNe a0 → ℝ))))
  exact hpres4.comp (hpres3.comp (hpres2.comp hpres1))

/-- The coordinatewise squared norm on a finite family of real variables. -/
private def sqNorm (x : α → ℝ) : ℝ :=
  ∑ a : α, x a ^ (2 : Nat)

private lemma sum_coords_split (a0 : α) (f : α → ℝ) :
    (∑ a : α, f a) = f a0 + ∑ aa : CoordNe a0, f aa.1 := by
  let ecompl : α ≃ CoordEq a0 ⊕ CoordNe a0 :=
    (Equiv.sumCompl (fun a : α => a = a0)).symm
  calc
    (∑ a : α, f a)
      = ∑ s : CoordEq a0 ⊕ CoordNe a0,
          match s with
          | Sum.inl a => f a.1
          | Sum.inr b => f b.1 := by
            exact Fintype.sum_equiv ecompl
              (fun a : α => f a)
              (fun s : CoordEq a0 ⊕ CoordNe a0 =>
                match s with
                | Sum.inl a => f a.1
                | Sum.inr b => f b.1)
              (by
                intro a
                cases h : ecompl a with
                | inl aa =>
                    have ha : a = aa.1 := by
                      simpa [ecompl] using congrArg ecompl.symm h
                    simp [ha]
                | inr aa =>
                    have ha : a = aa.1 := by
                      simpa [ecompl] using congrArg ecompl.symm h
                    simp [ha])
    _ = (∑ a : CoordEq a0, f a.1) + ∑ aa : CoordNe a0, f aa.1 := by
          rw [Fintype.sum_sum_type]
    _ = f a0 + ∑ aa : CoordNe a0, f aa.1 := by
          letI : Subsingleton (CoordEq a0) := by
            refine ⟨?_⟩
            intro a b
            apply Subtype.ext
            simpa [a.2, b.2]
          rw [Fintype.sum_subsingleton (f := fun a : CoordEq a0 => f a.1) ⟨a0, rfl⟩]

private lemma sqNorm_splitAt (a0 : α) (x : α → ℝ) :
    sqNorm x = (splitAt a0 x).1 ^ (2 : Nat) + sqNorm ((splitAt a0 x).2) := by
  unfold sqNorm
  rw [sum_coords_split a0 (fun a => x a ^ (2 : Nat))]
  congr 1
  · simpa [splitAt_fst]
  · refine Finset.sum_congr rfl ?_
    intro aa haa
    simpa [splitAt_snd]

/-- Splitting along one coordinate turns product-separable integrals into a product
of lower-dimensional integrals. -/
private lemma integral_split_prod (a0 : α) (f : ℝ → ℝ) (g : (CoordNe a0 → ℝ) → ℝ) :
    ∫ x : α → ℝ, f ((splitAt a0 x).1) * g ((splitAt a0 x).2)
      = (∫ z : ℝ, f z) * ∫ y : (CoordNe a0 → ℝ), g y := by
  let h : ℝ × (CoordNe a0 → ℝ) → ℝ := fun p => f p.1 * g p.2
  have htransport :=
    MeasureTheory.MeasurePreserving.integral_comp (splitAt_measurePreserving a0)
      (splitAt a0).measurableEmbedding h
  calc
    ∫ x : α → ℝ, f ((splitAt a0 x).1) * g ((splitAt a0 x).2)
      = ∫ x : α → ℝ, h (splitAt a0 x) := by
          rfl
    _ = ∫ p : ℝ × (CoordNe a0 → ℝ), h p := by
          simpa [h] using htransport
    _ = (∫ z : ℝ, f z) * ∫ y : (CoordNe a0 → ℝ), g y := by
          simpa [h] using (MeasureTheory.integral_prod_mul f g)

end CoordSplit

/-- Odd Gaussian moments vanish by symmetry. -/
private lemma gaussian_one_dim_odd_moment_zero (k : ℕ) (t : ℝ) :
    ∫ x : ℝ, x ^ (2 * k + 1) * Real.exp (-2 * t * x ^ (2 : Nat)) = 0 := by
  let f : ℝ → ℝ := fun x => x ^ (2 * k + 1) * Real.exp (-2 * t * x ^ (2 : Nat))
  have hnegfun : ∀ x : ℝ, f (-x) = -f x := by
    intro x
    dsimp [f]
    have heven : (-x) ^ (2 * k) = x ^ (2 * k) := by
      calc
        (-x) ^ (2 * k) = ((-x) ^ (2 : Nat)) ^ k := by
          rw [pow_mul]
        _ = (x ^ (2 : Nat)) ^ k := by
          ring_nf
        _ = x ^ (2 * k) := by
          rw [pow_mul]
    have hoddpow : (-x) ^ (2 * k + 1) = -(x ^ (2 * k + 1)) := by
      calc
        (-x) ^ (2 * k + 1) = (-x) ^ (2 * k) * (-x) := by
          rw [show (2 * k + 1 : ℕ) = 2 * k + 1 by omega, pow_add]
          simp
        _ = x ^ (2 * k) * (-x) := by
          rw [heven]
        _ = -(x ^ (2 * k) * x) := by
          ring
        _ = -(x ^ (2 * k + 1)) := by
          rw [show (2 * k + 1 : ℕ) = 2 * k + 1 by omega, pow_add]
          simp
    rw [hoddpow]
    have hsq : (-x) ^ (2 : Nat) = x ^ (2 : Nat) := by
      ring
    rw [hsq]
    ring
  have hsym :
      ∫ x : ℝ, f (-x) = ∫ x : ℝ, f x := by
    simpa using
      (MeasureTheory.integral_neg_eq_self f (MeasureTheory.volume : MeasureTheory.Measure ℝ))
  have hnegint :
      ∫ x : ℝ, f (-x) = -∫ x : ℝ, f x := by
    calc
      ∫ x : ℝ, f (-x) = ∫ x : ℝ, -f x := by
        refine MeasureTheory.integral_congr_ae ?_
        exact Filter.Eventually.of_forall (fun x => by simp [hnegfun x])
      _ = -∫ x : ℝ, f x := by
            rw [MeasureTheory.integral_neg]
  linarith

/-- The 1D Gaussian second moment is exactly a `1 / (4t)` fraction of the Gaussian mass. -/
private lemma gaussian_one_dim_sq_moment_factor (t : ℝ) (ht : 0 < t) :
    ∫ x : ℝ, x ^ (2 : Nat) * Real.exp (-2 * t * x ^ (2 : Nat))
      = (1 / (4 * t)) * ∫ x : ℝ, Real.exp (-2 * t * x ^ (2 : Nat)) := by
  have hmoment := gaussian_one_dim_scaled_moment 1 t ht
  have hgauss : ∫ x : ℝ, Real.exp (-2 * t * x ^ (2 : Nat)) = Real.sqrt (Real.pi / (2 * t)) := by
    simpa [pow_two] using integral_gaussian (2 * t)
  calc
    ∫ x : ℝ, x ^ (2 : Nat) * Real.exp (-2 * t * x ^ (2 : Nat))
      = (((Nat.doubleFactorial (2 * 1 - 1) : ℕ) : ℝ) / (2 ^ 1 * (2 * t) ^ 1))
          * Real.sqrt (Real.pi / (2 * t)) := by
            simpa using hmoment
    _ = (1 / (4 * t)) * Real.sqrt (Real.pi / (2 * t)) := by
          field_simp [ht.ne']
          norm_num
    _ = (1 / (4 * t)) * ∫ x : ℝ, Real.exp (-2 * t * x ^ (2 : Nat)) := by
          rw [hgauss]

/-- The standard Gaussian integral transported to an arbitrary finite coordinate type. -/
private lemma gaussian_integral_formula_fintype
    (α : Type*) [Fintype α] [DecidableEq α] (a : ℝ) (ha : 0 < a) :
    ∫ x : α → ℝ, Real.exp (-a * ∑ i : α, x i ^ (2 : Nat))
      = (Real.pi / a) ^ ((Fintype.card α : ℝ) / 2) := by
  let e : Fin (Fintype.card α) ≃ α := (Fintype.equivFin α).symm
  let reindex : (Fin (Fintype.card α) → ℝ) ≃ᵐ (α → ℝ) :=
    MeasurableEquiv.piCongrLeft (fun _ : α => ℝ) e
  have hpres :
      MeasureTheory.MeasurePreserving reindex MeasureTheory.volume MeasureTheory.volume := by
    simpa [reindex] using
      (MeasureTheory.volume_measurePreserving_piCongrLeft (fun _ : α => ℝ) e)
  have hsq :
      ∀ x : Fin (Fintype.card α) → ℝ,
        (∑ i : α, reindex x i ^ (2 : Nat)) = ∑ i : Fin (Fintype.card α), x i ^ (2 : Nat) := by
    intro x
    exact Fintype.sum_equiv e.symm
      (fun i : α => reindex x i ^ (2 : Nat))
      (fun i : Fin (Fintype.card α) => x i ^ (2 : Nat))
      (by
        intro i
        have happly : reindex x i = x (e.symm i) := by
          simpa [reindex] using
            (Equiv.piCongrLeft_apply (P := fun _ : α => ℝ) e x i)
        simp [happly])
  let g : (α → ℝ) → ℝ := fun y =>
    Real.exp (-a * ∑ i : α, y i ^ (2 : Nat))
  let h : (Fin (Fintype.card α) → ℝ) → ℝ := fun x =>
    Real.exp (-a * ∑ i : Fin (Fintype.card α), x i ^ (2 : Nat))
  have hcomp : ∀ x : Fin (Fintype.card α) → ℝ, g (reindex x) = h x := by
    intro x
    simp [g, h, hsq x]
  have htransport :=
    MeasureTheory.MeasurePreserving.integral_comp hpres reindex.measurableEmbedding g
  calc
    ∫ y : α → ℝ, Real.exp (-a * ∑ i : α, y i ^ (2 : Nat))
      = ∫ y : α → ℝ, g y := by
          rfl
    _ = ∫ x : Fin (Fintype.card α) → ℝ, g (reindex x) := by
          symm
          simpa [reindex, g] using htransport
    _ = ∫ x : Fin (Fintype.card α) → ℝ, h x := by
          refine MeasureTheory.integral_congr_ae ?_
          exact Filter.Eventually.of_forall hcomp
    _ = ∫ x : Fin (Fintype.card α) → ℝ,
          Real.exp (-a * ∑ i : Fin (Fintype.card α), x i ^ (2 : Nat)) := by
          rfl
    _ = (Real.pi / a) ^ ((Fintype.card α : ℝ) / 2) := by
          simpa using gaussian_integral_formula (Fintype.card α) a ha

/-- A product of three distinct squared coordinates contributes exactly a
`(4t)^{-3}` fraction of the full Gaussian mass. -/
private lemma gaussian_split_factor_aux
    {α : Type*} [Fintype α] [DecidableEq α]
    (a0 : α) (t : ℝ) (f : ℝ → ℝ) (g : (CoordSplit.CoordNe a0 → ℝ) → ℝ) :
    ∫ x : α → ℝ,
        f ((CoordSplit.splitAt a0 x).1) * g ((CoordSplit.splitAt a0 x).2)
          * Real.exp (-2 * t * CoordSplit.sqNorm x)
      =
        (∫ z : ℝ, f z * Real.exp (-2 * t * z ^ (2 : Nat)))
          * ∫ y : (CoordSplit.CoordNe a0 → ℝ),
              g y * Real.exp (-2 * t * CoordSplit.sqNorm y) := by
  calc
    ∫ x : α → ℝ,
        f ((CoordSplit.splitAt a0 x).1) * g ((CoordSplit.splitAt a0 x).2)
          * Real.exp (-2 * t * CoordSplit.sqNorm x)
      = ∫ x : α → ℝ,
          (f ((CoordSplit.splitAt a0 x).1) * Real.exp (-2 * t * (CoordSplit.splitAt a0 x).1 ^ (2 : Nat)))
            * (g ((CoordSplit.splitAt a0 x).2)
                * Real.exp (-2 * t * CoordSplit.sqNorm ((CoordSplit.splitAt a0 x).2))) := by
            refine MeasureTheory.integral_congr_ae ?_
            exact Filter.Eventually.of_forall (fun x => by
              change
                f ((CoordSplit.splitAt a0 x).1) * g ((CoordSplit.splitAt a0 x).2)
                    * Real.exp (-2 * t * CoordSplit.sqNorm x)
                  =
                (f ((CoordSplit.splitAt a0 x).1)
                    * Real.exp (-2 * t * (CoordSplit.splitAt a0 x).1 ^ (2 : Nat)))
                  * (g ((CoordSplit.splitAt a0 x).2)
                      * Real.exp (-2 * t * CoordSplit.sqNorm ((CoordSplit.splitAt a0 x).2)))
              rw [CoordSplit.sqNorm_splitAt]
              rw [show -2 * t
                    * ((CoordSplit.splitAt a0 x).1 ^ (2 : Nat)
                        + CoordSplit.sqNorm ((CoordSplit.splitAt a0 x).2))
                    = -2 * t * (CoordSplit.splitAt a0 x).1 ^ (2 : Nat)
                        + -2 * t * CoordSplit.sqNorm ((CoordSplit.splitAt a0 x).2) by ring]
              rw [Real.exp_add]
              ring)
    _ =
        (∫ z : ℝ, f z * Real.exp (-2 * t * z ^ (2 : Nat)))
          * ∫ y : (CoordSplit.CoordNe a0 → ℝ),
              g y * Real.exp (-2 * t * CoordSplit.sqNorm y) := by
            simpa [mul_assoc, mul_left_comm, mul_comm] using
              (CoordSplit.integral_split_prod a0
                (fun z => f z * Real.exp (-2 * t * z ^ (2 : Nat)))
                (fun y => g y * Real.exp (-2 * t * CoordSplit.sqNorm y)))

set_option maxHeartbeats 4000000 in
private lemma gaussian_three_coord_sq_factor
    {α : Type*} [Fintype α] [DecidableEq α]
    (a b c : α) (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c)
    (t : ℝ) (ht : 0 < t) :
    ∫ x : α → ℝ,
        x a ^ (2 : Nat) * x b ^ (2 : Nat) * x c ^ (2 : Nat)
          * Real.exp (-2 * t * CoordSplit.sqNorm x)
      = (1 / (4 * t)) ^ (3 : Nat)
          * ∫ x : α → ℝ, Real.exp (-2 * t * CoordSplit.sqNorm x) := by
  let b₁ : CoordSplit.CoordNe a := ⟨b, by simpa using hab.symm⟩
  let c₁ : CoordSplit.CoordNe a := ⟨c, by simpa using hac.symm⟩
  have hc₁_ne_b₁ : c₁ ≠ b₁ := by
    intro h
    apply hbc
    exact (congrArg Subtype.val h).symm
  let c₂ : CoordSplit.CoordNe b₁ := ⟨c₁, hc₁_ne_b₁⟩
  let M : ℝ := ∫ z : ℝ, z ^ (2 : Nat) * Real.exp (-2 * t * z ^ (2 : Nat))
  let G : ℝ := ∫ z : ℝ, Real.exp (-2 * t * z ^ (2 : Nat))
  let I₁ : ℝ :=
    ∫ y : (CoordSplit.CoordNe a → ℝ),
        y b₁ ^ (2 : Nat) * y c₁ ^ (2 : Nat)
          * Real.exp (-2 * t * CoordSplit.sqNorm y)
  let I₂ : ℝ :=
    ∫ y : (CoordSplit.CoordNe b₁ → ℝ),
        y c₂ ^ (2 : Nat) * Real.exp (-2 * t * CoordSplit.sqNorm y)
  let I₃ : ℝ :=
    ∫ y : (CoordSplit.CoordNe c₂ → ℝ),
        Real.exp (-2 * t * CoordSplit.sqNorm y)
  let G₁ : ℝ :=
    ∫ y : (CoordSplit.CoordNe a → ℝ),
        Real.exp (-2 * t * CoordSplit.sqNorm y)
  let G₂ : ℝ :=
    ∫ y : (CoordSplit.CoordNe b₁ → ℝ),
        Real.exp (-2 * t * CoordSplit.sqNorm y)
  have hM : M = (1 / (4 * t)) * G := by
    unfold M G
    exact gaussian_one_dim_sq_moment_factor t ht
  have hIabc :
      ∫ x : α → ℝ,
          x a ^ (2 : Nat) * x b ^ (2 : Nat) * x c ^ (2 : Nat)
            * Real.exp (-2 * t * CoordSplit.sqNorm x)
        = M * I₁ := by
    unfold M I₁
    simpa [CoordSplit.splitAt_fst, CoordSplit.splitAt_snd,
      b₁, c₁, mul_assoc, mul_left_comm, mul_comm] using
      (gaussian_split_factor_aux a t
        (fun z => z ^ (2 : Nat))
        (fun y => y b₁ ^ (2 : Nat) * y c₁ ^ (2 : Nat)))
  have hI₁ : I₁ = M * I₂ := by
    unfold I₁ I₂ M
    simpa [CoordSplit.splitAt_fst, CoordSplit.splitAt_snd,
      c₂, mul_assoc, mul_left_comm, mul_comm] using
      (gaussian_split_factor_aux b₁ t
        (fun z => z ^ (2 : Nat))
        (fun y => y c₂ ^ (2 : Nat)))
  have hI₂ : I₂ = M * I₃ := by
    unfold I₂ I₃ M
    simpa [CoordSplit.splitAt_fst, CoordSplit.splitAt_snd,
      mul_assoc, mul_left_comm, mul_comm] using
      (gaussian_split_factor_aux c₂ t
        (fun z => z ^ (2 : Nat))
        (fun _ => (1 : ℝ)))
  have hG₀ :
      ∫ x : α → ℝ, Real.exp (-2 * t * CoordSplit.sqNorm x) = G * G₁ := by
    unfold G G₁
    simpa [mul_assoc, mul_left_comm, mul_comm] using
      (gaussian_split_factor_aux a t
        (fun _ => (1 : ℝ))
        (fun _ => (1 : ℝ)))
  have hG₁ : G₁ = G * G₂ := by
    unfold G₁ G₂ G
    simpa [mul_assoc, mul_left_comm, mul_comm] using
      (gaussian_split_factor_aux b₁ t
        (fun _ => (1 : ℝ))
        (fun _ => (1 : ℝ)))
  have hG₂ : G₂ = G * I₃ := by
    unfold G₂ I₃ G
    simpa [mul_assoc, mul_left_comm, mul_comm] using
      (gaussian_split_factor_aux c₂ t
        (fun _ => (1 : ℝ))
        (fun _ => (1 : ℝ)))
  have hGchain :
      G * (G * (G * I₃)) = ∫ x : α → ℝ, Real.exp (-2 * t * CoordSplit.sqNorm x) := by
    calc
      G * (G * (G * I₃)) = G * (G * G₂) := by rw [hG₂]
      _ = G * G₁ := by rw [hG₁]
      _ = ∫ x : α → ℝ, Real.exp (-2 * t * CoordSplit.sqNorm x) := by rw [hG₀]
  calc
    ∫ x : α → ℝ,
        x a ^ (2 : Nat) * x b ^ (2 : Nat) * x c ^ (2 : Nat)
          * Real.exp (-2 * t * CoordSplit.sqNorm x)
      = M * (M * (M * I₃)) := by rw [hIabc, hI₁, hI₂]
    _ = ((1 / (4 * t)) * G) * (M * (M * I₃)) := by rw [hM]
    _ = ((1 / (4 * t)) * G) * (((1 / (4 * t)) * G) * (M * I₃)) := by rw [hM]
    _ = ((1 / (4 * t)) * G) * (((1 / (4 * t)) * G) * (((1 / (4 * t)) * G) * I₃)) := by rw [hM]
    _ = (1 / (4 * t)) ^ (3 : Nat) * (G * (G * (G * I₃))) := by
          ring
    _ = (1 / (4 * t)) ^ (3 : Nat)
          * ∫ x : α → ℝ, Real.exp (-2 * t * CoordSplit.sqNorm x) := by
            rw [hGchain]

/-- Gaussian-weighted integrals factor after splitting off one coordinate. -/
private lemma gaussian_split_factor
    {α : Type*} [Fintype α] [DecidableEq α]
    (a0 : α) (t : ℝ) (f : ℝ → ℝ) (g : (CoordSplit.CoordNe a0 → ℝ) → ℝ) :
    ∫ x : α → ℝ,
        f ((CoordSplit.splitAt a0 x).1) * g ((CoordSplit.splitAt a0 x).2)
          * Real.exp (-2 * t * CoordSplit.sqNorm x)
      =
        (∫ z : ℝ, f z * Real.exp (-2 * t * z ^ (2 : Nat)))
          * ∫ y : (CoordSplit.CoordNe a0 → ℝ),
              g y * Real.exp (-2 * t * CoordSplit.sqNorm y) := by
  exact gaussian_split_factor_aux a0 t f g

/-- The Gaussian-weighted odd moment in one split coordinate vanishes. -/
private lemma gaussian_split_odd_zero
    {α : Type*} [Fintype α] [DecidableEq α]
    (a0 : α) (k : ℕ) (t : ℝ) (g : (CoordSplit.CoordNe a0 → ℝ) → ℝ) :
    ∫ x : α → ℝ,
        ((CoordSplit.splitAt a0 x).1 ^ (2 * k + 1) * g ((CoordSplit.splitAt a0 x).2))
          * Real.exp (-2 * t * CoordSplit.sqNorm x)
      = 0 := by
  rw [gaussian_split_factor a0 t (fun z => z ^ (2 * k + 1)) g]
  rw [gaussian_one_dim_odd_moment_zero]
  simp

/-- Split a product over a finite type into one distinguished coordinate and the rest. -/
private lemma prod_coords_split
    {α : Type*} [Fintype α] [DecidableEq α]
    (a0 : α) (f : α → ℝ) :
    (∏ a : α, f a) = f a0 * ∏ aa : CoordSplit.CoordNe a0, f aa.1 := by
  let ecompl : α ≃ CoordSplit.CoordEq a0 ⊕ CoordSplit.CoordNe a0 :=
    (Equiv.sumCompl (fun a : α => a = a0)).symm
  calc
    (∏ a : α, f a)
      = ∏ s : CoordSplit.CoordEq a0 ⊕ CoordSplit.CoordNe a0,
          match s with
          | Sum.inl a => f a.1
          | Sum.inr b => f b.1 := by
            exact Fintype.prod_equiv ecompl
              (fun a : α => f a)
              (fun s : CoordSplit.CoordEq a0 ⊕ CoordSplit.CoordNe a0 =>
                match s with
                | Sum.inl a => f a.1
                | Sum.inr b => f b.1)
              (by
                intro a
                cases h : ecompl a with
                | inl aa =>
                    have ha : a = aa.1 := by
                      simpa [ecompl] using congrArg ecompl.symm h
                    simp [ha]
                | inr aa =>
                    have ha : a = aa.1 := by
                      simpa [ecompl] using congrArg ecompl.symm h
                    simp [ha])
    _ = (∏ a : CoordSplit.CoordEq a0, f a.1) * ∏ aa : CoordSplit.CoordNe a0, f aa.1 := by
          rw [Fintype.prod_sum_type]
    _ = f a0 * ∏ aa : CoordSplit.CoordNe a0, f aa.1 := by
          letI : Subsingleton (CoordSplit.CoordEq a0) := by
            refine ⟨?_⟩
            intro a b
            apply Subtype.ext
            simpa [a.2, b.2]
          rw [Fintype.prod_subsingleton (f := fun a : CoordSplit.CoordEq a0 => f a.1) ⟨a0, rfl⟩]

/-- Coordinatewise monomial on a finite family of real variables. -/
private def coordMonomial
    {α : Type*} [Fintype α] [DecidableEq α]
    (m : α → ℕ) (x : α → ℝ) : ℝ :=
  ∏ a : α, x a ^ m a

/-- The complement-factor of `coordMonomial` after splitting off one coordinate. -/
private def coordMonomialNe
    {α : Type*} [Fintype α] [DecidableEq α]
    (a0 : α) (m : α → ℕ) (y : CoordSplit.CoordNe a0 → ℝ) : ℝ :=
  ∏ aa : CoordSplit.CoordNe a0, y aa ^ m aa.1

private lemma coordMonomial_splitAt
    {α : Type*} [Fintype α] [DecidableEq α]
    (a0 : α) (m : α → ℕ) (x : α → ℝ) :
    coordMonomial m x
      = (CoordSplit.splitAt a0 x).1 ^ m a0
          * coordMonomialNe a0 m ((CoordSplit.splitAt a0 x).2) := by
  unfold coordMonomial coordMonomialNe
  rw [prod_coords_split a0 (fun a => x a ^ m a)]
  congr 1
  · simpa [CoordSplit.splitAt_fst]
  · refine Finset.prod_congr rfl ?_
    intro aa haa
    simp [CoordSplit.splitAt_snd]

private lemma coordMonomial_mul
    {α : Type*} [Fintype α] [DecidableEq α]
    (m₁ m₂ : α → ℕ) (x : α → ℝ) :
    coordMonomial m₁ x * coordMonomial m₂ x
      = coordMonomial (fun a => m₁ a + m₂ a) x := by
  unfold coordMonomial
  rw [← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl ?_
  intro a ha
  rw [pow_add]

private lemma coordSqNorm_nonneg
    {α : Type*} [Fintype α] [DecidableEq α] (x : α → ℝ) :
    0 ≤ CoordSplit.sqNorm x := by
  unfold CoordSplit.sqNorm
  exact Finset.sum_nonneg (fun _ _ => by positivity)

private lemma coord_sq_le_sqNorm
    {α : Type*} [Fintype α] [DecidableEq α]
    (x : α → ℝ) (a : α) :
    x a ^ (2 : Nat) ≤ CoordSplit.sqNorm x := by
  unfold CoordSplit.sqNorm
  simpa using
    (Finset.single_le_sum
      (f := fun b : α => x b ^ (2 : Nat))
      (fun _ _ => by positivity)
      (Finset.mem_univ a))

private lemma abs_coord_le_sqrt_sqNorm
    {α : Type*} [Fintype α] [DecidableEq α]
    (x : α → ℝ) (a : α) :
    |x a| ≤ Real.sqrt (CoordSplit.sqNorm x) := by
  have hsq : |x a| ^ (2 : Nat) ≤ CoordSplit.sqNorm x := by
    simpa [sq_abs] using coord_sq_le_sqNorm x a
  simpa [pow_two] using Real.le_sqrt_of_sq_le (by simpa [pow_two] using hsq)

private lemma abs_coordMonomial_le_sqNorm_pow
    {α : Type*} [Fintype α] [DecidableEq α]
    (m : α → ℕ) (k : ℕ) (hdeg : (∑ a : α, m a) = 2 * k) (x : α → ℝ) :
    |coordMonomial m x| ≤ CoordSplit.sqNorm x ^ k := by
  let S : ℝ := CoordSplit.sqNorm x
  have hS_nonneg : 0 ≤ S := coordSqNorm_nonneg x
  have hcoord :
      ∀ a : α, |x a| ^ m a ≤ Real.sqrt S ^ m a := by
    intro a
    exact pow_le_pow_left₀ (abs_nonneg (x a)) (by
      simpa [S] using abs_coord_le_sqrt_sqNorm x a) (m a)
  calc
    |coordMonomial m x|
      = ∏ a : α, |x a ^ m a| := by
          unfold coordMonomial
          rw [Finset.abs_prod]
    _ = ∏ a : α, |x a| ^ m a := by
          refine Finset.prod_congr rfl ?_
          intro a ha
          rw [abs_pow]
    _ ≤ ∏ a : α, Real.sqrt S ^ m a := by
          refine Finset.prod_le_prod ?_ ?_
          · intro a ha
            positivity
          · intro a ha
            exact hcoord a
    _ = Real.sqrt S ^ (∑ a : α, m a) := by
          exact Finset.prod_pow_eq_pow_sum (Finset.univ) (fun a : α => m a) (Real.sqrt S)
    _ = Real.sqrt S ^ (2 * k) := by rw [hdeg]
    _ = S ^ k := by
          rw [pow_mul, Real.sq_sqrt hS_nonneg]

private lemma gaussian_coordMonomial_odd_zero
    {α : Type*} [Fintype α] [DecidableEq α]
    (a0 : α) (m : α → ℕ) (t : ℝ) (hodd : Odd (m a0)) :
    ∫ x : α → ℝ,
        coordMonomial m x * Real.exp (-2 * t * CoordSplit.sqNorm x)
      = 0 := by
  rcases hodd with ⟨k, hk⟩
  calc
    ∫ x : α → ℝ, coordMonomial m x * Real.exp (-2 * t * CoordSplit.sqNorm x)
      = ∫ x : α → ℝ,
          (((CoordSplit.splitAt a0 x).1 ^ (2 * k + 1))
            * coordMonomialNe a0 m ((CoordSplit.splitAt a0 x).2))
            * Real.exp (-2 * t * CoordSplit.sqNorm x) := by
              refine MeasureTheory.integral_congr_ae ?_
              exact Filter.Eventually.of_forall (fun x => by
                change
                  coordMonomial m x * Real.exp (-2 * t * CoordSplit.sqNorm x)
                    =
                  (((CoordSplit.splitAt a0 x).1 ^ (2 * k + 1))
                    * coordMonomialNe a0 m ((CoordSplit.splitAt a0 x).2))
                    * Real.exp (-2 * t * CoordSplit.sqNorm x)
                rw [coordMonomial_splitAt a0 m x, hk])
    _ = 0 := by
          simpa using
            (gaussian_split_odd_zero a0 k t (fun y => coordMonomialNe a0 m y))

/-- The 1D Gaussian moment used to factor multivariate Gaussian monomial integrals. -/
private def gaussian1DMoment (k : ℕ) (t : ℝ) : ℝ :=
  ∫ x : ℝ, x ^ k * Real.exp (-2 * t * x ^ (2 : Nat))

/-- The complement of `none` in `Option α` is canonically equivalent to `α`. -/
private def coordNeNoneEquiv (α : Type*) : CoordSplit.CoordNe (none : Option α) ≃ α where
  toFun x := by
    cases hx : x.1 with
    | none =>
        exfalso
        exact x.2 hx
    | some a =>
        exact a
  invFun a := ⟨some a, by simp⟩
  left_inv := by
    intro x
    rcases x with ⟨x, hx⟩
    cases x with
    | none =>
        exfalso
        exact hx rfl
    | some a =>
        rfl
  right_inv := by
    intro a
    rfl

private lemma coordMonomial_piCongrLeft
    {α β : Type*} [Fintype α] [DecidableEq α] [Fintype β] [DecidableEq β]
    (e : α ≃ β) (m : β → ℕ) (x : α → ℝ) :
    coordMonomial m ((MeasurableEquiv.piCongrLeft (fun _ : β => ℝ) e) x)
      = coordMonomial (fun a => m (e a)) x := by
  unfold coordMonomial
  symm
  refine Fintype.prod_equiv e
    (fun a : α => x a ^ m (e a))
    (fun b : β => ((MeasurableEquiv.piCongrLeft (fun _ : β => ℝ) e) x) b ^ m b) ?_
  intro a
  change x a ^ m (e a) = ((MeasurableEquiv.piCongrLeft (fun _ : β => ℝ) e) x) (e a) ^ m (e a)
  simp [MeasurableEquiv.piCongrLeft]

private lemma sqNorm_piCongrLeft
    {α β : Type*} [Fintype α] [DecidableEq α] [Fintype β] [DecidableEq β]
    (e : α ≃ β) (x : α → ℝ) :
    CoordSplit.sqNorm ((MeasurableEquiv.piCongrLeft (fun _ : β => ℝ) e) x)
      = CoordSplit.sqNorm x := by
  unfold CoordSplit.sqNorm
  symm
  refine Fintype.sum_equiv e
    (fun a : α => x a ^ (2 : Nat))
    (fun b : β => ((MeasurableEquiv.piCongrLeft (fun _ : β => ℝ) e) x) b ^ (2 : Nat)) ?_
  intro a
  change x a ^ (2 : Nat) = ((MeasurableEquiv.piCongrLeft (fun _ : β => ℝ) e) x) (e a) ^ (2 : Nat)
  simp [MeasurableEquiv.piCongrLeft]

private def GaussianCoordMonomialFactorProp (β : Type*) : Prop := by
  classical
  exact ∀ [Fintype β] [DecidableEq β], ∀ (m : β → ℕ) (t : ℝ), 0 < t →
    ∫ x : β → ℝ, coordMonomial m x * Real.exp (-2 * t * CoordSplit.sqNorm x)
      = ∏ a : β, gaussian1DMoment (m a) t

private lemma gaussian_coordMonomial_factor_of_equiv
    {α β : Type*} [Fintype α] [Fintype β]
    (e : α ≃ β)
    (hα :
      ∀ (m : α → ℕ) (t : ℝ), 0 < t →
        letI := Classical.decEq α
        ∫ x : α → ℝ, coordMonomial m x * Real.exp (-2 * t * CoordSplit.sqNorm x)
          = ∏ a : α, gaussian1DMoment (m a) t) :
    ∀ (m : β → ℕ) (t : ℝ), 0 < t →
      letI := Classical.decEq β
      ∫ y : β → ℝ, coordMonomial m y * Real.exp (-2 * t * CoordSplit.sqNorm y)
        = ∏ b : β, gaussian1DMoment (m b) t := by
  classical
  intro m t ht
  let reindex : (α → ℝ) ≃ᵐ (β → ℝ) :=
    MeasurableEquiv.piCongrLeft (fun _ : β => ℝ) e
  let mα : α → ℕ := fun a => m (e a)
  let fβ : (β → ℝ) → ℝ := fun y =>
    coordMonomial m y * Real.exp (-2 * t * CoordSplit.sqNorm y)
  let fα : (α → ℝ) → ℝ := fun x =>
    coordMonomial mα x * Real.exp (-2 * t * CoordSplit.sqNorm x)
  have hpres :
      MeasureTheory.MeasurePreserving reindex MeasureTheory.volume MeasureTheory.volume := by
    simpa [reindex] using
      (MeasureTheory.volume_measurePreserving_piCongrLeft (fun _ : β => ℝ) e)
  have hcomp : ∀ x : α → ℝ, fβ (reindex x) = fα x := by
    intro x
    simp only [fβ, fα, mα]
    rw [coordMonomial_piCongrLeft e m x, sqNorm_piCongrLeft e x]
  have htransport :=
    MeasureTheory.MeasurePreserving.integral_comp hpres reindex.measurableEmbedding fβ
  calc
    ∫ y : β → ℝ, coordMonomial m y * Real.exp (-2 * t * CoordSplit.sqNorm y)
      = ∫ y : β → ℝ, fβ y := by
          rfl
    _ = ∫ x : α → ℝ, fβ (reindex x) := by
          symm
          simpa [reindex, fβ] using htransport
    _ = ∫ x : α → ℝ, fα x := by
          refine MeasureTheory.integral_congr_ae ?_
          exact Filter.Eventually.of_forall hcomp
    _ = ∏ a : α, gaussian1DMoment (mα a) t := by
          simpa [fα, mα] using hα mα t ht
    _ = ∏ b : β, gaussian1DMoment (m b) t := by
          exact Fintype.prod_equiv e
            (fun a : α => gaussian1DMoment (m (e a)) t)
            (fun b : β => gaussian1DMoment (m b) t)
            (by intro a; rfl)

private lemma gaussian_coordMonomial_factor
    {α : Type*} [Fintype α] (m : α → ℕ) (t : ℝ) (ht : 0 < t) :
    letI := Classical.decEq α
    ∫ x : α → ℝ, coordMonomial m x * Real.exp (-2 * t * CoordSplit.sqNorm x)
      = ∏ a : α, gaussian1DMoment (m a) t := by
  classical
  have hP : GaussianCoordMonomialFactorProp α := by
    refine Finite.induction_empty_option (P := GaussianCoordMonomialFactorProp) ?_ ?_ ?_ α
    · intro β γ e hβ
      intro _ _
      letI : Fintype β := Fintype.ofEquiv γ e.symm
      letI : DecidableEq β := Classical.decEq β
      exact gaussian_coordMonomial_factor_of_equiv e (fun m t ht => hβ m t ht)
    · intro _ _ m t ht
      calc
        ∫ x : PEmpty → ℝ, coordMonomial m x * Real.exp (-2 * t * CoordSplit.sqNorm x)
          = ∫ x : PEmpty → ℝ, Real.exp (-2 * t * CoordSplit.sqNorm x) := by
              refine MeasureTheory.integral_congr_ae ?_
              exact Filter.Eventually.of_forall (fun x => by simp [coordMonomial])
        _ = 1 := by
              simpa [CoordSplit.sqNorm] using
                (gaussian_integral_formula_fintype PEmpty (2 * t) (by positivity))
        _ = ∏ a : PEmpty, gaussian1DMoment (m a) t := by simp
    · intro β _ hβ _ _ m t ht
      let mRest : CoordSplit.CoordNe (none : Option β) → ℕ := fun aa => m aa.1
      have hrest : GaussianCoordMonomialFactorProp (CoordSplit.CoordNe (none : Option β)) := by
        intro _ _
        simpa using
          (gaussian_coordMonomial_factor_of_equiv
            (e := (coordNeNoneEquiv β).symm) hβ)
      have hprod_rest :
          ∏ aa : CoordSplit.CoordNe (none : Option β), gaussian1DMoment (m aa.1) t
            = ∏ b : β, gaussian1DMoment (m (some b)) t := by
        exact Fintype.prod_equiv (coordNeNoneEquiv β)
          (fun aa : CoordSplit.CoordNe (none : Option β) => gaussian1DMoment (m aa.1) t)
          (fun b : β => gaussian1DMoment (m (some b)) t)
          (by
            intro aa
            rcases aa with ⟨aa, haa⟩
            cases aa with
            | none =>
                exfalso
                exact haa rfl
            | some a =>
                rfl)
      calc
        ∫ x : Option β → ℝ, coordMonomial m x * Real.exp (-2 * t * CoordSplit.sqNorm x)
          = ∫ x : Option β → ℝ,
              (((CoordSplit.splitAt none x).1 ^ m none)
                * coordMonomialNe none m ((CoordSplit.splitAt none x).2))
                * Real.exp (-2 * t * CoordSplit.sqNorm x) := by
                  refine MeasureTheory.integral_congr_ae ?_
                  exact Filter.Eventually.of_forall (fun x => by
                    change
                      coordMonomial m x * Real.exp (-2 * t * CoordSplit.sqNorm x)
                        =
                      (((CoordSplit.splitAt none x).1 ^ m none)
                        * coordMonomialNe none m ((CoordSplit.splitAt none x).2))
                        * Real.exp (-2 * t * CoordSplit.sqNorm x)
                    rw [coordMonomial_splitAt (a0 := none) m x])
        _ = (∫ z : ℝ, z ^ m none * Real.exp (-2 * t * z ^ (2 : Nat)))
              * ∫ y : CoordSplit.CoordNe (none : Option β) → ℝ,
                  coordMonomialNe none m y * Real.exp (-2 * t * CoordSplit.sqNorm y) := by
                simpa [mul_assoc, mul_left_comm, mul_comm] using
                  (gaussian_split_factor (α := Option β) none t
                    (fun z => z ^ m none)
                    (fun y => coordMonomialNe none m y))
        _ = gaussian1DMoment (m none) t
              * ∫ y : CoordSplit.CoordNe (none : Option β) → ℝ,
                  coordMonomial mRest y * Real.exp (-2 * t * CoordSplit.sqNorm y) := by
                simp [gaussian1DMoment, mRest, coordMonomialNe, coordMonomial]
        _ = gaussian1DMoment (m none) t
              * ∏ aa : CoordSplit.CoordNe (none : Option β), gaussian1DMoment (mRest aa) t := by
                rw [hrest mRest t ht]
        _ = gaussian1DMoment (m none) t
              * ∏ b : β, gaussian1DMoment (m (some b)) t := by
                rw [hprod_rest]
        _ = gaussian1DMoment (m none) t
              * ∏ aa : CoordSplit.CoordNe (none : Option β), gaussian1DMoment (m aa.1) t := by
                rw [← hprod_rest]
        _ = ∏ o : Option β, gaussian1DMoment (m o) t := by
              symm
              simpa [CoordSplit.CoordNe] using
                (Fintype.prod_eq_mul_prod_subtype_ne
                  (f := fun o : Option β => gaussian1DMoment (m o) t) none)
  exact hP m t ht

private lemma gaussian1DMoment_zero_eq (t : ℝ) (ht : 0 < t) :
    gaussian1DMoment 0 t = Real.sqrt (Real.pi / (2 * t)) := by
  unfold gaussian1DMoment
  simpa [pow_zero, pow_two] using integral_gaussian (2 * t)

/-- The exact coefficient in the even Gaussian moment formula for the kernel
`exp (-2 t x^2)`. -/
private noncomputable def gaussianEvenMomentCoeff (m : ℕ) : ℝ :=
  ((Nat.doubleFactorial (2 * m - 1) : ℕ) : ℝ) / (4 : ℝ) ^ m

private lemma gaussian1DMoment_even_eq (m : ℕ) (t : ℝ) (ht : 0 < t) :
    gaussian1DMoment (2 * m) t
      = (gaussianEvenMomentCoeff m / t ^ m) * gaussian1DMoment 0 t := by
  have hscaled := gaussian_one_dim_scaled_moment m t ht
  have hcoeff :
      (((Nat.doubleFactorial (2 * m - 1) : ℕ) : ℝ) / (2 ^ m * (2 * t) ^ m))
        = gaussianEvenMomentCoeff m / t ^ m := by
    unfold gaussianEvenMomentCoeff
    rw [show (2 * t) ^ m = (2 : ℝ) ^ m * t ^ m by rw [mul_pow]]
    rw [show (4 : ℝ) ^ m = (2 : ℝ) ^ m * (2 : ℝ) ^ m by
      rw [show (4 : ℝ) = 2 * 2 by norm_num, mul_pow]]
    field_simp [ht.ne']
  calc
    gaussian1DMoment (2 * m) t
      = (((Nat.doubleFactorial (2 * m - 1) : ℕ) : ℝ) / (2 ^ m * (2 * t) ^ m))
          * Real.sqrt (Real.pi / (2 * t)) := by
            simpa [gaussian1DMoment, pow_two] using hscaled
    _ = (gaussianEvenMomentCoeff m / t ^ m) * Real.sqrt (Real.pi / (2 * t)) := by
          rw [hcoeff]
    _ = (gaussianEvenMomentCoeff m / t ^ m) * gaussian1DMoment 0 t := by
          rw [gaussian1DMoment_zero_eq t ht]

private lemma gaussian_edge_coordMonomial_factor {n : ℕ}
    (m : Cn3Torus.Edge n → ℕ) (t : ℝ) (ht : 0 < t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∏ e : Cn3Torus.Edge n, gaussian1DMoment (m e) t := by
  simpa [CoordSplit.sqNorm, Cn3Torus.sqNormEdge] using
    (gaussian_coordMonomial_factor (α := Cn3Torus.Edge n) m t ht)

private lemma gaussian_edge_coordMonomial_odd_zero {n : ℕ}
    (e0 : Cn3Torus.Edge n) (m : Cn3Torus.Edge n → ℕ) (t : ℝ) (hodd : Odd (m e0)) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = 0 := by
  simpa [CoordSplit.sqNorm, Cn3Torus.sqNormEdge] using
    (gaussian_coordMonomial_odd_zero (α := Cn3Torus.Edge n) e0 m t hodd)

private def edgePowMultiplicity {n : ℕ} (e0 : Cn3Torus.Edge n) (k : ℕ) :
    Cn3Torus.Edge n → ℕ :=
  fun e => if e = e0 then k else 0

/-- The undirected edge between two distinct vertices, ordered by the ambient `<`. -/
private def edgeOfNe {n : ℕ} (i j : Fin n) (h : i ≠ j) : Cn3Torus.Edge n := by
  by_cases hij : i < j
  · exact ⟨(i, j), hij⟩
  · exact ⟨(j, i), lt_of_le_of_ne (le_of_not_gt hij) h.symm⟩

private lemma edgeOfNe_eq_of_lt {n : ℕ} (i j : Fin n) (hij : i < j) :
    edgeOfNe i j (by exact ne_of_lt hij) = ⟨(i, j), hij⟩ := by
  simp [edgeOfNe, hij]

private lemma edgeOfNe_eq_of_gt {n : ℕ} (i j : Fin n) (hij : j < i) :
    edgeOfNe i j (by exact ne_of_gt hij) = ⟨(j, i), hij⟩ := by
  have hnot : ¬ i < j := not_lt_of_ge (le_of_lt hij)
  simp [edgeOfNe, hnot, hij]

private lemma edgeOfNe_symm {n : ℕ} (i j : Fin n) (h : i ≠ j) :
    edgeOfNe i j h = edgeOfNe j i h.symm := by
  by_cases hij : i < j
  · rw [edgeOfNe_eq_of_lt i j hij]
    rw [edgeOfNe_eq_of_gt j i hij]
  · have hji : j < i := lt_of_le_of_ne (le_of_not_gt hij) h.symm
    rw [edgeOfNe_eq_of_gt i j hji]
    rw [edgeOfNe_eq_of_lt j i hji]

private lemma coordMonomial_edgePowMultiplicity {n : ℕ}
    (e0 : Cn3Torus.Edge n) (k : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    coordMonomial (edgePowMultiplicity e0 k) mu = mu e0 ^ k := by
  classical
  unfold coordMonomial edgePowMultiplicity
  rw [Fintype.prod_eq_mul_prod_subtype_ne
    (f := fun e : Cn3Torus.Edge n => mu e ^ (if e = e0 then k else 0)) e0]
  have hrest :
      ∏ x : Cn3Torus.EdgeNe e0, (if (x : Cn3Torus.Edge n) = e0 then mu ↑x ^ k else 1)
        = ∏ x : Cn3Torus.EdgeNe e0, (1 : ℝ) := by
    refine Finset.prod_congr rfl ?_
    intro x hx
    simp [x.2]
  simp [hrest]

private lemma sum_edgePowMultiplicity {n : ℕ} (e0 : Cn3Torus.Edge n) (k : ℕ) :
    ∑ e : Cn3Torus.Edge n, edgePowMultiplicity e0 k e = k := by
  classical
  rw [Finset.sum_eq_single e0]
  · simp [edgePowMultiplicity]
  · intro e he hne
    simp [edgePowMultiplicity, hne]
  · intro hnot
    exact False.elim (hnot (Finset.mem_univ e0))

private lemma gaussian_edge_zero_moment_prod {n : ℕ} (t : ℝ) (ht : 0 < t) :
    ∏ e : Cn3Torus.Edge n, gaussian1DMoment 0 t = gaussianF (dim n) t := by
  calc
    ∏ e : Cn3Torus.Edge n, gaussian1DMoment 0 t
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial (fun _ : Cn3Torus.Edge n => 0) mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              symm
              simpa [coordMonomial] using
                (gaussian_edge_coordMonomial_factor
                  (n := n) (fun _ : Cn3Torus.Edge n => 0) t ht)
    _ = ∫ mu : Cn3Torus.Edge n → ℝ, Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
          refine MeasureTheory.integral_congr_ae ?_
          exact Filter.Eventually.of_forall (fun mu => by simp [coordMonomial])
    _ = gaussianF (dim n) t := by
          simpa using gaussian_integral_formula_edge n (2 * t) (by positivity)

private lemma edge_coordMonomial_integrable {n : ℕ}
    (m : Cn3Torus.Edge n → ℕ) (k : ℕ) (hk : 0 < k)
    (hdeg : (∑ e : Cn3Torus.Edge n, m e) = 2 * k)
    (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Cn3Torus.sqNormEdge n mu ^ k * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  have hg_int : MeasureTheory.Integrable g := by
    simpa [g] using sqNorm_moment_gaussian_integrable_edge n k hk t ht
  have hf_sm : MeasureTheory.AEStronglyMeasurable f := by
    have hcoord : Continuous (fun mu : Cn3Torus.Edge n → ℝ => coordMonomial m mu) := by
      unfold coordMonomial
      exact continuous_finset_prod _ (fun e _ => (continuous_apply e).pow (m e))
    have hexp' :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
          Real.exp (-((2 * t) * Cn3Torus.sqNormEdge n mu))) := by
      exact Real.continuous_exp.comp
        ((continuous_const.mul (Cn3Torus.continuous_sqNormEdge n)).neg)
    have hexp :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
          Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
      simpa [mul_assoc] using hexp'
    exact (hcoord.mul hexp).aestronglyMeasurable
  have hbound :
      ∀ᵐ mu : Cn3Torus.Edge n → ℝ ∂MeasureTheory.volume, ‖f mu‖ ≤ g mu := by
    exact Filter.Eventually.of_forall (fun mu => by
      have hs_nonneg : 0 ≤ Cn3Torus.sqNormEdge n mu := Cn3Torus.sqNormEdge_nonneg n mu
      have hexp_nonneg : 0 ≤ Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by positivity
      calc
        ‖f mu‖
          = |coordMonomial m mu| * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              unfold f
              rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hexp_nonneg]
        _ ≤ CoordSplit.sqNorm mu ^ k * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              gcongr
              exact abs_coordMonomial_le_sqNorm_pow m k hdeg mu
        _ = g mu := by
              simp [g, CoordSplit.sqNorm, Cn3Torus.sqNormEdge])
  exact MeasureTheory.Integrable.mono' hg_int hf_sm hbound

/-- A finite envelope for the even Gaussian moment coefficients up to degree `2K`. -/
noncomputable def gaussianEvenMomentEnvelope (K : ℕ) : ℝ :=
  by
    exact Finset.sum (Finset.range (K + 1)) (fun r => max 1 (gaussianEvenMomentCoeff r))

lemma gaussianEvenMomentEnvelope_one_le (K : ℕ) :
    1 ≤ gaussianEvenMomentEnvelope K := by
  classical
  have hmem : 0 ∈ Finset.range (K + 1) := by simp
  unfold gaussianEvenMomentEnvelope
  calc
    (1 : ℝ) ≤ max 1 (gaussianEvenMomentCoeff 0) := by simp
    _ ≤ Finset.sum (Finset.range (K + 1)) (fun r => max 1 (gaussianEvenMomentCoeff r)) := by
          exact Finset.single_le_sum
            (f := fun r : ℕ => max 1 (gaussianEvenMomentCoeff r))
            (by intro r hr; positivity) hmem

private lemma gaussianEvenMomentCoeff_le_envelope {K r : ℕ} (hr : r ≤ K) :
    gaussianEvenMomentCoeff r ≤ gaussianEvenMomentEnvelope K := by
  classical
  unfold gaussianEvenMomentEnvelope
  have hmem : r ∈ Finset.range (K + 1) := by simp [hr]
  calc
    gaussianEvenMomentCoeff r ≤ max 1 (gaussianEvenMomentCoeff r) := by exact le_max_right _ _
    _ ≤ Finset.sum (Finset.range (K + 1)) (fun s => max 1 (gaussianEvenMomentCoeff s)) := by
          exact Finset.single_le_sum
            (f := fun s : ℕ => max 1 (gaussianEvenMomentCoeff s))
            (by intro s hs; positivity) hmem

private lemma gaussianEvenMomentCoeff_le_envelope_pow {K r : ℕ} (hr : r ≤ K) :
    gaussianEvenMomentCoeff r ≤ gaussianEvenMomentEnvelope K ^ r := by
  have hcoeff : gaussianEvenMomentCoeff r ≤ gaussianEvenMomentEnvelope K :=
    gaussianEvenMomentCoeff_le_envelope hr
  have henv_one : 1 ≤ gaussianEvenMomentEnvelope K := gaussianEvenMomentEnvelope_one_le K
  cases r with
  | zero =>
      simp [gaussianEvenMomentCoeff]
  | succ r =>
      have hpow : gaussianEvenMomentEnvelope K ≤ gaussianEvenMomentEnvelope K ^ (Nat.succ r) := by
        have hpow_one : 1 ≤ gaussianEvenMomentEnvelope K ^ r := by
          exact one_le_pow₀ henv_one
        rw [pow_succ]
        nlinarith
      exact le_trans hcoeff hpow

private lemma gaussian_edge_even_coordMonomial_bound {n : ℕ}
    (m : Cn3Torus.Edge n → ℕ) (k : ℕ)
    (hdeg : (∑ e : Cn3Torus.Edge n, m e) = 2 * k)
    (heven : ∀ e : Cn3Torus.Edge n, Even (m e))
    (t : ℝ) (ht : 1 ≤ t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ (gaussianEvenMomentEnvelope k ^ k / t ^ k) * gaussianF (dim n) t := by
  classical
  have ht_pos : 0 < t := by linarith
  let r : Cn3Torus.Edge n → ℕ := fun e => Classical.choose (heven e)
  have hm_eq : ∀ e : Cn3Torus.Edge n, m e = 2 * r e := by
    intro e
    simpa [two_mul] using Classical.choose_spec (heven e)
  have hr_sum : (∑ e : Cn3Torus.Edge n, r e) = k := by
    have hsum :
        (∑ e : Cn3Torus.Edge n, m e) = 2 * ∑ e : Cn3Torus.Edge n, r e := by
      calc
        (∑ e : Cn3Torus.Edge n, m e) = ∑ e : Cn3Torus.Edge n, 2 * r e := by
          refine Finset.sum_congr rfl ?_
          intro e he
          rw [hm_eq e]
        _ = 2 * ∑ e : Cn3Torus.Edge n, r e := by
          rw [Finset.mul_sum]
    omega
  have hr_le : ∀ e : Cn3Torus.Edge n, r e ≤ k := by
    intro e
    have hsingle : r e ≤ ∑ e' : Cn3Torus.Edge n, r e' := by
      exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ e)
    omega
  have hcoeff_prod :
      ∏ e : Cn3Torus.Edge n, gaussianEvenMomentCoeff (r e)
        ≤ gaussianEvenMomentEnvelope k ^ k := by
    have henv_nonneg : 0 ≤ gaussianEvenMomentEnvelope k := by
      linarith [gaussianEvenMomentEnvelope_one_le k]
    have hpoint :
        ∀ e : Cn3Torus.Edge n,
          gaussianEvenMomentCoeff (r e) ≤ gaussianEvenMomentEnvelope k ^ r e := by
      intro e
      exact gaussianEvenMomentCoeff_le_envelope_pow (hr_le e)
    calc
      ∏ e : Cn3Torus.Edge n, gaussianEvenMomentCoeff (r e)
        ≤ ∏ e : Cn3Torus.Edge n, gaussianEvenMomentEnvelope k ^ r e := by
            refine Finset.prod_le_prod ?_ ?_
            · intro e he
              exact div_nonneg (by positivity) (by positivity)
            · intro e he
              exact hpoint e
      _ = gaussianEvenMomentEnvelope k ^ ∑ e : Cn3Torus.Edge n, r e := by
            exact Finset.prod_pow_eq_pow_sum (Finset.univ) r (gaussianEvenMomentEnvelope k)
      _ = gaussianEvenMomentEnvelope k ^ k := by rw [hr_sum]
  have htpow_pos : 0 < t ^ k := by positivity
  have hmain :
      ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = (∏ e : Cn3Torus.Edge n, gaussianEvenMomentCoeff (r e) / t ^ r e)
            * ∏ e : Cn3Torus.Edge n, gaussian1DMoment 0 t := by
    calc
      ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = ∏ e : Cn3Torus.Edge n, gaussian1DMoment (m e) t := by
            exact gaussian_edge_coordMonomial_factor m t ht_pos
      _ = ∏ e : Cn3Torus.Edge n,
            ((gaussianEvenMomentCoeff (r e) / t ^ r e) * gaussian1DMoment 0 t) := by
            refine Finset.prod_congr rfl ?_
            intro e he
            rw [hm_eq e, gaussian1DMoment_even_eq (r e) t ht_pos]
      _ = (∏ e : Cn3Torus.Edge n, gaussianEvenMomentCoeff (r e) / t ^ r e)
            * ∏ e : Cn3Torus.Edge n, gaussian1DMoment 0 t := by
            rw [Finset.prod_mul_distrib]
  have hscale :
      ∏ e : Cn3Torus.Edge n, gaussianEvenMomentCoeff (r e) / t ^ r e
        ≤ gaussianEvenMomentEnvelope k ^ k / t ^ k := by
    have henv_nonneg : 0 ≤ gaussianEvenMomentEnvelope k := by
      linarith [gaussianEvenMomentEnvelope_one_le k]
    have hpoint :
        ∀ e : Cn3Torus.Edge n,
          gaussianEvenMomentCoeff (r e) / t ^ r e
            ≤ gaussianEvenMomentEnvelope k ^ r e / t ^ r e := by
      intro e
      exact div_le_div_of_nonneg_right
        (gaussianEvenMomentCoeff_le_envelope_pow (hr_le e))
        (by positivity)
    calc
      ∏ e : Cn3Torus.Edge n, gaussianEvenMomentCoeff (r e) / t ^ r e
        ≤ ∏ e : Cn3Torus.Edge n, gaussianEvenMomentEnvelope k ^ r e / t ^ r e := by
            refine Finset.prod_le_prod ?_ ?_
            · intro e he
              have hnum_nonneg : 0 ≤ gaussianEvenMomentCoeff (r e) := by
                unfold gaussianEvenMomentCoeff
                positivity
              exact div_nonneg hnum_nonneg (pow_nonneg ht_pos.le _)
            · intro e he
              exact hpoint e
      _ = (gaussianEvenMomentEnvelope k ^ k) / t ^ k := by
            calc
              ∏ e : Cn3Torus.Edge n, gaussianEvenMomentEnvelope k ^ r e / t ^ r e
                = (∏ e : Cn3Torus.Edge n, gaussianEvenMomentEnvelope k ^ r e)
                    * (∏ e : Cn3Torus.Edge n, t ^ r e)⁻¹ := by
                      simp_rw [div_eq_mul_inv]
                      rw [Finset.prod_mul_distrib, ← Finset.prod_inv_distrib]
              _ = (gaussianEvenMomentEnvelope k ^ ∑ e : Cn3Torus.Edge n, r e)
                    * (t ^ ∑ e : Cn3Torus.Edge n, r e)⁻¹ := by
                      rw [Finset.prod_pow_eq_pow_sum, Finset.prod_pow_eq_pow_sum]
              _ = (gaussianEvenMomentEnvelope k ^ k) * (t ^ k)⁻¹ := by rw [hr_sum]
              _ = (gaussianEvenMomentEnvelope k ^ k) / t ^ k := by
                    rw [div_eq_mul_inv]
  have hzero_prod :
      ∏ e : Cn3Torus.Edge n, gaussian1DMoment 0 t = gaussianF (dim n) t :=
    gaussian_edge_zero_moment_prod (n := n) t ht_pos
  have hscale_nonneg : 0 ≤ gaussianEvenMomentEnvelope k ^ k / t ^ k := by
    have henv_nonneg : 0 ≤ gaussianEvenMomentEnvelope k := by
      linarith [gaussianEvenMomentEnvelope_one_le k]
    exact div_nonneg (pow_nonneg henv_nonneg _) (pow_nonneg ht_pos.le _)
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = (∏ e : Cn3Torus.Edge n, gaussianEvenMomentCoeff (r e) / t ^ r e)
          * ∏ e : Cn3Torus.Edge n, gaussian1DMoment 0 t := hmain
    _ ≤ (gaussianEvenMomentEnvelope k ^ k / t ^ k)
          * ∏ e : Cn3Torus.Edge n, gaussian1DMoment 0 t := by
            have hmom_nonneg : 0 ≤ ∏ e : Cn3Torus.Edge n, gaussian1DMoment 0 t := by
              rw [hzero_prod]
              unfold gaussianF
              positivity
            exact mul_le_mul_of_nonneg_right hscale hmom_nonneg
    _ = (gaussianEvenMomentEnvelope k ^ k / t ^ k) * gaussianF (dim n) t := by
          rw [hzero_prod]

/-- `sNorm` is a continuous polynomial in the edge variables. -/
private lemma continuous_sNorm_local (n : ℕ) :
    Continuous (sNorm n) := by
  have h : sNorm n = fun lam : Fin n → Fin n → ℝ => momentX n lam 2 := by
    funext lam
    symm
    exact momentX_two_eq_sNorm n lam
  rw [h]
  exact continuous_momentX n 2

/-- The quartic correction is continuous in the edge variables. -/
private lemma continuous_quarticCorr_local (n : ℕ) :
    Continuous (quarticCorr n) := by
  have hs : Continuous (sNorm n) := continuous_sNorm_local n
  have h :
      quarticCorr n
        = fun lam : Fin n → Fin n → ℝ =>
            ((momentX n lam 4 - 3 * sNorm n lam ^ (2 : Nat)) / 24 : ℝ) := by
    funext lam
    symm
    exact fourth_cumulant_identity n lam
  rw [h]
  have hmain :
      Continuous (fun lam : Fin n → Fin n → ℝ =>
        momentX n lam 4 - 3 * sNorm n lam ^ (2 : Nat)) := by
    exact (continuous_momentX n 4).sub
      (continuous_const.mul (hs.pow 2))
  simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using
    ((continuous_const : Continuous fun _ : Fin n → Fin n → ℝ => ((24 : ℝ)⁻¹)).mul hmain)

/-- Uniform fourth-moment bound: the split foundational layer already uses the
explicit witness `3^4`. -/
private lemma fourth_moment_upper_uniform (n : ℕ) :
    ∀ lam : Fin n → Fin n → ℝ,
      momentX n lam 4 ≤ (81 : ℝ) * sNorm n lam ^ (2 : Nat) := by
  intro lam
  have hhc := fixedDegreeHC_degree2_W_fourth n (edgeLam n lam)
  have habs :
      (fun y => |Cn3Torus.W (edgeLam n lam) y| ^ (4 : Nat))
        = (fun y => (Cn3Torus.W (edgeLam n lam) y) ^ (4 : Nat)) := by
    funext y
    simpa using (abs_pow_even (Cn3Torus.W (edgeLam n lam) y) 2)
  rw [habs] at hhc
  have hhc' :
      momentX n lam 4 ≤ (3 : ℝ) ^ (4 : Nat) * sNorm n lam ^ (2 : Nat) := by
    rw [momentX_eq_avgOver_W_pow]
    simpa [sNorm_eq_sqNormEdge] using hhc
  norm_num at hhc'
  simpa using hhc'

/-- The quartic correction admits a uniform `O(s^2)` bound. -/
lemma quarticCorr_pointwise_bound_uniform :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      |quarticCorr n lam| ≤ C * sNorm n lam ^ (2 : Nat) := by
  refine ⟨(81 : ℝ) / 24 + 1 / 8, by positivity, ?_⟩
  intro n lam
  set s : ℝ := sNorm n lam
  set μ₄ : ℝ := momentX n lam 4
  have hμ₄_nonneg : 0 ≤ μ₄ := by
    dsimp [μ₄]
    unfold momentX
    refine mul_nonneg ?_ ?_
    · positivity
    · refine Finset.sum_nonneg ?_
      intro σ _
      positivity
  have hμ₄_bound : μ₄ ≤ (81 : ℝ) * s ^ (2 : Nat) := by
    simpa [μ₄, s] using fourth_moment_upper_uniform n lam
  have hquartic_id : quarticCorr n lam = (μ₄ - 3 * s ^ (2 : Nat)) / 24 := by
    simpa [μ₄, s] using (fourth_cumulant_identity n lam).symm
  have htri : |μ₄ - 3 * s ^ (2 : Nat)| ≤ μ₄ + 3 * s ^ (2 : Nat) := by
    have h := abs_sub μ₄ (3 * s ^ (2 : Nat))
    rw [abs_of_nonneg hμ₄_nonneg, abs_of_nonneg (by positivity : 0 ≤ 3 * s ^ (2 : Nat))] at h
    exact h
  calc
    |quarticCorr n lam| = |(μ₄ - 3 * s ^ (2 : Nat)) / 24| := by
      rw [hquartic_id]
    _ = |μ₄ - 3 * s ^ (2 : Nat)| / 24 := by
      rw [abs_div]
      norm_num
    _ ≤ (μ₄ + 3 * s ^ (2 : Nat)) / 24 := by
      gcongr
    _ = μ₄ / 24 + s ^ (2 : Nat) / 8 := by ring
    _ ≤ (81 : ℝ) * s ^ (2 : Nat) / 24 + s ^ (2 : Nat) / 8 := by
      gcongr
    _ = ((81 : ℝ) / 24 + 1 / 8) * s ^ (2 : Nat) := by
      ring

/-- Dimension-free sixth-moment bound in the matrix model. -/
private lemma sixth_moment_upper_uniform :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      momentX n lam 6 ≤ C * sNorm n lam ^ 3 := by
  refine ⟨(5 : ℝ) ^ (6 : Nat), by positivity, ?_⟩
  intro n lam
  have hhc := fixedDegreeHC_degree2_W_sixth n (edgeLam n lam)
  have habs :
      (fun y => |Cn3Torus.W (edgeLam n lam) y| ^ (6 : Nat))
        = (fun y => (Cn3Torus.W (edgeLam n lam) y) ^ (6 : Nat)) := by
    funext y
    simpa using (abs_pow_even (Cn3Torus.W (edgeLam n lam) y) 3)
  rw [habs] at hhc
  rw [momentX_eq_avgOver_W_pow]
  simpa [sNorm_eq_sqNormEdge] using hhc

/-- Dimension-free cubic-form bound. -/
lemma cubicT_pointwise_bound_uniform :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      |cubicT n lam| ≤ C * sNorm n lam ^ (3 / 2 : ℝ) := by
  refine ⟨(125 : ℝ) / 6, by positivity, ?_⟩
  intro n lam
  have hcubic : cubicT n lam = momentX n lam 3 / 6 := by
    have h := momentX_three_eq_six_cubicT n lam
    linarith
  have habs_avg :
      |momentX n lam 3| ≤ avgSigns n (fun σ => |innerX n lam σ| ^ (3 : Nat)) := by
    calc
      |momentX n lam 3|
          = |avgSigns n (fun σ => innerX n lam σ ^ (3 : Nat))| := rfl
      _ ≤ avgSigns n (fun σ => |(innerX n lam σ) ^ (3 : Nat)|) :=
            abs_avgSigns_le_avgSigns_abs n (fun σ => innerX n lam σ ^ (3 : Nat))
      _ = avgSigns n (fun σ => |innerX n lam σ| ^ (3 : Nat)) := by
            congr 1
            funext σ
            rw [abs_pow]
  have havg :
      avgSigns n (fun σ => |innerX n lam σ| ^ (3 : Nat))
        = Cn3Torus.avgOver n (fun y => |Cn3Torus.W (edgeLam n lam) y| ^ (3 : Nat)) := by
    simpa using (avgSigns_abs_innerX_pow_eq_avgOver_abs_W_pow n lam 3)
  have hcube :=
    Cn3Torus.avgOver_abs_cube_le_125_mul_sqNormEdge_threeHalves n (edgeLam n lam)
  have hμ3 :
      |momentX n lam 3| ≤ (125 : ℝ) * sNorm n lam ^ (3 / 2 : ℝ) := by
    have hle := habs_avg
    rw [havg] at hle
    simpa [sNorm_eq_sqNormEdge] using hle.trans hcube
  rw [hcubic]
  have habs_div :
      |momentX n lam 3 / (6 : ℝ)| = |momentX n lam 3| / (6 : ℝ) := by
    rw [abs_div]
    simp [abs_of_pos (show (0 : ℝ) < (6 : ℝ) by norm_num)]
  rw [habs_div]
  convert div_le_div_of_nonneg_right hμ3 (show (0 : ℝ) ≤ (6 : ℝ) from by positivity) using 1
  ring_nf

/-- Dimension-free quintic-form bound, obtained from the explicit quintic identity and
the uniform cubic bound. -/
private lemma quinticP5_pointwise_bound_uniform :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      |quinticP5 n lam| ≤ C * sNorm n lam ^ (5 / 2 : ℝ) := by
  obtain ⟨C_T, hCT_pos, hCT⟩ := cubicT_pointwise_bound_uniform
  refine ⟨(1125 : ℝ) / 120 + C_T / 2, ?_, ?_⟩
  · have hfirst_nonneg : 0 ≤ (1125 : ℝ) / 120 := by positivity
    nlinarith
  · intro n lam
    have hs_nonneg : 0 ≤ sNorm n lam := sNorm_nonneg n lam
    have hμ5 :
        |momentX n lam 5| ≤ (1125 : ℝ) * sNorm n lam ^ (5 / 2 : ℝ) :=
      momentX_five_abs_le n lam
    have hT : |cubicT n lam| ≤ C_T * sNorm n lam ^ (3 / 2 : ℝ) := hCT n lam
    have hs_mul :
        sNorm n lam * sNorm n lam ^ (3 / 2 : ℝ) = sNorm n lam ^ (5 / 2 : ℝ) := by
      calc
        sNorm n lam * sNorm n lam ^ (3 / 2 : ℝ)
            = sNorm n lam ^ (1 : ℝ) * sNorm n lam ^ (3 / 2 : ℝ) := by simp
        _ = sNorm n lam ^ (5 / 2 : ℝ) := by
              rw [← Real.rpow_add_of_nonneg hs_nonneg (by positivity) (by positivity)]
              norm_num
    have hmix :
        |sNorm n lam * cubicT n lam / 2| ≤ (C_T / 2) * sNorm n lam ^ (5 / 2 : ℝ) := by
      have h_eq : |sNorm n lam * cubicT n lam / 2| = sNorm n lam * |cubicT n lam| / 2 := by
        rw [div_eq_mul_inv, abs_mul, abs_mul, abs_of_nonneg hs_nonneg,
          abs_of_nonneg (by positivity : 0 ≤ (2 : ℝ)⁻¹)]
        ring
      rw [h_eq]
      calc
        sNorm n lam * |cubicT n lam| / 2
            ≤ sNorm n lam * (C_T * sNorm n lam ^ (3 / 2 : ℝ)) / 2 := by
                gcongr
        _ = (C_T / 2) * (sNorm n lam * sNorm n lam ^ (3 / 2 : ℝ)) := by ring
        _ = (C_T / 2) * sNorm n lam ^ (5 / 2 : ℝ) := by rw [hs_mul]
    have hquintic :
        quinticP5 n lam = momentX n lam 5 / 120 - sNorm n lam * cubicT n lam / 2 := by
      rw [quinticP5, momentX_three_eq_six_cubicT n lam, momentX_two_eq_sNorm n lam]
      ring
    rw [hquintic]
    calc
      |momentX n lam 5 / 120 - sNorm n lam * cubicT n lam / 2|
          ≤ |momentX n lam 5 / 120| + |sNorm n lam * cubicT n lam / 2| := by
            simpa using abs_sub (momentX n lam 5 / 120) (sNorm n lam * cubicT n lam / 2)
      _ = |momentX n lam 5| / 120 + |sNorm n lam * cubicT n lam / 2| := by
            rw [abs_div]
            norm_num
      _ ≤ ((1125 : ℝ) / 120) * sNorm n lam ^ (5 / 2 : ℝ)
            + (C_T / 2) * sNorm n lam ^ (5 / 2 : ℝ) := by
              have hμ5' :
                  |momentX n lam 5| / 120
                    ≤ ((1125 : ℝ) / 120) * sNorm n lam ^ (5 / 2 : ℝ) := by
                have hdiv := div_le_div_of_nonneg_right hμ5 (show (0 : ℝ) ≤ 120 by positivity)
                simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using hdiv
              linarith
      _ = ((1125 : ℝ) / 120 + C_T / 2) * sNorm n lam ^ (5 / 2 : ℝ) := by ring

/-- Dimension-free quartic real-part expansion for `ψ`. -/
private lemma dl10_local_real_quartic_expansion_uniform :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      sNorm n lam ≤ 1 →
      |(psi n lam).re - (1 - sNorm n lam / 2 + momentX n lam 4 / 24)| ≤
        C * sNorm n lam ^ 3 := by
  obtain ⟨C₆, hC₆_pos, hC₆⟩ := sixth_moment_upper_uniform
  refine ⟨C₆ / 720, by positivity, ?_⟩
  intro n lam hlam
  obtain ⟨eps, heps_eq, heps⟩ := re_psi_taylor4_decomposition n lam
  have hμ₂ : momentX n lam 2 = sNorm n lam := momentX_two_eq_sNorm n lam
  calc
    |(psi n lam).re - (1 - sNorm n lam / 2 + momentX n lam 4 / 24)| = |eps| := by
      rw [heps_eq, hμ₂]
      ring
    _ ≤ avgSigns n (fun σ => |innerX n lam σ| ^ (6 : Nat) / 720) := heps
    _ = avgSigns n (fun σ => |innerX n lam σ| ^ (6 : Nat)) / 720 := by
          rw [avgSigns_div_const]
    _ = momentX n lam 6 / 720 := by rw [avgSigns_abs_innerX_six_eq_momentX_six]
    _ ≤ (C₆ * sNorm n lam ^ 3) / 720 := by
          exact div_le_div_of_nonneg_right (hC₆ n lam) (by positivity)
    _ = (C₆ / 720) * sNorm n lam ^ 3 := by ring

private lemma taylorWithinEval_sin_four_at_zero {x : ℝ} (hx : 0 < x) :
    taylorWithinEval Real.sin 4 (Set.Icc (0 : ℝ) x) 0 x
      = x - x ^ (3 : Nat) / 6 := by
  have hmem0 : (0 : ℝ) ∈ Set.Icc (0 : ℝ) x := ⟨le_rfl, hx.le⟩
  have hwithin (k : ℕ) :
      iteratedDerivWithin k Real.sin (Set.Icc (0 : ℝ) x) 0 = iteratedDeriv k Real.sin 0 := by
    exact iteratedDerivWithin_eq_iteratedDeriv
      (uniqueDiffOn_Icc hx) Real.contDiff_sin.contDiffAt hmem0
  have h0 : iteratedDerivWithin 0 Real.sin (Set.Icc (0 : ℝ) x) 0 = 0 := by
    simpa [hwithin 0] using (Real.sin_zero : Real.sin 0 = 0)
  have h1 : iteratedDerivWithin 1 Real.sin (Set.Icc (0 : ℝ) x) 0 = 1 := by
    have hodd := congrArg (fun f : ℝ → ℝ => f (0 : ℝ)) (Real.iteratedDeriv_odd_sin (n := 0))
    simpa [hwithin 1] using hodd
  have h2 : iteratedDerivWithin 2 Real.sin (Set.Icc (0 : ℝ) x) 0 = 0 := by
    have heven := congrArg (fun f : ℝ → ℝ => f (0 : ℝ)) (Real.iteratedDeriv_even_sin (n := 1))
    simpa [hwithin 2] using heven
  have h3 : iteratedDerivWithin 3 Real.sin (Set.Icc (0 : ℝ) x) 0 = -1 := by
    have hodd := congrArg (fun f : ℝ → ℝ => f (0 : ℝ)) (Real.iteratedDeriv_odd_sin (n := 1))
    simpa [hwithin 3] using hodd
  have h4 : iteratedDerivWithin 4 Real.sin (Set.Icc (0 : ℝ) x) 0 = 0 := by
    have heven := congrArg (fun f : ℝ → ℝ => f (0 : ℝ)) (Real.iteratedDeriv_even_sin (n := 2))
    simpa [hwithin 4] using heven
  rw [taylor_within_apply]
  simp [Finset.sum_range_succ, h0, h1, h2, h3, h4, Nat.factorial]
  ring

private lemma abs_sin_sub_taylor3_le_pow5_div_120_of_nonneg {x : ℝ} (hx : 0 ≤ x) :
    |Real.sin x - (x - x ^ (3 : Nat) / 6)| ≤ x ^ (5 : Nat) / 120 := by
  rcases eq_or_lt_of_le hx with rfl | hpos
  · simp
  ·
    rcases taylor_mean_remainder_lagrange_iteratedDeriv
      (f := Real.sin) (x := x) (x₀ := (0 : ℝ)) (n := 4) hpos
      Real.contDiff_sin.contDiffOn with ⟨ξ, hξ, hrem⟩
    have htaylor :
        taylorWithinEval Real.sin 4 (Set.Icc (0 : ℝ) x) 0 x
          = x - x ^ (3 : Nat) / 6 :=
      taylorWithinEval_sin_four_at_zero hpos
    have hodd :
        iteratedDeriv (5 : Nat) Real.sin ξ = Real.cos ξ := by
      have hodd0 := congrArg (fun f : ℝ → ℝ => f ξ) (Real.iteratedDeriv_odd_sin (n := 2))
      simpa using hodd0
    have hrem' :
        Real.sin x - (x - x ^ (3 : Nat) / 6)
          = (Real.cos ξ * x ^ (5 : Nat)) / ((Nat.factorial 5 : Nat) : ℝ) := by
      have hrem0 := hrem
      rw [htaylor, hodd] at hrem0
      simpa using hrem0
    have hxpow_nonneg : 0 ≤ x ^ (5 : Nat) := by positivity
    have hfac : (((Nat.factorial 5 : Nat) : ℝ)) = 120 := by norm_num
    rw [hrem', abs_div, abs_mul, abs_of_nonneg hxpow_nonneg,
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ ((Nat.factorial 5 : Nat) : ℝ)), hfac]
    have hmul :
        |Real.cos ξ| * x ^ (5 : Nat) ≤ 1 * x ^ (5 : Nat) :=
      mul_le_mul_of_nonneg_right (Real.abs_cos_le_one ξ) hxpow_nonneg
    nlinarith

private lemma abs_sin_sub_taylor3_le_pow5_div_120 (x : ℝ) :
    |Real.sin x - (x - x ^ (3 : Nat) / 6)| ≤ |x| ^ (5 : Nat) / 120 := by
  by_cases hx : 0 ≤ x
  · have h := abs_sin_sub_taylor3_le_pow5_div_120_of_nonneg (x := x) hx
    simpa [abs_of_nonneg hx] using h
  · have hxneg : 0 ≤ -x := by linarith
    have h := abs_sin_sub_taylor3_le_pow5_div_120_of_nonneg (x := -x) hxneg
    have habs : |x| = -x := abs_of_nonpos (le_of_not_ge hx)
    have hinner :
        Real.sin (-x) - ((-x) - (-x) ^ (3 : Nat) / 6)
          = -(Real.sin x - (x - x ^ (3 : Nat) / 6)) := by
      calc
        Real.sin (-x) - ((-x) - (-x) ^ (3 : Nat) / 6)
            = -Real.sin x - ((-x) - (-x) ^ (3 : Nat) / 6) := by
              simp [Real.sin_neg]
        _ = -Real.sin x - (-(x - x ^ (3 : Nat) / 6)) := by ring
        _ = -(Real.sin x - (x - x ^ (3 : Nat) / 6)) := by ring
    have h' :
        |Real.sin x - (x - x ^ (3 : Nat) / 6)| ≤ (-x) ^ (5 : Nat) / 120 := by
      have h0 := h
      rw [hinner, abs_neg] at h0
      exact h0
    simpa [habs] using h'

private lemma im_psi_taylor3_decomposition (n : ℕ) (lam : Fin n → Fin n → ℝ) :
    ∃ eps : ℝ,
      (psi n lam).im = momentX n lam 1 - momentX n lam 3 / 6 + eps ∧
      |eps| ≤ avgSigns n (fun σ => |innerX n lam σ| ^ (5 : Nat) / 120) := by
  let xs : (Fin n → Fin 2) → ℝ := fun σ => innerX n lam σ
  let R : (Fin n → Fin 2) → ℝ :=
    fun σ => Real.sin (xs σ) - (xs σ - (xs σ) ^ (3 : Nat) / 6)
  refine ⟨avgSigns n R, ?_, ?_⟩
  · have hsplit :
        avgSigns n (fun σ => Real.sin (xs σ))
          = avgSigns n (fun σ => xs σ - (xs σ) ^ (3 : Nat) / 6) + avgSigns n R := by
      have hfun :
          (fun σ => Real.sin (xs σ))
            = (fun σ => (xs σ - (xs σ) ^ (3 : Nat) / 6) + R σ) := by
        funext σ
        dsimp [R]
        ring
      rw [hfun, avgSigns_add]
    have hpoly :
        avgSigns n (fun σ => xs σ - (xs σ) ^ (3 : Nat) / 6)
          = momentX n lam 1 - momentX n lam 3 / 6 := by
      rw [avgSigns_sub, avgSigns_div_const]
      rw [momentX, momentX]
      simp [avgSigns, xs]
    calc
      (psi n lam).im = avgSigns n (fun σ => Real.sin (xs σ)) := by
          simp [xs, psi_im_eq_avgSigns_sin]
      _ = avgSigns n (fun σ => xs σ - (xs σ) ^ (3 : Nat) / 6) + avgSigns n R := hsplit
      _ = momentX n lam 1 - momentX n lam 3 / 6 + avgSigns n R := by rw [hpoly]
  · have habs : |avgSigns n R| ≤ avgSigns n (fun σ => |R σ|) :=
      abs_avgSigns_le_avgSigns_abs n R
    have havg :
        avgSigns n (fun σ => |R σ|)
          ≤ avgSigns n (fun σ => |innerX n lam σ| ^ (5 : Nat) / 120) := by
      apply avgSigns_mono
      intro σ
      dsimp [R, xs]
      exact abs_sin_sub_taylor3_le_pow5_div_120 (innerX n lam σ)
    exact habs.trans havg

/-- Uniform quadratic bound on the imaginary part of `ψ`. -/
private lemma dl10_local_imag_expansion_uniform :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      sNorm n lam ≤ 1 →
      |(psi n lam).im + cubicT n lam| ≤ C * sNorm n lam ^ 2 := by
  refine ⟨(1125 : ℝ) / 120 + 1, by positivity, ?_⟩
  intro n lam hlam
  obtain ⟨eps, heps_eq, heps⟩ := im_psi_taylor3_decomposition n lam
  have hs_nonneg : 0 ≤ sNorm n lam := sNorm_nonneg n lam
  have hs_half_le_one : sNorm n lam ^ (1 / 2 : ℝ) ≤ 1 := by
    exact Real.rpow_le_one hs_nonneg hlam (by norm_num : (0 : ℝ) ≤ 1 / 2)
  have hs_52_le_2 : sNorm n lam ^ (5 / 2 : ℝ) ≤ sNorm n lam ^ 2 := by
    rw [show (5 / 2 : ℝ) = 2 + 1 / 2 by norm_num,
      Real.rpow_add_of_nonneg hs_nonneg (by positivity) (by positivity)]
    calc
      sNorm n lam ^ (2 : ℝ) * sNorm n lam ^ (1 / 2 : ℝ)
          ≤ sNorm n lam ^ (2 : ℝ) * 1 := by
              gcongr
      _ = sNorm n lam ^ (2 : ℝ) := by ring
      _ = sNorm n lam ^ (2 : Nat) := by norm_num
  have heps_eq' : (psi n lam).im + cubicT n lam = eps := by
    rw [heps_eq, momentX_one_eq_zero n lam, momentX_three_eq_six_cubicT n lam]
    ring
  have hfive :
      avgSigns n (fun σ => |innerX n lam σ| ^ (5 : Nat))
        ≤ (1125 : ℝ) * sNorm n lam ^ (5 / 2 : ℝ) := by
    have havg :
        avgSigns n (fun σ => |innerX n lam σ| ^ (5 : Nat))
          = Cn3Torus.avgOver n (fun y => |Cn3Torus.W (edgeLam n lam) y| ^ (5 : Nat)) := by
      simpa using (avgSigns_abs_innerX_pow_eq_avgOver_abs_W_pow n lam 5)
    rw [havg]
    simpa [sNorm_eq_sqNormEdge] using
      (Cn3Torus.avgOver_abs_five_le_1125_mul_sqNormEdge_fiveHalves n (edgeLam n lam))
  calc
    |(psi n lam).im + cubicT n lam| = |eps| := by rw [heps_eq']
    _ ≤ avgSigns n (fun σ => |innerX n lam σ| ^ (5 : Nat) / 120) := heps
    _ = avgSigns n (fun σ => |innerX n lam σ| ^ (5 : Nat)) / 120 := by
          rw [avgSigns_div_const]
    _ ≤ ((1125 : ℝ) * sNorm n lam ^ (5 / 2 : ℝ)) / 120 := by
          exact div_le_div_of_nonneg_right hfive (by positivity)
    _ = ((1125 : ℝ) / 120) * sNorm n lam ^ (5 / 2 : ℝ) := by ring
    _ ≤ ((1125 : ℝ) / 120) * sNorm n lam ^ 2 := by
          gcongr
    _ ≤ (((1125 : ℝ) / 120) + 1) * sNorm n lam ^ 2 := by
          nlinarith [pow_nonneg hs_nonneg 2]

/-- Dimension-free quintic imaginary expansion for `ψ`. -/
private lemma dl10_local_imag_quintic_expansion_uniform :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      sNorm n lam ≤ 1 →
      |(psi n lam).im + cubicT n lam - momentX n lam 5 / 120|
        ≤ C * sNorm n lam ^ 3 := by
  let K : ℝ := (6 : ℝ) ^ (7 : Nat) / 5040
  refine ⟨K + 1, by positivity, ?_⟩
  intro n lam hlam
  obtain ⟨eps, heps_eq, heps⟩ := im_psi_taylor5_decomposition n lam
  have hs_nonneg : 0 ≤ sNorm n lam := sNorm_nonneg n lam
  have hs_half_le_one : sNorm n lam ^ (1 / 2 : ℝ) ≤ 1 := by
    exact Real.rpow_le_one hs_nonneg hlam (by norm_num : (0 : ℝ) ≤ 1 / 2)
  have hs_72_le_3 : sNorm n lam ^ (7 / 2 : ℝ) ≤ sNorm n lam ^ 3 := by
    rw [show (7 / 2 : ℝ) = 3 + 1 / 2 by norm_num,
      Real.rpow_add_of_nonneg hs_nonneg (by positivity) (by positivity)]
    calc
      sNorm n lam ^ (3 : ℝ) * sNorm n lam ^ (1 / 2 : ℝ)
          ≤ sNorm n lam ^ (3 : ℝ) * 1 := by
              gcongr
      _ = sNorm n lam ^ (3 : ℝ) := by ring
      _ = sNorm n lam ^ (3 : Nat) := by norm_num
  have hK_nonneg : 0 ≤ K := by
    dsimp [K]
    positivity
  have hrem :
      avgSigns n (fun σ => |innerX n lam σ| ^ (7 : Nat) / 5040)
        ≤ K * sNorm n lam ^ (7 / 2 : ℝ) := by
    calc
      avgSigns n (fun σ => |innerX n lam σ| ^ (7 : Nat) / 5040)
          = avgSigns n (fun σ => |innerX n lam σ| ^ (7 : Nat)) / 5040 := by
              rw [avgSigns_div_const]
      _ ≤ (((6 : ℝ) ^ (7 : Nat)) * sNorm n lam ^ (7 / 2 : ℝ)) / 5040 := by
            exact div_le_div_of_nonneg_right
              (by
                rw [avgSigns_abs_innerX_pow_eq_avgOver_abs_W_pow]
                simpa [sNorm_eq_sqNormEdge] using
                  _root_.fixedDegreeHC_degree2_W_seventh_uniform n (edgeLam n lam))
              (by positivity)
      _ = K * sNorm n lam ^ (7 / 2 : ℝ) := by
            dsimp [K]
            ring
  calc
    |(psi n lam).im + cubicT n lam - momentX n lam 5 / 120| = |eps| := by
      rw [heps_eq, momentX_one_eq_zero n lam, momentX_three_eq_six_cubicT n lam]
      ring
    _ ≤ avgSigns n (fun σ => |innerX n lam σ| ^ (7 : Nat) / 5040) := heps
    _ ≤ K * sNorm n lam ^ (7 / 2 : ℝ) := hrem
    _ ≤ K * sNorm n lam ^ 3 := by
          exact mul_le_mul_of_nonneg_left hs_72_le_3 hK_nonneg
    _ ≤ (K + 1) * sNorm n lam ^ 3 := by
          nlinarith [pow_nonneg hs_nonneg 3]

private lemma dl10_local_real_expansion_uniform :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      sNorm n lam ≤ 1 →
      |(psi n lam).re - (1 - sNorm n lam / 2)| ≤ C * sNorm n lam ^ 2 := by
  obtain ⟨C_RQ, hCRQ_pos, hCRQ⟩ := dl10_local_real_quartic_expansion_uniform
  refine ⟨C_RQ + (81 : ℝ) / 24 + 1, by positivity, ?_⟩
  intro n lam hlam
  have hs_nonneg : 0 ≤ sNorm n lam := sNorm_nonneg n lam
  have hs_cube_le_sq : sNorm n lam ^ 3 ≤ sNorm n lam ^ 2 := by
    exact pow_le_pow_of_le_one hs_nonneg hlam (by norm_num : 2 ≤ 3)
  have hdecomp :
      (psi n lam).re - (1 - sNorm n lam / 2)
        = ((psi n lam).re - (1 - sNorm n lam / 2 + momentX n lam 4 / 24))
            + momentX n lam 4 / 24 := by
    ring
  calc
    |(psi n lam).re - (1 - sNorm n lam / 2)|
        = |((psi n lam).re - (1 - sNorm n lam / 2 + momentX n lam 4 / 24))
            + momentX n lam 4 / 24| := by
              rw [hdecomp]
    _ ≤ |(psi n lam).re - (1 - sNorm n lam / 2 + momentX n lam 4 / 24)|
          + |momentX n lam 4 / 24| := by
            simpa using
              (abs_add_le ((psi n lam).re - (1 - sNorm n lam / 2 + momentX n lam 4 / 24))
                (momentX n lam 4 / 24))
    _ ≤ C_RQ * sNorm n lam ^ 3 + (81 : ℝ) / 24 * sNorm n lam ^ 2 := by
          gcongr
          · simpa using hCRQ n lam hlam
          · have hμ₄ : momentX n lam 4 ≤ (81 : ℝ) * sNorm n lam ^ (2 : Nat) :=
                fourth_moment_upper_uniform n lam
            have hμ₄_nonneg : 0 ≤ momentX n lam 4 := by
              unfold momentX
              refine mul_nonneg ?_ ?_
              · positivity
              · refine Finset.sum_nonneg ?_
                intro σ _
                positivity
            have hdiv :
                momentX n lam 4 * (24 : ℝ)⁻¹
                  ≤ (81 : ℝ) * (24 : ℝ)⁻¹ * sNorm n lam ^ (2 : Nat) := by
              nlinarith
            have hnonneg : 0 ≤ momentX n lam 4 / 24 := by
              exact div_nonneg hμ₄_nonneg (by positivity)
            rw [abs_of_nonneg hnonneg]
            simpa [div_eq_mul_inv] using hdiv
    _ ≤ C_RQ * sNorm n lam ^ 2 + ((81 : ℝ) / 24) * sNorm n lam ^ 2 := by
          gcongr
    _ ≤ (C_RQ + (81 : ℝ) / 24 + 1) * sNorm n lam ^ 2 := by
          nlinarith [pow_nonneg hs_nonneg 2]

set_option maxHeartbeats 1600000 in
private theorem corrected_real_log_uniform :
    ∃ c_rl C_rl : ℝ, 0 < c_rl ∧ 0 < C_rl ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      sNorm n lam ≤ c_rl →
      ∃ E_rl : ℝ, |E_rl| ≤ C_rl * sNorm n lam ^ 3 ∧
        (Complex.log (psi n lam)).re =
          -(sNorm n lam / 2) + quarticCorr n lam + E_rl := by
  obtain ⟨C_R, hCR_pos, hCR⟩ := dl10_local_real_quartic_expansion_uniform
  obtain ⟨C_I, hCI_pos, hCI⟩ := dl10_local_imag_expansion_uniform
  obtain ⟨C_T, hCT_pos, hCT⟩ := cubicT_pointwise_bound_uniform
  let C₄ : ℝ := 81
  let A : ℝ := C_R + C₄ + 2
  let B : ℝ := C_I + C_T + 1
  let M : ℝ := 2 * A + B
  let c_rl : ℝ := min 1 (1 / (2 * M))
  let C_rl : ℝ := M ^ 3 + C_R + A / 2 + A ^ 2 / 2 + B ^ 2 / 2
  refine ⟨c_rl, C_rl, by
    unfold c_rl M A B
    positivity, by
    unfold C_rl M A B
    positivity, fun n lam hlam => ?_⟩
  set s : ℝ := sNorm n lam
  set μ₄ : ℝ := momentX n lam 4
  set a : ℝ := (psi n lam).re - 1
  set b : ℝ := (psi n lam).im
  set z : ℂ := psi n lam - 1
  have hA_pos : 0 < A := by
    unfold A
    positivity
  have hM_pos : 0 < M := by
    unfold M
    positivity
  have hs_nonneg : 0 ≤ s := by
    simpa [s] using sNorm_nonneg n lam
  have hs_one : s ≤ 1 := by
    exact le_trans hlam (min_le_left _ _)
  have hs_sq_le_s : s ^ 2 ≤ s := by
    simpa using pow_le_pow_of_le_one hs_nonneg hs_one (by norm_num : 1 ≤ 2)
  have hs_cube_le_sq : s ^ 3 ≤ s ^ 2 := by
    exact pow_le_pow_of_le_one hs_nonneg hs_one (by norm_num : 2 ≤ 3)
  have hs_four_le_cube : s ^ 4 ≤ s ^ 3 := by
    exact pow_le_pow_of_le_one hs_nonneg hs_one (by norm_num : 3 ≤ 4)
  have hs_le_half_rpow : s ≤ s ^ (1 / 2 : ℝ) := by
    simpa using Real.self_le_rpow_of_le_one hs_nonneg hs_one (by norm_num : (1 / 2 : ℝ) ≤ 1)
  have hs_half_le_one : s ^ (1 / 2 : ℝ) ≤ 1 := by
    exact Real.rpow_le_one hs_nonneg hs_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
  have hs_sq_le_three_halves : s ^ 2 ≤ s ^ (3 / 2 : ℝ) := by
    rw [show (3 / 2 : ℝ) = 1 + 1 / 2 by norm_num,
      Real.rpow_add_of_nonneg hs_nonneg (by norm_num) (by norm_num), Real.rpow_one]
    nlinarith [hs_le_half_rpow, hs_nonneg]
  have hs_three_halves_le_s : s ^ (3 / 2 : ℝ) ≤ s := by
    rw [show (3 / 2 : ℝ) = 1 + 1 / 2 by norm_num,
      Real.rpow_add_of_nonneg hs_nonneg (by norm_num) (by norm_num), Real.rpow_one]
    nlinarith [hs_half_le_one, hs_nonneg]
  have hμ₄_nonneg : 0 ≤ μ₄ := by
    dsimp [μ₄]
    unfold momentX
    refine mul_nonneg ?_ ?_
    · positivity
    · refine Finset.sum_nonneg ?_
      intro σ _
      positivity
  have hμ₄_bound : μ₄ ≤ C₄ * s ^ 2 := by
    simpa [μ₄, s, C₄] using fourth_moment_upper_uniform n lam
  have hμ₄_div_bound : μ₄ / 24 ≤ C₄ * s ^ 2 := by
    nlinarith [hμ₄_bound]
  have hδa : |a - (-s / 2 + μ₄ / 24)| ≤ C_R * s ^ 3 := by
    dsimp [a, s, μ₄]
    convert hCR n lam hs_one using 1 <;> ring_nf
  set δa : ℝ := a - (-s / 2 + μ₄ / 24)
  have hδa_bound : |δa| ≤ C_R * s ^ 3 := by
    simpa [δa] using hδa
  set c : ℝ := μ₄ / 24 + δa
  have ha_eq : a = -s / 2 + c := by
    dsimp [a, c, δa]
    ring
  have hc_bound : |c| ≤ A * s ^ 2 := by
    have htri : |c| ≤ |μ₄ / 24| + |δa| := by
      dsimp [c]
      simpa [sub_eq_add_neg] using abs_sub (μ₄ / 24) (-δa)
    unfold A
    have hμ₄_div_nonneg : 0 ≤ μ₄ / 24 := by positivity
    rw [abs_of_nonneg hμ₄_div_nonneg] at htri
    calc
      |c| ≤ μ₄ / 24 + C_R * s ^ 3 := by nlinarith [htri, hδa_bound]
      _ ≤ C₄ * s ^ 2 + C_R * s ^ 3 := by nlinarith [hμ₄_div_bound]
      _ ≤ A * s ^ 2 := by nlinarith [hs_cube_le_sq, hs_nonneg]
  have ha_bound : |a| ≤ 2 * A * s := by
    have htri : |a| ≤ |c| + |s / 2| := by
      rw [ha_eq]
      simpa [sub_eq_add_neg, add_comm, neg_div] using abs_sub c (s / 2)
    unfold A
    have hs_div_nonneg : 0 ≤ s / 2 := by positivity
    rw [abs_of_nonneg hs_div_nonneg] at htri
    calc
      |a| ≤ A * s ^ 2 + s / 2 := by nlinarith [htri, hc_bound]
      _ ≤ A * s + s / 2 := by gcongr
      _ ≤ 2 * A * s := by nlinarith [hs_nonneg, hA_pos]
  have hb_aux : |b| ≤ C_I * s ^ 2 + C_T * s ^ (3 / 2 : ℝ) := by
    have htri : |b| ≤ |b + cubicT n lam| + |cubicT n lam| := by
      dsimp [b]
      simpa using abs_sub ((psi n lam).im + cubicT n lam) (cubicT n lam)
    have hmain : |(psi n lam).im + cubicT n lam| ≤ C_I * s ^ 2 := by
      simpa [b, s] using hCI n lam hs_one
    have hT : |cubicT n lam| ≤ C_T * s ^ (3 / 2 : ℝ) := by
      simpa [s] using hCT n lam
    nlinarith
  have hb_bound : |b| ≤ B * s ^ (3 / 2 : ℝ) := by
    unfold B
    nlinarith [hb_aux, hs_sq_le_three_halves, hs_nonneg]
  have hz_decomp : z = a + Complex.I * b := by
    apply Complex.ext <;> simp [z, a, b]
  have hz_bound : ‖z‖ ≤ M * s := by
    rw [hz_decomp]
    calc
      ‖(a : ℂ) + Complex.I * b‖ ≤ ‖(a : ℂ)‖ + ‖Complex.I * b‖ := norm_add_le _ _
      _ = |a| + |b| := by simp [Complex.norm_real, norm_mul]
      _ ≤ 2 * A * s + B * s ^ (3 / 2 : ℝ) := by gcongr
      _ ≤ M * s := by
        unfold M
        nlinarith [hs_three_halves_le_s, hs_nonneg]
  have hsM : s ≤ 1 / (2 * M) := by
    exact le_trans hlam (min_le_right _ _)
  have hz_half : ‖z‖ ≤ 1 / 2 := by
    have hsM_half : M * s ≤ 1 / 2 := by
      have hmul := mul_le_mul_of_nonneg_left hsM hM_pos.le
      have hcalc : M * (1 / (2 * M)) = 1 / 2 := by
        field_simp [hM_pos.ne']
      exact hmul.trans_eq hcalc
    exact le_trans hz_bound hsM_half
  have hz_cube : ‖z‖ ^ 3 ≤ M ^ 3 * s ^ 3 := by
    calc
      ‖z‖ ^ 3 ≤ (M * s) ^ 3 := by
        exact pow_le_pow_left₀ (norm_nonneg z) hz_bound 3
      _ = M ^ 3 * s ^ 3 := by ring
  have hlog_taylor :
      ‖Complex.log (psi n lam) - z + z ^ 2 / 2‖ ≤ M ^ 3 * s ^ 3 := by
    have hz_eq : 1 + z = psi n lam := by
      simp [z]
    have h : ‖Complex.log (psi n lam) - z + z ^ 2 / 2‖ ≤ ‖z‖ ^ 3 := by
      simpa [hz_eq] using complex_log_approx_quadratic z hz_half
    exact le_trans h hz_cube
  have hremainder :
      |(Complex.log (psi n lam)).re - (a - a ^ 2 / 2 + b ^ 2 / 2)| ≤ M ^ 3 * s ^ 3 := by
    have htmp : |(Complex.log (psi n lam) - z + z ^ 2 / 2).re| ≤ M ^ 3 * s ^ 3 := by
      exact le_trans (complex_re_abs_le_norm _) hlog_taylor
    rw [hz_decomp] at htmp
    have htmp' := htmp
    ring_nf at htmp'
    norm_num [pow_two] at htmp'
    simpa [pow_two, div_eq_mul_inv, sub_eq_add_neg, add_assoc, add_left_comm, add_comm,
      mul_assoc, mul_left_comm, mul_comm] using htmp'
  have hb_sq : |b ^ 2 / 2| ≤ B ^ 2 / 2 * s ^ 3 := by
    have hs32_sq : (s ^ (3 / 2 : ℝ)) ^ 2 = s ^ 3 := by
      rw [pow_two, ← Real.rpow_add_of_nonneg hs_nonneg (by positivity) (by positivity)]
      norm_num
    have hb2 : b ^ 2 ≤ B ^ 2 * s ^ 3 := by
      have hb2' : b ^ 2 ≤ (B * s ^ (3 / 2 : ℝ)) ^ 2 := by
        have habs : |b| ≤ |B * s ^ (3 / 2 : ℝ)| := by
          have hB_nonneg : 0 ≤ B := by
            unfold B
            positivity
          rw [abs_of_nonneg (by positivity : 0 ≤ B * s ^ (3 / 2 : ℝ))]
          exact hb_bound
        exact (sq_le_sq).2 habs
      calc
        b ^ 2 ≤ (B * s ^ (3 / 2 : ℝ)) ^ 2 := hb2'
        _ = B ^ 2 * (s ^ (3 / 2 : ℝ)) ^ 2 := by ring
        _ = B ^ 2 * s ^ 3 := by rw [hs32_sq]
    have hnonneg : 0 ≤ b ^ 2 / 2 := by positivity
    rw [abs_of_nonneg hnonneg]
    nlinarith
  have hquartic : μ₄ / 24 - s ^ 2 / 8 = quarticCorr n lam := by
    have hκ : (μ₄ - 3 * s ^ 2) / 24 = quarticCorr n lam := by
      simpa [μ₄, s] using fourth_cumulant_identity n lam
    nlinarith
  have ha_part :
      |a - a ^ 2 / 2 - (-(s / 2) + quarticCorr n lam)| ≤
        (C_R + A / 2 + A ^ 2 / 2) * s ^ 3 := by
    have hquartic' : quarticCorr n lam = μ₄ / 24 - s ^ 2 / 8 := by
      linarith [hquartic]
    have hdecomp :
        a - a ^ 2 / 2 - (-(s / 2) + quarticCorr n lam) =
          δa + s * c / 2 - c ^ 2 / 2 := by
      rw [ha_eq, hquartic']
      dsimp [c, δa]
      ring
    rw [hdecomp]
    have htri₁ : |δa + s * c / 2 - c ^ 2 / 2| ≤ |δa + s * c / 2| + |c ^ 2 / 2| := by
      simpa using abs_sub (δa + s * c / 2) (c ^ 2 / 2)
    have htri₂ : |δa + s * c / 2| ≤ |δa| + |s * c / 2| := by
      simpa [sub_eq_add_neg] using abs_sub δa (-(s * c / 2))
    have hsc : |s * c / 2| ≤ A / 2 * s ^ 3 := by
      have hsc_eq : |s * c / 2| = s * |c| / 2 := by
        rw [div_eq_mul_inv, abs_mul, abs_mul, abs_of_nonneg hs_nonneg,
          abs_of_nonneg (by positivity : 0 ≤ (2 : ℝ)⁻¹)]
        ring
      rw [hsc_eq]
      calc
        s * |c| / 2 ≤ s * (A * s ^ 2) / 2 := by gcongr
        _ = A / 2 * s ^ 3 := by ring
    have hc_sq : |c ^ 2 / 2| ≤ A ^ 2 / 2 * s ^ 3 := by
      have hnonneg : 0 ≤ c ^ 2 / 2 := by positivity
      rw [abs_of_nonneg hnonneg]
      have hc2 : c ^ 2 ≤ A ^ 2 * s ^ 4 := by
        have habs : |c| ≤ |A * s ^ 2| := by
          rw [abs_of_nonneg (by positivity : 0 ≤ A * s ^ 2)]
          exact hc_bound
        have hc2' : c ^ 2 ≤ (A * s ^ 2) ^ 2 := by
          exact (sq_le_sq).2 habs
        calc
          c ^ 2 ≤ (A * s ^ 2) ^ 2 := hc2'
          _ = A ^ 2 * s ^ 4 := by ring
      calc
        c ^ 2 / 2 ≤ (A ^ 2 * s ^ 4) / 2 := by gcongr
        _ ≤ (A ^ 2 * s ^ 3) / 2 := by gcongr
        _ = A ^ 2 / 2 * s ^ 3 := by ring
    calc
      |δa + s * c / 2 - c ^ 2 / 2| ≤ |δa + s * c / 2| + |c ^ 2 / 2| := htri₁
      _ ≤ (|δa| + |s * c / 2|) + |c ^ 2 / 2| := by gcongr
      _ = |δa| + |s * c / 2| + |c ^ 2 / 2| := by ring
      _ ≤ C_R * s ^ 3 + A / 2 * s ^ 3 + A ^ 2 / 2 * s ^ 3 := by gcongr
      _ = (C_R + A / 2 + A ^ 2 / 2) * s ^ 3 := by ring
  have happrox :
      |(a - a ^ 2 / 2 + b ^ 2 / 2) - (-(s / 2) + quarticCorr n lam)| ≤
        (C_R + A / 2 + A ^ 2 / 2 + B ^ 2 / 2) * s ^ 3 := by
    calc
      |(a - a ^ 2 / 2 + b ^ 2 / 2) - (-(s / 2) + quarticCorr n lam)| ≤
          |a - a ^ 2 / 2 - (-(s / 2) + quarticCorr n lam)| + |b ^ 2 / 2| := by
            have :=
              abs_sub (a - a ^ 2 / 2 - (-(s / 2) + quarticCorr n lam)) (-(b ^ 2 / 2))
            simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using this
      _ ≤ (C_R + A / 2 + A ^ 2 / 2) * s ^ 3 + B ^ 2 / 2 * s ^ 3 := by
            gcongr
      _ = (C_R + A / 2 + A ^ 2 / 2 + B ^ 2 / 2) * s ^ 3 := by ring
  refine ⟨(Complex.log (psi n lam)).re - (-(s / 2) + quarticCorr n lam), ?_, ?_⟩
  · unfold C_rl
    set y : ℝ := (a - a ^ 2 / 2 + b ^ 2 / 2) - (-(s / 2) + quarticCorr n lam)
    have hy_eq :
        (Complex.log (psi n lam)).re - (-(s / 2) + quarticCorr n lam) =
          ((Complex.log (psi n lam)).re - (a - a ^ 2 / 2 + b ^ 2 / 2)) + y := by
      dsimp [y]
      ring
    have hy_bound : |y| ≤ (C_R + A / 2 + A ^ 2 / 2 + B ^ 2 / 2) * s ^ 3 := by
      simpa [y] using happrox
    calc
      |(Complex.log (psi n lam)).re - (-(s / 2) + quarticCorr n lam)| =
          |((Complex.log (psi n lam)).re - (a - a ^ 2 / 2 + b ^ 2 / 2)) + y| := by
            rw [hy_eq]
      _ ≤ |(Complex.log (psi n lam)).re - (a - a ^ 2 / 2 + b ^ 2 / 2)| + |y| := by
            have :=
              abs_sub ((Complex.log (psi n lam)).re - (a - a ^ 2 / 2 + b ^ 2 / 2)) (-y)
            simpa [sub_eq_add_neg, add_assoc] using this
      _ ≤ M ^ 3 * s ^ 3 + (C_R + A / 2 + A ^ 2 / 2 + B ^ 2 / 2) * s ^ 3 := by
            gcongr
      _ = C_rl * s ^ 3 := by
            unfold C_rl
            ring
  · simp [s]

