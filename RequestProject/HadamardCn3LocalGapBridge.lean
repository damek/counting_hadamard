      refine ⟨?_, ?_⟩
      · intro i hi
        have hqi : i ∈ quarticQuadrupleVertices q.1 := (quarticChoiceVertices_subset_quadrupleVertices q.1).1 hi
        simpa [hAq] using hqi
      · simpa using quarticChoiceVertices_card (quarticQuad1 q.1)
    let hmem2 : quarticChoiceVertices (quarticQuad2 q.1) ∈ Finset.powersetCard 4 A := by
      refine Finset.mem_powersetCard.mpr ?_
      refine ⟨?_, ?_⟩
      · intro i hi
        have hqi : i ∈ quarticQuadrupleVertices q.1 := (quarticChoiceVertices_subset_quadrupleVertices q.1).2.1 hi
        simpa [hAq] using hqi
      · simpa using quarticChoiceVertices_card (quarticQuad2 q.1)
    let hmem3 : quarticChoiceVertices (quarticQuad3 q.1) ∈ Finset.powersetCard 4 A := by
      refine Finset.mem_powersetCard.mpr ?_
      refine ⟨?_, ?_⟩
      · intro i hi
        have hqi : i ∈ quarticQuadrupleVertices q.1 := (quarticChoiceVertices_subset_quadrupleVertices q.1).2.2.1 hi
        simpa [hAq] using hqi
      · simpa using quarticChoiceVertices_card (quarticQuad3 q.1)
    let hmem4 : quarticChoiceVertices (quarticQuad4 q.1) ∈ Finset.powersetCard 4 A := by
      refine Finset.mem_powersetCard.mpr ?_
      refine ⟨?_, ?_⟩
      · intro i hi
        have hqi : i ∈ quarticQuadrupleVertices q.1 := (quarticChoiceVertices_subset_quadrupleVertices q.1).2.2.2 hi
        simpa [hAq] using hqi
      · simpa using quarticChoiceVertices_card (quarticQuad4 q.1)
    ((⟨quarticChoiceVertices (quarticQuad1 q.1), hmem1⟩, (quarticQuad1 q.1).1.2),
      ((⟨quarticChoiceVertices (quarticQuad2 q.1), hmem2⟩, (quarticQuad2 q.1).1.2),
        ((⟨quarticChoiceVertices (quarticQuad3 q.1), hmem3⟩, (quarticQuad3 q.1).1.2),
          (⟨quarticChoiceVertices (quarticQuad4 q.1), hmem4⟩, (quarticQuad4 q.1).1.2))))
  have hmap_inj : Function.Injective map := by
    intro p q hpq
    apply Subtype.ext
    have h1 : (map p).1 = (map q).1 := by
      exact congrArg Prod.fst hpq
    have h2 : (map p).2.1 = (map q).2.1 := by
      exact congrArg (fun z => z.2.1) hpq
    have h3 : (map p).2.2.1 = (map q).2.2.1 := by
      exact congrArg (fun z => z.2.2.1) hpq
    have h4 : (map p).2.2.2 = (map q).2.2.2 := by
      exact congrArg (fun z => z.2.2.2) hpq
    have hξ1 : quarticQuad1 p.1 = quarticQuad1 q.1 := by
      have hV1 :
          quarticChoiceVertices (quarticQuad1 p.1) = quarticChoiceVertices (quarticQuad1 q.1) := by
        simpa [map, quarticChoiceVertices] using congrArg Subtype.val (congrArg Prod.fst h1)
      have hs1 : (quarticQuad1 p.1).1.2 = (quarticQuad1 q.1).1.2 := by
        simpa [map] using congrArg Prod.snd h1
      exact quarticChoice_eq_of_vertices_eq_shape_eq
        hV1 hs1
    have hξ2 : quarticQuad2 p.1 = quarticQuad2 q.1 := by
      have hV2 :
          quarticChoiceVertices (quarticQuad2 p.1) = quarticChoiceVertices (quarticQuad2 q.1) := by
        simpa [map, quarticChoiceVertices] using congrArg Subtype.val (congrArg Prod.fst h2)
      have hs2 : (quarticQuad2 p.1).1.2 = (quarticQuad2 q.1).1.2 := by
        simpa [map] using congrArg Prod.snd h2
      exact quarticChoice_eq_of_vertices_eq_shape_eq
        hV2 hs2
    have hξ3 : quarticQuad3 p.1 = quarticQuad3 q.1 := by
      have hV3 :
          quarticChoiceVertices (quarticQuad3 p.1) = quarticChoiceVertices (quarticQuad3 q.1) := by
        simpa [map, quarticChoiceVertices] using congrArg Subtype.val (congrArg Prod.fst h3)
      have hs3 : (quarticQuad3 p.1).1.2 = (quarticQuad3 q.1).1.2 := by
        simpa [map] using congrArg Prod.snd h3
      exact quarticChoice_eq_of_vertices_eq_shape_eq
        hV3 hs3
    have hξ4 : quarticQuad4 p.1 = quarticQuad4 q.1 := by
      have hV4 :
          quarticChoiceVertices (quarticQuad4 p.1) = quarticChoiceVertices (quarticQuad4 q.1) := by
        simpa [map, quarticChoiceVertices] using congrArg Subtype.val (congrArg Prod.fst h4)
      have hs4 : (quarticQuad4 p.1).1.2 = (quarticQuad4 q.1).1.2 := by
        simpa [map] using congrArg Prod.snd h4
      exact quarticChoice_eq_of_vertices_eq_shape_eq
        hV4 hs4
    exact Prod.ext hξ1 (Prod.ext hξ2 (Prod.ext hξ3 hξ4))
  have hcard :
      (quarticEvenQuadrupleFiber n A).card
        ≤ Fintype.card (ChoiceA × (ChoiceA × (ChoiceA × ChoiceA))) := by
    simpa [Fintype.card_coe] using Fintype.card_le_of_injective map hmap_inj
  have hshape : Fintype.card QuarticCycleShape = 3 := quarticCycleShape_card
  have hchoice :
      Fintype.card ChoiceA = (Finset.powersetCard 4 A).card * 3 := by
    simpa [ChoiceA, hshape] using
      (show Fintype.card (↥(Finset.powersetCard 4 A) × QuarticCycleShape)
          = (Finset.powersetCard 4 A).card * 3 by
        rw [Fintype.card_prod, Fintype.card_coe, hshape])
  have hchoice4 :
      Fintype.card (ChoiceA × (ChoiceA × (ChoiceA × ChoiceA)))
        = (Fintype.card ChoiceA) ^ (4 : Nat) := by
    simp [pow_succ, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
  calc
    ((quarticEvenQuadrupleFiber n A).card : ℝ)
      ≤ Fintype.card (ChoiceA × (ChoiceA × (ChoiceA × ChoiceA))) := by exact_mod_cast hcard
    _ = (Fintype.card ChoiceA : ℝ) ^ (4 : Nat) := by
          rw [hchoice4]
          norm_num
    _ = ((((Finset.powersetCard 4 A).card : ℝ) * 3) ^ (4 : Nat)) := by
          rw [hchoice]
