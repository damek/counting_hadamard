        ≤ (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
            * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := hcs
      _ ≤ ((C₄' * (dim n : ℝ) ^ (4 : Nat) / t ^ (8 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ))
            * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
              exact mul_le_mul_of_nonneg_right hA_rpow hB_factor_nonneg
      _ ≤ ((C₄' * (dim n : ℝ) ^ (4 : Nat) / t ^ (8 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ))
            * (Real.exp 4 * gaussianF (dim n) t) ^ (1 / (2 : ℝ)) := by
              exact mul_le_mul_of_nonneg_left hB_rpow hA_bound_nonneg
  have hgauss_nonneg : 0 ≤ gaussianF (dim n) t := by
    exact Real.rpow_nonneg (by positivity) _
  have hterm2 :
      (32 * t ^ (2 : Nat))
          * (((C₄' * (dim n : ℝ) ^ (4 : Nat) / t ^ (8 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ))
              * (Real.exp 4 * gaussianF (dim n) t) ^ (1 / (2 : ℝ)))
        = (32 * Real.sqrt C₄' * Real.sqrt (Real.exp 4))
            * (((dim n : ℝ) / t) ^ (2 : Nat)) * gaussianF (dim n) t := by
    let G : ℝ := gaussianF (dim n) t
    let u : ℝ := (dim n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat)
    have hG_nonneg : 0 ≤ G := by
      dsimp [G]
      exact Real.rpow_nonneg (by positivity) _
    have hu_nonneg : 0 ≤ u := by
      dsimp [u]
      positivity
    have hu_sq :
        u ^ (2 : Nat) = (dim n : ℝ) ^ (4 : Nat) / t ^ (8 : Nat) := by
      dsimp [u]
      field_simp [ht_pos.ne']
    have htu :
        t ^ (2 : Nat) * u = ((dim n : ℝ) / t) ^ (2 : Nat) := by
      dsimp [u]
      field_simp [ht_pos.ne']
    have hsqrt_u : Real.sqrt (u ^ (2 : Nat)) = u := by
      rw [Real.sqrt_sq_eq_abs, abs_of_nonneg hu_nonneg]
    have hsqrt_G : Real.sqrt G * Real.sqrt G = G := by
      nlinarith [Real.sq_sqrt hG_nonneg]
    have hArew :
        (C₄' * (dim n : ℝ) ^ (4 : Nat) / t ^ (8 : Nat)) * G = C₄' * u ^ (2 : Nat) * G := by
      rw [hu_sq]
      ring
    have hsqrt_Cu :
        Real.sqrt (C₄' * u ^ (2 : Nat)) = Real.sqrt C₄' * Real.sqrt (u ^ (2 : Nat)) := by
      rw [Real.sqrt_mul (by positivity)]
    have hsqrt_expG :
        Real.sqrt (Real.exp 4 * G) = Real.sqrt (Real.exp 4) * Real.sqrt G := by
      rw [Real.sqrt_mul (by positivity)]
    rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow]
    calc
      (32 * t ^ (2 : Nat))
          * (Real.sqrt ((C₄' * (dim n : ℝ) ^ (4 : Nat) / t ^ (8 : Nat)) * G)
              * Real.sqrt (Real.exp 4 * G))
        = (32 * t ^ (2 : Nat))
            * (Real.sqrt (C₄' * u ^ (2 : Nat) * G) * Real.sqrt (Real.exp 4 * G)) := by
              rw [hArew]
      _ = (32 * t ^ (2 : Nat))
            * ((Real.sqrt (C₄' * u ^ (2 : Nat)) * Real.sqrt G)
                * Real.sqrt (Real.exp 4 * G)) := by
              rw [show C₄' * u ^ (2 : Nat) * G = (C₄' * u ^ (2 : Nat)) * G by ring]
              rw [Real.sqrt_mul (by positivity)]
      _ = (32 * t ^ (2 : Nat))
            * (((Real.sqrt C₄' * Real.sqrt (u ^ (2 : Nat))) * Real.sqrt G)
                * (Real.sqrt (Real.exp 4) * Real.sqrt G)) := by
              rw [hsqrt_Cu, hsqrt_expG]
      _ = (32 * t ^ (2 : Nat))
            * (Real.sqrt C₄' * Real.sqrt (Real.exp 4) * u * G) := by
              rw [hsqrt_u]
              have hmulG :
                  Real.sqrt C₄' * u * Real.sqrt G * (Real.sqrt (Real.exp 4) * Real.sqrt G)
                    = Real.sqrt C₄' * Real.sqrt (Real.exp 4) * u * G := by
                calc
                  Real.sqrt C₄' * u * Real.sqrt G * (Real.sqrt (Real.exp 4) * Real.sqrt G)
                    = Real.sqrt C₄' * Real.sqrt (Real.exp 4) * u * (Real.sqrt G * Real.sqrt G) := by ring
                  _ = Real.sqrt C₄' * Real.sqrt (Real.exp 4) * u * G := by rw [hsqrt_G]
              rw [hmulG]
      _ = (32 * Real.sqrt C₄' * Real.sqrt (Real.exp 4))
            * (((dim n : ℝ) / t) ^ (2 : Nat)) * G := by
              calc
                (32 * t ^ (2 : Nat)) * (Real.sqrt C₄' * Real.sqrt (Real.exp 4) * u * G)
                  = (32 * Real.sqrt C₄' * Real.sqrt (Real.exp 4)) * (t ^ (2 : Nat) * u) * G := by ring
                _ = (32 * Real.sqrt C₄' * Real.sqrt (Real.exp 4))
                      * (((dim n : ℝ) / t) ^ (2 : Nat)) * G := by rw [htu]
      _ = (32 * Real.sqrt C₄' * Real.sqrt (Real.exp 4))
            * (((dim n : ℝ) / t) ^ (2 : Nat)) * gaussianF (dim n) t := by
              rfl
  calc
    ∫ mu in edgeCoreRegion n t, h mu
      ≤ (∫ mu in edgeCoreRegion n t, h₁ mu)
          + (32 * t ^ (2 : Nat)) * ∫ x, f x * g x ∂μ := hsplit
    _ ≤ (32 * C₂) * (((dim n : ℝ) / t) ^ (2 : Nat)) * gaussianF (dim n) t
          + (32 * t ^ (2 : Nat))
              * (((C₄' * (dim n : ℝ) ^ (4 : Nat) / t ^ (8 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ))
                  * (Real.exp 4 * gaussianF (dim n) t) ^ (1 / (2 : ℝ))) := by
            have hcoeff_nonneg : 0 ≤ 32 * t ^ (2 : Nat) := by positivity
            have h₂bound :
                (32 * t ^ (2 : Nat)) * ∫ x, f x * g x ∂μ
                  ≤ (32 * t ^ (2 : Nat))
                      * (((C₄' * (dim n : ℝ) ^ (4 : Nat) / t ^ (8 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ))
                          * (Real.exp 4 * gaussianF (dim n) t) ^ (1 / (2 : ℝ))) := by
              exact mul_le_mul_of_nonneg_left hfg hcoeff_nonneg
            simpa using add_le_add hI1 h₂bound
    _ = (32 * C₂) * (((dim n : ℝ) / t) ^ (2 : Nat)) * gaussianF (dim n) t
          + (32 * Real.sqrt C₄' * Real.sqrt (Real.exp 4))
              * (((dim n : ℝ) / t) ^ (2 : Nat)) * gaussianF (dim n) t := by
            rw [hterm2]
    _ = (C₄ * (((dim n : ℝ) / t) ^ (2 : Nat))) * gaussianF (dim n) t := by
          unfold C₄
          ring

/-- Ordered 5-tuples of edge coordinates, used for the quintic expansion. -/
private abbrev EdgeQuintuple (n : ℕ) := Fin 5 → Cn3Torus.Edge n

/-- Edge multiplicities attached to an ordered 5-tuple of edges. -/
private def Cn3Torus.edgeMultiplicity5 {n : ℕ}
    (e₁ e₂ e₃ e₄ e₅ : Cn3Torus.Edge n) : Cn3Torus.Edge n → ℕ :=
  fun e =>
    (if e = e₁ then 1 else 0) +
    (if e = e₂ then 1 else 0) +
    (if e = e₃ then 1 else 0) +
    (if e = e₄ then 1 else 0) +
    (if e = e₅ then 1 else 0)

private lemma Cn3Torus.edgeNatRowSum_edgeMultiplicity5 {n : ℕ}
    (e₁ e₂ e₃ e₄ e₅ : Cn3Torus.Edge n) (i : Fin n) :
    Cn3Torus.edgeNatRowSum (Cn3Torus.edgeMultiplicity5 e₁ e₂ e₃ e₄ e₅) i
      = (if e₁ ∈ Cn3Torus.edgesIncident n i then 1 else 0)
          + (if e₂ ∈ Cn3Torus.edgesIncident n i then 1 else 0)
          + (if e₃ ∈ Cn3Torus.edgesIncident n i then 1 else 0)
          + (if e₄ ∈ Cn3Torus.edgesIncident n i then 1 else 0)
          + (if e₅ ∈ Cn3Torus.edgesIncident n i then 1 else 0) := by
  unfold Cn3Torus.edgeNatRowSum Cn3Torus.edgeMultiplicity5
  simp [Finset.sum_add_distrib, add_assoc, add_left_comm, add_comm]

private lemma Cn3Torus.edgeZMonomial_edgeMultiplicity5 {n : ℕ}
    (y : Fin n → Bool) (e₁ e₂ e₃ e₄ e₅ : Cn3Torus.Edge n) :
    Cn3Torus.edgeZMonomial (Cn3Torus.edgeMultiplicity5 e₁ e₂ e₃ e₄ e₅) y
      = Cn3Torus.Z y e₁ * Cn3Torus.Z y e₂ * Cn3Torus.Z y e₃ * Cn3Torus.Z y e₄ * Cn3Torus.Z y e₅ := by
  let b₄ : Cn3Torus.Edge n → ℕ := Cn3Torus.edgeMultiplicity4 e₁ e₂ e₃ e₄
  let b₅ : Cn3Torus.Edge n → ℕ := fun e => if e = e₅ then 1 else 0
  have hmul :
      Cn3Torus.edgeZMonomial (fun e => b₄ e + b₅ e) y
        = Cn3Torus.edgeZMonomial b₄ y * Cn3Torus.edgeZMonomial b₅ y :=
    Cn3Torus.edgeZMonomial_add b₄ b₅ y
  have hsum :
      Cn3Torus.edgeMultiplicity5 e₁ e₂ e₃ e₄ e₅
        = fun e => b₄ e + b₅ e := by
    funext e
    simp [Cn3Torus.edgeMultiplicity5, b₄, b₅, Cn3Torus.edgeMultiplicity4, add_assoc]
  rw [hsum, hmul, Cn3Torus.edgeZMonomial_edgeMultiplicity4, Cn3Torus.edgeZMonomial_single]

private lemma Cn3Torus.exists_incident_left_not_right_of_ne {n : ℕ}
    {e f : Cn3Torus.Edge n} (hef : e ≠ f) :
    ∃ i : Fin n, e ∈ Cn3Torus.edgesIncident n i ∧ f ∉ Cn3Torus.edgesIncident n i := by
  rcases e with ⟨⟨a, b⟩, hab⟩
  rcases f with ⟨⟨c, d⟩, hcd⟩
  by_cases ha : a = c ∨ a = d
  · by_cases hb : b = c ∨ b = d
    · rcases ha with hac | had <;> rcases hb with hbc | hbd
      · exfalso
        subst hac
        exact (ne_of_lt hab) hbc.symm
      · exfalso
        subst hac
        subst hbd
        exact hef rfl
      · exfalso
        have hba : b < a := by simpa [had, hbc] using hcd
        exact (not_lt_of_gt hab) hba
      · exfalso
        have hab_eq : a = b := had.trans hbd.symm
        exact (ne_of_lt hab) hab_eq
    · refine ⟨b, ?_⟩
      constructor
      · exact Cn3Torus.edge_mem_edgesIncident_right ⟨(a, b), hab⟩
      · intro hf
        have hmem := (Cn3Torus.mem_edgesIncident_iff (i := b) (e := ⟨(c, d), hcd⟩)).1 hf
        cases hmem with
        | inl h => exact hb (Or.inl h.symm)
        | inr h => exact hb (Or.inr h.symm)
  · refine ⟨a, ?_⟩
    constructor
    · exact Cn3Torus.edge_mem_edgesIncident_left ⟨(a, b), hab⟩
    · intro hf
      have hmem := (Cn3Torus.mem_edgesIncident_iff (i := a) (e := ⟨(c, d), hcd⟩)).1 hf
      cases hmem with
      | inl h => exact ha (Or.inl h.symm)
      | inr h => exact ha (Or.inr h.symm)

private lemma Cn3Torus.edge_eq_of_incident_both_endpoints {n : ℕ}
    (e f : Cn3Torus.Edge n)
    (hleft : f ∈ Cn3Torus.edgesIncident n e.1.1)
    (hright : f ∈ Cn3Torus.edgesIncident n e.1.2) :
    f = e := by
  rcases e with ⟨⟨a, b⟩, hab⟩
  rcases f with ⟨⟨c, d⟩, hcd⟩
  rcases (Cn3Torus.mem_edgesIncident_iff (i := a) (e := ⟨(c, d), hcd⟩)).1 hleft with hca | hda
  · rcases (Cn3Torus.mem_edgesIncident_iff (i := b) (e := ⟨(c, d), hcd⟩)).1 hright with hcb | hdb
    · exfalso
      exact (ne_of_lt hab) (hca.symm.trans hcb)
    · subst hca
      subst hdb
      apply Subtype.ext
      rfl
  · rcases (Cn3Torus.mem_edgesIncident_iff (i := b) (e := ⟨(c, d), hcd⟩)).1 hright with hcb | hdb
    · exfalso
      subst hda
      subst hcb
      exact (not_lt_of_ge (le_of_lt hab)) hcd
    · exfalso
      exact (ne_of_lt hab) (hda.symm.trans hdb)

private lemma even_three_one_one_xor {n : ℕ} {i : Fin n}
    {e f g : Cn3Torus.Edge n}
    (he : e ∈ Cn3Torus.edgesIncident n i)
    (hall : Even
      ((if e ∈ Cn3Torus.edgesIncident n i then 3 else 0)
        + (if f ∈ Cn3Torus.edgesIncident n i then 1 else 0)
        + (if g ∈ Cn3Torus.edgesIncident n i then 1 else 0))) :
    (f ∈ Cn3Torus.edgesIncident n i ∧ g ∉ Cn3Torus.edgesIncident n i) ∨
      (f ∉ Cn3Torus.edgesIncident n i ∧ g ∈ Cn3Torus.edgesIncident n i) := by
  by_cases hf : f ∈ Cn3Torus.edgesIncident n i <;>
    by_cases hg : g ∈ Cn3Torus.edgesIncident n i <;>
    simp [he, hf, hg] at hall ⊢ <;> norm_num at hall

private lemma even_zero_one_one_other_mem {n : ℕ} {i : Fin n}
    {e f g : Cn3Torus.Edge n}
    (he : e ∉ Cn3Torus.edgesIncident n i)
    (hf : f ∈ Cn3Torus.edgesIncident n i)
    (hall : Even
      ((if e ∈ Cn3Torus.edgesIncident n i then 3 else 0)
        + (if f ∈ Cn3Torus.edgesIncident n i then 1 else 0)
        + (if g ∈ Cn3Torus.edgesIncident n i then 1 else 0))) :
    g ∈ Cn3Torus.edgesIncident n i := by
  by_cases hg : g ∈ Cn3Torus.edgesIncident n i
  · exact hg
  · simp [he, hf, hg] at hall

private lemma quintupleGate_eq_zero_five {n : ℕ} {e : Cn3Torus.Edge n} :
    (if ∀ i : Fin n,
        Even (Cn3Torus.edgeNatRowSum (Cn3Torus.edgeMultiplicity5 e e e e e) i)
      then 1 else 0 : ℝ) = 0 := by
  have hnot :
      ¬ ∀ i : Fin n,
        Even (Cn3Torus.edgeNatRowSum (Cn3Torus.edgeMultiplicity5 e e e e e) i) := by
    intro hall
    have hrow :
        Cn3Torus.edgeNatRowSum (Cn3Torus.edgeMultiplicity5 e e e e e) e.1.1 = 5 := by
      rw [Cn3Torus.edgeNatRowSum_edgeMultiplicity5]
      simp [Cn3Torus.edge_mem_edgesIncident_left]
    have hi := hall e.1.1
    rw [hrow] at hi
    norm_num at hi
  simpa [hnot]

private lemma quintupleGate_eq_zero_two_two_one {n : ℕ} {e f g : Cn3Torus.Edge n}
    (heg : e ≠ g) :
    (if ∀ i : Fin n,
        Even (Cn3Torus.edgeNatRowSum (Cn3Torus.edgeMultiplicity5 e e f f g) i)
      then 1 else 0 : ℝ) = 0 := by
  have hnot :
      ¬ ∀ i : Fin n,
        Even (Cn3Torus.edgeNatRowSum (Cn3Torus.edgeMultiplicity5 e e f f g) i) := by
    intro hall
    obtain ⟨i, hg, he⟩ := Cn3Torus.exists_incident_left_not_right_of_ne (e := g) (f := e) heg.symm
    have hrow :
        Cn3Torus.edgeNatRowSum (Cn3Torus.edgeMultiplicity5 e e f f g) i
          = 2 * (if f ∈ Cn3Torus.edgesIncident n i then 1 else 0) + 1 := by
      rw [Cn3Torus.edgeNatRowSum_edgeMultiplicity5]
      by_cases hf : f ∈ Cn3Torus.edgesIncident n i <;>
        simp [he, hg, hf, add_assoc, add_left_comm, add_comm]
    have hi := hall i
    rw [hrow] at hi
    by_cases hf : f ∈ Cn3Torus.edgesIncident n i
    · have hi' : Even 3 := by simpa [hf] using hi
      norm_num at hi'
    · have hi' : Even 1 := by simpa [hf] using hi
      norm_num at hi'
  simpa [hnot]

private lemma Cn3Torus.W_pow_five_eq_sum_tuple_prod
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) (y : Fin n → Bool) :
    (Cn3Torus.W mu y) ^ (5 : Nat)
      = ∑ p : Fin 5 → Cn3Torus.Edge n, ∏ i : Fin 5, mu (p i) * Cn3Torus.Z y (p i) := by
  unfold Cn3Torus.W
  simpa using (Fintype.sum_pow (fun e : Cn3Torus.Edge n => mu e * Cn3Torus.Z y e) 5)

private lemma Cn3Torus.avgOver_prod_Z_five_eq_gate
    (n : ℕ) (p : Fin 5 → Cn3Torus.Edge n) :
    Cn3Torus.avgOver n (fun y => ∏ i : Fin 5, Cn3Torus.Z y (p i))
      = if ∀ i : Fin n,
          Even (Cn3Torus.edgeNatRowSum
            (Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)) i) then 1 else 0 := by
  have hfun :
      (fun y => ∏ i : Fin 5, Cn3Torus.Z y (p i))
        = (fun y =>
            Cn3Torus.Z y (p 0) * Cn3Torus.Z y (p 1) * Cn3Torus.Z y (p 2)
              * Cn3Torus.Z y (p 3) * Cn3Torus.Z y (p 4)) := by
    funext y
    rw [Fin.prod_univ_five]
  rw [hfun]
  calc
    Cn3Torus.avgOver n
        (fun y =>
          Cn3Torus.Z y (p 0) * Cn3Torus.Z y (p 1) * Cn3Torus.Z y (p 2)
            * Cn3Torus.Z y (p 3) * Cn3Torus.Z y (p 4))
      = Cn3Torus.avgOver n
          (fun y =>
            Cn3Torus.edgeZMonomial
              (Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)) y) := by
            refine congrArg (Cn3Torus.avgOver n) ?_
            funext y
            rw [Cn3Torus.edgeZMonomial_edgeMultiplicity5 y (p 0) (p 1) (p 2) (p 3) (p 4)]
    _ = if ∀ i : Fin n,
          Even (Cn3Torus.edgeNatRowSum
            (Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)) i) then 1 else 0 := by
            simpa using
              Cn3Torus.avg_edgeZMonomial_eq_ite_allEven
                (Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4))

private lemma Cn3Torus.avgOver_weighted_prod_Z_five
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) (p : Fin 5 → Cn3Torus.Edge n) :
    Cn3Torus.avgOver n (fun y => ∏ i : Fin 5, mu (p i) * Cn3Torus.Z y (p i))
      = (∏ i : Fin 5, mu (p i))
          * (if ∀ i : Fin n,
              Even (Cn3Torus.edgeNatRowSum
                (Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)) i) then 1 else 0) := by
  have hpoint :
      (fun y => ∏ i : Fin 5, mu (p i) * Cn3Torus.Z y (p i))
        = (fun y => (∏ i : Fin 5, mu (p i)) * ∏ i : Fin 5, Cn3Torus.Z y (p i)) := by
    funext y
    rw [Finset.prod_mul_distrib]
  rw [hpoint, Cn3Torus.avgOver_mul_const_left]
  simp [Cn3Torus.avgOver_prod_Z_five_eq_gate]

/-- Exact ordered 5-edge expansion of the fifth moment. -/
private lemma momentX_five_eq_edge_quintuple_sum (n : ℕ) (lam : Fin n → Fin n → ℝ) :
    momentX n lam 5
      = ∑ p : Fin 5 → Cn3Torus.Edge n,
          (∏ i : Fin 5, edgeLam n lam (p i))
            * (if ∀ i : Fin n,
                Even (Cn3Torus.edgeNatRowSum
                  (Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)) i) then 1 else 0) := by
  let tupleIntegrand : (Fin 5 → Cn3Torus.Edge n) → (Fin n → Bool) → ℝ :=
    fun p y => ∏ i : Fin 5, edgeLam n lam (p i) * Cn3Torus.Z y (p i)
  let tupleCoeff : (Fin 5 → Cn3Torus.Edge n) → ℝ :=
    fun p =>
      (∏ i : Fin 5, edgeLam n lam (p i))
        * (if ∀ i : Fin n,
            Even (Cn3Torus.edgeNatRowSum
              (Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)) i) then 1 else 0)
  have hcoeff :
      ∀ p : Fin 5 → Cn3Torus.Edge n,
        Cn3Torus.avgOver n (tupleIntegrand p) = tupleCoeff p := by
    intro p
    simp [tupleIntegrand, tupleCoeff, Cn3Torus.avgOver_weighted_prod_Z_five]
  rw [momentX_eq_avgOver_W_pow]
  calc
    Cn3Torus.avgOver n (fun y => (Cn3Torus.W (edgeLam n lam) y) ^ (5 : Nat))
      = Cn3Torus.avgOver n (fun y => ∑ p : Fin 5 → Cn3Torus.Edge n, tupleIntegrand p y) := by
          refine congrArg (Cn3Torus.avgOver n) ?_
          funext y
          exact Cn3Torus.W_pow_five_eq_sum_tuple_prod n (edgeLam n lam) y
    _ = ∑ p : Fin 5 → Cn3Torus.Edge n,
          Cn3Torus.avgOver n (tupleIntegrand p) := by
          simpa [tupleIntegrand] using Cn3Torus.avgOver_sum n tupleIntegrand
    _ = ∑ p : Fin 5 → Cn3Torus.Edge n, tupleCoeff p := by
          refine Finset.sum_congr rfl ?_
          intro p hp
          exact hcoeff p
    _ = ∑ p : Fin 5 → Cn3Torus.Edge n,
          (∏ i : Fin 5, edgeLam n lam (p i))
            * (if ∀ i : Fin n,
                Even (Cn3Torus.edgeNatRowSum
                  (Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)) i) then 1 else 0) := by
          rfl

private def quinticMomentTupleMonomial {n : ℕ}
    (p : EdgeQuintuple n) (mu : Cn3Torus.Edge n → ℝ) : ℝ :=
  ∏ i : Fin 5, mu (p i)

private def quinticMomentTupleGate {n : ℕ} (p : EdgeQuintuple n) : ℝ :=
  if ∀ i : Fin n,
      Even (Cn3Torus.edgeNatRowSum
        (Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)) i) then 1 else 0

private lemma quinticMomentTupleGate_eq_one_iff {n : ℕ} (p : EdgeQuintuple n) :
    quinticMomentTupleGate p = 1 ↔
      ∀ i : Fin n,
        Even (Cn3Torus.edgeNatRowSum
          (Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)) i) := by
  unfold quinticMomentTupleGate
  by_cases h :
      ∀ i : Fin n,
        Even (Cn3Torus.edgeNatRowSum
          (Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)) i)
  · simp [h]
  · simp [h]

private def quinticMomentTupleMultiplicity {n : ℕ} (p : EdgeQuintuple n) :
  Cn3Torus.Edge n → ℕ :=
  Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)

private def quinticMomentTupleSupport {n : ℕ} (p : EdgeQuintuple n) : Finset (Cn3Torus.Edge n) :=
  Finset.univ.filter (fun e => 0 < quinticMomentTupleMultiplicity p e)

private def quinticMomentTupleOddEdgeSet {n : ℕ} (p : EdgeQuintuple n) : Finset (Cn3Torus.Edge n) :=
  Finset.univ.filter (fun e => Odd (quinticMomentTupleMultiplicity p e))

private def quinticGateSupportCardTuples (n : ℕ) (k : ℕ) : Finset (EdgeQuintuple n) :=
  Finset.univ.filter
    (fun p => quinticMomentTupleGate p = 1 ∧ (quinticMomentTupleSupport p).card = k)

private abbrev quinticGateSupportThreeTuples (n : ℕ) : Finset (EdgeQuintuple n) :=
  quinticGateSupportCardTuples n 3

private abbrev quinticGateSupportFourTuples (n : ℕ) : Finset (EdgeQuintuple n) :=
  quinticGateSupportCardTuples n 4

private abbrev quinticGateSupportFiveTuples (n : ℕ) : Finset (EdgeQuintuple n) :=
  quinticGateSupportCardTuples n 5

private lemma mem_quinticGateSupportCardTuples_iff {n k : ℕ} (p : EdgeQuintuple n) :
    p ∈ quinticGateSupportCardTuples n k ↔
      quinticMomentTupleGate p = 1 ∧ (quinticMomentTupleSupport p).card = k := by
  simp [quinticGateSupportCardTuples]

private lemma mem_quinticGateSupportThreeTuples_iff {n : ℕ} (p : EdgeQuintuple n) :
    p ∈ quinticGateSupportThreeTuples n ↔
      quinticMomentTupleGate p = 1 ∧ (quinticMomentTupleSupport p).card = 3 := by
  simpa [quinticGateSupportThreeTuples] using
    (mem_quinticGateSupportCardTuples_iff (n := n) (k := 3) p)

private lemma mem_quinticGateSupportFourTuples_iff {n : ℕ} (p : EdgeQuintuple n) :
    p ∈ quinticGateSupportFourTuples n ↔
      quinticMomentTupleGate p = 1 ∧ (quinticMomentTupleSupport p).card = 4 := by
  simpa [quinticGateSupportFourTuples] using
    (mem_quinticGateSupportCardTuples_iff (n := n) (k := 4) p)

private lemma mem_quinticGateSupportFiveTuples_iff {n : ℕ} (p : EdgeQuintuple n) :
    p ∈ quinticGateSupportFiveTuples n ↔
      quinticMomentTupleGate p = 1 ∧ (quinticMomentTupleSupport p).card = 5 := by
  simpa [quinticGateSupportFiveTuples] using
    (mem_quinticGateSupportCardTuples_iff (n := n) (k := 5) p)

private lemma quinticMomentTupleMultiplicity_apply {n : ℕ}
    (p : EdgeQuintuple n) (e : Cn3Torus.Edge n) :
    quinticMomentTupleMultiplicity p e
      = (if e = p 0 then 1 else 0)
          + (if e = p 1 then 1 else 0)
          + (if e = p 2 then 1 else 0)
          + (if e = p 3 then 1 else 0)
          + (if e = p 4 then 1 else 0) := by
  simp [quinticMomentTupleMultiplicity, Cn3Torus.edgeMultiplicity5, add_assoc]

private lemma quinticMomentTupleMultiplicity_total_degree {n : ℕ} (p : EdgeQuintuple n) :
    ∑ e : Cn3Torus.Edge n, quinticMomentTupleMultiplicity p e = 5 := by
  classical
  rw [show quinticMomentTupleMultiplicity p
      = Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4) by
        rfl]
  unfold Cn3Torus.edgeMultiplicity5
  repeat rw [Finset.sum_add_distrib]
  have h0 : ∑ e : Cn3Torus.Edge n, (if e = p 0 then 1 else 0) = 1 := by
    rw [Finset.sum_eq_single (p 0)]
    · simp
    · intro e he hne
      simp [hne]
    · intro hnot
      exact False.elim (hnot (Finset.mem_univ (p 0)))
  have h1 : ∑ e : Cn3Torus.Edge n, (if e = p 1 then 1 else 0) = 1 := by
    rw [Finset.sum_eq_single (p 1)]
    · simp
    · intro e he hne
      simp [hne]
    · intro hnot
      exact False.elim (hnot (Finset.mem_univ (p 1)))
  have h2 : ∑ e : Cn3Torus.Edge n, (if e = p 2 then 1 else 0) = 1 := by
    rw [Finset.sum_eq_single (p 2)]
    · simp
    · intro e he hne
      simp [hne]
    · intro hnot
      exact False.elim (hnot (Finset.mem_univ (p 2)))
  have h3 : ∑ e : Cn3Torus.Edge n, (if e = p 3 then 1 else 0) = 1 := by
    rw [Finset.sum_eq_single (p 3)]
    · simp
    · intro e he hne
      simp [hne]
    · intro hnot
      exact False.elim (hnot (Finset.mem_univ (p 3)))
  have h4 : ∑ e : Cn3Torus.Edge n, (if e = p 4 then 1 else 0) = 1 := by
    rw [Finset.sum_eq_single (p 4)]
    · simp
    · intro e he hne
      simp [hne]
    · intro hnot
      exact False.elim (hnot (Finset.mem_univ (p 4)))
  rw [h0, h1, h2, h3, h4]

private lemma mem_quinticMomentTupleSupport_iff {n : ℕ}
    (p : EdgeQuintuple n) (e : Cn3Torus.Edge n) :
    e ∈ quinticMomentTupleSupport p ↔ 0 < quinticMomentTupleMultiplicity p e := by
  simp [quinticMomentTupleSupport]

private lemma quinticMomentTupleSupport_card_le_five {n : ℕ} (p : EdgeQuintuple n) :
    (quinticMomentTupleSupport p).card ≤ 5 := by
  let S := quinticMomentTupleSupport p
  let T : ℕ := Finset.sum S (fun e => quinticMomentTupleMultiplicity p e)
  have hle :
      S.card ≤ T := by
    calc
      S.card = Finset.sum S (fun _ => 1) := by simp
      _ ≤ Finset.sum S (fun e => quinticMomentTupleMultiplicity p e) := by
            refine Finset.sum_le_sum ?_
            intro e he
            exact Nat.succ_le_of_lt (by simpa [S] using (mem_quinticMomentTupleSupport_iff p e).1 he)
      _ = T := by rfl
  have hsum_le :
      T
        ≤ (∑ e : Cn3Torus.Edge n, quinticMomentTupleMultiplicity p e) := by
    simpa [T] using
      (Finset.sum_le_sum_of_subset_of_nonneg (s := S) (t := (Finset.univ : Finset (Cn3Torus.Edge n)))
        (by intro e he; simp)
        (by intro e he hnot; exact Nat.zero_le _))
  exact le_trans hle (by simpa [S, T, quinticMomentTupleMultiplicity_total_degree] using hsum_le)

private lemma quinticMomentTuple_mem_support {n : ℕ}
    (p : EdgeQuintuple n) (i : Fin 5) :
    p i ∈ quinticMomentTupleSupport p := by
  rw [mem_quinticMomentTupleSupport_iff]
  fin_cases i <;> simp [quinticMomentTupleMultiplicity_apply]

private lemma quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support {n : ℕ}
    (p : EdgeQuintuple n) {e : Cn3Torus.Edge n}
    (he : e ∉ quinticMomentTupleSupport p) :
    quinticMomentTupleMultiplicity p e = 0 := by
  have hnot : ¬ 0 < quinticMomentTupleMultiplicity p e := by
    simpa [mem_quinticMomentTupleSupport_iff] using he
  omega

private lemma quinticMomentTuple_rowSum_of_support_two_left_not_right {n : ℕ}
    {p : EdgeQuintuple n} {e f : Cn3Torus.Edge n}
    (hsupp : quinticMomentTupleSupport p = ({e, f} : Finset (Cn3Torus.Edge n)))
    {i : Fin n} (hei : e ∈ Cn3Torus.edgesIncident n i)
    (hfi : f ∉ Cn3Torus.edgesIncident n i) :
    Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i
      = quinticMomentTupleMultiplicity p e := by
  unfold Cn3Torus.edgeNatRowSum
  refine Finset.sum_eq_single_of_mem e hei ?_
  intro x hx hxe
  have hxf : x ≠ f := by
    intro hxf
    subst hxf
    exact hfi hx
  have hxnot : x ∉ quinticMomentTupleSupport p := by
    have : x ∉ ({e, f} : Finset (Cn3Torus.Edge n)) := by
      simp [hxe, hxf]
    simpa [hsupp] using this
  simp [quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support p hxnot]

private lemma quinticMomentTupleGate_congr_of_multiplicity_eq {n : ℕ}
    {p q : EdgeQuintuple n}
    (h : quinticMomentTupleMultiplicity p = quinticMomentTupleMultiplicity q) :
    quinticMomentTupleGate p = quinticMomentTupleGate q := by
  unfold quinticMomentTupleGate
  simp_rw [show
      Cn3Torus.edgeMultiplicity5 (p 0) (p 1) (p 2) (p 3) (p 4)
        = quinticMomentTupleMultiplicity p by rfl]
  simp_rw [show
      Cn3Torus.edgeMultiplicity5 (q 0) (q 1) (q 2) (q 3) (q 4)
        = quinticMomentTupleMultiplicity q by rfl]
  simp [h]

private lemma quintic_gate_support_one_false {n : ℕ} {p : EdgeQuintuple n}
    (hgate : quinticMomentTupleGate p = 1)
    (hcard : (quinticMomentTupleSupport p).card = 1) :
    False := by
  rcases Finset.card_eq_one.mp hcard with ⟨e, he⟩
  have hpconst : p = fun _ => e := by
    funext i
    have hi : p i ∈ quinticMomentTupleSupport p := quinticMomentTuple_mem_support p i
    simpa [he] using hi
  have hgate0 : quinticMomentTupleGate p = 0 := by
    rw [hpconst]
    simpa [quinticMomentTupleGate] using (quintupleGate_eq_zero_five (e := e))
  linarith

private lemma quintic_gate_support_two_false {n : ℕ} {p : EdgeQuintuple n}
    (hgate : quinticMomentTupleGate p = 1)
    (hcard : (quinticMomentTupleSupport p).card = 2) :
    False := by
  classical
  rcases Finset.card_eq_two.mp hcard with ⟨e, f, hef, hsupp⟩
  let a := quinticMomentTupleMultiplicity p e
  let b := quinticMomentTupleMultiplicity p f
  have ha_pos : 0 < a := by
    dsimp [a]
    exact (mem_quinticMomentTupleSupport_iff p e).1 (by simpa [hsupp] using
      (show e ∈ ({e, f} : Finset (Cn3Torus.Edge n)) by simp))
  have hb_pos : 0 < b := by
    dsimp [b]
    exact (mem_quinticMomentTupleSupport_iff p f).1 (by simpa [hsupp] using
      (show f ∈ ({e, f} : Finset (Cn3Torus.Edge n)) by simp))
  have hsum_support :
      Finset.sum (quinticMomentTupleSupport p) (fun x => quinticMomentTupleMultiplicity p x) = 5 := by
    calc
      Finset.sum (quinticMomentTupleSupport p) (fun x => quinticMomentTupleMultiplicity p x)
        = ∑ x : Cn3Torus.Edge n,
            if 0 < quinticMomentTupleMultiplicity p x then quinticMomentTupleMultiplicity p x else 0 := by
              simp [quinticMomentTupleSupport, Finset.sum_filter]
      _ = ∑ x : Cn3Torus.Edge n, quinticMomentTupleMultiplicity p x := by
            refine Finset.sum_congr rfl ?_
            intro x hx
            by_cases hpos : 0 < quinticMomentTupleMultiplicity p x
            · simp [hpos]
            · have hx0 : quinticMomentTupleMultiplicity p x = 0 := by omega
              simp [hpos, hx0]
      _ = 5 := quinticMomentTupleMultiplicity_total_degree p
  have hsum : a + b = 5 := by
    simpa [a, b, hsupp, hef, add_comm, add_left_comm, add_assoc] using hsum_support
  have hall :
      ∀ i : Fin n, Even (Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i) := by
    intro i
    simpa [quinticMomentTupleMultiplicity] using ((quinticMomentTupleGate_eq_one_iff p).1 hgate i)
  have hcases :
      (a = 1 ∧ b = 4) ∨ (a = 2 ∧ b = 3) ∨ (a = 3 ∧ b = 2) ∨ (a = 4 ∧ b = 1) := by
    omega
  rcases hcases with h14 | h23 | h32 | h41
  · rcases h14 with ⟨ha1, hb4⟩
    obtain ⟨i, hei, hfi⟩ := Cn3Torus.exists_incident_left_not_right_of_ne hef
    have hrow :
        Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i = a := by
      rw [quinticMomentTuple_rowSum_of_support_two_left_not_right
        (p := p) (e := e) (f := f) hsupp hei hfi]
    have hi := hall i
    rw [hrow, ha1] at hi
    norm_num at hi
  · rcases h23 with ⟨ha2, hb3⟩
    have hsupp' : quinticMomentTupleSupport p = ({f, e} : Finset (Cn3Torus.Edge n)) := by
      simpa [Finset.pair_comm] using hsupp
    obtain ⟨i, hfi, hei⟩ := Cn3Torus.exists_incident_left_not_right_of_ne (e := f) (f := e) hef.symm
    have hrow :
        Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i = b := by
      rw [quinticMomentTuple_rowSum_of_support_two_left_not_right
        (p := p) (e := f) (f := e) hsupp' hfi hei]
    have hi := hall i
    rw [hrow, hb3] at hi
    norm_num at hi
  · rcases h32 with ⟨ha3, hb2⟩
    obtain ⟨i, hei, hfi⟩ := Cn3Torus.exists_incident_left_not_right_of_ne hef
    have hrow :
        Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i = a := by
      rw [quinticMomentTuple_rowSum_of_support_two_left_not_right
        (p := p) (e := e) (f := f) hsupp hei hfi]
    have hi := hall i
    rw [hrow, ha3] at hi
    norm_num at hi
  · rcases h41 with ⟨ha4, hb1⟩
    have hsupp' : quinticMomentTupleSupport p = ({f, e} : Finset (Cn3Torus.Edge n)) := by
      simpa [Finset.pair_comm] using hsupp
    obtain ⟨i, hfi, hei⟩ := Cn3Torus.exists_incident_left_not_right_of_ne (e := f) (f := e) hef.symm
    have hrow :
        Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i = b := by
      rw [quinticMomentTuple_rowSum_of_support_two_left_not_right
        (p := p) (e := f) (f := e) hsupp' hfi hei]
    have hi := hall i
    rw [hrow, hb1] at hi
    norm_num at hi

private lemma quinticMomentTupleSupport_sum_multiplicity_eq_five {n : ℕ}
    (p : EdgeQuintuple n) :
    Finset.sum (quinticMomentTupleSupport p) (fun e => quinticMomentTupleMultiplicity p e) = 5 := by
  calc
    Finset.sum (quinticMomentTupleSupport p) (fun e => quinticMomentTupleMultiplicity p e)
      = ∑ e : Cn3Torus.Edge n,
          if 0 < quinticMomentTupleMultiplicity p e then quinticMomentTupleMultiplicity p e else 0 := by
            simp [quinticMomentTupleSupport, Finset.sum_filter]
    _ = ∑ e : Cn3Torus.Edge n, quinticMomentTupleMultiplicity p e := by
          refine Finset.sum_congr rfl ?_
          intro e he
          by_cases hpos : 0 < quinticMomentTupleMultiplicity p e
          · simp [hpos]
          · have hz : quinticMomentTupleMultiplicity p e = 0 := by omega
            simp [hpos, hz]
    _ = 5 := quinticMomentTupleMultiplicity_total_degree p

private lemma quinticMomentTupleMultiplicity_eq_of_support_eq {n : ℕ}
    {p q : EdgeQuintuple n}
    (hsupp : quinticMomentTupleSupport p = quinticMomentTupleSupport q)
    (hvals :
      ∀ e ∈ quinticMomentTupleSupport p,
        quinticMomentTupleMultiplicity p e = quinticMomentTupleMultiplicity q e) :
    quinticMomentTupleMultiplicity p = quinticMomentTupleMultiplicity q := by
  funext e
  by_cases he : e ∈ quinticMomentTupleSupport p
  · exact hvals e he
  · have he' : e ∉ quinticMomentTupleSupport q := by
      simpa [hsupp] using he
    rw [quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support p he,
      quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support q he']

private lemma quinticMomentTupleSupport_eq_triple_of_card_three {n : ℕ} {p : EdgeQuintuple n}
    (hcard : (quinticMomentTupleSupport p).card = 3) :
    ∃ e f g : Cn3Torus.Edge n,
      e ≠ f ∧ e ≠ g ∧ f ≠ g ∧
      quinticMomentTupleSupport p = ({e, f, g} : Finset (Cn3Torus.Edge n)) := by
  let S := quinticMomentTupleSupport p
  have hScard : S.card = 3 := by simpa [S] using hcard
  have hSpos : 0 < S.card := by omega
  obtain ⟨e, he⟩ := Finset.card_pos.mp hSpos
  have hrest_card : (S.erase e).card = 2 := by
    have hcard' : (S.erase e).card + 1 = S.card := Finset.card_erase_add_one he
    omega
  rcases Finset.card_eq_two.mp hrest_card with ⟨f, g, hfg, hrest⟩
  have hf_mem : f ∈ S.erase e := by simpa [hrest] using (show f ∈ ({f, g} : Finset (Cn3Torus.Edge n)) by simp)
  have hg_mem : g ∈ S.erase e := by simpa [hrest] using (show g ∈ ({f, g} : Finset (Cn3Torus.Edge n)) by simp)
  have hef : e ≠ f := ((Finset.mem_erase.mp hf_mem).1).symm
  have heg : e ≠ g := ((Finset.mem_erase.mp hg_mem).1).symm
  refine ⟨e, f, g, hef, heg, hfg, ?_⟩
  calc
    quinticMomentTupleSupport p = insert e (S.erase e) := by
      simpa [S] using (Finset.insert_erase he).symm
    _ = insert e ({f, g} : Finset (Cn3Torus.Edge n)) := by rw [hrest]
    _ = ({e, f, g} : Finset (Cn3Torus.Edge n)) := by
      rfl

private lemma quintic_gate_support_five_all_one {n : ℕ} {p : EdgeQuintuple n}
    (hcard : (quinticMomentTupleSupport p).card = 5) :
    ∀ e ∈ quinticMomentTupleSupport p, quinticMomentTupleMultiplicity p e = 1 := by
  intro e he
  let S := quinticMomentTupleSupport p
  have hScard : S.card = 5 := by simpa [S] using hcard
  have hsumS : Finset.sum S (fun x => quinticMomentTupleMultiplicity p x) = 5 := by
    simpa [S] using quinticMomentTupleSupport_sum_multiplicity_eq_five p
  have he_pos : 1 ≤ quinticMomentTupleMultiplicity p e := by
    exact Nat.succ_le_of_lt ((mem_quinticMomentTupleSupport_iff p e).1 he)
  have hrest_ge :
      (S.erase e).card ≤ Finset.sum (S.erase e) (fun x => quinticMomentTupleMultiplicity p x) := by
    calc
      (S.erase e).card = Finset.sum (S.erase e) (fun _ => 1) := by simp
      _ ≤ Finset.sum (S.erase e) (fun x => quinticMomentTupleMultiplicity p x) := by
            refine Finset.sum_le_sum ?_
            intro x hx
            exact Nat.succ_le_of_lt ((mem_quinticMomentTupleSupport_iff p x).1 (Finset.mem_of_mem_erase hx))
  have hrest_card : (S.erase e).card = 4 := by
    have hcard' : (S.erase e).card + 1 = S.card := Finset.card_erase_add_one he
    omega
  have hupper : quinticMomentTupleMultiplicity p e ≤ 1 := by
    have hsplit' :
        quinticMomentTupleMultiplicity p e
          + Finset.sum (S.erase e) (fun x => quinticMomentTupleMultiplicity p x)
            = Finset.sum S (fun x => quinticMomentTupleMultiplicity p x) := by
      simpa [add_comm, add_left_comm, add_assoc] using
        (S.sum_erase_add (fun x => quinticMomentTupleMultiplicity p x) he)
    have hsum_split :
        quinticMomentTupleMultiplicity p e
          + Finset.sum (S.erase e) (fun x => quinticMomentTupleMultiplicity p x) = 5 := by
      rw [hsplit']
      exact hsumS
    have hrest_lb : 4 ≤ Finset.sum (S.erase e) (fun x => quinticMomentTupleMultiplicity p x) := by
      simpa [hrest_card] using hrest_ge
    omega
  exact le_antisymm hupper he_pos

private lemma Cn3Torus.sum_incident_indicators_eq_two {n : ℕ} (e : Cn3Torus.Edge n) :
    ∑ i : Fin n, (if e ∈ Cn3Torus.edgesIncident n i then 1 else 0) = 2 := by
  rcases e with ⟨⟨u, v⟩, huv⟩
  let e' : Cn3Torus.Edge n := ⟨(u, v), huv⟩
  have hfilter :
      ((Finset.univ : Finset (Fin n)).filter (fun i => e' ∈ Cn3Torus.edgesIncident n i))
        = ({u, v} : Finset (Fin n)) := by
    ext i
    simp [e', Cn3Torus.mem_edgesIncident_iff, Finset.mem_insert, Finset.mem_singleton,
      eq_comm, ne_of_lt huv]
  calc
    ∑ i : Fin n, (if e' ∈ Cn3Torus.edgesIncident n i then 1 else 0)
      = Finset.sum
          (((Finset.univ : Finset (Fin n)).filter
            (fun i => e' ∈ Cn3Torus.edgesIncident n i)))
          (fun _ => (1 : ℕ)) := by
          rw [← Finset.sum_filter]
    _ = Finset.sum ({u, v} : Finset (Fin n)) (fun _ => (1 : ℕ)) := by
          rw [hfilter]
    _ = 2 := by
          simp [ne_of_lt huv]

private lemma quinticMomentTuple_rowSum_total {n : ℕ} (p : EdgeQuintuple n) :
    ∑ i : Fin n, Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i = 10 := by
  calc
    ∑ i : Fin n, Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i
      = ∑ i : Fin n,
          ((if p 0 ∈ Cn3Torus.edgesIncident n i then 1 else 0)
            + (if p 1 ∈ Cn3Torus.edgesIncident n i then 1 else 0)
            + (if p 2 ∈ Cn3Torus.edgesIncident n i then 1 else 0)
            + (if p 3 ∈ Cn3Torus.edgesIncident n i then 1 else 0)
            + (if p 4 ∈ Cn3Torus.edgesIncident n i then 1 else 0)) := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          simpa [quinticMomentTupleMultiplicity, Cn3Torus.edgeNatRowSum_edgeMultiplicity5]
    _ = (∑ i : Fin n, (if p 0 ∈ Cn3Torus.edgesIncident n i then 1 else 0))
          + (∑ i : Fin n, (if p 1 ∈ Cn3Torus.edgesIncident n i then 1 else 0))
          + (∑ i : Fin n, (if p 2 ∈ Cn3Torus.edgesIncident n i then 1 else 0))
          + (∑ i : Fin n, (if p 3 ∈ Cn3Torus.edgesIncident n i then 1 else 0))
          + (∑ i : Fin n, (if p 4 ∈ Cn3Torus.edgesIncident n i then 1 else 0)) := by
          simp [Finset.sum_add_distrib, add_assoc, add_left_comm, add_comm]
    _ = 2 + 2 + 2 + 2 + 2 := by
          rw [Cn3Torus.sum_incident_indicators_eq_two (p 0),
            Cn3Torus.sum_incident_indicators_eq_two (p 1),
            Cn3Torus.sum_incident_indicators_eq_two (p 2),
            Cn3Torus.sum_incident_indicators_eq_two (p 3),
            Cn3Torus.sum_incident_indicators_eq_two (p 4)]
    _ = 10 := by
          norm_num

private def quinticActiveVertices {n : ℕ} (p : EdgeQuintuple n) : Finset (Fin n) :=
  (Finset.univ : Finset (Fin n)).filter
    (fun i => 0 < Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i)

private lemma mem_quinticActiveVertices_iff {n : ℕ} (p : EdgeQuintuple n) {i : Fin n} :
    i ∈ quinticActiveVertices p ↔
      0 < Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i := by
  simp [quinticActiveVertices]

private lemma quinticMomentTuple_edge_left_endpoint_active {n : ℕ} {p : EdgeQuintuple n}
    {e : Cn3Torus.Edge n} (he : e ∈ quinticMomentTupleSupport p) :
    e.1.1 ∈ quinticActiveVertices p := by
  rw [mem_quinticActiveVertices_iff]
  have hnonneg :
      ∀ e' ∈ Cn3Torus.edgesIncident n e.1.1, 0 ≤ quinticMomentTupleMultiplicity p e' := by
    intro e' he'
    exact Nat.zero_le _
  have hle :
      quinticMomentTupleMultiplicity p e
        ≤ Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) e.1.1 := by
    exact Finset.single_le_sum hnonneg (Cn3Torus.edge_mem_edgesIncident_left e)
  exact lt_of_lt_of_le ((mem_quinticMomentTupleSupport_iff p e).1 he) hle

private lemma quinticMomentTuple_edge_right_endpoint_active {n : ℕ} {p : EdgeQuintuple n}
    {e : Cn3Torus.Edge n} (he : e ∈ quinticMomentTupleSupport p) :
    e.1.2 ∈ quinticActiveVertices p := by
  rw [mem_quinticActiveVertices_iff]
  have hnonneg :
      ∀ e' ∈ Cn3Torus.edgesIncident n e.1.2, 0 ≤ quinticMomentTupleMultiplicity p e' := by
    intro e' he'
    exact Nat.zero_le _
  have hle :
      quinticMomentTupleMultiplicity p e
        ≤ Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) e.1.2 := by
    exact Finset.single_le_sum hnonneg (Cn3Torus.edge_mem_edgesIncident_right e)
  exact lt_of_lt_of_le ((mem_quinticMomentTupleSupport_iff p e).1 he) hle

private lemma quinticActiveVertices_rowSum_sum_eq_ten {n : ℕ} (p : EdgeQuintuple n) :
    Finset.sum (quinticActiveVertices p)
      (fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i) = 10 := by
  have hsplit :
      Finset.sum (quinticActiveVertices p)
          (fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i)
        + Finset.sum
            ((Finset.univ : Finset (Fin n)).filter
              (fun i => ¬ 0 < Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i))
            (fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i)
        = ∑ i : Fin n, Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i := by
    simpa [quinticActiveVertices] using
      (Finset.sum_filter_add_sum_filter_not
        (s := (Finset.univ : Finset (Fin n)))
        (p := fun i => 0 < Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i)
        (f := fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i))
  have hzero :
      Finset.sum
          ((Finset.univ : Finset (Fin n)).filter
            (fun i => ¬ 0 < Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i))
          (fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i) = 0 := by
    refine Finset.sum_eq_zero ?_
    intro i hi
    have hnot :
        ¬ 0 < Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i := by
      exact (Finset.mem_filter.mp hi).2
    omega
  rw [hzero, add_zero] at hsplit
  calc
    Finset.sum (quinticActiveVertices p)
        (fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i)
      = ∑ i : Fin n, Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i := hsplit
    _ = 10 := quinticMomentTuple_rowSum_total p

private lemma quintic_gate_support_five_activeVertices_card_le_five {n : ℕ} {p : EdgeQuintuple n}
    (hgate : quinticMomentTupleGate p = 1)
    (hcard : (quinticMomentTupleSupport p).card = 5) :
    (quinticActiveVertices p).card ≤ 5 := by
  let A := quinticActiveVertices p
  have hsumActive :
      Finset.sum A
        (fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i) = 10 := by
    exact quinticActiveVertices_rowSum_sum_eq_ten p
  have hgateEven := (quinticMomentTupleGate_eq_one_iff p).1 hgate
  have hlower :
      2 * A.card
        ≤ Finset.sum A
            (fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i) := by
    calc
      2 * A.card
        = Finset.sum A (fun _ => 2) := by
            rw [Nat.mul_comm]
            simp
      _ ≤ Finset.sum A
            (fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i) := by
            refine Finset.sum_le_sum ?_
            intro i hi
            have hpos :
                0 < Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i := by
              exact (mem_quinticActiveVertices_iff p).1 (by simpa [A] using hi)
            have heven :
                Even (Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i) := by
              exact hgateEven i
            rcases heven with ⟨k, hk⟩
            omega
  dsimp [A] at hsumActive hlower ⊢
  omega

private lemma Cn3Torus.edgeFromOffdiag_mem_edgesIncident_other {n : ℕ}
    (i : Fin n) (j : {k : Fin n // k ≠ i}) :
    Cn3Torus.edgeFromOffdiag i j ∈ Cn3Torus.edgesIncident n j.1 := by
  unfold Cn3Torus.edgeFromOffdiag
  by_cases hij : i < j.1
  · simp [hij, Cn3Torus.mem_edgesIncident_iff]
  · simp [hij, Cn3Torus.mem_edgesIncident_iff]

private lemma quinticMomentTuple_incident_vertex_active {n : ℕ} {p : EdgeQuintuple n}
    {e : Cn3Torus.Edge n} {i : Fin n}
    (he : e ∈ quinticMomentTupleSupport p)
    (hi : e ∈ Cn3Torus.edgesIncident n i) :
    i ∈ quinticActiveVertices p := by
  rw [mem_quinticActiveVertices_iff]
  have hnonneg :
      ∀ e' ∈ Cn3Torus.edgesIncident n i, 0 ≤ quinticMomentTupleMultiplicity p e' := by
    intro e' he'
    exact Nat.zero_le _
  have hle :
      quinticMomentTupleMultiplicity p e
        ≤ Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i := by
    exact Finset.single_le_sum hnonneg hi
  exact lt_of_lt_of_le ((mem_quinticMomentTupleSupport_iff p e).1 he) hle

private lemma quintic_gate_support_five_rowSum_eq_incident_support_card {n : ℕ}
    {p : EdgeQuintuple n} (hcard : (quinticMomentTupleSupport p).card = 5)
    (i : Fin n) :
    Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i
      = (((quinticMomentTupleSupport p).filter
            (fun e => e ∈ Cn3Torus.edgesIncident n i)).card) := by
  have hall_one := quintic_gate_support_five_all_one (p := p) hcard
  calc
    Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i
      = Finset.sum
          ((Cn3Torus.edgesIncident n i).filter
            (fun e => 0 < quinticMomentTupleMultiplicity p e))
          (fun e => quinticMomentTupleMultiplicity p e) := by
            unfold Cn3Torus.edgeNatRowSum
            symm
            refine Finset.sum_subset ?_ ?_
            · intro e he
              exact (Finset.mem_filter.mp he).1
            · intro e heInc heNot
              have hnot_pos : ¬ 0 < quinticMomentTupleMultiplicity p e := by
                intro hpos
                exact heNot (Finset.mem_filter.mpr ⟨heInc, hpos⟩)
              omega
    _ = Finset.sum
          ((quinticMomentTupleSupport p).filter
            (fun e => e ∈ Cn3Torus.edgesIncident n i))
          (fun _ => (1 : ℕ)) := by
            have hset :
                ((Cn3Torus.edgesIncident n i).filter
                  (fun e => 0 < quinticMomentTupleMultiplicity p e))
                  =
                ((quinticMomentTupleSupport p).filter
                  (fun e => e ∈ Cn3Torus.edgesIncident n i)) := by
              ext e
              constructor
              · intro he
                rcases Finset.mem_filter.mp he with ⟨heInc, hePos⟩
                exact Finset.mem_filter.mpr
                  ⟨(mem_quinticMomentTupleSupport_iff p e).2 hePos, heInc⟩
              · intro he
                rcases Finset.mem_filter.mp he with ⟨heS, heInc⟩
                exact Finset.mem_filter.mpr
                  ⟨heInc, (mem_quinticMomentTupleSupport_iff p e).1 heS⟩
            rw [hset]
            refine Finset.sum_congr rfl ?_
            intro e he
            exact hall_one e ((Finset.mem_filter.mp he).1)
    _ = (((quinticMomentTupleSupport p).filter
            (fun e => e ∈ Cn3Torus.edgesIncident n i)).card) := by
          simp

private lemma quintic_gate_support_five_rowSum_le_activeVertices_card_sub_one {n : ℕ}
    {p : EdgeQuintuple n} (hcard : (quinticMomentTupleSupport p).card = 5)
    {i : Fin n} (hi : i ∈ quinticActiveVertices p) :
    Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i
      ≤ (quinticActiveVertices p).card - 1 := by
  classical
  let A := quinticActiveVertices p
  let Sinc :=
    ((quinticMomentTupleSupport p).filter (fun e => e ∈ Cn3Torus.edgesIncident n i))
  let other : Cn3Torus.Edge n → Fin n := fun e =>
    if he : e ∈ Cn3Torus.edgesIncident n i then
      (Cn3Torus.offdiagOfIncident i e he).1
    else i
  have hrow :
      Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i = Sinc.card := by
    simpa [Sinc] using quintic_gate_support_five_rowSum_eq_incident_support_card (p := p) hcard i
  have hle_card : Sinc.card ≤ (A.erase i).card := by
    refine Finset.card_le_card_of_injOn other ?_ ?_
    · intro e he
      have heS : e ∈ quinticMomentTupleSupport p := (Finset.mem_filter.mp he).1
      have heInc : e ∈ Cn3Torus.edgesIncident n i := (Finset.mem_filter.mp he).2
      have hEq :
          other e = (Cn3Torus.offdiagOfIncident i e heInc).1 := by
        simp [other, heInc]
      rw [hEq]
      have hedge_support :
          Cn3Torus.edgeFromOffdiag i (Cn3Torus.offdiagOfIncident i e heInc)
            ∈ quinticMomentTupleSupport p := by
        simpa [Cn3Torus.edgeFromOffdiag_offdiagOfIncident i e heInc] using heS
      have hactive :
          (Cn3Torus.offdiagOfIncident i e heInc).1 ∈ A := by
        dsimp [A]
        exact quinticMomentTuple_incident_vertex_active
          (p := p) hedge_support
          (Cn3Torus.edgeFromOffdiag_mem_edgesIncident_other i
            (Cn3Torus.offdiagOfIncident i e heInc))
      exact Finset.mem_erase.mpr ⟨(Cn3Torus.offdiagOfIncident i e heInc).2, hactive⟩
    · intro e₁ he₁ e₂ he₂ hEq
      have he₁Inc : e₁ ∈ Cn3Torus.edgesIncident n i := (Finset.mem_filter.mp he₁).2
      have he₂Inc : e₂ ∈ Cn3Torus.edgesIncident n i := (Finset.mem_filter.mp he₂).2
      have hEq' :
          Cn3Torus.offdiagOfIncident i e₁ he₁Inc
            = Cn3Torus.offdiagOfIncident i e₂ he₂Inc := by
        apply Subtype.ext
        simpa [other, he₁Inc, he₂Inc] using hEq
      calc
        e₁ = Cn3Torus.edgeFromOffdiag i (Cn3Torus.offdiagOfIncident i e₁ he₁Inc) := by
              symm
              exact Cn3Torus.edgeFromOffdiag_offdiagOfIncident i e₁ he₁Inc
        _ = Cn3Torus.edgeFromOffdiag i (Cn3Torus.offdiagOfIncident i e₂ he₂Inc) := by
              rw [hEq']
        _ = e₂ := Cn3Torus.edgeFromOffdiag_offdiagOfIncident i e₂ he₂Inc
  have herase : (A.erase i).card + 1 = A.card := Finset.card_erase_add_one hi
  calc
    Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i = Sinc.card := hrow
    _ ≤ (A.erase i).card := hle_card
    _ = A.card - 1 := by
          omega

private lemma quintic_gate_support_five_activeVertices_card_eq_five {n : ℕ} {p : EdgeQuintuple n}
    (hgate : quinticMomentTupleGate p = 1)
    (hcard : (quinticMomentTupleSupport p).card = 5) :
    (quinticActiveVertices p).card = 5 := by
  let A := quinticActiveVertices p
  have hsumA :
      Finset.sum A
        (fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i) = 10 := by
    exact quinticActiveVertices_rowSum_sum_eq_ten p
  have hA_le : A.card ≤ 5 := by
    dsimp [A]
    exact quintic_gate_support_five_activeVertices_card_le_five (p := p) hgate hcard
  by_cases hlt : A.card < 5
  · have hall_two :
        ∀ i ∈ A, Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i = 2 := by
      intro i hi
      have hpos :
          0 < Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i := by
        exact (mem_quinticActiveVertices_iff p).1 (by simpa [A] using hi)
      have heven :
          Even (Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i) := by
        exact ((quinticMomentTupleGate_eq_one_iff p).1 hgate) i
      have hup :
          Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i ≤ A.card - 1 := by
        dsimp [A] at hi ⊢
        exact quintic_gate_support_five_rowSum_le_activeVertices_card_sub_one (p := p) hcard hi
      rcases heven with ⟨k, hk⟩
      omega
    have hsumTwo :
        Finset.sum A
          (fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i) = 2 * A.card := by
      calc
        Finset.sum A (fun i => Cn3Torus.edgeNatRowSum (quinticMomentTupleMultiplicity p) i)
          = Finset.sum A (fun _ => 2) := by
              refine Finset.sum_congr rfl ?_
              intro i hi
              exact hall_two i hi
        _ = 2 * A.card := by
              rw [Nat.mul_comm]
              simp
    have : False := by
      rw [hsumTwo] at hsumA
      omega
    exact False.elim this
  · exact le_antisymm hA_le (Nat.le_of_not_lt hlt)

private def edgeToFin5OfSubset {n : ℕ} (A : Finset (Fin n)) (eA : A ≃ Fin 5)
    (e : Cn3Torus.Edge n) (h₁ : e.1.1 ∈ A) (h₂ : e.1.2 ∈ A) : Cn3Torus.Edge 5 :=
  edgeOfNe (eA ⟨e.1.1, h₁⟩) (eA ⟨e.1.2, h₂⟩) (by
    intro h
    have hsub : (⟨e.1.1, h₁⟩ : A) = ⟨e.1.2, h₂⟩ := eA.injective h
    exact (ne_of_lt e.2) (congrArg Subtype.val hsub))

private def edgeFromFin5OfSubset {n : ℕ} (A : Finset (Fin n)) (v : Fin 5 ≃ A)
    (e : Cn3Torus.Edge 5) : Cn3Torus.Edge n :=
  edgeOfNe (v e.1.1).1 (v e.1.2).1 (by
    intro h
    apply ne_of_lt e.2
    exact v.injective (Subtype.ext h))

private lemma edgeFromFin5OfSubset_edgeToFin5OfSubset {n : ℕ}
    (A : Finset (Fin n)) (eA : A ≃ Fin 5)
    (e : Cn3Torus.Edge n) (h₁ : e.1.1 ∈ A) (h₂ : e.1.2 ∈ A) :
    edgeFromFin5OfSubset A eA.symm (edgeToFin5OfSubset A eA e h₁ h₂) = e := by
  let i : Fin 5 := eA ⟨e.1.1, h₁⟩
  let j : Fin 5 := eA ⟨e.1.2, h₂⟩
  have hij_ne : i ≠ j := by
    intro h
    have hsub : (⟨e.1.1, h₁⟩ : A) = ⟨e.1.2, h₂⟩ := eA.injective h
    exact (ne_of_lt e.2) (congrArg Subtype.val hsub)
  have hleft : (eA.symm i).1 = e.1.1 := by
    simp [i]
  have hright : (eA.symm j).1 = e.1.2 := by
    simp [j]
  unfold edgeToFin5OfSubset
  change edgeFromFin5OfSubset A eA.symm (edgeOfNe i j hij_ne) = e
  by_cases hij : i < j
  · rw [edgeOfNe_eq_of_lt i j hij]
    unfold edgeFromFin5OfSubset
    simpa [hleft, hright] using edgeOfNe_eq_of_lt e.1.1 e.1.2 e.2
  · have hji : j < i := lt_of_le_of_ne (le_of_not_gt hij) hij_ne.symm
    rw [edgeOfNe_eq_of_gt i j hji]
    unfold edgeFromFin5OfSubset
    calc
      edgeOfNe (eA.symm j).1 (eA.symm i).1 (by
          intro h
          apply hji.ne
          simpa using congrArg eA (Subtype.ext h))
        = edgeOfNe (eA.symm i).1 (eA.symm j).1 (by
            intro h
            apply hij_ne
            simpa using congrArg eA (Subtype.ext h)) := by
              simpa using (edgeOfNe_symm (eA.symm j).1 (eA.symm i).1
                (by
                  intro h
                  apply hji.ne
                  simpa using congrArg eA (Subtype.ext h)))
      _ = e := by
            simpa [hleft, hright] using edgeOfNe_eq_of_lt e.1.1 e.1.2 e.2

private lemma quintic_gate_support_three_multiplicity_shape {n : ℕ} {p : EdgeQuintuple n}
    (hgate : quinticMomentTupleGate p = 1)
    (hcard : (quinticMomentTupleSupport p).card = 3) :
    ∃ e ∈ quinticMomentTupleSupport p, quinticMomentTupleMultiplicity p e = 3 ∧
      ∀ f ∈ quinticMomentTupleSupport p, f ≠ e → quinticMomentTupleMultiplicity p f = 1 := by
  obtain ⟨e, f, g, hef, heg, hfg, hsupp⟩ :=
    quinticMomentTupleSupport_eq_triple_of_card_three (p := p) hcard
  let a := quinticMomentTupleMultiplicity p e
  let b := quinticMomentTupleMultiplicity p f
  let c := quinticMomentTupleMultiplicity p g
  have heS : e ∈ quinticMomentTupleSupport p := by simpa [hsupp]
  have hfS : f ∈ quinticMomentTupleSupport p := by simpa [hsupp, hef]
  have hgS : g ∈ quinticMomentTupleSupport p := by simpa [hsupp, heg, hfg]
  have ha_pos : 0 < a := by
    dsimp [a]
    exact (mem_quinticMomentTupleSupport_iff p e).1 heS
  have hb_pos : 0 < b := by
    dsimp [b]
    exact (mem_quinticMomentTupleSupport_iff p f).1 hfS
  have hc_pos : 0 < c := by
    dsimp [c]
    exact (mem_quinticMomentTupleSupport_iff p g).1 hgS
  have hsum : a + b + c = 5 := by
    simpa [a, b, c, hsupp, hef, heg, hfg, add_assoc, add_left_comm, add_comm] using
      quinticMomentTupleSupport_sum_multiplicity_eq_five p
  have hnot_two_two_one :
      ∀ {u v w : Cn3Torus.Edge n},
        u ≠ v → u ≠ w → v ≠ w →
        quinticMomentTupleSupport p = ({u, v, w} : Finset (Cn3Torus.Edge n)) →
        quinticMomentTupleMultiplicity p u = 2 →
        quinticMomentTupleMultiplicity p v = 2 →
        quinticMomentTupleMultiplicity p w = 1 →
        False := by
    intro u v w huv huw hvw hsupp' hu hv hw
    let q : EdgeQuintuple n := fun i =>
      if i = (0 : Fin 5) ∨ i = (1 : Fin 5) then u
      else if i = (2 : Fin 5) ∨ i = (3 : Fin 5) then v
      else w
    have hsuppq' : quinticMomentTupleSupport q = ({u, v, w} : Finset (Cn3Torus.Edge n)) := by
      ext x
      by_cases hxu : x = u
      · subst hxu
        simp [q, quinticMomentTupleSupport, quinticMomentTupleMultiplicity_apply, huv, huw]
      · by_cases hxv : x = v
        · subst hxv
          simp [q, quinticMomentTupleSupport, quinticMomentTupleMultiplicity_apply, hxu, huv, hvw]
        · by_cases hxw : x = w
          · subst hxw
            simp [q, quinticMomentTupleSupport, quinticMomentTupleMultiplicity_apply, hxu, hxv, huw, hvw]
          · simp [q, quinticMomentTupleSupport, quinticMomentTupleMultiplicity_apply, hxu, hxv, hxw]
    have hsuppq : quinticMomentTupleSupport p = quinticMomentTupleSupport q := by
      rw [hsupp', hsuppq']
    have hvals :
        ∀ x ∈ quinticMomentTupleSupport p,
          quinticMomentTupleMultiplicity p x = quinticMomentTupleMultiplicity q x := by
      intro x hx
      have hx' : x = u ∨ x = v ∨ x = w := by
        simpa [hsupp'] using hx
      rcases hx' with rfl | rfl | rfl
      · simpa [q, quinticMomentTupleMultiplicity_apply, huv, huv.symm, huw, huw.symm] using hu
      · simpa [q, quinticMomentTupleMultiplicity_apply, huv, huv.symm, hvw, hvw.symm] using hv
      · simpa [q, quinticMomentTupleMultiplicity_apply, huw, huw.symm, hvw, hvw.symm] using hw
    have hmult :
        quinticMomentTupleMultiplicity p = quinticMomentTupleMultiplicity q :=
      quinticMomentTupleMultiplicity_eq_of_support_eq hsuppq hvals
    have hgate0 : quinticMomentTupleGate p = 0 := by
      rw [quinticMomentTupleGate_congr_of_multiplicity_eq hmult]
      simpa [q, quinticMomentTupleGate] using
        (quintupleGate_eq_zero_two_two_one (e := u) (f := v) (g := w) huw)
    linarith
  have hcases :
      (a = 3 ∧ b = 1 ∧ c = 1) ∨
      (a = 1 ∧ b = 3 ∧ c = 1) ∨
      (a = 1 ∧ b = 1 ∧ c = 3) ∨
      (a = 2 ∧ b = 2 ∧ c = 1) ∨
      (a = 2 ∧ b = 1 ∧ c = 2) ∨
      (a = 1 ∧ b = 2 ∧ c = 2) := by
    omega
  rcases hcases with h311 | h131 | h113 | h221 | h212 | h122
  · rcases h311 with ⟨ha3, hb1, hc1⟩
    refine ⟨e, heS, ha3, ?_⟩
    intro x hx hxe
    have hx' : x = f ∨ x = g := by
      have : x = e ∨ x = f ∨ x = g := by simpa [hsupp] using hx
      rcases this with rfl | hxf | hxg
      · exact False.elim (hxe rfl)
      · exact Or.inl hxf
      · exact Or.inr hxg
    rcases hx' with rfl | rfl
    · exact hb1
    · exact hc1
  · rcases h131 with ⟨ha1, hb3, hc1⟩
    refine ⟨f, hfS, hb3, ?_⟩
    intro x hx hxf
    have hx' : x = e ∨ x = g := by
      have : x = e ∨ x = f ∨ x = g := by simpa [hsupp] using hx
      rcases this with hxe | rfl | hxg
      · exact Or.inl hxe
      · exact False.elim (hxf rfl)
      · exact Or.inr hxg
    rcases hx' with rfl | rfl
    · exact ha1
    · exact hc1
  · rcases h113 with ⟨ha1, hb1, hc3⟩
    refine ⟨g, hgS, hc3, ?_⟩
    intro x hx hxg'
    have hx' : x = e ∨ x = f := by
      have : x = e ∨ x = f ∨ x = g := by simpa [hsupp] using hx
      rcases this with hxe | hxf | rfl
      · exact Or.inl hxe
      · exact Or.inr hxf
      · exact False.elim (hxg' rfl)
    rcases hx' with rfl | rfl
    · exact ha1
    · exact hb1
  · rcases h221 with ⟨ha2, hb2, hc1⟩
    exact (hnot_two_two_one hef heg hfg hsupp ha2 hb2 hc1).elim
  · rcases h212 with ⟨ha2, hb1, hc2⟩
    exact (hnot_two_two_one heg hef hfg.symm (by simpa [Finset.pair_comm] using hsupp)
      ha2 hc2 hb1).elim
  · rcases h122 with ⟨ha1, hb2, hc2⟩
    have hsupp_fge : quinticMomentTupleSupport p = ({f, g, e} : Finset (Cn3Torus.Edge n)) := by
      calc
        quinticMomentTupleSupport p = ({e, f, g} : Finset (Cn3Torus.Edge n)) := hsupp
        _ = ({f, e, g} : Finset (Cn3Torus.Edge n)) := by simp [Finset.insert_comm]
        _ = ({f, g, e} : Finset (Cn3Torus.Edge n)) := by simp [Finset.pair_comm]
    exact (hnot_two_two_one hfg hef.symm heg.symm hsupp_fge
      hb2 hc2 ha1).elim

private def quinticThreeOneOneTuple {n : ℕ}
