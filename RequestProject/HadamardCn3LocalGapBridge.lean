private lemma quinticTwoOneOneOneTuple_triangle_gate_one {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) :
    quinticMomentTupleGate
        (quinticTwoOneOneOneTuple d
          (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)) = 1 := by
  rw [quinticMomentTupleGate_eq_one_iff]
  intro i
  by_cases hi1 : i = triangleV1 τ
  · subst i
    have h12 : triangleEdge12 τ hτ ∈ Cn3Torus.edgesIncident n (triangleV1 τ) := by
      exact (triangleEdge12_mem_edgesIncident_iff τ hτ (triangleV1 τ)).2 (Or.inl rfl)
    have h13 : triangleEdge13 τ hτ ∈ Cn3Torus.edgesIncident n (triangleV1 τ) := by
      exact (triangleEdge13_mem_edgesIncident_iff τ hτ (triangleV1 τ)).2 (Or.inl rfl)
    have h23 : triangleEdge23 τ hτ ∉ Cn3Torus.edgesIncident n (triangleV1 τ) := by
      intro h
      rcases (triangleEdge23_mem_edgesIncident_iff τ hτ (triangleV1 τ)).1 h with h2 | h3
      · exact (ne_of_lt hτ.1) h2
      · exact (ne_of_lt (lt_trans hτ.1 hτ.2)) h3
    by_cases hd1 : d ∈ Cn3Torus.edgesIncident n (triangleV1 τ)
    · have hEven : Even (2 + (1 + (1 + 0))) := by norm_num
      simpa [quinticTwoOneOneOneTuple, Cn3Torus.edgeNatRowSum_edgeMultiplicity5,
        hd1, h12, h13, h23, add_assoc, add_left_comm, add_comm] using hEven
    · have hEven : Even (0 + (1 + (1 + 0))) := by norm_num
      simpa [quinticTwoOneOneOneTuple, Cn3Torus.edgeNatRowSum_edgeMultiplicity5,
        hd1, h12, h13, h23, add_assoc, add_left_comm, add_comm] using hEven
  · by_cases hi2 : i = triangleV2 τ
    · subst i
      have h12 : triangleEdge12 τ hτ ∈ Cn3Torus.edgesIncident n (triangleV2 τ) := by
        exact (triangleEdge12_mem_edgesIncident_iff τ hτ (triangleV2 τ)).2 (Or.inr rfl)
      have h13 : triangleEdge13 τ hτ ∉ Cn3Torus.edgesIncident n (triangleV2 τ) := by
        intro h
        rcases (triangleEdge13_mem_edgesIncident_iff τ hτ (triangleV2 τ)).1 h with h1 | h3
        · exact (ne_of_lt hτ.1) h1.symm
        · exact (ne_of_lt hτ.2) h3
      have h23 : triangleEdge23 τ hτ ∈ Cn3Torus.edgesIncident n (triangleV2 τ) := by
        exact (triangleEdge23_mem_edgesIncident_iff τ hτ (triangleV2 τ)).2 (Or.inl rfl)
      by_cases hd2 : d ∈ Cn3Torus.edgesIncident n (triangleV2 τ)
      · have hEven : Even (2 + (1 + (0 + 1))) := by norm_num
        simpa [quinticTwoOneOneOneTuple, Cn3Torus.edgeNatRowSum_edgeMultiplicity5,
          hd2, h12, h13, h23, add_assoc, add_left_comm, add_comm] using hEven
      · have hEven : Even (0 + (1 + (0 + 1))) := by norm_num
        simpa [quinticTwoOneOneOneTuple, Cn3Torus.edgeNatRowSum_edgeMultiplicity5,
          hd2, h12, h13, h23, add_assoc, add_left_comm, add_comm] using hEven
    · by_cases hi3 : i = triangleV3 τ
      · subst i
        have h12 : triangleEdge12 τ hτ ∉ Cn3Torus.edgesIncident n (triangleV3 τ) := by
          intro h
          rcases (triangleEdge12_mem_edgesIncident_iff τ hτ (triangleV3 τ)).1 h with h1 | h2
          · exact (ne_of_lt (lt_trans hτ.1 hτ.2)) h1.symm
          · exact (ne_of_lt hτ.2) h2.symm
        have h13 : triangleEdge13 τ hτ ∈ Cn3Torus.edgesIncident n (triangleV3 τ) := by
          exact (triangleEdge13_mem_edgesIncident_iff τ hτ (triangleV3 τ)).2 (Or.inr rfl)
        have h23 : triangleEdge23 τ hτ ∈ Cn3Torus.edgesIncident n (triangleV3 τ) := by
          exact (triangleEdge23_mem_edgesIncident_iff τ hτ (triangleV3 τ)).2 (Or.inr rfl)
        by_cases hd3 : d ∈ Cn3Torus.edgesIncident n (triangleV3 τ)
        · have hEven : Even (2 + (0 + (1 + 1))) := by norm_num
          simpa [quinticTwoOneOneOneTuple, Cn3Torus.edgeNatRowSum_edgeMultiplicity5,
            hd3, h12, h13, h23, add_assoc, add_left_comm, add_comm] using hEven
        · have hEven : Even (0 + (0 + (1 + 1))) := by norm_num
          simpa [quinticTwoOneOneOneTuple, Cn3Torus.edgeNatRowSum_edgeMultiplicity5,
            hd3, h12, h13, h23, add_assoc, add_left_comm, add_comm] using hEven
      · have h12 : triangleEdge12 τ hτ ∉ Cn3Torus.edgesIncident n i := by
          intro h
          rcases (triangleEdge12_mem_edgesIncident_iff τ hτ i).1 h with h1 | h2
          · exact hi1 h1
          · exact hi2 h2
        have h13 : triangleEdge13 τ hτ ∉ Cn3Torus.edgesIncident n i := by
          intro h
          rcases (triangleEdge13_mem_edgesIncident_iff τ hτ i).1 h with h1 | h3
          · exact hi1 h1
          · exact hi3 h3
        have h23 : triangleEdge23 τ hτ ∉ Cn3Torus.edgesIncident n i := by
          intro h
          rcases (triangleEdge23_mem_edgesIncident_iff τ hτ i).1 h with h2 | h3
          · exact hi2 h2
          · exact hi3 h3
        by_cases hdi : d ∈ Cn3Torus.edgesIncident n i
        · have hEven : Even (2 + (0 + (0 + 0))) := by norm_num
          simpa [quinticTwoOneOneOneTuple, Cn3Torus.edgeNatRowSum_edgeMultiplicity5,
            hdi, h12, h13, h23, add_assoc, add_left_comm, add_comm] using hEven
        · have hEven : Even (0 + (0 + (0 + 0))) := by norm_num
          simpa [quinticTwoOneOneOneTuple, Cn3Torus.edgeNatRowSum_edgeMultiplicity5,
            hdi, h12, h13, h23, add_assoc, add_left_comm, add_comm] using hEven

private lemma quinticTwoOneOneOneTuple_triangle_multiplicity_eq_edgeTriangleMultiplicity {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) :
    quinticMomentTupleMultiplicity
        (quinticTwoOneOneOneTuple d
          (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ))
      = quinticEdgeTriangleMultiplicity d τ hτ := by
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  have hd12 : d ≠ triangleEdge12 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hd13 : d ≠ triangleEdge13 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hd23 : d ≠ triangleEdge23 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  funext x
  by_cases hxd : x = d
  · subst x
    rw [quinticTwoOneOneOneTuple_multiplicity_d d
        (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ) hd12 hd13 hd23,
      quinticEdgeTriangleMultiplicity_doubled_self d τ hτ hd]
  · by_cases hx12 : x = triangleEdge12 τ hτ
    · subst x
      rw [quinticTwoOneOneOneTuple_multiplicity_e d
          (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ) hd12 h12 h13,
        quinticEdgeTriangleMultiplicity_triangle12 d τ hτ hd]
    · by_cases hx13 : x = triangleEdge13 τ hτ
      · subst x
        rw [quinticTwoOneOneOneTuple_multiplicity_f d
            (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ) hd13 h12 h23,
          quinticEdgeTriangleMultiplicity_triangle13 d τ hτ hd]
      · by_cases hx23 : x = triangleEdge23 τ hτ
        · subst x
          rw [quinticTwoOneOneOneTuple_multiplicity_g d
              (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ) hd23 h13 h23,
            quinticEdgeTriangleMultiplicity_triangle23 d τ hτ hd]
        · have hxnot : x ∉ triangleEdgeSet τ hτ := by
            simp [triangleEdgeSet, hx12, hx13, hx23]
          rw [quinticTwoOneOneOneTuple_multiplicity_eq_zero_of_ne d
              (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)
              x hxd hx12 hx13 hx23,
            quinticEdgeTriangleMultiplicity_eq_zero_of_not_mem d τ hτ hxd hxnot]

