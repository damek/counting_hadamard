private lemma quinticThreeOneOneTuple_gate_one_is_triangle_repeat {n : ℕ}
    (e u v : Cn3Torus.Edge n) (heu : e ≠ u) (hev : e ≠ v) (huv : u ≠ v)
    (hgate : quinticMomentTupleGate (quinticThreeOneOneTuple e u v) = 1) :
    ∃ τ : TriangleTriple n, ∃ hτ : IsTriangleTriple τ, ∃ s : TriangleEdgeShape,
      quinticMomentTupleSupport (quinticThreeOneOneTuple e u v) = triangleEdgeSet τ hτ ∧
      quinticMomentTupleMultiplicity (quinticThreeOneOneTuple e u v)
        = quinticTriangleRepeatMultiplicity τ hτ s := by
  obtain ⟨u', v', heu', hev', huv', hmult, hu_left, hu_not_right, hv_not_left, hv_right⟩ :=
    quinticThreeOneOneTuple_reorder_incidence e u v heu hev huv hgate
  let q' : EdgeQuintuple n := quinticThreeOneOneTuple e u' v'
  have hgate' : quinticMomentTupleGate q' = 1 := by
    rw [← quinticMomentTupleGate_congr_of_multiplicity_eq hmult]
    exact hgate
  have hsupport' :
      quinticMomentTupleSupport (quinticThreeOneOneTuple e u v)
        = quinticMomentTupleSupport (quinticThreeOneOneTuple e u' v') := by
    ext w
    simp [quinticMomentTupleSupport, hmult]
  have hall :
      ∀ i : Fin n,
        Even
          ((if e ∈ Cn3Torus.edgesIncident n i then 3 else 0)
            + (if u' ∈ Cn3Torus.edgesIncident n i then 1 else 0)
            + (if v' ∈ Cn3Torus.edgesIncident n i then 1 else 0)) := by
    intro i
    have hi := ((quinticMomentTupleGate_eq_one_iff q').1 hgate' i)
    by_cases hei : e ∈ Cn3Torus.edgesIncident n i
    · simpa [q', quinticThreeOneOneTuple, quinticMomentTupleMultiplicity,
        Cn3Torus.edgeNatRowSum_edgeMultiplicity5, hei, add_assoc, add_left_comm, add_comm] using hi
    · simpa [q', quinticThreeOneOneTuple, quinticMomentTupleMultiplicity,
        Cn3Torus.edgeNatRowSum_edgeMultiplicity5, hei, add_assoc, add_left_comm, add_comm] using hi
  rcases e with ⟨⟨a, b⟩, hab⟩
  rcases u' with ⟨⟨x, y⟩, hxy⟩
  rcases v' with ⟨⟨m, z⟩, hmz⟩
  dsimp at hu_left hu_not_right hv_not_left hv_right hmult hall hgate' ⊢
  rcases (Cn3Torus.mem_edgesIncident_iff (i := a) (e := ⟨(x, y), hxy⟩)).1 hu_left with hxa | hya
  · have hxa' : x = a := by simpa using hxa
    subst x
    have hy_ne_b : y ≠ b := by
      intro hyb
      apply hu_not_right
      simpa [hyb] using (Cn3Torus.edge_mem_edgesIncident_right ⟨(a, y), hxy⟩)
    have he_not_y : ⟨(a, b), hab⟩ ∉ Cn3Torus.edgesIncident n y := by
      intro hey
      rcases (Cn3Torus.mem_edgesIncident_iff (i := y) (e := ⟨(a, b), hab⟩)).1 hey with hay | hby
      · exact (ne_of_lt hxy) hay
      · exact hy_ne_b hby.symm
    have hu_y : ⟨(a, y), hxy⟩ ∈ Cn3Torus.edgesIncident n y :=
      Cn3Torus.edge_mem_edgesIncident_right ⟨(a, y), hxy⟩
    have hv_y : ⟨(m, z), hmz⟩ ∈ Cn3Torus.edgesIncident n y :=
      even_zero_one_one_other_mem he_not_y hu_y (hall y)
    rcases lt_or_gt_of_ne hy_ne_b with hyb | hby
    · let τ : TriangleTriple n := (a, (y, b))
      have hτ : IsTriangleTriple τ := by
        exact ⟨hxy, hyb⟩
      have hu_eq : ⟨(a, y), hxy⟩ = triangleEdge12 τ hτ := by
        rfl
      have he_eq : ⟨(a, b), hab⟩ = triangleEdge13 τ hτ := by
        apply Subtype.ext
        rfl
      have hv_eq : ⟨(m, z), hmz⟩ = triangleEdge23 τ hτ := by
        have hvtmp :
            (⟨(m, z), hmz⟩ : Cn3Torus.Edge n) = (⟨(y, b), hyb⟩ : Cn3Torus.Edge n) :=
          Cn3Torus.edge_eq_of_incident_both_endpoints
            (⟨(y, b), hyb⟩ : Cn3Torus.Edge n) (⟨(m, z), hmz⟩ : Cn3Torus.Edge n) hv_y hv_right
        have hpair : (m, z) = (y, b) := congrArg Subtype.val hvtmp
        have hm : m = y := congrArg Prod.fst hpair
        have hz : z = b := congrArg Prod.snd hpair
        subst m
        subst z
        rfl
      refine ⟨τ, hτ, TriangleEdgeShape.edge13, ?_, ?_⟩
      · rw [hsupport', quinticThreeOneOneTuple_support ⟨(a, b), hab⟩ ⟨(a, y), hxy⟩ ⟨(m, z), hmz⟩
          heu' hev' huv']
        rw [he_eq, hu_eq, hv_eq]
        ext t
        simp [triangleEdgeSet, or_assoc, or_left_comm, or_comm]
      · rw [hmult, he_eq, hu_eq, hv_eq]
        exact quinticThreeOneOneTuple_triangle_edge13_eq_repeat τ hτ
    · let τ : TriangleTriple n := (a, (b, y))
      have hτ : IsTriangleTriple τ := by
        exact ⟨hab, hby⟩
      have he_eq : ⟨(a, b), hab⟩ = triangleEdge12 τ hτ := by
        rfl
      have hu_eq : ⟨(a, y), hxy⟩ = triangleEdge13 τ hτ := by
        apply Subtype.ext
        rfl
      have hv_eq : ⟨(m, z), hmz⟩ = triangleEdge23 τ hτ := by
        have hvtmp :
            (⟨(m, z), hmz⟩ : Cn3Torus.Edge n) = (⟨(b, y), hby⟩ : Cn3Torus.Edge n) :=
          Cn3Torus.edge_eq_of_incident_both_endpoints
            (⟨(b, y), hby⟩ : Cn3Torus.Edge n) (⟨(m, z), hmz⟩ : Cn3Torus.Edge n) hv_right hv_y
        have hpair : (m, z) = (b, y) := congrArg Subtype.val hvtmp
        have hm : m = b := congrArg Prod.fst hpair
        have hz : z = y := congrArg Prod.snd hpair
        subst m
        subst z
        rfl
      refine ⟨τ, hτ, TriangleEdgeShape.edge12, ?_, ?_⟩
      · rw [hsupport', quinticThreeOneOneTuple_support ⟨(a, b), hab⟩ ⟨(a, y), hxy⟩ ⟨(m, z), hmz⟩
          heu' hev' huv']
        rw [he_eq, hu_eq, hv_eq]
        ext t
        simp [triangleEdgeSet, or_assoc, or_left_comm, or_comm]
      · rw [hmult, he_eq, hu_eq, hv_eq]
        exact quinticThreeOneOneTuple_triangle_edge12_eq_repeat τ hτ
  · have hya' : y = a := by simpa using hya
    subst y
    have hx_ne_b : x ≠ b := by
      intro hxb
      apply hu_not_right
      simpa [hxb] using (Cn3Torus.edge_mem_edgesIncident_left ⟨(x, a), hxy⟩)
    have he_not_x : ⟨(a, b), hab⟩ ∉ Cn3Torus.edgesIncident n x := by
      intro hex
      rcases (Cn3Torus.mem_edgesIncident_iff (i := x) (e := ⟨(a, b), hab⟩)).1 hex with hax | hbx
      · exact (ne_of_lt hxy) hax.symm
      · exact hx_ne_b hbx.symm
    have hu_x : ⟨(x, a), hxy⟩ ∈ Cn3Torus.edgesIncident n x :=
      Cn3Torus.edge_mem_edgesIncident_left ⟨(x, a), hxy⟩
    have hv_x : ⟨(m, z), hmz⟩ ∈ Cn3Torus.edgesIncident n x :=
      even_zero_one_one_other_mem he_not_x hu_x (hall x)
    let τ : TriangleTriple n := (x, (a, b))
    have hτ : IsTriangleTriple τ := by
      exact ⟨hxy, hab⟩
    have hu_eq : ⟨(x, a), hxy⟩ = triangleEdge12 τ hτ := by
      rfl
    have he_eq : ⟨(a, b), hab⟩ = triangleEdge23 τ hτ := by
      rfl
    have hv_eq : ⟨(m, z), hmz⟩ = triangleEdge13 τ hτ := by
      have hvtmp :
          (⟨(m, z), hmz⟩ : Cn3Torus.Edge n) = (⟨(x, b), lt_trans hxy hab⟩ : Cn3Torus.Edge n) :=
        Cn3Torus.edge_eq_of_incident_both_endpoints
          (⟨(x, b), lt_trans hxy hab⟩ : Cn3Torus.Edge n) (⟨(m, z), hmz⟩ : Cn3Torus.Edge n)
          hv_x hv_right
      have hpair : (m, z) = (x, b) := congrArg Subtype.val hvtmp
      have hm : m = x := congrArg Prod.fst hpair
      have hz : z = b := congrArg Prod.snd hpair
      subst m
      subst z
      apply Subtype.ext
      rfl
    refine ⟨τ, hτ, TriangleEdgeShape.edge23, ?_, ?_⟩
    · rw [hsupport', quinticThreeOneOneTuple_support ⟨(a, b), hab⟩ ⟨(x, a), hxy⟩ ⟨(m, z), hmz⟩
        heu' hev' huv']
      rw [he_eq, hu_eq, hv_eq]
      ext t
      simp [triangleEdgeSet, or_assoc, or_left_comm, or_comm]
    · rw [hmult, he_eq, hu_eq, hv_eq]
      exact quinticThreeOneOneTuple_triangle_edge23_eq_repeat τ hτ

private lemma quintic_gate_support_three_is_triangle_repeat {n : ℕ} {p : EdgeQuintuple n}
    (hp : p ∈ quinticGateSupportThreeTuples n) :
    ∃ τ : TriangleTriple n, ∃ hτ : IsTriangleTriple τ, ∃ s : TriangleEdgeShape,
      quinticMomentTupleSupport p = triangleEdgeSet τ hτ ∧
      quinticMomentTupleMultiplicity p = quinticTriangleRepeatMultiplicity τ hτ s := by
  rcases (mem_quinticGateSupportThreeTuples_iff p).1 hp with ⟨hgate, hcard⟩
  obtain ⟨e, f, g, hef, heg, hfg, hsupp⟩ :=
    quinticMomentTupleSupport_eq_triple_of_card_three (p := p) hcard
  have heS : e ∈ quinticMomentTupleSupport p := by simpa [hsupp]
  have hfS : f ∈ quinticMomentTupleSupport p := by simpa [hsupp, hef]
  have hgS : g ∈ quinticMomentTupleSupport p := by simpa [hsupp, heg, hfg]
  obtain ⟨e0, he0S, he03, hrest⟩ :=
    quintic_gate_support_three_multiplicity_shape (p := p) hgate hcard
  have he0_cases : e0 = e ∨ e0 = f ∨ e0 = g := by
    have he0mem : e0 ∈ ({e, f, g} : Finset (Cn3Torus.Edge n)) := by simpa [hsupp] using he0S
    simpa [or_assoc] using he0mem
  rcases he0_cases with he0e | he0f | he0g
  · have he03' : quinticMomentTupleMultiplicity p e = 3 := by simpa [he0e] using he03
    have hmult :
        quinticMomentTupleMultiplicity p
          = quinticMomentTupleMultiplicity (quinticThreeOneOneTuple e f g) := by
      apply quinticMomentTupleMultiplicity_eq_threeOneOneTuple_of_support_eq_values
        (p := p) (e0 := e) (u0 := f) (v0 := g)
      · exact hsupp
      · exact he03'
      · exact hrest f hfS (by simpa [he0e] using hef.symm)
      · exact hrest g hgS (by simpa [he0e] using heg.symm)
      · exact hef
      · exact heg
      · exact hfg
    have hsupp' :
        quinticMomentTupleSupport p = quinticMomentTupleSupport (quinticThreeOneOneTuple e f g) := by
      ext x
      simp [quinticMomentTupleSupport, hmult]
    have hgate' : quinticMomentTupleGate (quinticThreeOneOneTuple e f g) = 1 := by
      rw [← quinticMomentTupleGate_congr_of_multiplicity_eq hmult]
      exact hgate
    obtain ⟨τ, hτ, s, hsuppq, hmultq⟩ :=
      quinticThreeOneOneTuple_gate_one_is_triangle_repeat e f g hef heg hfg hgate'
    exact ⟨τ, hτ, s, hsupp'.trans hsuppq, hmult.trans hmultq⟩
  · have he03' : quinticMomentTupleMultiplicity p f = 3 := by simpa [he0f] using he03
    have hsupp' :
        quinticMomentTupleSupport p = ({f, e, g} : Finset (Cn3Torus.Edge n)) := by
      calc
        quinticMomentTupleSupport p = ({e, f, g} : Finset (Cn3Torus.Edge n)) := hsupp
        _ = ({f, e, g} : Finset (Cn3Torus.Edge n)) := by
              ext x
              simp [or_assoc, or_left_comm, or_comm]
    have hmult :
        quinticMomentTupleMultiplicity p
          = quinticMomentTupleMultiplicity (quinticThreeOneOneTuple f e g) := by
      apply quinticMomentTupleMultiplicity_eq_threeOneOneTuple_of_support_eq_values
        (p := p) (e0 := f) (u0 := e) (v0 := g)
      · exact hsupp'
      · exact he03'
      · exact hrest e heS (by simpa [he0f] using hef)
      · exact hrest g hgS (by simpa [he0f] using hfg.symm)
      · exact hef.symm
      · exact hfg
      · exact heg
    have hsupp'' :
        quinticMomentTupleSupport p = quinticMomentTupleSupport (quinticThreeOneOneTuple f e g) := by
      ext x
      simp [quinticMomentTupleSupport, hmult]
    have hgate' : quinticMomentTupleGate (quinticThreeOneOneTuple f e g) = 1 := by
      rw [← quinticMomentTupleGate_congr_of_multiplicity_eq hmult]
      exact hgate
    obtain ⟨τ, hτ, s, hsuppq, hmultq⟩ :=
      quinticThreeOneOneTuple_gate_one_is_triangle_repeat f e g hef.symm hfg heg hgate'
    exact ⟨τ, hτ, s, hsupp''.trans hsuppq, hmult.trans hmultq⟩
  · have he03' : quinticMomentTupleMultiplicity p g = 3 := by simpa [he0g] using he03
    have hsupp' :
        quinticMomentTupleSupport p = ({g, e, f} : Finset (Cn3Torus.Edge n)) := by
      calc
        quinticMomentTupleSupport p = ({e, f, g} : Finset (Cn3Torus.Edge n)) := hsupp
        _ = ({g, e, f} : Finset (Cn3Torus.Edge n)) := by
              ext x
              simp [or_assoc, or_left_comm, or_comm]
    have hmult :
        quinticMomentTupleMultiplicity p
          = quinticMomentTupleMultiplicity (quinticThreeOneOneTuple g e f) := by
      apply quinticMomentTupleMultiplicity_eq_threeOneOneTuple_of_support_eq_values
        (p := p) (e0 := g) (u0 := e) (v0 := f)
      · exact hsupp'
      · exact he03'
      · exact hrest e heS (by simpa [he0g] using heg)
      · exact hrest f hfS (by simpa [he0g] using hfg)
      · exact heg.symm
      · exact hfg.symm
      · exact hef
    have hsupp'' :
        quinticMomentTupleSupport p = quinticMomentTupleSupport (quinticThreeOneOneTuple g e f) := by
      ext x
      simp [quinticMomentTupleSupport, hmult]
    have hgate' : quinticMomentTupleGate (quinticThreeOneOneTuple g e f) = 1 := by
      rw [← quinticMomentTupleGate_congr_of_multiplicity_eq hmult]
      exact hgate
    obtain ⟨τ, hτ, s, hsuppq, hmultq⟩ :=
      quinticThreeOneOneTuple_gate_one_is_triangle_repeat g e f heg.symm hfg.symm hef hgate'
    exact ⟨τ, hτ, s, hsupp''.trans hsuppq, hmult.trans hmultq⟩

private lemma quinticTriangleRepeatMultiplicity_odd_of_mem_support {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    {e : Cn3Torus.Edge n} (he : e ∈ triangleEdgeSet τ hτ) :
    Odd (quinticTriangleRepeatMultiplicity τ hτ s e) := by
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  cases s <;>
    rcases (by simpa [triangleEdgeSet] using he) with rfl | rfl | rfl <;>
    simp [quinticTriangleRepeatMultiplicity, edgePowMultiplicity, h12, h12.symm, h13, h13.symm,
      h23, h23.symm] <;> norm_num

private lemma quinticTriangleRepeatMultiplicity_eq_zero_of_not_mem_support {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    {e : Cn3Torus.Edge n} (he : e ∉ triangleEdgeSet τ hτ) :
    quinticTriangleRepeatMultiplicity τ hτ s e = 0 := by
  have h12e : e ≠ triangleEdge12 τ hτ := by
    intro h
    exact he (by simp [triangleEdgeSet, h])
  have h13e : e ≠ triangleEdge13 τ hτ := by
    intro h
    exact he (by simp [triangleEdgeSet, h])
  have h23e : e ≠ triangleEdge23 τ hτ := by
    intro h
    exact he (by simp [triangleEdgeSet, h])
  cases s <;>
    simp [quinticTriangleRepeatMultiplicity, edgePowMultiplicity, h12e, h13e, h23e]

private lemma quinticTriangleRepeatMonomial_eq_coordMonomial {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    (mu : Cn3Torus.Edge n → ℝ) :
    quinticTriangleRepeatMonomial τ hτ s mu
      = coordMonomial (quinticTriangleRepeatMultiplicity τ hτ s) mu := by
  cases s
  · calc
      quinticTriangleRepeatMonomial τ hτ TriangleEdgeShape.edge12 mu
        = coordMonomial (edgePowMultiplicity (triangleEdge12 τ hτ) 3) mu
            * coordMonomial (edgePowMultiplicity (triangleEdge13 τ hτ) 1) mu
            * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu := by
              simp [quinticTriangleRepeatMonomial, coordMonomial_edgePowMultiplicity, mul_assoc]
      _ = coordMonomial
            ((edgePowMultiplicity (triangleEdge12 τ hτ) 3
              + edgePowMultiplicity (triangleEdge13 τ hτ) 1)
              + edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu := by
              calc
                coordMonomial (edgePowMultiplicity (triangleEdge12 τ hτ) 3) mu
                    * coordMonomial (edgePowMultiplicity (triangleEdge13 τ hτ) 1) mu
                    * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu
                  = (coordMonomial (edgePowMultiplicity (triangleEdge12 τ hτ) 3) mu
                        * coordMonomial (edgePowMultiplicity (triangleEdge13 τ hτ) 1) mu)
                      * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu := by
                        ring
                _ = (coordMonomial
                        (edgePowMultiplicity (triangleEdge12 τ hτ) 3
                          + edgePowMultiplicity (triangleEdge13 τ hτ) 1) mu)
                      * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu := by
                        exact congrArg
                          (fun z : ℝ =>
                            z * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu)
                          (coordMonomial_mul
                            (edgePowMultiplicity (triangleEdge12 τ hτ) 3)
                            (edgePowMultiplicity (triangleEdge13 τ hτ) 1) mu)
                _ = coordMonomial
                      ((edgePowMultiplicity (triangleEdge12 τ hτ) 3
                        + edgePowMultiplicity (triangleEdge13 τ hτ) 1)
                        + edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu := by
                      exact coordMonomial_mul
                        (edgePowMultiplicity (triangleEdge12 τ hτ) 3
                          + edgePowMultiplicity (triangleEdge13 τ hτ) 1)
                        (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu
      _ = coordMonomial (quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge12) mu := by
            simp [quinticTriangleRepeatMultiplicity]
  · calc
      quinticTriangleRepeatMonomial τ hτ TriangleEdgeShape.edge13 mu
        = coordMonomial (edgePowMultiplicity (triangleEdge12 τ hτ) 1) mu
            * coordMonomial (edgePowMultiplicity (triangleEdge13 τ hτ) 3) mu
            * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu := by
              simp [quinticTriangleRepeatMonomial, coordMonomial_edgePowMultiplicity, mul_assoc]
      _ = coordMonomial
            ((edgePowMultiplicity (triangleEdge12 τ hτ) 1
              + edgePowMultiplicity (triangleEdge13 τ hτ) 3)
              + edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu := by
              calc
                coordMonomial (edgePowMultiplicity (triangleEdge12 τ hτ) 1) mu
                    * coordMonomial (edgePowMultiplicity (triangleEdge13 τ hτ) 3) mu
                    * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu
                  = (coordMonomial (edgePowMultiplicity (triangleEdge12 τ hτ) 1) mu
                        * coordMonomial (edgePowMultiplicity (triangleEdge13 τ hτ) 3) mu)
                      * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu := by
                        ring
                _ = (coordMonomial
                        (edgePowMultiplicity (triangleEdge12 τ hτ) 1
                          + edgePowMultiplicity (triangleEdge13 τ hτ) 3) mu)
                      * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu := by
                        exact congrArg
                          (fun z : ℝ =>
                            z * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu)
                          (coordMonomial_mul
                            (edgePowMultiplicity (triangleEdge12 τ hτ) 1)
                            (edgePowMultiplicity (triangleEdge13 τ hτ) 3) mu)
                _ = coordMonomial
                      ((edgePowMultiplicity (triangleEdge12 τ hτ) 1
                        + edgePowMultiplicity (triangleEdge13 τ hτ) 3)
                        + edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu := by
                      exact coordMonomial_mul
                        (edgePowMultiplicity (triangleEdge12 τ hτ) 1
                          + edgePowMultiplicity (triangleEdge13 τ hτ) 3)
                        (edgePowMultiplicity (triangleEdge23 τ hτ) 1) mu
      _ = coordMonomial (quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge13) mu := by
            simp [quinticTriangleRepeatMultiplicity]
  · calc
      quinticTriangleRepeatMonomial τ hτ TriangleEdgeShape.edge23 mu
        = coordMonomial (edgePowMultiplicity (triangleEdge12 τ hτ) 1) mu
            * coordMonomial (edgePowMultiplicity (triangleEdge13 τ hτ) 1) mu
            * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 3) mu := by
              simp [quinticTriangleRepeatMonomial, coordMonomial_edgePowMultiplicity, mul_assoc]
      _ = coordMonomial
            ((edgePowMultiplicity (triangleEdge12 τ hτ) 1
              + edgePowMultiplicity (triangleEdge13 τ hτ) 1)
              + edgePowMultiplicity (triangleEdge23 τ hτ) 3) mu := by
              calc
                coordMonomial (edgePowMultiplicity (triangleEdge12 τ hτ) 1) mu
                    * coordMonomial (edgePowMultiplicity (triangleEdge13 τ hτ) 1) mu
                    * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 3) mu
                  = (coordMonomial (edgePowMultiplicity (triangleEdge12 τ hτ) 1) mu
                        * coordMonomial (edgePowMultiplicity (triangleEdge13 τ hτ) 1) mu)
                      * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 3) mu := by
                        ring
                _ =
                    (coordMonomial
                      (edgePowMultiplicity (triangleEdge12 τ hτ) 1
                        + edgePowMultiplicity (triangleEdge13 τ hτ) 1) mu)
                    * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 3) mu := by
                      exact congrArg
                        (fun z : ℝ =>
                          z * coordMonomial (edgePowMultiplicity (triangleEdge23 τ hτ) 3) mu)
                        (coordMonomial_mul
                          (edgePowMultiplicity (triangleEdge12 τ hτ) 1)
                          (edgePowMultiplicity (triangleEdge13 τ hτ) 1) mu)
                _ = coordMonomial
                      ((edgePowMultiplicity (triangleEdge12 τ hτ) 1
                        + edgePowMultiplicity (triangleEdge13 τ hτ) 1)
                        + edgePowMultiplicity (triangleEdge23 τ hτ) 3) mu := by
                      exact coordMonomial_mul
                        (edgePowMultiplicity (triangleEdge12 τ hτ) 1
                          + edgePowMultiplicity (triangleEdge13 τ hτ) 1)
                        (edgePowMultiplicity (triangleEdge23 τ hτ) 3) mu
      _ = coordMonomial (quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge23) mu := by
            simp [quinticTriangleRepeatMultiplicity]

private lemma quinticTriangleRepeatMultiplicity_total_degree {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape) :
    (∑ e : Cn3Torus.Edge n, quinticTriangleRepeatMultiplicity τ hτ s e) = 5 := by
  cases s <;> simp [quinticTriangleRepeatMultiplicity, Finset.sum_add_distrib, sum_edgePowMultiplicity]

private def triangleShapeCount (f : Fin 5 → TriangleEdgeShape) (s : TriangleEdgeShape) : ℕ :=
  (Finset.univ.filter (fun i : Fin 5 => f i = s)).card

private lemma triangleShapeCount_eq_sum_indicators (f : Fin 5 → TriangleEdgeShape)
    (s : TriangleEdgeShape) :
    triangleShapeCount f s
      = (if f 0 = s then 1 else 0)
          + (if f 1 = s then 1 else 0)
          + (if f 2 = s then 1 else 0)
          + (if f 3 = s then 1 else 0)
          + (if f 4 = s then 1 else 0) := by
  unfold triangleShapeCount
  change #{i : Fin 5 | f i = s} =
      (if f 0 = s then 1 else 0)
        + (if f 1 = s then 1 else 0)
        + (if f 2 = s then 1 else 0)
        + (if f 3 = s then 1 else 0)
        + (if f 4 = s then 1 else 0)
  rw [Fin.card_filter_univ_succ', Fin.card_filter_univ_succ', Fin.card_filter_univ_succ',
    Fin.card_filter_univ_succ', Fin.card_filter_univ_succ']
  simp
  ring_nf

private def quinticTriangleRepeatPatterns (s : TriangleEdgeShape) : Finset (Fin 5 → TriangleEdgeShape) :=
  Finset.univ.filter (fun f =>
    triangleShapeCount f TriangleEdgeShape.edge12 = (if s = TriangleEdgeShape.edge12 then 3 else 1) ∧
    triangleShapeCount f TriangleEdgeShape.edge13 = (if s = TriangleEdgeShape.edge13 then 3 else 1) ∧
    triangleShapeCount f TriangleEdgeShape.edge23 = (if s = TriangleEdgeShape.edge23 then 3 else 1))

private lemma quinticTriangleRepeatPatterns_card (s : TriangleEdgeShape) :
    (quinticTriangleRepeatPatterns s).card = 20 := by
  cases s <;> decide

private def quinticTriangleRepeatTupleOfPattern {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (f : Fin 5 → TriangleEdgeShape) : EdgeQuintuple n :=
  fun i => triangleEdgeOfShape τ hτ (f i)

private lemma triangleEdge12_eq_triangleEdgeOfShape_iff {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape) :
    triangleEdge12 τ hτ = triangleEdgeOfShape τ hτ s ↔ s = TriangleEdgeShape.edge12 := by
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  cases s <;> simp [triangleEdgeOfShape, h12, h13]

private lemma triangleEdge13_eq_triangleEdgeOfShape_iff {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape) :
    triangleEdge13 τ hτ = triangleEdgeOfShape τ hτ s ↔ s = TriangleEdgeShape.edge13 := by
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  cases s <;> simp [triangleEdgeOfShape, h12, h12.symm, h23]

private lemma triangleEdge23_eq_triangleEdgeOfShape_iff {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape) :
    triangleEdge23 τ hτ = triangleEdgeOfShape τ hτ s ↔ s = TriangleEdgeShape.edge23 := by
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  cases s <;> simp [triangleEdgeOfShape, h13, h13.symm, h23, h23.symm]

private lemma quinticTriangleRepeatTupleOfPattern_multiplicity_edge12 {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (f : Fin 5 → TriangleEdgeShape) :
    quinticMomentTupleMultiplicity (quinticTriangleRepeatTupleOfPattern τ hτ f)
        (triangleEdge12 τ hτ)
      = triangleShapeCount f TriangleEdgeShape.edge12 := by
  rw [quinticMomentTupleMultiplicity_apply]
  rw [triangleShapeCount_eq_sum_indicators]
  change (((((if triangleEdge12 τ hτ = triangleEdgeOfShape τ hτ (f 0) then 1 else 0) +
        if triangleEdge12 τ hτ = triangleEdgeOfShape τ hτ (f 1) then 1 else 0) +
      if triangleEdge12 τ hτ = triangleEdgeOfShape τ hτ (f 2) then 1 else 0) +
    if triangleEdge12 τ hτ = triangleEdgeOfShape τ hτ (f 3) then 1 else 0) +
    if triangleEdge12 τ hτ = triangleEdgeOfShape τ hτ (f 4) then 1 else 0) = _
  simp [quinticTriangleRepeatTupleOfPattern,
    triangleEdge12_eq_triangleEdgeOfShape_iff]

private lemma quinticTriangleRepeatTupleOfPattern_multiplicity_edge13 {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (f : Fin 5 → TriangleEdgeShape) :
    quinticMomentTupleMultiplicity (quinticTriangleRepeatTupleOfPattern τ hτ f)
        (triangleEdge13 τ hτ)
      = triangleShapeCount f TriangleEdgeShape.edge13 := by
  rw [quinticMomentTupleMultiplicity_apply]
  rw [triangleShapeCount_eq_sum_indicators]
  change (((((if triangleEdge13 τ hτ = triangleEdgeOfShape τ hτ (f 0) then 1 else 0) +
        if triangleEdge13 τ hτ = triangleEdgeOfShape τ hτ (f 1) then 1 else 0) +
      if triangleEdge13 τ hτ = triangleEdgeOfShape τ hτ (f 2) then 1 else 0) +
    if triangleEdge13 τ hτ = triangleEdgeOfShape τ hτ (f 3) then 1 else 0) +
    if triangleEdge13 τ hτ = triangleEdgeOfShape τ hτ (f 4) then 1 else 0) = _
  simp [quinticTriangleRepeatTupleOfPattern,
    triangleEdge13_eq_triangleEdgeOfShape_iff]

private lemma quinticTriangleRepeatTupleOfPattern_multiplicity_edge23 {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (f : Fin 5 → TriangleEdgeShape) :
    quinticMomentTupleMultiplicity (quinticTriangleRepeatTupleOfPattern τ hτ f)
        (triangleEdge23 τ hτ)
      = triangleShapeCount f TriangleEdgeShape.edge23 := by
  rw [quinticMomentTupleMultiplicity_apply]
  rw [triangleShapeCount_eq_sum_indicators]
  change (((((if triangleEdge23 τ hτ = triangleEdgeOfShape τ hτ (f 0) then 1 else 0) +
        if triangleEdge23 τ hτ = triangleEdgeOfShape τ hτ (f 1) then 1 else 0) +
      if triangleEdge23 τ hτ = triangleEdgeOfShape τ hτ (f 2) then 1 else 0) +
    if triangleEdge23 τ hτ = triangleEdgeOfShape τ hτ (f 3) then 1 else 0) +
    if triangleEdge23 τ hτ = triangleEdgeOfShape τ hτ (f 4) then 1 else 0) = _
  simp [quinticTriangleRepeatTupleOfPattern,
    triangleEdge23_eq_triangleEdgeOfShape_iff]

private lemma triangleEdgeOfShape_injective {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    Function.Injective (triangleEdgeOfShape τ hτ) := by
  intro s s' hss'
  cases s <;> cases s' <;> simp [triangleEdgeOfShape] at hss' ⊢
  · exfalso
    exact (triangleEdge12_ne_13 τ hτ) hss'
  · exfalso
    exact (triangleEdge12_ne_23 τ hτ) hss'
  · exfalso
    exact (triangleEdge12_ne_13 τ hτ) hss'.symm
  · exfalso
    exact (triangleEdge13_ne_23 τ hτ) hss'
  · exfalso
    exact (triangleEdge12_ne_23 τ hτ) hss'.symm
  · exfalso
    exact (triangleEdge13_ne_23 τ hτ) hss'.symm

private lemma quinticTriangleRepeatTupleOfPattern_multiplicity {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
  {f : Fin 5 → TriangleEdgeShape} (hf : f ∈ quinticTriangleRepeatPatterns s) :
    quinticMomentTupleMultiplicity (quinticTriangleRepeatTupleOfPattern τ hτ f)
      = quinticTriangleRepeatMultiplicity τ hτ s := by
  rcases (by
      simpa [quinticTriangleRepeatPatterns] using hf :
        triangleShapeCount f TriangleEdgeShape.edge12 = (if s = TriangleEdgeShape.edge12 then 3 else 1) ∧
          triangleShapeCount f TriangleEdgeShape.edge13 = (if s = TriangleEdgeShape.edge13 then 3 else 1) ∧
          triangleShapeCount f TriangleEdgeShape.edge23 = (if s = TriangleEdgeShape.edge23 then 3 else 1))
    with ⟨hf12, hf13, hf23⟩
  funext e
  by_cases he12 : e = triangleEdge12 τ hτ
  · subst e
    rw [quinticTriangleRepeatTupleOfPattern_multiplicity_edge12, hf12]
    cases s
    · simpa using (quinticTriangleRepeatMultiplicity_edge12_self τ hτ).symm
    · simpa using (quinticTriangleRepeatMultiplicity_edge13_other12 τ hτ).symm
    · simpa using (quinticTriangleRepeatMultiplicity_edge23_other12 τ hτ).symm
  · by_cases he13 : e = triangleEdge13 τ hτ
    · subst e
      rw [quinticTriangleRepeatTupleOfPattern_multiplicity_edge13, hf13]
      cases s
      · simpa using (quinticTriangleRepeatMultiplicity_edge12_other13 τ hτ).symm
      · simpa using (quinticTriangleRepeatMultiplicity_edge13_self τ hτ).symm
      · simpa using (quinticTriangleRepeatMultiplicity_edge23_other13 τ hτ).symm
    · by_cases he23 : e = triangleEdge23 τ hτ
      · subst e
        rw [quinticTriangleRepeatTupleOfPattern_multiplicity_edge23, hf23]
        cases s
        · simpa using (quinticTriangleRepeatMultiplicity_edge12_other23 τ hτ).symm
        · simpa using (quinticTriangleRepeatMultiplicity_edge13_other23 τ hτ).symm
        · simpa using (quinticTriangleRepeatMultiplicity_edge23_self τ hτ).symm
      · have he_not : e ∉ triangleEdgeSet τ hτ := by
          simp [triangleEdgeSet, he12, he13, he23]
        have h12e : e ≠ triangleEdge12 τ hτ := he12
        have h13e : e ≠ triangleEdge13 τ hτ := he13
        have h23e : e ≠ triangleEdge23 τ hτ := he23
        have hmatch : ∀ i : Fin 5, e ≠ triangleEdgeOfShape τ hτ (f i) := by
          intro i
          cases hfi : f i <;> simp [triangleEdgeOfShape, h12e, h13e, h23e]
        rw [quinticTriangleRepeatMultiplicity_eq_zero_of_not_mem_support τ hτ s he_not]
        have h0 := hmatch 0
        have h1 := hmatch 1
        have h2 := hmatch 2
        have h3 := hmatch 3
        have h4 := hmatch 4
        simp [quinticMomentTupleMultiplicity_apply, quinticTriangleRepeatTupleOfPattern,
          h0, h1, h2, h3, h4]

private lemma quinticTriangleRepeatMultiplicity_pos_iff {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    {e : Cn3Torus.Edge n} :
    0 < quinticTriangleRepeatMultiplicity τ hτ s e ↔ e ∈ triangleEdgeSet τ hτ := by
  constructor
  · intro he
    by_contra hnot
    rw [quinticTriangleRepeatMultiplicity_eq_zero_of_not_mem_support τ hτ s hnot] at he
    omega
  · intro he
    rcases quinticTriangleRepeatMultiplicity_odd_of_mem_support τ hτ s he with ⟨k, hk⟩
    omega

private lemma quinticTriangleRepeatTupleOfPattern_monomial {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    {f : Fin 5 → TriangleEdgeShape} (hf : f ∈ quinticTriangleRepeatPatterns s)
    (mu : Cn3Torus.Edge n → ℝ) :
    quinticMomentTupleMonomial (quinticTriangleRepeatTupleOfPattern τ hτ f) mu
      = quinticTriangleRepeatMonomial τ hτ s mu := by
  rw [quinticMomentTupleMonomial_eq_coordMonomial,
    quinticTriangleRepeatMonomial_eq_coordMonomial]
  congr 1
  exact quinticTriangleRepeatTupleOfPattern_multiplicity τ hτ s hf

private def triangleEdgeShapeOfEdge {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (e : Cn3Torus.Edge n) :
    TriangleEdgeShape :=
  if e = triangleEdge12 τ hτ then TriangleEdgeShape.edge12
  else if e = triangleEdge13 τ hτ then TriangleEdgeShape.edge13
  else TriangleEdgeShape.edge23

private lemma triangleEdgeOfShape_triangleEdgeShapeOfEdge {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) {e : Cn3Torus.Edge n}
    (he : e ∈ triangleEdgeSet τ hτ) :
    triangleEdgeOfShape τ hτ (triangleEdgeShapeOfEdge τ hτ e) = e := by
  unfold triangleEdgeShapeOfEdge
  by_cases h12 : e = triangleEdge12 τ hτ
  · simp [h12, triangleEdgeOfShape]
  · by_cases h13 : e = triangleEdge13 τ hτ
    · have h31 : triangleEdge13 τ hτ ≠ triangleEdge12 τ hτ := by
        intro h
        exact (triangleEdge12_ne_13 τ hτ) h.symm
      simp [h12, h13, h31, triangleEdgeOfShape]
    · have h23 : e = triangleEdge23 τ hτ := by
        rcases (by simpa [triangleEdgeSet] using he) with h | h | h
        · exact (h12 h).elim
        · exact (h13 h).elim
        · exact h
      have h32 : triangleEdge23 τ hτ ≠ triangleEdge12 τ hτ := by
        intro h
        exact (triangleEdge12_ne_23 τ hτ) h.symm
      have h33 : triangleEdge23 τ hτ ≠ triangleEdge13 τ hτ := by
        intro h
        exact (triangleEdge13_ne_23 τ hτ) h.symm
      simp [h12, h13, h23, h32, h33, triangleEdgeOfShape]

private lemma exists_quinticTriangleRepeatPattern_of_multiplicity_eq {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    {p : EdgeQuintuple n}
    (hmult : quinticMomentTupleMultiplicity p = quinticTriangleRepeatMultiplicity τ hτ s) :
    ∃ f ∈ quinticTriangleRepeatPatterns s,
      p = quinticTriangleRepeatTupleOfPattern τ hτ f := by
  let f : Fin 5 → TriangleEdgeShape := fun i => triangleEdgeShapeOfEdge τ hτ (p i)
  have hsupp : quinticMomentTupleSupport p = triangleEdgeSet τ hτ := by
    ext e
    simpa [mem_quinticMomentTupleSupport_iff, hmult] using
      (quinticTriangleRepeatMultiplicity_pos_iff (τ := τ) (hτ := hτ) (s := s) (e := e))
  have hpi : ∀ i : Fin 5, p i ∈ triangleEdgeSet τ hτ := by
    intro i
    simpa [hsupp] using quinticMomentTuple_mem_support p i
  have hp_eq : p = quinticTriangleRepeatTupleOfPattern τ hτ f := by
    funext i
    dsimp [f, quinticTriangleRepeatTupleOfPattern]
    exact (triangleEdgeOfShape_triangleEdgeShapeOfEdge τ hτ (hpi i)).symm
  have hf12 :
      triangleShapeCount f TriangleEdgeShape.edge12 = (if s = TriangleEdgeShape.edge12 then 3 else 1) := by
    calc
      triangleShapeCount f TriangleEdgeShape.edge12
        = quinticMomentTupleMultiplicity (quinticTriangleRepeatTupleOfPattern τ hτ f)
            (triangleEdge12 τ hτ) := by
              symm
              exact quinticTriangleRepeatTupleOfPattern_multiplicity_edge12 τ hτ f
      _ = quinticMomentTupleMultiplicity p (triangleEdge12 τ hτ) := by
            rw [hp_eq]
      _ = quinticTriangleRepeatMultiplicity τ hτ s (triangleEdge12 τ hτ) := by
            rw [hmult]
      _ = (if s = TriangleEdgeShape.edge12 then 3 else 1) := by
            cases s <;> simp [quinticTriangleRepeatMultiplicity_edge12_self,
              quinticTriangleRepeatMultiplicity_edge13_other12,
              quinticTriangleRepeatMultiplicity_edge23_other12]
  have hf13 :
      triangleShapeCount f TriangleEdgeShape.edge13 = (if s = TriangleEdgeShape.edge13 then 3 else 1) := by
    calc
      triangleShapeCount f TriangleEdgeShape.edge13
        = quinticMomentTupleMultiplicity (quinticTriangleRepeatTupleOfPattern τ hτ f)
            (triangleEdge13 τ hτ) := by
              symm
              exact quinticTriangleRepeatTupleOfPattern_multiplicity_edge13 τ hτ f
      _ = quinticMomentTupleMultiplicity p (triangleEdge13 τ hτ) := by
            rw [hp_eq]
      _ = quinticTriangleRepeatMultiplicity τ hτ s (triangleEdge13 τ hτ) := by
            rw [hmult]
      _ = (if s = TriangleEdgeShape.edge13 then 3 else 1) := by
            cases s <;> simp [quinticTriangleRepeatMultiplicity_edge12_other13,
              quinticTriangleRepeatMultiplicity_edge13_self,
              quinticTriangleRepeatMultiplicity_edge23_other13]
  have hf23 :
      triangleShapeCount f TriangleEdgeShape.edge23 = (if s = TriangleEdgeShape.edge23 then 3 else 1) := by
    calc
      triangleShapeCount f TriangleEdgeShape.edge23
        = quinticMomentTupleMultiplicity (quinticTriangleRepeatTupleOfPattern τ hτ f)
            (triangleEdge23 τ hτ) := by
              symm
              exact quinticTriangleRepeatTupleOfPattern_multiplicity_edge23 τ hτ f
      _ = quinticMomentTupleMultiplicity p (triangleEdge23 τ hτ) := by
            rw [hp_eq]
      _ = quinticTriangleRepeatMultiplicity τ hτ s (triangleEdge23 τ hτ) := by
            rw [hmult]
      _ = (if s = TriangleEdgeShape.edge23 then 3 else 1) := by
            cases s <;> simp [quinticTriangleRepeatMultiplicity_edge12_other23,
              quinticTriangleRepeatMultiplicity_edge13_other23,
              quinticTriangleRepeatMultiplicity_edge23_self]
  refine ⟨f, ?_, hp_eq⟩
  simpa [quinticTriangleRepeatPatterns] using ⟨hf12, hf13, hf23⟩

private lemma quinticTriangleRepeatTupleOfPattern_injective {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    Function.Injective (quinticTriangleRepeatTupleOfPattern τ hτ) := by
  intro f g hfg
  funext i
  apply triangleEdgeOfShape_injective τ hτ
  simpa [quinticTriangleRepeatTupleOfPattern] using congrArg (fun p : EdgeQuintuple n => p i) hfg

private def quinticTriangleRepeatMultiplicityFiber {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape) :
    Finset (EdgeQuintuple n) :=
  (Finset.univ : Finset (EdgeQuintuple n)).filter
    (fun p => quinticMomentTupleMultiplicity p = quinticTriangleRepeatMultiplicity τ hτ s)

private lemma mem_quinticTriangleRepeatMultiplicityFiber_iff {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    {p : EdgeQuintuple n} :
    p ∈ quinticTriangleRepeatMultiplicityFiber τ hτ s ↔
      quinticMomentTupleMultiplicity p = quinticTriangleRepeatMultiplicity τ hτ s := by
  simp [quinticTriangleRepeatMultiplicityFiber]

private lemma sum_quinticTriangleRepeatMultiplicityFiber_monomial {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    (mu : Cn3Torus.Edge n → ℝ) :
    Finset.sum (quinticTriangleRepeatMultiplicityFiber τ hτ s)
      (fun p => quinticMomentTupleMonomial p mu)
      = 20 * quinticTriangleRepeatMonomial τ hτ s mu := by
  classical
  have hsum :
      Finset.sum (quinticTriangleRepeatPatterns s)
          (fun f => quinticMomentTupleMonomial (quinticTriangleRepeatTupleOfPattern τ hτ f) mu)
        =
      Finset.sum (quinticTriangleRepeatMultiplicityFiber τ hτ s)
        (fun p => quinticMomentTupleMonomial p mu) := by
    refine Finset.sum_bij
      (fun f hf => quinticTriangleRepeatTupleOfPattern τ hτ f) ?_ ?_ ?_ ?_
    · intro f hf
      rw [mem_quinticTriangleRepeatMultiplicityFiber_iff]
      exact quinticTriangleRepeatTupleOfPattern_multiplicity τ hτ s hf
    · intro f₁ hf₁ f₂ hf₂ hEq
      exact quinticTriangleRepeatTupleOfPattern_injective τ hτ hEq
    · intro p hp
      rw [mem_quinticTriangleRepeatMultiplicityFiber_iff] at hp
      obtain ⟨f, hf, hEq⟩ := exists_quinticTriangleRepeatPattern_of_multiplicity_eq τ hτ s hp
      refine ⟨f, hf, hEq.symm⟩
    · intro f hf
      rfl
  calc
    Finset.sum (quinticTriangleRepeatMultiplicityFiber τ hτ s)
        (fun p => quinticMomentTupleMonomial p mu)
      = Finset.sum (quinticTriangleRepeatPatterns s)
          (fun f => quinticMomentTupleMonomial (quinticTriangleRepeatTupleOfPattern τ hτ f) mu) := by
            symm
            exact hsum
    _ = Finset.sum (quinticTriangleRepeatPatterns s)
          (fun _ => quinticTriangleRepeatMonomial τ hτ s mu) := by
            refine Finset.sum_congr rfl ?_
            intro f hf
            exact quinticTriangleRepeatTupleOfPattern_monomial τ hτ s hf mu
    _ = ((quinticTriangleRepeatPatterns s).card : ℝ) * quinticTriangleRepeatMonomial τ hτ s mu := by
          simp
    _ = 20 * quinticTriangleRepeatMonomial τ hτ s mu := by
          rw [quinticTriangleRepeatPatterns_card]
          norm_num

private inductive QuinticEdgeTriangleLabel where
  | doubled
  | edge12
  | edge13
  | edge23
  deriving DecidableEq, Fintype

private def quinticEdgeTriangleLabelCount (f : Fin 5 → QuinticEdgeTriangleLabel)
    (s : QuinticEdgeTriangleLabel) : ℕ :=
  (Finset.univ.filter (fun i : Fin 5 => f i = s)).card

private lemma quinticEdgeTriangleLabelCount_eq_sum_indicators (f : Fin 5 → QuinticEdgeTriangleLabel)
    (s : QuinticEdgeTriangleLabel) :
    quinticEdgeTriangleLabelCount f s
      = (if f 0 = s then 1 else 0)
          + (if f 1 = s then 1 else 0)
          + (if f 2 = s then 1 else 0)
          + (if f 3 = s then 1 else 0)
          + (if f 4 = s then 1 else 0) := by
  unfold quinticEdgeTriangleLabelCount
  change #{i : Fin 5 | f i = s} =
      (if f 0 = s then 1 else 0)
        + (if f 1 = s then 1 else 0)
        + (if f 2 = s then 1 else 0)
        + (if f 3 = s then 1 else 0)
        + (if f 4 = s then 1 else 0)
  rw [Fin.card_filter_univ_succ', Fin.card_filter_univ_succ', Fin.card_filter_univ_succ',
    Fin.card_filter_univ_succ', Fin.card_filter_univ_succ']
  simp
  ring_nf

private def quinticEdgeTrianglePatterns : Finset (Fin 5 → QuinticEdgeTriangleLabel) :=
  Finset.univ.filter (fun f =>
    quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.doubled = 2 ∧
    quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge12 = 1 ∧
    quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge13 = 1 ∧
    quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge23 = 1)

private lemma quinticEdgeTrianglePatterns_card :
    quinticEdgeTrianglePatterns.card = 60 := by
  decide

private def quinticEdgeTriangleTupleOfPattern {n : ℕ}
    (e : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (f : Fin 5 → QuinticEdgeTriangleLabel) : EdgeQuintuple n :=
  fun i =>
    match f i with
    | .doubled => e
    | .edge12 => triangleEdge12 τ hτ
    | .edge13 => triangleEdge13 τ hτ
    | .edge23 => triangleEdge23 τ hτ

private def quinticEdgeTriangleMultiplicity {n : ℕ}
    (e : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    Cn3Torus.Edge n → ℕ :=
  edgePowMultiplicity e 2
    + edgePowMultiplicity (triangleEdge12 τ hτ) 1
    + edgePowMultiplicity (triangleEdge13 τ hτ) 1
    + edgePowMultiplicity (triangleEdge23 τ hτ) 1

private lemma quinticEdgeTriangleMultiplicity_doubled_self {n : ℕ}
    (e : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (he : e ∉ triangleEdgeSet τ hτ) :
    quinticEdgeTriangleMultiplicity e τ hτ e = 2 := by
  have h12 : e ≠ triangleEdge12 τ hτ := by
    intro h
    exact he (by simpa [triangleEdgeSet, h])
  have h13 : e ≠ triangleEdge13 τ hτ := by
    intro h
    exact he (by simpa [triangleEdgeSet, h])
  have h23 : e ≠ triangleEdge23 τ hτ := by
    intro h
    exact he (by simpa [triangleEdgeSet, h])
  simp [quinticEdgeTriangleMultiplicity, edgePowMultiplicity, h12, h13, h23]

private lemma quinticEdgeTriangleMultiplicity_triangle12 {n : ℕ}
    (e : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (he : e ∉ triangleEdgeSet τ hτ) :
    quinticEdgeTriangleMultiplicity e τ hτ (triangleEdge12 τ hτ) = 1 := by
  have he12 : e ≠ triangleEdge12 τ hτ := by
    intro h
    exact he (by simpa [triangleEdgeSet, h])
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h23 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  simp [quinticEdgeTriangleMultiplicity, edgePowMultiplicity, he12.symm, h13, h23]

private lemma quinticEdgeTriangleMultiplicity_triangle13 {n : ℕ}
    (e : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (he : e ∉ triangleEdgeSet τ hτ) :
    quinticEdgeTriangleMultiplicity e τ hτ (triangleEdge13 τ hτ) = 1 := by
  have he13 : e ≠ triangleEdge13 τ hτ := by
    intro h
    exact he (by simpa [triangleEdgeSet, h])
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  simp [quinticEdgeTriangleMultiplicity, edgePowMultiplicity, he13.symm, h12.symm, h23]

private lemma quinticEdgeTriangleMultiplicity_triangle23 {n : ℕ}
    (e : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (he : e ∉ triangleEdgeSet τ hτ) :
    quinticEdgeTriangleMultiplicity e τ hτ (triangleEdge23 τ hτ) = 1 := by
  have he23 : e ≠ triangleEdge23 τ hτ := by
    intro h
    exact he (by simpa [triangleEdgeSet, h])
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  have h13 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  simp [quinticEdgeTriangleMultiplicity, edgePowMultiplicity, he23.symm, h12.symm, h13.symm]

private lemma quinticEdgeTriangleMultiplicity_eq_one_of_mem_triangleEdgeSet {n : ℕ}
    (e : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    {x : Cn3Torus.Edge n}
    (he : e ∉ triangleEdgeSet τ hτ)
    (hx : x ∈ triangleEdgeSet τ hτ) :
    quinticEdgeTriangleMultiplicity e τ hτ x = 1 := by
  rcases (by simpa [triangleEdgeSet] using hx) with rfl | rfl | rfl
  · exact quinticEdgeTriangleMultiplicity_triangle12 e τ hτ he
  · exact quinticEdgeTriangleMultiplicity_triangle13 e τ hτ he
  · exact quinticEdgeTriangleMultiplicity_triangle23 e τ hτ he

private lemma quinticEdgeTriangleMultiplicity_eq_zero_of_not_mem {n : ℕ}
    (e : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    {x : Cn3Torus.Edge n}
    (hxe : x ≠ e)
    (hx : x ∉ triangleEdgeSet τ hτ) :
    quinticEdgeTriangleMultiplicity e τ hτ x = 0 := by
  have hx12 : x ≠ triangleEdge12 τ hτ := by
    intro h
    exact hx (by simpa [triangleEdgeSet, h])
  have hx13 : x ≠ triangleEdge13 τ hτ := by
    intro h
    exact hx (by simpa [triangleEdgeSet, h])
  have hx23 : x ≠ triangleEdge23 τ hτ := by
    intro h
    exact hx (by simpa [triangleEdgeSet, h])
  simp [quinticEdgeTriangleMultiplicity, edgePowMultiplicity, hxe, hx12, hx13, hx23]

private lemma quinticSTriangleMonomialOn_eq_coordMonomial {n : ℕ}
    (e : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (mu : Cn3Torus.Edge n → ℝ) :
    quinticSTriangleMonomialOn mu e τ
      = coordMonomial (quinticEdgeTriangleMultiplicity e τ hτ) mu := by
  let mE : Cn3Torus.Edge n → ℕ := edgePowMultiplicity e 2
  let m12 : Cn3Torus.Edge n → ℕ := edgePowMultiplicity (triangleEdge12 τ hτ) 1
  let m13 : Cn3Torus.Edge n → ℕ := edgePowMultiplicity (triangleEdge13 τ hτ) 1
  let m23 : Cn3Torus.Edge n → ℕ := edgePowMultiplicity (triangleEdge23 τ hτ) 1
  calc
    quinticSTriangleMonomialOn mu e τ
      = ((coordMonomial mE mu * coordMonomial m12 mu)
            * coordMonomial m13 mu)
            * coordMonomial m23 mu := by
            simp [quinticSTriangleMonomialOn, triangleMonomialOn, hτ, triangleMonomial,
              mE, m12, m13, m23, coordMonomial_edgePowMultiplicity, mul_assoc]
    _ = (coordMonomial (fun a => mE a + m12 a) mu * coordMonomial m13 mu)
          * coordMonomial m23 mu := by
            rw [coordMonomial_mul]
    _ = (coordMonomial (fun a => (mE a + m12 a) + m13 a) mu)
          * coordMonomial m23 mu := by
            exact congrArg
              (fun z : ℝ => z * coordMonomial m23 mu)
              (coordMonomial_mul (fun a => mE a + m12 a) m13 mu)
    _ = coordMonomial
          (fun a => ((mE a + m12 a) + m13 a) + m23 a) mu := by
            rw [coordMonomial_mul]
    _ = coordMonomial (quinticEdgeTriangleMultiplicity e τ hτ) mu := by
          have hm :
              (fun a => ((mE a + m12 a) + m13 a) + m23 a)
                = quinticEdgeTriangleMultiplicity e τ hτ := by
            funext a
            simp [quinticEdgeTriangleMultiplicity, mE, m12, m13, m23, add_assoc]
          rw [hm]

private lemma left_endpoint_mem_vertices_of_mem_triangleEdgeSet {n : ℕ}
    {u v : Fin n} (huv : u < v) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hmem : ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) ∈ triangleEdgeSet τ hτ)) :
    u ∈ triangleVertices τ := by
  refine left_endpoint_mem_vertices_of_edge_eq_any huv τ hτ ?_
  simpa [triangleEdgeSet, or_assoc, or_left_comm, or_comm] using hmem

private lemma right_endpoint_mem_vertices_of_mem_triangleEdgeSet {n : ℕ}
    {u v : Fin n} (huv : u < v) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hmem : ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) ∈ triangleEdgeSet τ hτ)) :
    v ∈ triangleVertices τ := by
  refine right_endpoint_mem_vertices_of_edge_eq_any huv τ hτ ?_
  simpa [triangleEdgeSet, or_assoc, or_left_comm, or_comm] using hmem

private lemma exists_triangleEdgeSet_incident_of_mem_triangleVertices {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) {v : Fin n}
    (hv : v ∈ triangleVertices τ) :
    ∃ e ∈ triangleEdgeSet τ hτ, e ∈ Cn3Torus.edgesIncident n v := by
  rcases (by simpa [triangleVertices, or_assoc, or_left_comm, or_comm] using hv) with rfl | rfl | rfl
  · exact ⟨triangleEdge12 τ hτ, by simp [triangleEdgeSet],
      Cn3Torus.edge_mem_edgesIncident_left (triangleEdge12 τ hτ)⟩
  · exact ⟨triangleEdge12 τ hτ, by simp [triangleEdgeSet],
      Cn3Torus.edge_mem_edgesIncident_right (triangleEdge12 τ hτ)⟩
  · exact ⟨triangleEdge13 τ hτ, by simp [triangleEdgeSet],
      Cn3Torus.edge_mem_edgesIncident_right (triangleEdge13 τ hτ)⟩

private lemma triangleVertices_eq_of_triangleEdgeSet_eq {n : ℕ}
    (τ τ' : TriangleTriple n) (hτ : IsTriangleTriple τ) (hτ' : IsTriangleTriple τ')
    (hE : triangleEdgeSet τ hτ = triangleEdgeSet τ' hτ') :
    triangleVertices τ = triangleVertices τ' := by
  ext v
  constructor
  · intro hv
    obtain ⟨e, he, hinc⟩ := exists_triangleEdgeSet_incident_of_mem_triangleVertices τ hτ hv
    have he' : e ∈ triangleEdgeSet τ' hτ' := by
      rw [← hE]
      exact he
    rcases e with ⟨⟨u, w⟩, huw⟩
    have hu_mem : u ∈ triangleVertices τ' := by
      exact left_endpoint_mem_vertices_of_mem_triangleEdgeSet huw τ' hτ' he'
    have hw_mem : w ∈ triangleVertices τ' := by
      exact right_endpoint_mem_vertices_of_mem_triangleEdgeSet huw τ' hτ' he'
    rcases (Cn3Torus.mem_edgesIncident_iff (i := v) (e := ⟨(u, w), huw⟩)).1 hinc with hvu | hvw
    · have hvu' : u = v := by
        simpa using hvu
      simpa [hvu'] using hu_mem
    · have hvw' : w = v := by
        simpa using hvw
      simpa [hvw'] using hw_mem
  · intro hv
    obtain ⟨e, he, hinc⟩ := exists_triangleEdgeSet_incident_of_mem_triangleVertices τ' hτ' hv
    have he' : e ∈ triangleEdgeSet τ hτ := by
      rw [hE]
      exact he
    rcases e with ⟨⟨u, w⟩, huw⟩
    have hu_mem : u ∈ triangleVertices τ := by
      exact left_endpoint_mem_vertices_of_mem_triangleEdgeSet huw τ hτ he'
    have hw_mem : w ∈ triangleVertices τ := by
      exact right_endpoint_mem_vertices_of_mem_triangleEdgeSet huw τ hτ he'
    rcases (Cn3Torus.mem_edgesIncident_iff (i := v) (e := ⟨(u, w), huw⟩)).1 hinc with hvu | hvw
    · have hvu' : u = v := by
        simpa using hvu
      simpa [hvu'] using hu_mem
    · have hvw' : w = v := by
        simpa using hvw
      simpa [hvw'] using hw_mem

private lemma triangleTriple_eq_of_triangleEdgeSet_eq {n : ℕ}
    (τ τ' : TriangleTriple n) (hτ : IsTriangleTriple τ) (hτ' : IsTriangleTriple τ')
    (hE : triangleEdgeSet τ hτ = triangleEdgeSet τ' hτ') :
    τ = τ' := by
  exact triangleTriple_eq_of_vertices_eq τ τ' hτ hτ'
    (triangleVertices_eq_of_triangleEdgeSet_eq τ τ' hτ hτ' hE)

private abbrev TriangleChoice (n : ℕ) := ↥(triangleTriples n)

private abbrev TriangleQuadruple (n : ℕ) :=
  TriangleChoice n × (TriangleChoice n × (TriangleChoice n × TriangleChoice n))

private instance {n : ℕ} : DecidableEq (TriangleChoice n) := by
  classical
  infer_instance

private instance {n : ℕ} : DecidableEq (TriangleQuadruple n) := by
  classical
  infer_instance

private abbrev triangleQuad1 {n : ℕ} (q : TriangleQuadruple n) : TriangleChoice n := q.1
private abbrev triangleQuad2 {n : ℕ} (q : TriangleQuadruple n) : TriangleChoice n := q.2.1
private abbrev triangleQuad3 {n : ℕ} (q : TriangleQuadruple n) : TriangleChoice n := q.2.2.1
private abbrev triangleQuad4 {n : ℕ} (q : TriangleQuadruple n) : TriangleChoice n := q.2.2.2

private lemma triangleChoice_valid {n : ℕ} (ξ : TriangleChoice n) :
    IsTriangleTriple ξ.1 := by
  exact (Finset.mem_filter.mp ξ.2).2

private def triangleChoiceMonomial {n : ℕ}
    (ξ : TriangleChoice n) (mu : Cn3Torus.Edge n → ℝ) : ℝ :=
  triangleMonomial ξ.1 (triangleChoice_valid ξ) mu

private def triangleChoiceSupport {n : ℕ}
    (ξ : TriangleChoice n) : Finset (Cn3Torus.Edge n) :=
  triangleEdgeSet ξ.1 (triangleChoice_valid ξ)

private def triangleChoiceVertices {n : ℕ}
    (ξ : TriangleChoice n) : Finset (Fin n) :=
  triangleVertices ξ.1

private def triangleChoiceMultiplicity {n : ℕ}
    (ξ : TriangleChoice n) : Cn3Torus.Edge n → ℕ :=
  edgePowMultiplicity (triangleEdge12 ξ.1 (triangleChoice_valid ξ)) 1
    + edgePowMultiplicity (triangleEdge13 ξ.1 (triangleChoice_valid ξ)) 1
    + edgePowMultiplicity (triangleEdge23 ξ.1 (triangleChoice_valid ξ)) 1

private def triangleQuadrupleMultiplicity {n : ℕ}
    (q : TriangleQuadruple n) : Cn3Torus.Edge n → ℕ :=
  triangleChoiceMultiplicity (triangleQuad1 q)
    + triangleChoiceMultiplicity (triangleQuad2 q)
    + triangleChoiceMultiplicity (triangleQuad3 q)
    + triangleChoiceMultiplicity (triangleQuad4 q)

private def triangleQuadrupleSupport {n : ℕ}
    (q : TriangleQuadruple n) : Finset (Cn3Torus.Edge n) :=
  triangleChoiceSupport (triangleQuad1 q) ∪ triangleChoiceSupport (triangleQuad2 q)
    ∪ triangleChoiceSupport (triangleQuad3 q) ∪ triangleChoiceSupport (triangleQuad4 q)

private def triangleQuadrupleVertices {n : ℕ}
    (q : TriangleQuadruple n) : Finset (Fin n) :=
  triangleChoiceVertices (triangleQuad1 q) ∪ triangleChoiceVertices (triangleQuad2 q)
    ∪ triangleChoiceVertices (triangleQuad3 q) ∪ triangleChoiceVertices (triangleQuad4 q)

private def triangleQuadrupleEven {n : ℕ}
    (q : TriangleQuadruple n) : Prop :=
  ∀ e : Cn3Torus.Edge n, Even (triangleQuadrupleMultiplicity q e)

private def triangleEvenQuadruples (n : ℕ) : Finset (TriangleQuadruple n) := by
  classical
  exact Finset.univ.filter (fun q => triangleQuadrupleEven q)

private def triangleActiveVertexSetsUpToSix (n : ℕ) : Finset (Finset (Fin n)) :=
  (Finset.range 7).biUnion (fun k => Finset.powersetCard k (Finset.univ : Finset (Fin n)))

private def triangleEvenQuadrupleFiber (n : ℕ) (A : Finset (Fin n)) :
    Finset (TriangleQuadruple n) := by
  classical
  exact (triangleEvenQuadruples n).filter (fun q => triangleQuadrupleVertices q = A)

private lemma triangleChoiceVertices_card {n : ℕ} (ξ : TriangleChoice n) :
    (triangleChoiceVertices ξ).card = 3 := by
  simpa [triangleChoiceVertices] using triangleVertices_card ξ.1 (triangleChoice_valid ξ)

private lemma triangleChoice_eq_of_vertices_eq {n : ℕ}
    {ξ η : TriangleChoice n}
    (hV : triangleChoiceVertices ξ = triangleChoiceVertices η) :
    ξ = η := by
  apply Subtype.ext
  exact triangleTriple_eq_of_vertices_eq
    ξ.1 η.1 (triangleChoice_valid ξ) (triangleChoice_valid η) hV

private lemma triangleChoiceMonomial_eq_coordMonomial {n : ℕ}
    (ξ : TriangleChoice n) (mu : Cn3Torus.Edge n → ℝ) :
    triangleChoiceMonomial ξ mu = coordMonomial (triangleChoiceMultiplicity ξ) mu := by
  let m12 : Cn3Torus.Edge n → ℕ := edgePowMultiplicity (triangleEdge12 ξ.1 (triangleChoice_valid ξ)) 1
  let m13 : Cn3Torus.Edge n → ℕ := edgePowMultiplicity (triangleEdge13 ξ.1 (triangleChoice_valid ξ)) 1
  let m23 : Cn3Torus.Edge n → ℕ := edgePowMultiplicity (triangleEdge23 ξ.1 (triangleChoice_valid ξ)) 1
  calc
    triangleChoiceMonomial ξ mu
      = (coordMonomial m12 mu * coordMonomial m13 mu) * coordMonomial m23 mu := by
          simp [triangleChoiceMonomial, triangleMonomial, m12, m13, m23,
            coordMonomial_edgePowMultiplicity, mul_assoc]
    _ = coordMonomial (m12 + m13) mu * coordMonomial m23 mu := by
          simpa [Pi.add_apply] using
            congrArg (fun z : ℝ => z * coordMonomial m23 mu)
              (coordMonomial_mul m12 m13 mu)
    _ = coordMonomial ((m12 + m13) + m23) mu := by
          simpa [Pi.add_apply] using coordMonomial_mul (m12 + m13) m23 mu
    _ = coordMonomial (triangleChoiceMultiplicity ξ) mu := by
          simp [triangleChoiceMultiplicity, m12, m13, m23, add_assoc]

private lemma triangleChoiceSupport_subset_quadrupleSupport {n : ℕ}
    (q : TriangleQuadruple n) :
    triangleChoiceSupport (triangleQuad1 q) ⊆ triangleQuadrupleSupport q ∧
      triangleChoiceSupport (triangleQuad2 q) ⊆ triangleQuadrupleSupport q ∧
      triangleChoiceSupport (triangleQuad3 q) ⊆ triangleQuadrupleSupport q ∧
      triangleChoiceSupport (triangleQuad4 q) ⊆ triangleQuadrupleSupport q := by
  constructor
