            exact right_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
          · have he : quarticEdge24 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.third := by
              simp [quarticCycleSupport]
            have he' : quarticEdge24 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
              exact he
            exact left_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
    · cases ξ using Prod.rec with
      | _ σ s =>
          cases s
          · have he : quarticEdge34 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.first := by
              simp [quarticCycleSupport]
            have he' : quarticEdge34 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
              exact he
            exact left_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
          · have he : quarticEdge34 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.second := by
              simp [quarticCycleSupport]
            have he' : quarticEdge34 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
              exact he
            exact left_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
          · have he : quarticEdge13 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.third := by
              simp [quarticCycleSupport]
            have he' : quarticEdge13 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
              exact he
            exact right_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
    · cases ξ using Prod.rec with
      | _ σ s =>
          cases s
          · have he : quarticEdge34 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.first := by
              simp [quarticCycleSupport]
            have he' : quarticEdge34 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
              exact he
            exact right_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
          · have he : quarticEdge34 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.second := by
              simp [quarticCycleSupport]
            have he' : quarticEdge34 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
              exact he
            exact right_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
          · have he : quarticEdge24 σ hξ ∈ quarticCycleSupport σ hξ QuarticCycleShape.third := by
              simp [quarticCycleSupport]
            have he' : quarticEdge24 σ hξ ∈ quarticCycleSupport ξ'.1 hξ' ξ'.2 := by
              rw [← hS]
              exact he
            exact right_endpoint_mem_quarticVertices_of_mem_support ξ'.1 hξ' ξ'.2 he'
  have hcard :
      (quarticVertices ξ'.1).card ≤ (quarticVertices ξ.1).card := by
    rw [quarticVertices_card ξ'.1 hξ', quarticVertices_card ξ.1 hξ]
  have hV :
      quarticVertices ξ.1 = quarticVertices ξ'.1 := Finset.eq_of_subset_of_card_le hsubset hcard
  have hσeq : ξ.1 = ξ'.1 := simpleCycle4Index_eq_of_vertices_eq ξ.1 ξ'.1 hξ hξ' hV
  rcases ξ with ⟨σ, s⟩
  rcases ξ' with ⟨σ', s'⟩
  simp at hσeq
  subst hσeq
  cases s <;> cases s'
  · rfl
  · exfalso
    exact quarticCycleSupport_first_ne_second σ hξ (by simpa using hS)
  · exfalso
    exact quarticCycleSupport_first_ne_third σ hξ (by simpa using hS)
  · exfalso
    exact quarticCycleSupport_first_ne_second σ hξ (by simpa using hS.symm)
  · rfl
  · exfalso
    exact quarticCycleSupport_second_ne_third σ hξ (by simpa using hS)
  · exfalso
    exact quarticCycleSupport_first_ne_third σ hξ (by simpa using hS.symm)
  · exfalso
    exact quarticCycleSupport_second_ne_third σ hξ (by simpa using hS.symm)
  · rfl

private lemma quarticCycleMultiplicity_total_degree {n : ℕ}
    (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) (s : QuarticCycleShape) :
    (∑ e : Cn3Torus.Edge n, quarticCycleMultiplicity σ hσ s e) = 4 := by
  cases s
  · simp [quarticCycleMultiplicity, Finset.sum_add_distrib, sum_edgePowMultiplicity]
  · simp [quarticCycleMultiplicity, Finset.sum_add_distrib, sum_edgePowMultiplicity]
  · simp [quarticCycleMultiplicity, Finset.sum_add_distrib, sum_edgePowMultiplicity]

private lemma quarticCycleMultiplicity_odd_of_mem_support {n : ℕ}
    (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) (s : QuarticCycleShape)
    {e : Cn3Torus.Edge n} (he : e ∈ quarticCycleSupport σ hσ s) :
    Odd (quarticCycleMultiplicity σ hσ s e) := by
  cases s
  · rcases (by simpa [quarticCycleSupport] using he) with rfl | rfl | rfl | rfl
    · simp [quarticCycleMultiplicity, edgePowMultiplicity, quarticEdge12_ne_23, quarticEdge12_ne_34,
        quarticEdge12_ne_14]
    · have h23_12 : quarticEdge23 σ hσ ≠ quarticEdge12 σ hσ := by
          intro h
          exact quarticEdge12_ne_23 σ hσ h.symm
      have h23_14 : quarticEdge23 σ hσ ≠ quarticEdge14 σ hσ := by
          intro h
          exact quarticEdge14_ne_23 σ hσ h.symm
      simp [quarticCycleMultiplicity, edgePowMultiplicity, h23_12, quarticEdge23_ne_34, h23_14]
    · have h34_12 : quarticEdge34 σ hσ ≠ quarticEdge12 σ hσ := by
          intro h
          exact quarticEdge12_ne_34 σ hσ h.symm
      have h34_23 : quarticEdge34 σ hσ ≠ quarticEdge23 σ hσ := by
          intro h
          exact quarticEdge23_ne_34 σ hσ h.symm
      have h34_14 : quarticEdge34 σ hσ ≠ quarticEdge14 σ hσ := by
          intro h
          exact quarticEdge14_ne_34 σ hσ h.symm
      simp [quarticCycleMultiplicity, edgePowMultiplicity, h34_12, h34_23, h34_14]
    · have h14_12 : quarticEdge14 σ hσ ≠ quarticEdge12 σ hσ := by
          intro h
          exact quarticEdge12_ne_14 σ hσ h.symm
      simp [quarticCycleMultiplicity, edgePowMultiplicity, h14_12, quarticEdge14_ne_23, quarticEdge14_ne_34]
  · rcases (by simpa [quarticCycleSupport] using he) with rfl | rfl | rfl | rfl
    · simp [quarticCycleMultiplicity, edgePowMultiplicity, quarticEdge12_ne_24, quarticEdge12_ne_34,
        quarticEdge12_ne_13]
    · have h24_12 : quarticEdge24 σ hσ ≠ quarticEdge12 σ hσ := by
          intro h
          exact quarticEdge12_ne_24 σ hσ h.symm
      have h24_13 : quarticEdge24 σ hσ ≠ quarticEdge13 σ hσ := by
          intro h
          exact quarticEdge13_ne_24 σ hσ h.symm
      simp [quarticCycleMultiplicity, edgePowMultiplicity, h24_12, quarticEdge24_ne_34, h24_13]
    · have h34_12 : quarticEdge34 σ hσ ≠ quarticEdge12 σ hσ := by
          intro h
          exact quarticEdge12_ne_34 σ hσ h.symm
      have h34_24 : quarticEdge34 σ hσ ≠ quarticEdge24 σ hσ := by
          intro h
          exact quarticEdge24_ne_34 σ hσ h.symm
      have h34_13 : quarticEdge34 σ hσ ≠ quarticEdge13 σ hσ := by
          intro h
          exact quarticEdge13_ne_34 σ hσ h.symm
      simp [quarticCycleMultiplicity, edgePowMultiplicity, h34_12, h34_24, h34_13]
    · have h13_12 : quarticEdge13 σ hσ ≠ quarticEdge12 σ hσ := by
          intro h
          exact quarticEdge12_ne_13 σ hσ h.symm
      simp [quarticCycleMultiplicity, edgePowMultiplicity, h13_12, quarticEdge13_ne_24, quarticEdge13_ne_34]
  · rcases (by simpa [quarticCycleSupport] using he) with rfl | rfl | rfl | rfl
    · simp [quarticCycleMultiplicity, edgePowMultiplicity, quarticEdge13_ne_23, quarticEdge13_ne_24,
        quarticEdge13_ne_14]
    · have h23_13 : quarticEdge23 σ hσ ≠ quarticEdge13 σ hσ := by
          intro h
          exact quarticEdge13_ne_23 σ hσ h.symm
      have h23_14 : quarticEdge23 σ hσ ≠ quarticEdge14 σ hσ := by
          intro h
          exact quarticEdge14_ne_23 σ hσ h.symm
      simp [quarticCycleMultiplicity, edgePowMultiplicity, h23_13, quarticEdge23_ne_24, h23_14]
    · have h24_13 : quarticEdge24 σ hσ ≠ quarticEdge13 σ hσ := by
          intro h
          exact quarticEdge13_ne_24 σ hσ h.symm
      have h24_23 : quarticEdge24 σ hσ ≠ quarticEdge23 σ hσ := by
          intro h
          exact quarticEdge23_ne_24 σ hσ h.symm
      have h24_14 : quarticEdge24 σ hσ ≠ quarticEdge14 σ hσ := by
          intro h
          exact quarticEdge14_ne_24 σ hσ h.symm
      simp [quarticCycleMultiplicity, edgePowMultiplicity, h24_13, h24_23, h24_14]
    · have h14_13 : quarticEdge14 σ hσ ≠ quarticEdge13 σ hσ := by
          intro h
          exact quarticEdge13_ne_14 σ hσ h.symm
      simp [quarticCycleMultiplicity, edgePowMultiplicity, h14_13, quarticEdge14_ne_23, quarticEdge14_ne_24]

private lemma quarticCycleMultiplicity_not_odd_of_not_mem_support {n : ℕ}
    (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) (s : QuarticCycleShape)
    {e : Cn3Torus.Edge n} (he : e ∉ quarticCycleSupport σ hσ s) :
    ¬ Odd (quarticCycleMultiplicity σ hσ s e) := by
  cases s
  · have h12 : e ≠ quarticEdge12 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    have h23 : e ≠ quarticEdge23 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    have h34 : e ≠ quarticEdge34 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    have h14 : e ≠ quarticEdge14 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    simp [quarticCycleMultiplicity, edgePowMultiplicity, h12, h23, h34, h14]
  · have h12 : e ≠ quarticEdge12 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    have h24 : e ≠ quarticEdge24 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    have h34 : e ≠ quarticEdge34 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    have h13 : e ≠ quarticEdge13 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    simp [quarticCycleMultiplicity, edgePowMultiplicity, h12, h24, h34, h13]
  · have h13 : e ≠ quarticEdge13 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    have h23 : e ≠ quarticEdge23 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    have h24 : e ≠ quarticEdge24 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    have h14 : e ≠ quarticEdge14 σ hσ := by
        intro h
        exact he (by simp [quarticCycleSupport, h])
    simp [quarticCycleMultiplicity, edgePowMultiplicity, h13, h23, h24, h14]

private lemma odd_add_of_odd_even {a b : ℕ} (ha : Odd a) (hb : Even b) : Odd (a + b) := by
  rcases ha with ⟨k, hk⟩
  rcases hb with ⟨l, hl⟩
  refine ⟨k + l, ?_⟩
  rw [hk, hl]
  ring

private lemma quarticCycleMonomial_eq_coordMonomial {n : ℕ}
    (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ)
    (s : QuarticCycleShape) (mu : Cn3Torus.Edge n → ℝ) :
    quarticCycleMonomial σ hσ s mu = coordMonomial (quarticCycleMultiplicity σ hσ s) mu := by
  cases s
  · let m12 := edgePowMultiplicity (quarticEdge12 σ hσ) 1
    let m23 := edgePowMultiplicity (quarticEdge23 σ hσ) 1
    let m34 := edgePowMultiplicity (quarticEdge34 σ hσ) 1
    let m14 := edgePowMultiplicity (quarticEdge14 σ hσ) 1
    calc
      quarticCycleMonomial σ hσ QuarticCycleShape.first mu
        = (((coordMonomial m12 mu * coordMonomial m23 mu) * coordMonomial m34 mu)
            * coordMonomial m14 mu) := by
              simp [quarticCycleMonomial, m12, m23, m34, m14, coordMonomial_edgePowMultiplicity]
      _ = ((coordMonomial (m12 + m23) mu) * coordMonomial m34 mu) * coordMonomial m14 mu := by
            simpa [Pi.add_apply] using
              congrArg (fun z : ℝ => (z * coordMonomial m34 mu) * coordMonomial m14 mu)
                (coordMonomial_mul m12 m23 mu)
      _ = (coordMonomial ((m12 + m23) + m34) mu) * coordMonomial m14 mu := by
            simpa [Pi.add_apply] using
              congrArg (fun z : ℝ => z * coordMonomial m14 mu)
                (coordMonomial_mul (m12 + m23) m34 mu)
      _ = coordMonomial (((m12 + m23) + m34) + m14) mu := by
            simpa [Pi.add_apply] using
              (coordMonomial_mul ((m12 + m23) + m34) m14 mu)
      _ = coordMonomial (quarticCycleMultiplicity σ hσ QuarticCycleShape.first) mu := by
            rfl
  · let m12 := edgePowMultiplicity (quarticEdge12 σ hσ) 1
    let m24 := edgePowMultiplicity (quarticEdge24 σ hσ) 1
    let m34 := edgePowMultiplicity (quarticEdge34 σ hσ) 1
    let m13 := edgePowMultiplicity (quarticEdge13 σ hσ) 1
    calc
      quarticCycleMonomial σ hσ QuarticCycleShape.second mu
        = (((coordMonomial m12 mu * coordMonomial m24 mu) * coordMonomial m34 mu)
            * coordMonomial m13 mu) := by
              simp [quarticCycleMonomial, m12, m24, m34, m13, coordMonomial_edgePowMultiplicity]
      _ = ((coordMonomial (m12 + m24) mu) * coordMonomial m34 mu) * coordMonomial m13 mu := by
            simpa [Pi.add_apply] using
              congrArg (fun z : ℝ => (z * coordMonomial m34 mu) * coordMonomial m13 mu)
                (coordMonomial_mul m12 m24 mu)
      _ = (coordMonomial ((m12 + m24) + m34) mu) * coordMonomial m13 mu := by
            simpa [Pi.add_apply] using
              congrArg (fun z : ℝ => z * coordMonomial m13 mu)
                (coordMonomial_mul (m12 + m24) m34 mu)
      _ = coordMonomial (((m12 + m24) + m34) + m13) mu := by
            simpa [Pi.add_apply] using
              (coordMonomial_mul ((m12 + m24) + m34) m13 mu)
      _ = coordMonomial (quarticCycleMultiplicity σ hσ QuarticCycleShape.second) mu := by
            rfl
  · let m13 := edgePowMultiplicity (quarticEdge13 σ hσ) 1
    let m23 := edgePowMultiplicity (quarticEdge23 σ hσ) 1
    let m24 := edgePowMultiplicity (quarticEdge24 σ hσ) 1
    let m14 := edgePowMultiplicity (quarticEdge14 σ hσ) 1
    calc
      quarticCycleMonomial σ hσ QuarticCycleShape.third mu
        = (((coordMonomial m13 mu * coordMonomial m23 mu) * coordMonomial m24 mu)
            * coordMonomial m14 mu) := by
              simp [quarticCycleMonomial, m13, m23, m24, m14, coordMonomial_edgePowMultiplicity]
      _ = ((coordMonomial (m13 + m23) mu) * coordMonomial m24 mu) * coordMonomial m14 mu := by
            simpa [Pi.add_apply] using
              congrArg (fun z : ℝ => (z * coordMonomial m24 mu) * coordMonomial m14 mu)
                (coordMonomial_mul m13 m23 mu)
      _ = (coordMonomial ((m13 + m23) + m24) mu) * coordMonomial m14 mu := by
            simpa [Pi.add_apply] using
              congrArg (fun z : ℝ => z * coordMonomial m14 mu)
                (coordMonomial_mul (m13 + m23) m24 mu)
      _ = coordMonomial (((m13 + m23) + m24) + m14) mu := by
            simpa [Pi.add_apply] using
              (coordMonomial_mul ((m13 + m23) + m24) m14 mu)
      _ = coordMonomial (quarticCycleMultiplicity σ hσ QuarticCycleShape.third) mu := by
            rfl

private lemma quarticCycle_pair_gaussian_zero_of_ne {n : ℕ}
    (ξ ξ' : SimpleCycle4Index n × QuarticCycleShape)
    (hξ : IsSimpleCycle4Index ξ.1) (hξ' : IsSimpleCycle4Index ξ'.1)
    (hne : ξ ≠ ξ') (t : ℝ) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quarticCycleMonomial ξ.1 hξ ξ.2 mu * quarticCycleMonomial ξ'.1 hξ' ξ'.2 mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = 0 := by
  let S := quarticCycleSupport ξ.1 hξ ξ.2
  let S' := quarticCycleSupport ξ'.1 hξ' ξ'.2
  have hSne : S ≠ S' := by
    intro hS
    exact hne (quarticCycleSupport_injective ξ ξ' hξ hξ' (by simpa [S, S'] using hS))
  have hexists : ∃ e : Cn3Torus.Edge n, e ∈ S ∧ e ∉ S' := by
    by_contra hnone
    have hsubset : S ⊆ S' := by
      intro e he
      by_contra he'
      exact hnone ⟨e, he, he'⟩
    have hcard : S'.card ≤ S.card := by
      have hScard : S.card = 4 := by
        simp [S, quarticCycleSupport_card]
      have hS'card : S'.card = 4 := by
        simp [S', quarticCycleSupport_card]
      omega
    have hEq : S = S' := Finset.eq_of_subset_of_card_le hsubset hcard
    exact hSne hEq
  rcases hexists with ⟨e, heS, heS'⟩
  have hodd₁ : Odd (quarticCycleMultiplicity ξ.1 hξ ξ.2 e) := by
    simpa [S] using quarticCycleMultiplicity_odd_of_mem_support ξ.1 hξ ξ.2 heS
  have heven₂ : Even (quarticCycleMultiplicity ξ'.1 hξ' ξ'.2 e) := by
    exact (Nat.not_odd_iff_even).mp (by
      simpa [S'] using quarticCycleMultiplicity_not_odd_of_not_mem_support ξ'.1 hξ' ξ'.2 heS')
  have hodd :
      Odd ((quarticCycleMultiplicity ξ.1 hξ ξ.2 + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2) e) := by
    exact odd_add_of_odd_even hodd₁ heven₂
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quarticCycleMonomial ξ.1 hξ ξ.2 mu * quarticCycleMonomial ξ'.1 hξ' ξ'.2 mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial
              (quarticCycleMultiplicity ξ.1 hξ ξ.2 + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2) mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              refine MeasureTheory.integral_congr_ae ?_
              exact Filter.Eventually.of_forall (fun mu => by
                have hadd :
                    (fun a =>
                      quarticCycleMultiplicity ξ.1 hξ ξ.2 a
                        + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2 a)
                      = quarticCycleMultiplicity ξ.1 hξ ξ.2 + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2 := by
                  funext a
                  simp
                simp [quarticCycleMonomial_eq_coordMonomial, coordMonomial_mul, hadd])
    _ = 0 := gaussian_edge_coordMonomial_odd_zero e
          (quarticCycleMultiplicity ξ.1 hξ ξ.2 + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2) t hodd

private lemma quarticCyclePair_integrable {n : ℕ}
    (ξ ξ' : SimpleCycle4Index n × QuarticCycleShape)
    (hξ : IsSimpleCycle4Index ξ.1) (hξ' : IsSimpleCycle4Index ξ'.1)
    (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      quarticCycleMonomial ξ.1 hξ ξ.2 mu * quarticCycleMonomial ξ'.1 hξ' ξ'.2 mu
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  have hdeg :
      (∑ e : Cn3Torus.Edge n,
          (quarticCycleMultiplicity ξ.1 hξ ξ.2 + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2) e)
        = 2 * 4 := by
    calc
      (∑ e : Cn3Torus.Edge n,
          (quarticCycleMultiplicity ξ.1 hξ ξ.2 + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2) e)
        = ∑ e : Cn3Torus.Edge n,
            (quarticCycleMultiplicity ξ.1 hξ ξ.2 e + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2 e) := by
              simp
      _ = (∑ e : Cn3Torus.Edge n, quarticCycleMultiplicity ξ.1 hξ ξ.2 e)
            + ∑ e : Cn3Torus.Edge n, quarticCycleMultiplicity ξ'.1 hξ' ξ'.2 e := by
              rw [Finset.sum_add_distrib]
      _ = 4 + 4 := by
            rw [quarticCycleMultiplicity_total_degree, quarticCycleMultiplicity_total_degree]
      _ = 2 * 4 := by norm_num
  have hbase :
      MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
        coordMonomial
            (quarticCycleMultiplicity ξ.1 hξ ξ.2 + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2) mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) :=
    edge_coordMonomial_integrable
      (quarticCycleMultiplicity ξ.1 hξ ξ.2 + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2)
      4 (by norm_num) hdeg t ht
  refine hbase.congr ?_
  exact Filter.Eventually.of_forall (fun mu => by
    change
      coordMonomial
          (fun a =>
            quarticCycleMultiplicity ξ.1 hξ ξ.2 a + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2 a) mu
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        =
      quarticCycleMonomial ξ.1 hξ ξ.2 mu * quarticCycleMonomial ξ'.1 hξ' ξ'.2 mu
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
    have hadd :
        (fun a =>
          quarticCycleMultiplicity ξ.1 hξ ξ.2 a
            + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2 a)
          = quarticCycleMultiplicity ξ.1 hξ ξ.2 + quarticCycleMultiplicity ξ'.1 hξ' ξ'.2 := by
      funext a
      simp
    simp [quarticCycleMonomial_eq_coordMonomial, coordMonomial_mul, hadd])

private def quarticCycleQuadrupleMultiplicity {n : ℕ}
    (ξ₁ ξ₂ ξ₃ ξ₄ : SimpleCycle4Index n × QuarticCycleShape)
    (hξ₁ : IsSimpleCycle4Index ξ₁.1) (hξ₂ : IsSimpleCycle4Index ξ₂.1)
    (hξ₃ : IsSimpleCycle4Index ξ₃.1) (hξ₄ : IsSimpleCycle4Index ξ₄.1) :
    Cn3Torus.Edge n → ℕ :=
  quarticCycleMultiplicity ξ₁.1 hξ₁ ξ₁.2
    + quarticCycleMultiplicity ξ₂.1 hξ₂ ξ₂.2
    + quarticCycleMultiplicity ξ₃.1 hξ₃ ξ₃.2
    + quarticCycleMultiplicity ξ₄.1 hξ₄ ξ₄.2

private lemma quarticCycleQuadrupleMultiplicity_total_degree {n : ℕ}
    (ξ₁ ξ₂ ξ₃ ξ₄ : SimpleCycle4Index n × QuarticCycleShape)
    (hξ₁ : IsSimpleCycle4Index ξ₁.1) (hξ₂ : IsSimpleCycle4Index ξ₂.1)
    (hξ₃ : IsSimpleCycle4Index ξ₃.1) (hξ₄ : IsSimpleCycle4Index ξ₄.1) :
    (∑ e : Cn3Torus.Edge n,
        quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄ e) = 2 * 8 := by
  calc
    (∑ e : Cn3Torus.Edge n,
        quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄ e)
      = ∑ e : Cn3Torus.Edge n,
          (quarticCycleMultiplicity ξ₁.1 hξ₁ ξ₁.2 e
            + quarticCycleMultiplicity ξ₂.1 hξ₂ ξ₂.2 e
            + quarticCycleMultiplicity ξ₃.1 hξ₃ ξ₃.2 e
            + quarticCycleMultiplicity ξ₄.1 hξ₄ ξ₄.2 e) := by
              simp [quarticCycleQuadrupleMultiplicity]
    _ = (∑ e : Cn3Torus.Edge n, quarticCycleMultiplicity ξ₁.1 hξ₁ ξ₁.2 e)
          + ∑ e : Cn3Torus.Edge n, quarticCycleMultiplicity ξ₂.1 hξ₂ ξ₂.2 e
          + ∑ e : Cn3Torus.Edge n, quarticCycleMultiplicity ξ₃.1 hξ₃ ξ₃.2 e
          + ∑ e : Cn3Torus.Edge n, quarticCycleMultiplicity ξ₄.1 hξ₄ ξ₄.2 e := by
            simp [Finset.sum_add_distrib, add_assoc, add_left_comm, add_comm]
    _ = 4 + 4 + 4 + 4 := by
          rw [quarticCycleMultiplicity_total_degree, quarticCycleMultiplicity_total_degree,
            quarticCycleMultiplicity_total_degree, quarticCycleMultiplicity_total_degree]
    _ = 2 * 8 := by norm_num

private lemma quarticCycleQuadrupleMonomial_eq_coordMonomial {n : ℕ}
    (ξ₁ ξ₂ ξ₃ ξ₄ : SimpleCycle4Index n × QuarticCycleShape)
    (hξ₁ : IsSimpleCycle4Index ξ₁.1) (hξ₂ : IsSimpleCycle4Index ξ₂.1)
    (hξ₃ : IsSimpleCycle4Index ξ₃.1) (hξ₄ : IsSimpleCycle4Index ξ₄.1)
    (mu : Cn3Torus.Edge n → ℝ) :
    quarticCycleMonomial ξ₁.1 hξ₁ ξ₁.2 mu
        * quarticCycleMonomial ξ₂.1 hξ₂ ξ₂.2 mu
        * quarticCycleMonomial ξ₃.1 hξ₃ ξ₃.2 mu
        * quarticCycleMonomial ξ₄.1 hξ₄ ξ₄.2 mu
      =
    coordMonomial
      (quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄) mu := by
  let m₁ := quarticCycleMultiplicity ξ₁.1 hξ₁ ξ₁.2
  let m₂ := quarticCycleMultiplicity ξ₂.1 hξ₂ ξ₂.2
  let m₃ := quarticCycleMultiplicity ξ₃.1 hξ₃ ξ₃.2
  let m₄ := quarticCycleMultiplicity ξ₄.1 hξ₄ ξ₄.2
  calc
    quarticCycleMonomial ξ₁.1 hξ₁ ξ₁.2 mu
        * quarticCycleMonomial ξ₂.1 hξ₂ ξ₂.2 mu
        * quarticCycleMonomial ξ₃.1 hξ₃ ξ₃.2 mu
        * quarticCycleMonomial ξ₄.1 hξ₄ ξ₄.2 mu
      = ((coordMonomial m₁ mu * coordMonomial m₂ mu) * coordMonomial m₃ mu)
          * coordMonomial m₄ mu := by
            simp [m₁, m₂, m₃, m₄, quarticCycleMonomial_eq_coordMonomial, mul_assoc]
    _ = (coordMonomial (m₁ + m₂) mu * coordMonomial m₃ mu) * coordMonomial m₄ mu := by
          simpa [Pi.add_apply] using
            congrArg (fun z : ℝ => (z * coordMonomial m₃ mu) * coordMonomial m₄ mu)
              (coordMonomial_mul m₁ m₂ mu)
    _ = coordMonomial ((m₁ + m₂) + m₃) mu * coordMonomial m₄ mu := by
          simpa [Pi.add_apply] using
            congrArg (fun z : ℝ => z * coordMonomial m₄ mu)
              (coordMonomial_mul (m₁ + m₂) m₃ mu)
    _ = coordMonomial (((m₁ + m₂) + m₃) + m₄) mu := by
          simpa [Pi.add_apply] using
            (coordMonomial_mul ((m₁ + m₂) + m₃) m₄ mu)
    _ =
        coordMonomial
          (quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄) mu := by
          simp [quarticCycleQuadrupleMultiplicity, m₁, m₂, m₃, m₄]

private lemma quarticCycleQuadruple_integrable {n : ℕ}
    (ξ₁ ξ₂ ξ₃ ξ₄ : SimpleCycle4Index n × QuarticCycleShape)
    (hξ₁ : IsSimpleCycle4Index ξ₁.1) (hξ₂ : IsSimpleCycle4Index ξ₂.1)
    (hξ₃ : IsSimpleCycle4Index ξ₃.1) (hξ₄ : IsSimpleCycle4Index ξ₄.1)
    (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      quarticCycleMonomial ξ₁.1 hξ₁ ξ₁.2 mu
        * quarticCycleMonomial ξ₂.1 hξ₂ ξ₂.2 mu
        * quarticCycleMonomial ξ₃.1 hξ₃ ξ₃.2 mu
        * quarticCycleMonomial ξ₄.1 hξ₄ ξ₄.2 mu
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  have hdeg :
      (∑ e : Cn3Torus.Edge n,
          quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄ e) = 2 * 8 :=
    quarticCycleQuadrupleMultiplicity_total_degree ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄
  have hbase :
      MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
        coordMonomial
            (quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄) mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) :=
    edge_coordMonomial_integrable
      (quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄)
      8 (by norm_num) hdeg t ht
  refine hbase.congr ?_
  exact Filter.Eventually.of_forall (fun mu => by
    simpa [mul_assoc] using
      (congrArg
        (fun z : ℝ => z * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
        (quarticCycleQuadrupleMonomial_eq_coordMonomial ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄ mu)).symm)

private lemma quarticCycleQuadruple_gaussian_zero_of_exists_odd {n : ℕ}
    (ξ₁ ξ₂ ξ₃ ξ₄ : SimpleCycle4Index n × QuarticCycleShape)
    (hξ₁ : IsSimpleCycle4Index ξ₁.1) (hξ₂ : IsSimpleCycle4Index ξ₂.1)
    (hξ₃ : IsSimpleCycle4Index ξ₃.1) (hξ₄ : IsSimpleCycle4Index ξ₄.1)
    (t : ℝ)
    (hodd :
      ∃ e : Cn3Torus.Edge n,
        Odd (quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄ e)) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quarticCycleMonomial ξ₁.1 hξ₁ ξ₁.2 mu
          * quarticCycleMonomial ξ₂.1 hξ₂ ξ₂.2 mu
          * quarticCycleMonomial ξ₃.1 hξ₃ ξ₃.2 mu
          * quarticCycleMonomial ξ₄.1 hξ₄ ξ₄.2 mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = 0 := by
  rcases hodd with ⟨e, he⟩
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quarticCycleMonomial ξ₁.1 hξ₁ ξ₁.2 mu
          * quarticCycleMonomial ξ₂.1 hξ₂ ξ₂.2 mu
          * quarticCycleMonomial ξ₃.1 hξ₃ ξ₃.2 mu
          * quarticCycleMonomial ξ₄.1 hξ₄ ξ₄.2 mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial
              (quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄) mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              refine MeasureTheory.integral_congr_ae ?_
              exact Filter.Eventually.of_forall (fun mu => by
                simpa [mul_assoc] using
                  congrArg
                    (fun z : ℝ => z * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
                    (quarticCycleQuadrupleMonomial_eq_coordMonomial
                      ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄ mu))
    _ = 0 := gaussian_edge_coordMonomial_odd_zero e
          (quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄) t he

private lemma quarticCycleQuadruple_gaussian_bound_of_even {n : ℕ}
    (ξ₁ ξ₂ ξ₃ ξ₄ : SimpleCycle4Index n × QuarticCycleShape)
    (hξ₁ : IsSimpleCycle4Index ξ₁.1) (hξ₂ : IsSimpleCycle4Index ξ₂.1)
    (hξ₃ : IsSimpleCycle4Index ξ₃.1) (hξ₄ : IsSimpleCycle4Index ξ₄.1)
    (t : ℝ) (ht : 1 ≤ t)
    (heven :
      ∀ e : Cn3Torus.Edge n,
        Even (quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄ e)) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quarticCycleMonomial ξ₁.1 hξ₁ ξ₁.2 mu
          * quarticCycleMonomial ξ₂.1 hξ₂ ξ₂.2 mu
          * quarticCycleMonomial ξ₃.1 hξ₃ ξ₃.2 mu
          * quarticCycleMonomial ξ₄.1 hξ₄ ξ₄.2 mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ (gaussianEvenMomentEnvelope 8 ^ 8 / t ^ (8 : Nat)) * gaussianF (dim n) t := by
  have hdeg :
      (∑ e : Cn3Torus.Edge n,
          quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄ e) = 2 * 8 :=
    quarticCycleQuadrupleMultiplicity_total_degree ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄
  have hbound := gaussian_edge_even_coordMonomial_bound
    (quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄)
    8 hdeg heven t ht
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quarticCycleMonomial ξ₁.1 hξ₁ ξ₁.2 mu
          * quarticCycleMonomial ξ₂.1 hξ₂ ξ₂.2 mu
          * quarticCycleMonomial ξ₃.1 hξ₃ ξ₃.2 mu
          * quarticCycleMonomial ξ₄.1 hξ₄ ξ₄.2 mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial
              (quarticCycleQuadrupleMultiplicity ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄) mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              refine MeasureTheory.integral_congr_ae ?_
              exact Filter.Eventually.of_forall (fun mu => by
                simpa [mul_assoc] using
                  congrArg
                    (fun z : ℝ => z * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
                    (quarticCycleQuadrupleMonomial_eq_coordMonomial
                      ξ₁ ξ₂ ξ₃ ξ₄ hξ₁ hξ₂ hξ₃ hξ₄ mu))
    _ ≤ (gaussianEvenMomentEnvelope 8 ^ 8 / t ^ (8 : Nat)) * gaussianF (dim n) t := hbound

private abbrev QuarticCycleChoice (n : ℕ) := ↥(simpleCycle4Indices n)

private abbrev QuarticCycleQuadruple (n : ℕ) :=
  QuarticCycleChoice n × (QuarticCycleChoice n × (QuarticCycleChoice n × QuarticCycleChoice n))

private instance {n : ℕ} : DecidableEq (QuarticCycleChoice n) := by
  classical
  infer_instance

private instance {n : ℕ} : DecidableEq (QuarticCycleQuadruple n) := by
  classical
  infer_instance

private abbrev quarticQuad1 {n : ℕ} (q : QuarticCycleQuadruple n) : QuarticCycleChoice n := q.1
private abbrev quarticQuad2 {n : ℕ} (q : QuarticCycleQuadruple n) : QuarticCycleChoice n := q.2.1
private abbrev quarticQuad3 {n : ℕ} (q : QuarticCycleQuadruple n) : QuarticCycleChoice n := q.2.2.1
private abbrev quarticQuad4 {n : ℕ} (q : QuarticCycleQuadruple n) : QuarticCycleChoice n := q.2.2.2

private lemma quarticChoice_valid {n : ℕ} (ξ : QuarticCycleChoice n) :
    IsSimpleCycle4Index ξ.1.1 := by
  exact (Finset.mem_filter.mp ξ.2).2

private def quarticChoiceMonomial {n : ℕ}
    (ξ : QuarticCycleChoice n) (mu : Cn3Torus.Edge n → ℝ) : ℝ :=
  quarticCycleMonomial ξ.1.1 (quarticChoice_valid ξ) ξ.1.2 mu

private def quarticChoiceSupport {n : ℕ}
    (ξ : QuarticCycleChoice n) : Finset (Cn3Torus.Edge n) :=
  quarticCycleSupport ξ.1.1 (quarticChoice_valid ξ) ξ.1.2

private def quarticChoiceVertices {n : ℕ}
    (ξ : QuarticCycleChoice n) : Finset (Fin n) :=
  quarticVertices ξ.1.1

private def quarticQuadrupleMultiplicity {n : ℕ}
    (q : QuarticCycleQuadruple n) : Cn3Torus.Edge n → ℕ :=
  quarticCycleQuadrupleMultiplicity
    (quarticQuad1 q).1 (quarticQuad2 q).1 (quarticQuad3 q).1 (quarticQuad4 q).1
    (quarticChoice_valid (quarticQuad1 q)) (quarticChoice_valid (quarticQuad2 q))
    (quarticChoice_valid (quarticQuad3 q)) (quarticChoice_valid (quarticQuad4 q))

private def quarticQuadrupleSupport {n : ℕ}
    (q : QuarticCycleQuadruple n) : Finset (Cn3Torus.Edge n) :=
  quarticChoiceSupport (quarticQuad1 q) ∪ quarticChoiceSupport (quarticQuad2 q)
    ∪ quarticChoiceSupport (quarticQuad3 q) ∪ quarticChoiceSupport (quarticQuad4 q)

private def quarticQuadrupleVertices {n : ℕ}
    (q : QuarticCycleQuadruple n) : Finset (Fin n) :=
  quarticChoiceVertices (quarticQuad1 q) ∪ quarticChoiceVertices (quarticQuad2 q)
    ∪ quarticChoiceVertices (quarticQuad3 q) ∪ quarticChoiceVertices (quarticQuad4 q)

private def quarticQuadrupleEven {n : ℕ}
    (q : QuarticCycleQuadruple n) : Prop :=
  ∀ e : Cn3Torus.Edge n, Even (quarticQuadrupleMultiplicity q e)

private def quarticEvenQuadruples (n : ℕ) : Finset (QuarticCycleQuadruple n) :=
  by
    classical
    exact Finset.univ.filter (fun q => quarticQuadrupleEven q)

private def quarticActiveVertexSetsUpToEight (n : ℕ) : Finset (Finset (Fin n)) :=
  (Finset.range 9).biUnion (fun k => Finset.powersetCard k (Finset.univ : Finset (Fin n)))

private def quarticEvenQuadrupleFiber (n : ℕ) (A : Finset (Fin n)) :
    Finset (QuarticCycleQuadruple n) :=
  by
    classical
    exact (quarticEvenQuadruples n).filter (fun q => quarticQuadrupleVertices q = A)

private lemma quarticQuadrupleMultiplicity_total_degree {n : ℕ}
    (q : QuarticCycleQuadruple n) :
    (∑ e : Cn3Torus.Edge n, quarticQuadrupleMultiplicity q e) = 2 * 8 := by
  simpa [quarticQuadrupleMultiplicity] using
    quarticCycleQuadrupleMultiplicity_total_degree
      (quarticQuad1 q).1 (quarticQuad2 q).1 (quarticQuad3 q).1 (quarticQuad4 q).1
      (quarticChoice_valid (quarticQuad1 q)) (quarticChoice_valid (quarticQuad2 q))
      (quarticChoice_valid (quarticQuad3 q)) (quarticChoice_valid (quarticQuad4 q))

private lemma quarticChoiceVertices_card {n : ℕ} (ξ : QuarticCycleChoice n) :
    (quarticChoiceVertices ξ).card = 4 := by
  simpa [quarticChoiceVertices] using quarticVertices_card ξ.1.1 (quarticChoice_valid ξ)

private lemma quarticChoiceSupport_incident_card_eq_two {n : ℕ}
    (ξ : QuarticCycleChoice n) {i : Fin n} (hi : i ∈ quarticChoiceVertices ξ) :
    2 ≤ ((quarticChoiceSupport ξ).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
  simpa [quarticChoiceSupport, quarticChoiceVertices] using
    quarticCycleSupport_incident_card_eq_two ξ.1.1 (quarticChoice_valid ξ) ξ.1.2 hi

private lemma quarticChoiceSupport_subset_quadrupleSupport {n : ℕ}
    (q : QuarticCycleQuadruple n) :
    quarticChoiceSupport (quarticQuad1 q) ⊆ quarticQuadrupleSupport q ∧
      quarticChoiceSupport (quarticQuad2 q) ⊆ quarticQuadrupleSupport q ∧
      quarticChoiceSupport (quarticQuad3 q) ⊆ quarticQuadrupleSupport q ∧
      quarticChoiceSupport (quarticQuad4 q) ⊆ quarticQuadrupleSupport q := by
  constructor
  · intro e he
    simp [quarticQuadrupleSupport, he]
  constructor
  · intro e he
    simp [quarticQuadrupleSupport, he]
  constructor
  · intro e he
    simp [quarticQuadrupleSupport, he]
  · intro e he
    simp [quarticQuadrupleSupport, he]

private lemma quarticChoiceVertices_subset_quadrupleVertices {n : ℕ}
    (q : QuarticCycleQuadruple n) :
    quarticChoiceVertices (quarticQuad1 q) ⊆ quarticQuadrupleVertices q ∧
      quarticChoiceVertices (quarticQuad2 q) ⊆ quarticQuadrupleVertices q ∧
      quarticChoiceVertices (quarticQuad3 q) ⊆ quarticQuadrupleVertices q ∧
      quarticChoiceVertices (quarticQuad4 q) ⊆ quarticQuadrupleVertices q := by
  constructor
  · intro i hi
    simp [quarticQuadrupleVertices, hi]
  constructor
  · intro i hi
    simp [quarticQuadrupleVertices, hi]
  constructor
  · intro i hi
    simp [quarticQuadrupleVertices, hi]
  · intro i hi
    simp [quarticQuadrupleVertices, hi]

private lemma quarticQuadrupleMultiplicity_pos_of_mem_support {n : ℕ}
    (q : QuarticCycleQuadruple n) {e : Cn3Torus.Edge n}
    (he : e ∈ quarticQuadrupleSupport q) :
    0 < quarticQuadrupleMultiplicity q e := by
  rcases (by simpa [quarticQuadrupleSupport] using he) with he₁ | he₂ | he₃ | he₄
  · have hodd :
        Odd (quarticCycleMultiplicity (quarticQuad1 q).1.1
          (quarticChoice_valid (quarticQuad1 q)) (quarticQuad1 q).1.2 e) := by
      simpa [quarticChoiceSupport] using
        quarticCycleMultiplicity_odd_of_mem_support
          (quarticQuad1 q).1.1 (quarticChoice_valid (quarticQuad1 q)) (quarticQuad1 q).1.2 he₁
    rcases hodd with ⟨k, hk⟩
    have hpos :
        0 < quarticCycleMultiplicity (quarticQuad1 q).1.1
          (quarticChoice_valid (quarticQuad1 q)) (quarticQuad1 q).1.2 e := by
      rw [hk]
      omega
    have hle :
        quarticCycleMultiplicity (quarticQuad1 q).1.1
            (quarticChoice_valid (quarticQuad1 q)) (quarticQuad1 q).1.2 e
          ≤ quarticQuadrupleMultiplicity q e := by
      dsimp [quarticQuadrupleMultiplicity, quarticCycleQuadrupleMultiplicity]
      omega
    exact lt_of_lt_of_le hpos hle
  · have hodd :
        Odd (quarticCycleMultiplicity (quarticQuad2 q).1.1
          (quarticChoice_valid (quarticQuad2 q)) (quarticQuad2 q).1.2 e) := by
      simpa [quarticChoiceSupport] using
        quarticCycleMultiplicity_odd_of_mem_support
          (quarticQuad2 q).1.1 (quarticChoice_valid (quarticQuad2 q)) (quarticQuad2 q).1.2 he₂
    rcases hodd with ⟨k, hk⟩
    have hpos :
        0 < quarticCycleMultiplicity (quarticQuad2 q).1.1
          (quarticChoice_valid (quarticQuad2 q)) (quarticQuad2 q).1.2 e := by
      rw [hk]
      omega
    have hle :
        quarticCycleMultiplicity (quarticQuad2 q).1.1
            (quarticChoice_valid (quarticQuad2 q)) (quarticQuad2 q).1.2 e
          ≤ quarticQuadrupleMultiplicity q e := by
      dsimp [quarticQuadrupleMultiplicity, quarticCycleQuadrupleMultiplicity]
      omega
    exact lt_of_lt_of_le hpos hle
  · have hodd :
        Odd (quarticCycleMultiplicity (quarticQuad3 q).1.1
          (quarticChoice_valid (quarticQuad3 q)) (quarticQuad3 q).1.2 e) := by
      simpa [quarticChoiceSupport] using
        quarticCycleMultiplicity_odd_of_mem_support
          (quarticQuad3 q).1.1 (quarticChoice_valid (quarticQuad3 q)) (quarticQuad3 q).1.2 he₃
    rcases hodd with ⟨k, hk⟩
    have hpos :
        0 < quarticCycleMultiplicity (quarticQuad3 q).1.1
          (quarticChoice_valid (quarticQuad3 q)) (quarticQuad3 q).1.2 e := by
      rw [hk]
      omega
    have hle :
        quarticCycleMultiplicity (quarticQuad3 q).1.1
            (quarticChoice_valid (quarticQuad3 q)) (quarticQuad3 q).1.2 e
          ≤ quarticQuadrupleMultiplicity q e := by
      dsimp [quarticQuadrupleMultiplicity, quarticCycleQuadrupleMultiplicity]
      omega
    exact lt_of_lt_of_le hpos hle
  · have hodd :
        Odd (quarticCycleMultiplicity (quarticQuad4 q).1.1
          (quarticChoice_valid (quarticQuad4 q)) (quarticQuad4 q).1.2 e) := by
      simpa [quarticChoiceSupport] using
        quarticCycleMultiplicity_odd_of_mem_support
          (quarticQuad4 q).1.1 (quarticChoice_valid (quarticQuad4 q)) (quarticQuad4 q).1.2 he₄
    rcases hodd with ⟨k, hk⟩
    have hpos :
        0 < quarticCycleMultiplicity (quarticQuad4 q).1.1
          (quarticChoice_valid (quarticQuad4 q)) (quarticQuad4 q).1.2 e := by
      rw [hk]
      omega
    have hle :
        quarticCycleMultiplicity (quarticQuad4 q).1.1
            (quarticChoice_valid (quarticQuad4 q)) (quarticQuad4 q).1.2 e
          ≤ quarticQuadrupleMultiplicity q e := by
      dsimp [quarticQuadrupleMultiplicity, quarticCycleQuadrupleMultiplicity]
      omega
    exact lt_of_lt_of_le hpos hle

private lemma quarticQuadrupleSupport_card_le_eight_of_even {n : ℕ}
    (q : QuarticCycleQuadruple n) (heven : quarticQuadrupleEven q) :
    (quarticQuadrupleSupport q).card ≤ 8 := by
  have hsum :
      (∑ e : Cn3Torus.Edge n, quarticQuadrupleMultiplicity q e) = 16 := by
    simpa using quarticQuadrupleMultiplicity_total_degree q
  have hlower :
      2 * (quarticQuadrupleSupport q).card
        ≤ ∑ e : Cn3Torus.Edge n, quarticQuadrupleMultiplicity q e := by
    calc
      2 * (quarticQuadrupleSupport q).card
          = ∑ e : Cn3Torus.Edge n, if e ∈ quarticQuadrupleSupport q then 2 else 0 := by
              rw [Nat.mul_comm]
              simp
      _ ≤ ∑ e : Cn3Torus.Edge n, quarticQuadrupleMultiplicity q e := by
            refine Finset.sum_le_sum ?_
            intro e he
            by_cases hemem : e ∈ quarticQuadrupleSupport q
            · rcases heven e with ⟨k, hk⟩
              have hpos : 0 < quarticQuadrupleMultiplicity q e :=
                quarticQuadrupleMultiplicity_pos_of_mem_support q hemem
              simp [hemem]
              rw [hk] at hpos ⊢
              omega
            · simp [hemem]
  have : 2 * (quarticQuadrupleSupport q).card ≤ 16 := by simpa [hsum] using hlower
  omega

private lemma quarticQuadruple_incident_card_ge_two_of_mem_vertices {n : ℕ}
