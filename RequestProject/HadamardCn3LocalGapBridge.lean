        (n : ℝ) ^ (3 : Nat) = (n : ℝ) * (n : ℝ) ^ (2 : Nat) := by ring
        _ ≤ (n : ℝ) ^ (2 : Nat) * (n : ℝ) ^ (2 : Nat) := by
              exact mul_le_mul_of_nonneg_right hn_le_sq hnonneg2
        _ = ((n : ℝ) ^ (2 : Nat)) ^ (2 : Nat) := by ring
    have hsqrt := Real.sqrt_le_sqrt hpow_le
    simpa [Real.sqrt_sq_eq_abs, abs_of_nonneg hnonneg2] using hsqrt
  have hA_nonneg : 0 ≤ ∫ x, f x ^ (2 : Nat) ∂μ := by
    exact MeasureTheory.integral_nonneg_of_ae (Filter.Eventually.of_forall (fun x => by
      dsimp [f]
      positivity))
  have hB_nonneg : 0 ≤ ∫ x, g x ^ (2 : Nat) ∂μ := by
    exact MeasureTheory.integral_nonneg_of_ae (Filter.Eventually.of_forall (fun x => by
      dsimp [g]
      positivity))
  have hA_rpow :
      (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
        ≤ ((Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ)) := by
    exact Real.rpow_le_rpow hA_nonneg hA (by norm_num)
  have hB_rpow :
      (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
        ≤ ((Cquin / t ^ (5 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ)) := by
    exact Real.rpow_le_rpow hB_nonneg hB (by norm_num)
  have hA_bound_nonneg :
      0 ≤ ((Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ)) := by
    exact Real.rpow_nonneg (by positivity) _
  have hB_factor_nonneg :
      0 ≤ (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
    exact Real.rpow_nonneg hB_nonneg _
  calc
    ∫ mu in edgeCoreRegion n t,
        |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|
          * Real.exp
            (-2 * t * Cn3Torus.sqNormEdge n mu
              + 4 * t * quarticCorr n (matrixOfEdge n mu))
      = ∫ x, f x * g x ∂μ := by rw [hleft_eq]
    _ ≤ (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
          * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := hcs
    _ ≤ ((Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ))
          * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
            exact mul_le_mul_of_nonneg_right hA_rpow hB_factor_nonneg
    _ ≤ ((Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ))
          * (((Cquin / t ^ (5 : Nat)) * gaussianF (dim n) t)) ^ (1 / (2 : ℝ)) := by
            exact mul_le_mul_of_nonneg_left hB_rpow hA_bound_nonneg
    _ = Real.sqrt (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
          * Real.sqrt (Cquin / t ^ (5 : Nat))
          * gaussianF (dim n) t := by
            rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow]
            calc
              Real.sqrt ((Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * gaussianF (dim n) t)
                  * Real.sqrt ((Cquin / t ^ (5 : Nat)) * gaussianF (dim n) t)
                = (Real.sqrt (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                    * Real.sqrt (gaussianF (dim n) t))
                  * (Real.sqrt (Cquin / t ^ (5 : Nat))
                    * Real.sqrt (gaussianF (dim n) t)) := by
                      rw [Real.sqrt_mul (by positivity), Real.sqrt_mul (by positivity)]
                _ = (Real.sqrt (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                    * Real.sqrt (Cquin / t ^ (5 : Nat)))
                  * (Real.sqrt (gaussianF (dim n) t) * Real.sqrt (gaussianF (dim n) t)) := by
                      ring
                _ = Real.sqrt (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                    * Real.sqrt (Cquin / t ^ (5 : Nat))
                    * gaussianF (dim n) t := by
                      rw [show Real.sqrt (gaussianF (dim n) t) * Real.sqrt (gaussianF (dim n) t)
                              = gaussianF (dim n) t by
                              nlinarith [Real.sq_sqrt hgauss_nonneg]]
    _ ≤ (Real.sqrt Ccub * Real.sqrt Cquin * (n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat))
          * gaussianF (dim n) t := by
            have hn_one' : (1 : ℝ) ≤ (n : ℝ) := by
              exact_mod_cast (Nat.succ_le_of_lt (lt_of_lt_of_le (by omega : 0 < 2) hn))
            have hcoeff :
                Real.sqrt (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                  * Real.sqrt (Cquin / t ^ (5 : Nat))
                  ≤ Real.sqrt Ccub * Real.sqrt Cquin * ((n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat)) := by
              have hA_nonneg' : 0 ≤ Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat) := by positivity
              have hB_nonneg' : 0 ≤ Cquin / t ^ (5 : Nat) := by positivity
              have hu_nonneg : 0 ≤ ((n : ℝ) ^ (3 : Nat) / t ^ (8 : Nat)) := by positivity
              have hrhs_nonneg : 0 ≤ (n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat) := by positivity
              have hsquare :
                  (n : ℝ) ^ (3 : Nat) / t ^ (8 : Nat)
                    ≤ ((n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat)) ^ (2 : Nat) := by
                have hn_pow_le :
                    (n : ℝ) ^ (3 : Nat) ≤ (n : ℝ) ^ (4 : Nat) := by
                  calc
                    (n : ℝ) ^ (3 : Nat) = (n : ℝ) ^ (3 : Nat) * 1 := by ring
                    _ ≤ (n : ℝ) ^ (3 : Nat) * (n : ℝ) := by
                          exact mul_le_mul_of_nonneg_left hn_one' (by positivity)
                    _ = (n : ℝ) ^ (4 : Nat) := by ring
                calc
                  (n : ℝ) ^ (3 : Nat) / t ^ (8 : Nat)
                    = (n : ℝ) ^ (3 : Nat) * (1 / t ^ (8 : Nat)) := by ring
                  _ ≤ (n : ℝ) ^ (4 : Nat) * (1 / t ^ (8 : Nat)) := by
                      exact mul_le_mul_of_nonneg_right hn_pow_le (by positivity)
                  _ = ((n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat)) ^ (2 : Nat) := by
                      field_simp [ht_pos.ne']
                      ring
              have hsqrt_u :
                  Real.sqrt ((n : ℝ) ^ (3 : Nat) / t ^ (8 : Nat))
                    ≤ (n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat) := by
                have hsqrt := Real.sqrt_le_sqrt hsquare
                simpa [Real.sqrt_sq_eq_abs, abs_of_nonneg hrhs_nonneg] using hsqrt
              calc
                Real.sqrt (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                    * Real.sqrt (Cquin / t ^ (5 : Nat))
                  = Real.sqrt ((Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * (Cquin / t ^ (5 : Nat))) := by
                      rw [← Real.sqrt_mul hA_nonneg' (Cquin / t ^ (5 : Nat))]
                _ = Real.sqrt (Ccub * Cquin * ((n : ℝ) ^ (3 : Nat) / t ^ (8 : Nat))) := by
                      field_simp [ht_pos.ne']
                      ring
                _ = Real.sqrt (Ccub * Cquin) * Real.sqrt ((n : ℝ) ^ (3 : Nat) / t ^ (8 : Nat)) := by
                      rw [show Ccub * Cquin * ((n : ℝ) ^ (3 : Nat) / t ^ (8 : Nat))
                          = (Ccub * Cquin) * ((n : ℝ) ^ (3 : Nat) / t ^ (8 : Nat)) by ring]
                      rw [Real.sqrt_mul (by positivity) ((n : ℝ) ^ (3 : Nat) / t ^ (8 : Nat))]
                _ = Real.sqrt Ccub * Real.sqrt Cquin * Real.sqrt ((n : ℝ) ^ (3 : Nat) / t ^ (8 : Nat)) := by
                      rw [Real.sqrt_mul hCcub_pos.le Cquin]
                      ring
                _ ≤ Real.sqrt Ccub * Real.sqrt Cquin * ((n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat)) := by
                      gcongr
                      exact hsqrt_u
            simpa [mul_assoc, mul_left_comm, mul_comm, div_eq_mul_inv] using
              (mul_le_mul_of_nonneg_right hcoeff hgauss_nonneg)

/-- Refined corrected-to-quartic bridge: after exploiting the real-part structure, the
quintic bridge loses only `O(n^6 / t^2)` on the cubic scale. -/
lemma correctedCore_core_integral_re_gap_abs_le_gaussianF_refined :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, 2 ≤ n → ∀ t : ℕ, 1 ≤ t →
        (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat) →
        (8 : ℝ) * ((dim n : ℝ) / (t : ℝ)) ≤ 1 / 2 →
        (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ 1 →
        |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))
            - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))|
          ≤ (C * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat)) * gaussianF (dim n) (t : ℝ) := by
  obtain ⟨Cquin, hCquin_pos, hquin⟩ := quinticP5_sq_quarticWeight_core_bound_uniform
  obtain ⟨Cmix, hCmix_pos, hmix⟩ := cubicT_quinticP5_abs_quarticWeight_core_bound_uniform
  refine ⟨(8 : ℝ) * Cquin + (16 : ℝ) * Cmix, by positivity, ?_⟩
  intro n hn t ht hbox hsmall8 hcube
  let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n (t : ℝ)
  let rem : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Complex.re (correctedCoreIntegrand n t mu) - Complex.re (quarticCoreIntegrand n t mu)
  let upper : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp
        (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
          + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
      * ((8 : ℝ) * (t : ℝ) ^ (2 : Nat) * (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
          + (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
              * |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|)
  let Pterm : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
      * Real.exp
          (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
            + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
  let TPterm : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|
      * Real.exp
          (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
            + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
  have hrem_cont : Continuous rem := by
    have hcorr_re_cont :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Complex.re (correctedCoreIntegrand n t mu)) :=
      Complex.continuous_re.comp (continuous_correctedCoreIntegrand n t)
    have hquart_re_cont :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Complex.re (quarticCoreIntegrand n t mu)) :=
      Complex.continuous_re.comp (continuous_quarticCoreIntegrand n t)
    simpa [rem] using hcorr_re_cont.sub hquart_re_cont
  have hupper_cont : Continuous upper := by
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    have hcub :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
      (continuous_cubicT n).comp (continuous_matrixOfEdge n)
    have hquint :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hquart :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
      (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
    dsimp [upper]
    fun_prop
  have hPterm_cont : Continuous Pterm := by
    have hquint :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    have hquart :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
      (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
    dsimp [Pterm]
    fun_prop
  have hTPterm_cont : Continuous TPterm := by
    have hcub :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
      (continuous_cubicT n).comp (continuous_matrixOfEdge n)
    have hquint :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    have hquart :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
      (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
    dsimp [TPterm]
    fun_prop
  have hrem_int : MeasureTheory.IntegrableOn rem core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hrem_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hupper_int : MeasureTheory.IntegrableOn upper core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hupper_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hPterm_int : MeasureTheory.IntegrableOn Pterm core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hPterm_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hTPterm_int : MeasureTheory.IntegrableOn TPterm core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hTPterm_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hcorr_re_int :
      MeasureTheory.IntegrableOn
        (fun mu : Cn3Torus.Edge n → ℝ => Complex.re (correctedCoreIntegrand n t mu)) core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      ((Complex.continuous_re.comp (continuous_correctedCoreIntegrand n t)).continuousOn.integrableOn_compact
        (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hquart_re_int :
      MeasureTheory.IntegrableOn
        (fun mu : Cn3Torus.Edge n → ℝ => Complex.re (quarticCoreIntegrand n t mu)) core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      ((Complex.continuous_re.comp (continuous_quarticCoreIntegrand n t)).continuousOn.integrableOn_compact
        (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hmono :
      ∀ᵐ mu ∂(MeasureTheory.volume.restrict core), |rem mu| ≤ upper mu := by
    exact Filter.Eventually.of_forall (fun mu => by
      dsimp [rem, upper]
      exact correctedCoreIntegrand_re_sub_quarticCoreIntegrand_abs_le n t mu)
  have hupper_nonneg :
      0 ≤ᵐ[MeasureTheory.volume.restrict core] upper := by
    exact Filter.Eventually.of_forall (fun mu => by
      dsimp [upper]
      positivity)
  have hrem_le :
      ∫ mu in core, |rem mu| ≤ ∫ mu in core, upper mu := by
    exact MeasureTheory.integral_mono_ae hrem_int.norm hupper_int hmono
  have habs :
      |∫ mu in edgeCoreRegion n (t : ℝ), rem mu|
        ≤ ∫ mu in core, |rem mu| := by
    simpa [core] using
      (MeasureTheory.norm_integral_le_integral_norm
        (μ := MeasureTheory.volume.restrict core) (f := rem))
  have hupper_eq :
      ∫ mu in core, upper mu
        = (8 : ℝ) * (t : ℝ) ^ (2 : Nat) *
            ∫ mu in core,
              Pterm mu
          + (16 : ℝ) * (t : ℝ) ^ (2 : Nat) *
            ∫ mu in core,
              TPterm mu := by
    calc
      ∫ mu in core, upper mu
        = ∫ mu in core, ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)) * Pterm mu
            + ((16 : ℝ) * (t : ℝ) ^ (2 : Nat)) * TPterm mu := by
              refine MeasureTheory.integral_congr_ae ?_
              exact Filter.Eventually.of_forall (fun mu => by
                dsimp [upper, Pterm, TPterm]
                ring)
      _ = (∫ mu in core, ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)) * Pterm mu)
            + (∫ mu in core, ((16 : ℝ) * (t : ℝ) ^ (2 : Nat)) * TPterm mu) := by
              simpa using
                (MeasureTheory.integral_add
                  (hPterm_int.const_mul ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)))
                  (hTPterm_int.const_mul ((16 : ℝ) * (t : ℝ) ^ (2 : Nat))))
      _ = (8 : ℝ) * (t : ℝ) ^ (2 : Nat) * ∫ mu in core, Pterm mu
            + (16 : ℝ) * (t : ℝ) ^ (2 : Nat) * ∫ mu in core, TPterm mu := by
              calc
                (∫ mu in core, ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)) * Pterm mu)
                    + (∫ mu in core, ((16 : ℝ) * (t : ℝ) ^ (2 : Nat)) * TPterm mu)
                    = (((8 : ℝ) * (t : ℝ) ^ (2 : Nat)) * ∫ mu in core, Pterm mu)
                        + (((16 : ℝ) * (t : ℝ) ^ (2 : Nat)) * ∫ mu in core, TPterm mu) := by
                          rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
                _ = (8 : ℝ) * (t : ℝ) ^ (2 : Nat) * ∫ mu in core, Pterm mu
                      + (16 : ℝ) * (t : ℝ) ^ (2 : Nat) * ∫ mu in core, TPterm mu := by ring
  have hP :
      (8 : ℝ) * (t : ℝ) ^ (2 : Nat) *
          ∫ mu in core,
            Pterm mu
        ≤ ((8 : ℝ) * Cquin / (t : ℝ) ^ (3 : Nat)) * gaussianF (dim n) (t : ℝ) := by
    have hq := hquin n (t : ℝ) (by exact_mod_cast ht) hbox hsmall8 hcube
    have hconst_nonneg : 0 ≤ (8 : ℝ) * (t : ℝ) ^ (2 : Nat) := by positivity
    have hq' := mul_le_mul_of_nonneg_left hq hconst_nonneg
    calc
      (8 : ℝ) * (t : ℝ) ^ (2 : Nat) *
          ∫ mu in core,
            Pterm mu
        ≤ (8 : ℝ) * (t : ℝ) ^ (2 : Nat) * ((Cquin / (t : ℝ) ^ (5 : Nat)) * gaussianF (dim n) (t : ℝ)) := hq'
      _ = ((8 : ℝ) * Cquin / (t : ℝ) ^ (3 : Nat)) * gaussianF (dim n) (t : ℝ) := by
            have ht_pos : 0 < (t : ℝ) := by exact_mod_cast ht
            field_simp [ht_pos.ne']
  have hTP :
      (16 : ℝ) * (t : ℝ) ^ (2 : Nat) *
          ∫ mu in core,
            TPterm mu
        ≤ ((16 : ℝ) * Cmix * (n : ℝ) ^ (2 : Nat) / (t : ℝ) ^ (2 : Nat)) * gaussianF (dim n) (t : ℝ) := by
    have hm := hmix n hn (t : ℝ) (by exact_mod_cast ht) hbox hsmall8 hcube
    have hconst_nonneg : 0 ≤ (16 : ℝ) * (t : ℝ) ^ (2 : Nat) := by positivity
    have hm' := mul_le_mul_of_nonneg_left hm hconst_nonneg
    calc
      (16 : ℝ) * (t : ℝ) ^ (2 : Nat) *
          ∫ mu in core,
            TPterm mu
        ≤ (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
            * ((Cmix * (n : ℝ) ^ (2 : Nat) / (t : ℝ) ^ (4 : Nat)) * gaussianF (dim n) (t : ℝ)) := hm'
      _ = ((16 : ℝ) * Cmix * (n : ℝ) ^ (2 : Nat) / (t : ℝ) ^ (2 : Nat))
            * gaussianF (dim n) (t : ℝ) := by
            have ht_pos : 0 < (t : ℝ) := by exact_mod_cast ht
            field_simp [ht_pos.ne']
  have hn_one : (1 : ℝ) ≤ (n : ℝ) := by
    have hn_two : (2 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    linarith
  have hpow6_one : (1 : ℝ) ≤ (n : ℝ) ^ (6 : Nat) := by
    calc
      (1 : ℝ) = (1 : ℝ) ^ (6 : Nat) := by norm_num
      _ ≤ (n : ℝ) ^ (6 : Nat) := by
          gcongr
  have hpow2_le : (n : ℝ) ^ (2 : Nat) ≤ (n : ℝ) ^ (6 : Nat) := by
    calc
      (n : ℝ) ^ (2 : Nat) = (n : ℝ) ^ (2 : Nat) * 1 := by ring
      _ ≤ (n : ℝ) ^ (2 : Nat) * (n : ℝ) ^ (4 : Nat) := by
          gcongr
          calc
            (1 : ℝ) = (1 : ℝ) ^ (4 : Nat) := by norm_num
            _ ≤ (n : ℝ) ^ (4 : Nat) := by
                gcongr
      _ = (n : ℝ) ^ (6 : Nat) := by ring
  have ht_inv : 1 / (t : ℝ) ^ (3 : Nat) ≤ 1 / (t : ℝ) ^ (2 : Nat) := by
    have ht_pos : 0 < (t : ℝ) := by exact_mod_cast ht
    have h_inv_le : 1 / (t : ℝ) ≤ 1 := by
      simpa using (one_div_le_one_div_of_le (show (0 : ℝ) < 1 by norm_num) (show (1 : ℝ) ≤ (t : ℝ) by exact_mod_cast ht))
    calc
      1 / (t : ℝ) ^ (3 : Nat) = (1 / (t : ℝ) ^ (2 : Nat)) * (1 / (t : ℝ)) := by
        field_simp [ht_pos.ne']
      _ ≤ (1 / (t : ℝ) ^ (2 : Nat)) * 1 := by
        gcongr
      _ = 1 / (t : ℝ) ^ (2 : Nat) := by ring
  have hpoly :
      ((8 : ℝ) * Cquin / (t : ℝ) ^ (3 : Nat)
          + (16 : ℝ) * Cmix * (n : ℝ) ^ (2 : Nat) / (t : ℝ) ^ (2 : Nat))
        * gaussianF (dim n) (t : ℝ)
        ≤ (((8 : ℝ) * Cquin + (16 : ℝ) * Cmix) * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat))
