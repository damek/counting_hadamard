private lemma cubicT_pow_four_eq_sum_triangleQuadruples (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat)
      = Finset.sum (Finset.univ : Finset (TriangleQuadruple n)) (fun q =>
          triangleChoiceMonomial (triangleQuad1 q) mu
            * triangleChoiceMonomial (triangleQuad2 q) mu
            * triangleChoiceMonomial (triangleQuad3 q) mu
            * triangleChoiceMonomial (triangleQuad4 q) mu) := by
  classical
  let Q : Finset (TriangleQuadruple n) := Finset.univ
  have hsum_eq :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        (∑ ξ : TriangleChoice n, triangleChoiceMonomial ξ mu)
          = cubicT n (matrixOfEdge n mu) := by
    intro mu
    symm
    exact cubicT_matrixOfEdge_eq_sum_triangleChoices n mu
  calc
    (cubicT n (matrixOfEdge n mu)) ^ (4 : Nat)
      = (∑ ξ : TriangleChoice n, triangleChoiceMonomial ξ mu) ^ (4 : Nat) := by
          rw [hsum_eq mu]
    _ = (∑ ξ : TriangleChoice n, triangleChoiceMonomial ξ mu)
          * ((∑ ξ : TriangleChoice n, triangleChoiceMonomial ξ mu)
              * ((∑ ξ : TriangleChoice n, triangleChoiceMonomial ξ mu)
                  * ∑ ξ : TriangleChoice n, triangleChoiceMonomial ξ mu)) := by
            ring
    _ = Finset.sum Q (fun q =>
          triangleChoiceMonomial (triangleQuad1 q) mu
            * triangleChoiceMonomial (triangleQuad2 q) mu
            * triangleChoiceMonomial (triangleQuad3 q) mu
            * triangleChoiceMonomial (triangleQuad4 q) mu) := by
          symm
          dsimp [Q]
          simp_rw [← Finset.univ_product_univ, Finset.sum_product]
          let s : TriangleChoice n → ℝ := fun ξ => triangleChoiceMonomial ξ mu
          have hprod4 :
              (∑ x : TriangleChoice n,
                  ∑ x_1 : TriangleChoice n,
                    ∑ x_2 : TriangleChoice n,
                      ∑ x_3 : TriangleChoice n,
                        s x * (s x_1 * (s x_2 * s x_3)))
                = (∑ ξ : TriangleChoice n, s ξ)
                    * ((∑ ξ : TriangleChoice n, s ξ)
                        * ((∑ ξ : TriangleChoice n, s ξ)
                            * ∑ ξ : TriangleChoice n, s ξ)) := by
            let P : (TriangleChoice n × TriangleChoice n) → ℝ := fun p => s p.1 * s p.2
            have hpair :
                (∑ ξ : TriangleChoice n, s ξ) * ∑ ξ : TriangleChoice n, s ξ
                  = ∑ p : TriangleChoice n × TriangleChoice n, P p := by
              calc
                (∑ ξ : TriangleChoice n, s ξ) * ∑ ξ : TriangleChoice n, s ξ
                  = ∑ x : TriangleChoice n, ∑ y : TriangleChoice n, s x * s y := by
                      simpa using (Fintype.sum_mul_sum (f := s) (g := s))
                _ = ∑ p : TriangleChoice n × TriangleChoice n, P p := by
                      simp_rw [P]
                      rw [← Finset.univ_product_univ, Finset.sum_product]
            have hfour :
                ∑ x : TriangleChoice n,
                    ∑ x_1 : TriangleChoice n,
                      ∑ x_2 : TriangleChoice n,
                        ∑ x_3 : TriangleChoice n,
                          s x * (s x_1 * (s x_2 * s x_3))
                  = ∑ p : TriangleChoice n × TriangleChoice n,
                      ∑ q : TriangleChoice n × TriangleChoice n,
                        P p * P q := by
              simp_rw [P]
              simp_rw [← Finset.univ_product_univ, Finset.sum_product]
              ring
            calc
              ∑ x : TriangleChoice n,
                  ∑ x_1 : TriangleChoice n,
                    ∑ x_2 : TriangleChoice n,
                      ∑ x_3 : TriangleChoice n,
                        s x * (s x_1 * (s x_2 * s x_3))
                = ∑ p : TriangleChoice n × TriangleChoice n,
                    ∑ q : TriangleChoice n × TriangleChoice n, P p * P q := hfour
              _ = (∑ p : TriangleChoice n × TriangleChoice n, P p)
                    * ∑ q : TriangleChoice n × TriangleChoice n, P q := by
                      symm
                      simpa using (Fintype.sum_mul_sum (f := P) (g := P))
              _ = ((∑ ξ : TriangleChoice n, s ξ) * ∑ ξ : TriangleChoice n, s ξ)
                    * ((∑ ξ : TriangleChoice n, s ξ) * ∑ ξ : TriangleChoice n, s ξ) := by
                      simpa using congrArg (fun z : ℝ => z * z) hpair.symm
              _ = (∑ ξ : TriangleChoice n, s ξ)
                    * ((∑ ξ : TriangleChoice n, s ξ)
                        * ((∑ ξ : TriangleChoice n, s ξ)
                            * ∑ ξ : TriangleChoice n, s ξ)) := by
                      ring
          calc
            ∑ x : TriangleChoice n,
                ∑ x_1 : TriangleChoice n,
                  ∑ x_2 : TriangleChoice n,
                    ∑ x_3 : TriangleChoice n,
                      triangleChoiceMonomial (triangleQuad1 (x, x_1, x_2, x_3)) mu
                        * triangleChoiceMonomial (triangleQuad2 (x, x_1, x_2, x_3)) mu
                        * triangleChoiceMonomial (triangleQuad3 (x, x_1, x_2, x_3)) mu
                        * triangleChoiceMonomial (triangleQuad4 (x, x_1, x_2, x_3)) mu
              = ∑ x : TriangleChoice n,
                  ∑ x_1 : TriangleChoice n,
                    ∑ x_2 : TriangleChoice n,
                      ∑ x_3 : TriangleChoice n,
                        s x * (s x_1 * (s x_2 * s x_3)) := by
                          simp [triangleQuad1, triangleQuad2, triangleQuad3, triangleQuad4,
