        = ∫ mu in core,
            |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1| ^ (2 : Nat)
              * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu) := by
    have hEq :
        ∫ x, f x ^ (2 : Nat) ∂μ
          = ∫ x,
              |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) - 1| ^ (2 : Nat)
                * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x) ∂μ := by
      refine MeasureTheory.integral_congr_ae ?_
      exact Filter.Eventually.of_forall (fun x => by
        dsimp [f]
        rw [quartic_gap_weight_sq])
    simpa [μ] using hEq
  have hA :
      ∫ x, f x ^ (2 : Nat) ∂μ ≤ Aexpr := by
    rw [hAeq]
    exact hquarticGap n (t : ℝ) ht_real hdim_c₄ hcube_c₄
  have hBeq :
      ∫ x, g x ^ (2 : Nat) ∂μ
        = (16 * (t : ℝ) ^ (2 : Nat))
            * ∫ mu in core,
                (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
                  * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu) := by
    have hEq :
        ∫ x, g x ^ (2 : Nat) ∂μ
          = ∫ x,
              (16 * (t : ℝ) ^ (2 : Nat))
                * ((quinticP5 n (matrixOfEdge n x)) ^ (2 : Nat)
                    * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x)) ∂μ := by
      refine MeasureTheory.integral_congr_ae ?_
      exact Filter.Eventually.of_forall (fun x => by
        dsimp [g]
        let a := quinticP5 n (matrixOfEdge n x)
        let e := Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)
        have hExp :
            e * e = Real.exp (-(2 * (t : ℝ) * Cn3Torus.sqNormEdge n x)) := by
          dsimp [e]
          rw [← Real.exp_add]
          congr 1
          ring
        have hAbsSq : |a| ^ (2 : Nat) = a ^ (2 : Nat) := by
          simpa [pow_two] using (sq_abs a)
        have hExpSq :
            e ^ (2 : Nat) = Real.exp (-(2 * (t : ℝ) * Cn3Torus.sqNormEdge n x)) := by
          simpa [pow_two] using hExp
        calc
          (((4 : ℝ) * (t : ℝ) * |a|) * e) ^ (2 : Nat)
            = (16 * (t : ℝ) ^ (2 : Nat)) * (|a| ^ (2 : Nat) * e ^ (2 : Nat)) := by
                ring
          _ = (16 * (t : ℝ) ^ (2 : Nat)) * (a ^ (2 : Nat) * Real.exp (-(2 * (t : ℝ) * Cn3Torus.sqNormEdge n x))) := by
                rw [hAbsSq, hExpSq]
          _ = (16 * (t : ℝ) ^ (2 : Nat))
                * ((quinticP5 n (matrixOfEdge n x)) ^ (2 : Nat)
                    * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x)) := by
                simp [a, mul_assoc, mul_left_comm, mul_comm])
    rw [hEq, MeasureTheory.integral_const_mul]
  have hB :
      ∫ x, g x ^ (2 : Nat) ∂μ ≤ Bexpr := by
    have hquintic_core := hquintic n hcore_dim (t : ℝ) ht_real
    have hconst_nonneg : 0 ≤ 16 * (t : ℝ) ^ (2 : Nat) := by positivity
    have hscaled := mul_le_mul_of_nonneg_left hquintic_core hconst_nonneg
    calc
      ∫ x, g x ^ (2 : Nat) ∂μ
        = (16 * (t : ℝ) ^ (2 : Nat))
            * ∫ mu in core,
                (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
                  * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu) := hBeq
      _ ≤ (16 * (t : ℝ) ^ (2 : Nat))
            * ((Cq * (n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (5 : Nat)) * coreMass (dim n) (t : ℝ)) := hscaled
      _ = ((16 : ℝ) * Cq * (n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (3 : Nat))
            * coreMass (dim n) (t : ℝ) := by
            field_simp [ht_pos.ne']
      _ ≤ Bexpr := by
            dsimp [Bexpr, gf]
            gcongr
            exact coreMass_le_gaussianF n (t : ℝ) ht_pos
  have hA_nonneg : 0 ≤ ∫ x, f x ^ (2 : Nat) ∂μ := by
    exact MeasureTheory.integral_nonneg_of_ae (Filter.Eventually.of_forall (fun x => by
      dsimp [f]
      positivity))
  have hB_nonneg : 0 ≤ ∫ x, g x ^ (2 : Nat) ∂μ := by
    exact MeasureTheory.integral_nonneg_of_ae (Filter.Eventually.of_forall (fun x => by
      dsimp [g]
      positivity))
  have hAexpr_nonneg : 0 ≤ Aexpr := by
    dsimp [Aexpr, gf]
    positivity
  have hBexpr_nonneg : 0 ≤ Bexpr := by
    dsimp [Bexpr, gf]
    positivity
  have hA_rpow :
      (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) ≤ Real.sqrt Aexpr := by
    calc
      (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
        ≤ Aexpr ^ (1 / (2 : ℝ)) := by
            exact Real.rpow_le_rpow hA_nonneg hA (by norm_num)
      _ = Real.sqrt Aexpr := by rw [Real.sqrt_eq_rpow]
  have hB_rpow :
      (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) ≤ Real.sqrt Bexpr := by
    calc
      (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
        ≤ Bexpr ^ (1 / (2 : ℝ)) := by
            exact Real.rpow_le_rpow hB_nonneg hB (by norm_num)
      _ = Real.sqrt Bexpr := by rw [Real.sqrt_eq_rpow]
  have hA_factor_nonneg :
      0 ≤ (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
    exact Real.rpow_nonneg hB_nonneg _
  have hB_factor_nonneg : 0 ≤ Real.sqrt Aexpr := by
    exact Real.sqrt_nonneg _
  have hpert_cs :
      ∫ mu in core, |pert mu| ≤ Real.sqrt Aexpr * Real.sqrt Bexpr := by
    calc
      ∫ mu in core, |pert mu| ≤ ∫ mu in core, f mu * g mu := hpert_le
      _ ≤ (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
            * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := hcs
      _ ≤ Real.sqrt Aexpr * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
            exact mul_le_mul_of_nonneg_right hA_rpow hA_factor_nonneg
      _ ≤ Real.sqrt Aexpr * Real.sqrt Bexpr := by
            exact mul_le_mul_of_nonneg_left hB_rpow hB_factor_nonneg
  have hpert_abs :
      |∫ mu in core, pert mu| ≤ Real.sqrt Aexpr * Real.sqrt Bexpr := by
    calc
      |∫ mu in core, pert mu| ≤ ∫ mu in core, |pert mu| := by
            simpa [core, Real.norm_eq_abs] using
              (MeasureTheory.norm_integral_le_integral_norm (μ := μ) (f := pert))
      _ ≤ Real.sqrt Aexpr * Real.sqrt Bexpr := hpert_cs
  have hgeom :
      Real.sqrt Aexpr * Real.sqrt Bexpr ≤ Aexpr + Bexpr := by
    have hs : 0 ≤ (Real.sqrt Aexpr - Real.sqrt Bexpr) ^ (2 : Nat) := by
      exact sq_nonneg (Real.sqrt Aexpr - Real.sqrt Bexpr)
    nlinarith [Real.sq_sqrt hAexpr_nonneg, Real.sq_sqrt hBexpr_nonneg]
  have hA_poly :
      Aexpr ≤ (C₄ * poly) * gf := by
    dsimp [Aexpr]
    have hcoeff : C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ C₄ * poly := by
      exact mul_le_mul_of_nonneg_left hdt_sq_le_poly hC₄_pos.le
    exact mul_le_mul_of_nonneg_right hcoeff hgauss_nonneg
  have hB_poly :
      Bexpr ≤ (((16 : ℝ) * Cq) * poly) * gf := by
    dsimp [Bexpr]
    have hcoeff :
        (16 : ℝ) * Cq * (n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (3 : Nat)
          ≤ ((16 : ℝ) * Cq) * poly := by
      calc
        (16 : ℝ) * Cq * (n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (3 : Nat)
          = ((16 : ℝ) * Cq) * ((n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (3 : Nat)) := by ring
        _ ≤ ((16 : ℝ) * Cq) * poly := by
              exact mul_le_mul_of_nonneg_left hn5_t3_le_poly (by positivity)
    exact mul_le_mul_of_nonneg_right hcoeff hgauss_nonneg
  have hpert_poly :
      |∫ mu in core, pert mu| ≤ (Cpert * poly) * gf := by
    calc
      |∫ mu in core, pert mu| ≤ Real.sqrt Aexpr * Real.sqrt Bexpr := hpert_abs
      _ ≤ Aexpr + Bexpr := hgeom
      _ ≤ (C₄ * poly) * gf + (((16 : ℝ) * Cq) * poly) * gf := by
            exact add_le_add hA_poly hB_poly
      _ = (Cpert * poly) * gf := by
            unfold Cpert
            ring
  calc
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))|
      = |∫ mu in core, rem mu| := hmain_eq
    _ ≤ |∫ mu in core, pure mu| + |∫ mu in core, pert mu| := by
          rw [hsplit_int]
          simpa [Real.norm_eq_abs] using
            (norm_add_le (∫ mu in core, pure mu) (∫ mu in core, pert mu))
    _ ≤ (Cpure * poly) * gf + (Cpert * poly) * gf := by
          exact add_le_add hpure_poly hpert_poly
    _ = (C * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat)) * gaussianF (dim n) (t : ℝ) := by
          unfold C
          dsimp [poly, gf]
          ring

/-- A five-step telescoping chain for absolute differences. -/
private lemma abs_sub_le_sum_abs_sub_five
    (x₀ x₁ x₂ x₃ x₄ x₅ : ℝ) :
    |x₀ - x₅|
      ≤ |x₀ - x₁| + |x₁ - x₂| + |x₂ - x₃| + |x₃ - x₄| + |x₄ - x₅| := by
  have h01 : |x₀ - x₅| ≤ |x₀ - x₁| + |x₁ - x₅| := by
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      (norm_add_le (x₀ - x₁) (x₁ - x₅))
  have h12 : |x₁ - x₅| ≤ |x₁ - x₂| + |x₂ - x₅| := by
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      (norm_add_le (x₁ - x₂) (x₂ - x₅))
  have h23 : |x₂ - x₅| ≤ |x₂ - x₃| + |x₃ - x₅| := by
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      (norm_add_le (x₂ - x₃) (x₃ - x₅))
  have h34 : |x₃ - x₅| ≤ |x₃ - x₄| + |x₄ - x₅| := by
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      (norm_add_le (x₃ - x₄) (x₄ - x₅))
  calc
    |x₀ - x₅| ≤ |x₀ - x₁| + |x₁ - x₅| := h01
    _ ≤ |x₀ - x₁| + (|x₁ - x₂| + |x₂ - x₅|) := by gcongr
    _ ≤ |x₀ - x₁| + (|x₁ - x₂| + (|x₂ - x₃| + |x₃ - x₅|)) := by gcongr
    _ ≤ |x₀ - x₁| + (|x₁ - x₂| + (|x₂ - x₃| + (|x₃ - x₄| + |x₄ - x₅|))) := by gcongr
    _ = |x₀ - x₁| + |x₁ - x₂| + |x₂ - x₃| + |x₃ - x₄| + |x₄ - x₅| := by ring

/-- A six-step telescoping chain for absolute differences. -/
lemma abs_sub_le_sum_abs_sub_six
    (x₀ x₁ x₂ x₃ x₄ x₅ x₆ : ℝ) :
    |x₀ - x₆|
      ≤ |x₀ - x₁| + |x₁ - x₂| + |x₂ - x₃| + |x₃ - x₄| + |x₄ - x₅| + |x₅ - x₆| := by
  have h05 := abs_sub_le_sum_abs_sub_five x₀ x₁ x₂ x₃ x₄ x₅
  have h56 : |x₀ - x₆| ≤ |x₀ - x₅| + |x₅ - x₆| := by
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      (norm_add_le (x₀ - x₅) (x₅ - x₆))
  calc
    |x₀ - x₆| ≤ |x₀ - x₅| + |x₅ - x₆| := h56
    _ ≤ (|x₀ - x₁| + |x₁ - x₂| + |x₂ - x₃| + |x₃ - x₄| + |x₄ - x₅|) + |x₅ - x₆| := by
          gcongr
    _ = |x₀ - x₁| + |x₁ - x₂| + |x₂ - x₃| + |x₃ - x₄| + |x₄ - x₅| + |x₅ - x₆| := by
          ring

/-- Convert the bookkeeping constraint `6 K / ε ≤ C` into the useful bound
`K / C ≤ ε / 6`. -/
lemma div_le_eps_six_of_scaled_bound
    {K C ε : ℝ}
    (hC : 0 < C) (hε : 0 < ε)
    (hscaled : 6 * K / ε ≤ C) :
    K / C ≤ ε / 6 := by
  have hK_le : K ≤ (ε / 6) * C := by
    have hmul : (ε / 6) * (6 * K / ε) ≤ (ε / 6) * C := by
      exact mul_le_mul_of_nonneg_left hscaled (by positivity)
    have hfac : (ε / 6) * (6 * K / ε) = K := by
      field_simp [hε.ne']
    calc
      K = (ε / 6) * (6 * K / ε) := by symm; exact hfac
      _ ≤ (ε / 6) * C := hmul
  exact (div_le_iff₀ hC).2 hK_le


