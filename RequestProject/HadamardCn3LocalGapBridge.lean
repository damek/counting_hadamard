private lemma left_endpoint_mem_quarticVertices_of_edge_eq_any {n : ℕ}
    {u v : Fin n} (huv : u < v) (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ)
    (h :
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = quarticEdge12 σ hσ) ∨
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = quarticEdge13 σ hσ) ∨
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = quarticEdge14 σ hσ) ∨
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = quarticEdge23 σ hσ) ∨
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = quarticEdge24 σ hσ) ∨
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = quarticEdge34 σ hσ)) :
    u ∈ quarticVertices σ := by
  rcases h with h | h | h | h | h | h
  · have hu : u = quarticV1 σ := by
      simpa [quarticEdge12] using congrArg Prod.fst (congrArg Subtype.val h)
    simp [quarticVertices, hu]
  · have hu : u = quarticV1 σ := by
      simpa [quarticEdge13] using congrArg Prod.fst (congrArg Subtype.val h)
    simp [quarticVertices, hu]
  · have hu : u = quarticV1 σ := by
      simpa [quarticEdge14] using congrArg Prod.fst (congrArg Subtype.val h)
    simp [quarticVertices, hu]
  · have hu : u = quarticV2 σ := by
      simpa [quarticEdge23] using congrArg Prod.fst (congrArg Subtype.val h)
    simp [quarticVertices, hu]
  · have hu : u = quarticV2 σ := by
      simpa [quarticEdge24] using congrArg Prod.fst (congrArg Subtype.val h)
    simp [quarticVertices, hu]
  · have hu : u = quarticV3 σ := by
      simpa [quarticEdge34] using congrArg Prod.fst (congrArg Subtype.val h)
    simp [quarticVertices, hu]

private lemma right_endpoint_mem_quarticVertices_of_edge_eq_any {n : ℕ}
