private lemma triangleEvenQuadrupleFiber_card_le_threeSetChoices
    {n : ℕ} (A : Finset (Fin n)) :
    ((triangleEvenQuadrupleFiber n A).card : ℝ)
      ≤ (((Finset.powersetCard 3 A).card : ℝ) ^ (4 : Nat)) := by
  classical
  let ChoiceA := ↥(Finset.powersetCard 3 A)
  let map : triangleEvenQuadrupleFiber n A →
      ChoiceA × (ChoiceA × (ChoiceA × ChoiceA)) := fun q =>
    let hAq : triangleQuadrupleVertices q.1 = A := (Finset.mem_filter.mp q.2).2
    let hmem1 : triangleChoiceVertices (triangleQuad1 q.1) ∈ Finset.powersetCard 3 A := by
      refine Finset.mem_powersetCard.mpr ?_
      refine ⟨?_, ?_⟩
      · intro i hi
        have hqi : i ∈ triangleQuadrupleVertices q.1 := (triangleChoiceVertices_subset_quadrupleVertices q.1).1 hi
        simpa [hAq] using hqi
      · simpa using triangleChoiceVertices_card (triangleQuad1 q.1)
    let hmem2 : triangleChoiceVertices (triangleQuad2 q.1) ∈ Finset.powersetCard 3 A := by
      refine Finset.mem_powersetCard.mpr ?_
      refine ⟨?_, ?_⟩
      · intro i hi
        have hqi : i ∈ triangleQuadrupleVertices q.1 := (triangleChoiceVertices_subset_quadrupleVertices q.1).2.1 hi
        simpa [hAq] using hqi
      · simpa using triangleChoiceVertices_card (triangleQuad2 q.1)
    let hmem3 : triangleChoiceVertices (triangleQuad3 q.1) ∈ Finset.powersetCard 3 A := by
      refine Finset.mem_powersetCard.mpr ?_
      refine ⟨?_, ?_⟩
      · intro i hi
        have hqi : i ∈ triangleQuadrupleVertices q.1 := (triangleChoiceVertices_subset_quadrupleVertices q.1).2.2.1 hi
        simpa [hAq] using hqi
      · simpa using triangleChoiceVertices_card (triangleQuad3 q.1)
    let hmem4 : triangleChoiceVertices (triangleQuad4 q.1) ∈ Finset.powersetCard 3 A := by
      refine Finset.mem_powersetCard.mpr ?_
      refine ⟨?_, ?_⟩
      · intro i hi
        have hqi : i ∈ triangleQuadrupleVertices q.1 := (triangleChoiceVertices_subset_quadrupleVertices q.1).2.2.2 hi
        simpa [hAq] using hqi
      · simpa using triangleChoiceVertices_card (triangleQuad4 q.1)
    (⟨triangleChoiceVertices (triangleQuad1 q.1), hmem1⟩,
      (⟨triangleChoiceVertices (triangleQuad2 q.1), hmem2⟩,
        (⟨triangleChoiceVertices (triangleQuad3 q.1), hmem3⟩,
          ⟨triangleChoiceVertices (triangleQuad4 q.1), hmem4⟩)))
  have hmap_inj : Function.Injective map := by
    intro p q hpq
    apply Subtype.ext
    have h1 : (map p).1 = (map q).1 := by exact congrArg Prod.fst hpq
    have h2 : (map p).2.1 = (map q).2.1 := by exact congrArg (fun z => z.2.1) hpq
    have h3 : (map p).2.2.1 = (map q).2.2.1 := by exact congrArg (fun z => z.2.2.1) hpq
    have h4 : (map p).2.2.2 = (map q).2.2.2 := by exact congrArg (fun z => z.2.2.2) hpq
    have hξ1 : triangleQuad1 p.1 = triangleQuad1 q.1 := by
      have hV1 :
          triangleChoiceVertices (triangleQuad1 p.1) = triangleChoiceVertices (triangleQuad1 q.1) := by
        simpa [map] using congrArg Subtype.val h1
      exact triangleChoice_eq_of_vertices_eq hV1
    have hξ2 : triangleQuad2 p.1 = triangleQuad2 q.1 := by
      have hV2 :
          triangleChoiceVertices (triangleQuad2 p.1) = triangleChoiceVertices (triangleQuad2 q.1) := by
        simpa [map] using congrArg Subtype.val h2
      exact triangleChoice_eq_of_vertices_eq hV2
    have hξ3 : triangleQuad3 p.1 = triangleQuad3 q.1 := by
      have hV3 :
          triangleChoiceVertices (triangleQuad3 p.1) = triangleChoiceVertices (triangleQuad3 q.1) := by
        simpa [map] using congrArg Subtype.val h3
      exact triangleChoice_eq_of_vertices_eq hV3
    have hξ4 : triangleQuad4 p.1 = triangleQuad4 q.1 := by
      have hV4 :
          triangleChoiceVertices (triangleQuad4 p.1) = triangleChoiceVertices (triangleQuad4 q.1) := by
        simpa [map] using congrArg Subtype.val h4
      exact triangleChoice_eq_of_vertices_eq hV4
    exact Prod.ext hξ1 (Prod.ext hξ2 (Prod.ext hξ3 hξ4))
  have hcard :
      (triangleEvenQuadrupleFiber n A).card
        ≤ Fintype.card (ChoiceA × (ChoiceA × (ChoiceA × ChoiceA))) := by
    simpa [Fintype.card_coe] using Fintype.card_le_of_injective map hmap_inj
  have hchoice4 :
      Fintype.card (ChoiceA × (ChoiceA × (ChoiceA × ChoiceA)))
        = (Fintype.card ChoiceA) ^ (4 : Nat) := by
    simp [pow_succ, Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]
  calc
    ((triangleEvenQuadrupleFiber n A).card : ℝ)
      ≤ Fintype.card (ChoiceA × (ChoiceA × (ChoiceA × ChoiceA))) := by exact_mod_cast hcard
    _ = (Fintype.card ChoiceA : ℝ) ^ (4 : Nat) := by
          rw [hchoice4]
          norm_num
    _ = (((Finset.powersetCard 3 A).card : ℝ) ^ (4 : Nat)) := by
          rw [Fintype.card_coe]

private lemma mem_triangleActiveVertexSetsUpToSix_card_le_six {n : ℕ}
    {A : Finset (Fin n)} (hA : A ∈ triangleActiveVertexSetsUpToSix n) :
    A.card ≤ 6 := by
  rw [triangleActiveVertexSetsUpToSix, Finset.mem_biUnion] at hA
  rcases hA with ⟨k, hk, hAk⟩
  have hklt : k < 7 := Finset.mem_range.mp hk
  have hcard : A.card = k := (Finset.mem_powersetCard.mp hAk).2
  omega

private lemma triangleActiveVertexSetsUpToSix_card_le_n_six
    (n : ℕ) (hn : 1 ≤ n) :
    ((triangleActiveVertexSetsUpToSix n).card : ℝ) ≤ 7 * (n : ℝ) ^ (6 : Nat) := by
  have hbi_nat :
      (triangleActiveVertexSetsUpToSix n).card
        ≤ Finset.sum (Finset.range 7)
            (fun k => (Finset.powersetCard k (Finset.univ : Finset (Fin n))).card) := by
    simpa [triangleActiveVertexSetsUpToSix] using
      (Finset.card_biUnion_le
        (s := Finset.range 7)
        (t := fun k => Finset.powersetCard k (Finset.univ : Finset (Fin n))))
  have hbi :
      ((triangleActiveVertexSetsUpToSix n).card : ℝ)
        ≤ Finset.sum (Finset.range 7)
            (fun k => ((Finset.powersetCard k (Finset.univ : Finset (Fin n))).card : ℝ)) := by
    exact_mod_cast hbi_nat
  calc
    ((triangleActiveVertexSetsUpToSix n).card : ℝ)
      ≤ Finset.sum (Finset.range 7)
          (fun k => ((Finset.powersetCard k (Finset.univ : Finset (Fin n))).card : ℝ)) := hbi
    _ ≤ Finset.sum (Finset.range 7) (fun _k => (n : ℝ) ^ (6 : Nat)) := by
          refine Finset.sum_le_sum ?_
          intro k hk
          have hk6 : k ≤ 6 := by
            exact Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
          have hchoose :
              ((Finset.powersetCard k (Finset.univ : Finset (Fin n))).card : ℝ) ≤ (n : ℝ) ^ k := by
            rw [Finset.card_powersetCard]
            simpa using
              (show (((Finset.univ : Finset (Fin n)).card).choose k : ℝ) ≤ (n : ℝ) ^ k by
                simpa using
                  (show ((n.choose k : Nat) : ℝ) ≤ (n : ℝ) ^ k by
                    exact_mod_cast (Nat.choose_le_pow n k)))
          have hpow : (n : ℝ) ^ k ≤ (n : ℝ) ^ (6 : Nat) := by
            exact_mod_cast (Nat.pow_le_pow_right hn hk6)
          exact le_trans hchoose hpow
    _ = 7 * (n : ℝ) ^ (6 : Nat) := by
          rw [Finset.sum_const, nsmul_eq_mul]
          norm_num

private lemma triangleEvenQuadruples_card_le_n_six
    (n : ℕ) (hn : 1 ≤ n) :
    ((triangleEvenQuadruples n).card : ℝ)
      ≤ (7 * (6 : ℝ) ^ (12 : Nat)) * (n : ℝ) ^ (6 : Nat) := by
  have hbi_nat :
      ((triangleActiveVertexSetsUpToSix n).biUnion (triangleEvenQuadrupleFiber n)).card
        ≤ Finset.sum (triangleActiveVertexSetsUpToSix n)
            (fun A => (triangleEvenQuadrupleFiber n A).card) := by
    simpa using
      (Finset.card_biUnion_le
        (s := triangleActiveVertexSetsUpToSix n)
        (t := triangleEvenQuadrupleFiber n))
  have hbi :
      (((triangleActiveVertexSetsUpToSix n).biUnion (triangleEvenQuadrupleFiber n)).card : ℝ)
        ≤ Finset.sum (triangleActiveVertexSetsUpToSix n)
            (fun A => ((triangleEvenQuadrupleFiber n A).card : ℝ)) := by
    exact_mod_cast hbi_nat
  calc
    ((triangleEvenQuadruples n).card : ℝ)
      = (((triangleActiveVertexSetsUpToSix n).biUnion (triangleEvenQuadrupleFiber n)).card : ℝ) := by
          rw [← triangleEvenQuadruples_eq_biUnion_activeFibers]
    _ ≤ Finset.sum (triangleActiveVertexSetsUpToSix n)
          (fun A => ((triangleEvenQuadrupleFiber n A).card : ℝ)) := hbi
    _ ≤ Finset.sum (triangleActiveVertexSetsUpToSix n)
          (fun _A => (6 : ℝ) ^ (12 : Nat)) := by
          refine Finset.sum_le_sum ?_
          intro A hA
          have hAcard : A.card ≤ 6 := mem_triangleActiveVertexSetsUpToSix_card_le_six hA
          have hthree :
              ((Finset.powersetCard 3 A).card : ℝ) ≤ (6 : ℝ) ^ (3 : Nat) := by
            have hbase :
                ((Finset.powersetCard 3 A).card : ℝ) ≤ (A.card : ℝ) ^ (3 : Nat) := by
              rw [Finset.card_powersetCard]
              simpa using
                (show (((A.card).choose 3 : Nat) : ℝ) ≤ (A.card : ℝ) ^ (3 : Nat) by
                  exact_mod_cast (Nat.choose_le_pow A.card 3))
            have hpow : (A.card : ℝ) ^ (3 : Nat) ≤ (6 : ℝ) ^ (3 : Nat) := by
              gcongr
              exact_mod_cast hAcard
            exact le_trans hbase hpow
          calc
            ((triangleEvenQuadrupleFiber n A).card : ℝ)
              ≤ (((Finset.powersetCard 3 A).card : ℝ) ^ (4 : Nat)) :=
                triangleEvenQuadrupleFiber_card_le_threeSetChoices A
            _ ≤ ((6 : ℝ) ^ (3 : Nat)) ^ (4 : Nat) := by
                  exact pow_le_pow_left₀ (by positivity) hthree 4
            _ = (6 : ℝ) ^ (12 : Nat) := by
                  norm_num
    _ = ((triangleActiveVertexSetsUpToSix n).card : ℝ) * (6 : ℝ) ^ (12 : Nat) := by
          rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (7 * (n : ℝ) ^ (6 : Nat)) * (6 : ℝ) ^ (12 : Nat) := by
          refine mul_le_mul_of_nonneg_right (triangleActiveVertexSetsUpToSix_card_le_n_six n hn) ?_
          positivity
    _ = (7 * (6 : ℝ) ^ (12 : Nat)) * (n : ℝ) ^ (6 : Nat) := by
          ring

