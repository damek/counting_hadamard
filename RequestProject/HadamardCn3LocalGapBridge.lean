private theorem corrected_imag_log_uniform :
    ∃ c_im C_im : ℝ, 0 < c_im ∧ 0 < C_im ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      sNorm n lam ≤ c_im →
      ∃ E_im : ℝ, |E_im| ≤ C_im * sNorm n lam ^ 3 ∧
        (Complex.log (psi n lam)).im =
          -(cubicT n lam) + quinticP5 n lam + E_im := by
  obtain ⟨C_R, hCR_pos, hCR⟩ := dl10_local_real_expansion_uniform
  obtain ⟨C_I, hCI_pos, hCI⟩ := dl10_local_imag_expansion_uniform
  obtain ⟨C_I5, hCI5_pos, hCI5⟩ := dl10_local_imag_quintic_expansion_uniform
  obtain ⟨C_T, hCT_pos, hCT⟩ := cubicT_pointwise_bound_uniform
  let A : ℝ := C_R + 1
  let B : ℝ := C_I + C_T
  let M : ℝ := A + B
  let c_im : ℝ := min 1 (1 / (2 * M))
  let C_im : ℝ := M ^ 3 + C_I5 + C_I / 2 + C_R * B
  refine ⟨c_im, C_im, by
    unfold c_im M A B
    positivity, by
    unfold C_im M A B
    positivity, fun n lam hlam => ?_⟩
  set s : ℝ := sNorm n lam
  set μ5 : ℝ := momentX n lam 5
  set a : ℝ := (psi n lam).re - 1
  set b : ℝ := (psi n lam).im
  set z : ℂ := psi n lam - 1
  have hA_pos : 0 < A := by
    unfold A
    positivity
  have hB_nonneg : 0 ≤ B := by
    unfold B
    positivity
  have hM_pos : 0 < M := by
    unfold M
    positivity
  have hs_nonneg : 0 ≤ s := by
    simpa [s] using sNorm_nonneg n lam
  have hs_one : s ≤ 1 := by
    exact le_trans hlam (min_le_left _ _)
  have hs_sq_le_s : s ^ 2 ≤ s := by
    simpa using pow_le_pow_of_le_one hs_nonneg hs_one (by norm_num : 1 ≤ 2)
  have hs_le_half_rpow : s ≤ s ^ (1 / 2 : ℝ) := by
    simpa using Real.self_le_rpow_of_le_one hs_nonneg hs_one (by norm_num : (1 / 2 : ℝ) ≤ 1)
  have hs_half_le_one : s ^ (1 / 2 : ℝ) ≤ 1 := by
    exact Real.rpow_le_one hs_nonneg hs_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
  have hs_sq_le_three_halves : s ^ 2 ≤ s ^ (3 / 2 : ℝ) := by
    rw [show (3 / 2 : ℝ) = 1 + 1 / 2 by norm_num,
      Real.rpow_add_of_nonneg hs_nonneg (by norm_num) (by norm_num), Real.rpow_one]
    nlinarith [hs_le_half_rpow, hs_nonneg]
  have hs_three_halves_le_s : s ^ (3 / 2 : ℝ) ≤ s := by
    rw [show (3 / 2 : ℝ) = 1 + 1 / 2 by norm_num,
      Real.rpow_add_of_nonneg hs_nonneg (by norm_num) (by norm_num), Real.rpow_one]
    nlinarith [hs_half_le_one, hs_nonneg]
  have hδa :
      |a + s / 2| ≤ C_R * s ^ 2 := by
    dsimp [a, s]
    convert hCR n lam hs_one using 1 <;> ring_nf
  set δa : ℝ := a + s / 2
  have hδa_bound : |δa| ≤ C_R * s ^ 2 := by
    simpa [δa] using hδa
  have ha_eq : a = δa - s / 2 := by
    dsimp [δa]
    ring
  have ha_bound : |a| ≤ A * s := by
    have htri : |a| ≤ |δa| + |s / 2| := by
      rw [ha_eq]
      simpa using abs_sub δa (s / 2)
    unfold A
    have hs_div_nonneg : 0 ≤ s / 2 := by positivity
    rw [abs_of_nonneg hs_div_nonneg] at htri
    calc
      |a| ≤ C_R * s ^ 2 + s / 2 := by nlinarith [htri, hδa_bound]
      _ ≤ C_R * s + s / 2 := by gcongr
      _ ≤ A * s := by nlinarith [hs_nonneg]
  have hb_aux : |b| ≤ C_I * s ^ 2 + C_T * s ^ (3 / 2 : ℝ) := by
    have htri : |b| ≤ |b + cubicT n lam| + |cubicT n lam| := by
      dsimp [b]
      simpa using abs_sub ((psi n lam).im + cubicT n lam) (cubicT n lam)
    have hmain : |(psi n lam).im + cubicT n lam| ≤ C_I * s ^ 2 := by
      simpa [b, s] using hCI n lam hs_one
    have hT : |cubicT n lam| ≤ C_T * s ^ (3 / 2 : ℝ) := by
      simpa [s] using hCT n lam
    nlinarith
  have hb_bound : |b| ≤ B * s ^ (3 / 2 : ℝ) := by
    unfold B
    nlinarith [hb_aux, hs_sq_le_three_halves, hs_nonneg]
  have hb_linear : |b| ≤ B * s := by
    calc
      |b| ≤ B * s ^ (3 / 2 : ℝ) := hb_bound
      _ ≤ B * s := by gcongr
  have hz_decomp : z = a + Complex.I * b := by
    apply Complex.ext <;> simp [z, a, b]
  have hz_bound : ‖z‖ ≤ M * s := by
    rw [hz_decomp]
    calc
      ‖(a : ℂ) + Complex.I * b‖ ≤ ‖(a : ℂ)‖ + ‖Complex.I * b‖ := norm_add_le _ _
      _ = |a| + |b| := by simp [Complex.norm_real]
      _ ≤ A * s + B * s := by gcongr
      _ = M * s := by
            unfold M
            ring
  have hsM : s ≤ 1 / (2 * M) := by
    exact le_trans hlam (min_le_right _ _)
  have hz_half : ‖z‖ ≤ 1 / 2 := by
    have hsM_half : M * s ≤ 1 / 2 := by
      have hmul := mul_le_mul_of_nonneg_left hsM hM_pos.le
      have hcalc : M * (1 / (2 * M)) = 1 / 2 := by
        field_simp [hM_pos.ne']
      exact hmul.trans_eq hcalc
    exact le_trans hz_bound hsM_half
  have hz_cube : ‖z‖ ^ 3 ≤ M ^ 3 * s ^ 3 := by
    calc
      ‖z‖ ^ 3 ≤ (M * s) ^ 3 := by
        exact pow_le_pow_left₀ (norm_nonneg z) hz_bound 3
      _ = M ^ 3 * s ^ 3 := by ring
  have hlog_taylor :
      ‖Complex.log (psi n lam) - z + z ^ 2 / 2‖ ≤ M ^ 3 * s ^ 3 := by
    have hz_eq : 1 + z = psi n lam := by
      simp [z]
    have h : ‖Complex.log (psi n lam) - z + z ^ 2 / 2‖ ≤ ‖z‖ ^ 3 := by
      simpa [hz_eq] using complex_log_approx_quadratic z hz_half
    exact le_trans h hz_cube
  have himag_remainder :
      |(Complex.log (psi n lam)).im - (b - a * b)| ≤ M ^ 3 * s ^ 3 := by
    have htmp : |(Complex.log (psi n lam) - z + z ^ 2 / 2).im| ≤ M ^ 3 * s ^ 3 := by
      exact le_trans (complex_im_abs_le_norm _) hlog_taylor
    rw [hz_decomp] at htmp
    have htmp' := htmp
    ring_nf at htmp'
    norm_num [pow_two] at htmp'
    simpa [pow_two, div_eq_mul_inv, sub_eq_add_neg, add_assoc, add_left_comm, add_comm,
      mul_assoc, mul_left_comm, mul_comm] using htmp'
  have hδb :
      |b + cubicT n lam - μ5 / 120| ≤ C_I5 * s ^ 3 := by
    dsimp [b, μ5, s]
    simpa using hCI5 n lam hs_one
  set δb : ℝ := b + cubicT n lam - μ5 / 120
  have hδb_bound : |δb| ≤ C_I5 * s ^ 3 := by
    simpa [δb] using hδb
  have hquintic : quinticP5 n lam = μ5 / 120 - s * cubicT n lam / 2 := by
    rw [quinticP5, momentX_three_eq_six_cubicT n lam, momentX_two_eq_sNorm n lam]
    dsimp [μ5, s]
    ring
  have hab_shift :
      |a * b - s * cubicT n lam / 2| ≤ (C_I / 2 + C_R * B) * s ^ 3 := by
    have hdecomp :
        a * b - s * cubicT n lam / 2 = δa * b - (s / 2) * (b + cubicT n lam) := by
      rw [ha_eq]
      dsimp [δa]
      ring
    rw [hdecomp]
    have hδab : |δa * b| ≤ C_R * B * s ^ 3 := by
      calc
        |δa * b| = |δa| * |b| := by rw [abs_mul]
        _ ≤ (C_R * s ^ 2) * (B * s) := by gcongr
        _ = C_R * B * s ^ 3 := by ring
    have hs_term : |(s / 2) * (b + cubicT n lam)| ≤ C_I / 2 * s ^ 3 := by
      have hsum : |b + cubicT n lam| ≤ C_I * s ^ 2 := by
        simpa [b, s] using hCI n lam hs_one
      calc
        |(s / 2) * (b + cubicT n lam)| = (s / 2) * |b + cubicT n lam| := by
          rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ s / 2)]
        _ ≤ (s / 2) * (C_I * s ^ 2) := by gcongr
        _ = C_I / 2 * s ^ 3 := by ring
    calc
      |δa * b - (s / 2) * (b + cubicT n lam)| ≤ |δa * b| + |(s / 2) * (b + cubicT n lam)| := by
        simpa using abs_sub (δa * b) ((s / 2) * (b + cubicT n lam))
      _ ≤ C_R * B * s ^ 3 + C_I / 2 * s ^ 3 := by
        gcongr
      _ = (C_I / 2 + C_R * B) * s ^ 3 := by ring
  have happrox :
      |(b - a * b) - (-(cubicT n lam) + quinticP5 n lam)| ≤
        (C_I5 + C_I / 2 + C_R * B) * s ^ 3 := by
    have hdecomp :
        (b - a * b) - (-(cubicT n lam) + quinticP5 n lam) =
          δb - (a * b - s * cubicT n lam / 2) := by
      rw [hquintic]
      dsimp [δb]
      ring
    rw [hdecomp]
    calc
      |δb - (a * b - s * cubicT n lam / 2)| ≤ |δb| + |a * b - s * cubicT n lam / 2| := by
        simpa using abs_sub δb (a * b - s * cubicT n lam / 2)
      _ ≤ C_I5 * s ^ 3 + (C_I / 2 + C_R * B) * s ^ 3 := by
        gcongr
      _ = (C_I5 + C_I / 2 + C_R * B) * s ^ 3 := by ring
  refine ⟨(Complex.log (psi n lam)).im - (-(cubicT n lam) + quinticP5 n lam), ?_, ?_⟩
  · unfold C_im
    set y : ℝ := (b - a * b) - (-(cubicT n lam) + quinticP5 n lam)
    have hy_eq :
        (Complex.log (psi n lam)).im - (-(cubicT n lam) + quinticP5 n lam) =
          ((Complex.log (psi n lam)).im - (b - a * b)) + y := by
      dsimp [y]
      ring
    have hy_bound : |y| ≤ (C_I5 + C_I / 2 + C_R * B) * s ^ 3 := by
      simpa [y] using happrox
    calc
      |(Complex.log (psi n lam)).im - (-(cubicT n lam) + quinticP5 n lam)| =
          |((Complex.log (psi n lam)).im - (b - a * b)) + y| := by
            rw [hy_eq]
      _ ≤ |(Complex.log (psi n lam)).im - (b - a * b)| + |y| := by
            have := abs_sub ((Complex.log (psi n lam)).im - (b - a * b)) (-y)
            simpa [sub_eq_add_neg, add_assoc] using this
      _ ≤ M ^ 3 * s ^ 3 + (C_I5 + C_I / 2 + C_R * B) * s ^ 3 := by
            gcongr
      _ = C_im * s ^ 3 := by
            unfold C_im
            ring
  · simp [s]

private theorem corrected_sixth_order_normal_form_uniform :
    ∃ c₂ C₂ : ℝ, 0 < c₂ ∧ 0 < C₂ ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      sNorm n lam ≤ c₂ →
      ∃ E₆ : ℂ, ‖E₆‖ ≤ C₂ * sNorm n lam ^ 3 ∧
        Complex.log (psi n lam) =
          -(sNorm n lam / 2 : ℝ) - Complex.I * ↑(cubicT n lam) +
          ↑(quarticCorr n lam) + Complex.I * ↑(quinticP5 n lam) + E₆ := by
  obtain ⟨c_rl, C_rl, hc_rl_pos, hC_rl_pos, hrl⟩ := corrected_real_log_uniform
  obtain ⟨c_im, C_im, hc_im_pos, hC_im_pos, him⟩ := corrected_imag_log_uniform
  let c₂ : ℝ := min c_rl c_im
  let C₂ : ℝ := C_rl + C_im + 1
  refine ⟨c₂, C₂, by
    unfold c₂
    exact lt_min hc_rl_pos hc_im_pos, by
    unfold C₂
    positivity, fun n lam hlam => ?_⟩
  obtain ⟨E_rl, hE_rl_bound, hE_rl_eq⟩ := hrl n lam (le_trans hlam (min_le_left _ _))
  obtain ⟨E_im, hE_im_bound, hE_im_eq⟩ := him n lam (le_trans hlam (min_le_right _ _))
  let E₆ : ℂ := E_rl + Complex.I * E_im
  refine ⟨E₆, ?_, ?_⟩
  · unfold C₂
    calc
      ‖E₆‖ ≤ ‖(E_rl : ℂ)‖ + ‖Complex.I * E_im‖ := by
              unfold E₆
              exact norm_add_le _ _
      _ = |E_rl| + |E_im| := by simp [Complex.norm_real]
      _ ≤ C_rl * sNorm n lam ^ 3 + C_im * sNorm n lam ^ 3 := by
              gcongr
      _ ≤ (C_rl + C_im + 1) * sNorm n lam ^ 3 := by
              have hs_nonneg : 0 ≤ sNorm n lam ^ 3 := by
                exact pow_nonneg (sNorm_nonneg n lam) 3
              nlinarith
  · apply Complex.ext
    · rw [hE_rl_eq]
      simp [E₆]
    · rw [hE_im_eq]
      simp [E₆]

private lemma psi_re_pos_uniform :
    ∃ c : ℝ, 0 < c ∧ ∀ n : ℕ, ∀ lam : Fin n → Fin n → ℝ,
      sNorm n lam ≤ c → 0 < (psi n lam).re := by
  obtain ⟨C_R, hCR_pos, hCR⟩ := dl10_local_real_expansion_uniform
  let c : ℝ := min 1 (1 / (2 * C_R + 1))
  refine ⟨c, by
    unfold c
    exact lt_min zero_lt_one (by positivity), ?_⟩
  intro n lam hlam
  have hs_nonneg : 0 ≤ sNorm n lam := sNorm_nonneg n lam
  have hs_one : sNorm n lam ≤ 1 := by
    exact le_trans hlam (min_le_left _ _)
  have hs_sq_le_s : sNorm n lam ^ 2 ≤ sNorm n lam := by
    simpa using pow_le_pow_of_le_one hs_nonneg hs_one (by norm_num : 1 ≤ 2)
  have hs_small : sNorm n lam ≤ 1 / (2 * C_R + 1) := by
    exact le_trans hlam (min_le_right _ _)
  have hmain : |(psi n lam).re - (1 - sNorm n lam / 2)| ≤ C_R * sNorm n lam ^ 2 := by
    exact hCR n lam hs_one
  have hbound : sNorm n lam / 2 + C_R * sNorm n lam ^ 2 ≤ 1 / 2 := by
    have hlin : sNorm n lam / 2 + C_R * sNorm n lam ≤ 1 / 2 := by
      have hmul :
          (2 * C_R + 1) * sNorm n lam ≤ (2 * C_R + 1) * (1 / (2 * C_R + 1)) := by
        exact mul_le_mul_of_nonneg_left hs_small (by positivity : 0 ≤ 2 * C_R + 1)
      have hcancel : (2 * C_R + 1) * (1 / (2 * C_R + 1)) = 1 := by
        field_simp
      nlinarith [hmul]
    have hstep : sNorm n lam / 2 + C_R * sNorm n lam ^ 2 ≤ sNorm n lam / 2 + C_R * sNorm n lam := by
      gcongr
    exact le_trans hstep hlin
  have hlow := (abs_le.mp hmain).1
  linarith

private theorem corrected_sixth_order_exp_form_edge_uniform :
    ∃ c₂ C₂ : ℝ, 0 < c₂ ∧ 0 < C₂ ∧ ∀ n : ℕ, ∀ mu : Cn3Torus.Edge n → ℝ,
      Cn3Torus.sqNormEdge n mu ≤ c₂ →
      ∃ E₆ : ℂ, ‖E₆‖ ≤ C₂ * Cn3Torus.sqNormEdge n mu ^ 3 ∧
        Cn3Torus.psi n mu = Complex.exp
          (((( -(Cn3Torus.sqNormEdge n mu / 2 : ℝ)) : ℂ)
              - Complex.I * (cubicT n (matrixOfEdge n mu) : ℂ)
              + (quarticCorr n (matrixOfEdge n mu) : ℂ)
              + Complex.I * (quinticP5 n (matrixOfEdge n mu) : ℂ)) + E₆) := by
  obtain ⟨c₂, C₂, hc₂_pos, hC₂_pos, hmain⟩ := corrected_sixth_order_normal_form_uniform
  obtain ⟨c_pos, hc_pos, hpos⟩ := psi_re_pos_uniform
  let c : ℝ := min c₂ c_pos
  refine ⟨c, C₂, lt_min hc₂_pos hc_pos, hC₂_pos, ?_⟩
  intro n mu hmu
  have hs_small : sNorm n (matrixOfEdge n mu) ≤ c := by
    simpa [sNorm_matrixOfEdge_eq] using hmu
  have hs_norm : sNorm n (matrixOfEdge n mu) ≤ c₂ := le_trans hs_small (min_le_left _ _)
  have hs_pos : sNorm n (matrixOfEdge n mu) ≤ c_pos := le_trans hs_small (min_le_right _ _)
  have hre_pos : 0 < (psi n (matrixOfEdge n mu)).re := hpos n (matrixOfEdge n mu) hs_pos
  have hpsi_ne : psi n (matrixOfEdge n mu) ≠ 0 := by
    intro hzero
    rw [hzero] at hre_pos
    simpa using hre_pos
  obtain ⟨E₆, hE₆_bound, hlog_eq⟩ := hmain n (matrixOfEdge n mu) hs_norm
  refine ⟨E₆, ?_, ?_⟩
  · simpa [sNorm_matrixOfEdge_eq] using hE₆_bound
  · calc
      Cn3Torus.psi n mu = psi n (matrixOfEdge n mu) := by
          simpa [psi_matrixOfEdge_eq]
      _ = Complex.exp (Complex.log (psi n (matrixOfEdge n mu))) := by
          symm
          simpa using (Complex.exp_log hpsi_ne)
      _ = Complex.exp
            (((( -(Cn3Torus.sqNormEdge n mu / 2 : ℝ)) : ℂ)
                - Complex.I * (cubicT n (matrixOfEdge n mu) : ℂ)
                + (quarticCorr n (matrixOfEdge n mu) : ℂ)
                + Complex.I * (quinticP5 n (matrixOfEdge n mu) : ℂ)) + E₆) := by
            rw [hlog_eq]
            simp [sNorm_matrixOfEdge_eq]

theorem psi_pow_sub_correctedCoreIntegrand_norm_le_uniform :
    ∃ c₂ C₂ : ℝ, 0 < c₂ ∧ 0 < C₂ ∧ ∀ n : ℕ, ∀ t : ℕ, ∀ mu : Cn3Torus.Edge n → ℝ,
      Cn3Torus.sqNormEdge n mu ≤ c₂ →
      4 * (t : ℝ) * C₂ * Cn3Torus.sqNormEdge n mu ^ 3 ≤ 1 →
      ‖Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu‖
        ≤ (8 * (t : ℝ) * C₂ * Cn3Torus.sqNormEdge n mu ^ 3)
            * Real.exp
                (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                  + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
  obtain ⟨c₂, C₂, hc₂_pos, hC₂_pos, hmodel⟩ := corrected_sixth_order_exp_form_edge_uniform
  refine ⟨c₂, C₂, hc₂_pos, hC₂_pos, ?_⟩
  intro n t mu hmu hsmall
  obtain ⟨E₆, hE₆_bound, hpsi⟩ := hmodel n mu hmu
  have hpow :
      Cn3Torus.psi n mu ^ (4 * t)
        = correctedCoreIntegrand n t mu * Complex.exp ((((4 * t : ℕ) : ℂ) * E₆)) := by
    calc
      Cn3Torus.psi n mu ^ (4 * t)
          = Complex.exp (correctedCoreExponent n mu + E₆) ^ (4 * t) := by
              rw [hpsi]
              congr 1
              simp [correctedCoreExponent, sub_eq_add_neg, div_eq_mul_inv]
      _ = Complex.exp ((((4 * t : ℕ) : ℂ) * (correctedCoreExponent n mu + E₆))) := by
            symm
            exact Complex.exp_nat_mul (correctedCoreExponent n mu + E₆) (4 * t)
      _ = Complex.exp
            ((((4 * t : ℕ) : ℂ) * correctedCoreExponent n mu)
              + (((4 * t : ℕ) : ℂ) * E₆)) := by
            congr 1
            ring
      _ = Complex.exp ((((4 * t : ℕ) : ℂ) * correctedCoreExponent n mu))
            * Complex.exp ((((4 * t : ℕ) : ℂ) * E₆)) := by
            rw [Complex.exp_add]
      _ = correctedCoreIntegrand n t mu * Complex.exp ((((4 * t : ℕ) : ℂ) * E₆)) := by
            rfl
  have harg_norm :
      ‖(((4 * t : ℕ) : ℂ) * E₆)‖ ≤ 1 := by
    have hstep :
        ‖(((4 * t : ℕ) : ℂ) * E₆)‖
          ≤ (4 * (t : ℝ)) * (C₂ * Cn3Torus.sqNormEdge n mu ^ 3) := by
      rw [norm_mul]
      simpa [mul_assoc, mul_left_comm, mul_comm] using
        mul_le_mul_of_nonneg_left hE₆_bound (by positivity : 0 ≤ (4 * (t : ℝ)))
    exact le_trans hstep (by
      simpa [mul_assoc, mul_left_comm, mul_comm] using hsmall)
  have hsub_one :
      ‖Complex.exp ((((4 * t : ℕ) : ℂ) * E₆)) - 1‖
        ≤ 2 * ‖(((4 * t : ℕ) : ℂ) * E₆)‖ := by
    exact Complex.norm_exp_sub_one_le harg_norm
  have hsub :
      Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu
        = correctedCoreIntegrand n t mu
            * (Complex.exp ((((4 * t : ℕ) : ℂ) * E₆)) - 1) := by
    rw [hpow]
    ring
  have harg_bound :
      ‖(((4 * t : ℕ) : ℂ) * E₆)‖
        ≤ (4 * (t : ℝ)) * (C₂ * Cn3Torus.sqNormEdge n mu ^ 3) := by
    rw [norm_mul]
    simpa [mul_assoc, mul_left_comm, mul_comm] using
      mul_le_mul_of_nonneg_left hE₆_bound (by positivity : 0 ≤ (4 * (t : ℝ)))
  calc
    ‖Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu‖
      = ‖correctedCoreIntegrand n t mu
          * (Complex.exp ((((4 * t : ℕ) : ℂ) * E₆)) - 1)‖ := by
            rw [hsub]
    _ = ‖correctedCoreIntegrand n t mu‖
          * ‖Complex.exp ((((4 * t : ℕ) : ℂ) * E₆)) - 1‖ := by
            rw [norm_mul]
    _ ≤ ‖correctedCoreIntegrand n t mu‖ * (2 * ‖(((4 * t : ℕ) : ℂ) * E₆)‖) := by
          gcongr
    _ ≤ ‖correctedCoreIntegrand n t mu‖
          * (2 * ((4 * (t : ℝ)) * (C₂ * Cn3Torus.sqNormEdge n mu ^ 3))) := by
            gcongr
    _ = (8 * (t : ℝ) * C₂ * Cn3Torus.sqNormEdge n mu ^ 3)
          * Real.exp
              (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
          rw [correctedCoreIntegrand_norm]
          ring

/-- Uniform pointwise bridge 1 on the Gaussian core. -/
private lemma repaired_step1_pointwise_uniform :
    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧
      ∀ n : ℕ, ∀ t : ℕ, 1 ≤ t →
      ∀ mu : Cn3Torus.Edge n → ℝ,
        mu ∈ edgeCoreRegion n (t : ℝ) →
        (dim n : ℝ) / (t : ℝ) ≤ c →
        ((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat) ≤ c →
        ‖Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu‖
          ≤ (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
              * Real.exp
                  (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                    + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
  obtain ⟨c₂, C₂, hc₂_pos, hC₂_pos, hpoint⟩ := psi_pow_sub_correctedCoreIntegrand_norm_le_uniform
  let c : ℝ := min c₂ (1 / (4 * C₂))
  let C : ℝ := 8 * C₂
  have hc_le_c₂ : c ≤ c₂ := by
    unfold c
    exact min_le_left _ _
  have hc_le_inv : c ≤ 1 / (4 * C₂) := by
    unfold c
    exact min_le_right _ _
  refine ⟨c, C, lt_min hc₂_pos (one_div_pos.mpr (by positivity)), by
    unfold C
    positivity, ?_⟩
  intro n t ht mu hmu hdt hd3
  have ht_pos : (0 : ℝ) < (t : ℝ) := by
    exact_mod_cast (Nat.succ_le_iff.mp ht)
  have hsq_core : Cn3Torus.sqNormEdge n mu ≤ (dim n : ℝ) / (t : ℝ) :=
    (mem_edgeCoreRegion_iff n (t : ℝ) mu).1 hmu
  have hs_small : Cn3Torus.sqNormEdge n mu ≤ c₂ := le_trans hsq_core (le_trans hdt hc_le_c₂)
  have hsq_cube :
      Cn3Torus.sqNormEdge n mu ^ (3 : Nat)
        ≤ ((dim n : ℝ) / (t : ℝ)) ^ (3 : Nat) := by
    exact pow_le_pow_left₀ (Cn3Torus.sqNormEdge_nonneg n mu) hsq_core 3
  have hsmall :
      4 * (t : ℝ) * C₂ * Cn3Torus.sqNormEdge n mu ^ (3 : Nat) ≤ 1 := by
    have hmul :
        4 * (t : ℝ) * C₂ * Cn3Torus.sqNormEdge n mu ^ (3 : Nat)
          ≤ 4 * C₂ * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat) := by
      calc
        4 * (t : ℝ) * C₂ * Cn3Torus.sqNormEdge n mu ^ (3 : Nat)
            ≤ 4 * (t : ℝ) * C₂ * (((dim n : ℝ) / (t : ℝ)) ^ (3 : Nat)) := by
              gcongr
        _ = 4 * C₂ * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat) := by
              field_simp [ht_pos.ne']
    have htarget : 4 * C₂ * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat) ≤ 1 := by
      have hsmall' :
          (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat) ≤ 1 / (4 * C₂) := by
        exact le_trans hd3 hc_le_inv
      have hconst_pos : 0 < 4 * C₂ := by positivity
      have hmul' :
          (4 * C₂) * ((dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
            ≤ (4 * C₂) * (1 / (4 * C₂)) := by
        exact mul_le_mul_of_nonneg_left hsmall' hconst_pos.le
      calc
        4 * C₂ * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat)
            = (4 * C₂) * ((dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat)) := by ring
        _ ≤ (4 * C₂) * (1 / (4 * C₂)) := hmul'
        _ = 1 := by
              field_simp [hC₂_pos.ne']
    exact le_trans hmul htarget
  have hpoint' := hpoint n t mu hs_small hsmall
  calc
    ‖Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu‖
      ≤ (8 * (t : ℝ) * C₂ * Cn3Torus.sqNormEdge n mu ^ (3 : Nat))
          * Real.exp
              (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
            simpa using hpoint'
    _ ≤ (8 * (t : ℝ) * C₂ * (((dim n : ℝ) / (t : ℝ)) ^ (3 : Nat)))
          * Real.exp
              (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
            gcongr
    _ = ((8 * C₂) * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
          * Real.exp
              (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
            field_simp [ht_pos.ne']
    _ = (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
          * Real.exp
              (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
            simp [C]

/-- Real exponential perturbations satisfy a quadratic Lipschitz bound with one
exponential loss. -/
private lemma exp_sub_one_sq_le (u : ℝ) :
    |Real.exp u - 1| ^ (2 : Nat) ≤ 2 * u ^ (2 : Nat) * (1 + Real.exp (2 * u)) := by
  have hmain : |Real.exp u - 1| ≤ |u| * (1 + Real.exp u) := by
    by_cases hu : u ≤ 0
    · have hexp_le : Real.exp u ≤ 1 := (Real.exp_le_one_iff).2 hu
      have hlin : u + 1 ≤ Real.exp u := Real.add_one_le_exp u
      have hsub : 1 - Real.exp u ≤ -u := by
        linarith
      have habs : |Real.exp u - 1| = 1 - Real.exp u := by
        rw [abs_of_nonpos (sub_nonpos.mpr hexp_le)]
        ring
      rw [habs]
      have hleft : 1 - Real.exp u ≤ |u| := by
        simpa [abs_of_nonpos hu] using hsub
      have hge : 1 ≤ 1 + Real.exp u := by
        have hpos : 0 < Real.exp u := Real.exp_pos u
        linarith
      exact le_trans hleft (le_mul_of_one_le_right (abs_nonneg u) hge)
    · have hu0 : 0 ≤ u := le_of_not_ge hu
      have hlin : 1 - Real.exp (-u) ≤ u := by
        have hadd : -u + 1 ≤ Real.exp (-u) := Real.add_one_le_exp (-u)
        linarith
      have hrew : Real.exp u - 1 = Real.exp u * (1 - Real.exp (-u)) := by
        rw [show Real.exp (-u) = (Real.exp u)⁻¹ by rw [Real.exp_neg]]
        field_simp [Real.exp_ne_zero u]
      have hbound : Real.exp u - 1 ≤ u * Real.exp u := by
        rw [hrew]
        have hmul := mul_le_mul_of_nonneg_left hlin (by positivity : 0 ≤ Real.exp u)
        simpa [mul_assoc, mul_left_comm, mul_comm] using hmul
      have habs : |Real.exp u - 1| = Real.exp u - 1 := by
        rw [abs_of_nonneg]
        have hge : 1 ≤ Real.exp u := Real.one_le_exp hu0
        linarith
      rw [habs]
      have hu_abs : |u| = u := abs_of_nonneg hu0
      have hmul : u * Real.exp u ≤ |u| * (1 + Real.exp u) := by
        rw [hu_abs]
        nlinarith [Real.one_le_exp hu0]
      exact le_trans hbound hmul
  have hsq := pow_le_pow_left₀ (abs_nonneg (Real.exp u - 1)) hmain 2
  have haux : (|u| * (1 + Real.exp u)) ^ (2 : Nat) ≤ 2 * u ^ (2 : Nat) * (1 + Real.exp (2 * u)) := by
    rw [mul_pow]
    have hu_sq : |u| ^ (2 : Nat) = u ^ (2 : Nat) := by
      simpa [sq_abs]
    rw [hu_sq]
    have hmid : 2 * Real.exp u ≤ 1 + Real.exp (2 * u) := by
      have hs : 0 ≤ (Real.exp u - 1) ^ (2 : Nat) := by
        positivity
      have hs' := hs
      rw [pow_two] at hs'
      have hexp2 : Real.exp u * Real.exp u = Real.exp (2 * u) := by
        rw [← Real.exp_add]
        congr 1
        ring
      linarith
    have hsum : (1 + Real.exp u) ^ (2 : Nat) ≤ 2 * (1 + Real.exp (2 * u)) := by
      have hmid' : 2 * Real.exp u ≤ 1 + Real.exp (u * 2) := by
        simpa [two_mul, mul_assoc, mul_left_comm, mul_comm] using hmid
      have hexp_sq : Real.exp u ^ (2 : Nat) ≤ Real.exp (u * 2) := by
        have hEq : Real.exp u ^ (2 : Nat) = Real.exp (u * 2) := by
          rw [pow_two, show u * 2 = u + u by ring, Real.exp_add]
        exact le_of_eq hEq
      ring_nf
      nlinarith [hmid', hexp_sq]
    have hu_nonneg : 0 ≤ u ^ (2 : Nat) := by
      positivity
    have hmul := mul_le_mul_of_nonneg_left hsum hu_nonneg
    simpa [mul_assoc, mul_left_comm, mul_comm] using hmul
  exact le_trans hsq haux

/-- The cubic core exponent has purely oscillatory imaginary part. -/
private lemma cubicCoreExponent_im (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    (cubicCoreExponent n mu).im = -(cubicT n (matrixOfEdge n mu)) := by
  unfold cubicCoreExponent
  simp [sub_eq_add_neg]

/-- Scalar cosine-difference bound used in the refined quintic phase removal. -/
private lemma cos_sub_cos_abs_le_sq_div_two_add_abs_mul (x y : ℝ) :
    |Real.cos (x - y) - Real.cos x| ≤ y ^ (2 : Nat) / 2 + |x * y| := by
  have hcos_sub_one_abs :
      |Real.cos y - 1| ≤ y ^ (2 : Nat) / 2 := by
    have hcos_lower : 1 - y ^ (2 : Nat) / 2 ≤ Real.cos y := by
      simpa using (Real.one_sub_sq_div_two_le_cos (x := y))
    have hnonpos : Real.cos y - 1 ≤ 0 := by
      linarith [Real.cos_le_one y]
    rw [abs_of_nonpos hnonpos]
    linarith
  have hid :
      Real.cos (x - y) - Real.cos x
        = Real.cos x * (Real.cos y - 1) + Real.sin x * Real.sin y := by
    rw [Real.cos_sub]
    ring
  calc
    |Real.cos (x - y) - Real.cos x|
      = |Real.cos x * (Real.cos y - 1) + Real.sin x * Real.sin y| := by
          rw [hid]
    _ ≤ |Real.cos x * (Real.cos y - 1)| + |Real.sin x * Real.sin y| := by
          simpa [Real.norm_eq_abs] using
            (norm_add_le (Real.cos x * (Real.cos y - 1)) (Real.sin x * Real.sin y))
    _ ≤ |Real.cos x| * |Real.cos y - 1| + |Real.sin x * Real.sin y| := by
          rw [abs_mul]
    _ ≤ 1 * (y ^ (2 : Nat) / 2) + |Real.sin x * Real.sin y| := by
          have hmul :
              |Real.cos x| * |Real.cos y - 1| ≤ 1 * (y ^ (2 : Nat) / 2) := by
            have hcx : |Real.cos x| ≤ 1 := Real.abs_cos_le_one x
            nlinarith [hcx, hcos_sub_one_abs, abs_nonneg (Real.cos x),
              abs_nonneg (Real.cos y - 1)]
          linarith
    _ ≤ y ^ (2 : Nat) / 2 + |x * y| := by
          have hsinxy : |Real.sin x * Real.sin y| ≤ |x * y| := by
            have hsx : |Real.sin x| ≤ |x| := by
              simpa using (Real.abs_sin_le_abs (x := x))
            have hsy : |Real.sin y| ≤ |y| := by
              simpa using (Real.abs_sin_le_abs (x := y))
            calc
              |Real.sin x * Real.sin y| = |Real.sin x| * |Real.sin y| := by rw [abs_mul]
              _ ≤ |x| * |y| := by
                    nlinarith [hsx, hsy, abs_nonneg (Real.sin x), abs_nonneg (Real.sin y),
                      abs_nonneg x, abs_nonneg y]
              _ = |x * y| := by simpa [abs_mul]
          nlinarith

/-- The quartic core exponent keeps the same oscillatory cubic phase. -/
private lemma quarticCoreExponent_im (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    (quarticCoreExponent n mu).im = -(cubicT n (matrixOfEdge n mu)) := by
  unfold quarticCoreExponent
  simp [sub_eq_add_neg]

/-- The corrected core exponent adds the quintic oscillatory phase. -/
private lemma correctedCoreExponent_im (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    (correctedCoreExponent n mu).im
      = -(cubicT n (matrixOfEdge n mu)) + quinticP5 n (matrixOfEdge n mu) := by
  unfold correctedCoreExponent
  simp [sub_eq_add_neg]

/-- The real part of the cubic core integrand is the Gaussian-cosine model from
`cubic_core_lower_bound`. -/
lemma cubicCoreIntegrand_re (n t : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    Complex.re (cubicCoreIntegrand n t mu)
      = Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
          * Real.cos (4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)) := by
  set c : ℝ := 4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)
  unfold cubicCoreIntegrand
  rw [Complex.exp_eq_exp_re_mul_sin_add_cos]
  have hre :
      ((((4 * t : ℕ) : ℂ) * cubicCoreExponent n mu)).re
        = -2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu := by
    simp [cubicCoreExponent_re]
    ring
  have him :
      ((((4 * t : ℕ) : ℂ) * cubicCoreExponent n mu)).im = -c := by
    simp [cubicCoreExponent_im, c]
  rw [hre, him]
  rw [Complex.mul_re, Complex.exp_ofReal_re, Complex.exp_ofReal_im]
  rw [Complex.add_re, Complex.mul_re, Complex.cos_ofReal_re, Complex.sin_ofReal_re]
  norm_num

/-- The real part of the quartic core integrand is the Gaussian-cosine model weighted by
the quartic correction. -/
private lemma quarticCoreIntegrand_re (n t : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    Complex.re (quarticCoreIntegrand n t mu)
      = Real.exp
          (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
            + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
          * Real.cos (4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)) := by
  set c : ℝ := 4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)
  unfold quarticCoreIntegrand
  rw [Complex.exp_eq_exp_re_mul_sin_add_cos]
  have hre :
      ((((4 * t : ℕ) : ℂ) * quarticCoreExponent n mu)).re
        = -2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
            + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu) := by
    simp [quarticCoreExponent_re]
    ring
  have him :
      ((((4 * t : ℕ) : ℂ) * quarticCoreExponent n mu)).im = -c := by
    simp [quarticCoreExponent_im, c]
  rw [hre, him]
  rw [Complex.mul_re, Complex.exp_ofReal_re, Complex.exp_ofReal_im]
  rw [Complex.add_re, Complex.mul_re, Complex.cos_ofReal_re, Complex.sin_ofReal_re]
  norm_num

/-- The real part of the corrected core integrand includes the quintic phase shift. -/
private lemma correctedCoreIntegrand_re (n t : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    Complex.re (correctedCoreIntegrand n t mu)
      = Real.exp
          (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
            + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
          * Real.cos
              (4 * (t : ℝ)
                * (cubicT n (matrixOfEdge n mu) - quinticP5 n (matrixOfEdge n mu))) := by
  set c : ℝ :=
    4 * (t : ℝ) * (cubicT n (matrixOfEdge n mu) - quinticP5 n (matrixOfEdge n mu))
  unfold correctedCoreIntegrand
  rw [Complex.exp_eq_exp_re_mul_sin_add_cos]
  have hre :
      ((((4 * t : ℕ) : ℂ) * correctedCoreExponent n mu)).re
        = -2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
            + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu) := by
    simp [correctedCoreExponent_re]
    ring
  have him :
      ((((4 * t : ℕ) : ℂ) * correctedCoreExponent n mu)).im = -c := by
    simp [correctedCoreExponent_im, c]
    ring
  rw [hre, him]
  rw [Complex.mul_re, Complex.exp_ofReal_re, Complex.exp_ofReal_im]
  rw [Complex.add_re, Complex.mul_re, Complex.cos_ofReal_re, Complex.sin_ofReal_re,
    Complex.sin_ofReal_im]
  rw [Real.cos_neg, Real.sin_neg]
  simp

/-- On the `t \gtrsim n^3` scale, the dynamic core sits inside the fixed local box. -/
private lemma edgeCoreRegion_subset_localBox (n : ℕ) {t : ℝ}
    (hbox : (dim n : ℝ) / t ≤ Cn3Torus.delta ^ (2 : Nat)) :
    edgeCoreRegion n t ⊆ Cn3Torus.localBox n := by
  intro mu hmu
  rw [Cn3Torus.localBox, Set.mem_pi]
  intro e he
  have hsq : Cn3Torus.sqNormEdge n mu ≤ (dim n : ℝ) / t :=
    (mem_edgeCoreRegion_iff n t mu).1 hmu
  have hcoord_sq : (mu e) ^ (2 : Nat) ≤ (Cn3Torus.delta : ℝ) ^ (2 : Nat) := by
    exact le_trans (Cn3Torus.sqNormEdge_coord_sq_le n mu e) (le_trans hsq hbox)
  have habs_sq : |mu e| ^ (2 : Nat) ≤ (Cn3Torus.delta : ℝ) ^ (2 : Nat) := by
    simpa [sq_abs] using hcoord_sq
  have habs : |mu e| ≤ Cn3Torus.delta := by
    have hs := sq_nonneg (|mu e| - Cn3Torus.delta)
    nlinarith [Cn3Torus.delta_pos.le, habs_sq]
  simpa [Set.mem_Icc] using (abs_le.mp habs)

/-- A Euclidean ball in edge coordinates sits inside the coordinate box of the same
radius. -/
lemma edgeEuclidBall_subset_edgeBox (n : ℕ) {r delta : ℝ}
    (hr_nonneg : 0 ≤ r) (hr : r ≤ delta) :
    edgeEuclidBall n r ⊆ edgeBox n delta := by
  intro mu hmu
  rw [edgeBox_eq_pi, Set.mem_pi]
  intro e he
  have hsq_ball : Cn3Torus.sqNormEdge n mu ≤ r ^ (2 : Nat) :=
    (mem_edgeEuclidBall_iff n r mu).1 hmu
  have hcoord_sq : (mu e) ^ (2 : Nat) ≤ delta ^ (2 : Nat) := by
    calc
      (mu e) ^ (2 : Nat) ≤ Cn3Torus.sqNormEdge n mu := Cn3Torus.sqNormEdge_coord_sq_le n mu e
      _ ≤ r ^ (2 : Nat) := hsq_ball
      _ ≤ delta ^ (2 : Nat) := by
            exact pow_le_pow_left₀ hr_nonneg hr 2
  have habs_sq : |mu e| ^ (2 : Nat) ≤ delta ^ (2 : Nat) := by
    simpa [sq_abs] using hcoord_sq
  have habs : |mu e| ≤ delta := by
    have hs := sq_nonneg (|mu e| - delta)
    nlinarith [habs_sq]
  simpa [Set.mem_Icc] using (abs_le.mp habs)

/-- Real Cauchy-Schwarz on an arbitrary measure space, specialized to the `L²`
controls used in the four-bridge argument. -/
lemma cs_helper {α : Type*} [MeasurableSpace α] (μ : MeasureTheory.Measure α)
    {f g : α → ℝ}
    (hf_ae : MeasureTheory.AEStronglyMeasurable f μ)
    (hg_ae : MeasureTheory.AEStronglyMeasurable g μ)
    (hf_nonneg : 0 ≤ᵐ[μ] f) (hg_nonneg : 0 ≤ᵐ[μ] g)
    (hf_int : MeasureTheory.Integrable (fun x => f x ^ (2 : Nat)) μ)
    (hg_int : MeasureTheory.Integrable (fun x => g x ^ (2 : Nat)) μ) :
    ∫ x, f x * g x ∂μ
      ≤ (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
          * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
  have hf_mem : MeasureTheory.MemLp f (ENNReal.ofReal 2) μ := by
    simpa using (MeasureTheory.memLp_two_iff_integrable_sq (f := f) hf_ae).2 hf_int
  have hg_mem : MeasureTheory.MemLp g (ENNReal.ofReal 2) μ := by
    simpa using (MeasureTheory.memLp_two_iff_integrable_sq (f := g) hg_ae).2 hg_int
  have hHC : Real.HolderConjugate (2 : ℝ) 2 := by
    refine ⟨by norm_num, by norm_num, by norm_num⟩
  simpa using
    MeasureTheory.integral_mul_le_Lp_mul_Lq_of_nonneg hHC hf_nonneg hg_nonneg hf_mem hg_mem

/-- Ordered triangle triples `(i,j,k)` with `i < j < k`, used to expand the cubic term
in edge coordinates. -/
private abbrev TriangleTriple (n : ℕ) := Fin n × Fin n × Fin n

/-- The validity predicate for an ordered triangle triple. -/
private def IsTriangleTriple {n : ℕ} (τ : TriangleTriple n) : Prop :=
  τ.1 < τ.2.1 ∧ τ.2.1 < τ.2.2

private instance {n : ℕ} : DecidablePred (@IsTriangleTriple n) := by
  classical
  intro τ
  dsimp [IsTriangleTriple]
  infer_instance

/-- The finite set of all ordered triangles in `K_n`. -/
private def triangleTriples (n : ℕ) : Finset (TriangleTriple n) :=
  by
    classical
    exact Finset.univ.filter IsTriangleTriple

/-- The first vertex of an ordered triangle triple. -/
private def triangleV1 {n : ℕ} (τ : TriangleTriple n) : Fin n := τ.1

/-- The second vertex of an ordered triangle triple. -/
private def triangleV2 {n : ℕ} (τ : TriangleTriple n) : Fin n := τ.2.1

/-- The third vertex of an ordered triangle triple. -/
private def triangleV3 {n : ℕ} (τ : TriangleTriple n) : Fin n := τ.2.2

/-- The first edge of an ordered triangle triple. -/
private def triangleEdge12 {n : ℕ} (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    Cn3Torus.Edge n :=
  ⟨(triangleV1 τ, triangleV2 τ), hτ.1⟩

/-- The second edge of an ordered triangle triple. -/
private def triangleEdge13 {n : ℕ} (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    Cn3Torus.Edge n :=
  ⟨(triangleV1 τ, triangleV3 τ), lt_trans hτ.1 hτ.2⟩

/-- The third edge of an ordered triangle triple. -/
private def triangleEdge23 {n : ℕ} (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    Cn3Torus.Edge n :=
  ⟨(triangleV2 τ, triangleV3 τ), hτ.2⟩

/-- The cubic monomial attached to an ordered triangle triple. -/
private def triangleMonomial {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (mu : Cn3Torus.Edge n → ℝ) : ℝ :=
  mu (triangleEdge12 τ hτ) * mu (triangleEdge13 τ hτ) * mu (triangleEdge23 τ hτ)

/-- The vertex set of an ordered triangle triple. -/
private def triangleVertices {n : ℕ} (τ : TriangleTriple n) : Finset (Fin n) :=
  ({triangleV1 τ, triangleV2 τ, triangleV3 τ} : Finset (Fin n))

private lemma triangleEdge12_ne_13 {n : ℕ} (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := by
  intro h
  have hpair :
      (triangleV1 τ, triangleV2 τ) = (triangleV1 τ, triangleV3 τ) :=
    congrArg Subtype.val h
  have h23 : triangleV2 τ = triangleV3 τ := by
    exact congrArg Prod.snd hpair
  exact (ne_of_lt hτ.2) h23

private lemma triangleEdge12_ne_23 {n : ℕ} (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := by
  intro h
  have hpair :
      (triangleV1 τ, triangleV2 τ) = (triangleV2 τ, triangleV3 τ) :=
    congrArg Subtype.val h
  have h12 : triangleV1 τ = triangleV2 τ := by
    exact congrArg Prod.fst hpair
  exact (ne_of_lt hτ.1) h12

private lemma triangleEdge13_ne_23 {n : ℕ} (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := by
  intro h
  have hpair :
      (triangleV1 τ, triangleV3 τ) = (triangleV2 τ, triangleV3 τ) :=
    congrArg Subtype.val h
  have h12 : triangleV1 τ = triangleV2 τ := by
    exact congrArg Prod.fst hpair
  exact (ne_of_lt hτ.1) h12

private lemma triangleVertices_card {n : ℕ} (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    (triangleVertices τ).card = 3 := by
  have h12 : triangleV1 τ ≠ triangleV2 τ := ne_of_lt hτ.1
  have h23 : triangleV2 τ ≠ triangleV3 τ := ne_of_lt hτ.2
  have h13 : triangleV1 τ ≠ triangleV3 τ := ne_of_lt (lt_trans hτ.1 hτ.2)
  have hmem23 : triangleV2 τ ∉ ({triangleV3 τ} : Finset (Fin n)) := by
    simp [h23]
  have hmem1 : triangleV1 τ ∉ ({triangleV2 τ, triangleV3 τ} : Finset (Fin n)) := by
    simp [h12, h13]
  unfold triangleVertices
  simp [hmem23, hmem1]

private lemma triangleV1_le_of_mem_vertices {n : ℕ} (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    {v : Fin n} (hv : v ∈ triangleVertices τ) :
    triangleV1 τ ≤ v := by
  have hv' : v = triangleV1 τ ∨ v = triangleV2 τ ∨ v = triangleV3 τ := by
    simpa [triangleVertices] using hv
  rcases hv' with rfl | rfl | rfl
  · exact le_rfl
  · exact le_of_lt hτ.1
  · exact le_of_lt (lt_trans hτ.1 hτ.2)

private lemma le_triangleV3_of_mem_vertices {n : ℕ} (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    {v : Fin n} (hv : v ∈ triangleVertices τ) :
    v ≤ triangleV3 τ := by
  have hv' : v = triangleV1 τ ∨ v = triangleV2 τ ∨ v = triangleV3 τ := by
    simpa [triangleVertices] using hv
  rcases hv' with rfl | rfl | rfl
  · exact le_of_lt (lt_trans hτ.1 hτ.2)
  · exact le_of_lt hτ.2
  · exact le_rfl

private lemma triangleTriple_eq_of_vertices_eq {n : ℕ}
    (τ τ' : TriangleTriple n) (hτ : IsTriangleTriple τ) (hτ' : IsTriangleTriple τ')
    (hV : triangleVertices τ = triangleVertices τ') :
    τ = τ' := by
  have h1mem : triangleV1 τ ∈ triangleVertices τ' := by
    rw [← hV]
    simp [triangleVertices]
  have h1mem' : triangleV1 τ' ∈ triangleVertices τ := by
    rw [hV]
    simp [triangleVertices]
  have h1le : triangleV1 τ' ≤ triangleV1 τ :=
    triangleV1_le_of_mem_vertices τ' hτ' h1mem
  have h1le' : triangleV1 τ ≤ triangleV1 τ' :=
    triangleV1_le_of_mem_vertices τ hτ h1mem'
  have h1 : triangleV1 τ = triangleV1 τ' := le_antisymm h1le' h1le
  have h3mem : triangleV3 τ ∈ triangleVertices τ' := by
    rw [← hV]
    simp [triangleVertices]
  have h3mem' : triangleV3 τ' ∈ triangleVertices τ := by
    rw [hV]
    simp [triangleVertices]
  have h3le : triangleV3 τ ≤ triangleV3 τ' :=
    le_triangleV3_of_mem_vertices τ' hτ' h3mem
  have h3le' : triangleV3 τ' ≤ triangleV3 τ :=
    le_triangleV3_of_mem_vertices τ hτ h3mem'
  have h3 : triangleV3 τ = triangleV3 τ' := le_antisymm h3le h3le'
  have h2mem : triangleV2 τ ∈ triangleVertices τ' := by
    rw [← hV]
    simp [triangleVertices]
  have h2' :
      triangleV2 τ = triangleV2 τ' := by
    have hcases :
        triangleV2 τ = triangleV1 τ' ∨
          triangleV2 τ = triangleV2 τ' ∨
          triangleV2 τ = triangleV3 τ' := by
      simpa [triangleVertices] using h2mem
    rcases hcases with h | h | h
    · exfalso
      have hcontra : triangleV1 τ < triangleV1 τ := by
        calc
          triangleV1 τ < triangleV2 τ := hτ.1
          _ = triangleV1 τ' := h
          _ = triangleV1 τ := h1.symm
      exact (lt_irrefl _) hcontra
    · exact h
    · exfalso
      have hcontra : triangleV3 τ' < triangleV3 τ' := by
        calc
          triangleV3 τ' = triangleV2 τ := h.symm
          _ < triangleV3 τ := hτ.2
          _ = triangleV3 τ' := h3
      exact (lt_irrefl _) hcontra
  cases τ with
  | mk a bc =>
      cases bc with
      | mk b c =>
          cases τ' with
          | mk a' bc' =>
              cases bc' with
              | mk b' c' =>
                  simp [triangleV1, triangleV2, triangleV3] at h1 h2' h3
                  subst h1 h2' h3
                  rfl

private lemma exists_vertex_notin_of_triangle_ne {n : ℕ}
    (τ τ' : TriangleTriple n) (hτ : IsTriangleTriple τ) (hτ' : IsTriangleTriple τ')
    (hne : τ ≠ τ') :
    ∃ v : Fin n, v ∈ triangleVertices τ ∧ v ∉ triangleVertices τ' := by
  have hVne : triangleVertices τ ≠ triangleVertices τ' := by
    intro hV
    exact hne (triangleTriple_eq_of_vertices_eq τ τ' hτ hτ' hV)
  by_contra hnone
  have hsubset : triangleVertices τ ⊆ triangleVertices τ' := by
    intro v hv
    by_contra hv'
    exact hnone ⟨v, hv, hv'⟩
  have hcard :
      (triangleVertices τ').card ≤ (triangleVertices τ).card := by
    rw [triangleVertices_card τ' hτ', triangleVertices_card τ hτ]
  have hEq : triangleVertices τ = triangleVertices τ' :=
    Finset.eq_of_subset_of_card_le hsubset hcard
  exact hVne hEq

private lemma coordSplit_sqNorm_eq_sqNormEdge {n : ℕ} (mu : Cn3Torus.Edge n → ℝ) :
    CoordSplit.sqNorm mu = Cn3Torus.sqNormEdge n mu := by
  unfold CoordSplit.sqNorm Cn3Torus.sqNormEdge
  rfl

private lemma gaussian_edge_three_sq_factor {n : ℕ}
    (e₁ e₂ e₃ : Cn3Torus.Edge n) (he₁₂ : e₁ ≠ e₂) (he₁₃ : e₁ ≠ e₃) (he₂₃ : e₂ ≠ e₃)
    (t : ℝ) (ht : 0 < t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        mu e₁ ^ (2 : Nat) * mu e₂ ^ (2 : Nat) * mu e₃ ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = (1 / (4 * t)) ^ (3 : Nat) * gaussianF (dim n) t := by
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        mu e₁ ^ (2 : Nat) * mu e₂ ^ (2 : Nat) * mu e₃ ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          mu e₁ ^ (2 : Nat) * mu e₂ ^ (2 : Nat) * mu e₃ ^ (2 : Nat)
            * Real.exp (-2 * t * CoordSplit.sqNorm mu) := by
            refine MeasureTheory.integral_congr_ae ?_
            exact Filter.Eventually.of_forall (fun mu => by simp [coordSplit_sqNorm_eq_sqNormEdge])
    _ = (1 / (4 * t)) ^ (3 : Nat)
          * ∫ mu : Cn3Torus.Edge n → ℝ, Real.exp (-2 * t * CoordSplit.sqNorm mu) := by
            exact gaussian_three_coord_sq_factor e₁ e₂ e₃ he₁₂ he₁₃ he₂₃ t ht
    _ = (1 / (4 * t)) ^ (3 : Nat) * gaussianF (dim n) t := by
          congr 1
          calc
            ∫ mu : Cn3Torus.Edge n → ℝ, Real.exp (-2 * t * CoordSplit.sqNorm mu)
              = ∫ mu : Cn3Torus.Edge n → ℝ, Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
                  refine MeasureTheory.integral_congr_ae ?_
                  exact Filter.Eventually.of_forall (fun mu => by simp [coordSplit_sqNorm_eq_sqNormEdge])
            _ = gaussianF (dim n) t := by
                  simpa using gaussian_integral_formula_edge n (2 * t) (by positivity)

private lemma gaussian_edge_six_fold_odd_zero {n : ℕ}
    (e₀ e₁ e₂ e₃ e₄ e₅ : Cn3Torus.Edge n)
    (he₁ : e₁ ≠ e₀) (he₂ : e₂ ≠ e₀) (he₃ : e₃ ≠ e₀)
    (he₄ : e₄ ≠ e₀) (he₅ : e₅ ≠ e₀) (t : ℝ) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        mu e₀ * mu e₁ * mu e₂ * mu e₃ * mu e₄ * mu e₅
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = 0 := by
  let ee₁ : CoordSplit.CoordNe e₀ := ⟨e₁, he₁⟩
  let ee₂ : CoordSplit.CoordNe e₀ := ⟨e₂, he₂⟩
  let ee₃ : CoordSplit.CoordNe e₀ := ⟨e₃, he₃⟩
  let ee₄ : CoordSplit.CoordNe e₀ := ⟨e₄, he₄⟩
  let ee₅ : CoordSplit.CoordNe e₀ := ⟨e₅, he₅⟩
  simpa [pow_one, coordSplit_sqNorm_eq_sqNormEdge, CoordSplit.splitAt_fst, CoordSplit.splitAt_snd,
    ee₁, ee₂, ee₃, ee₄, ee₅, mul_assoc, mul_left_comm, mul_comm] using
    (gaussian_split_odd_zero (α := Cn3Torus.Edge n) e₀ 0 t
      (fun y =>
        y ee₁ * y ee₂ * y ee₃ * y ee₄ * y ee₅))

private lemma left_endpoint_mem_vertices_of_edge_eq_any {n : ℕ}
    {u v : Fin n} (huv : u < v) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (h :
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = triangleEdge12 τ hτ) ∨
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = triangleEdge13 τ hτ) ∨
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = triangleEdge23 τ hτ)) :
    u ∈ triangleVertices τ := by
  rcases h with h | h | h
  · have hu : u = triangleV1 τ := by
      simpa [triangleEdge12] using congrArg Prod.fst (congrArg Subtype.val h)
    simp [triangleVertices, hu]
  · have hu : u = triangleV1 τ := by
      simpa [triangleEdge13] using congrArg Prod.fst (congrArg Subtype.val h)
    simp [triangleVertices, hu]
  · have hu : u = triangleV2 τ := by
      simpa [triangleEdge23] using congrArg Prod.fst (congrArg Subtype.val h)
    simp [triangleVertices, hu]

private lemma right_endpoint_mem_vertices_of_edge_eq_any {n : ℕ}
    {u v : Fin n} (huv : u < v) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (h :
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = triangleEdge12 τ hτ) ∨
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = triangleEdge13 τ hτ) ∨
      ((⟨(u, v), huv⟩ : Cn3Torus.Edge n) = triangleEdge23 τ hτ)) :
    v ∈ triangleVertices τ := by
  rcases h with h | h | h
  · have hv : v = triangleV2 τ := by
      simpa [triangleEdge12] using congrArg Prod.snd (congrArg Subtype.val h)
    simp [triangleVertices, hv]
  · have hv : v = triangleV3 τ := by
      simpa [triangleEdge13] using congrArg Prod.snd (congrArg Subtype.val h)
    simp [triangleVertices, hv]
  · have hv : v = triangleV3 τ := by
      simpa [triangleEdge23] using congrArg Prod.snd (congrArg Subtype.val h)
    simp [triangleVertices, hv]

/-- The cubic term written as a finite sum over ordered triangle triples. -/
private def triangleMonomialOn {n : ℕ}
    (mu : Cn3Torus.Edge n → ℝ) (τ : TriangleTriple n) : ℝ := by
  classical
  exact if hτ : IsTriangleTriple τ then triangleMonomial τ hτ mu else 0

private lemma cubicT_matrixOfEdge_eq_sum_triangleTriples (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    cubicT n (matrixOfEdge n mu)
      = Finset.sum (triangleTriples n) (fun τ => triangleMonomialOn mu τ) := by
  classical
  rw [triangle_formula, triangleTriples, Finset.sum_filter]
  rw [Fintype.sum_prod_type]
  refine Finset.sum_congr rfl ?_
  intro i hi
  rw [Fintype.sum_prod_type]
  refine Finset.sum_congr rfl ?_
  intro j hj
  refine Finset.sum_congr rfl ?_
  intro k hk
  by_cases hijk : i < j ∧ j < k
  · have hij : i < j := hijk.1
    have hjk : j < k := hijk.2
    have hik : i < k := lt_trans hij hjk
    simp [TriangleTriple, IsTriangleTriple, triangleMonomialOn, triangleMonomial,
      triangleV1, triangleV2, triangleV3, triangleEdge12, triangleEdge13,
      triangleEdge23, matrixOfEdge, hijk, hij, hjk, hik]
  · simp [TriangleTriple, IsTriangleTriple, triangleMonomialOn, triangleMonomial, hijk]

private lemma abs_coord_le_sqrt_sqNormEdge {n : ℕ}
    (mu : Cn3Torus.Edge n → ℝ) (e : Cn3Torus.Edge n) :
    |mu e| ≤ Real.sqrt (Cn3Torus.sqNormEdge n mu) := by
  have hsq :
      |mu e| ^ (2 : Nat) ≤ Cn3Torus.sqNormEdge n mu := by
    simpa [sq_abs] using Cn3Torus.sqNormEdge_coord_sq_le n mu e
  have hs_nonneg : 0 ≤ Cn3Torus.sqNormEdge n mu := Cn3Torus.sqNormEdge_nonneg n mu
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Cn3Torus.sqNormEdge n mu) := by positivity
  nlinarith [hsq, Real.sq_sqrt hs_nonneg]

private lemma sqrt_sqNormEdge_cubed_eq_rpow_threeHalves {n : ℕ}
    (mu : Cn3Torus.Edge n → ℝ) :
    Real.sqrt (Cn3Torus.sqNormEdge n mu)
      * Real.sqrt (Cn3Torus.sqNormEdge n mu)
      * Real.sqrt (Cn3Torus.sqNormEdge n mu)
      = Cn3Torus.sqNormEdge n mu ^ (3 / 2 : ℝ) := by
  have hs_nonneg : 0 ≤ Cn3Torus.sqNormEdge n mu := Cn3Torus.sqNormEdge_nonneg n mu
  by_cases hs_zero : Cn3Torus.sqNormEdge n mu = 0
  · simp [hs_zero]
  · have hs_pos : 0 < Cn3Torus.sqNormEdge n mu := lt_of_le_of_ne hs_nonneg (Ne.symm hs_zero)
    calc
      Real.sqrt (Cn3Torus.sqNormEdge n mu)
          * Real.sqrt (Cn3Torus.sqNormEdge n mu)
          * Real.sqrt (Cn3Torus.sqNormEdge n mu)
        = (Cn3Torus.sqNormEdge n mu) ^ (1 / 2 : ℝ)
            * (Cn3Torus.sqNormEdge n mu) ^ (1 / 2 : ℝ)
            * (Cn3Torus.sqNormEdge n mu) ^ (1 / 2 : ℝ) := by
              simp [Real.sqrt_eq_rpow]
      _ = (Cn3Torus.sqNormEdge n mu) ^ ((1 / 2 : ℝ) + (1 / 2 : ℝ))
            * (Cn3Torus.sqNormEdge n mu) ^ (1 / 2 : ℝ) := by
              rw [← Real.rpow_add hs_pos]
      _ = (Cn3Torus.sqNormEdge n mu) ^ (((1 / 2 : ℝ) + (1 / 2 : ℝ)) + (1 / 2 : ℝ)) := by
            rw [← Real.rpow_add hs_pos]
      _ = Cn3Torus.sqNormEdge n mu ^ (3 / 2 : ℝ) := by norm_num

private lemma abs_triangleMonomial_le_sqNorm_threeHalves {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (mu : Cn3Torus.Edge n → ℝ) :
    |triangleMonomial τ hτ mu|
      ≤ Cn3Torus.sqNormEdge n mu ^ (3 / 2 : ℝ) := by
  calc
    |triangleMonomial τ hτ mu|
      = |mu (triangleEdge12 τ hτ)| * |mu (triangleEdge13 τ hτ)| * |mu (triangleEdge23 τ hτ)| := by
          simp [triangleMonomial, abs_mul, mul_assoc, mul_left_comm, mul_comm]
    _ ≤ Real.sqrt (Cn3Torus.sqNormEdge n mu)
          * Real.sqrt (Cn3Torus.sqNormEdge n mu)
          * Real.sqrt (Cn3Torus.sqNormEdge n mu) := by
            gcongr
            · exact abs_coord_le_sqrt_sqNormEdge mu (triangleEdge12 τ hτ)
            · exact abs_coord_le_sqrt_sqNormEdge mu (triangleEdge13 τ hτ)
            · exact abs_coord_le_sqrt_sqNormEdge mu (triangleEdge23 τ hτ)
    _ = Cn3Torus.sqNormEdge n mu ^ (3 / 2 : ℝ) := sqrt_sqNormEdge_cubed_eq_rpow_threeHalves mu

private lemma trianglePair_integrable {n : ℕ}
    (τ τ' : TriangleTriple n) (hτ : IsTriangleTriple τ) (hτ' : IsTriangleTriple τ')
    (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      triangleMonomial τ hτ mu * triangleMonomial τ' hτ' mu
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    triangleMonomial τ hτ mu * triangleMonomial τ' hτ' mu
      * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Cn3Torus.sqNormEdge n mu ^ (3 : Nat) * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  have hg_int : MeasureTheory.Integrable g := by
    simpa [g] using sqNorm_moment_gaussian_integrable_edge n 3 (by norm_num) t ht
  have hf_sm : MeasureTheory.AEStronglyMeasurable f := by
    have hτ_cont :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => triangleMonomial τ hτ mu) := by
      exact ((continuous_apply (triangleEdge12 τ hτ)).mul
        (continuous_apply (triangleEdge13 τ hτ))).mul
        (continuous_apply (triangleEdge23 τ hτ))
    have hτ'_cont :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => triangleMonomial τ' hτ' mu) := by
      exact ((continuous_apply (triangleEdge12 τ' hτ')).mul
        (continuous_apply (triangleEdge13 τ' hτ'))).mul
        (continuous_apply (triangleEdge23 τ' hτ'))
    have hexp_cont' :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
          Real.exp (-((2 * t) * Cn3Torus.sqNormEdge n mu))) := by
      exact Real.continuous_exp.comp
        ((continuous_const.mul (Cn3Torus.continuous_sqNormEdge n)).neg)
    have hexp_cont :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
          Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
      simpa [mul_assoc] using hexp_cont'
    exact ((hτ_cont.mul hτ'_cont).mul hexp_cont).aestronglyMeasurable
  have hbound :
      ∀ᵐ mu : Cn3Torus.Edge n → ℝ ∂MeasureTheory.volume, ‖f mu‖ ≤ g mu := by
    exact Filter.Eventually.of_forall (fun mu => by
      have hs_nonneg : 0 ≤ Cn3Torus.sqNormEdge n mu := Cn3Torus.sqNormEdge_nonneg n mu
      have hsq :
          Cn3Torus.sqNormEdge n mu ^ (3 / 2 : ℝ)
            * Cn3Torus.sqNormEdge n mu ^ (3 / 2 : ℝ)
            = Cn3Torus.sqNormEdge n mu ^ (3 : Nat) := by
        by_cases hs_zero : Cn3Torus.sqNormEdge n mu = 0
        · simp [hs_zero]
        · have hs_pos : 0 < Cn3Torus.sqNormEdge n mu :=
            lt_of_le_of_ne hs_nonneg (Ne.symm hs_zero)
          calc
            Cn3Torus.sqNormEdge n mu ^ (3 / 2 : ℝ)
                * Cn3Torus.sqNormEdge n mu ^ (3 / 2 : ℝ)
              = Cn3Torus.sqNormEdge n mu ^ ((3 / 2 : ℝ) + (3 / 2 : ℝ)) := by
                  rw [← Real.rpow_add hs_pos]
            _ = Cn3Torus.sqNormEdge n mu ^ (3 : ℝ) := by norm_num
            _ = Cn3Torus.sqNormEdge n mu ^ (3 : Nat) := by
                  simpa using (Real.rpow_natCast (Cn3Torus.sqNormEdge n mu) 3)
      have htri :
          |triangleMonomial τ hτ mu * triangleMonomial τ' hτ' mu|
            ≤ Cn3Torus.sqNormEdge n mu ^ (3 : Nat) := by
        calc
          |triangleMonomial τ hτ mu * triangleMonomial τ' hτ' mu|
            = |triangleMonomial τ hτ mu| * |triangleMonomial τ' hτ' mu| := by
                rw [abs_mul]
          _ ≤ Cn3Torus.sqNormEdge n mu ^ (3 / 2 : ℝ)
                * Cn3Torus.sqNormEdge n mu ^ (3 / 2 : ℝ) := by
                  gcongr
                  · exact abs_triangleMonomial_le_sqNorm_threeHalves τ hτ mu
                  · exact abs_triangleMonomial_le_sqNorm_threeHalves τ' hτ' mu
          _ = Cn3Torus.sqNormEdge n mu ^ (3 : Nat) := hsq
      have hexp_nonneg : 0 ≤ Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by positivity
      have hmul :
          ‖f mu‖ ≤ g mu := by
        unfold f g
        calc
          ‖triangleMonomial τ hτ mu * triangleMonomial τ' hτ' mu
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)‖
              = |triangleMonomial τ hτ mu * triangleMonomial τ' hτ' mu|
                  * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
                    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hexp_nonneg]
          _ ≤ Cn3Torus.sqNormEdge n mu ^ (3 : Nat)
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
                  gcongr
          _ = g mu := by rfl
      exact hmul)
  exact MeasureTheory.Integrable.mono' hg_int hf_sm hbound

private lemma triangle_pair_gaussian_zero_of_ne {n : ℕ}
    (τ τ' : TriangleTriple n) (hτ : IsTriangleTriple τ) (hτ' : IsTriangleTriple τ')
    (hne : τ ≠ τ') (t : ℝ) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        triangleMonomial τ hτ mu * triangleMonomial τ' hτ' mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = 0 := by
  obtain ⟨v, hv_mem, hv_not⟩ := exists_vertex_notin_of_triangle_ne τ τ' hτ hτ' hne
  have hvcases :
      v = triangleV1 τ ∨ v = triangleV2 τ ∨ v = triangleV3 τ := by
    simpa [triangleVertices] using hv_mem
  rcases hvcases with hv | hv | hv
  · subst hv
    have he₁ : triangleEdge13 τ hτ ≠ triangleEdge12 τ hτ := by
      exact (triangleEdge12_ne_13 τ hτ).symm
    have he₂ : triangleEdge23 τ hτ ≠ triangleEdge12 τ hτ := by
      exact (triangleEdge12_ne_23 τ hτ).symm
    have he₃ : triangleEdge12 τ' hτ' ≠ triangleEdge12 τ hτ := by
      intro h
      apply hv_not
      have hfst : triangleV1 τ' = triangleV1 τ := by
        simpa [triangleEdge12, triangleV1, triangleV2] using
          congrArg Prod.fst (congrArg Subtype.val h)
      simp [triangleVertices, hfst]
    have he₄ : triangleEdge13 τ' hτ' ≠ triangleEdge12 τ hτ := by
      intro h
      apply hv_not
      have hfst : triangleV1 τ' = triangleV1 τ := by
        simpa [triangleEdge12, triangleEdge13, triangleV1, triangleV2, triangleV3] using
          congrArg Prod.fst (congrArg Subtype.val h)
      simp [triangleVertices, hfst]
    have he₅ : triangleEdge23 τ' hτ' ≠ triangleEdge12 τ hτ := by
      intro h
      apply hv_not
      have hfst : triangleV2 τ' = triangleV1 τ := by
        simpa [triangleEdge12, triangleEdge23, triangleV1, triangleV2, triangleV3] using
          congrArg Prod.fst (congrArg Subtype.val h)
      simp [triangleVertices, ← hfst]
    simpa [triangleMonomial, mul_assoc, mul_left_comm, mul_comm] using
      (gaussian_edge_six_fold_odd_zero
        (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)
        (triangleEdge12 τ' hτ') (triangleEdge13 τ' hτ') (triangleEdge23 τ' hτ')
        he₁ he₂ he₃ he₄ he₅ t)
  · subst hv
    have he₁ : triangleEdge13 τ hτ ≠ triangleEdge12 τ hτ := by
      exact (triangleEdge12_ne_13 τ hτ).symm
    have he₂ : triangleEdge23 τ hτ ≠ triangleEdge12 τ hτ := by
      exact (triangleEdge12_ne_23 τ hτ).symm
    have he₃ : triangleEdge12 τ' hτ' ≠ triangleEdge12 τ hτ := by
      intro h
      apply hv_not
      have hsnd : triangleV2 τ' = triangleV2 τ := by
        simpa [triangleEdge12, triangleV1, triangleV2] using
          congrArg Prod.snd (congrArg Subtype.val h)
      simp [triangleVertices, hsnd]
    have he₄ : triangleEdge13 τ' hτ' ≠ triangleEdge12 τ hτ := by
      intro h
      apply hv_not
      have hsnd : triangleV3 τ' = triangleV2 τ := by
        simpa [triangleEdge12, triangleEdge13, triangleV1, triangleV2, triangleV3] using
          congrArg Prod.snd (congrArg Subtype.val h)
      simp [triangleVertices, ← hsnd]
    have he₅ : triangleEdge23 τ' hτ' ≠ triangleEdge12 τ hτ := by
      intro h
      apply hv_not
      have hsnd : triangleV3 τ' = triangleV2 τ := by
        simpa [triangleEdge12, triangleEdge23, triangleV1, triangleV2, triangleV3] using
          congrArg Prod.snd (congrArg Subtype.val h)
      simp [triangleVertices, ← hsnd]
    simpa [triangleMonomial, mul_assoc, mul_left_comm, mul_comm] using
      (gaussian_edge_six_fold_odd_zero
        (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)
        (triangleEdge12 τ' hτ') (triangleEdge13 τ' hτ') (triangleEdge23 τ' hτ')
        he₁ he₂ he₃ he₄ he₅ t)
  · subst hv
    have he₁ : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := by
      exact triangleEdge12_ne_23 τ hτ
    have he₂ : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := by
      exact triangleEdge13_ne_23 τ hτ
    have he₃ : triangleEdge12 τ' hτ' ≠ triangleEdge23 τ hτ := by
      intro h
      apply hv_not
      have hsnd : triangleV2 τ' = triangleV3 τ := by
        simpa [triangleEdge12, triangleEdge23, triangleV1, triangleV2, triangleV3] using
          congrArg Prod.snd (congrArg Subtype.val h)
      simp [triangleVertices, ← hsnd]
    have he₄ : triangleEdge13 τ' hτ' ≠ triangleEdge23 τ hτ := by
      intro h
      apply hv_not
      have hsnd : triangleV3 τ' = triangleV3 τ := by
        simpa [triangleEdge13, triangleEdge23, triangleV1, triangleV2, triangleV3] using
          congrArg Prod.snd (congrArg Subtype.val h)
      simp [triangleVertices, hsnd]
    have he₅ : triangleEdge23 τ' hτ' ≠ triangleEdge23 τ hτ := by
      intro h
      apply hv_not
      have hsnd : triangleV3 τ' = triangleV3 τ := by
        simpa [triangleEdge23, triangleV2, triangleV3] using
          congrArg Prod.snd (congrArg Subtype.val h)
      simp [triangleVertices, hsnd]
    simpa [triangleMonomial, mul_assoc, mul_left_comm, mul_comm] using
      (gaussian_edge_six_fold_odd_zero
        (triangleEdge23 τ hτ) (triangleEdge12 τ hτ) (triangleEdge13 τ hτ)
        (triangleEdge12 τ' hτ') (triangleEdge13 τ' hτ') (triangleEdge23 τ' hτ')
        he₁ he₂ he₃ he₄ he₅ t)

private lemma triangle_self_gaussian_integral {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (t : ℝ) (ht : 0 < t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (triangleMonomial τ hτ mu) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = (1 / (4 * t)) ^ (3 : Nat) * gaussianF (dim n) t := by
  simpa [triangleMonomial, pow_two, mul_assoc, mul_left_comm, mul_comm] using
    (gaussian_edge_three_sq_factor
      (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)
      (triangleEdge12_ne_13 τ hτ) (triangleEdge12_ne_23 τ hτ) (triangleEdge13_ne_23 τ hτ)
      t ht)

private lemma isTriangleTriple_orderEmbOfFin_card3 {n : ℕ}
    (s : Finset (Fin n)) (hs : s.card = 3) :
    IsTriangleTriple
      (s.orderEmbOfFin hs (0 : Fin 3),
        (s.orderEmbOfFin hs (1 : Fin 3), s.orderEmbOfFin hs (2 : Fin 3))) := by
  constructor
  · exact (s.orderEmbOfFin hs).strictMono (by omega : (0 : Fin 3) < 1)
  · exact (s.orderEmbOfFin hs).strictMono (by omega : (1 : Fin 3) < 2)

private lemma triangleVertices_orderEmbOfFin_card3 {n : ℕ}
    (s : Finset (Fin n)) (hs : s.card = 3) :
    triangleVertices
        (s.orderEmbOfFin hs (0 : Fin 3),
          (s.orderEmbOfFin hs (1 : Fin 3), s.orderEmbOfFin hs (2 : Fin 3)))
      = s := by
  classical
  let f : Fin 3 ↪o Fin n := s.orderEmbOfFin hs
  have himage : Finset.image f.toEmbedding Finset.univ = s := by
    simpa [f] using (Finset.image_orderEmbOfFin_univ s hs)
  ext v
  constructor
  · intro hv
    have hv' :
        v = f (0 : Fin 3) ∨ v = f (1 : Fin 3) ∨ v = f (2 : Fin 3) := by
      simpa [triangleVertices, f] using hv
    rcases hv' with rfl | rfl | rfl
    ·
      have h0 : f (0 : Fin 3) ∈ Finset.image f.toEmbedding Finset.univ :=
        Finset.mem_image.mpr ⟨(0 : Fin 3), Finset.mem_univ _, rfl⟩
      rw [← himage]
      exact h0
    ·
      have h1 : f (1 : Fin 3) ∈ Finset.image f.toEmbedding Finset.univ :=
        Finset.mem_image.mpr ⟨(1 : Fin 3), Finset.mem_univ _, rfl⟩
      rw [← himage]
      exact h1
    ·
      have h2 : f (2 : Fin 3) ∈ Finset.image f.toEmbedding Finset.univ :=
        Finset.mem_image.mpr ⟨(2 : Fin 3), Finset.mem_univ _, rfl⟩
      rw [← himage]
      exact h2
  · intro hv
    rw [← himage] at hv
    rcases Finset.mem_image.mp hv with ⟨i, -, rfl⟩
    fin_cases i <;> simp [triangleVertices, triangleV1, triangleV2, triangleV3, f]

noncomputable def triangleTripleValidEquivFinsetCard3 (n : ℕ) :
    { τ : TriangleTriple n // IsTriangleTriple τ } ≃ { s : Finset (Fin n) // s.card = 3 } where
  toFun τ := ⟨triangleVertices τ.1, triangleVertices_card τ.1 τ.2⟩
  invFun s :=
    ⟨(s.1.orderEmbOfFin s.2 (0 : Fin 3),
        (s.1.orderEmbOfFin s.2 (1 : Fin 3), s.1.orderEmbOfFin s.2 (2 : Fin 3))),
      isTriangleTriple_orderEmbOfFin_card3 s.1 s.2⟩
  left_inv τ := by
    rcases τ with ⟨τ, hτ⟩
    apply Subtype.ext
    let s : Finset (Fin n) := triangleVertices τ
    let hs : s.card = 3 := triangleVertices_card τ hτ
    let τ' : TriangleTriple n :=
      (s.orderEmbOfFin hs (0 : Fin 3),
        (s.orderEmbOfFin hs (1 : Fin 3), s.orderEmbOfFin hs (2 : Fin 3)))
    have hτ' : IsTriangleTriple τ' := isTriangleTriple_orderEmbOfFin_card3 s hs
    have hV : triangleVertices τ = triangleVertices τ' := by
      have hEq : triangleVertices τ' = s := triangleVertices_orderEmbOfFin_card3 s hs
      simpa [s, τ'] using hEq.symm
    exact (triangleTriple_eq_of_vertices_eq τ τ' hτ hτ' hV).symm
  right_inv s := by
    rcases s with ⟨s, hs⟩
    apply Subtype.ext
    simpa using triangleVertices_orderEmbOfFin_card3 s hs

private lemma triangleTriples_card_eq_choose (n : ℕ) :
    (triangleTriples n).card = Nat.choose n 3 := by
  classical
  calc
    (triangleTriples n).card = Fintype.card ({ τ : TriangleTriple n // IsTriangleTriple τ }) := by
      simpa [triangleTriples] using
        (Fintype.card_subtype (α := TriangleTriple n) IsTriangleTriple).symm
    _ = Fintype.card { s : Finset (Fin n) // s.card = 3 } := by
      exact Fintype.card_congr (triangleTripleValidEquivFinsetCard3 n)
    _ = Nat.choose n 3 := by
      simpa using (Fintype.card_finset_len (α := Fin n) 3)

private lemma triangleTriples_card_le_cube (n : ℕ) :
    ((triangleTriples n).card : ℝ) ≤ (n : ℝ) ^ (3 : Nat) := by
  classical
  have hcard_le_nat : (triangleTriples n).card ≤ n ^ (3 : Nat) := by
    simpa [triangleTriples, TriangleTriple, pow_three] using
      (Finset.card_filter_le (s := (Finset.univ : Finset (TriangleTriple n)))
        (p := IsTriangleTriple))
  exact_mod_cast hcard_le_nat

private lemma cubicT_sq_full_gaussian_exact_card
    (n : ℕ) (t : ℝ) (ht : 0 < t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ((triangleTriples n).card : ℝ) * (1 / (4 * t)) ^ (3 : Nat) * gaussianF (dim n) t := by
  classical
  let Tset := triangleTriples n
  have hpair_int :
      ∀ τ ∈ Tset, ∀ τ' ∈ Tset,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          triangleMonomialOn mu τ * triangleMonomialOn mu τ'
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
    intro τ hτ τ' hτ'
    simpa [triangleMonomialOn, (Finset.mem_filter.mp hτ).2, (Finset.mem_filter.mp hτ').2] using
      (trianglePair_integrable τ τ'
        (Finset.mem_filter.mp hτ).2 (Finset.mem_filter.mp hτ').2 t ht)
  have houter_int :
      ∀ τ ∈ Tset,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          Finset.sum Tset (fun τ' =>
            triangleMonomialOn mu τ * triangleMonomialOn mu τ'
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro τ hτ
    exact MeasureTheory.integrable_finset_sum Tset (fun τ' hτ' => hpair_int τ hτ τ' hτ')
  have hpoint :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = Finset.sum Tset (fun τ =>
            Finset.sum Tset (fun τ' =>
              triangleMonomialOn mu τ * triangleMonomialOn mu τ'
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro mu
    have hcubic := cubicT_matrixOfEdge_eq_sum_triangleTriples n mu
    rw [hcubic, pow_two]
    calc
      (Finset.sum Tset (fun τ => triangleMonomialOn mu τ))
          * (Finset.sum Tset (fun τ' => triangleMonomialOn mu τ'))
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = (Finset.sum Tset (fun τ =>
            Finset.sum Tset (fun τ' =>
              triangleMonomialOn mu τ * triangleMonomialOn mu τ')))
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              rw [Finset.sum_mul_sum]
      _ = Finset.sum Tset (fun τ =>
            Finset.sum Tset (fun τ' =>
              triangleMonomialOn mu τ * triangleMonomialOn mu τ'
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl ?_
            intro τ hτ
            rw [Finset.sum_mul]
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          Finset.sum Tset (fun τ =>
            Finset.sum Tset (fun τ' =>
              triangleMonomialOn mu τ * triangleMonomialOn mu τ'
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
            refine MeasureTheory.integral_congr_ae ?_
            exact Filter.Eventually.of_forall hpoint
    _ = Finset.sum Tset (fun τ =>
          Finset.sum Tset (fun τ' =>
            (∫ mu : Cn3Torus.Edge n → ℝ,
              triangleMonomialOn mu τ * triangleMonomialOn mu τ'
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)))) := by
          rw [MeasureTheory.integral_finset_sum Tset houter_int]
          refine Finset.sum_congr rfl ?_
          intro τ hτ
          rw [MeasureTheory.integral_finset_sum Tset (fun τ' hτ' => hpair_int τ hτ τ' hτ')]
    _ = Finset.sum Tset (fun τ => (1 / (4 * t)) ^ (3 : Nat) * gaussianF (dim n) t) := by
          refine Finset.sum_congr rfl ?_
          intro τ hτ
          have hτ_tri : IsTriangleTriple τ := (Finset.mem_filter.mp hτ).2
          rw [Finset.sum_eq_single τ]
          · simpa [triangleMonomialOn, hτ_tri, pow_two, mul_assoc, mul_left_comm, mul_comm] using
              triangle_self_gaussian_integral τ hτ_tri t ht
          · intro τ' hτ' hneq
            have hτ'_tri : IsTriangleTriple τ' := (Finset.mem_filter.mp hτ').2
            have hzero := triangle_pair_gaussian_zero_of_ne τ τ' hτ_tri hτ'_tri hneq.symm t
            simpa [triangleMonomialOn, hτ_tri, hτ'_tri] using hzero
          · intro hnot
            exact False.elim (hnot hτ)
    _ = ((Tset.card : ℝ) * ((1 / (4 * t)) ^ (3 : Nat) * gaussianF (dim n) t)) := by
          rw [Finset.sum_const, nsmul_eq_mul]
    _ = ((triangleTriples n).card : ℝ) * (1 / (4 * t)) ^ (3 : Nat) * gaussianF (dim n) t := by
          simp [Tset]
          ring

lemma cubicT_sq_full_gaussian_correction_exact
    (n : ℕ) (t : ℝ) (ht : 0 < t) :
    (8 : ℝ) * t ^ (2 : Nat)
        * ∫ mu : Cn3Torus.Edge n → ℝ,
            (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ((Nat.choose n 3 : ℝ) / (8 * t)) * gaussianF (dim n) t := by
  rw [cubicT_sq_full_gaussian_exact_card n t ht, triangleTriples_card_eq_choose]
  field_simp [ht.ne']
  ring

private lemma cubicT_sq_full_gaussian_bound_uniform :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, ∀ t : ℝ, 1 ≤ t →
        ∫ mu : Cn3Torus.Edge n → ℝ,
            (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
          ≤ (C * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * gaussianF (dim n) t := by
  classical
  refine ⟨1, by norm_num, ?_⟩
  intro n t ht
  have ht_pos : 0 < t := by linarith
  let Tset := triangleTriples n
  have hpair_int :
      ∀ τ ∈ Tset, ∀ τ' ∈ Tset,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          triangleMonomialOn mu τ * triangleMonomialOn mu τ'
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
    intro τ hτ τ' hτ'
    simpa [triangleMonomialOn, (Finset.mem_filter.mp hτ).2, (Finset.mem_filter.mp hτ').2] using
      (trianglePair_integrable τ τ'
        (Finset.mem_filter.mp hτ).2 (Finset.mem_filter.mp hτ').2 t ht_pos)
  have houter_int :
      ∀ τ ∈ Tset,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          Finset.sum Tset (fun τ' =>
            triangleMonomialOn mu τ * triangleMonomialOn mu τ'
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro τ hτ
    exact MeasureTheory.integrable_finset_sum Tset (fun τ' hτ' => hpair_int τ hτ τ' hτ')
  have hpoint :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = Finset.sum Tset (fun τ =>
            Finset.sum Tset (fun τ' =>
              triangleMonomialOn mu τ * triangleMonomialOn mu τ'
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro mu
    have hcubic := cubicT_matrixOfEdge_eq_sum_triangleTriples n mu
    rw [hcubic, pow_two]
    calc
      (Finset.sum Tset (fun τ => triangleMonomialOn mu τ))
          * (Finset.sum Tset (fun τ' => triangleMonomialOn mu τ'))
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = (Finset.sum Tset (fun τ =>
            Finset.sum Tset (fun τ' =>
              triangleMonomialOn mu τ * triangleMonomialOn mu τ')))
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              rw [Finset.sum_mul_sum]
      _ = Finset.sum Tset (fun τ =>
            Finset.sum Tset (fun τ' =>
              triangleMonomialOn mu τ * triangleMonomialOn mu τ'
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl ?_
            intro τ hτ
            rw [Finset.sum_mul]
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          Finset.sum Tset (fun τ =>
            Finset.sum Tset (fun τ' =>
              triangleMonomialOn mu τ * triangleMonomialOn mu τ'
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
            refine MeasureTheory.integral_congr_ae ?_
            exact Filter.Eventually.of_forall hpoint
    _ = Finset.sum Tset (fun τ =>
          Finset.sum Tset (fun τ' =>
            (∫ mu : Cn3Torus.Edge n → ℝ,
              triangleMonomialOn mu τ * triangleMonomialOn mu τ'
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)))) := by
          rw [MeasureTheory.integral_finset_sum Tset houter_int]
          refine Finset.sum_congr rfl ?_
          intro τ hτ
          rw [MeasureTheory.integral_finset_sum Tset (fun τ' hτ' => hpair_int τ hτ τ' hτ')]
    _ = Finset.sum Tset (fun τ => (1 / (4 * t)) ^ (3 : Nat) * gaussianF (dim n) t) := by
          refine Finset.sum_congr rfl ?_
          intro τ hτ
          have hτ_tri : IsTriangleTriple τ := (Finset.mem_filter.mp hτ).2
          rw [Finset.sum_eq_single τ]
          · simpa [triangleMonomialOn, hτ_tri, pow_two, mul_assoc, mul_left_comm, mul_comm] using
              triangle_self_gaussian_integral τ hτ_tri t ht_pos
          · intro τ' hτ' hneq
            have hτ'_tri : IsTriangleTriple τ' := (Finset.mem_filter.mp hτ').2
            have hzero := triangle_pair_gaussian_zero_of_ne τ τ' hτ_tri hτ'_tri hneq.symm t
            simpa [triangleMonomialOn, hτ_tri, hτ'_tri] using hzero
          · intro hnot
            exact False.elim (hnot hτ)
    _ = ((Tset.card : ℝ) * ((1 / (4 * t)) ^ (3 : Nat) * gaussianF (dim n) t)) := by
          rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ ((n : ℝ) ^ (3 : Nat) * (1 / t ^ (3 : Nat))) * gaussianF (dim n) t := by
          have hcard := triangleTriples_card_le_cube n
          have hpow : (1 / (4 * t)) ^ (3 : Nat) ≤ 1 / t ^ (3 : Nat) := by
            field_simp [ht_pos.ne']
            nlinarith
          have hgauss_nonneg : 0 ≤ gaussianF (dim n) t := by
            unfold gaussianF
            positivity
          have hcoeff :
              (Tset.card : ℝ) * (1 / (4 * t)) ^ (3 : Nat)
                ≤ (n : ℝ) ^ (3 : Nat) * (1 / t ^ (3 : Nat)) := by
            exact mul_le_mul hcard hpow (by positivity) (by positivity)
          simpa [mul_assoc, mul_left_comm, mul_comm] using
            mul_le_mul_of_nonneg_right hcoeff hgauss_nonneg
    _ = (1 * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * gaussianF (dim n) t := by
          ring

private lemma cubicT_sq_coreMass_bound_uniform :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, 1 ≤ dim n → ∀ t : ℝ, 1 ≤ t →
        ∫ mu in edgeCoreRegion n t,
            (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
          ≤ (C * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * coreMass (dim n) t := by
  obtain ⟨Cfull, hCfull_pos, hfull⟩ := cubicT_sq_full_gaussian_bound_uniform
  obtain ⟨Ccore, hCcore_pos, hcore⟩ := gaussianF_le_const_mul_coreMass
  refine ⟨Cfull * Ccore, mul_pos hCfull_pos hCcore_pos, ?_⟩
  intro n hd t ht
  let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
      * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  have hf_int :
      MeasureTheory.Integrable f := by
    have ht_pos : 0 < t := by linarith
    simpa [f] using cubicT_sq_gaussian_integrable_edge n t ht_pos
  have hA_meas : MeasurableSet (edgeCoreRegion n t) := measurableSet_edgeCoreRegion n t
  have hind_int : MeasureTheory.Integrable (Set.indicator (edgeCoreRegion n t) f) := by
    exact hf_int.indicator hA_meas
  have hmono_ae :
      ∀ᵐ mu : Cn3Torus.Edge n → ℝ ∂MeasureTheory.volume,
        Set.indicator (edgeCoreRegion n t) f mu ≤ f mu := by
    exact Filter.Eventually.of_forall (fun mu => by
      have hf_nonneg : 0 ≤ f mu := by
        unfold f
        positivity
      by_cases hmu : mu ∈ edgeCoreRegion n t
      · simp [Set.indicator, hmu]
      · simp [Set.indicator, hmu, hf_nonneg])
  have hset_le_full :
      ∫ mu in edgeCoreRegion n t, f mu ≤ ∫ mu, f mu := by
    have hmono' := MeasureTheory.integral_mono_ae hind_int hf_int hmono_ae
    simpa [f, hA_meas, MeasureTheory.integral_indicator] using hmono'
  have htR : (1 : ℝ) ≤ t := ht
  have hgauss_core :
      gaussianF (dim n) t ≤ Ccore * coreMass (dim n) t := hcore (dim n) t hd htR
  have hcoeff_nonneg : 0 ≤ Cfull * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat) := by positivity
  calc
    ∫ mu in edgeCoreRegion n t,
        (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu in edgeCoreRegion n t, f mu := by rfl
    _ ≤ ∫ mu, f mu := hset_le_full
    _ ≤ (Cfull * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * gaussianF (dim n) t := hfull n t ht
    _ ≤ (Cfull * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * (Ccore * coreMass (dim n) t) := by
          exact mul_le_mul_of_nonneg_left hgauss_core hcoeff_nonneg
    _ = ((Cfull * Ccore) * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * coreMass (dim n) t := by
          rw [div_eq_mul_inv, div_eq_mul_inv]
          ring

/-- Ordered quadruples `i < j < k < l` indexing the three quartic cycle monomials. -/
private abbrev SimpleCycle4Index (n : ℕ) := Fin n × (Fin n × (Fin n × Fin n))

private def IsSimpleCycle4Index {n : ℕ} (σ : SimpleCycle4Index n) : Prop :=
  σ.1 < σ.2.1 ∧ σ.2.1 < σ.2.2.1 ∧ σ.2.2.1 < σ.2.2.2

private instance {n : ℕ} : DecidablePred (@IsSimpleCycle4Index n) := by
  intro σ
  unfold IsSimpleCycle4Index
  infer_instance

private inductive QuarticCycleShape where
  | first
  | second
  | third
  deriving DecidableEq, Fintype

private lemma quarticCycleShape_univ :
    (Finset.univ : Finset QuarticCycleShape)
      = ({QuarticCycleShape.first, QuarticCycleShape.second, QuarticCycleShape.third}
          : Finset QuarticCycleShape) := by
  ext s
  cases s <;> simp

private lemma quarticCycleShape_card :
    Fintype.card QuarticCycleShape = 3 := by
  calc
    Fintype.card QuarticCycleShape = ((Finset.univ : Finset QuarticCycleShape).card : ℕ) := by
      simp
    _ = 3 := by
      rw [quarticCycleShape_univ]
      simp

private def simpleCycle4Indices (n : ℕ) : Finset (SimpleCycle4Index n × QuarticCycleShape) := by
  classical
  exact Finset.univ.filter (fun ξ => IsSimpleCycle4Index ξ.1)

private lemma simpleCycle4Indices_card_le_dim_sq (n : ℕ) :
    ((simpleCycle4Indices n).card : ℝ) ≤ 48 * (dim n : ℝ) ^ (2 : Nat) := by
  classical
  by_cases hn : n < 2
  · have hcard_zero : (simpleCycle4Indices n).card = 0 := by
      cases n with
      | zero =>
          simp [simpleCycle4Indices]
      | succ n =>
          cases n with
          | zero =>
              simp [simpleCycle4Indices, IsSimpleCycle4Index]
          | succ n =>
              omega
    simp [hcard_zero]
  · have hn2 : 2 ≤ n := by omega
    have hcard_nat :
        (simpleCycle4Indices n).card
          ≤ Fintype.card (SimpleCycle4Index n × QuarticCycleShape) := by
      simpa [simpleCycle4Indices] using
        (Finset.card_filter_le
          (s := (Finset.univ : Finset (SimpleCycle4Index n × QuarticCycleShape)))
          (p := fun ξ => IsSimpleCycle4Index ξ.1))
    have hshape : Fintype.card QuarticCycleShape = 3 := quarticCycleShape_card
    have hcard_type :
        Fintype.card (SimpleCycle4Index n × QuarticCycleShape) = 3 * n ^ (4 : Nat) := by
      simp [SimpleCycle4Index, hshape, pow_succ, mul_assoc, mul_left_comm, mul_comm]
    have hcard_real :
        ((simpleCycle4Indices n).card : ℝ) ≤ 3 * (n : ℝ) ^ (4 : Nat) := by
      have hcard_nat' : (simpleCycle4Indices n).card ≤ 3 * n ^ (4 : Nat) := by
        rw [hcard_type] at hcard_nat
        exact hcard_nat
      exact_mod_cast hcard_nat'
    have hn_sq : (n : ℝ) ^ (2 : Nat) ≤ 4 * (dim n : ℝ) := n_sq_le_four_mul_dim hn2
    have hdim_nonneg : 0 ≤ (dim n : ℝ) := by positivity
    have hpow :
        (n : ℝ) ^ (4 : Nat) ≤ (4 * (dim n : ℝ)) ^ (2 : Nat) := by
      nlinarith [hn_sq]
    calc
      ((simpleCycle4Indices n).card : ℝ) ≤ 3 * (n : ℝ) ^ (4 : Nat) := hcard_real
      _ ≤ 3 * (4 * (dim n : ℝ)) ^ (2 : Nat) := by
            gcongr
      _ = 48 * (dim n : ℝ) ^ (2 : Nat) := by ring

private def quarticV1 {n : ℕ} (σ : SimpleCycle4Index n) : Fin n := σ.1
private def quarticV2 {n : ℕ} (σ : SimpleCycle4Index n) : Fin n := σ.2.1
private def quarticV3 {n : ℕ} (σ : SimpleCycle4Index n) : Fin n := σ.2.2.1
private def quarticV4 {n : ℕ} (σ : SimpleCycle4Index n) : Fin n := σ.2.2.2

private def quarticVertices {n : ℕ} (σ : SimpleCycle4Index n) : Finset (Fin n) :=
  {quarticV1 σ, quarticV2 σ, quarticV3 σ, quarticV4 σ}

private lemma quarticVertices_card {n : ℕ} (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) :
    (quarticVertices σ).card = 4 := by
  have h12 : quarticV1 σ ≠ quarticV2 σ := ne_of_lt hσ.1
  have h13 : quarticV1 σ ≠ quarticV3 σ := ne_of_lt (lt_trans hσ.1 hσ.2.1)
  have h14 : quarticV1 σ ≠ quarticV4 σ := ne_of_lt (lt_trans (lt_trans hσ.1 hσ.2.1) hσ.2.2)
  have h23 : quarticV2 σ ≠ quarticV3 σ := ne_of_lt hσ.2.1
  have h24 : quarticV2 σ ≠ quarticV4 σ := ne_of_lt (lt_trans hσ.2.1 hσ.2.2)
  have h34 : quarticV3 σ ≠ quarticV4 σ := ne_of_lt hσ.2.2
  simp [quarticVertices, h12, h13, h14, h23, h24, h34]

private lemma quarticV1_le_of_mem_vertices {n : ℕ} (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ)
    {v : Fin n} (hv : v ∈ quarticVertices σ) :
    quarticV1 σ ≤ v := by
  have hv' :
      v = quarticV1 σ ∨ v = quarticV2 σ ∨ v = quarticV3 σ ∨ v = quarticV4 σ := by
    simpa [quarticVertices] using hv
  rcases hv' with rfl | rfl | rfl | rfl
  · exact le_rfl
  · exact le_of_lt hσ.1
  · exact le_of_lt (lt_trans hσ.1 hσ.2.1)
  · exact le_of_lt (lt_trans (lt_trans hσ.1 hσ.2.1) hσ.2.2)

private lemma le_quarticV4_of_mem_vertices {n : ℕ} (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ)
    {v : Fin n} (hv : v ∈ quarticVertices σ) :
    v ≤ quarticV4 σ := by
  have hv' :
      v = quarticV1 σ ∨ v = quarticV2 σ ∨ v = quarticV3 σ ∨ v = quarticV4 σ := by
    simpa [quarticVertices] using hv
  rcases hv' with rfl | rfl | rfl | rfl
  · exact le_of_lt (lt_trans (lt_trans hσ.1 hσ.2.1) hσ.2.2)
  · exact le_of_lt (lt_trans hσ.2.1 hσ.2.2)
  · exact le_of_lt hσ.2.2
  · exact le_rfl

private lemma simpleCycle4Index_eq_of_vertices_eq {n : ℕ}
    (σ σ' : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) (hσ' : IsSimpleCycle4Index σ')
    (hV : quarticVertices σ = quarticVertices σ') :
    σ = σ' := by
  have h1mem : quarticV1 σ ∈ quarticVertices σ' := by
    rw [← hV]
    simp [quarticVertices]
  have h1mem' : quarticV1 σ' ∈ quarticVertices σ := by
    rw [hV]
    simp [quarticVertices]
  have h1le : quarticV1 σ' ≤ quarticV1 σ :=
    quarticV1_le_of_mem_vertices σ' hσ' h1mem
  have h1le' : quarticV1 σ ≤ quarticV1 σ' :=
    quarticV1_le_of_mem_vertices σ hσ h1mem'
  have h1 : quarticV1 σ = quarticV1 σ' := le_antisymm h1le' h1le
  have h4mem : quarticV4 σ ∈ quarticVertices σ' := by
    rw [← hV]
    simp [quarticVertices]
  have h4mem' : quarticV4 σ' ∈ quarticVertices σ := by
    rw [hV]
    simp [quarticVertices]
  have h4le : quarticV4 σ ≤ quarticV4 σ' :=
    le_quarticV4_of_mem_vertices σ' hσ' h4mem
  have h4le' : quarticV4 σ' ≤ quarticV4 σ :=
    le_quarticV4_of_mem_vertices σ hσ h4mem'
  have h4 : quarticV4 σ = quarticV4 σ' := le_antisymm h4le h4le'
  have h2mem : quarticV2 σ ∈ quarticVertices σ' := by
    rw [← hV]
    simp [quarticVertices]
  have h2 :
      quarticV2 σ = quarticV2 σ' := by
    have hcases :
        quarticV2 σ = quarticV1 σ' ∨
          quarticV2 σ = quarticV2 σ' ∨
          quarticV2 σ = quarticV3 σ' ∨
          quarticV2 σ = quarticV4 σ' := by
      simpa [quarticVertices] using h2mem
    rcases hcases with h | h | h | h
    · exfalso
      have hcontra : quarticV1 σ < quarticV1 σ := by
        calc
          quarticV1 σ < quarticV2 σ := hσ.1
          _ = quarticV1 σ' := h
          _ = quarticV1 σ := h1.symm
      exact (lt_irrefl _) hcontra
    · exact h
    · exfalso
      have h3mem : quarticV3 σ ∈ quarticVertices σ' := by
        rw [← hV]
        simp [quarticVertices]
      have h3cases :
          quarticV3 σ = quarticV1 σ' ∨
            quarticV3 σ = quarticV2 σ' ∨
            quarticV3 σ = quarticV3 σ' ∨
            quarticV3 σ = quarticV4 σ' := by
        simpa [quarticVertices] using h3mem
      rcases h3cases with h3 | h3 | h3 | h3
      · have hcontra : quarticV1 σ' < quarticV1 σ' := by
          calc
            quarticV1 σ' < quarticV2 σ' := hσ'.1
            _ < quarticV3 σ' := hσ'.2.1
            _ = quarticV2 σ := h.symm
            _ < quarticV3 σ := hσ.2.1
            _ = quarticV1 σ' := h3
        exact (lt_irrefl _) hcontra
      · have hcontra : quarticV3 σ' < quarticV2 σ' := by
          calc
            quarticV3 σ' = quarticV2 σ := h.symm
            _ < quarticV3 σ := hσ.2.1
            _ = quarticV2 σ' := h3
        exact (not_lt_of_ge (le_of_lt hσ'.2.1)) hcontra
      · have hcontra : quarticV3 σ' < quarticV3 σ' := by
          calc
            quarticV3 σ' = quarticV2 σ := h.symm
            _ < quarticV3 σ := hσ.2.1
            _ = quarticV3 σ' := h3
        exact (lt_irrefl _) hcontra
      · have hcontra : quarticV3 σ < quarticV3 σ := by
          calc
            quarticV3 σ < quarticV4 σ := hσ.2.2
            _ = quarticV4 σ' := h4
            _ = quarticV3 σ := h3.symm
        exact (lt_irrefl _) hcontra
    · exfalso
      have hcontra : quarticV4 σ' < quarticV4 σ' := by
        calc
          quarticV4 σ' = quarticV2 σ := h.symm
          _ < quarticV4 σ := lt_trans hσ.2.1 hσ.2.2
          _ = quarticV4 σ' := h4
      exact (lt_irrefl _) hcontra
  have h3mem : quarticV3 σ ∈ quarticVertices σ' := by
    rw [← hV]
    simp [quarticVertices]
  have h3 :
      quarticV3 σ = quarticV3 σ' := by
    have hcases :
        quarticV3 σ = quarticV1 σ' ∨
          quarticV3 σ = quarticV2 σ' ∨
          quarticV3 σ = quarticV3 σ' ∨
          quarticV3 σ = quarticV4 σ' := by
      simpa [quarticVertices] using h3mem
    rcases hcases with h | h | h | h
    · exfalso
      have hcontra : quarticV1 σ' < quarticV1 σ' := by
        calc
          quarticV1 σ' < quarticV2 σ' := hσ'.1
          _ = quarticV2 σ := h2.symm
          _ < quarticV3 σ := hσ.2.1
          _ = quarticV1 σ' := h
      exact (lt_irrefl _) hcontra
    · exfalso
      have hcontra : quarticV2 σ < quarticV2 σ := by
        calc
          quarticV2 σ < quarticV3 σ := hσ.2.1
          _ = quarticV2 σ' := h
          _ = quarticV2 σ := h2.symm
      exact (lt_irrefl _) hcontra
    · exact h
    · exfalso
      have hcontra : quarticV4 σ' < quarticV4 σ' := by
        calc
          quarticV4 σ' = quarticV3 σ := h.symm
          _ < quarticV4 σ := hσ.2.2
          _ = quarticV4 σ' := h4
      exact (lt_irrefl _) hcontra
  cases σ with
  | mk a bcd =>
      cases bcd with
      | mk b cd =>
          cases cd with
          | mk c d =>
              cases σ' with
              | mk a' bcd' =>
                  cases bcd' with
                  | mk b' cd' =>
                      cases cd' with
                      | mk c' d' =>
                          simp [quarticV1, quarticV2, quarticV3, quarticV4] at h1 h2 h3 h4
                          subst h1 h2 h3 h4
                          rfl

private def quarticEdge12 {n : ℕ} (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) :
    Cn3Torus.Edge n :=
  ⟨(quarticV1 σ, quarticV2 σ), hσ.1⟩

private def quarticEdge13 {n : ℕ} (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) :
    Cn3Torus.Edge n :=
  ⟨(quarticV1 σ, quarticV3 σ), lt_trans hσ.1 hσ.2.1⟩

private def quarticEdge14 {n : ℕ} (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) :
    Cn3Torus.Edge n :=
  ⟨(quarticV1 σ, quarticV4 σ), lt_trans (lt_trans hσ.1 hσ.2.1) hσ.2.2⟩

private def quarticEdge23 {n : ℕ} (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) :
    Cn3Torus.Edge n :=
  ⟨(quarticV2 σ, quarticV3 σ), hσ.2.1⟩

private def quarticEdge24 {n : ℕ} (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) :
    Cn3Torus.Edge n :=
  ⟨(quarticV2 σ, quarticV4 σ), lt_trans hσ.2.1 hσ.2.2⟩

private def quarticEdge34 {n : ℕ} (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) :
    Cn3Torus.Edge n :=
  ⟨(quarticV3 σ, quarticV4 σ), hσ.2.2⟩

private lemma quarticEdge12_ne_13 {n : ℕ} (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) :
    quarticEdge12 σ hσ ≠ quarticEdge13 σ hσ := by
  intro h
  have hsnd : quarticV2 σ = quarticV3 σ := by
    simpa [quarticEdge12, quarticEdge13, quarticV1, quarticV2, quarticV3] using
      congrArg Prod.snd (congrArg Subtype.val h)
  exact (ne_of_lt hσ.2.1) hsnd

private lemma quarticEdge12_ne_14 {n : ℕ} (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) :
    quarticEdge12 σ hσ ≠ quarticEdge14 σ hσ := by
  intro h
  have hsnd : quarticV2 σ = quarticV4 σ := by
    simpa [quarticEdge12, quarticEdge14, quarticV1, quarticV2, quarticV4] using
      congrArg Prod.snd (congrArg Subtype.val h)
  exact (ne_of_lt (lt_trans hσ.2.1 hσ.2.2)) hsnd

