    exact le_trans (quarticChoiceSupport_incident_card_eq_two (quarticQuad4 q) hi₄) hmono

private lemma sum_filter_card_edgesIncident_eq_two_mul_card_aux {n : ℕ}
    (S : Finset (Cn3Torus.Edge n)) :
    ∑ i : Fin n, (S.filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card = 2 * S.card := by
  classical
  have htwo :
      ∀ e : Cn3Torus.Edge n,
        ∑ i : Fin n, (if e ∈ Cn3Torus.edgesIncident n i then 1 else 0) = 2 := by
    intro e
    rcases e with ⟨⟨u, v⟩, huv⟩
    let e' : Cn3Torus.Edge n := ⟨(u, v), huv⟩
    have hfilter :
        ((Finset.univ : Finset (Fin n)).filter (fun i => e' ∈ Cn3Torus.edgesIncident n i))
          = ({u, v} : Finset (Fin n)) := by
      ext i
      simp [e', Cn3Torus.mem_edgesIncident_iff, Finset.mem_insert, Finset.mem_singleton,
        eq_comm, ne_of_lt huv]
    calc
      ∑ i : Fin n, (if e' ∈ Cn3Torus.edgesIncident n i then 1 else 0)
        = Finset.sum
            (((Finset.univ : Finset (Fin n)).filter
              (fun i => e' ∈ Cn3Torus.edgesIncident n i)))
            (fun _ => (1 : ℕ)) := by
            rw [← Finset.sum_filter]
      _ = Finset.sum ({u, v} : Finset (Fin n)) (fun _ => (1 : ℕ)) := by
            rw [hfilter]
      _ = 2 := by
            simp [ne_of_lt huv]
  have hcount :
      ∀ i : Fin n,
        (S.filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card
          = S.sum (fun e => if e ∈ Cn3Torus.edgesIncident n i then 1 else 0) := by
    intro i
    calc
      (S.filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card
        = (S.filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).sum (fun _ => 1) := by simp
      _ = S.sum (fun e => if e ∈ Cn3Torus.edgesIncident n i then 1 else 0) := by
            rw [Finset.sum_filter]
  calc
    ∑ i : Fin n, (S.filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card
      = Finset.univ.sum (fun i : Fin n =>
          S.sum (fun e => if e ∈ Cn3Torus.edgesIncident n i then 1 else 0)) := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          exact hcount i
    _ = S.sum (fun e => Finset.univ.sum (fun i : Fin n =>
          if e ∈ Cn3Torus.edgesIncident n i then 1 else 0)) := by
          rw [Finset.sum_comm]
    _ = S.sum (fun e => 2) := by
          refine Finset.sum_congr rfl ?_
          intro e he
          exact htwo e
    _ = 2 * S.card := by
          simp [Nat.mul_comm]

private lemma quarticQuadrupleVertices_card_le_support_card_of_even {n : ℕ}
    (q : QuarticCycleQuadruple n) (heven : quarticQuadrupleEven q) :
    (quarticQuadrupleVertices q).card ≤ (quarticQuadrupleSupport q).card := by
  have hverts :
      2 * (quarticQuadrupleVertices q).card
        ≤ ∑ i : Fin n,
            ((quarticQuadrupleSupport q).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
    calc
      2 * (quarticQuadrupleVertices q).card
          = ∑ i : Fin n, if i ∈ quarticQuadrupleVertices q then 2 else 0 := by
              rw [Nat.mul_comm]
              simp
      _ ≤ ∑ i : Fin n,
            ((quarticQuadrupleSupport q).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
            refine Finset.sum_le_sum ?_
            intro i hi
            by_cases himem : i ∈ quarticQuadrupleVertices q
            · simpa [himem] using quarticQuadruple_incident_card_ge_two_of_mem_vertices q heven himem
            · simp [himem]
  have hsum := sum_filter_card_edgesIncident_eq_two_mul_card_aux (quarticQuadrupleSupport q)
  have : 2 * (quarticQuadrupleVertices q).card ≤ 2 * (quarticQuadrupleSupport q).card := by
    simpa [hsum] using hverts
  omega

private lemma quarticChoice_eq_of_vertices_eq_shape_eq {n : ℕ}
    {ξ η : QuarticCycleChoice n}
