private lemma quarticEvenQuadrupleFiber_card_le_fourSetChoices
    {n : ℕ} (A : Finset (Fin n)) :
    ((quarticEvenQuadrupleFiber n A).card : ℝ)
      ≤ ((((Finset.powersetCard 4 A).card : ℝ) * 3) ^ (4 : Nat)) := by
  classical
  let ChoiceA := ↥(Finset.powersetCard 4 A) × QuarticCycleShape
  let map : quarticEvenQuadrupleFiber n A →
      ChoiceA × (ChoiceA × (ChoiceA × ChoiceA)) := fun q =>
    let hAq : quarticQuadrupleVertices q.1 = A := (Finset.mem_filter.mp q.2).2
    let hmem1 : quarticChoiceVertices (quarticQuad1 q.1) ∈ Finset.powersetCard 4 A := by
