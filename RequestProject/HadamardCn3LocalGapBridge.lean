  apply Subtype.ext
  apply Prod.ext
  · exact simpleCycle4Index_eq_of_vertices_eq
      ξ.1.1 η.1.1 (quarticChoice_valid ξ) (quarticChoice_valid η) hV
  · exact hs

private lemma quarticEvenQuadruples_eq_biUnion_activeFibers (n : ℕ) :
    quarticEvenQuadruples n
