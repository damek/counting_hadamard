    exact Real.rpow_nonneg (by positivity) _
  have hB_factor_nonneg :
      0 ≤ (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
    exact Real.rpow_nonneg hB_nonneg _
  calc
    ∫ x, f x * g x ∂μ
      ≤ (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
          * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := hcs
    _ ≤ ((Ccub4 * (n : ℝ) ^ (6 : Nat) / t ^ (6 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ))
          * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
            exact mul_le_mul_of_nonneg_right hA_rpow hB_factor_nonneg
    _ ≤ ((Ccub4 * (n : ℝ) ^ (6 : Nat) / t ^ (6 : Nat)) * gaussianF (dim n) t) ^ (1 / (2 : ℝ))
          * (Real.exp 32 * gaussianF (dim n) t) ^ (1 / (2 : ℝ)) := by
            exact mul_le_mul_of_nonneg_left hB_rpow hA_bound_nonneg
    _ = (Real.sqrt Ccub4 * Real.sqrt (Real.exp 32) * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
          * gaussianF (dim n) t := by
            let G : ℝ := gaussianF (dim n) t
            let u : ℝ := (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)
            have hG_nonneg : 0 ≤ G := by
              dsimp [G]
              exact Real.rpow_nonneg (by positivity) _
            have hu_nonneg : 0 ≤ u := by
              dsimp [u]
              positivity
            have hu_sq : u ^ (2 : Nat) = (n : ℝ) ^ (6 : Nat) / t ^ (6 : Nat) := by
              dsimp [u]
              ring
            have hArew :
                (Ccub4 * (n : ℝ) ^ (6 : Nat) / t ^ (6 : Nat)) * G = Ccub4 * u ^ (2 : Nat) * G := by
              rw [hu_sq]
              ring
            rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow]
            calc
              Real.sqrt ((Ccub4 * (n : ℝ) ^ (6 : Nat) / t ^ (6 : Nat)) * G)
                  * Real.sqrt (Real.exp 32 * G)
                = ((Real.sqrt (Ccub4 * u ^ (2 : Nat))) * Real.sqrt G)
                    * (Real.sqrt (Real.exp 32) * Real.sqrt G) := by
                      rw [hArew, show Ccub4 * u ^ (2 : Nat) * G = (Ccub4 * u ^ (2 : Nat)) * G by ring]
                      rw [Real.sqrt_mul (by positivity) G]
                      rw [show Real.exp 32 * G = (Real.exp 32) * G by ring]
                      rw [Real.sqrt_mul (by positivity) G]
              _ = ((Real.sqrt Ccub4 * u) * Real.sqrt G)
                    * (Real.sqrt (Real.exp 32) * Real.sqrt G) := by
                      rw [Real.sqrt_mul (by positivity) (u ^ (2 : Nat))]
                      rw [Real.sqrt_sq_eq_abs, abs_of_nonneg hu_nonneg]
              _ = Real.sqrt Ccub4 * Real.sqrt (Real.exp 32)
                    * (u * (Real.sqrt G * Real.sqrt G)) := by
                      ring
              _ = Real.sqrt Ccub4 * Real.sqrt (Real.exp 32) * (u * G) := by
                      congr 2
                      nlinarith [Real.sq_sqrt hG_nonneg]
              _ = (Real.sqrt Ccub4 * Real.sqrt (Real.exp 32) * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                    * G := by
                      dsimp [u]
                      ring
              _ = (Real.sqrt Ccub4 * Real.sqrt (Real.exp 32) * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                    * gaussianF (dim n) t := by
                      rfl

