      have hEven : Even (3 + ((if True then 1 else 0) + if False then 1 else 0)) := by
        norm_num
      simpa [quinticThreeOneOneTuple, Cn3Torus.edgeNatRowSum_edgeMultiplicity5,
        he23, he12, he13, add_assoc, add_left_comm, add_comm] using hEven
    · by_cases hi3 : i = triangleV3 τ
      · subst i
        have he23 : triangleEdge23 τ hτ ∈ Cn3Torus.edgesIncident n (triangleV3 τ) := by
          exact (triangleEdge23_mem_edgesIncident_iff τ hτ (triangleV3 τ)).2 (Or.inr rfl)
        have he12 : triangleEdge12 τ hτ ∉ Cn3Torus.edgesIncident n (triangleV3 τ) := by
          intro h
          rcases (triangleEdge12_mem_edgesIncident_iff τ hτ (triangleV3 τ)).1 h with h1 | h2
          · exact (ne_of_lt (lt_trans hτ.1 hτ.2)) h1.symm
          · exact (ne_of_lt hτ.2) h2.symm
        have he13 : triangleEdge13 τ hτ ∈ Cn3Torus.edgesIncident n (triangleV3 τ) := by
          exact (triangleEdge13_mem_edgesIncident_iff τ hτ (triangleV3 τ)).2 (Or.inr rfl)
        have hEven : Even (3 + ((if False then 1 else 0) + if True then 1 else 0)) := by
          norm_num
        simpa [quinticThreeOneOneTuple, Cn3Torus.edgeNatRowSum_edgeMultiplicity5,
          he23, he12, he13, add_assoc, add_left_comm, add_comm] using hEven
      · have he23 : triangleEdge23 τ hτ ∉ Cn3Torus.edgesIncident n i := by
          intro h
          rcases (triangleEdge23_mem_edgesIncident_iff τ hτ i).1 h with h2 | h3
          · exact hi2 h2
          · exact hi3 h3
        have he12 : triangleEdge12 τ hτ ∉ Cn3Torus.edgesIncident n i := by
          intro h
          rcases (triangleEdge12_mem_edgesIncident_iff τ hτ i).1 h with h1 | h2
          · exact hi1 h1
          · exact hi2 h2
        have he13 : triangleEdge13 τ hτ ∉ Cn3Torus.edgesIncident n i := by
          intro h
          rcases (triangleEdge13_mem_edgesIncident_iff τ hτ i).1 h with h1 | h3
          · exact hi1 h1
          · exact hi3 h3
        have hEven : Even ((if False then 1 else 0) + if False then 1 else 0) := by
          norm_num
        simpa [quinticThreeOneOneTuple, Cn3Torus.edgeNatRowSum_edgeMultiplicity5,
          he23, he12, he13, add_assoc, add_left_comm, add_comm] using hEven

private lemma quinticTriangleRepeatMultiplicity_gate_one {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    {p : EdgeQuintuple n}
    (hp : quinticMomentTupleMultiplicity p = quinticTriangleRepeatMultiplicity τ hτ s) :
    quinticMomentTupleGate p = 1 := by
  cases s with
  | edge12 =>
      let q : EdgeQuintuple n :=
        quinticThreeOneOneTuple
          (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)
      have hqmult :
          quinticMomentTupleMultiplicity q
            = quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge12 := by
        exact quinticThreeOneOneTuple_triangle_edge12_eq_repeat τ hτ
      have hEq : quinticMomentTupleMultiplicity p = quinticMomentTupleMultiplicity q := by
        rw [hp, hqmult]
      rw [quinticMomentTupleGate_congr_of_multiplicity_eq hEq]
      exact quinticThreeOneOneTuple_triangle_edge12_gate_one τ hτ
  | edge13 =>
      let q : EdgeQuintuple n :=
        quinticThreeOneOneTuple
          (triangleEdge13 τ hτ) (triangleEdge12 τ hτ) (triangleEdge23 τ hτ)
      have hqmult :
          quinticMomentTupleMultiplicity q
            = quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge13 := by
        exact quinticThreeOneOneTuple_triangle_edge13_eq_repeat τ hτ
      have hEq : quinticMomentTupleMultiplicity p = quinticMomentTupleMultiplicity q := by
        rw [hp, hqmult]
      rw [quinticMomentTupleGate_congr_of_multiplicity_eq hEq]
      exact quinticThreeOneOneTuple_triangle_edge13_gate_one τ hτ
  | edge23 =>
      let q : EdgeQuintuple n :=
        quinticThreeOneOneTuple
          (triangleEdge23 τ hτ) (triangleEdge12 τ hτ) (triangleEdge13 τ hτ)
      have hqmult :
          quinticMomentTupleMultiplicity q
            = quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge23 := by
        exact quinticThreeOneOneTuple_triangle_edge23_eq_repeat τ hτ
      have hEq : quinticMomentTupleMultiplicity p = quinticMomentTupleMultiplicity q := by
        rw [hp, hqmult]
      rw [quinticMomentTupleGate_congr_of_multiplicity_eq hEq]
      exact quinticThreeOneOneTuple_triangle_edge23_gate_one τ hτ

private lemma quinticTriangleRepeatMultiplicity_support_eq {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    {p : EdgeQuintuple n}
    (hp : quinticMomentTupleMultiplicity p = quinticTriangleRepeatMultiplicity τ hτ s) :
    quinticMomentTupleSupport p = triangleEdgeSet τ hτ := by
  ext e
  rw [mem_quinticMomentTupleSupport_iff]
  cases s with
  | edge12 =>
      let q : EdgeQuintuple n :=
        quinticThreeOneOneTuple
          (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)
      have hqmult :
          quinticMomentTupleMultiplicity q
            = quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge12 := by
        exact quinticThreeOneOneTuple_triangle_edge12_eq_repeat τ hτ
      have hqsupport :
          quinticMomentTupleSupport q = triangleEdgeSet τ hτ := by
        rw [quinticThreeOneOneTuple_support
          (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)]
        · rfl
        · exact triangleEdge12_ne_13 τ hτ
        · exact triangleEdge12_ne_23 τ hτ
        · exact triangleEdge13_ne_23 τ hτ
      have hmemq : e ∈ quinticMomentTupleSupport q ↔ e ∈ triangleEdgeSet τ hτ := by
        rw [hqsupport]
      simpa [mem_quinticMomentTupleSupport_iff, hp, hqmult] using hmemq
  | edge13 =>
      let q : EdgeQuintuple n :=
        quinticThreeOneOneTuple
          (triangleEdge13 τ hτ) (triangleEdge12 τ hτ) (triangleEdge23 τ hτ)
      have hqmult :
          quinticMomentTupleMultiplicity q
            = quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge13 := by
        exact quinticThreeOneOneTuple_triangle_edge13_eq_repeat τ hτ
      have hqsupport :
          quinticMomentTupleSupport q = triangleEdgeSet τ hτ := by
        rw [quinticThreeOneOneTuple_support
          (triangleEdge13 τ hτ) (triangleEdge12 τ hτ) (triangleEdge23 τ hτ)]
        · ext t
          simp [triangleEdgeSet, or_assoc, or_left_comm, or_comm]
        · exact (triangleEdge12_ne_13 τ hτ).symm
        · exact triangleEdge13_ne_23 τ hτ
        · exact triangleEdge12_ne_23 τ hτ
      have hmemq : e ∈ quinticMomentTupleSupport q ↔ e ∈ triangleEdgeSet τ hτ := by
        rw [hqsupport]
      simpa [mem_quinticMomentTupleSupport_iff, hp, hqmult] using hmemq
  | edge23 =>
      let q : EdgeQuintuple n :=
        quinticThreeOneOneTuple
          (triangleEdge23 τ hτ) (triangleEdge12 τ hτ) (triangleEdge13 τ hτ)
      have hqmult :
          quinticMomentTupleMultiplicity q
            = quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge23 := by
        exact quinticThreeOneOneTuple_triangle_edge23_eq_repeat τ hτ
      have hqsupport :
          quinticMomentTupleSupport q = triangleEdgeSet τ hτ := by
        rw [quinticThreeOneOneTuple_support
          (triangleEdge23 τ hτ) (triangleEdge12 τ hτ) (triangleEdge13 τ hτ)]
        · ext t
          simp [triangleEdgeSet, or_assoc, or_left_comm, or_comm]
        · exact (triangleEdge12_ne_23 τ hτ).symm
        · exact (triangleEdge13_ne_23 τ hτ).symm
        · exact triangleEdge12_ne_13 τ hτ
      have hmemq : e ∈ quinticMomentTupleSupport q ↔ e ∈ triangleEdgeSet τ hτ := by
        rw [hqsupport]
      simpa [mem_quinticMomentTupleSupport_iff, hp, hqmult] using hmemq

private lemma quinticTriangleRepeatMultiplicity_mem_supportThree {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    {p : EdgeQuintuple n}
    (hp : quinticMomentTupleMultiplicity p = quinticTriangleRepeatMultiplicity τ hτ s) :
    p ∈ quinticGateSupportThreeTuples n := by
  rw [mem_quinticGateSupportThreeTuples_iff]
  refine ⟨quinticTriangleRepeatMultiplicity_gate_one τ hτ s hp, ?_⟩
  rw [quinticTriangleRepeatMultiplicity_support_eq τ hτ s hp, triangleEdgeSet_card]

private abbrev quinticTriangleRepeatIndices (n : ℕ) : Finset (TriangleTriple n × TriangleEdgeShape) :=
  (triangleTriples n).product (Finset.univ : Finset TriangleEdgeShape)

private def quinticTriangleRepeatMultiplicityFiberPairOn {n : ℕ}
    (u : TriangleTriple n × TriangleEdgeShape) : Finset (EdgeQuintuple n) := by
  classical
  exact if hτ : IsTriangleTriple u.1 then quinticTriangleRepeatMultiplicityFiber u.1 hτ u.2 else ∅

private lemma mem_quinticTriangleRepeatMultiplicityFiberPairOn_iff {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    {p : EdgeQuintuple n} :
    p ∈ quinticTriangleRepeatMultiplicityFiberPairOn (τ, s) ↔
      quinticMomentTupleMultiplicity p = quinticTriangleRepeatMultiplicity τ hτ s := by
  simp [quinticTriangleRepeatMultiplicityFiberPairOn, hτ,
    mem_quinticTriangleRepeatMultiplicityFiber_iff]

private lemma disjoint_quinticTriangleRepeatMultiplicityFiberPairOn {n : ℕ}
    {u v : TriangleTriple n × TriangleEdgeShape}
    (hu : u ∈ quinticTriangleRepeatIndices n)
    (hv : v ∈ quinticTriangleRepeatIndices n)
    (huv : u ≠ v) :
    Disjoint (quinticTriangleRepeatMultiplicityFiberPairOn u)
      (quinticTriangleRepeatMultiplicityFiberPairOn v) := by
  classical
  rcases u with ⟨τ, s⟩
  rcases v with ⟨τ', s'⟩
  have hτmem : τ ∈ triangleTriples n := (Finset.mem_product.mp hu).1
  have hτ'mem : τ' ∈ triangleTriples n := (Finset.mem_product.mp hv).1
  have hτ : IsTriangleTriple τ := by
    simpa [triangleTriples] using (Finset.mem_filter.mp hτmem).2
  have hτ' : IsTriangleTriple τ' := by
    simpa [triangleTriples] using (Finset.mem_filter.mp hτ'mem).2
  refine Finset.disjoint_left.mpr ?_
  intro p hp hp'
  rw [mem_quinticTriangleRepeatMultiplicityFiberPairOn_iff τ hτ s] at hp
  rw [mem_quinticTriangleRepeatMultiplicityFiberPairOn_iff τ' hτ' s'] at hp'
  have hsupp : triangleEdgeSet τ hτ = triangleEdgeSet τ' hτ' := by
    calc
      triangleEdgeSet τ hτ = quinticMomentTupleSupport p := by
        symm
        exact quinticTriangleRepeatMultiplicity_support_eq τ hτ s hp
      _ = triangleEdgeSet τ' hτ' := by
        exact quinticTriangleRepeatMultiplicity_support_eq τ' hτ' s' hp'
  have hτeq : τ = τ' := triangleTriple_eq_of_triangleEdgeSet_eq τ τ' hτ hτ' hsupp
  subst τ'
  have hτself : IsTriangleTriple τ := by
    simpa [triangleTriples] using (Finset.mem_filter.mp hτmem).2
  have hp'' :
      quinticMomentTupleMultiplicity p = quinticTriangleRepeatMultiplicity τ hτself s' := by
    simpa using hp'
  have hseq : s = s' := by
    exact quinticTriangleRepeatMultiplicity_injective τ hτself (by rw [← hp, hp''])
  exact huv (Prod.ext rfl hseq)

private lemma quinticGateSupportThreeTuples_eq_biUnion_triangleRepeatFibers (n : ℕ) :
    quinticGateSupportThreeTuples n
      = (quinticTriangleRepeatIndices n).biUnion
          quinticTriangleRepeatMultiplicityFiberPairOn := by
  classical
  ext p
  constructor
  · intro hp
    rcases quintic_gate_support_three_is_triangle_repeat hp with ⟨τ, hτ, s, -, hmult⟩
    have hu : (τ, s) ∈ quinticTriangleRepeatIndices n := by
      simp [quinticTriangleRepeatIndices, triangleTriples, hτ]
    rw [Finset.mem_biUnion]
    refine ⟨(τ, s), hu, ?_⟩
    rw [mem_quinticTriangleRepeatMultiplicityFiberPairOn_iff τ hτ s]
    exact hmult
  · intro hp
    rw [Finset.mem_biUnion] at hp
    rcases hp with ⟨u, hu, hp⟩
    rcases u with ⟨τ, s⟩
    have hτmem : τ ∈ triangleTriples n := (Finset.mem_product.mp hu).1
    have hτ : IsTriangleTriple τ := by
      simpa [triangleTriples] using (Finset.mem_filter.mp hτmem).2
    rw [mem_quinticTriangleRepeatMultiplicityFiberPairOn_iff τ hτ s] at hp
    exact quinticTriangleRepeatMultiplicity_mem_supportThree τ hτ s hp

private lemma quintic_supportThree_sum_eq_triangleRepeat_sum
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    Finset.sum (quinticGateSupportThreeTuples n) (fun p => quinticMomentTupleMonomial p mu)
      =
        20 * Finset.sum (triangleTriples n)
          (fun τ => Finset.sum Finset.univ (fun s : TriangleEdgeShape =>
            quinticTriangleRepeatMonomialOn mu τ s)) := by
  classical
  rw [quinticGateSupportThreeTuples_eq_biUnion_triangleRepeatFibers]
  have hdisj :
      ((quinticTriangleRepeatIndices n : Finset (TriangleTriple n × TriangleEdgeShape)) : Set
          (TriangleTriple n × TriangleEdgeShape)).PairwiseDisjoint
        quinticTriangleRepeatMultiplicityFiberPairOn := by
    intro u hu v hv huv
    exact disjoint_quinticTriangleRepeatMultiplicityFiberPairOn hu hv huv
  rw [Finset.sum_biUnion hdisj]
  calc
    ∑ u ∈ quinticTriangleRepeatIndices n,
        ∑ p ∈ quinticTriangleRepeatMultiplicityFiberPairOn u, quinticMomentTupleMonomial p mu
      =
        ∑ u ∈ quinticTriangleRepeatIndices n, 20 * quinticTriangleRepeatMonomialOn mu u.1 u.2 := by
          refine Finset.sum_congr rfl ?_
          intro u hu
          rcases u with ⟨τ, s⟩
          have hτmem : τ ∈ triangleTriples n := (Finset.mem_product.mp hu).1
          have hτ : IsTriangleTriple τ := by
            simpa [triangleTriples] using (Finset.mem_filter.mp hτmem).2
          simp [quinticTriangleRepeatMultiplicityFiberPairOn, hτ, quinticTriangleRepeatMonomialOn]
          exact sum_quinticTriangleRepeatMultiplicityFiber_monomial τ hτ s mu
    _ = 20 * ∑ u ∈ quinticTriangleRepeatIndices n, quinticTriangleRepeatMonomialOn mu u.1 u.2 := by
          rw [← Finset.mul_sum]
    _ = 20 * Finset.sum (triangleTriples n)
          (fun τ => Finset.sum Finset.univ (fun s : TriangleEdgeShape =>
            quinticTriangleRepeatMonomialOn mu τ s)) := by
          congr 1
          simpa [quinticTriangleRepeatIndices] using
            (Finset.sum_product (triangleTriples n) (Finset.univ : Finset TriangleEdgeShape)
              (fun u : TriangleTriple n × TriangleEdgeShape =>
                quinticTriangleRepeatMonomialOn mu u.1 u.2))

private lemma quintic_gate_support_four_is_edge_plus_triangle {n : ℕ} {p : EdgeQuintuple n}
    (hp : p ∈ quinticGateSupportFourTuples n) :
    ∃ d : Cn3Torus.Edge n, ∃ τ : TriangleTriple n, ∃ hτ : IsTriangleTriple τ,
      quinticMomentTupleOddEdgeSet p = triangleEdgeSet τ hτ ∧
      quinticMomentTupleMultiplicity p = quinticEdgeTriangleMultiplicity d τ hτ ∧
      d ∉ triangleEdgeSet τ hτ := by
  rcases (mem_quinticGateSupportFourTuples_iff p).1 hp with ⟨hgate, hcard⟩
  obtain ⟨d, e, f, g, hde, hdf, hdg, hef, heg, hfg, hsupp, hd2, he1, hf1, hg1⟩ :=
    quintic_gate_support_four_multiplicity_shape (p := p) hcard
  let q : EdgeQuintuple n := quinticTwoOneOneOneTuple d e f g
  have hmultq :
      quinticMomentTupleMultiplicity p = quinticMomentTupleMultiplicity q := by
    dsimp [q]
    exact quinticMomentTupleMultiplicity_eq_twoOneOneOneTuple_of_support_eq_values
      p d e f g hsupp hd2 he1 hf1 hg1 hde hdf hdg hef heg hfg
  have hgateq : quinticMomentTupleGate q = 1 := by
    rw [← quinticMomentTupleGate_congr_of_multiplicity_eq hmultq]
    exact hgate
  have hgate3 :
      quinticMomentTupleGate (quinticThreeOneOneTuple e f g) = 1 :=
    quinticTwoOneOneOneTuple_gate_one_implies_threeOneOne_gate_one d e f g hgateq
  obtain ⟨τ, hτ, s, hsupp3, hmult3⟩ :=
    quinticThreeOneOneTuple_gate_one_is_triangle_repeat e f g hef heg hfg hgate3
  have htriSet : ({e, f, g} : Finset (Cn3Torus.Edge n)) = triangleEdgeSet τ hτ := by
    calc
      ({e, f, g} : Finset (Cn3Torus.Edge n))
        = quinticMomentTupleSupport (quinticThreeOneOneTuple e f g) := by
            symm
            exact quinticThreeOneOneTuple_support e f g hef heg hfg
      _ = triangleEdgeSet τ hτ := hsupp3
  have hd_not_tri : d ∉ triangleEdgeSet τ hτ := by
    rw [← htriSet]
    simp [hde, hdf, hdg]
  have hoddq :
      quinticMomentTupleOddEdgeSet q = ({e, f, g} : Finset (Cn3Torus.Edge n)) := by
    dsimp [q]
    exact quinticTwoOneOneOneTuple_oddEdgeSet d e f g hde hdf hdg hef heg hfg
  have hoddp : quinticMomentTupleOddEdgeSet p = quinticMomentTupleOddEdgeSet q := by
    ext x
    simp [quinticMomentTupleOddEdgeSet, hmultq]
  have hmult_edge :
      quinticMomentTupleMultiplicity p = quinticEdgeTriangleMultiplicity d τ hτ := by
    funext x
    by_cases hxd : x = d
    · subst x
      rw [hd2, quinticEdgeTriangleMultiplicity_doubled_self d τ hτ hd_not_tri]
    · by_cases hxtri : x ∈ triangleEdgeSet τ hτ
      · have hxEFG : x ∈ ({e, f, g} : Finset (Cn3Torus.Edge n)) := by
          simpa [htriSet] using hxtri
        have hxqS : x ∈ quinticMomentTupleSupport q := by
          dsimp [q]
          rw [quinticTwoOneOneOneTuple_support d e f g hde hdf hdg hef heg hfg]
          simpa [hxd, or_assoc] using hxEFG
        have hx1q :
            quinticMomentTupleMultiplicity q x = 1 := by
          dsimp [q] at hxqS ⊢
          exact quinticTwoOneOneOneTuple_multiplicity_eq_one_of_mem_support_ne_d
            d e f g x hde hdf hdg hef heg hfg hxqS hxd
        have hx1p : quinticMomentTupleMultiplicity p x = 1 := by
          rw [hmultq]
          exact hx1q
        rw [hx1p, quinticEdgeTriangleMultiplicity_eq_one_of_mem_triangleEdgeSet d τ hτ hd_not_tri hxtri]
      · have hxnotP : x ∉ quinticMomentTupleSupport p := by
          rw [hsupp]
          have hxnotEFG : x ∉ ({e, f, g} : Finset (Cn3Torus.Edge n)) := by
            intro hxEFG
            exact hxtri (by simpa [htriSet] using hxEFG)
          simpa [hxd, or_assoc] using hxnotEFG
        rw [quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support p hxnotP,
          quinticEdgeTriangleMultiplicity_eq_zero_of_not_mem d τ hτ hxd hxtri]
  refine ⟨d, τ, hτ, ?_, hmult_edge, hd_not_tri⟩
  calc
    quinticMomentTupleOddEdgeSet p = quinticMomentTupleOddEdgeSet q := hoddp
    _ = ({e, f, g} : Finset (Cn3Torus.Edge n)) := hoddq
    _ = triangleEdgeSet τ hτ := htriSet

private lemma quinticEdgeTriangleMultiplicity_mem_supportFour {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) {p : EdgeQuintuple n}
    (hp : quinticMomentTupleMultiplicity p = quinticEdgeTriangleMultiplicity d τ hτ) :
    p ∈ quinticGateSupportFourTuples n := by
  let q : EdgeQuintuple n :=
    quinticTwoOneOneOneTuple d (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  have hd12 : d ≠ triangleEdge12 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hd13 : d ≠ triangleEdge13 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hd23 : d ≠ triangleEdge23 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hqmult : quinticMomentTupleMultiplicity q = quinticEdgeTriangleMultiplicity d τ hτ := by
    dsimp [q]
    exact quinticTwoOneOneOneTuple_triangle_multiplicity_eq_edgeTriangleMultiplicity d τ hτ hd
  have hEq : quinticMomentTupleMultiplicity p = quinticMomentTupleMultiplicity q := by
    rw [hp, ← hqmult]
  have hsuppEq : quinticMomentTupleSupport p = quinticMomentTupleSupport q := by
    ext x
    simp [quinticMomentTupleSupport, hEq]
  rw [mem_quinticGateSupportFourTuples_iff]
  refine ⟨?_, ?_⟩
  · rw [quinticMomentTupleGate_congr_of_multiplicity_eq hEq]
    dsimp [q]
    exact quinticTwoOneOneOneTuple_triangle_gate_one d τ hτ hd
  · rw [hsuppEq]
    dsimp [q]
    rw [quinticTwoOneOneOneTuple_support d
      (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)
      hd12 hd13 hd23 h12 h13 h23]
    simp [hd12, hd13, hd23, h12, h13, h23]

private lemma quinticEdgeTriangleMultiplicity_support_eq {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) {p : EdgeQuintuple n}
    (hp : quinticMomentTupleMultiplicity p = quinticEdgeTriangleMultiplicity d τ hτ) :
    quinticMomentTupleSupport p = insert d (triangleEdgeSet τ hτ) := by
  let q : EdgeQuintuple n :=
    quinticTwoOneOneOneTuple d (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  have hd12 : d ≠ triangleEdge12 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hd13 : d ≠ triangleEdge13 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hd23 : d ≠ triangleEdge23 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hqmult : quinticMomentTupleMultiplicity q = quinticEdgeTriangleMultiplicity d τ hτ := by
    dsimp [q]
    exact quinticTwoOneOneOneTuple_triangle_multiplicity_eq_edgeTriangleMultiplicity d τ hτ hd
  have hEq : quinticMomentTupleMultiplicity p = quinticMomentTupleMultiplicity q := by
    rw [hp, hqmult]
  have hsuppEq : quinticMomentTupleSupport p = quinticMomentTupleSupport q := by
    ext x
    simp [quinticMomentTupleSupport, hEq]
  rw [hsuppEq]
  dsimp [q]
  rw [quinticTwoOneOneOneTuple_support d
    (triangleEdge12 τ hτ) (triangleEdge13 τ hτ) (triangleEdge23 τ hτ)
    hd12 hd13 hd23 h12 h13 h23]
  ext x
  simp [triangleEdgeSet, hd12, hd13, hd23, or_assoc, or_left_comm, or_comm]

private def quinticEdgeTriangleLabelOfEdge {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (e : Cn3Torus.Edge n) : QuinticEdgeTriangleLabel :=
  if e = d then QuinticEdgeTriangleLabel.doubled
  else if e = triangleEdge12 τ hτ then QuinticEdgeTriangleLabel.edge12
  else if e = triangleEdge13 τ hτ then QuinticEdgeTriangleLabel.edge13
  else QuinticEdgeTriangleLabel.edge23

private lemma quinticEdgeTriangleLabelOfEdge_spec {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) {e : Cn3Torus.Edge n}
    (he : e ∈ insert d (triangleEdgeSet τ hτ)) :
    (match quinticEdgeTriangleLabelOfEdge d τ hτ e with
      | QuinticEdgeTriangleLabel.doubled => d
      | QuinticEdgeTriangleLabel.edge12 => triangleEdge12 τ hτ
      | QuinticEdgeTriangleLabel.edge13 => triangleEdge13 τ hτ
      | QuinticEdgeTriangleLabel.edge23 => triangleEdge23 τ hτ) = e := by
  unfold quinticEdgeTriangleLabelOfEdge
  by_cases hed : e = d
  · simp [hed]
  · have hetri : e ∈ triangleEdgeSet τ hτ := by
      simpa [hed] using he
    rcases (by simpa [triangleEdgeSet] using hetri) with he12 | he13 | he23
    · have hd12 : d ≠ triangleEdge12 τ hτ := by
        intro h
        exact hd (by simpa [triangleEdgeSet, h])
      simp [hed, he12, hd12.symm]
    · have hd12 : d ≠ triangleEdge12 τ hτ := by
        intro h
        exact hd (by simpa [triangleEdgeSet, h])
      have hd13 : d ≠ triangleEdge13 τ hτ := by
        intro h
        exact hd (by simpa [triangleEdgeSet, h])
      have h12 : triangleEdge13 τ hτ ≠ triangleEdge12 τ hτ := (triangleEdge12_ne_13 τ hτ).symm
      simp [hed, he13, hd12.symm, hd13.symm, h12]
    · have hd12 : d ≠ triangleEdge12 τ hτ := by
        intro h
        exact hd (by simpa [triangleEdgeSet, h])
      have hd13 : d ≠ triangleEdge13 τ hτ := by
        intro h
        exact hd (by simpa [triangleEdgeSet, h])
      have hd23 : d ≠ triangleEdge23 τ hτ := by
        intro h
        exact hd (by simpa [triangleEdgeSet, h])
      have h12 : triangleEdge23 τ hτ ≠ triangleEdge12 τ hτ := (triangleEdge12_ne_23 τ hτ).symm
      have h13 : triangleEdge23 τ hτ ≠ triangleEdge13 τ hτ := (triangleEdge13_ne_23 τ hτ).symm
      simp [hed, he23, hd12.symm, hd13.symm, hd23.symm, h12, h13]

private lemma quinticEdgeTriangleLabelOfEdge_tupleOfPattern {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ)
    (f : Fin 5 → QuinticEdgeTriangleLabel) (i : Fin 5) :
    quinticEdgeTriangleLabelOfEdge d τ hτ
        ((quinticEdgeTriangleTupleOfPattern d τ hτ f) i)
      = f i := by
  have hd12 : d ≠ triangleEdge12 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hd13 : d ≠ triangleEdge13 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hd23 : d ≠ triangleEdge23 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  cases hfi : f i <;>
    simp [quinticEdgeTriangleTupleOfPattern, quinticEdgeTriangleLabelOfEdge, hfi,
      hd12, hd13, hd23, hd12.symm, hd13.symm, hd23.symm,
      h12, h13, h23, h12.symm, h13.symm, h23.symm]

private lemma quinticEdgeTriangleTupleOfPattern_doubled_indicator {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ)
    (f : Fin 5 → QuinticEdgeTriangleLabel) (i : Fin 5) :
    (if d = (quinticEdgeTriangleTupleOfPattern d τ hτ f) i then 1 else 0)
      = (if f i = QuinticEdgeTriangleLabel.doubled then 1 else 0) := by
  have hd12 : d ≠ triangleEdge12 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hd13 : d ≠ triangleEdge13 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have hd23 : d ≠ triangleEdge23 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  cases hfi : f i <;>
    simp [quinticEdgeTriangleTupleOfPattern, hfi, hd12, hd13, hd23]

private lemma quinticEdgeTriangleTupleOfPattern_edge12_indicator {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ)
    (f : Fin 5 → QuinticEdgeTriangleLabel) (i : Fin 5) :
    (if triangleEdge12 τ hτ = (quinticEdgeTriangleTupleOfPattern d τ hτ f) i then 1 else 0)
      = (if f i = QuinticEdgeTriangleLabel.edge12 then 1 else 0) := by
  have hd12 : d ≠ triangleEdge12 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  cases hfi : f i <;>
    simp [quinticEdgeTriangleTupleOfPattern, hfi, hd12.symm, h12, h13]

private lemma quinticEdgeTriangleTupleOfPattern_edge13_indicator {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ)
    (f : Fin 5 → QuinticEdgeTriangleLabel) (i : Fin 5) :
    (if triangleEdge13 τ hτ = (quinticEdgeTriangleTupleOfPattern d τ hτ f) i then 1 else 0)
      = (if f i = QuinticEdgeTriangleLabel.edge13 then 1 else 0) := by
  have hd13 : d ≠ triangleEdge13 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  cases hfi : f i <;>
    simp [quinticEdgeTriangleTupleOfPattern, hfi, hd13.symm, h12.symm, h23]

private lemma quinticEdgeTriangleTupleOfPattern_edge23_indicator {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ)
    (f : Fin 5 → QuinticEdgeTriangleLabel) (i : Fin 5) :
    (if triangleEdge23 τ hτ = (quinticEdgeTriangleTupleOfPattern d τ hτ f) i then 1 else 0)
      = (if f i = QuinticEdgeTriangleLabel.edge23 then 1 else 0) := by
  have hd23 : d ≠ triangleEdge23 τ hτ := by
    intro h
    exact hd (by simpa [triangleEdgeSet, h])
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  cases hfi : f i <;>
    simp [quinticEdgeTriangleTupleOfPattern, hfi, hd23.symm, h13.symm, h23.symm]

private lemma quinticEdgeTriangleTupleOfPattern_multiplicity_doubled {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) (f : Fin 5 → QuinticEdgeTriangleLabel) :
    quinticMomentTupleMultiplicity (quinticEdgeTriangleTupleOfPattern d τ hτ f) d
      = quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.doubled := by
  rw [quinticMomentTupleMultiplicity_apply, quinticEdgeTriangleLabelCount_eq_sum_indicators]
  rw [quinticEdgeTriangleTupleOfPattern_doubled_indicator d τ hτ hd f 0,
    quinticEdgeTriangleTupleOfPattern_doubled_indicator d τ hτ hd f 1,
    quinticEdgeTriangleTupleOfPattern_doubled_indicator d τ hτ hd f 2,
    quinticEdgeTriangleTupleOfPattern_doubled_indicator d τ hτ hd f 3,
    quinticEdgeTriangleTupleOfPattern_doubled_indicator d τ hτ hd f 4]

private lemma quinticEdgeTriangleTupleOfPattern_multiplicity_edge12 {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) (f : Fin 5 → QuinticEdgeTriangleLabel) :
    quinticMomentTupleMultiplicity (quinticEdgeTriangleTupleOfPattern d τ hτ f)
        (triangleEdge12 τ hτ)
      = quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge12 := by
  rw [quinticMomentTupleMultiplicity_apply, quinticEdgeTriangleLabelCount_eq_sum_indicators]
  rw [quinticEdgeTriangleTupleOfPattern_edge12_indicator d τ hτ hd f 0,
    quinticEdgeTriangleTupleOfPattern_edge12_indicator d τ hτ hd f 1,
    quinticEdgeTriangleTupleOfPattern_edge12_indicator d τ hτ hd f 2,
    quinticEdgeTriangleTupleOfPattern_edge12_indicator d τ hτ hd f 3,
    quinticEdgeTriangleTupleOfPattern_edge12_indicator d τ hτ hd f 4]

private lemma quinticEdgeTriangleTupleOfPattern_multiplicity_edge13 {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) (f : Fin 5 → QuinticEdgeTriangleLabel) :
    quinticMomentTupleMultiplicity (quinticEdgeTriangleTupleOfPattern d τ hτ f)
        (triangleEdge13 τ hτ)
      = quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge13 := by
  rw [quinticMomentTupleMultiplicity_apply, quinticEdgeTriangleLabelCount_eq_sum_indicators]
  rw [quinticEdgeTriangleTupleOfPattern_edge13_indicator d τ hτ hd f 0,
    quinticEdgeTriangleTupleOfPattern_edge13_indicator d τ hτ hd f 1,
    quinticEdgeTriangleTupleOfPattern_edge13_indicator d τ hτ hd f 2,
    quinticEdgeTriangleTupleOfPattern_edge13_indicator d τ hτ hd f 3,
    quinticEdgeTriangleTupleOfPattern_edge13_indicator d τ hτ hd f 4]

private lemma quinticEdgeTriangleTupleOfPattern_multiplicity_edge23 {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) (f : Fin 5 → QuinticEdgeTriangleLabel) :
    quinticMomentTupleMultiplicity (quinticEdgeTriangleTupleOfPattern d τ hτ f)
        (triangleEdge23 τ hτ)
      = quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge23 := by
  rw [quinticMomentTupleMultiplicity_apply, quinticEdgeTriangleLabelCount_eq_sum_indicators]
  rw [quinticEdgeTriangleTupleOfPattern_edge23_indicator d τ hτ hd f 0,
    quinticEdgeTriangleTupleOfPattern_edge23_indicator d τ hτ hd f 1,
    quinticEdgeTriangleTupleOfPattern_edge23_indicator d τ hτ hd f 2,
    quinticEdgeTriangleTupleOfPattern_edge23_indicator d τ hτ hd f 3,
    quinticEdgeTriangleTupleOfPattern_edge23_indicator d τ hτ hd f 4]

private lemma quinticEdgeTriangleTupleOfPattern_multiplicity {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ)
    {f : Fin 5 → QuinticEdgeTriangleLabel} (hf : f ∈ quinticEdgeTrianglePatterns) :
    quinticMomentTupleMultiplicity (quinticEdgeTriangleTupleOfPattern d τ hτ f)
      = quinticEdgeTriangleMultiplicity d τ hτ := by
  rcases (by
      simpa [quinticEdgeTrianglePatterns] using hf :
        quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.doubled = 2 ∧
          quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge12 = 1 ∧
          quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge13 = 1 ∧
          quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge23 = 1)
    with ⟨hfd, hf12, hf13, hf23⟩
  funext e
  by_cases hed : e = d
  · subst e
    rw [quinticEdgeTriangleTupleOfPattern_multiplicity_doubled d τ hτ hd f, hfd,
      quinticEdgeTriangleMultiplicity_doubled_self d τ hτ hd]
  · by_cases he12 : e = triangleEdge12 τ hτ
    · subst e
      rw [quinticEdgeTriangleTupleOfPattern_multiplicity_edge12 d τ hτ hd f, hf12,
        quinticEdgeTriangleMultiplicity_triangle12 d τ hτ hd]
    · by_cases he13 : e = triangleEdge13 τ hτ
      · subst e
        rw [quinticEdgeTriangleTupleOfPattern_multiplicity_edge13 d τ hτ hd f, hf13,
          quinticEdgeTriangleMultiplicity_triangle13 d τ hτ hd]
      · by_cases he23 : e = triangleEdge23 τ hτ
        · subst e
          rw [quinticEdgeTriangleTupleOfPattern_multiplicity_edge23 d τ hτ hd f, hf23,
            quinticEdgeTriangleMultiplicity_triangle23 d τ hτ hd]
        · have hetri : e ∉ triangleEdgeSet τ hτ := by
            simp [triangleEdgeSet, he12, he13, he23]
          have hmatch : ∀ i : Fin 5, e ≠ (quinticEdgeTriangleTupleOfPattern d τ hτ f) i := by
            intro i
            cases hfi : f i <;>
              simp [quinticEdgeTriangleTupleOfPattern, hfi, hed, he12, he13, he23]
          have h0 := hmatch 0
          have h1 := hmatch 1
          have h2 := hmatch 2
          have h3 := hmatch 3
          have h4 := hmatch 4
          rw [quinticMomentTupleMultiplicity_apply]
          simp [h0, h1, h2, h3, h4, quinticEdgeTriangleMultiplicity_eq_zero_of_not_mem d τ hτ hed hetri]

private lemma quinticEdgeTriangleTupleOfPattern_monomial {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ)
    {f : Fin 5 → QuinticEdgeTriangleLabel} (hf : f ∈ quinticEdgeTrianglePatterns)
    (mu : Cn3Torus.Edge n → ℝ) :
    quinticMomentTupleMonomial (quinticEdgeTriangleTupleOfPattern d τ hτ f) mu
      = quinticSTriangleMonomialOn mu d τ := by
  rw [quinticMomentTupleMonomial_eq_coordMonomial,
    quinticSTriangleMonomialOn_eq_coordMonomial d τ hτ]
  congr 1
  exact quinticEdgeTriangleTupleOfPattern_multiplicity d τ hτ hd hf

private lemma quinticEdgeTriangleTupleOfPattern_injective {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) :
    Function.Injective (quinticEdgeTriangleTupleOfPattern d τ hτ) := by
  intro f g hfg
  funext i
  have hi := congrArg (fun p : EdgeQuintuple n =>
    quinticEdgeTriangleLabelOfEdge d τ hτ (p i)) hfg
  simpa [quinticEdgeTriangleLabelOfEdge_tupleOfPattern d τ hτ hd] using hi

private lemma exists_quinticEdgeTrianglePattern_of_multiplicity_eq {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) {p : EdgeQuintuple n}
    (hmult : quinticMomentTupleMultiplicity p = quinticEdgeTriangleMultiplicity d τ hτ) :
    ∃ f ∈ quinticEdgeTrianglePatterns,
      p = quinticEdgeTriangleTupleOfPattern d τ hτ f := by
  let f : Fin 5 → QuinticEdgeTriangleLabel :=
    fun i => quinticEdgeTriangleLabelOfEdge d τ hτ (p i)
  have hsupp : quinticMomentTupleSupport p = insert d (triangleEdgeSet τ hτ) := by
    exact quinticEdgeTriangleMultiplicity_support_eq d τ hτ hd hmult
  have hpi : ∀ i : Fin 5, p i ∈ insert d (triangleEdgeSet τ hτ) := by
    intro i
    simpa [hsupp] using quinticMomentTuple_mem_support p i
  have hp_eq : p = quinticEdgeTriangleTupleOfPattern d τ hτ f := by
    funext i
    dsimp [f, quinticEdgeTriangleTupleOfPattern]
    exact (quinticEdgeTriangleLabelOfEdge_spec d τ hτ hd (hpi i)).symm
  have hfd :
      quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.doubled = 2 := by
    calc
      quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.doubled
        = quinticMomentTupleMultiplicity
            (quinticEdgeTriangleTupleOfPattern d τ hτ f) d := by
              symm
              exact quinticEdgeTriangleTupleOfPattern_multiplicity_doubled d τ hτ hd f
      _ = quinticMomentTupleMultiplicity p d := by rw [hp_eq]
      _ = quinticEdgeTriangleMultiplicity d τ hτ d := by rw [hmult]
      _ = 2 := quinticEdgeTriangleMultiplicity_doubled_self d τ hτ hd
  have hf12 :
      quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge12 = 1 := by
    calc
      quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge12
        = quinticMomentTupleMultiplicity
            (quinticEdgeTriangleTupleOfPattern d τ hτ f) (triangleEdge12 τ hτ) := by
              symm
              exact quinticEdgeTriangleTupleOfPattern_multiplicity_edge12 d τ hτ hd f
      _ = quinticMomentTupleMultiplicity p (triangleEdge12 τ hτ) := by rw [hp_eq]
      _ = quinticEdgeTriangleMultiplicity d τ hτ (triangleEdge12 τ hτ) := by rw [hmult]
      _ = 1 := quinticEdgeTriangleMultiplicity_triangle12 d τ hτ hd
  have hf13 :
      quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge13 = 1 := by
    calc
      quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge13
        = quinticMomentTupleMultiplicity
            (quinticEdgeTriangleTupleOfPattern d τ hτ f) (triangleEdge13 τ hτ) := by
              symm
              exact quinticEdgeTriangleTupleOfPattern_multiplicity_edge13 d τ hτ hd f
      _ = quinticMomentTupleMultiplicity p (triangleEdge13 τ hτ) := by rw [hp_eq]
      _ = quinticEdgeTriangleMultiplicity d τ hτ (triangleEdge13 τ hτ) := by rw [hmult]
      _ = 1 := quinticEdgeTriangleMultiplicity_triangle13 d τ hτ hd
  have hf23 :
      quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge23 = 1 := by
    calc
      quinticEdgeTriangleLabelCount f QuinticEdgeTriangleLabel.edge23
        = quinticMomentTupleMultiplicity
            (quinticEdgeTriangleTupleOfPattern d τ hτ f) (triangleEdge23 τ hτ) := by
              symm
              exact quinticEdgeTriangleTupleOfPattern_multiplicity_edge23 d τ hτ hd f
      _ = quinticMomentTupleMultiplicity p (triangleEdge23 τ hτ) := by rw [hp_eq]
      _ = quinticEdgeTriangleMultiplicity d τ hτ (triangleEdge23 τ hτ) := by rw [hmult]
      _ = 1 := quinticEdgeTriangleMultiplicity_triangle23 d τ hτ hd
  refine ⟨f, ?_, hp_eq⟩
  simpa [quinticEdgeTrianglePatterns] using ⟨hfd, hf12, hf13, hf23⟩

private def quinticEdgeTriangleMultiplicityFiber {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    Finset (EdgeQuintuple n) :=
  (Finset.univ : Finset (EdgeQuintuple n)).filter
    (fun p => quinticMomentTupleMultiplicity p = quinticEdgeTriangleMultiplicity d τ hτ)

private lemma mem_quinticEdgeTriangleMultiplicityFiber_iff {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    {p : EdgeQuintuple n} :
    p ∈ quinticEdgeTriangleMultiplicityFiber d τ hτ ↔
      quinticMomentTupleMultiplicity p = quinticEdgeTriangleMultiplicity d τ hτ := by
  simp [quinticEdgeTriangleMultiplicityFiber]

private lemma sum_quinticEdgeTriangleMultiplicityFiber_monomial {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ)
    (mu : Cn3Torus.Edge n → ℝ) :
    Finset.sum (quinticEdgeTriangleMultiplicityFiber d τ hτ)
      (fun p => quinticMomentTupleMonomial p mu)
      = 60 * quinticSTriangleMonomialOn mu d τ := by
  classical
  have hsum :
      Finset.sum quinticEdgeTrianglePatterns
          (fun f => quinticMomentTupleMonomial (quinticEdgeTriangleTupleOfPattern d τ hτ f) mu)
        =
      Finset.sum (quinticEdgeTriangleMultiplicityFiber d τ hτ)
        (fun p => quinticMomentTupleMonomial p mu) := by
    refine Finset.sum_bij
      (fun f hf => quinticEdgeTriangleTupleOfPattern d τ hτ f) ?_ ?_ ?_ ?_
    · intro f hf
      rw [mem_quinticEdgeTriangleMultiplicityFiber_iff]
      exact quinticEdgeTriangleTupleOfPattern_multiplicity d τ hτ hd hf
    · intro f₁ hf₁ f₂ hf₂ hEq
      exact quinticEdgeTriangleTupleOfPattern_injective d τ hτ hd hEq
    · intro p hp
      rw [mem_quinticEdgeTriangleMultiplicityFiber_iff] at hp
      obtain ⟨f, hf, hEq⟩ :=
        exists_quinticEdgeTrianglePattern_of_multiplicity_eq d τ hτ hd hp
      exact ⟨f, hf, hEq.symm⟩
    · intro f hf
      rfl
  calc
    Finset.sum (quinticEdgeTriangleMultiplicityFiber d τ hτ)
        (fun p => quinticMomentTupleMonomial p mu)
      = Finset.sum quinticEdgeTrianglePatterns
          (fun f => quinticMomentTupleMonomial (quinticEdgeTriangleTupleOfPattern d τ hτ f) mu) := by
            symm
            exact hsum
    _ = Finset.sum quinticEdgeTrianglePatterns
          (fun _ => quinticSTriangleMonomialOn mu d τ) := by
            refine Finset.sum_congr rfl ?_
            intro f hf
            exact quinticEdgeTriangleTupleOfPattern_monomial d τ hτ hd hf mu
    _ = (quinticEdgeTrianglePatterns.card : ℝ) * quinticSTriangleMonomialOn mu d τ := by
          simp
    _ = 60 * quinticSTriangleMonomialOn mu d τ := by
          rw [quinticEdgeTrianglePatterns_card]
          norm_num

private lemma quinticEdgeTriangleMultiplicity_odd_iff {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) {e : Cn3Torus.Edge n} :
    Odd (quinticEdgeTriangleMultiplicity d τ hτ e) ↔ e ∈ triangleEdgeSet τ hτ := by
  by_cases hed : e = d
  · subst e
    rw [quinticEdgeTriangleMultiplicity_doubled_self d τ hτ hd]
    simp [hd]
  · by_cases hetri : e ∈ triangleEdgeSet τ hτ
    · rw [quinticEdgeTriangleMultiplicity_eq_one_of_mem_triangleEdgeSet d τ hτ hd hetri]
      simp [hetri]
    · rw [quinticEdgeTriangleMultiplicity_eq_zero_of_not_mem d τ hτ hed hetri]
      simp [hetri]

private lemma quinticEdgeTriangleMultiplicity_oddEdgeSet_eq {n : ℕ}
    (d : Cn3Torus.Edge n) (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (hd : d ∉ triangleEdgeSet τ hτ) {p : EdgeQuintuple n}
    (hp : quinticMomentTupleMultiplicity p = quinticEdgeTriangleMultiplicity d τ hτ) :
    quinticMomentTupleOddEdgeSet p = triangleEdgeSet τ hτ := by
  ext e
  simp [quinticMomentTupleOddEdgeSet, hp, quinticEdgeTriangleMultiplicity_odd_iff d τ hτ hd]

private abbrev quinticEdgeTriangleIndices (n : ℕ) :
    Finset (TriangleTriple n × Cn3Torus.Edge n) :=
  (triangleTriples n).product (Finset.univ : Finset (Cn3Torus.Edge n))

private def quinticEdgeTriangleMultiplicityFiberPairOn {n : ℕ}
    (u : TriangleTriple n × Cn3Torus.Edge n) : Finset (EdgeQuintuple n) := by
  classical
  exact if hτ : IsTriangleTriple u.1 then
      if hd : u.2 ∉ triangleEdgeSet u.1 hτ then
        quinticEdgeTriangleMultiplicityFiber u.2 u.1 hτ
      else ∅
    else ∅

private lemma mem_quinticEdgeTriangleMultiplicityFiberPairOn_iff {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (d : Cn3Torus.Edge n) (hd : d ∉ triangleEdgeSet τ hτ)
    {p : EdgeQuintuple n} :
    p ∈ quinticEdgeTriangleMultiplicityFiberPairOn (τ, d) ↔
      quinticMomentTupleMultiplicity p = quinticEdgeTriangleMultiplicity d τ hτ := by
  simp [quinticEdgeTriangleMultiplicityFiberPairOn, hτ, hd,
    mem_quinticEdgeTriangleMultiplicityFiber_iff]

private lemma disjoint_quinticEdgeTriangleMultiplicityFiberPairOn {n : ℕ}
    {u v : TriangleTriple n × Cn3Torus.Edge n}
    (hu : u ∈ quinticEdgeTriangleIndices n)
    (hv : v ∈ quinticEdgeTriangleIndices n)
    (huv : u ≠ v) :
    Disjoint (quinticEdgeTriangleMultiplicityFiberPairOn u)
      (quinticEdgeTriangleMultiplicityFiberPairOn v) := by
  classical
  rcases u with ⟨τ, d⟩
  rcases v with ⟨τ', d'⟩
  have hτmem : τ ∈ triangleTriples n := (Finset.mem_product.mp hu).1
  have hτ'mem : τ' ∈ triangleTriples n := (Finset.mem_product.mp hv).1
  have hτ : IsTriangleTriple τ := by
    simpa [triangleTriples] using (Finset.mem_filter.mp hτmem).2
  have hτ' : IsTriangleTriple τ' := by
    simpa [triangleTriples] using (Finset.mem_filter.mp hτ'mem).2
  refine Finset.disjoint_left.mpr ?_
  intro p hp hp'
  by_cases hd : d ∉ triangleEdgeSet τ hτ
  · rw [mem_quinticEdgeTriangleMultiplicityFiberPairOn_iff τ hτ d hd] at hp
    by_cases hd' : d' ∉ triangleEdgeSet τ' hτ'
    · rw [mem_quinticEdgeTriangleMultiplicityFiberPairOn_iff τ' hτ' d' hd'] at hp'
      have hsupp : triangleEdgeSet τ hτ = triangleEdgeSet τ' hτ' := by
        calc
          triangleEdgeSet τ hτ = quinticMomentTupleOddEdgeSet p := by
            symm
            exact quinticEdgeTriangleMultiplicity_oddEdgeSet_eq d τ hτ hd hp
          _ = triangleEdgeSet τ' hτ' := by
            exact quinticEdgeTriangleMultiplicity_oddEdgeSet_eq d' τ' hτ' hd' hp'
      have hτeq : τ = τ' := triangleTriple_eq_of_triangleEdgeSet_eq τ τ' hτ hτ' hsupp
      subst τ'
      have hp'' :
          quinticMomentTupleMultiplicity p = quinticEdgeTriangleMultiplicity d' τ hτ := by
        simpa using hp'
      have hdeq : d = d' := by
        by_contra hdd
        have hval :
            quinticEdgeTriangleMultiplicity d τ hτ d
              = quinticEdgeTriangleMultiplicity d' τ hτ d := by
          rw [← hp, hp'']
        rw [quinticEdgeTriangleMultiplicity_doubled_self d τ hτ hd,
          quinticEdgeTriangleMultiplicity_eq_zero_of_not_mem d' τ hτ hdd hd] at hval
        omega
      exact huv (Prod.ext rfl hdeq)
    · simp [quinticEdgeTriangleMultiplicityFiberPairOn, hτ', hd'] at hp'
  · simp [quinticEdgeTriangleMultiplicityFiberPairOn, hτ, hd] at hp

private lemma quinticGateSupportFourTuples_eq_biUnion_edgeTriangleFibers (n : ℕ) :
    quinticGateSupportFourTuples n
      = (quinticEdgeTriangleIndices n).biUnion
          quinticEdgeTriangleMultiplicityFiberPairOn := by
  classical
  ext p
  constructor
  · intro hp
    obtain ⟨d, τ, hτ, -, hmult, hd⟩ := quintic_gate_support_four_is_edge_plus_triangle hp
    have hu : (τ, d) ∈ quinticEdgeTriangleIndices n := by
      simp [quinticEdgeTriangleIndices, triangleTriples, hτ]
    rw [Finset.mem_biUnion]
    refine ⟨(τ, d), hu, ?_⟩
    rw [mem_quinticEdgeTriangleMultiplicityFiberPairOn_iff τ hτ d hd]
    exact hmult
  · intro hp
    rw [Finset.mem_biUnion] at hp
    rcases hp with ⟨u, hu, hp⟩
    rcases u with ⟨τ, d⟩
    have hτmem : τ ∈ triangleTriples n := (Finset.mem_product.mp hu).1
    have hτ : IsTriangleTriple τ := by
      simpa [triangleTriples] using (Finset.mem_filter.mp hτmem).2
    by_cases hd : d ∉ triangleEdgeSet τ hτ
    · rw [mem_quinticEdgeTriangleMultiplicityFiberPairOn_iff τ hτ d hd] at hp
      exact quinticEdgeTriangleMultiplicity_mem_supportFour d τ hτ hd hp
    · simp [quinticEdgeTriangleMultiplicityFiberPairOn, hτ, hd] at hp

private lemma sum_triangleEdgeSet_quinticSTriangleMonomialOn_eq_sum_repeat {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (mu : Cn3Torus.Edge n → ℝ) :
    Finset.sum (triangleEdgeSet τ hτ) (fun e => quinticSTriangleMonomialOn mu e τ)
      = Finset.sum Finset.univ (fun s : TriangleEdgeShape =>
          quinticTriangleRepeatMonomial τ hτ s mu) := by
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  have huniv :
      (Finset.univ : Finset TriangleEdgeShape)
        = ({TriangleEdgeShape.edge12, TriangleEdgeShape.edge13, TriangleEdgeShape.edge23}
            : Finset TriangleEdgeShape) := by
    exact triangleEdgeShape_univ
  rw [show triangleEdgeSet τ hτ =
      ({triangleEdge12 τ hτ, triangleEdge13 τ hτ, triangleEdge23 τ hτ}
        : Finset (Cn3Torus.Edge n)) by rfl]
  rw [huniv]
  simp [h12, h13, h23, quinticSTriangleMonomialOn, triangleMonomialOn,
    triangleMonomial, quinticTriangleRepeatMonomial, mul_assoc, mul_left_comm, mul_comm, hτ]
  ring_nf

private lemma sum_edges_quinticSTriangleMonomialOn_split {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (mu : Cn3Torus.Edge n → ℝ) :
    Finset.sum (Finset.univ : Finset (Cn3Torus.Edge n))
        (fun e => quinticSTriangleMonomialOn mu e τ)
      = Finset.sum Finset.univ (fun s : TriangleEdgeShape =>
          quinticTriangleRepeatMonomialOn mu τ s)
        + Finset.sum ((Finset.univ : Finset (Cn3Torus.Edge n)).filter
            (fun e => e ∉ triangleEdgeSet τ hτ))
            (fun e => quinticSTriangleMonomialOn mu e τ) := by
  rw [← Finset.sum_filter_add_sum_filter_not
    (s := (Finset.univ : Finset (Cn3Torus.Edge n)))
    (p := fun e => e ∈ triangleEdgeSet τ hτ)
    (f := fun e => quinticSTriangleMonomialOn mu e τ)]
  congr 1
  · calc
      Finset.sum ((Finset.univ : Finset (Cn3Torus.Edge n)).filter
          (fun e => e ∈ triangleEdgeSet τ hτ))
          (fun e => quinticSTriangleMonomialOn mu e τ)
        = Finset.sum (triangleEdgeSet τ hτ) (fun e => quinticSTriangleMonomialOn mu e τ) := by
            simp
      _ = Finset.sum Finset.univ (fun s : TriangleEdgeShape =>
            quinticTriangleRepeatMonomial τ hτ s mu) := by
            exact sum_triangleEdgeSet_quinticSTriangleMonomialOn_eq_sum_repeat τ hτ mu
      _ = Finset.sum Finset.univ (fun s : TriangleEdgeShape =>
            quinticTriangleRepeatMonomialOn mu τ s) := by
            refine Finset.sum_congr rfl ?_
            intro s hs
            simp [quinticTriangleRepeatMonomialOn, hτ]

private lemma sqNormEdge_mul_cubicT_eq_sum_edge_triangleTriples
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    Cn3Torus.sqNormEdge n mu * cubicT n (matrixOfEdge n mu)
      = Finset.sum (Finset.univ : Finset (Cn3Torus.Edge n))
          (fun e => Finset.sum (triangleTriples n) (fun τ => quinticSTriangleMonomialOn mu e τ)) := by
  rw [cubicT_matrixOfEdge_eq_sum_triangleTriples]
  unfold quinticSTriangleMonomialOn
  rw [Cn3Torus.sqNormEdge, Finset.sum_mul]
  refine Finset.sum_congr rfl ?_
  intro e he
  rw [Finset.mul_sum]

private def quinticExternalEdgeTriangleSumOn {n : ℕ}
    (mu : Cn3Torus.Edge n → ℝ) (τ : TriangleTriple n) : ℝ := by
  classical
  exact if hτ : IsTriangleTriple τ then
      Finset.sum ((Finset.univ : Finset (Cn3Torus.Edge n)).filter
        (fun e => e ∉ triangleEdgeSet τ hτ))
        (fun e => quinticSTriangleMonomialOn mu e τ)
    else 0

private lemma quintic_supportFour_sum_eq_edgeTriangle_sum
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    Finset.sum (quinticGateSupportFourTuples n) (fun p => quinticMomentTupleMonomial p mu)
      =
        60 * Finset.sum (triangleTriples n) (fun τ => quinticExternalEdgeTriangleSumOn mu τ) := by
  classical
  rw [quinticGateSupportFourTuples_eq_biUnion_edgeTriangleFibers]
  have hdisj :
      ((quinticEdgeTriangleIndices n : Finset (TriangleTriple n × Cn3Torus.Edge n)) : Set
          (TriangleTriple n × Cn3Torus.Edge n)).PairwiseDisjoint
        quinticEdgeTriangleMultiplicityFiberPairOn := by
    intro u hu v hv huv
    exact disjoint_quinticEdgeTriangleMultiplicityFiberPairOn hu hv huv
  rw [Finset.sum_biUnion hdisj]
  calc
    ∑ u ∈ quinticEdgeTriangleIndices n,
        ∑ p ∈ quinticEdgeTriangleMultiplicityFiberPairOn u, quinticMomentTupleMonomial p mu
      =
        ∑ u ∈ quinticEdgeTriangleIndices n,
          60 * (if hτ : IsTriangleTriple u.1 then
            if hd : u.2 ∉ triangleEdgeSet u.1 hτ then quinticSTriangleMonomialOn mu u.2 u.1
            else 0
          else 0) := by
          refine Finset.sum_congr rfl ?_
          intro u hu
          rcases u with ⟨τ, d⟩
          have hτmem : τ ∈ triangleTriples n := (Finset.mem_product.mp hu).1
          have hτ : IsTriangleTriple τ := by
            simpa [triangleTriples] using (Finset.mem_filter.mp hτmem).2
          by_cases hd : d ∉ triangleEdgeSet τ hτ
          · simp [quinticEdgeTriangleMultiplicityFiberPairOn, hτ, hd,
              sum_quinticEdgeTriangleMultiplicityFiber_monomial d τ hτ hd]
          · simp [quinticEdgeTriangleMultiplicityFiberPairOn, hτ, hd]
    _ =
        60 * ∑ u ∈ quinticEdgeTriangleIndices n,
          if hτ : IsTriangleTriple u.1 then
            if hd : u.2 ∉ triangleEdgeSet u.1 hτ then quinticSTriangleMonomialOn mu u.2 u.1
            else 0
          else 0 := by
          rw [← Finset.mul_sum]
    _ =
        60 * ∑ τ ∈ triangleTriples n,
          ∑ d : Cn3Torus.Edge n,
            if hτ : IsTriangleTriple τ then
              if hd : d ∉ triangleEdgeSet τ hτ then quinticSTriangleMonomialOn mu d τ
              else 0
            else 0 := by
          congr 1
          simp [quinticEdgeTriangleIndices, Finset.sum_product]
    _ =
        60 * Finset.sum (triangleTriples n) (fun τ => quinticExternalEdgeTriangleSumOn mu τ) := by
          congr 1
          refine Finset.sum_congr rfl ?_
          intro τ hτmem
          have hτ : IsTriangleTriple τ := by
            simpa [triangleTriples] using (Finset.mem_filter.mp hτmem).2
          unfold quinticExternalEdgeTriangleSumOn
          simp [hτ]
          symm
          calc
            ∑ e with e ∉ triangleEdgeSet τ hτ, quinticSTriangleMonomialOn mu e τ
              = ∑ x : Cn3Torus.Edge n,
                  if x ∉ triangleEdgeSet τ hτ then quinticSTriangleMonomialOn mu x τ else 0 := by
                    exact Finset.sum_filter
                      (s := (Finset.univ : Finset (Cn3Torus.Edge n)))
                      (p := fun d => d ∉ triangleEdgeSet τ hτ)
                      (f := fun d => quinticSTriangleMonomialOn mu d τ)
            _ = ∑ x : Cn3Torus.Edge n,
                  if x ∈ triangleEdgeSet τ hτ then 0 else quinticSTriangleMonomialOn mu x τ := by
                    refine Finset.sum_congr rfl ?_
                    intro x hx
                    by_cases hxin : x ∈ triangleEdgeSet τ hτ <;> simp [hxin]

private lemma sqNormEdge_mul_cubicT_eq_sum_repeat_add_external
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    Cn3Torus.sqNormEdge n mu * cubicT n (matrixOfEdge n mu)
      =
        Finset.sum (triangleTriples n)
          (fun τ => Finset.sum Finset.univ (fun s : TriangleEdgeShape =>
            quinticTriangleRepeatMonomialOn mu τ s))
        + Finset.sum (triangleTriples n)
          (fun τ => quinticExternalEdgeTriangleSumOn mu τ) := by
  classical
  calc
    Cn3Torus.sqNormEdge n mu * cubicT n (matrixOfEdge n mu)
      = Finset.sum (triangleTriples n)
          (fun τ => Finset.sum (Finset.univ : Finset (Cn3Torus.Edge n))
            (fun e => quinticSTriangleMonomialOn mu e τ)) := by
            rw [sqNormEdge_mul_cubicT_eq_sum_edge_triangleTriples, Finset.sum_comm]
    _ = Finset.sum (triangleTriples n)
          (fun τ =>
            Finset.sum Finset.univ (fun s : TriangleEdgeShape =>
              quinticTriangleRepeatMonomialOn mu τ s)
            + quinticExternalEdgeTriangleSumOn mu τ) := by
          refine Finset.sum_congr rfl ?_
          intro τ hτmem
          have hτ : IsTriangleTriple τ := (Finset.mem_filter.mp hτmem).2
          simp [quinticExternalEdgeTriangleSumOn, hτ, sum_edges_quinticSTriangleMonomialOn_split]
    _ =
        Finset.sum (triangleTriples n)
          (fun τ => Finset.sum Finset.univ (fun s : TriangleEdgeShape =>
            quinticTriangleRepeatMonomialOn mu τ s))
        + Finset.sum (triangleTriples n) (fun τ => quinticExternalEdgeTriangleSumOn mu τ) := by
          rw [Finset.sum_add_distrib]

private lemma quinticP5_matrixOfEdge_eq_explicit_difference
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    quinticP5 n (matrixOfEdge n mu)
      = (1 / 120 : ℝ)
            * ∑ p : EdgeQuintuple n,
                quinticMomentTupleMonomial p mu * quinticMomentTupleGate p
        - (1 / 2 : ℝ)
            * Finset.sum (Finset.univ : Finset (Cn3Torus.Edge n))
                (fun e => Finset.sum (triangleTriples n) (fun τ => quinticSTriangleMonomialOn mu e τ)) := by
  rw [quinticP5, momentX_two_eq_sNorm, momentX_three_eq_six_cubicT]
  rw [sNorm_matrixOfEdge_eq, momentX_five_matrixOfEdge_eq_sum_edgeQuintuples]
  have hmul :
      10 * (6 * cubicT n (matrixOfEdge n mu)) * Cn3Torus.sqNormEdge n mu
        = 60 * (Cn3Torus.sqNormEdge n mu * cubicT n (matrixOfEdge n mu)) := by
    ring
  rw [hmul, sqNormEdge_mul_cubicT_eq_sum_edge_triangleTriples]
  ring

private lemma quinticTriangleRepeatPair_integrable
    {n : ℕ} (τ τ' : TriangleTriple n)
    (hτ : IsTriangleTriple τ) (hτ' : IsTriangleTriple τ')
    (s s' : TriangleEdgeShape) (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      quinticTriangleRepeatMonomial τ hτ s mu * quinticTriangleRepeatMonomial τ' hτ' s' mu
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  let m : Cn3Torus.Edge n → ℕ :=
    quinticTriangleRepeatMultiplicity τ hτ s + quinticTriangleRepeatMultiplicity τ' hτ' s'
  have hdeg :
      (∑ e : Cn3Torus.Edge n, m e) = 2 * 5 := by
    calc
      (∑ e : Cn3Torus.Edge n, m e)
        = (∑ e : Cn3Torus.Edge n, quinticTriangleRepeatMultiplicity τ hτ s e)
            + ∑ e : Cn3Torus.Edge n, quinticTriangleRepeatMultiplicity τ' hτ' s' e := by
              simp [m, Finset.sum_add_distrib]
      _ = 5 + 5 := by
            rw [quinticTriangleRepeatMultiplicity_total_degree,
              quinticTriangleRepeatMultiplicity_total_degree]
      _ = 2 * 5 := by norm_num
  have hbase : MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) :=
    edge_coordMonomial_integrable m 5 (by norm_num) hdeg t ht
  refine hbase.congr ?_
  exact Filter.Eventually.of_forall (fun mu => by
    dsimp [m]
    rw [quinticTriangleRepeatMonomial_eq_coordMonomial,
      quinticTriangleRepeatMonomial_eq_coordMonomial]
    simpa using
      (coordMonomial_mul
        (quinticTriangleRepeatMultiplicity τ hτ s)
        (quinticTriangleRepeatMultiplicity τ' hτ' s') mu).symm)

private lemma quinticTriangleRepeat_pair_gaussian_zero_of_ne
    {n : ℕ} (τ τ' : TriangleTriple n)
    (hτ : IsTriangleTriple τ) (hτ' : IsTriangleTriple τ')
    (hneq : τ ≠ τ') (s s' : TriangleEdgeShape) (t : ℝ) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quinticTriangleRepeatMonomial τ hτ s mu
          * quinticTriangleRepeatMonomial τ' hτ' s' mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = 0 := by
  have hsupp_ne : triangleEdgeSet τ hτ ≠ triangleEdgeSet τ' hτ' := by
    intro hsupp
    exact hneq (triangleTriple_eq_of_triangleEdgeSet_eq τ τ' hτ hτ' hsupp)
  have hex :
      ∃ e : Cn3Torus.Edge n,
        (e ∈ triangleEdgeSet τ hτ ∧ e ∉ triangleEdgeSet τ' hτ') ∨
          (e ∈ triangleEdgeSet τ' hτ' ∧ e ∉ triangleEdgeSet τ hτ) := by
    by_contra hno
    apply hsupp_ne
    ext e
    by_cases heτ : e ∈ triangleEdgeSet τ hτ <;>
      by_cases heτ' : e ∈ triangleEdgeSet τ' hτ' <;> simp [heτ, heτ']
    · exfalso
      exact hno ⟨e, Or.inl ⟨heτ, heτ'⟩⟩
    · exfalso
      exact hno ⟨e, Or.inr ⟨heτ', heτ⟩⟩
  rcases hex with ⟨e, hdiff | hdiff⟩
  · rcases hdiff with ⟨heτ, heτ'⟩
    have hmτ : Odd (quinticTriangleRepeatMultiplicity τ hτ s e) :=
      quinticTriangleRepeatMultiplicity_odd_of_mem_support τ hτ s heτ
    have hmτ' : quinticTriangleRepeatMultiplicity τ' hτ' s' e = 0 :=
      quinticTriangleRepeatMultiplicity_eq_zero_of_not_mem_support τ' hτ' s' heτ'
    have hodd :
        Odd
          ((quinticTriangleRepeatMultiplicity τ hτ s
              + quinticTriangleRepeatMultiplicity τ' hτ' s') e) := by
      simpa [hmτ'] using hmτ
    let m : Cn3Torus.Edge n → ℕ :=
      quinticTriangleRepeatMultiplicity τ hτ s + quinticTriangleRepeatMultiplicity τ' hτ' s'
    calc
      ∫ mu : Cn3Torus.Edge n → ℝ,
          quinticTriangleRepeatMonomial τ hτ s mu
            * quinticTriangleRepeatMonomial τ' hτ' s' mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = ∫ mu : Cn3Torus.Edge n → ℝ,
            coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              refine MeasureTheory.integral_congr_ae ?_
              exact Filter.Eventually.of_forall (fun mu => by
                dsimp [m]
                rw [quinticTriangleRepeatMonomial_eq_coordMonomial,
                  quinticTriangleRepeatMonomial_eq_coordMonomial]
                simpa using
                  (coordMonomial_mul
                    (quinticTriangleRepeatMultiplicity τ hτ s)
                    (quinticTriangleRepeatMultiplicity τ' hτ' s') mu))
      _ = 0 := gaussian_edge_coordMonomial_odd_zero e m t hodd
  · rcases hdiff with ⟨heτ', heτ⟩
    have hmτ' : Odd (quinticTriangleRepeatMultiplicity τ' hτ' s' e) :=
      quinticTriangleRepeatMultiplicity_odd_of_mem_support τ' hτ' s' heτ'
    have hmτ : quinticTriangleRepeatMultiplicity τ hτ s e = 0 :=
      quinticTriangleRepeatMultiplicity_eq_zero_of_not_mem_support τ hτ s heτ
    have hodd :
        Odd
          ((quinticTriangleRepeatMultiplicity τ hτ s
              + quinticTriangleRepeatMultiplicity τ' hτ' s') e) := by
      simpa [hmτ, add_comm] using hmτ'
    let m : Cn3Torus.Edge n → ℕ :=
      quinticTriangleRepeatMultiplicity τ hτ s + quinticTriangleRepeatMultiplicity τ' hτ' s'
    calc
      ∫ mu : Cn3Torus.Edge n → ℝ,
          quinticTriangleRepeatMonomial τ hτ s mu
            * quinticTriangleRepeatMonomial τ' hτ' s' mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = ∫ mu : Cn3Torus.Edge n → ℝ,
            coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              refine MeasureTheory.integral_congr_ae ?_
              exact Filter.Eventually.of_forall (fun mu => by
                dsimp [m]
                rw [quinticTriangleRepeatMonomial_eq_coordMonomial,
                  quinticTriangleRepeatMonomial_eq_coordMonomial]
                simpa using
                  (coordMonomial_mul
                    (quinticTriangleRepeatMultiplicity τ hτ s)
                    (quinticTriangleRepeatMultiplicity τ' hτ' s') mu))
      _ = 0 := gaussian_edge_coordMonomial_odd_zero e m t hodd

private lemma quinticTriangleRepeat_self_gaussian_bound
    {n : ℕ} (τ : TriangleTriple n) (hτ : IsTriangleTriple τ)
    (s : TriangleEdgeShape) (t : ℝ) (ht : 1 ≤ t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (quinticTriangleRepeatMonomial τ hτ s mu) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat)) * gaussianF (dim n) t := by
  let m : Cn3Torus.Edge n → ℕ :=
    quinticTriangleRepeatMultiplicity τ hτ s + quinticTriangleRepeatMultiplicity τ hτ s
  have hdeg :
      (∑ e : Cn3Torus.Edge n, m e) = 2 * 5 := by
    calc
      (∑ e : Cn3Torus.Edge n, m e)
        = (∑ e : Cn3Torus.Edge n, quinticTriangleRepeatMultiplicity τ hτ s e)
            + ∑ e : Cn3Torus.Edge n, quinticTriangleRepeatMultiplicity τ hτ s e := by
              simp [m, Finset.sum_add_distrib]
      _ = 5 + 5 := by
            simp [quinticTriangleRepeatMultiplicity_total_degree]
      _ = 2 * 5 := by norm_num
  have heven : ∀ e : Cn3Torus.Edge n, Even (m e) := by
    intro e
    dsimp [m]
    exact ⟨quinticTriangleRepeatMultiplicity τ hτ s e, by omega⟩
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (quinticTriangleRepeatMonomial τ hτ s mu) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
            refine MeasureTheory.integral_congr_ae ?_
            exact Filter.Eventually.of_forall (fun mu => by
              dsimp [m]
              rw [quinticTriangleRepeatMonomial_eq_coordMonomial]
              rw [pow_two]
              simpa using
                (coordMonomial_mul
                  (quinticTriangleRepeatMultiplicity τ hτ s)
                  (quinticTriangleRepeatMultiplicity τ hτ s) mu))
    _ ≤ (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat)) * gaussianF (dim n) t := by
          exact gaussian_edge_even_coordMonomial_bound m 5 hdeg heven t ht

private lemma quinticMomentTuple_self_gaussian_bound
    {n : ℕ} (p : EdgeQuintuple n) (t : ℝ) (ht : 1 ≤ t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (quinticMomentTupleMonomial p mu) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat)) * gaussianF (dim n) t := by
  let m : Cn3Torus.Edge n → ℕ := quinticMomentTupleMultiplicity p + quinticMomentTupleMultiplicity p
  have hdeg :
      (∑ e : Cn3Torus.Edge n, m e) = 2 * 5 := by
    calc
      (∑ e : Cn3Torus.Edge n, m e)
        = (∑ e : Cn3Torus.Edge n, quinticMomentTupleMultiplicity p e)
            + ∑ e : Cn3Torus.Edge n, quinticMomentTupleMultiplicity p e := by
              simp [m, Finset.sum_add_distrib]
      _ = 5 + 5 := by
            simp [quinticMomentTupleMultiplicity_total_degree]
      _ = 2 * 5 := by norm_num
  have heven : ∀ e : Cn3Torus.Edge n, Even (m e) := by
    intro e
    dsimp [m]
    exact ⟨quinticMomentTupleMultiplicity p e, by omega⟩
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (quinticMomentTupleMonomial p mu) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
            refine MeasureTheory.integral_congr_ae ?_
            exact Filter.Eventually.of_forall (fun mu => by
              dsimp [m]
              rw [quinticMomentTupleMonomial_eq_coordMonomial, pow_two]
              simpa using
                (coordMonomial_mul
                  (quinticMomentTupleMultiplicity p)
                  (quinticMomentTupleMultiplicity p) mu))
    _ ≤ (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat)) * gaussianF (dim n) t := by
          exact gaussian_edge_even_coordMonomial_bound m 5 hdeg heven t ht

private lemma quintic_gate_support_five_activeVertices_eq_of_support_eq
    {n : ℕ} {p q : EdgeQuintuple n}
    (hp5 : (quinticMomentTupleSupport p).card = 5)
    (hq5 : (quinticMomentTupleSupport q).card = 5)
    (hsupp : quinticMomentTupleSupport p = quinticMomentTupleSupport q) :
    quinticActiveVertices p = quinticActiveVertices q := by
  ext i
  rw [mem_quinticActiveVertices_iff, mem_quinticActiveVertices_iff]
  rw [quintic_gate_support_five_rowSum_eq_incident_support_card (p := p) hp5 i]
  rw [quintic_gate_support_five_rowSum_eq_incident_support_card (p := q) hq5 i]
  simpa [hsupp]

private def quinticActiveVertexFiveSets (n : ℕ) : Finset (Finset (Fin n)) :=
  Finset.powersetCard 5 (Finset.univ : Finset (Fin n))

private def quinticSupportFiveActiveFiber (n : ℕ) (A : Finset (Fin n)) : Finset (EdgeQuintuple n) :=
  (quinticGateSupportFiveTuples n).filter (fun p => quinticActiveVertices p = A)

private lemma disjoint_quinticSupportFiveActiveFiber
    {n : ℕ} {A B : Finset (Fin n)} (hAB : A ≠ B) :
    Disjoint (quinticSupportFiveActiveFiber n A) (quinticSupportFiveActiveFiber n B) := by
  refine Finset.disjoint_left.mpr ?_
  intro p hpA hpB
  have hA : quinticActiveVertices p = A := (Finset.mem_filter.mp hpA).2
  have hB : quinticActiveVertices p = B := (Finset.mem_filter.mp hpB).2
  exact hAB (hA.symm.trans hB)

private lemma quinticGateSupportFiveTuples_eq_biUnion_activeFibers (n : ℕ) :
    quinticGateSupportFiveTuples n
      = (quinticActiveVertexFiveSets n).biUnion (quinticSupportFiveActiveFiber n) := by
  classical
  ext p
  constructor
  · intro hp
    rcases (mem_quinticGateSupportFiveTuples_iff p).1 hp with ⟨hgate, hp5⟩
    have hAcard : (quinticActiveVertices p).card = 5 :=
      quintic_gate_support_five_activeVertices_card_eq_five hgate hp5
    have hA :
        quinticActiveVertices p ∈ quinticActiveVertexFiveSets n := by
      exact Finset.mem_powersetCard.mpr ⟨by simp, hAcard⟩
    rw [Finset.mem_biUnion]
    exact ⟨quinticActiveVertices p, hA, by simp [quinticSupportFiveActiveFiber, hp]⟩
  · intro hp
    rw [Finset.mem_biUnion] at hp
    rcases hp with ⟨A, hA, hpA⟩
    exact (Finset.mem_filter.mp hpA).1

private lemma quinticSupportFiveActiveFiber_card_le_edgeQuintuple5
    {n : ℕ} (A : Finset (Fin n)) :
    (quinticSupportFiveActiveFiber n A).card ≤ Fintype.card (EdgeQuintuple 5) := by
  classical
  by_cases hA : A.card = 5
  · let eA : A ≃ Fin 5 := Finset.equivFinOfCardEq hA
    let map : quinticSupportFiveActiveFiber n A → (Finset.univ : Finset (EdgeQuintuple 5)) :=
      fun p =>
        ⟨(fun i =>
          edgeToFin5OfSubset A eA (p.1 i)
            (by
              have hpA : quinticActiveVertices p.1 = A := (Finset.mem_filter.mp p.2).2
              have hi :
                  (p.1 i).1.1 ∈ quinticActiveVertices p.1 := by
                exact quinticMomentTuple_edge_left_endpoint_active
                  (p := p.1) (quinticMomentTuple_mem_support p.1 i)
              simpa [hpA] using hi)
            (by
              have hpA : quinticActiveVertices p.1 = A := (Finset.mem_filter.mp p.2).2
              have hi :
                  (p.1 i).1.2 ∈ quinticActiveVertices p.1 := by
                exact quinticMomentTuple_edge_right_endpoint_active
                  (p := p.1) (quinticMomentTuple_mem_support p.1 i)
              simpa [hpA] using hi)),
          by simp⟩
    have hmap_inj : Function.Injective map := by
      intro p q hpq
      apply Subtype.ext
      funext i
      have hpA : quinticActiveVertices p.1 = A := (Finset.mem_filter.mp p.2).2
      have hqA : quinticActiveVertices q.1 = A := (Finset.mem_filter.mp q.2).2
      have hp_left :
          (p.1 i).1.1 ∈ A := by
        have hi :
            (p.1 i).1.1 ∈ quinticActiveVertices p.1 := by
          exact quinticMomentTuple_edge_left_endpoint_active
            (p := p.1) (quinticMomentTuple_mem_support p.1 i)
        simpa [hpA] using hi
      have hp_right :
          (p.1 i).1.2 ∈ A := by
        have hi :
            (p.1 i).1.2 ∈ quinticActiveVertices p.1 := by
          exact quinticMomentTuple_edge_right_endpoint_active
            (p := p.1) (quinticMomentTuple_mem_support p.1 i)
        simpa [hpA] using hi
      have hq_left :
          (q.1 i).1.1 ∈ A := by
        have hi :
            (q.1 i).1.1 ∈ quinticActiveVertices q.1 := by
          exact quinticMomentTuple_edge_left_endpoint_active
            (p := q.1) (quinticMomentTuple_mem_support q.1 i)
        simpa [hqA] using hi
      have hq_right :
          (q.1 i).1.2 ∈ A := by
        have hi :
            (q.1 i).1.2 ∈ quinticActiveVertices q.1 := by
          exact quinticMomentTuple_edge_right_endpoint_active
            (p := q.1) (quinticMomentTuple_mem_support q.1 i)
        simpa [hqA] using hi
      have hval : ((map p : (Finset.univ : Finset (EdgeQuintuple 5))).1 : EdgeQuintuple 5)
          = ((map q : (Finset.univ : Finset (EdgeQuintuple 5))).1 : EdgeQuintuple 5) := by
        exact congrArg Subtype.val hpq
      have hi : ((map p : (Finset.univ : Finset (EdgeQuintuple 5))).1 : EdgeQuintuple 5) i
          = ((map q : (Finset.univ : Finset (EdgeQuintuple 5))).1 : EdgeQuintuple 5) i := by
        exact congrArg (fun f : EdgeQuintuple 5 => f i) hval
      have hfrom := congrArg (edgeFromFin5OfSubset A eA.symm) hi
      simpa [map,
        edgeFromFin5OfSubset_edgeToFin5OfSubset A eA (p.1 i) hp_left hp_right,
        edgeFromFin5OfSubset_edgeToFin5OfSubset A eA (q.1 i) hq_left hq_right] using hfrom
    simpa using
      (Finset.card_le_card_of_injective
        (s := quinticSupportFiveActiveFiber n A)
        (t := (Finset.univ : Finset (EdgeQuintuple 5)))
        (f := map) hmap_inj)
  · have hempty : quinticSupportFiveActiveFiber n A = ∅ := by
      ext p
      simp [quinticSupportFiveActiveFiber]
      intro hp5 hpA
      rcases (mem_quinticGateSupportFiveTuples_iff p).1 hp5 with ⟨hgate, hsupp5⟩
      have hcardA : (quinticActiveVertices p).card = 5 :=
        quintic_gate_support_five_activeVertices_card_eq_five hgate hsupp5
      exact hA (by simpa [hpA] using hcardA)
    simp [hempty]

private lemma quintic_gate_support_five_pair_gaussian_zero_of_activeVertices_ne
    {n : ℕ} {p q : EdgeQuintuple n} (t : ℝ)
    (hp : p ∈ quinticGateSupportFiveTuples n)
    (hq : q ∈ quinticGateSupportFiveTuples n)
    (hA : quinticActiveVertices p ≠ quinticActiveVertices q) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = 0 := by
  rcases (mem_quinticGateSupportFiveTuples_iff p).1 hp with ⟨-, hp5⟩
  rcases (mem_quinticGateSupportFiveTuples_iff q).1 hq with ⟨-, hq5⟩
  apply quintic_gate_support_five_pair_gaussian_zero_of_support_ne t hp hq
  intro hsupp
  exact hA (quintic_gate_support_five_activeVertices_eq_of_support_eq hp5 hq5 hsupp)

private lemma quinticMomentTuple_pair_gaussian_bound
    {n : ℕ} (p q : EdgeQuintuple n) (t : ℝ) (ht : 1 ≤ t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat)) * gaussianF (dim n) t := by
  let fp : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (quinticMomentTupleMonomial p mu) ^ (2 : Nat)
      * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  let fq : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (quinticMomentTupleMonomial q mu) ^ (2 : Nat)
      * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  let M : ℝ := (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat)) * gaussianF (dim n) t
  have ht_pos : 0 < t := by linarith
  have hp_int : MeasureTheory.Integrable fp := by
    simpa [fp, pow_two] using quinticMomentTuplePair_integrable p p t ht_pos
  have hq_int : MeasureTheory.Integrable fq := by
    simpa [fq, pow_two] using quinticMomentTuplePair_integrable q q t ht_pos
  have hpq_int :
      MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
        quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) :=
    quinticMomentTuplePair_integrable p q t ht_pos
  have hupper_int :
      MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ => (fp mu + fq mu) / 2) := by
    simpa [fp, fq, div_eq_mul_inv, mul_add, add_mul, mul_assoc, mul_left_comm, mul_comm]
      using (hp_int.add hq_int).const_mul (1 / 2 : ℝ)
  have hpoint :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
          ≤ (fp mu + fq mu) / 2 := by
    intro mu
    have hsq :
        0 ≤ (quinticMomentTupleMonomial p mu - quinticMomentTupleMonomial q mu) ^ (2 : Nat) := by
      positivity
    have hw :
        0 ≤ Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by positivity
    dsimp [fp, fq]
    nlinarith
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ ∫ mu : Cn3Torus.Edge n → ℝ, (fp mu + fq mu) / 2 := by
          exact MeasureTheory.integral_mono_ae hpq_int hupper_int
            (Filter.Eventually.of_forall hpoint)
    _ = (1 / 2 : ℝ) * ((∫ mu : Cn3Torus.Edge n → ℝ, fp mu) + ∫ mu : Cn3Torus.Edge n → ℝ, fq mu) := by
          rw [show (fun mu : Cn3Torus.Edge n → ℝ => (fp mu + fq mu) / 2)
              = fun mu : Cn3Torus.Edge n → ℝ => (1 / 2 : ℝ) * (fp mu + fq mu) by
                funext mu
                ring]
          rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_add hp_int hq_int]
    _ ≤ (1 / 2 : ℝ) * (M + M) := by
          gcongr
          · exact quinticMomentTuple_self_gaussian_bound p t ht
          · exact quinticMomentTuple_self_gaussian_bound q t ht
    _ = M := by ring

private lemma quinticSupportFiveActiveFiber_sq_gaussian_bound
    {n : ℕ} (A : Finset (Fin n)) (t : ℝ) (ht : 1 ≤ t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (Finset.sum (quinticSupportFiveActiveFiber n A)
            (fun p => quinticMomentTupleMonomial p mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ ((((quinticSupportFiveActiveFiber n A).card : ℝ) ^ (2 : Nat))
            * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat)))
          * gaussianF (dim n) t := by
  let F := quinticSupportFiveActiveFiber n A
  have ht_pos : 0 < t := by linarith
  have hpair_int :
      ∀ p ∈ F, ∀ q ∈ F,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
    intro p hp q hq
    exact quinticMomentTuplePair_integrable p q t ht_pos
  have houter_int :
      ∀ p ∈ F,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          Finset.sum F (fun q =>
            quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro p hp
    exact MeasureTheory.integrable_finset_sum F (fun q hq => hpair_int p hp q hq)
  have hpoint :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        (Finset.sum F (fun p => quinticMomentTupleMonomial p mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = Finset.sum F (fun p =>
            Finset.sum F (fun q =>
              quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro mu
    rw [pow_two]
    calc
      (Finset.sum F (fun p => quinticMomentTupleMonomial p mu))
          * (Finset.sum F (fun q => quinticMomentTupleMonomial q mu))
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = (Finset.sum F (fun p =>
            Finset.sum F (fun q =>
              quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu)))
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              rw [Finset.sum_mul_sum]
      _ = Finset.sum F (fun p =>
            Finset.sum F (fun q =>
              quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl ?_
            intro p hp
            rw [Finset.sum_mul]
  have hrewrite :
      ∫ mu : Cn3Torus.Edge n → ℝ,
          (Finset.sum (quinticSupportFiveActiveFiber n A)
              (fun p => quinticMomentTupleMonomial p mu)) ^ (2 : Nat)
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = ∫ mu : Cn3Torus.Edge n → ℝ,
            Finset.sum F (fun p =>
              Finset.sum F (fun q =>
                quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
                  * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    refine MeasureTheory.integral_congr_ae ?_
    exact Filter.Eventually.of_forall hpoint
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (Finset.sum (quinticSupportFiveActiveFiber n A)
            (fun p => quinticMomentTupleMonomial p mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          Finset.sum F (fun p =>
            Finset.sum F (fun q =>
              quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := hrewrite
    _ = Finset.sum F (fun p =>
          Finset.sum F (fun q =>
            ∫ mu : Cn3Torus.Edge n → ℝ,
              quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
          rw [MeasureTheory.integral_finset_sum F houter_int]
          refine Finset.sum_congr rfl ?_
          intro p hp
          rw [MeasureTheory.integral_finset_sum F (fun q hq => hpair_int p hp q hq)]
    _ ≤ Finset.sum F (fun _ =>
          Finset.sum F (fun _ =>
            (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat)) * gaussianF (dim n) t)) := by
          refine Finset.sum_le_sum ?_
          intro p hp
          refine Finset.sum_le_sum ?_
          intro q hq
          exact quinticMomentTuple_pair_gaussian_bound p q t ht
    _ = ((((F.card : ℝ) ^ (2 : Nat))
            * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat)))
          * gaussianF (dim n) t) := by
          rw [Finset.sum_const, nsmul_eq_mul]
          rw [Finset.sum_const, nsmul_eq_mul]
          ring

private lemma quinticSupportFiveActiveFiberPair_integrable
    {n : ℕ} (A B : Finset (Fin n)) (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      (Finset.sum (quinticSupportFiveActiveFiber n A)
          (fun p => quinticMomentTupleMonomial p mu))
        * (Finset.sum (quinticSupportFiveActiveFiber n B)
            (fun q => quinticMomentTupleMonomial q mu))
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  let F := quinticSupportFiveActiveFiber n A
  let G := quinticSupportFiveActiveFiber n B
  have hpair_int :
      ∀ p ∈ F, ∀ q ∈ G,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
    intro p hp q hq
    exact quinticMomentTuplePair_integrable p q t ht
  have houter_int :
      ∀ p ∈ F,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          Finset.sum G (fun q =>
            quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro p hp
    exact MeasureTheory.integrable_finset_sum G (fun q hq => hpair_int p hp q hq)
  refine (MeasureTheory.integrable_finset_sum F (fun p hp => houter_int p hp)).congr ?_
  exact Filter.Eventually.of_forall (fun mu => by
    dsimp [F, G]
    rw [Finset.sum_mul_sum]
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl ?_
    intro p hp
    rw [Finset.sum_mul])

