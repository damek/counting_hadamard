private lemma quarticCycleSupport_first_ne_second {n : ℕ}
    (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) :
    quarticCycleSupport σ hσ QuarticCycleShape.first
      ≠ quarticCycleSupport σ hσ QuarticCycleShape.second := by
  intro h
  have hmem : quarticEdge23 σ hσ ∈ quarticCycleSupport σ hσ QuarticCycleShape.first := by
    simp [quarticCycleSupport]
  have hmem' : quarticEdge23 σ hσ ∈ quarticCycleSupport σ hσ QuarticCycleShape.second := by
    rw [← h]
    exact hmem
  have : False := by
    have hbad :
        quarticEdge23 σ hσ = quarticEdge12 σ hσ ∨
          quarticEdge23 σ hσ = quarticEdge24 σ hσ ∨
          quarticEdge23 σ hσ = quarticEdge34 σ hσ ∨
          quarticEdge23 σ hσ = quarticEdge13 σ hσ := by
      simpa [quarticCycleSupport] using hmem'
    rcases hbad with hbad | hbad | hbad | hbad
    · exact quarticEdge12_ne_23 σ hσ hbad.symm
    · exact quarticEdge23_ne_24 σ hσ hbad
    · exact quarticEdge23_ne_34 σ hσ hbad
    · exact quarticEdge13_ne_23 σ hσ hbad.symm
  exact this

