/-- A quantitative version of
`exp_neg_mul_t_div_n_two_thirds_le_eps_gaussianScale_uniform_ge_three`
with an explicit `exp(-c n^2)` factor on the Gaussian scale. -/
theorem exp_neg_mul_t_div_n_two_thirds_le_exp_neg_nsq_mul_gaussianScale_uniform_ge_three
    (a : ℝ) (ha : 0 < a) :
    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧ ∀ n : ℕ, 3 ≤ n →
      ∀ t : ℕ, (t : ℝ) ≥ C * ↑n ^ 3 →
        Real.exp (-(a * (t : ℝ) / ((n : ℝ) ^ (2 / 3 : ℝ))))
          ≤ Real.exp (-(c * (n : ℝ) ^ (2 : Nat))) * gaussianScale n ↑t := by
  let A : ℝ := 128 * Real.pi / a
  let U : ℝ := max (Real.log A) 1
  let C : ℝ := (16 / a) * Real.exp U
  let c : ℝ := a * C / 32
  refine ⟨c, C, ?_, ?_, ?_⟩
  · unfold c C
    positivity [ha]
  · unfold C
    positivity [ha]
  · intro n hn t ht
    have hA_pos : 0 < A := by
      unfold A
      positivity [Real.pi_pos, ha]
    have hU_log : Real.log A ≤ U := by
      unfold U
      exact le_max_left _ _
    have hU_one : (1 : ℝ) ≤ U := by
      unfold U
      exact le_max_right _ _
    have hC_pos : 0 < C := by
      unfold C
      positivity [ha]
    have hC_ge : 16 / a ≤ C := by
      have hexp_one : (1 : ℝ) ≤ Real.exp U := by
        have h0U : 0 ≤ U := by linarith
        simpa using Real.one_le_exp_iff.mpr h0U
      calc
        16 / a = (16 / a) * 1 := by ring
        _ ≤ (16 / a) * Real.exp U := by gcongr
        _ = C := by
              unfold C
              ring
    have hU_le_scaledC : U ≤ (a / 16) * C := by
      have hU_le_exp : U ≤ Real.exp U := by
        have haux := Real.add_one_le_exp U
        linarith
      have hfac : (a / 16) * C = Real.exp U := by
        unfold C
        field_simp [ha.ne']
      rw [hfac]
      exact hU_le_exp
    have hn_pos : 0 < n := by omega
    have hnR_pos : (0 : ℝ) < n := by exact_mod_cast hn_pos
    have hn_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast (show 1 ≤ n by omega)
    have hn_three : (3 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    have hcube_threshold : C * (n : ℝ) ^ (3 : Nat) ≤ (t : ℝ) := by
      simpa [C] using ht
    have ht_pos : (0 : ℝ) < (t : ℝ) := by
      have : 0 < C * (n : ℝ) ^ (3 : Nat) := by positivity [hC_pos, hnR_pos]
      linarith
    set u : ℝ := (t : ℝ) / (C * (n : ℝ) ^ (3 : Nat))
    have hu_pos : 0 < u := by
      unfold u
      positivity [hC_pos, hnR_pos, ht_pos]
    have hu_ge_one : 1 ≤ u := by
      unfold u
      have hdiv :
          C * (n : ℝ) ^ (3 : Nat) / (C * (n : ℝ) ^ (3 : Nat))
            ≤ (t : ℝ) / (C * (n : ℝ) ^ (3 : Nat)) := by
        exact div_le_div_of_nonneg_right hcube_threshold (by positivity [hC_pos, hnR_pos])
      simpa [hC_pos.ne', hnR_pos.ne'] using hdiv
    have hlogu : Real.log u ≤ u := by
      have hlogu' : Real.log u ≤ u - 1 := Real.log_le_sub_one_of_pos hu_pos
      linarith
    have hlogt :
        Real.log (8 * Real.pi * (t : ℝ))
          = Real.log (8 * Real.pi * C) + 3 * Real.log n + Real.log u := by
      have hdecomp : 8 * Real.pi * (t : ℝ) = (8 * Real.pi * C) * ((n : ℝ) ^ (3 : Nat)) * u := by
        unfold u
        field_simp [hC_pos.ne', hnR_pos.ne']
      rw [hdecomp]
      rw [show (8 * Real.pi * C * (n : ℝ) ^ (3 : Nat) * u)
            = (8 * Real.pi * C) * (((n : ℝ) ^ (3 : Nat)) * u) by ring]
      rw [Real.log_mul (show (8 * Real.pi * C) ≠ 0 by positivity [Real.pi_pos, hC_pos])
        (show (((n : ℝ) ^ (3 : Nat)) * u) ≠ 0 by positivity [hnR_pos, hu_pos])]
      rw [Real.log_mul (show ((n : ℝ) ^ (3 : Nat)) ≠ 0 by positivity [hnR_pos]) hu_pos.ne']
      have hlogpow : Real.log ((n : ℝ) ^ (3 : Nat)) = 3 * Real.log n := by
        have hpow := Real.log_rpow hnR_pos (3 : ℝ)
        simpa using hpow
      rw [hlogpow]
      ring_nf
    have hlogC_eq : Real.log (8 * Real.pi * C) = Real.log A + U := by
      have hrewrite : 8 * Real.pi * C = A * Real.exp U := by
        unfold A C
        field_simp [ha.ne']
        ring
      rw [hrewrite, Real.log_mul (show A ≠ 0 by positivity [Real.pi_pos, ha])
        (show Real.exp U ≠ 0 by positivity), Real.log_exp]
    have hlogC_le : Real.log (8 * Real.pi * C) ≤ 2 * U := by
      rw [hlogC_eq]
      nlinarith
    have hsq_le_seven_thirds :
        (n : ℝ) ^ (2 : Nat) ≤ (n : ℝ) ^ (7 / 3 : ℝ) := by
      calc
        (n : ℝ) ^ (2 : Nat) = (n : ℝ) ^ (2 : ℝ) := by
              simpa [Real.rpow_natCast]
        _ ≤ (n : ℝ) ^ (7 / 3 : ℝ) := by
              exact Real.rpow_le_rpow_of_exponent_le hn_one (by norm_num)
    have hsq_le_seven_thirds_u :
        (n : ℝ) ^ (2 : Nat) ≤ (n : ℝ) ^ (7 / 3 : ℝ) * u := by
      nlinarith [hsq_le_seven_thirds, hu_ge_one]
    have hsq_term :
        c * (n : ℝ) ^ (2 : Nat) ≤ (a * C / 32) * (n : ℝ) ^ (7 / 3 : ℝ) * u := by
      have hc_eq : c = a * C / 32 := by
        unfold c
        ring
      rw [hc_eq]
      nlinarith [hsq_le_seven_thirds_u]
    have hlogC_term :
        ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
          ≤ (a * C / 8) * (n : ℝ) ^ (7 / 3 : ℝ) * u := by
      have h1 :
          ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
            ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (2 * U) := by
        have hdim_nonneg : 0 ≤ ((dim n : ℝ) / 2) := by positivity
        calc
          ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
              ≤ ((dim n : ℝ) / 2) * (2 * U) := by
                  exact mul_le_mul_of_nonneg_left hlogC_le hdim_nonneg
          _ ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (2 * U) := by
                gcongr
                exact dim_le_sq n
      have h2 : ((n : ℝ) ^ (2 : Nat) / 2) * (2 * U) = (n : ℝ) ^ (2 : Nat) * U := by ring
      have h3 : (n : ℝ) ^ (2 : Nat) * U ≤ (n : ℝ) ^ (2 : Nat) * ((a / 16) * C) := by
        gcongr
      have h4 :
          (n : ℝ) ^ (2 : Nat) * ((a / 16) * C)
            ≤ (a * C / 8) * (n : ℝ) ^ (7 / 3 : ℝ) * u := by
        nlinarith [hsq_le_seven_thirds_u]
      exact le_trans h1 (le_trans (by rw [h2]) (le_trans h3 h4))
    have hlogn_le :
        Real.log n ≤ 3 * (n : ℝ) ^ (1 / 3 : ℝ) := by
      calc
        Real.log n ≤ (n : ℝ) ^ (1 / 3 : ℝ) / (1 / 3 : ℝ) := by
          exact Real.log_natCast_le_rpow_div n (show 0 < (1 / 3 : ℝ) by positivity)
        _ = 3 * (n : ℝ) ^ (1 / 3 : ℝ) := by
          ring_nf
    have hlogn_term :
        ((dim n : ℝ) / 2) * (3 * Real.log n)
          ≤ (a * C / 4) * (n : ℝ) ^ (7 / 3 : ℝ) * u := by
      have h1 :
          ((dim n : ℝ) / 2) * (3 * Real.log n)
            ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (9 * (n : ℝ) ^ (1 / 3 : ℝ)) := by
        have hdim_nonneg : 0 ≤ ((dim n : ℝ) / 2) := by positivity
        calc
          ((dim n : ℝ) / 2) * (3 * Real.log n)
              ≤ ((dim n : ℝ) / 2) * (9 * (n : ℝ) ^ (1 / 3 : ℝ)) := by
                  have htmp : 3 * Real.log n ≤ 9 * (n : ℝ) ^ (1 / 3 : ℝ) := by
                    nlinarith [hlogn_le]
                  exact mul_le_mul_of_nonneg_left htmp hdim_nonneg
          _ ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (9 * (n : ℝ) ^ (1 / 3 : ℝ)) := by
                gcongr
                exact dim_le_sq n
      have h2 :
          ((n : ℝ) ^ (2 : Nat) / 2) * (9 * (n : ℝ) ^ (1 / 3 : ℝ))
            = (9 / 2 : ℝ) * (n : ℝ) ^ (7 / 3 : ℝ) := by
        have hpow :
            (n : ℝ) ^ (7 / 3 : ℝ) = (n : ℝ) ^ (2 : Nat) * (n : ℝ) ^ (1 / 3 : ℝ) := by
          calc
            (n : ℝ) ^ (7 / 3 : ℝ) = (n : ℝ) ^ ((2 : ℝ) + (1 / 3 : ℝ)) := by
              congr 2
              norm_num
            _ = (n : ℝ) ^ (2 : ℝ) * (n : ℝ) ^ (1 / 3 : ℝ) := by
              rw [Real.rpow_add hnR_pos]
            _ = (n : ℝ) ^ (2 : Nat) * (n : ℝ) ^ (1 / 3 : ℝ) := by
              simp [Real.rpow_natCast]
        calc
          ((n : ℝ) ^ (2 : Nat) / 2) * (9 * (n : ℝ) ^ (1 / 3 : ℝ))
              = (9 / 2 : ℝ) * ((n : ℝ) ^ (2 : Nat) * (n : ℝ) ^ (1 / 3 : ℝ)) := by ring
          _ = (9 / 2 : ℝ) * (n : ℝ) ^ (7 / 3 : ℝ) := by simpa [hpow]
      have h3 :
          (9 / 2 : ℝ) * (n : ℝ) ^ (7 / 3 : ℝ)
            ≤ (a * C / 4) * (n : ℝ) ^ (7 / 3 : ℝ) * u := by
        have hcoef : (9 / 2 : ℝ) ≤ a * C / 4 := by
          have hexp_two : (2 : ℝ) ≤ Real.exp U := by
            have htwo_lt : (2 : ℝ) < Real.exp (1 : ℝ) := by
              have h := add_one_lt_exp (show (1 : ℝ) ≠ 0 by norm_num)
              linarith
            calc
              (2 : ℝ) ≤ Real.exp (1 : ℝ) := le_of_lt htwo_lt
              _ ≤ Real.exp U := by gcongr
          have hAC_ge : (32 : ℝ) ≤ a * C := by
            have hAC_eq : a * C = 16 * Real.exp U := by
              unfold C
              field_simp [ha.ne']
            rw [hAC_eq]
            nlinarith
          nlinarith
        nlinarith [hcoef, hu_ge_one]
      exact le_trans h1 (by rw [h2]; exact h3)
    have hlogu_term :
        ((dim n : ℝ) / 2) * Real.log u
          ≤ (a * C / 8) * (n : ℝ) ^ (7 / 3 : ℝ) * u := by
      have h1 :
          ((dim n : ℝ) / 2) * Real.log u ≤ ((n : ℝ) ^ (2 : Nat) / 2) * u := by
        have hdim_nonneg : 0 ≤ ((dim n : ℝ) / 2) := by positivity
        calc
          ((dim n : ℝ) / 2) * Real.log u ≤ ((dim n : ℝ) / 2) * u := by
            exact mul_le_mul_of_nonneg_left hlogu hdim_nonneg
          _ ≤ ((n : ℝ) ^ (2 : Nat) / 2) * u := by
            nlinarith [dim_le_sq n, hu_pos]
      have h2 :
          ((n : ℝ) ^ (2 : Nat) / 2) * u
            ≤ (a * C / 8) * (n : ℝ) ^ (7 / 3 : ℝ) * u := by
        have hcoef : (1 / 2 : ℝ) ≤ a * C / 8 := by
          have : (16 : ℝ) ≤ a * C := by nlinarith [hC_ge]
          nlinarith
        nlinarith [hsq_le_seven_thirds_u, hcoef]
      exact le_trans h1 h2
    have htn_div :
        (t : ℝ) / ((n : ℝ) ^ (2 / 3 : ℝ))
          = C * (n : ℝ) ^ (7 / 3 : ℝ) * u := by
      have hdecomp : (t : ℝ) = C * (n : ℝ) ^ (3 : Nat) * u := by
        unfold u
        field_simp [hC_pos.ne', hnR_pos.ne']
      have hpow :
          ((n : ℝ) ^ (3 : Nat)) / ((n : ℝ) ^ (2 / 3 : ℝ)) = (n : ℝ) ^ (7 / 3 : ℝ) := by
        rw [← Real.rpow_natCast]
        rw [div_eq_mul_inv, ← Real.rpow_neg hnR_pos.le, ← Real.rpow_add hnR_pos]
        congr 1
        ring
      have hn_pow_ne : (n : ℝ) ^ (2 / 3 : ℝ) ≠ 0 := by positivity
      rw [hdecomp]
      calc
        (C * (n : ℝ) ^ (3 : Nat) * u) / ((n : ℝ) ^ (2 / 3 : ℝ))
          = C * (((n : ℝ) ^ (3 : Nat)) / ((n : ℝ) ^ (2 / 3 : ℝ))) * u := by
              field_simp [hn_pow_ne]
        _ = C * (n : ℝ) ^ (7 / 3 : ℝ) * u := by rw [hpow]
    have hmain :
        c * (n : ℝ) ^ (2 : Nat)
          + ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))
          ≤ a * (t : ℝ) / ((n : ℝ) ^ (2 / 3 : ℝ)) := by
      have hsplit :
          c * (n : ℝ) ^ (2 : Nat)
            + ((dim n : ℝ) / 2) * (Real.log (8 * Real.pi * C) + 3 * Real.log n + Real.log u)
            = c * (n : ℝ) ^ (2 : Nat)
                + ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
                + ((dim n : ℝ) / 2) * (3 * Real.log n)
                + ((dim n : ℝ) / 2) * Real.log u := by ring
      have hmain' :
          c * (n : ℝ) ^ (2 : Nat)
              + ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
              + ((dim n : ℝ) / 2) * (3 * Real.log n)
              + ((dim n : ℝ) / 2) * Real.log u
            ≤ a * C * (n : ℝ) ^ (7 / 3 : ℝ) * u := by
        nlinarith [hsq_term, hlogC_term, hlogn_term, hlogu_term]
      calc
        c * (n : ℝ) ^ (2 : Nat) + ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))
          = c * (n : ℝ) ^ (2 : Nat)
              + ((dim n : ℝ) / 2) * (Real.log (8 * Real.pi * C) + 3 * Real.log n + Real.log u) := by
                rw [hlogt]
        _ = c * (n : ℝ) ^ (2 : Nat)
              + ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
              + ((dim n : ℝ) / 2) * (3 * Real.log n)
              + ((dim n : ℝ) / 2) * Real.log u := hsplit
        _ ≤ a * C * (n : ℝ) ^ (7 / 3 : ℝ) * u := hmain'
        _ = a * (t : ℝ) / ((n : ℝ) ^ (2 / 3 : ℝ)) := by
              calc
                a * C * (n : ℝ) ^ (7 / 3 : ℝ) * u = a * (C * (n : ℝ) ^ (7 / 3 : ℝ) * u) := by
                  ring
                _ = a * ((t : ℝ) / ((n : ℝ) ^ (2 / 3 : ℝ))) := by rw [← htn_div]
                _ = a * (t : ℝ) / ((n : ℝ) ^ (2 / 3 : ℝ)) := by ring
    have hneg :
        -(a * (t : ℝ) / ((n : ℝ) ^ (2 / 3 : ℝ)))
          ≤ -(c * (n : ℝ) ^ (2 : Nat))
              - ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ)) := by
      nlinarith [hmain]
    have hmain_exp :
        Real.exp (-(a * (t : ℝ) / ((n : ℝ) ^ (2 / 3 : ℝ))))
          ≤ Real.exp (-(c * (n : ℝ) ^ (2 : Nat)))
              * (8 * Real.pi * (t : ℝ)) ^ (-((dim n : ℝ) / 2)) := by
      calc
        Real.exp (-(a * (t : ℝ) / ((n : ℝ) ^ (2 / 3 : ℝ))))
            ≤ Real.exp (-(c * (n : ℝ) ^ (2 : Nat))
                - ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))) := by
                  exact Real.exp_le_exp.mpr hneg
        _ = Real.exp (-(c * (n : ℝ) ^ (2 : Nat)))
              * (8 * Real.pi * (t : ℝ)) ^ (-((dim n : ℝ) / 2)) := by
              rw [show -(c * (n : ℝ) ^ (2 : Nat))
                      - ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))
                      = (-(c * (n : ℝ) ^ (2 : Nat)))
                          + (-((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))) by ring,
                Real.exp_add]
              congr 1
              rw [Real.rpow_def_of_pos (by positivity [Real.pi_pos, ht_pos])]
              ring_nf
    have htoScale : (8 * Real.pi * (t : ℝ)) ^ (-((Cn3Torus.d n : ℝ) / 2)) ≤ gaussianScale n ↑t := by
      unfold gaussianScale dim
      have hsub : n ≤ 2 * Nat.choose n 2 := Cn3Torus.n_le_two_mul_d n hn
      have hExp : ((2 * Nat.choose n 2 - n + 1 : Nat) : ℤ) = (2 * ↑(Nat.choose n 2) - ↑n + 1 : ℤ) := by
        rw [Nat.cast_add, Nat.cast_sub hsub, Nat.cast_one]
        norm_num
      have hcoeff_ge_one_nat : (1 : ℝ) ≤ (2 : ℝ) ^ (2 * Nat.choose n 2 - n + 1 : Nat) := by
        exact one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2)
      have hcoeff_ge_one : (1 : ℝ) ≤ (2 ^ (2 * Nat.choose n 2 - n + 1 : ℤ) : ℝ) := by
        rw [← hExp, zpow_natCast]
        simpa using hcoeff_ge_one_nat
      have hbase_nonneg_arg : 0 ≤ 8 * Real.pi * (t : ℝ) := by positivity [Real.pi_pos, ht_pos]
      have hbase_nonneg : 0 ≤ (8 * Real.pi * (t : ℝ)) ^ (-((Nat.choose n 2 : ℝ) / 2)) := by
        exact Real.rpow_nonneg hbase_nonneg_arg _
      have hmul :
          (8 * Real.pi * (t : ℝ)) ^ (-((Nat.choose n 2 : ℝ) / 2))
            ≤ (2 ^ (2 * Nat.choose n 2 - n + 1 : ℤ) : ℝ)
                * (8 * Real.pi * (t : ℝ)) ^ (-((Nat.choose n 2 : ℝ) / 2)) := by
        nlinarith
      have hrew : -((Nat.choose n 2 : ℝ) / 2) = -(↑(Nat.choose n 2)) / 2 := by ring
      simpa [hrew, Cn3Torus.d, mul_assoc, mul_left_comm, mul_comm] using hmul
    calc
      Real.exp (-(a * (t : ℝ) / ((n : ℝ) ^ (2 / 3 : ℝ))))
        ≤ Real.exp (-(c * (n : ℝ) ^ (2 : Nat)))
            * (8 * Real.pi * (t : ℝ)) ^ (-((dim n : ℝ) / 2)) := hmain_exp
      _ ≤ Real.exp (-(c * (n : ℝ) ^ (2 : Nat))) * gaussianScale n ↑t := by
            exact mul_le_mul_of_nonneg_left htoScale (by positivity)

/-- The truncated Gaussian core differs from the full Gaussian mass by an
exponentially small factor in the dimension. -/
lemma coreMass_gap_le_exp_gaussianF :
    ∃ c : ℝ, 0 < c ∧
      ∀ n : ℕ, ∀ t : ℝ, 1 ≤ t →
        |coreMass (dim n) t - gaussianF (dim n) t|
          ≤ Real.exp (-(c * (dim n : ℝ))) * gaussianF (dim n) t := by
  obtain ⟨c, hc_pos, hcore⟩ := inner_core_gaussian_mass
  refine ⟨c, hc_pos, ?_⟩
  intro n t ht
  have hcore_le : coreMass (dim n) t ≤ gaussianF (dim n) t := coreMass_le_gaussianF n t (by linarith)
  have hcore_ge :
      (1 - Real.exp (-(c * (dim n : ℝ)))) * gaussianF (dim n) t
        ≤ coreMass (dim n) t := by
    exact hcore (dim n) t ht
  have hgauss_nonneg : 0 ≤ gaussianF (dim n) t := by
    exact Real.rpow_nonneg (by positivity) _
  have hgap :
      gaussianF (dim n) t - coreMass (dim n) t
        ≤ Real.exp (-(c * (dim n : ℝ))) * gaussianF (dim n) t := by
    nlinarith
  have habs :
      |coreMass (dim n) t - gaussianF (dim n) t|
        = gaussianF (dim n) t - coreMass (dim n) t := by
    rw [abs_of_nonpos]
    · ring
    · exact sub_nonpos.mpr hcore_le
  rw [habs]
  exact hgap

lemma edgeBox_delta_subset_pi_div_four (n : ℕ) :
    edgeBox n Cn3Torus.delta ⊆ edgeBox n (π / 4) := by
  intro mu hmu
  rw [edgeBox_eq_pi] at hmu ⊢
  intro e he
  rcases hmu e he with ⟨hlo, hhi⟩
  constructor <;> linarith [Cn3Torus.delta_lt_pi_div_four]

/-- The even far shell is measurable. -/
lemma measurableSet_edgeEvenFarShell (n : ℕ) (r : ℝ) :
    MeasurableSet (edgeEvenFarShell n r) := by
  have hsq :
      Measurable (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
    Cn3Torus.continuous_sqNormEdge n |>.measurable
  have hset :
      edgeEvenFarShell n r
        = edgeBox n (π / 4) ∩ {mu : Cn3Torus.Edge n → ℝ | r ^ (2 : Nat) ≤ Cn3Torus.sqNormEdge n mu} := by
    ext mu
    exact mem_edgeEvenFarShell_iff n r mu
  rw [hset]
  exact (edgeBox_isCompact n (π / 4)).measurableSet.inter (measurableSet_le measurable_const hsq)

/-- Continuity of the repaired core integrand in edge coordinates. -/
lemma continuous_correctedCoreIntegrand (n t : ℕ) :
    Continuous (fun mu : Cn3Torus.Edge n → ℝ => correctedCoreIntegrand n t mu) := by
  have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
    Cn3Torus.continuous_sqNormEdge n
  have hcubic : Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
    (continuous_cubicT n).comp (continuous_matrixOfEdge n)
  have hquart :
      Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
    (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
  have hquint :
      Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
    (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
  unfold correctedCoreIntegrand correctedCoreExponent
  fun_prop

/-- Continuity of the quartic core integrand in edge coordinates. -/
lemma continuous_quarticCoreIntegrand (n t : ℕ) :
    Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCoreIntegrand n t mu) := by
  have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
    Cn3Torus.continuous_sqNormEdge n
  have hcubic : Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
    (continuous_cubicT n).comp (continuous_matrixOfEdge n)
  have hquart :
      Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
    (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
  unfold quarticCoreIntegrand quarticCoreExponent
  fun_prop

/-- Continuity of the cubic core integrand in edge coordinates. -/
lemma continuous_cubicCoreIntegrand (n t : ℕ) :
    Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicCoreIntegrand n t mu) := by
  have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
    Cn3Torus.continuous_sqNormEdge n
  have hcubic : Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
    (continuous_cubicT n).comp (continuous_matrixOfEdge n)
  unfold cubicCoreIntegrand cubicCoreExponent
  fun_prop

/-- Monotonicity of set integrals for nonnegative real functions. -/
lemma integralOn_mono_of_nonneg
    {α : Type*} [MeasurableSpace α]
    {μ : MeasureTheory.Measure α}
    {s t : Set α} {f : α → ℝ}
    (hsubset : s ⊆ t)
    (hs : MeasurableSet s) (ht : MeasurableSet t)
    (hf_int : MeasureTheory.IntegrableOn f t μ)
    (hf_nonneg : 0 ≤ᵐ[μ.restrict t] f) :
    ∫ x in s, f x ∂μ ≤ ∫ x in t, f x ∂μ := by
  let ν : MeasureTheory.Measure α := μ.restrict t
  have hf_ind : MeasureTheory.Integrable (Set.indicator s f) ν := by
    exact hf_int.indicator hs
  have hmono_ae : ∀ᵐ x ∂ν, Set.indicator s f x ≤ f x := by
    filter_upwards [hf_nonneg] with x hxnonneg
    by_cases hxs : x ∈ s
    · simp [Set.indicator, hxs]
    · simpa [Set.indicator, hxs] using hxnonneg
  have hmono :
      ∫ x, Set.indicator s f x ∂ν ≤ ∫ x, f x ∂ν := by
    exact MeasureTheory.integral_mono_ae hf_ind hf_int hmono_ae
  have hs_eq :
      ∫ x in s, f x ∂μ = ∫ x, Set.indicator s f x ∂ν := by
    have hind :
        ∫ x, Set.indicator s f x ∂ν = ∫ x in s, f x ∂ν := by
      exact MeasureTheory.integral_indicator hs
    rw [hind]
    simp [ν, MeasureTheory.Measure.restrict_restrict, hs, Set.inter_eq_left.mpr hsubset]
  have ht_eq : ∫ x in t, f x ∂μ = ∫ x, f x ∂ν := by
    rfl
  rw [hs_eq, ht_eq]
  exact hmono

/-- Integrated bridge 1: the exact core integral is close to the repaired core model
once the pointwise `n^3/t^2` error is integrated against the quartic weight. -/
private lemma repaired_step1_core_integral_gap_le
    (n t : ℕ) (ht : 1 ≤ t)
    (hbox : (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat))
    {c C B : ℝ}
    (hC_nonneg : 0 ≤ C)
    (hpoint :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        mu ∈ edgeCoreRegion n (t : ℝ) →
        (dim n : ℝ) / (t : ℝ) ≤ c →
        ((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat) ≤ c →
        ‖Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu‖
          ≤ (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
              * Real.exp
                  (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                    + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)))
    (hdt : (dim n : ℝ) / (t : ℝ) ≤ c)
    (hd3 : ((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat) ≤ c)
    (hB :
      ∫ mu in edgeCoreRegion n (t : ℝ),
          Real.exp
            (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
              + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
        ≤ B) :
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (Cn3Torus.psi n mu ^ (4 * t)))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))|
      ≤ (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat)) * B := by
  let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n (t : ℝ)
  have hpsi_cont : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.psi n mu ^ (4 * t)) :=
    (Cn3Torus.continuous_psi n).pow (4 * t)
  have hpsi_int :
      MeasureTheory.IntegrableOn (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.psi n mu ^ (4 * t)) core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hpsi_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hcorr_int :
      MeasureTheory.IntegrableOn (fun mu : Cn3Torus.Edge n → ℝ => correctedCoreIntegrand n t mu) core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      ((continuous_correctedCoreIntegrand n t).continuousOn.integrableOn_compact
        (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hbound_cont :
      Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
        (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
          * Real.exp
              (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))) := by
    have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    have hquart :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
      (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
    fun_prop
  have hbound_int :
      MeasureTheory.IntegrableOn
        (fun mu : Cn3Torus.Edge n → ℝ =>
          (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
            * Real.exp
                (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                  + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))) core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hbound_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have habs :=
    abs_integral_re_sub_le_integral_norm (n := n) (s := core)
      (f := fun mu => Cn3Torus.psi n mu ^ (4 * t))
      (g := fun mu => correctedCoreIntegrand n t mu) hpsi_int hcorr_int
  have hdiff_cont :
      Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
        ‖Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu‖) := by
    exact (hpsi_cont.sub (continuous_correctedCoreIntegrand n t)).norm
  have hpoint_ae :
      ∀ᵐ mu ∂(MeasureTheory.volume.restrict core),
        ‖Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu‖
          ≤ (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
              * Real.exp
                  (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                    + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
    have hpoint_ae' :
        ∀ᵐ mu ∂(MeasureTheory.volume.restrict (edgeCoreRegion n (t : ℝ))),
          ‖Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu‖
            ≤ (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
                * Real.exp
                    (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                      + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
      have hmeas :
          MeasurableSet
            {mu : Cn3Torus.Edge n → ℝ |
              ‖Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu‖
                ≤ (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
                    * Real.exp
                        (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                          + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))} := by
        exact measurableSet_le hdiff_cont.measurable hbound_cont.measurable
      rw [MeasureTheory.ae_restrict_iff hmeas]
      exact Filter.Eventually.of_forall (fun mu hmu => hpoint mu hmu hdt hd3)
    simpa [core] using hpoint_ae'
  have hnorm_le :
      ∫ mu in core, ‖Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu‖
        ≤ ∫ mu in core,
            (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
              * Real.exp
                  (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                    + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
    exact MeasureTheory.integral_mono_ae (hpsi_int.sub hcorr_int).norm hbound_int hpoint_ae
  calc
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (Cn3Torus.psi n mu ^ (4 * t)))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))|
      ≤ ∫ mu in core, ‖Cn3Torus.psi n mu ^ (4 * t) - correctedCoreIntegrand n t mu‖ := habs
    _ ≤ ∫ mu in core,
          (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
            * Real.exp
                (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                  + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := hnorm_le
    _ = (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
          * ∫ mu in edgeCoreRegion n (t : ℝ),
              Real.exp
                (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
                  + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
            rw [MeasureTheory.integral_const_mul]
    _ ≤ (C * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat)) * B := by
          gcongr

/-- Integrated bridge 2: the quintic phase removal is controlled by the `L²` quintic
mass and the quartic exponential `L²` bound. -/
private lemma correctedCore_core_integral_gap_abs_le
    (n t : ℕ)
    (hbox : (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat))
    {A B : ℝ}
    (hA0 : 0 ≤ A)
    (hquintic :
      ∫ mu in edgeCoreRegion n (t : ℝ),
          (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
            * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
        ≤ A)
    (hquartic :
      ∫ mu in edgeCoreRegion n (t : ℝ),
          Real.exp (8 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
            * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
        ≤ B) :
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))|
      ≤ ((16 * (t : ℝ) ^ (2 : Nat)) * A) ^ (1 / (2 : ℝ)) * B ^ (1 / (2 : ℝ)) := by
  let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n (t : ℝ)
  have hcorr_int :
      MeasureTheory.IntegrableOn (fun mu : Cn3Torus.Edge n → ℝ => correctedCoreIntegrand n t mu) core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      ((continuous_correctedCoreIntegrand n t).continuousOn.integrableOn_compact
        (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hquart_int :
      MeasureTheory.IntegrableOn (fun mu : Cn3Torus.Edge n → ℝ => quarticCoreIntegrand n t mu) core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      ((continuous_quarticCoreIntegrand n t).continuousOn.integrableOn_compact
        (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  calc
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))|
      ≤ ∫ mu in core, ‖correctedCoreIntegrand n t mu - quarticCoreIntegrand n t mu‖ := by
          exact abs_integral_re_sub_le_integral_norm (n := n) (s := core)
            (f := fun mu => correctedCoreIntegrand n t mu)
            (g := fun mu => quarticCoreIntegrand n t mu) hcorr_int hquart_int
    _ ≤ ((16 * (t : ℝ) ^ (2 : Nat)) * A) ^ (1 / (2 : ℝ)) * B ^ (1 / (2 : ℝ)) := by
          exact correctedCore_integral_gap_le n t hbox hA0 hquintic hquartic

/-- Integrated bridge 3: stripping the quartic correction is controlled by the
quartic `L²` gap against the Gaussian core. -/
private lemma quarticCore_core_integral_gap_abs_le
    (n t : ℕ)
    (hbox : (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat))
    {c₄ C₄ : ℝ}
    (hquartic :
      (dim n : ℝ) / (t : ℝ) ≤ c₄ →
      (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ c₄ →
      ∫ mu in edgeCoreRegion n (t : ℝ),
          |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1| ^ (2 : Nat)
            * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
        ≤ (C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ))
    (hdim : (dim n : ℝ) / (t : ℝ) ≤ c₄)
    (hcube : (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ c₄) :
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (cubicCoreIntegrand n t mu))|
      ≤ ((C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ))
            ^ (1 / (2 : ℝ))
          * (coreMass (dim n) (t : ℝ)) ^ (1 / (2 : ℝ)) := by
  let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n (t : ℝ)
  have hquart_int :
      MeasureTheory.IntegrableOn (fun mu : Cn3Torus.Edge n → ℝ => quarticCoreIntegrand n t mu) core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      ((continuous_quarticCoreIntegrand n t).continuousOn.integrableOn_compact
        (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hcubic_int :
      MeasureTheory.IntegrableOn (fun mu : Cn3Torus.Edge n → ℝ => cubicCoreIntegrand n t mu) core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      ((continuous_cubicCoreIntegrand n t).continuousOn.integrableOn_compact
        (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  calc
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (cubicCoreIntegrand n t mu))|
      ≤ ∫ mu in core, ‖quarticCoreIntegrand n t mu - cubicCoreIntegrand n t mu‖ := by
          exact abs_integral_re_sub_le_integral_norm (n := n) (s := core)
            (f := fun mu => quarticCoreIntegrand n t mu)
            (g := fun mu => cubicCoreIntegrand n t mu) hquart_int hcubic_int
    _ ≤ ((C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ))
            ^ (1 / (2 : ℝ))
          * (coreMass (dim n) (t : ℝ)) ^ (1 / (2 : ℝ)) := by
          exact quarticCore_integral_gap_le n t hbox hquartic hdim hcube

/-- Integrated bridge 4: the cubic core model differs from `coreMass` by the
quantified cubic lower-bound error. -/
private lemma localIntegral_sub_inner_abs_le_annulus_plus_far_aux
    (n t : ℕ)
    (inner A B : Set (Cn3Torus.Edge n → ℝ))
    (hinner_box : inner ⊆ edgeBox n Cn3Torus.delta)
    (hA_sub_box : A ⊆ edgeBox n Cn3Torus.delta)
    (hB_sub_box : B ⊆ edgeBox n Cn3Torus.delta)
    (hshell_union : edgeBox n Cn3Torus.delta \ inner = A ∪ B)
    (hAB_disj : Disjoint A B)
    (hinner_meas : MeasurableSet inner)
    (hA_meas : MeasurableSet A)
    (hB_meas : MeasurableSet B) :
    |Cn3Torus.localIntegral n t - ∫ mu in inner, Complex.re (Cn3Torus.psi n mu ^ (4 * t))|
      ≤ (∫ mu in A, ‖Cn3Torus.psi n mu‖ ^ (4 * t))
          + ∫ mu in B, ‖Cn3Torus.psi n mu‖ ^ (4 * t) := by
  let box : Set (Cn3Torus.Edge n → ℝ) := edgeBox n Cn3Torus.delta
  let shell : Set (Cn3Torus.Edge n → ℝ) := box \ inner
  let fC : (Cn3Torus.Edge n → ℝ) → ℂ := fun mu => Cn3Torus.psi n mu ^ (4 * t)
  let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu => Complex.re (fC mu)
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu => ‖Cn3Torus.psi n mu‖ ^ (4 * t)
  have hfC_cont : Continuous fC := (Cn3Torus.continuous_psi n).pow (4 * t)
  have hf_cont : Continuous f := Complex.continuous_re.comp hfC_cont
  have hg_cont : Continuous g := (Cn3Torus.continuous_psi n).norm.pow (4 * t)
  have hfC_box : MeasureTheory.IntegrableOn fC box := by
    simpa [box, MeasureTheory.IntegrableOn] using
      hfC_cont.continuousOn.integrableOn_compact (edgeBox_isCompact n Cn3Torus.delta)
  have hf_box : MeasureTheory.IntegrableOn f box := by
    simpa [box, MeasureTheory.IntegrableOn] using
      hf_cont.continuousOn.integrableOn_compact (edgeBox_isCompact n Cn3Torus.delta)
  have hg_box : MeasureTheory.IntegrableOn g box := by
    simpa [box, MeasureTheory.IntegrableOn] using
      hg_cont.continuousOn.integrableOn_compact (edgeBox_isCompact n Cn3Torus.delta)
  have hf_inner : MeasureTheory.IntegrableOn f inner := hf_box.mono_set hinner_box
  have hf_shell : MeasureTheory.IntegrableOn f shell := hf_box.mono_set (by intro x hx; exact hx.1)
  have hfC_shell : MeasureTheory.IntegrableOn fC shell := hfC_box.mono_set (by intro x hx; exact hx.1)
  have hg_A : MeasureTheory.IntegrableOn g A := hg_box.mono_set hA_sub_box
  have hg_B : MeasureTheory.IntegrableOn g B := hg_box.mono_set hB_sub_box
  have hshell_meas : MeasurableSet shell := by
    dsimp [shell, box]
    exact (edgeBox_isCompact n Cn3Torus.delta).measurableSet.diff hinner_meas
  have hshell_union' : shell = A ∪ B := by
    simpa [shell, box] using hshell_union
  have hbox_split :
      ∫ mu in box, f mu = (∫ mu in inner, f mu) + ∫ mu in shell, f mu := by
    have hbox_eq : inner ∪ shell = box := by
      simpa [shell] using Set.union_diff_cancel hinner_box
    have hinner_shell_disj : Disjoint inner shell := by
      rw [Set.disjoint_left]
      intro x hx hxs
      exact hxs.2 hx
    rw [← hbox_eq]
    exact MeasureTheory.integral_union_ae hinner_shell_disj.aedisjoint
      hshell_meas.nullMeasurableSet hf_inner hf_shell
  have hshell_split :
      ∫ mu in shell, g mu = (∫ mu in A, g mu) + ∫ mu in B, g mu := by
    rw [hshell_union']
    exact MeasureTheory.integral_union_ae hAB_disj.aedisjoint
      hB_meas.nullMeasurableSet hg_A hg_B
  have hbox_local : box = Cn3Torus.localBox n := by
    simp [box, Cn3Torus.localBox, Cn3Torus.delta, edgeBox_eq_pi]
  have hlocal_edge : ∫ mu in box, f mu = Cn3Torus.localIntegral n t := by
    simpa [hbox_local, f, fC, Cn3Torus.localIntegral]
  have hshell_repr :
      Cn3Torus.localIntegral n t - ∫ mu in inner, f mu = ∫ mu in shell, f mu := by
    linarith [hbox_split, hlocal_edge]
  have habs_shell :
      |∫ mu in shell, f mu|
        ≤ ∫ mu in shell, g mu := by
    simpa [f, fC, g, norm_pow] using
      (abs_integral_re_le_integral_norm (n := n) (s := shell) (f := fC) hfC_shell)
  calc
    |Cn3Torus.localIntegral n t - ∫ mu in inner, Complex.re (Cn3Torus.psi n mu ^ (4 * t))|
      = |∫ mu in shell, f mu| := by
          rw [hshell_repr]
    _ ≤ ∫ mu in shell, g mu := habs_shell
    _ = (∫ mu in A, g mu) + ∫ mu in B, g mu := hshell_split

/-- Splitting the local box into the dynamic core plus the two shell pieces used in the
final argument. -/
lemma localIntegral_sub_core_abs_le_annulus_plus_far
    (n t : ℕ)
    (hbox : (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat))
    (r : ℝ) :
    let box : Set (Cn3Torus.Edge n → ℝ) := edgeBox n Cn3Torus.delta
    let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n (t : ℝ)
    let A : Set (Cn3Torus.Edge n → ℝ) := ((box ∩ edgeEuclidBall n r) \ core)
    let B : Set (Cn3Torus.Edge n → ℝ) := ((box \ edgeEuclidBall n r) \ core)
    |Cn3Torus.localIntegral n t - ∫ mu in core, Complex.re (Cn3Torus.psi n mu ^ (4 * t))|
      ≤ (∫ mu in A, ‖Cn3Torus.psi n mu‖ ^ (4 * t))
          + ∫ mu in B, ‖Cn3Torus.psi n mu‖ ^ (4 * t) := by
  let box : Set (Cn3Torus.Edge n → ℝ) := edgeBox n Cn3Torus.delta
  let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n (t : ℝ)
  let A : Set (Cn3Torus.Edge n → ℝ) := ((box ∩ edgeEuclidBall n r) \ core)
  let B : Set (Cn3Torus.Edge n → ℝ) := ((box \ edgeEuclidBall n r) \ core)
  have hbox_local : box = Cn3Torus.localBox n := by
    simp [box, Cn3Torus.localBox, Cn3Torus.delta, edgeBox_eq_pi]
  have hcore_box : core ⊆ box := by
    intro mu hmu
    simpa [hbox_local] using
      (edgeCoreRegion_subset_localBox n hbox hmu)
  have hA_sub_box : A ⊆ box := by
    intro mu hmu
    exact hmu.1.1
  have hB_sub_box : B ⊆ box := by
    intro mu hmu
    exact hmu.1.1
  have hshell_union : box \ core = A ∪ B := by
    ext mu
    by_cases hball : mu ∈ edgeEuclidBall n r
    · simp [A, B, box, core, hball]
    · simp [A, B, box, core, hball]
  have hAB_disj : Disjoint A B := by
    rw [Set.disjoint_left]
    intro mu hA hB
    exact hB.1.2 hA.1.2
  have hcore_meas : MeasurableSet core := measurableSet_edgeCoreRegion n (t : ℝ)
  have hA_meas : MeasurableSet A := by
    dsimp [A, box, core]
    exact ((edgeBox_isCompact n Cn3Torus.delta).measurableSet.inter
      (measurableSet_edgeEuclidBall n r)).diff (measurableSet_edgeCoreRegion n (t : ℝ))
  have hB_meas : MeasurableSet B := by
    dsimp [B, box, core]
    exact ((edgeBox_isCompact n Cn3Torus.delta).measurableSet.diff
      (measurableSet_edgeEuclidBall n r)).diff (measurableSet_edgeCoreRegion n (t : ℝ))
  simpa [core, A, B] using
    localIntegral_sub_inner_abs_le_annulus_plus_far_aux n t core A B
      hcore_box hA_sub_box hB_sub_box hshell_union hAB_disj hcore_meas hA_meas hB_meas

/-- Splitting the local box into a small Euclidean ball, the annulus up to a larger
Euclidean radius, and the remaining far shell. -/
private lemma quarticCore_core_integral_gap_abs_le_gaussianF
    (n t : ℕ) (ht : 1 ≤ t)
    {C₄ : ℝ}
    (hC₄_nonneg : 0 ≤ C₄)
    (hgap :
      |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))
          - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (cubicCoreIntegrand n t mu))|
        ≤ ((C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ))
              ^ (1 / (2 : ℝ))
            * (coreMass (dim n) (t : ℝ)) ^ (1 / (2 : ℝ))) :
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (cubicCoreIntegrand n t mu))|
      ≤ Real.sqrt C₄ * ((dim n : ℝ) / (t : ℝ)) * gaussianF (dim n) (t : ℝ) := by
  have ht_pos : (0 : ℝ) < (t : ℝ) := by
    exact_mod_cast (Nat.succ_le_iff.mp ht)
  have hcore_le := coreMass_le_gaussianF n (t : ℝ) ht_pos
  have hcore_nonneg : 0 ≤ coreMass (dim n) (t : ℝ) := coreMass_nonneg (dim n) (t : ℝ)
  have hgauss_nonneg : 0 ≤ gaussianF (dim n) (t : ℝ) := by
    exact Real.rpow_nonneg (by positivity) _
  have hdt_nonneg : 0 ≤ (dim n : ℝ) / (t : ℝ) := by positivity
  calc
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (cubicCoreIntegrand n t mu))|
      ≤ ((C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ))
            ^ (1 / (2 : ℝ))
          * (coreMass (dim n) (t : ℝ)) ^ (1 / (2 : ℝ)) := hgap
    _ ≤ ((C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ))
            ^ (1 / (2 : ℝ))
          * (gaussianF (dim n) (t : ℝ)) ^ (1 / (2 : ℝ)) := by
            gcongr
    _ = Real.sqrt (C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ) := by
          rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow]
          calc
            Real.sqrt ((C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ))
                * Real.sqrt (gaussianF (dim n) (t : ℝ))
              = (Real.sqrt (C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)))
                    * Real.sqrt (gaussianF (dim n) (t : ℝ)))
                  * Real.sqrt (gaussianF (dim n) (t : ℝ)) := by
                    rw [Real.sqrt_mul (by positivity)]
            _ = Real.sqrt (C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)))
                  * (Real.sqrt (gaussianF (dim n) (t : ℝ))
                      * Real.sqrt (gaussianF (dim n) (t : ℝ))) := by
                    ring
            _ = Real.sqrt (C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)))
                  * gaussianF (dim n) (t : ℝ) := by
                    rw [show Real.sqrt (gaussianF (dim n) (t : ℝ))
                            * Real.sqrt (gaussianF (dim n) (t : ℝ))
                          = gaussianF (dim n) (t : ℝ) by
                          nlinarith [Real.sq_sqrt hgauss_nonneg]]
    _ = Real.sqrt C₄ * ((dim n : ℝ) / (t : ℝ)) * gaussianF (dim n) (t : ℝ) := by
          rw [Real.sqrt_mul (by positivity), Real.sqrt_sq_eq_abs, abs_of_nonneg hdt_nonneg]

/-- The corrected-core to quartic-core bridge with the natural `t^{-3/2}` decay kept
explicit. It is retained as internal support for the main bridge chain. -/
private lemma correctedCore_core_integral_gap_abs_le_gaussianF_three_halves
    (n t : ℕ) (ht : 1 ≤ t)
    {C E : ℝ}
    (hC_nonneg : 0 ≤ C)
    (hE_nonneg : 0 ≤ E)
    (hgap :
      |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))
          - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))|
        ≤ ((16 * (t : ℝ) ^ (2 : Nat)) * ((C / (t : ℝ) ^ (5 : Nat)) * coreMass (dim n) (t : ℝ)))
              ^ (1 / (2 : ℝ))
            * (E * gaussianF (dim n) (t : ℝ)) ^ (1 / (2 : ℝ))) :
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))|
      ≤ (Real.sqrt (16 * C) * Real.sqrt E / (t : ℝ) ^ (3 / 2 : ℝ))
          * gaussianF (dim n) (t : ℝ) := by
  have ht_pos : (0 : ℝ) < (t : ℝ) := by
    exact_mod_cast (Nat.succ_le_iff.mp ht)
  have hcore_le := coreMass_le_gaussianF n (t : ℝ) ht_pos
  have hgauss_nonneg : 0 ≤ gaussianF (dim n) (t : ℝ) := by
    exact Real.rpow_nonneg (by positivity) _
  have hfirst_core_nonneg :
      0 ≤ (16 * (t : ℝ) ^ (2 : Nat)) * ((C / (t : ℝ) ^ (5 : Nat)) * coreMass (dim n) (t : ℝ)) := by
    have ht_five_pos : 0 < (t : ℝ) ^ (5 : Nat) := by positivity
    have hC_div_nonneg : 0 ≤ C / (t : ℝ) ^ (5 : Nat) := by
      exact div_nonneg hC_nonneg ht_five_pos.le
    exact mul_nonneg (by positivity) (mul_nonneg hC_div_nonneg (coreMass_nonneg _ _))
  have hleft_factor_nonneg :
      0 ≤ (16 * C) / (t : ℝ) ^ (3 : Nat) := by
    have ht_three_pos : 0 < (t : ℝ) ^ (3 : Nat) := by positivity
    exact div_nonneg (by positivity) ht_three_pos.le
  calc
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))|
      ≤ ((16 * (t : ℝ) ^ (2 : Nat)) * ((C / (t : ℝ) ^ (5 : Nat)) * coreMass (dim n) (t : ℝ)))
            ^ (1 / (2 : ℝ))
          * (E * gaussianF (dim n) (t : ℝ)) ^ (1 / (2 : ℝ)) := hgap
    _ ≤ ((16 * (t : ℝ) ^ (2 : Nat)) * ((C / (t : ℝ) ^ (5 : Nat)) * gaussianF (dim n) (t : ℝ)))
            ^ (1 / (2 : ℝ))
          * (E * gaussianF (dim n) (t : ℝ)) ^ (1 / (2 : ℝ)) := by
            have hbase_le :
                (16 * (t : ℝ) ^ (2 : Nat)) * ((C / (t : ℝ) ^ (5 : Nat)) * coreMass (dim n) (t : ℝ))
                  ≤ (16 * (t : ℝ) ^ (2 : Nat))
                      * ((C / (t : ℝ) ^ (5 : Nat)) * gaussianF (dim n) (t : ℝ)) := by
              gcongr
            have hrpow_le :
                ((16 * (t : ℝ) ^ (2 : Nat)) * ((C / (t : ℝ) ^ (5 : Nat)) * coreMass (dim n) (t : ℝ)))
                    ^ (1 / (2 : ℝ))
                  ≤ ((16 * (t : ℝ) ^ (2 : Nat))
                        * ((C / (t : ℝ) ^ (5 : Nat)) * gaussianF (dim n) (t : ℝ)))
                      ^ (1 / (2 : ℝ)) := by
              exact Real.rpow_le_rpow hfirst_core_nonneg hbase_le
                (by positivity : (0 : ℝ) ≤ 1 / (2 : ℝ))
            exact mul_le_mul_of_nonneg_right hrpow_le (by positivity)
    _ = Real.sqrt ((16 * C) / (t : ℝ) ^ (3 : Nat)) * Real.sqrt E * gaussianF (dim n) (t : ℝ) := by
          rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow]
          have hrew :
              (16 * (t : ℝ) ^ (2 : Nat)) * ((C / (t : ℝ) ^ (5 : Nat)) * gaussianF (dim n) (t : ℝ))
                = ((16 * C) / (t : ℝ) ^ (3 : Nat)) * gaussianF (dim n) (t : ℝ) := by
            field_simp [ht_pos.ne']
          rw [hrew]
          rw [Real.sqrt_mul hleft_factor_nonneg]
          rw [Real.sqrt_mul hE_nonneg]
          calc
            (Real.sqrt ((16 * C) / (t : ℝ) ^ (3 : Nat)) * Real.sqrt (gaussianF (dim n) (t : ℝ)))
                * (Real.sqrt E * Real.sqrt (gaussianF (dim n) (t : ℝ)))
              = Real.sqrt ((16 * C) / (t : ℝ) ^ (3 : Nat)) * Real.sqrt E
                  * (Real.sqrt (gaussianF (dim n) (t : ℝ))
                      * Real.sqrt (gaussianF (dim n) (t : ℝ))) := by
                  ring
            _ = Real.sqrt ((16 * C) / (t : ℝ) ^ (3 : Nat)) * Real.sqrt E
                  * gaussianF (dim n) (t : ℝ) := by
                  rw [show Real.sqrt (gaussianF (dim n) (t : ℝ))
                          * Real.sqrt (gaussianF (dim n) (t : ℝ))
                        = gaussianF (dim n) (t : ℝ) by
                        nlinarith [Real.sq_sqrt hgauss_nonneg]]
    _ = (Real.sqrt (16 * C) * Real.sqrt E / (t : ℝ) ^ (3 / 2 : ℝ))
          * gaussianF (dim n) (t : ℝ) := by
          have hsqrt_t :
              Real.sqrt ((16 * C) / (t : ℝ) ^ (3 : Nat))
                = Real.sqrt (16 * C) / (t : ℝ) ^ (3 / 2 : ℝ) := by
            calc
              Real.sqrt ((16 * C) / (t : ℝ) ^ (3 : Nat))
                = Real.sqrt (16 * C) / Real.sqrt ((t : ℝ) ^ (3 : Nat)) := by
                    simpa [div_eq_mul_inv] using
                      (Real.sqrt_div
                        (show 0 ≤ 16 * C by positivity)
                        (show 0 ≤ (t : ℝ) ^ (3 : Nat) by positivity))
              _ = Real.sqrt (16 * C) / (t : ℝ) ^ (3 / 2 : ℝ) := by
                    congr 1
                    have hpow3 : ((t : ℝ) ^ (3 : Nat)) = ((t : ℝ) ^ (3 : ℝ)) := by
                      simpa using (Real.rpow_natCast (t : ℝ) 3).symm
                    rw [hpow3]
                    rw [Real.sqrt_eq_rpow]
                    have ht_nonneg : 0 ≤ (t : ℝ) := by positivity
                    rw [← Real.rpow_mul ht_nonneg]
                    norm_num
          rw [hsqrt_t]
          ring

/-- The `β = 8` quartic-exponential core bound, packaged for the refined primary
expansion. -/
private lemma quarticCore_exp8_integral_le_gaussianF
    (n : ℕ) (t : ℝ) (ht : 1 ≤ t)
    (hsmall8 : (8 : ℝ) * ((dim n : ℝ) / t) ≤ 1 / 2)
    (hcube : (n : ℝ) * (((dim n : ℝ) / t) ^ (2 : Nat)) ≤ 1) :
    ∫ mu in edgeCoreRegion n t,
        Real.exp
          (-2 * t * Cn3Torus.sqNormEdge n mu
            + 8 * t * quarticCorr n (matrixOfEdge n mu))
      ≤ Real.exp 32 * gaussianF (dim n) t := by
  have ht_pos : 0 < t := by linarith
  have hgauss_nonneg : 0 ≤ gaussianF (dim n) t := by
    exact Real.rpow_nonneg (by positivity) _
  have hquartic8_raw :=
    quartic_core_integral_dim_bound 8 t (by positivity) ht_pos n hsmall8
  have hexp8 :
      Real.exp (((8 : ℝ) ^ (2 : Nat) / 2) * (n : ℝ) * (((dim n : ℝ) / t) ^ (2 : Nat)))
        ≤ Real.exp 32 := by
    apply Real.exp_le_exp.mpr
    nlinarith [hcube]
  have hquartic8 :
      ∫ mu in edgeCoreRegion n t,
          Real.exp (8 * t * quarticCorr n (matrixOfEdge n mu))
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        ≤ Real.exp 32 * gaussianF (dim n) t := by
    calc
      ∫ mu in edgeCoreRegion n t,
          Real.exp (8 * t * quarticCorr n (matrixOfEdge n mu))
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        ≤ Real.exp (((8 : ℝ) ^ (2 : Nat) / 2) * (n : ℝ) * (((dim n : ℝ) / t) ^ (2 : Nat)))
            * gaussianF (dim n) t := hquartic8_raw
      _ ≤ Real.exp 32 * gaussianF (dim n) t := by
            exact mul_le_mul_of_nonneg_right hexp8 hgauss_nonneg
  simpa [Real.exp_add, add_assoc, add_left_comm, add_comm, mul_assoc, mul_left_comm, mul_comm]
    using hquartic8

/-- Public bridge 1: the exact core integral
is close to the corrected core model on the Gaussian scale with `n^6 / t^2` loss. -/
theorem exactCore_correctedCore_gap_abs_le_gaussianF_short :
    ∃ c K : ℝ, 0 < c ∧ 0 < K ∧
      ∀ n : ℕ, 3 ≤ n → ∀ t : ℕ, 1 ≤ t →
        (dim n : ℝ) / (t : ℝ) ≤ c →
        (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat) ≤ c →
        |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (Cn3Torus.psi n mu ^ (4 * t)))
            - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))|
          ≤ (K * ((n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat)))
              * gaussianF (dim n) (t : ℝ) := by
  obtain ⟨c₁, C₁, hc₁_pos, hC₁_pos, hstep1⟩ := repaired_step1_pointwise_uniform
  let c : ℝ := min (Cn3Torus.delta ^ (2 : Nat)) (min c₁ (1 / 8 : ℝ))
  let K : ℝ := C₁ * Real.exp 8
  have hc_pos : 0 < c := by
    unfold c
    refine lt_min ?_ ?_
    · have hδ : 0 < Cn3Torus.delta := Cn3Torus.delta_pos
      positivity
    · refine lt_min hc₁_pos ?_
      norm_num
  have hK_pos : 0 < K := by
    unfold K
    positivity
  refine ⟨c, K, hc_pos, hK_pos, ?_⟩
  intro n hn t ht hdt h6
  have ht_pos : (0 : ℝ) < (t : ℝ) := by
    exact_mod_cast (Nat.succ_le_iff.mp ht)
  have hbox : (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat) := by
    exact le_trans hdt (min_le_left _ _)
  have hdt_c₁ : (dim n : ℝ) / (t : ℝ) ≤ c₁ := by
    exact le_trans hdt (le_trans (min_le_right _ _) (min_le_left _ _))
  have hc_le_eighth : c ≤ (1 / 8 : ℝ) := by
    unfold c
    exact le_trans (min_le_right _ _) (min_le_right _ _)
  have hsmall4 : (4 : ℝ) * ((dim n : ℝ) / (t : ℝ)) ≤ 1 / 2 := by
    have : (dim n : ℝ) / (t : ℝ) ≤ (1 / 8 : ℝ) := le_trans hdt hc_le_eighth
    nlinarith
  have hdim_le_nsq : (dim n : ℝ) ≤ (n : ℝ) ^ (2 : Nat) := dim_le_sq n
  have hdim_cube_le :
      (dim n : ℝ) ^ (3 : Nat) ≤ (n : ℝ) ^ (6 : Nat) := by
    have hdim_nonneg : 0 ≤ (dim n : ℝ) := by positivity
    have hpow := pow_le_pow_left₀ hdim_nonneg hdim_le_nsq 3
    calc
      (dim n : ℝ) ^ (3 : Nat) ≤ ((n : ℝ) ^ (2 : Nat)) ^ (3 : Nat) := hpow
      _ = (n : ℝ) ^ (6 : Nat) := by ring
  have hd3_c₁ : ((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat) ≤ c₁ := by
    calc
      ((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat)
        ≤ (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat) := by
            exact div_le_div_of_nonneg_right hdim_cube_le (by positivity)
      _ ≤ c := h6
      _ ≤ c₁ := by
            exact le_trans (min_le_right _ _) (min_le_left _ _)
  have hd3_c : ((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat) ≤ c := by
    calc
      ((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat)
        ≤ (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat) := by
            exact div_le_div_of_nonneg_right hdim_cube_le (by positivity)
      _ ≤ c := h6
  have hcube_one :
      (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ 1 := by
    have hhalf : (n : ℝ) / 2 ≤ (dim n : ℝ) := half_n_le_dim n hn
    have hn_le_two_dim : (n : ℝ) ≤ 2 * (dim n : ℝ) := by
      nlinarith
    have hmain :
        (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))
          ≤ 2 * (((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat)) := by
      have ht_sq_pos : 0 < (t : ℝ) ^ (2 : Nat) := by positivity
      calc
        (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))
          = ((n : ℝ) * (dim n : ℝ) ^ (2 : Nat)) / (t : ℝ) ^ (2 : Nat) := by
              field_simp [ht_pos.ne']
        _ ≤ ((2 * (dim n : ℝ)) * (dim n : ℝ) ^ (2 : Nat)) / (t : ℝ) ^ (2 : Nat) := by
              exact div_le_div_of_nonneg_right
                (mul_le_mul_of_nonneg_right hn_le_two_dim (by positivity)) ht_sq_pos.le
        _ = 2 * (((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat)) := by
              field_simp [ht_pos.ne']
    have hc_le_half : c ≤ (1 / 2 : ℝ) := by
      calc
        c ≤ (1 / 8 : ℝ) := hc_le_eighth
        _ ≤ (1 / 2 : ℝ) := by norm_num
    calc
      (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))
        ≤ 2 * (((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat)) := hmain
      _ ≤ 2 * c := by
            exact mul_le_mul_of_nonneg_left hd3_c (by norm_num)
      _ ≤ 1 := by
            nlinarith
  have hquartic4_raw :=
    quartic_core_integral_dim_bound 4 (t : ℝ) (by positivity) ht_pos n hsmall4
  have hquartic4_exp_sum :
      ∫ mu in edgeCoreRegion n (t : ℝ),
          Real.exp
            (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
              + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
        ≤ Real.exp 8 * gaussianF (dim n) (t : ℝ) := by
    have hgauss_nonneg : 0 ≤ gaussianF (dim n) (t : ℝ) := by
      exact Real.rpow_nonneg (by positivity) _
    have hquartic4_exp :
        ∫ mu in edgeCoreRegion n (t : ℝ),
            Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
              * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
          ≤ Real.exp 8 * gaussianF (dim n) (t : ℝ) := by
      have hexp4 :
          Real.exp (((4 : ℝ) ^ (2 : Nat) / 2) * (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)))
            ≤ Real.exp 8 := by
        apply Real.exp_le_exp.mpr
        nlinarith [hcube_one]
      calc
        ∫ mu in edgeCoreRegion n (t : ℝ),
            Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
              * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
          ≤ Real.exp (((4 : ℝ) ^ (2 : Nat) / 2) * (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)))
              * gaussianF (dim n) (t : ℝ) := hquartic4_raw
        _ ≤ Real.exp 8 * gaussianF (dim n) (t : ℝ) := by
              exact mul_le_mul_of_nonneg_right hexp4 hgauss_nonneg
    simpa [Real.exp_add, add_assoc, add_left_comm, add_comm, mul_assoc, mul_left_comm, mul_comm]
      using hquartic4_exp
  have hraw :
      |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (Cn3Torus.psi n mu ^ (4 * t)))
          - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))|
        ≤ (K * (((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat)))
            * gaussianF (dim n) (t : ℝ) := by
    have hmain :
        |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (Cn3Torus.psi n mu ^ (4 * t)))
            - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))|
          ≤ (C₁ * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
              * (Real.exp 8 * gaussianF (dim n) (t : ℝ)) := by
      simpa using
        repaired_step1_core_integral_gap_le n t ht hbox hC₁_pos.le
          (fun mu hmu hdt' hd3' => hstep1 n t ht mu hmu hdt' hd3')
          hdt_c₁ hd3_c₁ hquartic4_exp_sum
    calc
      |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (Cn3Torus.psi n mu ^ (4 * t)))
          - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))|
        ≤ (C₁ * (dim n : ℝ) ^ (3 : Nat) / (t : ℝ) ^ (2 : Nat))
            * (Real.exp 8 * gaussianF (dim n) (t : ℝ)) := hmain
      _ = (K * (((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat)))
            * gaussianF (dim n) (t : ℝ) := by
              unfold K
              ring
  have hfinal :
      |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (Cn3Torus.psi n mu ^ (4 * t)))
          - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))|
        ≤ (K * ((n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat)))
            * gaussianF (dim n) (t : ℝ) := by
    calc
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (Cn3Torus.psi n mu ^ (4 * t)))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))|
      ≤ (K * (((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat)))
          * gaussianF (dim n) (t : ℝ) := hraw
    _ ≤ (K * ((n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ) := by
          have hfrac :
              ((dim n : ℝ) ^ (3 : Nat)) / (t : ℝ) ^ (2 : Nat)
                ≤ (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat) := by
            exact div_le_div_of_nonneg_right hdim_cube_le (by positivity)
          have hgauss_nonneg : 0 ≤ gaussianF (dim n) (t : ℝ) := by
            exact Real.rpow_nonneg (by positivity) _
          exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hfrac hK_pos.le) hgauss_nonneg
  simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using hfinal

/-- Public bridge 2: the corrected-core to
quartic-core bridge with the natural `t^{-3/2}` decay. -/
theorem correctedCore_quarticCore_gap_abs_le_gaussianF_short :
    ∃ c K : ℝ, 0 < c ∧ 0 < K ∧
      ∀ n : ℕ, 2 ≤ n → ∀ t : ℕ, 1 ≤ t →
        (dim n : ℝ) / (t : ℝ) ≤ c →
        (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ c →
        |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))
            - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))|
          ≤ (K * ((n : ℝ) ^ (5 / 2 : ℝ) / (t : ℝ) ^ (3 / 2 : ℝ)))
              * gaussianF (dim n) (t : ℝ) := by
  obtain ⟨Cq, hCq_pos, hquintic⟩ := quinticP5_l2_coreMass_bound_uniform
  let c : ℝ := min (Cn3Torus.delta ^ (2 : Nat)) (1 / 16 : ℝ)
  let K : ℝ := Real.sqrt (16 * Cq) * Real.sqrt (Real.exp 32)
  have hc_pos : 0 < c := by
    unfold c
    refine lt_min ?_ ?_
    · have hδ : 0 < Cn3Torus.delta := Cn3Torus.delta_pos
      positivity
    · norm_num
  have hK_pos : 0 < K := by
    unfold K
    positivity
  refine ⟨c, K, hc_pos, hK_pos, ?_⟩
  intro n hn t ht hdt hcube
  have hdim : 1 ≤ dim n := one_le_dim_of_two_le n hn
  have hbox : (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat) := by
    exact le_trans hdt (min_le_left _ _)
  have hc_le_sixteenth : c ≤ (1 / 16 : ℝ) := by
    unfold c
    exact min_le_right _ _
  have hsmall8 : (8 : ℝ) * ((dim n : ℝ) / (t : ℝ)) ≤ 1 / 2 := by
    have : (dim n : ℝ) / (t : ℝ) ≤ (1 / 16 : ℝ) := le_trans hdt hc_le_sixteenth
    nlinarith
  have hcube_one :
      (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ 1 := by
    calc
      (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ c := hcube
      _ ≤ (1 / 16 : ℝ) := hc_le_sixteenth
      _ ≤ 1 := by norm_num
  have hquintic_bound :
      ∫ mu in edgeCoreRegion n (t : ℝ),
          (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
            * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
        ≤ ((Cq * (n : ℝ) ^ (5 : Nat)) / (t : ℝ) ^ (5 : Nat)) * coreMass (dim n) (t : ℝ) := by
    have ht_real : (1 : ℝ) ≤ (t : ℝ) := by exact_mod_cast ht
    simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using
      (hquintic n hdim (t : ℝ) ht_real)
  have hraw :
      |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))
          - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))|
        ≤ (K * (n : ℝ) ^ (5 / 2 : ℝ) / (t : ℝ) ^ (3 / 2 : ℝ))
            * gaussianF (dim n) (t : ℝ) := by
    have hmain :
        |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))
            - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))|
          ≤ (Real.sqrt (16 * (Cq * (n : ℝ) ^ (5 : Nat))) * Real.sqrt (Real.exp 32)
                / (t : ℝ) ^ (3 / 2 : ℝ)) * gaussianF (dim n) (t : ℝ) := by
      have hA_nonneg :
          0 ≤ Cq * (n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (5 : Nat) * coreMass (dim n) (t : ℝ) := by
        have hcore_nonneg : 0 ≤ coreMass (dim n) (t : ℝ) := coreMass_nonneg _ _
        positivity [hCq_pos, hcore_nonneg]
      exact correctedCore_core_integral_gap_abs_le_gaussianF_three_halves n t ht
        (by positivity [hCq_pos]) (by positivity)
        (correctedCore_core_integral_gap_abs_le n t hbox
          hA_nonneg
          hquintic_bound
          (by
            simpa [Real.exp_add, add_assoc, add_left_comm, add_comm, mul_assoc, mul_left_comm, mul_comm]
              using quarticCore_exp8_integral_le_gaussianF n (t : ℝ) (by exact_mod_cast ht) hsmall8 hcube_one))
    have hsqrt_n :
        Real.sqrt ((n : ℝ) ^ (5 : Nat)) = (n : ℝ) ^ (5 / 2 : ℝ) := by
      have hpow5 : ((n : ℝ) ^ (5 : Nat)) = ((n : ℝ) ^ (5 : ℝ)) := by
        simpa using (Real.rpow_natCast (n : ℝ) 5).symm
      rw [hpow5, Real.sqrt_eq_rpow]
      have hn_nonneg : 0 ≤ (n : ℝ) := by positivity
      rw [← Real.rpow_mul hn_nonneg]
      norm_num
    calc
      |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (correctedCoreIntegrand n t mu))
          - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))|
        ≤ (Real.sqrt (16 * (Cq * (n : ℝ) ^ (5 : Nat))) * Real.sqrt (Real.exp 32)
              / (t : ℝ) ^ (3 / 2 : ℝ)) * gaussianF (dim n) (t : ℝ) := hmain
      _ = (K * (n : ℝ) ^ (5 / 2 : ℝ) / (t : ℝ) ^ (3 / 2 : ℝ))
            * gaussianF (dim n) (t : ℝ) := by
            have hsqrt_split :
                Real.sqrt (16 * (Cq * (n : ℝ) ^ (5 : Nat)))
                  = Real.sqrt (16 * Cq) * Real.sqrt ((n : ℝ) ^ (5 : Nat)) := by
              rw [show 16 * (Cq * (n : ℝ) ^ (5 : Nat)) = (16 * Cq) * (n : ℝ) ^ (5 : Nat) by ring]
              rw [Real.sqrt_mul (by positivity [hCq_pos])]
            rw [hsqrt_split, hsqrt_n]
            unfold K
            ring
  simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using hraw

/-- Public bridge 3: stripping the quartic
correction costs only `n^2 / t` on the Gaussian scale. -/
theorem quarticCore_cubicCore_gap_abs_le_gaussianF_short :
    ∃ c K : ℝ, 0 < c ∧ 0 < K ∧
      ∀ n : ℕ, ∀ t : ℕ, 1 ≤ t →
        (dim n : ℝ) / (t : ℝ) ≤ c →
        (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ c →
        |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))
            - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (cubicCoreIntegrand n t mu))|
          ≤ (K * ((n : ℝ) ^ (2 : Nat) / (t : ℝ))) * gaussianF (dim n) (t : ℝ) := by
  obtain ⟨c₄, C₄, hc₄_pos, hC₄_pos, hquarticGap⟩ := quarticCoreSubOne_l2_gaussian_bound
  let c : ℝ := min (Cn3Torus.delta ^ (2 : Nat)) c₄
  let K : ℝ := Real.sqrt C₄
  have hc_pos : 0 < c := by
    unfold c
    refine lt_min ?_ hc₄_pos
    have hδ : 0 < Cn3Torus.delta := Cn3Torus.delta_pos
    positivity
  have hK_pos : 0 < K := by
    unfold K
    positivity
  refine ⟨c, K, hc_pos, hK_pos, ?_⟩
  intro n t ht hdt hcube
  have hbox : (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat) := by
    exact le_trans hdt (min_le_left _ _)
  have hdt_c₄ : (dim n : ℝ) / (t : ℝ) ≤ c₄ := by
    exact le_trans hdt (min_le_right _ _)
  have hcube_c₄ : (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ c₄ := by
    exact le_trans hcube (min_le_right _ _)
  have hdim_le_nsq : (dim n : ℝ) ≤ (n : ℝ) ^ (2 : Nat) := dim_le_sq n
  have hraw :
      |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))
          - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (cubicCoreIntegrand n t mu))|
        ≤ K * ((dim n : ℝ) / (t : ℝ)) * gaussianF (dim n) (t : ℝ) := by
    simpa [K] using
      quarticCore_core_integral_gap_abs_le_gaussianF n t ht hC₄_pos.le
        (quarticCore_core_integral_gap_abs_le n t hbox
          (hquarticGap n (t : ℝ) (by exact_mod_cast ht)) hdt_c₄ hcube_c₄)
  have hfinal :
      |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))
          - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (cubicCoreIntegrand n t mu))|
        ≤ (K * (n : ℝ) ^ (2 : Nat) / (t : ℝ)) * gaussianF (dim n) (t : ℝ) := by
    calc
    |(∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (quarticCoreIntegrand n t mu))
        - (∫ mu in edgeCoreRegion n (t : ℝ), Complex.re (cubicCoreIntegrand n t mu))|
      ≤ K * ((dim n : ℝ) / (t : ℝ)) * gaussianF (dim n) (t : ℝ) := hraw
    _ ≤ (K * (n : ℝ) ^ (2 : Nat) / (t : ℝ)) * gaussianF (dim n) (t : ℝ) := by
          have hfrac :
              (dim n : ℝ) / (t : ℝ) ≤ (n : ℝ) ^ (2 : Nat) / (t : ℝ) := by
            exact div_le_div_of_nonneg_right (dim_le_sq n) (by positivity)
          have hcoef :
              K * ((dim n : ℝ) / (t : ℝ)) ≤ K * (n : ℝ) ^ (2 : Nat) / (t : ℝ) := by
            simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using
              (mul_le_mul_of_nonneg_left hfrac hK_pos.le)
          have hgauss_nonneg : 0 ≤ gaussianF (dim n) (t : ℝ) := by
            exact Real.rpow_nonneg (by positivity) _
          exact mul_le_mul_of_nonneg_right hcoef hgauss_nonneg
  simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using hfinal

