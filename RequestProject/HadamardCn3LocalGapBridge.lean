private lemma sum_edgeQuintuples_gate_eq_supportThree_add_supportFour_add_supportFive
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    ∑ p : EdgeQuintuple n, quinticMomentTupleMonomial p mu * quinticMomentTupleGate p
      = Finset.sum (quinticGateSupportThreeTuples n) (fun p => quinticMomentTupleMonomial p mu)
        + Finset.sum (quinticGateSupportFourTuples n) (fun p => quinticMomentTupleMonomial p mu)
        + Finset.sum (quinticGateSupportFiveTuples n) (fun p => quinticMomentTupleMonomial p mu) := by
  let G : Finset (EdgeQuintuple n) :=
    (Finset.univ : Finset (EdgeQuintuple n)).filter (fun p => quinticMomentTupleGate p = 1)
  let S3 := quinticGateSupportThreeTuples n
  let S4 := quinticGateSupportFourTuples n
  let S5 := quinticGateSupportFiveTuples n
  have hleft :
      ∑ p : EdgeQuintuple n, quinticMomentTupleMonomial p mu * quinticMomentTupleGate p
        = Finset.sum G (fun p => quinticMomentTupleMonomial p mu) := by
    calc
      ∑ p : EdgeQuintuple n, quinticMomentTupleMonomial p mu * quinticMomentTupleGate p
        = ∑ p : EdgeQuintuple n,
            if quinticMomentTupleGate p = 1 then quinticMomentTupleMonomial p mu else 0 := by
              refine Finset.sum_congr rfl ?_
              intro p hp
              rcases quinticMomentTupleGate_zero_or_one p with h0 | h1
              · simp [h0]
              · simp [h1]
      _ = Finset.sum G (fun p => quinticMomentTupleMonomial p mu) := by
            symm
            simpa [G] using
              (Finset.sum_filter (s := (Finset.univ : Finset (EdgeQuintuple n)))
                (p := fun p => quinticMomentTupleGate p = 1)
                (f := fun p => quinticMomentTupleMonomial p mu))
  have hG :
      G = (S3 ∪ S4) ∪ S5 := by
    ext p
    constructor
    · intro hp
      have hgate : quinticMomentTupleGate p = 1 := (Finset.mem_filter.mp hp).2
      have hpos : 0 < (quinticMomentTupleSupport p).card := by
        exact Finset.card_pos.mpr ⟨p 0, quinticMomentTuple_mem_support p 0⟩
      have hle : (quinticMomentTupleSupport p).card ≤ 5 := quinticMomentTupleSupport_card_le_five p
      have hne1 : (quinticMomentTupleSupport p).card ≠ 1 := by
        intro h1
        exact (quintic_gate_support_one_false hgate h1).elim
      have hne2 : (quinticMomentTupleSupport p).card ≠ 2 := by
        intro h2
        exact (quintic_gate_support_two_false hgate h2).elim
      have hcases :
          (quinticMomentTupleSupport p).card = 3 ∨
            (quinticMomentTupleSupport p).card = 4 ∨
            (quinticMomentTupleSupport p).card = 5 := by
        omega
      rcases hcases with h3 | h4 | h5
      · show p ∈ (S3 ∪ S4) ∪ S5
        exact Finset.mem_union.mpr <| Or.inl <| Finset.mem_union.mpr <| Or.inl <|
          (mem_quinticGateSupportThreeTuples_iff p).2 ⟨hgate, h3⟩
      · show p ∈ (S3 ∪ S4) ∪ S5
        exact Finset.mem_union.mpr <| Or.inl <| Finset.mem_union.mpr <| Or.inr <|
          (mem_quinticGateSupportFourTuples_iff p).2 ⟨hgate, h4⟩
      · show p ∈ (S3 ∪ S4) ∪ S5
        exact Finset.mem_union.mpr <| Or.inr <|
          (mem_quinticGateSupportFiveTuples_iff p).2 ⟨hgate, h5⟩
    · intro hp
      rw [Finset.mem_union] at hp
      rcases hp with hp34 | hp5
      · rw [Finset.mem_union] at hp34
        rcases hp34 with hp3 | hp4
        · exact Finset.mem_filter.mpr ⟨by simp, (mem_quinticGateSupportThreeTuples_iff p).1 hp3 |>.1⟩
        · exact Finset.mem_filter.mpr ⟨by simp, (mem_quinticGateSupportFourTuples_iff p).1 hp4 |>.1⟩
      · exact Finset.mem_filter.mpr ⟨by simp, (mem_quinticGateSupportFiveTuples_iff p).1 hp5 |>.1⟩
  have h34 : Disjoint S3 S4 := by
    refine Finset.disjoint_left.mpr ?_
    intro p hp3 hp4
    rcases (mem_quinticGateSupportThreeTuples_iff p).1 hp3 with ⟨-, h3⟩
    rcases (mem_quinticGateSupportFourTuples_iff p).1 hp4 with ⟨-, h4⟩
    omega
  have h35 : Disjoint S3 S5 := by
    refine Finset.disjoint_left.mpr ?_
    intro p hp3 hp5
    rcases (mem_quinticGateSupportThreeTuples_iff p).1 hp3 with ⟨-, h3⟩
    rcases (mem_quinticGateSupportFiveTuples_iff p).1 hp5 with ⟨-, h5⟩
    omega
  have h45 : Disjoint S4 S5 := by
    refine Finset.disjoint_left.mpr ?_
    intro p hp4 hp5
    rcases (mem_quinticGateSupportFourTuples_iff p).1 hp4 with ⟨-, h4⟩
    rcases (mem_quinticGateSupportFiveTuples_iff p).1 hp5 with ⟨-, h5⟩
    omega
  have h345 : Disjoint (S3 ∪ S4) S5 := by
    refine Finset.disjoint_left.mpr ?_
    intro p hp34 hp5
    rw [Finset.mem_union] at hp34
    rcases hp34 with hp3 | hp4
    · exact (Finset.disjoint_left.mp h35) hp3 hp5
    · exact (Finset.disjoint_left.mp h45) hp4 hp5
  calc
    ∑ p : EdgeQuintuple n, quinticMomentTupleMonomial p mu * quinticMomentTupleGate p
      = Finset.sum G (fun p => quinticMomentTupleMonomial p mu) := hleft
    _ = Finset.sum ((S3 ∪ S4) ∪ S5) (fun p => quinticMomentTupleMonomial p mu) := by
          rw [hG]
    _ = Finset.sum (S3 ∪ S4) (fun p => quinticMomentTupleMonomial p mu)
          + Finset.sum S5 (fun p => quinticMomentTupleMonomial p mu) := by
            rw [Finset.sum_union h345]
    _ = (Finset.sum S3 (fun p => quinticMomentTupleMonomial p mu)
          + Finset.sum S4 (fun p => quinticMomentTupleMonomial p mu))
          + Finset.sum S5 (fun p => quinticMomentTupleMonomial p mu) := by
            rw [Finset.sum_union h34]
    _ = Finset.sum (quinticGateSupportThreeTuples n) (fun p => quinticMomentTupleMonomial p mu)
          + Finset.sum (quinticGateSupportFourTuples n) (fun p => quinticMomentTupleMonomial p mu)
          + Finset.sum (quinticGateSupportFiveTuples n) (fun p => quinticMomentTupleMonomial p mu) := by
            simp [S3, S4, S5, add_assoc]

private lemma quinticP5_matrixOfEdge_eq_supportFive_minus_triangleRepeat
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    quinticP5 n (matrixOfEdge n mu)
      = (1 / 120 : ℝ)
          * Finset.sum (quinticGateSupportFiveTuples n)
              (fun p => quinticMomentTupleMonomial p mu)
        - (1 / 3 : ℝ)
            * Finset.sum (triangleTriples n)
                (fun τ => Finset.sum Finset.univ
                  (fun s : TriangleEdgeShape => quinticTriangleRepeatMonomialOn mu τ s)) := by
  let R : ℝ :=
    Finset.sum (triangleTriples n)
      (fun τ => Finset.sum Finset.univ
        (fun s : TriangleEdgeShape => quinticTriangleRepeatMonomialOn mu τ s))
  let E : ℝ := Finset.sum (triangleTriples n) (fun τ => quinticExternalEdgeTriangleSumOn mu τ)
  let F : ℝ :=
    Finset.sum (quinticGateSupportFiveTuples n) (fun p => quinticMomentTupleMonomial p mu)
  calc
    quinticP5 n (matrixOfEdge n mu)
      = (1 / 120 : ℝ)
            * (Finset.sum (quinticGateSupportThreeTuples n)
                (fun p => quinticMomentTupleMonomial p mu)
              + Finset.sum (quinticGateSupportFourTuples n)
                  (fun p => quinticMomentTupleMonomial p mu)
              + Finset.sum (quinticGateSupportFiveTuples n)
                  (fun p => quinticMomentTupleMonomial p mu))
          - (1 / 2 : ℝ)
              * (Finset.sum (triangleTriples n)
                  (fun τ => Finset.sum Finset.univ
                    (fun s : TriangleEdgeShape => quinticTriangleRepeatMonomialOn mu τ s))
                + Finset.sum (triangleTriples n)
                    (fun τ => quinticExternalEdgeTriangleSumOn mu τ)) := by
            have hbridge :
                Finset.sum (Finset.univ : Finset (Cn3Torus.Edge n))
                    (fun e => Finset.sum (triangleTriples n) (fun τ => quinticSTriangleMonomialOn mu e τ))
                  =
                    Finset.sum (triangleTriples n)
                      (fun τ => Finset.sum Finset.univ
                        (fun s : TriangleEdgeShape => quinticTriangleRepeatMonomialOn mu τ s))
                    + Finset.sum (triangleTriples n)
                      (fun τ => quinticExternalEdgeTriangleSumOn mu τ) := by
              calc
                Finset.sum (Finset.univ : Finset (Cn3Torus.Edge n))
                    (fun e => Finset.sum (triangleTriples n) (fun τ => quinticSTriangleMonomialOn mu e τ))
                  = Cn3Torus.sqNormEdge n mu * cubicT n (matrixOfEdge n mu) := by
                      symm
                      exact sqNormEdge_mul_cubicT_eq_sum_edge_triangleTriples n mu
                _ = Finset.sum (triangleTriples n)
                      (fun τ => Finset.sum Finset.univ
                        (fun s : TriangleEdgeShape => quinticTriangleRepeatMonomialOn mu τ s))
                    + Finset.sum (triangleTriples n)
                        (fun τ => quinticExternalEdgeTriangleSumOn mu τ) := by
                      simpa using sqNormEdge_mul_cubicT_eq_sum_repeat_add_external n mu
            rw [quinticP5_matrixOfEdge_eq_explicit_difference,
              sum_edgeQuintuples_gate_eq_supportThree_add_supportFour_add_supportFive,
              hbridge]
    _ = (1 / 120 : ℝ) * (20 * R + 60 * E + F) - (1 / 2 : ℝ) * (R + E) := by
          rw [quintic_supportThree_sum_eq_triangleRepeat_sum, quintic_supportFour_sum_eq_edgeTriangle_sum]
    _ = (1 / 120 : ℝ) * F - (1 / 3 : ℝ) * R := by
          ring

private theorem quinticP5_l2_coreMass_bound_uniform :
  ∃ C : ℝ, 0 < C ∧
    ∀ n : ℕ, 1 ≤ dim n → ∀ t : ℝ, 1 ≤ t →
      ∫ mu in edgeCoreRegion n t,
          (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        ≤ (C * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)) * coreMass (dim n) t := by
  obtain ⟨Ccore, hCcore_pos, hcore⟩ := gaussianF_le_const_mul_coreMass
  let C5 : ℝ :=
    (2 * (1 / 120 : ℝ) ^ (2 : Nat))
      * ((Fintype.card (EdgeQuintuple 5) : ℝ) ^ (2 : Nat))
      * (gaussianEvenMomentEnvelope 5 ^ 5)
  let C3 : ℝ :=
    (2 * (1 / 3 : ℝ) ^ (2 : Nat)) * 9 * (gaussianEvenMomentEnvelope 5 ^ 5)
  refine ⟨Ccore * (C5 + C3), ?_, ?_⟩
  · have henv_pos : 0 < gaussianEvenMomentEnvelope 5 ^ 5 := by
      have henv_one : 1 ≤ gaussianEvenMomentEnvelope 5 := gaussianEvenMomentEnvelope_one_le 5
      positivity
    have hC5_nonneg : 0 ≤ C5 := by
      dsimp [C5]
      positivity
    have hC3_pos : 0 < C3 := by
      dsimp [C3]
      positivity
    have hsum_pos : 0 < C5 + C3 := by linarith
    positivity
  · intro n hd t ht
    classical
    let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n t
    let Ffun : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
      Finset.sum (quinticGateSupportFiveTuples n) (fun p => quinticMomentTupleMonomial p mu)
    let Rfun : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
      Finset.sum (triangleTriples n)
        (fun τ => Finset.sum Finset.univ
          (fun s : TriangleEdgeShape => quinticTriangleRepeatMonomialOn mu τ s))
    let w : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
      Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
    let f5 : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu => (Ffun mu) ^ (2 : Nat) * w mu
    let f3 : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu => (Rfun mu) ^ (2 : Nat) * w mu
    let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
      (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat) * w mu
    let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
      (2 * (1 / 120 : ℝ) ^ (2 : Nat)) * f5 mu
        + (2 * (1 / 3 : ℝ) ^ (2 : Nat)) * f3 mu
    have ht_pos : 0 < t := by linarith
    have hF_int : MeasureTheory.Integrable f5 := by
      simpa [f5, Ffun, w] using quintic_supportFive_full_gaussian_integrable n t ht_pos
    have hR_int : MeasureTheory.Integrable f3 := by
      simpa [f3, Rfun, w] using quintic_supportThree_repeat_full_gaussian_integrable n t ht_pos
    have hg_int : MeasureTheory.Integrable g := by
      simpa [g, f5, f3, add_comm, add_left_comm, add_assoc, mul_assoc, mul_left_comm, mul_comm]
        using ((hF_int.const_mul (2 * (1 / 120 : ℝ) ^ (2 : Nat))).add
          (hR_int.const_mul (2 * (1 / 3 : ℝ) ^ (2 : Nat))))
    have hf_sm :
        MeasureTheory.AEStronglyMeasurable f (MeasureTheory.volume.restrict core) := by
      have hw_cont : Continuous w := by
        have harg :
            Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
              (-2 * t : ℝ) * Cn3Torus.sqNormEdge n mu) :=
          continuous_const.mul (Cn3Torus.continuous_sqNormEdge n)
        simpa [w, mul_assoc] using Real.continuous_exp.comp harg
      have hf_cont :
          Continuous (fun mu : Cn3Torus.Edge n → ℝ => (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)) := by
        exact ((continuous_quinticP5 n).comp (continuous_matrixOfEdge n)).pow 2
      simpa [f] using (hf_cont.mul hw_cont).aestronglyMeasurable
    have hg_int_core : MeasureTheory.Integrable g (MeasureTheory.volume.restrict core) := by
      simpa [core, MeasureTheory.IntegrableOn] using hg_int.integrableOn
    have hbound_ae_norm :
        (fun mu => ‖f mu‖) ≤ᵐ[MeasureTheory.volume.restrict core] g := by
      exact Filter.Eventually.of_forall (fun mu => by
        have hf_nonneg : 0 ≤ f mu := by
          dsimp [f, w]
          positivity
        have hw_nonneg : 0 ≤ w mu := by
          dsimp [w]
          positivity
        have hpoint :
            f mu ≤ g mu := by
          have hmain := quinticP5_matrixOfEdge_eq_supportFive_minus_triangleRepeat n mu
          dsimp [f, g, f5, f3, Ffun, Rfun, w] at *
          rw [hmain]
          nlinarith [sq_nonneg
            (((1 / 120 : ℝ)
              * ∑ p ∈ quinticGateSupportFiveTuples n, quinticMomentTupleMonomial p mu)
            + ((1 / 3 : ℝ)
              * ∑ τ ∈ triangleTriples n,
                  ∑ s : TriangleEdgeShape, quinticTriangleRepeatMonomialOn mu τ s)), hw_nonneg]
        simpa [Real.norm_eq_abs, abs_of_nonneg hf_nonneg] using hpoint)
    have hf_int_core :
        MeasureTheory.Integrable f (MeasureTheory.volume.restrict core) :=
      MeasureTheory.Integrable.mono' hg_int_core hf_sm hbound_ae_norm
    have hbound_ae :
        f ≤ᵐ[MeasureTheory.volume.restrict core] g := by
      exact Filter.Eventually.of_forall (fun mu => by
        have hw_nonneg : 0 ≤ w mu := by
          dsimp [w]
          positivity
        have hmain := quinticP5_matrixOfEdge_eq_supportFive_minus_triangleRepeat n mu
        dsimp [f, g, f5, f3, Ffun, Rfun, w] at *
        rw [hmain]
        nlinarith [sq_nonneg
          (((1 / 120 : ℝ)
            * ∑ p ∈ quinticGateSupportFiveTuples n, quinticMomentTupleMonomial p mu)
          + ((1 / 3 : ℝ)
            * ∑ τ ∈ triangleTriples n,
                ∑ s : TriangleEdgeShape, quinticTriangleRepeatMonomialOn mu τ s)), hw_nonneg])
    have hF_nonneg : 0 ≤ᵐ[MeasureTheory.volume] f5 := by
      exact Filter.Eventually.of_forall (fun mu => by
        dsimp [f5, w]
        positivity)
    have hR_nonneg : 0 ≤ᵐ[MeasureTheory.volume] f3 := by
      exact Filter.Eventually.of_forall (fun mu => by
        dsimp [f3, w]
        positivity)
    have hF_int_core : MeasureTheory.Integrable f5 (MeasureTheory.volume.restrict core) := by
      simpa [core, MeasureTheory.IntegrableOn] using hF_int.integrableOn
    have hR_int_core : MeasureTheory.Integrable f3 (MeasureTheory.volume.restrict core) := by
      simpa [core, MeasureTheory.IntegrableOn] using hR_int.integrableOn
    have hF_core_le :
        ∫ mu in core, f5 mu ≤ ∫ mu : Cn3Torus.Edge n → ℝ, f5 mu := by
      simpa [core] using MeasureTheory.setIntegral_le_integral hF_int hF_nonneg
    have hR_core_le :
        ∫ mu in core, f3 mu ≤ ∫ mu : Cn3Torus.Edge n → ℝ, f3 mu := by
      simpa [core] using MeasureTheory.setIntegral_le_integral hR_int hR_nonneg
    have hF_bound :=
      quintic_supportFive_full_gaussian_bound_uniform n t ht
    have hR_bound :=
      quintic_supportThree_repeat_full_gaussian_bound_uniform n t ht
    have hn : 1 ≤ n := by
      cases n with
      | zero =>
          simp [dim] at hd
      | succ n =>
          exact Nat.succ_le_succ (Nat.zero_le n)
    have hnR : 1 ≤ (n : ℝ) := by exact_mod_cast hn
    have hn35 : (n : ℝ) ^ (3 : Nat) ≤ (n : ℝ) ^ (5 : Nat) := by
      have hn2 : 1 ≤ (n : ℝ) ^ (2 : Nat) := by
        nlinarith [sq_nonneg ((n : ℝ) - 1)]
      calc
        (n : ℝ) ^ (3 : Nat) = (n : ℝ) ^ (3 : Nat) * 1 := by ring
        _ ≤ (n : ℝ) ^ (3 : Nat) * (n : ℝ) ^ (2 : Nat) := by
          exact mul_le_mul_of_nonneg_left hn2 (by positivity)
        _ = (n : ℝ) ^ (5 : Nat) := by ring
    calc
      ∫ mu in edgeCoreRegion n t,
          (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = ∫ mu, f mu ∂(MeasureTheory.volume.restrict core) := by
            rfl
      _ ≤ ∫ mu, g mu ∂(MeasureTheory.volume.restrict core) := by
            exact MeasureTheory.integral_mono_ae hf_int_core hg_int_core hbound_ae
      _ = (2 * (1 / 120 : ℝ) ^ (2 : Nat)) * (∫ mu in core, f5 mu)
            + (2 * (1 / 3 : ℝ) ^ (2 : Nat)) * (∫ mu in core, f3 mu) := by
              rw [show (∫ mu, g mu ∂(MeasureTheory.volume.restrict core))
                  = ∫ mu in core, g mu by rfl]
              rw [MeasureTheory.integral_add (hF_int_core.const_mul _) (hR_int_core.const_mul _)]
              rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
      _ ≤ (2 * (1 / 120 : ℝ) ^ (2 : Nat)) * (∫ mu : Cn3Torus.Edge n → ℝ, f5 mu)
            + (2 * (1 / 3 : ℝ) ^ (2 : Nat)) * (∫ mu : Cn3Torus.Edge n → ℝ, f3 mu) := by
              gcongr
      _ ≤ (2 * (1 / 120 : ℝ) ^ (2 : Nat))
            * ((((Fintype.card (EdgeQuintuple 5) : ℝ) ^ (2 : Nat)) * (n : ℝ) ^ (5 : Nat))
                * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat))
                * gaussianF (dim n) t)
          + (2 * (1 / 3 : ℝ) ^ (2 : Nat))
            * (((9 : ℝ) * (n : ℝ) ^ (3 : Nat))
                * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat))
                * gaussianF (dim n) t) := by
              gcongr
      _ ≤ (C5 * ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))
              + C3 * ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))) * gaussianF (dim n) t := by
            have hgauss_nonneg : 0 ≤ gaussianF (dim n) t := by
              simp [gaussianF]
              positivity
            have hdiv_nonneg : 0 ≤ gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat) := by
              have henv_nonneg : 0 ≤ gaussianEvenMomentEnvelope 5 := by
                exact le_trans zero_le_one (gaussianEvenMomentEnvelope_one_le 5)
              have hnum_nonneg : 0 ≤ gaussianEvenMomentEnvelope 5 ^ 5 := by
                positivity
              have hden_nonneg : 0 ≤ t ^ (5 : Nat) := by positivity
              exact div_nonneg hnum_nonneg hden_nonneg
            have hcoeff3_nonneg : 0 ≤ (2 * (1 / 3 : ℝ) ^ (2 : Nat)) := by positivity
            calc
              (2 * (1 / 120 : ℝ) ^ (2 : Nat))
                  * ((((Fintype.card (EdgeQuintuple 5) : ℝ) ^ (2 : Nat)) * (n : ℝ) ^ (5 : Nat))
                      * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat))
                      * gaussianF (dim n) t)
                + (2 * (1 / 3 : ℝ) ^ (2 : Nat))
                  * (((9 : ℝ) * (n : ℝ) ^ (3 : Nat))
                      * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat))
                      * gaussianF (dim n) t)
                ≤ (2 * (1 / 120 : ℝ) ^ (2 : Nat))
                    * ((((Fintype.card (EdgeQuintuple 5) : ℝ) ^ (2 : Nat)) * (n : ℝ) ^ (5 : Nat))
                        * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat))
                        * gaussianF (dim n) t)
                  + (2 * (1 / 3 : ℝ) ^ (2 : Nat))
                    * (((9 : ℝ) * (n : ℝ) ^ (5 : Nat))
                        * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat))
                        * gaussianF (dim n) t) := by
                          have hscaled3 :
                              (((9 : ℝ) * (n : ℝ) ^ (3 : Nat))
                                  * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat))
                                  * gaussianF (dim n) t)
                                ≤ (((9 : ℝ) * (n : ℝ) ^ (5 : Nat))
                                    * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat))
                                    * gaussianF (dim n) t) := by
                            have hmul3 :
                                ((9 : ℝ) * (n : ℝ) ^ (3 : Nat))
                                  * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat))
                                  ≤ ((9 : ℝ) * (n : ℝ) ^ (5 : Nat))
                                      * (gaussianEvenMomentEnvelope 5 ^ 5 / t ^ (5 : Nat)) := by
                              exact mul_le_mul_of_nonneg_right
                                (mul_le_mul_of_nonneg_left hn35 (by positivity)) hdiv_nonneg
                            exact mul_le_mul_of_nonneg_right hmul3 hgauss_nonneg
                          simpa [mul_assoc, mul_left_comm, mul_comm] using
                            (mul_le_mul_of_nonneg_left hscaled3 hcoeff3_nonneg)
              _ = (C5 * ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))
                      + C3 * ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))) * gaussianF (dim n) t := by
                    dsimp [C5, C3]
                    ring
      _ = (C5 + C3) * ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)) * gaussianF (dim n) t := by
            ring
      _ ≤ (Ccore * (C5 + C3)) * ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)) * coreMass (dim n) t := by
            have hcore' : gaussianF (dim n) t ≤ Ccore * coreMass (dim n) t :=
              hcore (dim n) t hd ht
            have hfac_nonneg : 0 ≤ (C5 + C3) * ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)) := by
              have henv_base_nonneg : 0 ≤ gaussianEvenMomentEnvelope 5 := by
                exact le_trans zero_le_one (gaussianEvenMomentEnvelope_one_le 5)
              have henv_nonneg : 0 ≤ gaussianEvenMomentEnvelope 5 ^ 5 := by
                exact pow_nonneg henv_base_nonneg 5
              have hC5_nonneg : 0 ≤ C5 := by
                dsimp [C5]
                have hcoeff_nonneg : 0 ≤ 2 * (1 / 120 : ℝ) ^ (2 : Nat) := by
                  exact mul_nonneg (by norm_num) (sq_nonneg (1 / 120 : ℝ))
                have hcard_nonneg : 0 ≤ ((Fintype.card (EdgeQuintuple 5) : ℝ) ^ (2 : Nat)) := by
                  exact sq_nonneg ((Fintype.card (EdgeQuintuple 5) : ℝ))
                exact mul_nonneg (mul_nonneg hcoeff_nonneg hcard_nonneg) henv_nonneg
              have hC3_nonneg : 0 ≤ C3 := by
                dsimp [C3]
                have hcoeff_nonneg : 0 ≤ 2 * (1 / 3 : ℝ) ^ (2 : Nat) := by
                  exact mul_nonneg (by norm_num) (sq_nonneg (1 / 3 : ℝ))
                have hnine_nonneg : 0 ≤ (9 : ℝ) := by norm_num
                exact mul_nonneg (mul_nonneg hcoeff_nonneg hnine_nonneg) henv_nonneg
              have hsum_nonneg : 0 ≤ C5 + C3 := by
                exact add_nonneg hC5_nonneg hC3_nonneg
              have hpow_nonneg : 0 ≤ (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat) := by
                exact div_nonneg (by positivity) (by positivity)
              exact mul_nonneg hsum_nonneg hpow_nonneg
            simpa [mul_assoc, mul_left_comm, mul_comm] using
              (mul_le_mul_of_nonneg_left hcore' hfac_nonneg)
      _ = ((Ccore * (C5 + C3)) * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)) * coreMass (dim n) t := by
            ring

/-- The mixed cubic-quintic Gaussian core term is controlled by the corresponding
quadratic core moments. -/
private theorem cubicT_quinticP5_abs_coreMass_bound_uniform :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, 2 ≤ n → ∀ t : ℝ, 1 ≤ t →
        (dim n : ℝ) / t ≤ Cn3Torus.delta ^ (2 : Nat) →
        ∫ mu in edgeCoreRegion n t,
            |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
          ≤ (C * (n : ℝ) ^ (4 : Nat) / t ^ (4 : Nat)) * coreMass (dim n) t := by
  obtain ⟨Ccub, hCcub_pos, hcub⟩ := cubicT_sq_coreMass_bound_uniform
  obtain ⟨Cquin, hCquin_pos, hquin⟩ := quinticP5_l2_coreMass_bound_uniform
  refine ⟨Real.sqrt Ccub * Real.sqrt Cquin, by positivity, ?_⟩
  intro n hn t ht hbox
  let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n t
  let μ : MeasureTheory.Measure (Cn3Torus.Edge n → ℝ) := MeasureTheory.volume.restrict core
  let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    |cubicT n (matrixOfEdge n mu)| * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu)
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    |quinticP5 n (matrixOfEdge n mu)| * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu)
  have hdim : 1 ≤ dim n := one_le_dim_of_two_le n hn
  have ht_pos : 0 < t := by linarith
  have hf_cont : Continuous f := by
    have hcubic :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
      (continuous_cubicT n).comp (continuous_matrixOfEdge n)
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [f]
    fun_prop
  have hg_cont : Continuous g := by
    have hquint :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [g]
    fun_prop
  have hf_sq_int : MeasureTheory.Integrable (fun x => f x ^ (2 : Nat)) μ := by
    simpa [μ, core, MeasureTheory.IntegrableOn] using
      (((hf_cont.pow 2).continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox))
  have hg_sq_int : MeasureTheory.Integrable (fun x => g x ^ (2 : Nat)) μ := by
    simpa [μ, core, MeasureTheory.IntegrableOn] using
      (((hg_cont.pow 2).continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox))
  have hf_ae : MeasureTheory.AEStronglyMeasurable f μ := hf_cont.aestronglyMeasurable
  have hg_ae : MeasureTheory.AEStronglyMeasurable g μ := hg_cont.aestronglyMeasurable
  have hf_nonneg : 0 ≤ᵐ[μ] f := Filter.Eventually.of_forall (fun x => by
    dsimp [f]
    exact mul_nonneg (abs_nonneg _) (le_of_lt (Real.exp_pos _)))
  have hg_nonneg : 0 ≤ᵐ[μ] g := Filter.Eventually.of_forall (fun x => by
    dsimp [g]
    exact mul_nonneg (abs_nonneg _) (le_of_lt (Real.exp_pos _)))
  have hcs := cs_helper μ hf_ae hg_ae hf_nonneg hg_nonneg hf_sq_int hg_sq_int
  have hleft_eq :
      ∫ x, f x * g x ∂μ
        = ∫ mu in core,
            |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
    simp [μ]
    refine MeasureTheory.integral_congr_ae ?_
    exact Filter.Eventually.of_forall (fun x => by
      dsimp [f, g]
      have hExp :
          Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x) *
              Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x) =
            Real.exp (-(2 * t * Cn3Torus.sqNormEdge n x)) := by
        rw [← Real.exp_add]
        congr 1
        ring
      calc
        |cubicT n (matrixOfEdge n x)| * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x) *
            (|quinticP5 n (matrixOfEdge n x)| * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)) =
          (|cubicT n (matrixOfEdge n x)| * |quinticP5 n (matrixOfEdge n x)|) *
            (Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x) *
              Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)) := by
            ac_rfl
        _ = |cubicT n (matrixOfEdge n x) * quinticP5 n (matrixOfEdge n x)| *
            (Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x) *
              Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)) := by
            simp [abs_mul, mul_assoc, mul_left_comm, mul_comm]
        _ = |cubicT n (matrixOfEdge n x) * quinticP5 n (matrixOfEdge n x)| *
            Real.exp (-(2 * t * Cn3Torus.sqNormEdge n x)) := by
            rw [hExp]
        _ = |cubicT n (matrixOfEdge n x)| * |quinticP5 n (matrixOfEdge n x)| *
            Real.exp (-(2 * t * Cn3Torus.sqNormEdge n x)) := by
            simp [abs_mul, mul_assoc, mul_left_comm, mul_comm]
      )
  have hAeq :
      ∫ x, f x ^ (2 : Nat) ∂μ
        = ∫ mu in core,
            (cubicT n (matrixOfEdge n mu)) ^ (2 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
    simp [μ]
    refine MeasureTheory.integral_congr_ae ?_
    exact Filter.Eventually.of_forall (fun x => by
      dsimp [f]
      let a := cubicT n (matrixOfEdge n x)
      let e := Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)
      have hExp :
          e * e
            = Real.exp (-(2 * t * Cn3Torus.sqNormEdge n x)) := by
        dsimp [e]
        rw [← Real.exp_add]
        congr 1
        ring
      have hAbsSq : |a| * |a| = a ^ (2 : Nat) := by
        simpa [pow_two] using (sq_abs a)
      calc
        (|a| * e) ^ (2 : Nat) = (|a| * |a|) * (e * e) := by ring
        _ = a ^ (2 : Nat) * Real.exp (-(2 * t * Cn3Torus.sqNormEdge n x)) := by
          rw [hAbsSq, hExp]
      )
  have hBeq :
      ∫ x, g x ^ (2 : Nat) ∂μ
        = ∫ mu in core,
            (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
    simp [μ]
    refine MeasureTheory.integral_congr_ae ?_
    exact Filter.Eventually.of_forall (fun x => by
      dsimp [g]
      let a := quinticP5 n (matrixOfEdge n x)
      let e := Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)
      have hExp :
          e * e
            = Real.exp (-(2 * t * Cn3Torus.sqNormEdge n x)) := by
        dsimp [e]
        rw [← Real.exp_add]
        congr 1
        ring
      have hAbsSq : |a| * |a| = a ^ (2 : Nat) := by
        simpa [pow_two] using (sq_abs a)
      calc
        (|a| * e) ^ (2 : Nat) = (|a| * |a|) * (e * e) := by ring
        _ = a ^ (2 : Nat) * Real.exp (-(2 * t * Cn3Torus.sqNormEdge n x)) := by
          rw [hAbsSq, hExp]
      )
  have hA :
      ∫ x, f x ^ (2 : Nat) ∂μ
        ≤ (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * coreMass (dim n) t := by
    rw [hAeq]
    exact hcub n hdim t ht
  have hB :
      ∫ x, g x ^ (2 : Nat) ∂μ
        ≤ (Cquin * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)) * coreMass (dim n) t := by
    rw [hBeq]
    exact hquin n hdim t ht
  have hcore_nonneg : 0 ≤ coreMass (dim n) t := coreMass_nonneg (dim n) t
  have hA_nonneg : 0 ≤ ∫ x, f x ^ (2 : Nat) ∂μ := by
    exact MeasureTheory.integral_nonneg_of_ae (Filter.Eventually.of_forall (fun x => by
      dsimp [f]
      positivity))
  have hB_nonneg : 0 ≤ ∫ x, g x ^ (2 : Nat) ∂μ := by
    exact MeasureTheory.integral_nonneg_of_ae (Filter.Eventually.of_forall (fun x => by
      dsimp [g]
      positivity))
  have hA_rpow :
      (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
        ≤ ((Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * coreMass (dim n) t) ^ (1 / (2 : ℝ)) := by
    exact Real.rpow_le_rpow hA_nonneg hA (by norm_num)
  have hB_rpow :
      (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
        ≤ ((Cquin * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)) * coreMass (dim n) t) ^ (1 / (2 : ℝ)) := by
    exact Real.rpow_le_rpow hB_nonneg hB (by norm_num)
  have hA_bound_nonneg :
      0 ≤ ((Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * coreMass (dim n) t) ^ (1 / (2 : ℝ)) := by
    exact Real.rpow_nonneg (by positivity) _
  have hB_factor_nonneg :
      0 ≤ (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
    exact Real.rpow_nonneg hB_nonneg _
  calc
    ∫ mu in edgeCoreRegion n t,
        |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ x, f x * g x ∂μ := by rw [hleft_eq]
    _ ≤ (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
          * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := hcs
    _ ≤ ((Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * coreMass (dim n) t) ^ (1 / (2 : ℝ))
          * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
            exact mul_le_mul_of_nonneg_right hA_rpow hB_factor_nonneg
    _ ≤ ((Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * coreMass (dim n) t) ^ (1 / (2 : ℝ))
          * (((Cquin * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)) * coreMass (dim n) t)) ^ (1 / (2 : ℝ)) := by
            exact mul_le_mul_of_nonneg_left hB_rpow hA_bound_nonneg
    _ = Real.sqrt (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
          * Real.sqrt (Cquin * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))
          * coreMass (dim n) t := by
            rw [← Real.sqrt_eq_rpow, ← Real.sqrt_eq_rpow]
            calc
              Real.sqrt ((Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) * coreMass (dim n) t)
                  * Real.sqrt ((Cquin * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)) * coreMass (dim n) t)
                = (Real.sqrt (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                    * Real.sqrt (coreMass (dim n) t))
                  * (Real.sqrt (Cquin * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))
                    * Real.sqrt (coreMass (dim n) t)) := by
                      rw [Real.sqrt_mul (by positivity), Real.sqrt_mul (by positivity)]
              _ = (Real.sqrt (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                    * Real.sqrt (Cquin * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)))
                  * (Real.sqrt (coreMass (dim n) t) * Real.sqrt (coreMass (dim n) t)) := by
                      ring
              _ = Real.sqrt (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                    * Real.sqrt (Cquin * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))
                    * coreMass (dim n) t := by
                      rw [show Real.sqrt (coreMass (dim n) t) * Real.sqrt (coreMass (dim n) t)
                              = coreMass (dim n) t by
                              nlinarith [Real.sq_sqrt hcore_nonneg]]
    _ ≤ (Real.sqrt Ccub * Real.sqrt Cquin * (n : ℝ) ^ (4 : Nat) / t ^ (4 : Nat))
          * coreMass (dim n) t := by
            have hfac1_nonneg : 0 ≤ (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat) := by positivity
            have hfac2_nonneg : 0 ≤ (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat) := by positivity
            have hsqrt_u :
                Real.sqrt ((n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                  * Real.sqrt ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))
                  = (n : ℝ) ^ (4 : Nat) / t ^ (4 : Nat) := by
              rw [← Real.sqrt_mul hfac1_nonneg ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))]
              rw [show ((n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                    * ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))
                    = ((n : ℝ) ^ (4 : Nat) / t ^ (4 : Nat)) ^ (2 : Nat) by
                    field_simp [ht_pos.ne']]
              rw [Real.sqrt_sq_eq_abs]
              simpa using abs_of_nonneg (show 0 ≤ (n : ℝ) ^ (4 : Nat) / t ^ (4 : Nat) by positivity)
            have hprod_eq :
                Real.sqrt (Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                  * Real.sqrt (Cquin * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))
                  = Real.sqrt Ccub * Real.sqrt Cquin * ((n : ℝ) ^ (4 : Nat) / t ^ (4 : Nat)) := by
              rw [show Ccub * (n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)
                    = Ccub * ((n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)) by ring]
              rw [show Cquin * (n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)
                    = Cquin * ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)) by ring]
              rw [Real.sqrt_mul hCcub_pos.le ((n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))]
              rw [Real.sqrt_mul hCquin_pos.le ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))]
              calc
                (Real.sqrt Ccub * Real.sqrt ((n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat)))
                    * (Real.sqrt Cquin * Real.sqrt ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat)))
                  = Real.sqrt Ccub * Real.sqrt Cquin
                      * (Real.sqrt ((n : ℝ) ^ (3 : Nat) / t ^ (3 : Nat))
                          * Real.sqrt ((n : ℝ) ^ (5 : Nat) / t ^ (5 : Nat))) := by
                        ring
                _ = Real.sqrt Ccub * Real.sqrt Cquin * ((n : ℝ) ^ (4 : Nat) / t ^ (4 : Nat)) := by
                      rw [hsqrt_u]
            rw [hprod_eq]
            have htriv :
                Real.sqrt Ccub * Real.sqrt Cquin * (n : ℝ) ^ (4 : Nat) * t⁻¹ ^ (4 : Nat)
                    * coreMass (dim n) t
                  ≤ Real.sqrt Ccub * Real.sqrt Cquin * (n : ℝ) ^ (4 : Nat) * t⁻¹ ^ (4 : Nat)
                    * coreMass (dim n) t := le_rfl
            simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using htriv

/-- Gaussian-scale version of the mixed cubic-quintic core bound. -/
private theorem cubicT_quinticP5_abs_core_bound_uniform :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, 2 ≤ n → ∀ t : ℝ, 1 ≤ t →
        (dim n : ℝ) / t ≤ Cn3Torus.delta ^ (2 : Nat) →
        ∫ mu in edgeCoreRegion n t,
            |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
          ≤ (C * (n : ℝ) ^ (4 : Nat) / t ^ (4 : Nat)) * gaussianF (dim n) t := by
  obtain ⟨Cmix, hCmix_pos, hmix⟩ := cubicT_quinticP5_abs_coreMass_bound_uniform
  refine ⟨Cmix, hCmix_pos, ?_⟩
  intro n hn t ht hbox
  have hmix_core := hmix n hn t ht hbox
  have hcore_le : coreMass (dim n) t ≤ gaussianF (dim n) t := coreMass_le_gaussianF n t (by linarith)
  have hfac_nonneg : 0 ≤ Cmix * (n : ℝ) ^ (4 : Nat) / t ^ (4 : Nat) := by positivity
  calc
    ∫ mu in edgeCoreRegion n t,
        |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ (Cmix * (n : ℝ) ^ (4 : Nat) / t ^ (4 : Nat)) * coreMass (dim n) t := hmix_core
    _ ≤ (Cmix * (n : ℝ) ^ (4 : Nat) / t ^ (4 : Nat)) * gaussianF (dim n) t := by
          exact mul_le_mul_of_nonneg_left hcore_le hfac_nonneg

/-- Pointwise quadratic control for removing the quintic phase from the cubic
oscillation under the pure Gaussian core weight. This auxiliary version is placed
before the integrated core theorems that depend on it. -/
private lemma cubic_quintic_phase_gap_pointwise_aux
    (n t : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    |Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
        * (Real.cos
            (4 * (t : ℝ)
              * (cubicT n (matrixOfEdge n mu) - quinticP5 n (matrixOfEdge n mu)))
            - Real.cos (4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)))|
      ≤ Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
          * ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)
              * (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
            + (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
              * |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|) := by
  set A : ℝ := Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
  set x : ℝ := 4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)
  set y : ℝ := 4 * (t : ℝ) * quinticP5 n (matrixOfEdge n mu)
  have hA_nonneg : 0 ≤ A := by
    dsimp [A]
    positivity
  calc
    |Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
        * (Real.cos
            (4 * (t : ℝ)
              * (cubicT n (matrixOfEdge n mu) - quinticP5 n (matrixOfEdge n mu)))
            - Real.cos (4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)))|
      = |A * (Real.cos (x - y) - Real.cos x)| := by
          dsimp [A, x, y]
          congr 1
          ring_nf
    _ = A * |Real.cos (x - y) - Real.cos x| := by
          rw [abs_mul, abs_of_nonneg hA_nonneg]
    _ ≤ A * (y ^ (2 : Nat) / 2 + |x * y|) := by
          gcongr
          exact cos_sub_cos_abs_le_sq_div_two_add_abs_mul x y
    _ = A * ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)
              * (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
            + (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
              * |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|) := by
          have hy_sq :
              y ^ (2 : Nat) / 2
                = (8 : ℝ) * (t : ℝ) ^ (2 : Nat)
                    * (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat) := by
            dsimp [y]
            ring_nf
          have habs_xy :
              |x * y|
                = (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
                    * |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)| := by
            have h4t_nonneg : 0 ≤ (4 : ℝ) * (t : ℝ) := by positivity
            have habs_4t : |(4 : ℝ) * (t : ℝ)| = (4 : ℝ) * (t : ℝ) := by
              rw [abs_of_nonneg h4t_nonneg]
            dsimp [x, y]
            calc
              |(4 * (t : ℝ) * cubicT n (matrixOfEdge n mu))
                  * (4 * (t : ℝ) * quinticP5 n (matrixOfEdge n mu))|
                = |4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)|
                    * |4 * (t : ℝ) * quinticP5 n (matrixOfEdge n mu)| := by
                      rw [abs_mul]
              _ = (((4 : ℝ) * (t : ℝ)) * |cubicT n (matrixOfEdge n mu)|)
                    * (((4 : ℝ) * (t : ℝ)) * |quinticP5 n (matrixOfEdge n mu)|) := by
                      have habs_x :
                          |4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)|
                            = ((4 : ℝ) * (t : ℝ)) * |cubicT n (matrixOfEdge n mu)| := by
                            rw [abs_mul, abs_mul, abs_of_nonneg (by norm_num : 0 ≤ (4 : ℝ)),
                              abs_of_nonneg (by positivity : 0 ≤ (t : ℝ))]
                      have habs_y :
                          |4 * (t : ℝ) * quinticP5 n (matrixOfEdge n mu)|
                            = ((4 : ℝ) * (t : ℝ)) * |quinticP5 n (matrixOfEdge n mu)| := by
                            rw [abs_mul, abs_mul, abs_of_nonneg (by norm_num : 0 ≤ (4 : ℝ)),
                              abs_of_nonneg (by positivity : 0 ≤ (t : ℝ))]
                      rw [habs_x, habs_y]
              _ = (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
                    * (|cubicT n (matrixOfEdge n mu)| * |quinticP5 n (matrixOfEdge n mu)|) := by
                      ring_nf
              _ = (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
                    * |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)| := by
                      rw [← abs_mul]
          rw [hy_sq, habs_xy]

/-- Refined quintic-phase removal under the pure Gaussian core weight. This is the
first bridge used in the refined primary expansion from the arXiv paper. -/
private lemma core_integral_abs_le_of_two_term_majorant
    {α : Type*} [MeasurableSpace α] [MeasureSpace α]
    {core : Set α} {rem upper Pterm TPterm : α → ℝ}
    {Acoeff Bcoeff Pbound Tbound : ℝ}
    (hrem_int : MeasureTheory.IntegrableOn rem core)
    (hupper_int : MeasureTheory.IntegrableOn upper core)
    (hmono : ∀ᵐ x ∂(MeasureTheory.volume.restrict core), |rem x| ≤ upper x)
    (hupper_eq :
      ∫ x in core, upper x = Acoeff * (∫ x in core, Pterm x) + Bcoeff * (∫ x in core, TPterm x))
    (hP : Acoeff * (∫ x in core, Pterm x) ≤ Pbound)
    (hTP : Bcoeff * (∫ x in core, TPterm x) ≤ Tbound) :
    |∫ x in core, rem x| ≤ Pbound + Tbound := by
  have hrem_le :
      ∫ x in core, |rem x| ≤ ∫ x in core, upper x := by
    exact MeasureTheory.integral_mono_ae hrem_int.norm hupper_int hmono
  have habs :
      |∫ x in core, rem x| ≤ ∫ x in core, |rem x| := by
    simpa [Real.norm_eq_abs] using
      (MeasureTheory.norm_integral_le_integral_norm
        (μ := MeasureTheory.volume.restrict core) (f := rem))
  calc
    |∫ x in core, rem x| ≤ ∫ x in core, |rem x| := habs
    _ ≤ ∫ x in core, upper x := hrem_le
    _ = Acoeff * (∫ x in core, Pterm x) + Bcoeff * (∫ x in core, TPterm x) := hupper_eq
    _ ≤ Pbound + Tbound := add_le_add hP hTP

private theorem cubic_quintic_phase_core_integral_gap_abs_le_gaussianF_refined :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, 2 ≤ n → ∀ t : ℕ, 1 ≤ t →
        (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat) →
        |(∫ mu in edgeCoreRegion n (t : ℝ),
            Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
              * (Real.cos
                  (4 * (t : ℝ)
                    * (cubicT n (matrixOfEdge n mu) - quinticP5 n (matrixOfEdge n mu)))
                  - Real.cos (4 * (t : ℝ) * cubicT n (matrixOfEdge n mu))))|
          ≤ (C * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat)) * gaussianF (dim n) (t : ℝ) := by
  obtain ⟨Cquin, hCquin_pos, hquin⟩ := quinticP5_l2_coreMass_bound_uniform
  obtain ⟨Cmix, hCmix_pos, hmix⟩ := cubicT_quinticP5_abs_core_bound_uniform
  refine ⟨(8 : ℝ) * Cquin + (16 : ℝ) * Cmix, by positivity, ?_⟩
  intro n hn t ht hbox
  let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n (t : ℝ)
  let rem : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
      * (Real.cos
          (4 * (t : ℝ)
            * (cubicT n (matrixOfEdge n mu) - quinticP5 n (matrixOfEdge n mu)))
          - Real.cos (4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)))
  let upper : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
      * ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)
          * (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
        + (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
          * |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|)
  let Pterm : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
      * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
  let TPterm : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|
      * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
  have hrem_cont : Continuous rem := by
    have hcub :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
      (continuous_cubicT n).comp (continuous_matrixOfEdge n)
    have hquint :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [rem]
    fun_prop
  have hupper_cont : Continuous upper := by
    have hcub :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
      (continuous_cubicT n).comp (continuous_matrixOfEdge n)
    have hquint :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [upper]
    fun_prop
  have hPterm_cont : Continuous Pterm := by
    have hquint :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [Pterm]
    fun_prop
  have hTPterm_cont : Continuous TPterm := by
    have hcub :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
      (continuous_cubicT n).comp (continuous_matrixOfEdge n)
    have hquint :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [TPterm]
    fun_prop
  have hPterm_int : MeasureTheory.IntegrableOn Pterm core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hPterm_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hTPterm_int : MeasureTheory.IntegrableOn TPterm core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hTPterm_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hrem_int : MeasureTheory.IntegrableOn rem core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hrem_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hupper_int : MeasureTheory.IntegrableOn upper core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hupper_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hmono :
      ∀ᵐ mu ∂(MeasureTheory.volume.restrict core), |rem mu| ≤ upper mu := by
    exact Filter.Eventually.of_forall (fun mu => by
      dsimp [rem, upper]
      exact cubic_quintic_phase_gap_pointwise_aux n t mu)
  have hupper_eq :
      ∫ mu in core, upper mu
        = ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)) * (∫ mu in core, Pterm mu)
          + ((16 : ℝ) * (t : ℝ) ^ (2 : Nat)) * (∫ mu in core, TPterm mu) := by
    have hupper_fun :
        upper
          = fun mu =>
              ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)) * Pterm mu
                + ((16 : ℝ) * (t : ℝ) ^ (2 : Nat)) * TPterm mu := by
      funext mu
      dsimp [upper, Pterm, TPterm]
      ring
    calc
      ∫ mu in core, upper mu
        = ∫ mu in core,
            (((8 : ℝ) * (t : ℝ) ^ (2 : Nat)) * Pterm mu
              + ((16 : ℝ) * (t : ℝ) ^ (2 : Nat)) * TPterm mu) := by
                rw [hupper_fun]
      _ = (∫ mu in core, ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)) * Pterm mu)
            + ∫ mu in core, ((16 : ℝ) * (t : ℝ) ^ (2 : Nat)) * TPterm mu := by
              rw [MeasureTheory.integral_add
                (hPterm_int.const_mul ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)))
                (hTPterm_int.const_mul ((16 : ℝ) * (t : ℝ) ^ (2 : Nat)))]
      _ = ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)) * (∫ mu in core, Pterm mu)
            + ((16 : ℝ) * (t : ℝ) ^ (2 : Nat)) * (∫ mu in core, TPterm mu) := by
              rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
  have hP0 : 1 ≤ dim n := one_le_dim_of_two_le n hn
  have hP_core :
      ∫ mu in core, Pterm mu
        ≤ (Cquin * (n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (5 : Nat)) * coreMass (dim n) (t : ℝ) := by
    simpa [core, Pterm] using hquin n hP0 (t : ℝ) (by exact_mod_cast ht)
  have hP :
      ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)) * (∫ mu in core, Pterm mu)
        ≤ ((8 : ℝ) * Cquin * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat))
            * gaussianF (dim n) (t : ℝ) := by
    have hcore_le : coreMass (dim n) (t : ℝ) ≤ gaussianF (dim n) (t : ℝ) :=
      coreMass_le_gaussianF n (t : ℝ) (by exact_mod_cast ht)
    have hconst_nonneg : 0 ≤ (8 : ℝ) * (t : ℝ) ^ (2 : Nat) := by positivity
    have hmul1 := mul_le_mul_of_nonneg_left hP_core hconst_nonneg
    calc
      (8 : ℝ) * (t : ℝ) ^ (2 : Nat) * ∫ mu in core, Pterm mu
        ≤ (8 : ℝ) * (t : ℝ) ^ (2 : Nat)
            * ((Cquin * (n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (5 : Nat)) * coreMass (dim n) (t : ℝ)) := hmul1
      _ = ((8 : ℝ) * Cquin * (n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (3 : Nat))
            * coreMass (dim n) (t : ℝ) := by
            have ht_pos : (0 : ℝ) < (t : ℝ) := by exact_mod_cast ht
            field_simp [ht_pos.ne']
      _ ≤ ((8 : ℝ) * Cquin * (n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (3 : Nat))
            * gaussianF (dim n) (t : ℝ) := by
            gcongr
      _ ≤ ((8 : ℝ) * Cquin * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat))
            * gaussianF (dim n) (t : ℝ) := by
            have hgauss_nonneg : 0 ≤ gaussianF (dim n) (t : ℝ) := by
              exact Real.rpow_nonneg (by positivity) _
            have hcoeff_nonneg : 0 ≤ (8 : ℝ) * Cquin := by positivity
            have hpow :
                (n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (3 : Nat)
                  ≤ (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat) := by
              have ht_pos : (0 : ℝ) < (t : ℝ) := by exact_mod_cast ht
              have ht_one : (1 : ℝ) ≤ (t : ℝ) := by exact_mod_cast ht
              have hn_one : (1 : ℝ) ≤ (n : ℝ) := by
                have hn_two : (2 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
                nlinarith
              have h_inv_le_n : 1 / (t : ℝ) ≤ (n : ℝ) := by
                have h_inv_le_one : 1 / (t : ℝ) ≤ (1 : ℝ) := by
                  simpa using one_div_le_one_div_of_le (by positivity : (0 : ℝ) < 1) ht_one
                exact le_trans h_inv_le_one hn_one
              calc
                (n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (3 : Nat)
                  = ((n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (2 : Nat)) * (1 / (t : ℝ)) := by
                      field_simp [ht_pos.ne']
                      
                _ ≤ ((n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (2 : Nat)) * (n : ℝ) := by
                      exact mul_le_mul_of_nonneg_left h_inv_le_n (by positivity)
                _ = (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat) := by ring
            have hcoeff :
                ((8 : ℝ) * Cquin) * ((n : ℝ) ^ (5 : Nat) / (t : ℝ) ^ (3 : Nat))
                  ≤ ((8 : ℝ) * Cquin) * ((n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat)) := by
              exact mul_le_mul_of_nonneg_left hpow hcoeff_nonneg
            simpa [mul_assoc, mul_left_comm, mul_comm, div_eq_mul_inv] using
              (mul_le_mul_of_nonneg_right hcoeff hgauss_nonneg)
  have hTP_core :
      ∫ mu in core, TPterm mu
        ≤ (Cmix * (n : ℝ) ^ (4 : Nat) / (t : ℝ) ^ (4 : Nat)) * gaussianF (dim n) (t : ℝ) := by
    simpa [core, TPterm] using hmix n hn (t : ℝ) (by exact_mod_cast ht) hbox
  have hTP :
      ((16 : ℝ) * (t : ℝ) ^ (2 : Nat)) * (∫ mu in core, TPterm mu)
        ≤ ((16 : ℝ) * Cmix * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat))
            * gaussianF (dim n) (t : ℝ) := by
    have hconst_nonneg : 0 ≤ (16 : ℝ) * (t : ℝ) ^ (2 : Nat) := by positivity
    have hmul1 := mul_le_mul_of_nonneg_left hTP_core hconst_nonneg
    calc
      (16 : ℝ) * (t : ℝ) ^ (2 : Nat) * ∫ mu in core, TPterm mu
        ≤ (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
            * ((Cmix * (n : ℝ) ^ (4 : Nat) / (t : ℝ) ^ (4 : Nat))
                * gaussianF (dim n) (t : ℝ)) := hmul1
      _ = ((16 : ℝ) * Cmix * (n : ℝ) ^ (4 : Nat) / (t : ℝ) ^ (2 : Nat))
            * gaussianF (dim n) (t : ℝ) := by
            have ht_pos : (0 : ℝ) < (t : ℝ) := by exact_mod_cast ht
            field_simp [ht_pos.ne']
      _ ≤ ((16 : ℝ) * Cmix * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat))
            * gaussianF (dim n) (t : ℝ) := by
            have hgauss_nonneg : 0 ≤ gaussianF (dim n) (t : ℝ) := by
              exact Real.rpow_nonneg (by positivity) _
            have hcoeff_nonneg : 0 ≤ (16 : ℝ) * Cmix := by positivity
            have hn_one : (1 : ℝ) ≤ (n : ℝ) := by
              have hn_two : (2 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
              linarith
            have hpow :
                (n : ℝ) ^ (4 : Nat) ≤ (n : ℝ) ^ (6 : Nat) := by
              calc
                (n : ℝ) ^ (4 : Nat) = (n : ℝ) ^ (4 : Nat) * 1 := by ring
                _ ≤ (n : ℝ) ^ (4 : Nat) * (n : ℝ) ^ (2 : Nat) := by
                      gcongr
                      nlinarith [sq_nonneg ((n : ℝ) - 1)]
                _ = (n : ℝ) ^ (6 : Nat) := by ring
            have hcoeff :
                (16 : ℝ) * Cmix * (n : ℝ) ^ (4 : Nat) / (t : ℝ) ^ (2 : Nat)
                  ≤ (16 : ℝ) * Cmix * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat) := by
              have hfac_nonneg : 0 ≤ 1 / (t : ℝ) ^ (2 : Nat) := by positivity
              calc
                (16 : ℝ) * Cmix * (n : ℝ) ^ (4 : Nat) / (t : ℝ) ^ (2 : Nat)
                  = ((16 : ℝ) * Cmix * (n : ℝ) ^ (4 : Nat)) * (1 / (t : ℝ) ^ (2 : Nat)) := by ring
                _ ≤ ((16 : ℝ) * Cmix * (n : ℝ) ^ (6 : Nat)) * (1 / (t : ℝ) ^ (2 : Nat)) := by
                      gcongr
                _ = (16 : ℝ) * Cmix * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat) := by ring
            exact mul_le_mul_of_nonneg_right hcoeff hgauss_nonneg
  have hmajor :
      |∫ mu in core, rem mu|
        ≤ (((8 : ℝ) * Cquin * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat))
              * gaussianF (dim n) (t : ℝ))
            + (((16 : ℝ) * Cmix * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat))
              * gaussianF (dim n) (t : ℝ)) := by
    exact core_integral_abs_le_of_two_term_majorant hrem_int hupper_int hmono hupper_eq hP hTP
  calc
    |(∫ mu in edgeCoreRegion n (t : ℝ), rem mu)|
      = |∫ mu in core, rem mu| := by simp [core]
    _ ≤ ((8 : ℝ) * Cquin * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat))
            * gaussianF (dim n) (t : ℝ)
          + ((16 : ℝ) * Cmix * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat))
            * gaussianF (dim n) (t : ℝ) := hmajor
    _ = (((8 : ℝ) * Cquin + (16 : ℝ) * Cmix) * (n : ℝ) ^ (6 : Nat)
            / (t : ℝ) ^ (2 : Nat))
          * gaussianF (dim n) (t : ℝ) := by
            ring

/-- The quintic phase may also be removed inside the quartic-mean term on the cubic
scale, with only an `O(n^6 / t^2)` loss against the Gaussian scale. -/
private theorem quartic_mean_quintic_phase_core_integral_gap_abs_le_gaussianF_refined :
    ∃ C : ℝ, 0 < C ∧
      ∀ n : ℕ, 2 ≤ n → ∀ t : ℕ, 1 ≤ t →
        (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat) →
        (n : ℝ) ^ (3 : Nat) ≤ (t : ℝ) →
        |(4 : ℝ) * (t : ℝ)
            * ∫ mu in edgeCoreRegion n (t : ℝ),
                quarticCorr n (matrixOfEdge n mu)
                  * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
                  * (Real.cos
                      (4 * (t : ℝ)
                        * (cubicT n (matrixOfEdge n mu) - quinticP5 n (matrixOfEdge n mu)))
                      - Real.cos (4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)))|
          ≤ (C * (n : ℝ) ^ (6 : Nat) / (t : ℝ) ^ (2 : Nat)) * gaussianF (dim n) (t : ℝ) := by
  obtain ⟨Cquart, hCquart_pos, hquart⟩ := quarticCorr_pointwise_bound_uniform
  obtain ⟨Cquin, hCquin_pos, hquin⟩ := quinticP5_l2_coreMass_bound_uniform
  obtain ⟨Cmix, hCmix_pos, hmix⟩ := cubicT_quinticP5_abs_core_bound_uniform
  refine ⟨(32 : ℝ) * Cquart * Cquin + (64 : ℝ) * Cquart * Cmix, by positivity, ?_⟩
  intro n hn t ht hbox hscale
  let core : Set (Cn3Torus.Edge n → ℝ) := edgeCoreRegion n (t : ℝ)
  let rem : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (4 : ℝ) * (t : ℝ)
      * quarticCorr n (matrixOfEdge n mu)
      * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
      * (Real.cos
          (4 * (t : ℝ)
            * (cubicT n (matrixOfEdge n mu) - quinticP5 n (matrixOfEdge n mu)))
          - Real.cos (4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)))
  let Pterm : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
      * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
  let TPterm : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|
      * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
  let Acoeff : ℝ :=
    (32 : ℝ) * Cquart * ((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat) * (t : ℝ) ^ (3 : Nat)
  let Bcoeff : ℝ :=
    (64 : ℝ) * Cquart * ((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat) * (t : ℝ) ^ (3 : Nat)
  have hrem_cont : Continuous rem := by
    have hquart_cont :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
      (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    have hcub :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
      (continuous_cubicT n).comp (continuous_matrixOfEdge n)
    have hquint :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    dsimp [rem]
    fun_prop
  have hPterm_cont : Continuous Pterm := by
    have hquint :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [Pterm]
    fun_prop
  have hTPterm_cont : Continuous TPterm := by
    have hcub :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => cubicT n (matrixOfEdge n mu)) :=
      (continuous_cubicT n).comp (continuous_matrixOfEdge n)
    have hquint :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hsq :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [TPterm]
    fun_prop
  have hrem_int : MeasureTheory.IntegrableOn rem core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hrem_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hPterm_int : MeasureTheory.IntegrableOn Pterm core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hPterm_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hTPterm_int : MeasureTheory.IntegrableOn TPterm core := by
    simpa [core, MeasureTheory.IntegrableOn] using
      (hTPterm_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hmono :
      ∀ᵐ mu ∂(MeasureTheory.volume.restrict core),
        |rem mu| ≤ Acoeff * Pterm mu + Bcoeff * TPterm mu := by
    rw [MeasureTheory.ae_restrict_iff' (measurableSet_edgeCoreRegion n (t : ℝ))]
