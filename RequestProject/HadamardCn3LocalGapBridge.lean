      exact Finset.card_mono (Finset.filter_subset_filter (fun e => e ∈ Cn3Torus.edgesIncident n i) hsub)
    exact le_trans (quarticChoiceSupport_incident_card_eq_two (quarticQuad2 q) hi₂) hmono
  · have hsub := (quarticChoiceSupport_subset_quadrupleSupport q).2.2.1
    have hmono :
