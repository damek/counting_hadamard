                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
            refine MeasureTheory.integral_congr_ae ?_
            exact Filter.Eventually.of_forall hpoint
    _ = Finset.sum Tset (fun ξ =>
          Finset.sum Tset (fun ξ' =>
            ∫ mu : Cn3Torus.Edge n → ℝ,
              quarticCycleMonomialOn mu ξ * quarticCycleMonomialOn mu ξ'
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
          rw [MeasureTheory.integral_finset_sum Tset houter_int]
          refine Finset.sum_congr rfl ?_
          intro ξ hξ
          rw [MeasureTheory.integral_finset_sum Tset (fun ξ' hξ' => hpair_int ξ hξ ξ' hξ')]
    _ ≤ Finset.sum Tset (fun _ =>
          (gaussianEvenMomentEnvelope 4 ^ 4 / t ^ (4 : Nat)) * gaussianF (dim n) t) := by
          refine Finset.sum_le_sum ?_
          intro ξ hξ
          have hξvalid : IsSimpleCycle4Index ξ.1 := (Finset.mem_filter.mp hξ).2
          calc
            Finset.sum Tset (fun ξ' =>
                ∫ mu : Cn3Torus.Edge n → ℝ,
                  quarticCycleMonomialOn mu ξ * quarticCycleMonomialOn mu ξ'
                    * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
              = ∫ mu : Cn3Torus.Edge n → ℝ,
                  quarticCycleMonomialOn mu ξ * quarticCycleMonomialOn mu ξ
                    * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
                    let f : (SimpleCycle4Index n × QuarticCycleShape) → ℝ := fun ξ' =>
                      ∫ mu : Cn3Torus.Edge n → ℝ,
                        quarticCycleMonomialOn mu ξ * quarticCycleMonomialOn mu ξ'
                          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
                    have hsplit : Finset.sum Tset f = Finset.sum (Tset.erase ξ) f + f ξ := by
                      simpa [f, add_comm] using
                        (Finset.sum_erase_add (s := Tset) (f := f) (a := ξ) hξ).symm
                    have herase_zero : Finset.sum (Tset.erase ξ) f = 0 := by
                      refine Finset.sum_eq_zero ?_
                      intro ξ' hξ'erase
                      have hξ' : ξ' ∈ Tset := Finset.mem_of_mem_erase hξ'erase
                      have hne : ξ' ≠ ξ := Finset.ne_of_mem_erase hξ'erase
                      have hξ'valid : IsSimpleCycle4Index ξ'.1 := (Finset.mem_filter.mp hξ').2
                      have hzero := quarticCycle_pair_gaussian_zero_of_ne ξ ξ' hξvalid hξ'valid hne.symm t
                      simpa [f, quarticCycleMonomialOn, hξvalid, hξ'valid] using hzero
                    calc
                      Finset.sum Tset f = Finset.sum (Tset.erase ξ) f + f ξ := hsplit
                      _ = f ξ := by rw [herase_zero]; simp
                      _ = ∫ mu : Cn3Torus.Edge n → ℝ,
                            quarticCycleMonomialOn mu ξ * quarticCycleMonomialOn mu ξ
                              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
                            simp [f]
            _ ≤ (gaussianEvenMomentEnvelope 4 ^ 4 / t ^ (4 : Nat)) * gaussianF (dim n) t := by
                  simpa [quarticCycleMonomialOn, hξvalid, pow_two] using
                    quarticCycle_self_gaussian_bound ξ hξvalid t ht
    _ ≤ ((48 * (dim n : ℝ) ^ (2 : Nat))
            * ((gaussianEvenMomentEnvelope 4 ^ 4 / t ^ (4 : Nat)) * gaussianF (dim n) t)) := by
          rw [Finset.sum_const, nsmul_eq_mul]
          have hcard := simpleCycle4Indices_card_le_dim_sq n
          have hfac_nonneg :
              0 ≤ ((gaussianEvenMomentEnvelope 4 ^ 4 / t ^ (4 : Nat)) * gaussianF (dim n) t) := by
            have henv_nonneg : 0 ≤ gaussianEvenMomentEnvelope 4 ^ 4 := by
              have henv_one : 1 ≤ gaussianEvenMomentEnvelope 4 :=
                gaussianEvenMomentEnvelope_one_le 4
              positivity
            have ht_nonneg : 0 ≤ t := le_trans (by norm_num) ht
            have hdiv_nonneg : 0 ≤ gaussianEvenMomentEnvelope 4 ^ 4 / t ^ (4 : Nat) := by
              exact div_nonneg henv_nonneg (by positivity)
            have hgauss_nonneg : 0 ≤ gaussianF (dim n) t := by
              exact Real.rpow_nonneg (by positivity) _
            exact mul_nonneg hdiv_nonneg hgauss_nonneg
          exact mul_le_mul_of_nonneg_right hcard hfac_nonneg
    _ = ((48 * gaussianEvenMomentEnvelope 4 ^ 4) * (dim n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat))
          * gaussianF (dim n) t := by
          ring

private lemma quarticDiagonal_sum_sq_integrable
    {n : ℕ} (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      (∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat)) ^ (2 : Nat)
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  let Dset : Finset (Cn3Torus.Edge n) := Finset.univ
  have hpair_int :
      ∀ e ∈ Dset, ∀ e' ∈ Dset,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
    intro e he e' he'
    exact quarticDiagonalPair_integrable e e' t ht
  have houter_int :
      ∀ e ∈ Dset,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          Finset.sum Dset (fun e' =>
            mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro e he
    exact MeasureTheory.integrable_finset_sum Dset (fun e' he' => hpair_int e he e' he')
  have hpoint :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        (∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = Finset.sum Dset (fun e =>
            Finset.sum Dset (fun e' =>
              mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro mu
    rw [pow_two]
    calc
      (∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat))
          * (∑ e' : Cn3Torus.Edge n, mu e' ^ (4 : Nat))
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = (Finset.sum Dset (fun e =>
            Finset.sum Dset (fun e' =>
              mu e ^ (4 : Nat) * mu e' ^ (4 : Nat))))
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              rw [Finset.sum_mul_sum]
      _ = Finset.sum Dset (fun e =>
            Finset.sum Dset (fun e' =>
              mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl ?_
            intro e he
            rw [Finset.sum_mul]
  refine (MeasureTheory.integrable_finset_sum Dset houter_int).congr ?_
  exact Filter.Eventually.of_forall (fun mu => (hpoint mu).symm)

private lemma quarticCycle_sum_sq_integrable
    {n : ℕ} (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      (Finset.sum (simpleCycle4Indices n) (fun ξ => quarticCycleMonomialOn mu ξ)) ^ (2 : Nat)
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  let Tset := simpleCycle4Indices n
  have hpair_int :
      ∀ ξ ∈ Tset, ∀ ξ' ∈ Tset,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          quarticCycleMonomialOn mu ξ * quarticCycleMonomialOn mu ξ'
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
    intro ξ hξ ξ' hξ'
    simpa [quarticCycleMonomialOn, (Finset.mem_filter.mp hξ).2, (Finset.mem_filter.mp hξ').2] using
      (quarticCyclePair_integrable ξ ξ'
        (Finset.mem_filter.mp hξ).2 (Finset.mem_filter.mp hξ').2 t ht)
  have houter_int :
      ∀ ξ ∈ Tset,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          Finset.sum Tset (fun ξ' =>
            quarticCycleMonomialOn mu ξ * quarticCycleMonomialOn mu ξ'
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro ξ hξ
    exact MeasureTheory.integrable_finset_sum Tset (fun ξ' hξ' => hpair_int ξ hξ ξ' hξ')
  have hpoint :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        (Finset.sum Tset (fun ξ => quarticCycleMonomialOn mu ξ)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = Finset.sum Tset (fun ξ =>
            Finset.sum Tset (fun ξ' =>
              quarticCycleMonomialOn mu ξ * quarticCycleMonomialOn mu ξ'
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro mu
    rw [pow_two]
    calc
      (Finset.sum Tset (fun ξ => quarticCycleMonomialOn mu ξ))
          * (Finset.sum Tset (fun ξ' => quarticCycleMonomialOn mu ξ'))
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = (Finset.sum Tset (fun ξ =>
            Finset.sum Tset (fun ξ' =>
              quarticCycleMonomialOn mu ξ * quarticCycleMonomialOn mu ξ')))
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              rw [Finset.sum_mul_sum]
      _ = Finset.sum Tset (fun ξ =>
            Finset.sum Tset (fun ξ' =>
              quarticCycleMonomialOn mu ξ * quarticCycleMonomialOn mu ξ'
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl ?_
            intro ξ hξ
            rw [Finset.sum_mul]
  refine (MeasureTheory.integrable_finset_sum Tset houter_int).congr ?_
  exact Filter.Eventually.of_forall (fun mu => (hpoint mu).symm)

private lemma quarticCorr_sq_gaussian_integrable
    {n : ℕ} (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      (quarticCorr n (matrixOfEdge n mu)) ^ (2 : Nat)
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  let D : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu => ∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat)
  let C : (Cn3Torus.Edge n → ℝ) → ℝ :=
    fun mu => Finset.sum (simpleCycle4Indices n) (fun ξ => quarticCycleMonomialOn mu ξ)
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (1 / 72 : ℝ) * (D mu ^ (2 : Nat) * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
      + 2 * (C mu ^ (2 : Nat) * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
  have hD_int :
      MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
        D mu ^ (2 : Nat) * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
    simpa [D] using quarticDiagonal_sum_sq_integrable t ht
  have hC_int :
      MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
        C mu ^ (2 : Nat) * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
    simpa [C] using quarticCycle_sum_sq_integrable t ht
  have hg_int : MeasureTheory.Integrable g := by
    simpa [g, add_comm, add_left_comm, add_assoc, mul_assoc, mul_left_comm, mul_comm] using
      (hD_int.const_mul (1 / 72 : ℝ)).add (hC_int.const_mul (2 : ℝ))
  have hfsm :
      MeasureTheory.AEStronglyMeasurable (fun mu : Cn3Torus.Edge n → ℝ =>
        (quarticCorr n (matrixOfEdge n mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
    have hquart :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
          quarticCorr n (matrixOfEdge n mu)) :=
      (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
    have hexp :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
          Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
      have harg :
          Continuous (fun mu : Cn3Torus.Edge n → ℝ =>
            (-2 * t : ℝ) * Cn3Torus.sqNormEdge n mu) :=
        (continuous_const.mul (Cn3Torus.continuous_sqNormEdge n))
      simpa [mul_assoc] using Real.continuous_exp.comp harg
    exact ((hquart.pow 2).mul hexp).aestronglyMeasurable
  have hbound :
      ∀ᵐ mu : Cn3Torus.Edge n → ℝ ∂MeasureTheory.volume,
        ‖(quarticCorr n (matrixOfEdge n mu)) ^ (2 : Nat)
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)‖ ≤ g mu := by
    refine Filter.Eventually.of_forall ?_
    intro mu
    have hquart :
        quarticCorr n (matrixOfEdge n mu) = -(1 / 12 : ℝ) * D mu + C mu := by
      simpa [D, C] using quarticCorr_matrixOfEdge_eq_diag_plus_cycle_sum n mu
    have hsq :
        (quarticCorr n (matrixOfEdge n mu)) ^ (2 : Nat)
          ≤ (1 / 72 : ℝ) * D mu ^ (2 : Nat) + 2 * C mu ^ (2 : Nat) := by
      rw [hquart]
      have haux : 2 * ((1 / 12 : ℝ) * D mu) * C mu
          ≤ ((1 / 12 : ℝ) * D mu) ^ (2 : Nat) + C mu ^ (2 : Nat) := by
        have hs : 0 ≤ (((1 / 12 : ℝ) * D mu) - C mu) ^ (2 : Nat) := by positivity
        nlinarith
      have hcross :
          -2 * ((1 / 12 : ℝ) * D mu) * C mu
            ≤ ((1 / 12 : ℝ) * D mu) ^ (2 : Nat) + C mu ^ (2 : Nat) := by
        have hs : 0 ≤ (((1 / 12 : ℝ) * D mu) + C mu) ^ (2 : Nat) := by positivity
        nlinarith
      calc
        (-(1 / 12 : ℝ) * D mu + C mu) ^ (2 : Nat)
          = ((1 / 12 : ℝ) * D mu) ^ (2 : Nat)
              - 2 * ((1 / 12 : ℝ) * D mu) * C mu
              + C mu ^ (2 : Nat) := by ring
        _ ≤ ((1 / 12 : ℝ) * D mu) ^ (2 : Nat)
              + (((1 / 12 : ℝ) * D mu) ^ (2 : Nat) + C mu ^ (2 : Nat))
              + C mu ^ (2 : Nat) := by
                nlinarith [hcross]
        _ = (1 / 72 : ℝ) * D mu ^ (2 : Nat) + 2 * C mu ^ (2 : Nat) := by
              ring
    have hexp_nonneg : 0 ≤ Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by positivity
    have hmul := mul_le_mul_of_nonneg_right hsq hexp_nonneg
    have hf_nonneg :
        0 ≤ (quarticCorr n (matrixOfEdge n mu)) ^ (2 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
      positivity
    simpa [g, Real.norm_eq_abs, abs_of_nonneg hf_nonneg, mul_add, add_mul, mul_assoc,
      mul_left_comm, mul_comm] using hmul
  exact MeasureTheory.Integrable.mono' hg_int hfsm hbound

private lemma quarticCorr_sq_full_gaussian_bound
    (n : ℕ) (t : ℝ) (ht : 1 ≤ t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (quarticCorr n (matrixOfEdge n mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ ((((1 / 72 : ℝ) + 96) * gaussianEvenMomentEnvelope 4 ^ 4)
            * (dim n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat))
          * gaussianF (dim n) t := by
  let D : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu => ∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat)
  let C : (Cn3Torus.Edge n → ℝ) → ℝ :=
    fun mu => Finset.sum (simpleCycle4Indices n) (fun ξ => quarticCycleMonomialOn mu ξ)
  let fD : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    D mu ^ (2 : Nat) * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  let fC : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    C mu ^ (2 : Nat) * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (1 / 72 : ℝ) * fD mu + 2 * fC mu
  have ht_pos : 0 < t := by linarith
  have hf_int := quarticCorr_sq_gaussian_integrable (n := n) t ht_pos
  have hD_int : MeasureTheory.Integrable fD := by
    simpa [fD, D] using quarticDiagonal_sum_sq_integrable t ht_pos
  have hC_int : MeasureTheory.Integrable fC := by
    simpa [fC, C] using quarticCycle_sum_sq_integrable t ht_pos
  have hg_int : MeasureTheory.Integrable g := by
    simpa [g, add_comm, add_left_comm, add_assoc, mul_assoc, mul_left_comm, mul_comm] using
      (hD_int.const_mul (1 / 72 : ℝ)).add (hC_int.const_mul (2 : ℝ))
  have hpoint :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        (quarticCorr n (matrixOfEdge n mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        ≤ g mu := by
    intro mu
    have hquart :
        quarticCorr n (matrixOfEdge n mu) = -(1 / 12 : ℝ) * D mu + C mu := by
      simpa [D, C] using quarticCorr_matrixOfEdge_eq_diag_plus_cycle_sum n mu
    have hsq :
        (quarticCorr n (matrixOfEdge n mu)) ^ (2 : Nat)
          ≤ (1 / 72 : ℝ) * D mu ^ (2 : Nat) + 2 * C mu ^ (2 : Nat) := by
      rw [hquart]
      have haux : 2 * ((1 / 12 : ℝ) * D mu) * C mu
          ≤ ((1 / 12 : ℝ) * D mu) ^ (2 : Nat) + C mu ^ (2 : Nat) := by
        have hs : 0 ≤ (((1 / 12 : ℝ) * D mu) - C mu) ^ (2 : Nat) := by positivity
        nlinarith
      have hcross :
          -2 * ((1 / 12 : ℝ) * D mu) * C mu
            ≤ ((1 / 12 : ℝ) * D mu) ^ (2 : Nat) + C mu ^ (2 : Nat) := by
        have hs : 0 ≤ (((1 / 12 : ℝ) * D mu) + C mu) ^ (2 : Nat) := by positivity
        nlinarith
      calc
        (-(1 / 12 : ℝ) * D mu + C mu) ^ (2 : Nat)
          = ((1 / 12 : ℝ) * D mu) ^ (2 : Nat)
              - 2 * ((1 / 12 : ℝ) * D mu) * C mu
              + C mu ^ (2 : Nat) := by ring
        _ ≤ ((1 / 12 : ℝ) * D mu) ^ (2 : Nat)
              + (((1 / 12 : ℝ) * D mu) ^ (2 : Nat) + C mu ^ (2 : Nat))
              + C mu ^ (2 : Nat) := by
                nlinarith [hcross]
        _ = (1 / 72 : ℝ) * D mu ^ (2 : Nat) + 2 * C mu ^ (2 : Nat) := by
              ring
    have hexp_nonneg : 0 ≤ Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by positivity
    have hmul := mul_le_mul_of_nonneg_right hsq hexp_nonneg
    simpa [g, fD, fC, mul_add, add_mul, mul_assoc, mul_left_comm, mul_comm] using hmul
  have hmono :
      ∫ mu : Cn3Torus.Edge n → ℝ,
          (quarticCorr n (matrixOfEdge n mu)) ^ (2 : Nat)
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        ≤ ∫ mu : Cn3Torus.Edge n → ℝ, g mu := by
    exact MeasureTheory.integral_mono_ae hf_int hg_int (Filter.Eventually.of_forall hpoint)
  have hD_bound := quarticDiagonal_sum_sq_full_gaussian_bound n t ht
  have hC_bound := quarticCycle_sum_sq_full_gaussian_bound n t ht
  have hg_eval :
      ∫ mu : Cn3Torus.Edge n → ℝ, g mu
        = (∫ mu : Cn3Torus.Edge n → ℝ, fD mu) * (1 / 72 : ℝ)
          + (∫ mu : Cn3Torus.Edge n → ℝ, fC mu) * 2 := by
    have hDconst :
        ∫ mu : Cn3Torus.Edge n → ℝ,
            (1 / 72 : ℝ) * fD mu
          = (∫ mu : Cn3Torus.Edge n → ℝ, fD mu) * (1 / 72 : ℝ) := by
      rw [MeasureTheory.integral_const_mul]
      ring
    have hCconst :
        ∫ mu : Cn3Torus.Edge n → ℝ,
            2 * fC mu
          = (∫ mu : Cn3Torus.Edge n → ℝ, fC mu) * 2 := by
      rw [MeasureTheory.integral_const_mul]
      ring
    calc
      ∫ mu : Cn3Torus.Edge n → ℝ, g mu
        = ∫ mu : Cn3Torus.Edge n → ℝ, (1 / 72 : ℝ) * fD mu + 2 * fC mu := by rfl
      _ = (∫ mu : Cn3Torus.Edge n → ℝ,
              (1 / 72 : ℝ) * fD mu)
            + ∫ mu : Cn3Torus.Edge n → ℝ,
                2 * fC mu := by
              simpa using
                (MeasureTheory.integral_add
                  (hD_int.const_mul (1 / 72 : ℝ))
                  (hC_int.const_mul (2 : ℝ)))
      _ = (∫ mu : Cn3Torus.Edge n → ℝ, fD mu) * (1 / 72 : ℝ)
          + (∫ mu : Cn3Torus.Edge n → ℝ, fC mu) * 2 := by
              rw [hDconst, hCconst]
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (quarticCorr n (matrixOfEdge n mu)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ ∫ mu : Cn3Torus.Edge n → ℝ, g mu := hmono
    _ = (∫ mu : Cn3Torus.Edge n → ℝ, fD mu) * (1 / 72 : ℝ)
        + (∫ mu : Cn3Torus.Edge n → ℝ, fC mu) * 2 := hg_eval
    _ = (((1 / 72 : ℝ) *
          ∫ mu : Cn3Torus.Edge n → ℝ, fD mu)
        + (2 *
          ∫ mu : Cn3Torus.Edge n → ℝ, fC mu)) := by
          show
            ((∫ mu : Cn3Torus.Edge n → ℝ, fD mu) * (1 / 72 : ℝ)
                + (∫ mu : Cn3Torus.Edge n → ℝ, fC mu) * 2)
              =
            (((1 / 72 : ℝ) * ∫ mu : Cn3Torus.Edge n → ℝ, fD mu)
                + (2 * ∫ mu : Cn3Torus.Edge n → ℝ, fC mu))
          rw [mul_comm (∫ mu : Cn3Torus.Edge n → ℝ, fD mu) (1 / 72 : ℝ)]
          rw [mul_comm (∫ mu : Cn3Torus.Edge n → ℝ, fC mu) 2]
    _ ≤ (((1 / 72 : ℝ) *
          (((gaussianEvenMomentEnvelope 4 ^ 4) * (dim n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat))
            * gaussianF (dim n) t))
        + (2 *
          (((48 * gaussianEvenMomentEnvelope 4 ^ 4) * (dim n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat))
            * gaussianF (dim n) t))) := by
