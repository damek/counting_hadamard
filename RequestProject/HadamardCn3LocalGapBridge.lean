private lemma mem_quarticActiveVertexSetsUpToEight_card_le_eight {n : ℕ}
    {A : Finset (Fin n)} (hA : A ∈ quarticActiveVertexSetsUpToEight n) :
    A.card ≤ 8 := by
  rw [quarticActiveVertexSetsUpToEight, Finset.mem_biUnion] at hA
  rcases hA with ⟨k, hk, hAk⟩
  have hklt : k < 9 := Finset.mem_range.mp hk
  have hcard : A.card = k := (Finset.mem_powersetCard.mp hAk).2
  omega

private lemma quarticActiveVertexSetsUpToEight_card_le_n_eight
    (n : ℕ) (hn : 1 ≤ n) :
    ((quarticActiveVertexSetsUpToEight n).card : ℝ) ≤ 9 * (n : ℝ) ^ (8 : Nat) := by
  have hbi_nat :
      (quarticActiveVertexSetsUpToEight n).card
        ≤ Finset.sum (Finset.range 9)
            (fun k => (Finset.powersetCard k (Finset.univ : Finset (Fin n))).card) := by
    simpa [quarticActiveVertexSetsUpToEight] using
      (Finset.card_biUnion_le
        (s := Finset.range 9)
        (t := fun k => Finset.powersetCard k (Finset.univ : Finset (Fin n))))
  have hbi :
      ((quarticActiveVertexSetsUpToEight n).card : ℝ)
        ≤ Finset.sum (Finset.range 9)
            (fun k => ((Finset.powersetCard k (Finset.univ : Finset (Fin n))).card : ℝ)) := by
    exact_mod_cast hbi_nat
  calc
    ((quarticActiveVertexSetsUpToEight n).card : ℝ)
      ≤ Finset.sum (Finset.range 9)
          (fun k => ((Finset.powersetCard k (Finset.univ : Finset (Fin n))).card : ℝ)) := hbi
    _ ≤ Finset.sum (Finset.range 9) (fun _k => (n : ℝ) ^ (8 : Nat)) := by
          refine Finset.sum_le_sum ?_
          intro k hk
          have hk8 : k ≤ 8 := by
            exact Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
          have hchoose :
              ((Finset.powersetCard k (Finset.univ : Finset (Fin n))).card : ℝ) ≤ (n : ℝ) ^ k := by
            rw [Finset.card_powersetCard]
            simpa using
              (show (((Finset.univ : Finset (Fin n)).card).choose k : ℝ) ≤ (n : ℝ) ^ k by
                simpa using
                  (show ((n.choose k : Nat) : ℝ) ≤ (n : ℝ) ^ k by
                    exact_mod_cast (Nat.choose_le_pow n k)))
          have hpow : (n : ℝ) ^ k ≤ (n : ℝ) ^ (8 : Nat) := by
            exact_mod_cast (Nat.pow_le_pow_right hn hk8)
          exact le_trans hchoose hpow
    _ = 9 * (n : ℝ) ^ (8 : Nat) := by
          rw [Finset.sum_const, nsmul_eq_mul]
          norm_num

private lemma quarticEvenQuadruples_card_le_n_eight
    (n : ℕ) (hn : 1 ≤ n) :
    ((quarticEvenQuadruples n).card : ℝ)
      ≤ (9 * ((((8 : ℝ) ^ (4 : Nat)) * 3) ^ (4 : Nat))) * (n : ℝ) ^ (8 : Nat) := by
  have hbi_nat :
      ((quarticActiveVertexSetsUpToEight n).biUnion (quarticEvenQuadrupleFiber n)).card
        ≤ Finset.sum (quarticActiveVertexSetsUpToEight n)
            (fun A => (quarticEvenQuadrupleFiber n A).card) := by
    simpa using
      (Finset.card_biUnion_le
        (s := quarticActiveVertexSetsUpToEight n)
        (t := quarticEvenQuadrupleFiber n))
  have hbi :
      (((quarticActiveVertexSetsUpToEight n).biUnion (quarticEvenQuadrupleFiber n)).card : ℝ)
        ≤ Finset.sum (quarticActiveVertexSetsUpToEight n)
            (fun A => ((quarticEvenQuadrupleFiber n A).card : ℝ)) := by
    exact_mod_cast hbi_nat
  calc
    ((quarticEvenQuadruples n).card : ℝ)
      = (((quarticActiveVertexSetsUpToEight n).biUnion (quarticEvenQuadrupleFiber n)).card : ℝ) := by
          rw [← quarticEvenQuadruples_eq_biUnion_activeFibers]
    _ ≤ Finset.sum (quarticActiveVertexSetsUpToEight n)
          (fun A => ((quarticEvenQuadrupleFiber n A).card : ℝ)) := hbi
    _ ≤ Finset.sum (quarticActiveVertexSetsUpToEight n)
          (fun _A => ((((8 : ℝ) ^ (4 : Nat)) * 3) ^ (4 : Nat))) := by
          refine Finset.sum_le_sum ?_
          intro A hA
          have hAcard : A.card ≤ 8 := mem_quarticActiveVertexSetsUpToEight_card_le_eight hA
          have hfour :
              ((Finset.powersetCard 4 A).card : ℝ) ≤ (8 : ℝ) ^ (4 : Nat) := by
            have hbase :
                ((Finset.powersetCard 4 A).card : ℝ) ≤ (A.card : ℝ) ^ (4 : Nat) := by
              rw [Finset.card_powersetCard]
              simpa using
                (show (((A.card).choose 4 : Nat) : ℝ) ≤ (A.card : ℝ) ^ (4 : Nat) by
                  exact_mod_cast (Nat.choose_le_pow A.card 4))
            have hpow : (A.card : ℝ) ^ (4 : Nat) ≤ (8 : ℝ) ^ (4 : Nat) := by
              gcongr
              exact_mod_cast hAcard
            exact le_trans hbase hpow
          calc
            ((quarticEvenQuadrupleFiber n A).card : ℝ)
              ≤ ((((Finset.powersetCard 4 A).card : ℝ) * 3) ^ (4 : Nat)) :=
                quarticEvenQuadrupleFiber_card_le_fourSetChoices A
            _ ≤ ((((8 : ℝ) ^ (4 : Nat)) * 3) ^ (4 : Nat)) := by
                  have hmul :
                      (((Finset.powersetCard 4 A).card : ℝ) * 3)
                        ≤ (((8 : ℝ) ^ (4 : Nat)) * 3) := by
                    exact mul_le_mul_of_nonneg_right hfour (by positivity)
                  exact pow_le_pow_left₀ (by positivity) hmul 4
    _ = ((quarticActiveVertexSetsUpToEight n).card : ℝ)
          * ((((8 : ℝ) ^ (4 : Nat)) * 3) ^ (4 : Nat)) := by
            rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ (9 * (n : ℝ) ^ (8 : Nat)) * ((((8 : ℝ) ^ (4 : Nat)) * 3) ^ (4 : Nat)) := by
          refine mul_le_mul_of_nonneg_right (quarticActiveVertexSetsUpToEight_card_le_n_eight n hn) ?_
          positivity
    _ = (9 * ((((8 : ℝ) ^ (4 : Nat)) * 3) ^ (4 : Nat))) * (n : ℝ) ^ (8 : Nat) := by
          ring

private lemma quarticEvenQuadruples_card_le_dim_fourth (n : ℕ) :
    ((quarticEvenQuadruples n).card : ℝ)
      ≤ ((2304 : ℝ) * ((((8 : ℝ) ^ (4 : Nat)) * 3) ^ (4 : Nat))) * (dim n : ℝ) ^ (4 : Nat) := by
  by_cases hn2 : n < 2
  · have hcard_zero : (quarticEvenQuadruples n).card = 0 := by
      cases n with
      | zero =>
          have hs0 : simpleCycle4Indices 0 = ∅ := by
            simp [simpleCycle4Indices, IsSimpleCycle4Index]
          simp [quarticEvenQuadruples, QuarticCycleChoice, QuarticCycleQuadruple, hs0]
      | succ n =>
          cases n with
          | zero =>
              have hs1 : simpleCycle4Indices 1 = ∅ := by
                simp [simpleCycle4Indices, IsSimpleCycle4Index]
              simp [quarticEvenQuadruples, QuarticCycleChoice, QuarticCycleQuadruple, hs1]
          | succ n =>
              omega
    have hnonneg :
        0 ≤ ((2304 : ℝ) * ((((8 : ℝ) ^ (4 : Nat)) * 3) ^ (4 : Nat))) * (dim n : ℝ) ^ (4 : Nat) := by
      positivity
    simpa [hcard_zero] using hnonneg
  · have hn_ge_two : 2 ≤ n := by omega
    have hn_ge_one : 1 ≤ n := by omega
    have hcount := quarticEvenQuadruples_card_le_n_eight n hn_ge_one
    have hn_sq : (n : ℝ) ^ (2 : Nat) ≤ 4 * (dim n : ℝ) := n_sq_le_four_mul_dim hn_ge_two
    have hn_pow :
        (n : ℝ) ^ (8 : Nat) ≤ (4 * (dim n : ℝ)) ^ (4 : Nat) := by
      calc
        (n : ℝ) ^ (8 : Nat) = ((n : ℝ) ^ (2 : Nat)) ^ (4 : Nat) := by ring
        _ ≤ (4 * (dim n : ℝ)) ^ (4 : Nat) := by
              gcongr
    calc
      ((quarticEvenQuadruples n).card : ℝ)
        ≤ (9 * ((((8 : ℝ) ^ (4 : Nat)) * 3) ^ (4 : Nat))) * (n : ℝ) ^ (8 : Nat) := hcount
      _ ≤ (9 * ((((8 : ℝ) ^ (4 : Nat)) * 3) ^ (4 : Nat))) * (4 * (dim n : ℝ)) ^ (4 : Nat) := by
            gcongr
      _ = ((2304 : ℝ) * ((((8 : ℝ) ^ (4 : Nat)) * 3) ^ (4 : Nat))) * (dim n : ℝ) ^ (4 : Nat) := by
            ring

private lemma quarticChoiceQuadruple_integrable {n : ℕ}
    (q : QuarticCycleQuadruple n) (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      quarticChoiceMonomial (quarticQuad1 q) mu
        * quarticChoiceMonomial (quarticQuad2 q) mu
        * quarticChoiceMonomial (quarticQuad3 q) mu
        * quarticChoiceMonomial (quarticQuad4 q) mu
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  simpa [quarticChoiceMonomial] using
    quarticCycleQuadruple_integrable
      (quarticQuad1 q).1 (quarticQuad2 q).1 (quarticQuad3 q).1 (quarticQuad4 q).1
      (quarticChoice_valid (quarticQuad1 q)) (quarticChoice_valid (quarticQuad2 q))
      (quarticChoice_valid (quarticQuad3 q)) (quarticChoice_valid (quarticQuad4 q))
      t ht

private lemma quarticChoiceQuadruple_gaussian_zero_of_not_even {n : ℕ}
    (q : QuarticCycleQuadruple n) (t : ℝ) (hnot : ¬ quarticQuadrupleEven q) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quarticChoiceMonomial (quarticQuad1 q) mu
          * quarticChoiceMonomial (quarticQuad2 q) mu
          * quarticChoiceMonomial (quarticQuad3 q) mu
          * quarticChoiceMonomial (quarticQuad4 q) mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = 0 := by
  classical
  have hodd :
      ∃ e : Cn3Torus.Edge n, Odd (quarticQuadrupleMultiplicity q e) := by
    by_contra hno
    apply hnot
    intro e
    rcases Nat.even_or_odd (quarticQuadrupleMultiplicity q e) with he | ho
    · exact he
    · exact False.elim (hno ⟨e, ho⟩)
  simpa [quarticChoiceMonomial, quarticQuadrupleMultiplicity] using
    quarticCycleQuadruple_gaussian_zero_of_exists_odd
      (quarticQuad1 q).1 (quarticQuad2 q).1 (quarticQuad3 q).1 (quarticQuad4 q).1
      (quarticChoice_valid (quarticQuad1 q)) (quarticChoice_valid (quarticQuad2 q))
      (quarticChoice_valid (quarticQuad3 q)) (quarticChoice_valid (quarticQuad4 q))
      t hodd

private lemma quarticChoiceQuadruple_gaussian_bound_of_even {n : ℕ}
    (q : QuarticCycleQuadruple n) (t : ℝ) (ht : 1 ≤ t)
    (heven : quarticQuadrupleEven q) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quarticChoiceMonomial (quarticQuad1 q) mu
          * quarticChoiceMonomial (quarticQuad2 q) mu
          * quarticChoiceMonomial (quarticQuad3 q) mu
          * quarticChoiceMonomial (quarticQuad4 q) mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ (gaussianEvenMomentEnvelope 8 ^ 8 / t ^ (8 : Nat)) * gaussianF (dim n) t := by
  simpa [quarticChoiceMonomial, quarticQuadrupleMultiplicity] using
    quarticCycleQuadruple_gaussian_bound_of_even
      (quarticQuad1 q).1 (quarticQuad2 q).1 (quarticQuad3 q).1 (quarticQuad4 q).1
      (quarticChoice_valid (quarticQuad1 q)) (quarticChoice_valid (quarticQuad2 q))
      (quarticChoice_valid (quarticQuad3 q)) (quarticChoice_valid (quarticQuad4 q))
      t ht heven

private lemma sum_quarticCycleShapes {n : ℕ}
    (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ)
    (mu : Cn3Torus.Edge n → ℝ) :
    (∑ s : QuarticCycleShape, quarticCycleMonomial σ hσ s mu)
      = quarticCycleMonomial σ hσ .first mu
          + quarticCycleMonomial σ hσ .second mu
          + quarticCycleMonomial σ hσ .third mu := by
  classical
  rw [show (Finset.univ : Finset QuarticCycleShape) =
      ({QuarticCycleShape.first, QuarticCycleShape.second, QuarticCycleShape.third} :
        Finset QuarticCycleShape) by
        exact quarticCycleShape_univ]
  simp [quarticCycleMonomial, add_assoc, add_left_comm, add_comm]

private lemma simpleCycle4_matrixOfEdge_eq_raw_cycle_sum
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    simpleCycle4 n (matrixOfEdge n mu)
      = ∑ σ : SimpleCycle4Index n,
          if hs : IsSimpleCycle4Index σ then
            ∑ s : QuarticCycleShape, quarticCycleMonomial σ hs s mu
          else 0 := by
  classical
  unfold simpleCycle4
  rw [Fintype.sum_prod_type]
  refine Finset.sum_congr rfl ?_
  intro i hi
  rw [Fintype.sum_prod_type]
  refine Finset.sum_congr rfl ?_
  intro j hj
  rw [Fintype.sum_prod_type]
  refine Finset.sum_congr rfl ?_
  intro k hk
  refine Finset.sum_congr rfl ?_
  intro l hl
  let σ : SimpleCycle4Index n := (i, (j, (k, l)))
  by_cases hs : IsSimpleCycle4Index σ
  · have hij : i < j := hs.1
    have hjk : j < k := hs.2.1
    have hkl : k < l := hs.2.2
    have hik : i < k := lt_trans hij hjk
    have hil : i < l := lt_trans hik hkl
    have hjl : j < l := lt_trans hjk hkl
    have hsum := (sum_quarticCycleShapes σ hs mu).symm
    simp [σ, hs, quarticCycleMonomial, matrixOfEdge, hij, hjk, hkl, hik, hil, hjl] at hsum ⊢
    ring_nf at hsum ⊢
    exact hsum
  · have hnot : ¬ (i < j ∧ j < k ∧ k < l) := by
        simpa [σ, IsSimpleCycle4Index] using hs
    simp [σ, quarticCycleMonomial, hs, hnot]

private lemma simpleCycle4_matrixOfEdge_eq_sum_cycleIndices
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    simpleCycle4 n (matrixOfEdge n mu)
      = Finset.sum (simpleCycle4Indices n) (fun ξ => quarticCycleMonomialOn mu ξ) := by
  classical
  calc
    simpleCycle4 n (matrixOfEdge n mu)
      = ∑ σ : SimpleCycle4Index n,
          if hσ : IsSimpleCycle4Index σ then
            ∑ s : QuarticCycleShape, quarticCycleMonomial σ hσ s mu
          else 0 := simpleCycle4_matrixOfEdge_eq_raw_cycle_sum n mu
    _ = ∑ σ : SimpleCycle4Index n,
          ∑ s : QuarticCycleShape,
            if hσ : IsSimpleCycle4Index σ then quarticCycleMonomial σ hσ s mu else 0 := by
          refine Finset.sum_congr rfl ?_
          intro σ hσuniv
          by_cases hs : IsSimpleCycle4Index σ <;> simp [hs]
    _ = ∑ ξ : SimpleCycle4Index n × QuarticCycleShape,
          if hσ : IsSimpleCycle4Index ξ.1 then quarticCycleMonomial ξ.1 hσ ξ.2 mu else 0 := by
          simpa using
            (Fintype.sum_prod_type
              (fun ξ : SimpleCycle4Index n × QuarticCycleShape =>
                if hσ : IsSimpleCycle4Index ξ.1 then quarticCycleMonomial ξ.1 hσ ξ.2 mu else 0)).symm
    _ = Finset.sum (simpleCycle4Indices n) (fun ξ => quarticCycleMonomialOn mu ξ) := by
          unfold simpleCycle4Indices quarticCycleMonomialOn
          rw [Finset.sum_filter]
          refine Finset.sum_congr rfl ?_
          intro ξ hξ
          by_cases hs : IsSimpleCycle4Index ξ.1 <;> simp [hs]

private lemma quarticDiagonal_matrixOfEdge_eq_sum_edges_fourth
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    (∑ i : Fin n, ∑ j : Fin n, if i < j then (matrixOfEdge n mu i j) ^ (4 : Nat) else 0)
      = ∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat) := by
  classical
  let pairs : Finset (Fin n × Fin n) := Finset.univ.filter fun p : Fin n × Fin n => p.1 < p.2
  have hprod :
      (∑ i : Fin n, ∑ j : Fin n, if i < j then (matrixOfEdge n mu i j) ^ (4 : Nat) else 0)
        = ∑ p : Fin n × Fin n,
            if p.1 < p.2 then (matrixOfEdge n mu p.1 p.2) ^ (4 : Nat) else 0 := by
          simpa using
            (Fintype.sum_prod_type
              (fun p : Fin n × Fin n =>
                if p.1 < p.2 then (matrixOfEdge n mu p.1 p.2) ^ (4 : Nat) else 0)).symm
  have hfilter :
      (∑ p : Fin n × Fin n,
          if p.1 < p.2 then (matrixOfEdge n mu p.1 p.2) ^ (4 : Nat) else 0)
        = pairs.sum (fun p => (matrixOfEdge n mu p.1 p.2) ^ (4 : Nat)) := by
    unfold pairs
    rw [Finset.sum_filter]
  have hsub :
      pairs.sum (fun p => (matrixOfEdge n mu p.1 p.2) ^ (4 : Nat))
        = ∑ e : {p : Fin n × Fin n // p.1 < p.2}, (matrixOfEdge n mu e.1.1 e.1.2) ^ (4 : Nat) := by
    exact Finset.sum_subtype
      (p := fun p : Fin n × Fin n => p.1 < p.2)
      (s := pairs)
      (h := by
        intro p
        simp [pairs])
      (f := fun p : Fin n × Fin n => (matrixOfEdge n mu p.1 p.2) ^ (4 : Nat))
  have hedge :
      (∑ e : {p : Fin n × Fin n // p.1 < p.2}, (matrixOfEdge n mu e.1.1 e.1.2) ^ (4 : Nat))
        = ∑ e : Cn3Torus.Edge n, (matrixOfEdge n mu e.1.1 e.1.2) ^ (4 : Nat) := by
    rfl
  calc
    (∑ i : Fin n, ∑ j : Fin n, if i < j then (matrixOfEdge n mu i j) ^ (4 : Nat) else 0)
      = ∑ e : Cn3Torus.Edge n, (matrixOfEdge n mu e.1.1 e.1.2) ^ (4 : Nat) := by
          rw [hprod, hfilter, hsub, hedge]
    _ = ∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat) := by
          simpa [edgeLam] using congrArg
            (fun f : Cn3Torus.Edge n → ℝ => ∑ e : Cn3Torus.Edge n, f e ^ (4 : Nat))
            (edgeLam_matrixOfEdge n mu)

private lemma quarticCorr_matrixOfEdge_eq_diag_plus_cycle_sum
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    quarticCorr n (matrixOfEdge n mu)
      = -(1 / 12 : ℝ) * (∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat))
          + Finset.sum (simpleCycle4Indices n) (fun ξ => quarticCycleMonomialOn mu ξ) := by
  unfold quarticCorr orderedCycle4
  rw [simpleCycle4_matrixOfEdge_eq_sum_cycleIndices, quarticDiagonal_matrixOfEdge_eq_sum_edges_fourth]
  ring

private lemma quarticDiagonalPair_integrable {n : ℕ}
    (e e' : Cn3Torus.Edge n) (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  let m : Cn3Torus.Edge n → ℕ := edgePowMultiplicity e 4 + edgePowMultiplicity e' 4
  have hdeg : (∑ a : Cn3Torus.Edge n, m a) = 2 * 4 := by
    calc
      (∑ a : Cn3Torus.Edge n, m a)
        = ∑ a : Cn3Torus.Edge n, (edgePowMultiplicity e 4 a + edgePowMultiplicity e' 4 a) := by
              simp [m]
      _ = (∑ a : Cn3Torus.Edge n, edgePowMultiplicity e 4 a)
            + ∑ a : Cn3Torus.Edge n, edgePowMultiplicity e' 4 a := by
              rw [Finset.sum_add_distrib]
      _ = 4 + 4 := by rw [sum_edgePowMultiplicity, sum_edgePowMultiplicity]
      _ = 2 * 4 := by norm_num
  have hbase :
      MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
        coordMonomial (edgePowMultiplicity e 4 + edgePowMultiplicity e' 4) mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) :=
    edge_coordMonomial_integrable
      (edgePowMultiplicity e 4 + edgePowMultiplicity e' 4) 4 (by norm_num) hdeg t ht
  refine hbase.congr ?_
  exact Filter.Eventually.of_forall (fun mu => by
    dsimp [m]
    calc
      coordMonomial (edgePowMultiplicity e 4 + edgePowMultiplicity e' 4) mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = (coordMonomial (edgePowMultiplicity e 4) mu
            * coordMonomial (edgePowMultiplicity e' 4) mu)
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              simpa [mul_assoc] using
                congrArg
                  (fun z => z * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
                  (coordMonomial_mul (edgePowMultiplicity e 4) (edgePowMultiplicity e' 4) mu).symm
      _ = (mu e ^ (4 : Nat) * mu e' ^ (4 : Nat))
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              simp [coordMonomial_edgePowMultiplicity]
    )

private lemma quarticDiagonalPair_gaussian_bound {n : ℕ}
    (e e' : Cn3Torus.Edge n) (t : ℝ) (ht : 1 ≤ t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ (gaussianEvenMomentEnvelope 4 ^ 4 / t ^ (4 : Nat)) * gaussianF (dim n) t := by
  let m : Cn3Torus.Edge n → ℕ := edgePowMultiplicity e 4 + edgePowMultiplicity e' 4
  have hdeg : (∑ a : Cn3Torus.Edge n, m a) = 2 * 4 := by
    calc
      (∑ a : Cn3Torus.Edge n, m a)
        = ∑ a : Cn3Torus.Edge n, (edgePowMultiplicity e 4 a + edgePowMultiplicity e' 4 a) := by
              simp [m]
      _ = (∑ a : Cn3Torus.Edge n, edgePowMultiplicity e 4 a)
            + ∑ a : Cn3Torus.Edge n, edgePowMultiplicity e' 4 a := by
              rw [Finset.sum_add_distrib]
      _ = 4 + 4 := by rw [sum_edgePowMultiplicity, sum_edgePowMultiplicity]
      _ = 2 * 4 := by norm_num
  have heven : ∀ a : Cn3Torus.Edge n, Even (m a) := by
    intro a
    by_cases hee : e = e'
    · subst hee
      by_cases ha : a = e
      · subst ha
        norm_num [m, edgePowMultiplicity]
      · norm_num [m, edgePowMultiplicity, ha]
    · dsimp [m, edgePowMultiplicity]
      have hee' : e' ≠ e := by
        intro h
        exact hee h.symm
      by_cases ha : a = e
      · subst ha
        norm_num [m, edgePowMultiplicity, hee, hee']
      · by_cases ha' : a = e'
        · subst ha'
          norm_num [m, edgePowMultiplicity, ha, hee, hee']
        · norm_num [m, edgePowMultiplicity, ha, ha', hee, hee']
  have hbound := gaussian_edge_even_coordMonomial_bound m 4 hdeg heven t ht
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
            refine MeasureTheory.integral_congr_ae ?_
            exact Filter.Eventually.of_forall (fun mu => by
              dsimp [m]
              rw [← coordMonomial_edgePowMultiplicity, ← coordMonomial_edgePowMultiplicity,
                coordMonomial_mul]
              change
                coordMonomial (edgePowMultiplicity e 4 + edgePowMultiplicity e' 4) mu
                  * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
                    =
                coordMonomial (edgePowMultiplicity e 4 + edgePowMultiplicity e' 4) mu
                  * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
              rfl)
    _ ≤ (gaussianEvenMomentEnvelope 4 ^ 4 / t ^ (4 : Nat)) * gaussianF (dim n) t := hbound

private lemma quarticCycle_self_gaussian_bound {n : ℕ}
    (ξ : SimpleCycle4Index n × QuarticCycleShape)
    (hξ : IsSimpleCycle4Index ξ.1) (t : ℝ) (ht : 1 ≤ t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (quarticCycleMonomial ξ.1 hξ ξ.2 mu) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ (gaussianEvenMomentEnvelope 4 ^ 4 / t ^ (4 : Nat)) * gaussianF (dim n) t := by
  let m : Cn3Torus.Edge n → ℕ :=
    quarticCycleMultiplicity ξ.1 hξ ξ.2 + quarticCycleMultiplicity ξ.1 hξ ξ.2
  have hdeg : (∑ a : Cn3Torus.Edge n, m a) = 2 * 4 := by
    calc
      (∑ a : Cn3Torus.Edge n, m a)
        = ∑ a : Cn3Torus.Edge n,
            (quarticCycleMultiplicity ξ.1 hξ ξ.2 a + quarticCycleMultiplicity ξ.1 hξ ξ.2 a) := by
              simp [m]
      _ = (∑ a : Cn3Torus.Edge n, quarticCycleMultiplicity ξ.1 hξ ξ.2 a)
            + ∑ a : Cn3Torus.Edge n, quarticCycleMultiplicity ξ.1 hξ ξ.2 a := by
              rw [Finset.sum_add_distrib]
      _ = 4 + 4 := by
            simp [quarticCycleMultiplicity_total_degree]
      _ = 2 * 4 := by norm_num
  have heven : ∀ a : Cn3Torus.Edge n, Even (m a) := by
    intro a
    dsimp [m]
    simpa using Nat.even_add_self (quarticCycleMultiplicity ξ.1 hξ ξ.2 a)
  have hbound := gaussian_edge_even_coordMonomial_bound m 4 hdeg heven t ht
  have hEq :
      ∫ mu : Cn3Torus.Edge n → ℝ,
          (quarticCycleMonomial ξ.1 hξ ξ.2 mu) ^ (2 : Nat)
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = ∫ mu : Cn3Torus.Edge n → ℝ,
            coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
          refine MeasureTheory.integral_congr_ae ?_
          exact Filter.Eventually.of_forall (fun mu => by
            let q : Cn3Torus.Edge n → ℕ := quarticCycleMultiplicity ξ.1 hξ ξ.2
            calc
              (quarticCycleMonomial ξ.1 hξ ξ.2 mu) ^ (2 : Nat)
                  * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
                = (coordMonomial q mu * coordMonomial q mu)
                    * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
                      simp [q, pow_two, quarticCycleMonomial_eq_coordMonomial]
              _ = coordMonomial (q + q) mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
                    simpa [mul_assoc] using
                      congrArg
                        (fun z => z * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))
                        (coordMonomial_mul q q mu)
              _ = coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
                    simp [q, m])
  rw [hEq]
  exact hbound

private lemma quarticDiagonal_sum_sq_full_gaussian_bound
    (n : ℕ) (t : ℝ) (ht : 1 ≤ t) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      ≤ ((gaussianEvenMomentEnvelope 4 ^ 4) * (dim n : ℝ) ^ (2 : Nat) / t ^ (4 : Nat))
          * gaussianF (dim n) t := by
  let Dset : Finset (Cn3Torus.Edge n) := Finset.univ
  have ht_pos : 0 < t := by linarith
  have hpair_int :
      ∀ e ∈ Dset, ∀ e' ∈ Dset,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
    intro e he e' he'
    exact quarticDiagonalPair_integrable e e' t ht_pos
  have houter_int :
      ∀ e ∈ Dset,
        MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
          Finset.sum Dset (fun e' =>
            mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
              * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro e he
    exact MeasureTheory.integrable_finset_sum Dset (fun e' he' => hpair_int e he e' he')
  have hpoint :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        (∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = Finset.sum Dset (fun e =>
            Finset.sum Dset (fun e' =>
              mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
    intro mu
    rw [pow_two]
    calc
      (∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat))
          * (∑ e' : Cn3Torus.Edge n, mu e' ^ (4 : Nat))
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
        = (Finset.sum Dset (fun e =>
            Finset.sum Dset (fun e' =>
              mu e ^ (4 : Nat) * mu e' ^ (4 : Nat))))
            * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
              rw [Finset.sum_mul_sum]
      _ = Finset.sum Dset (fun e =>
            Finset.sum Dset (fun e' =>
              mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl ?_
            intro e he
            rw [Finset.sum_mul]
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        (∑ e : Cn3Torus.Edge n, mu e ^ (4 : Nat)) ^ (2 : Nat)
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          Finset.sum Dset (fun e =>
            Finset.sum Dset (fun e' =>
              mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
            refine MeasureTheory.integral_congr_ae ?_
            exact Filter.Eventually.of_forall hpoint
    _ = Finset.sum Dset (fun e =>
          Finset.sum Dset (fun e' =>
            ∫ mu : Cn3Torus.Edge n → ℝ,
              mu e ^ (4 : Nat) * mu e' ^ (4 : Nat)
                * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu))) := by
          rw [MeasureTheory.integral_finset_sum Dset houter_int]
          refine Finset.sum_congr rfl ?_
          intro e he
          rw [MeasureTheory.integral_finset_sum Dset (fun e' he' => hpair_int e he e' he')]
    _ ≤ Finset.sum Dset (fun _ =>
          Finset.sum Dset (fun _ =>
            (gaussianEvenMomentEnvelope 4 ^ 4 / t ^ (4 : Nat)) * gaussianF (dim n) t)) := by
          refine Finset.sum_le_sum ?_
          intro e he
          refine Finset.sum_le_sum ?_
          intro e' he'
