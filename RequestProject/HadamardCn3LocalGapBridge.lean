private def quarticCycleMonomial {n : ℕ}
    (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ)
    (s : QuarticCycleShape) (mu : Cn3Torus.Edge n → ℝ) : ℝ :=
  match s with
  | .first =>
      mu (quarticEdge12 σ hσ) * mu (quarticEdge23 σ hσ)
        * mu (quarticEdge34 σ hσ) * mu (quarticEdge14 σ hσ)
  | .second =>
      mu (quarticEdge12 σ hσ) * mu (quarticEdge24 σ hσ)
        * mu (quarticEdge34 σ hσ) * mu (quarticEdge13 σ hσ)
  | .third =>
      mu (quarticEdge13 σ hσ) * mu (quarticEdge23 σ hσ)
        * mu (quarticEdge24 σ hσ) * mu (quarticEdge14 σ hσ)

private def quarticCycleMonomialOn {n : ℕ}
    (mu : Cn3Torus.Edge n → ℝ) (ξ : SimpleCycle4Index n × QuarticCycleShape) : ℝ := by
  classical
  exact if hσ : IsSimpleCycle4Index ξ.1 then quarticCycleMonomial ξ.1 hσ ξ.2 mu else 0

private def quarticCycleMultiplicity {n : ℕ}
    (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) (s : QuarticCycleShape) :
    Cn3Torus.Edge n → ℕ :=
  match s with
  | .first =>
      edgePowMultiplicity (quarticEdge12 σ hσ) 1
        + edgePowMultiplicity (quarticEdge23 σ hσ) 1
        + edgePowMultiplicity (quarticEdge34 σ hσ) 1
        + edgePowMultiplicity (quarticEdge14 σ hσ) 1
  | .second =>
      edgePowMultiplicity (quarticEdge12 σ hσ) 1
        + edgePowMultiplicity (quarticEdge24 σ hσ) 1
        + edgePowMultiplicity (quarticEdge34 σ hσ) 1
        + edgePowMultiplicity (quarticEdge13 σ hσ) 1
  | .third =>
      edgePowMultiplicity (quarticEdge13 σ hσ) 1
        + edgePowMultiplicity (quarticEdge23 σ hσ) 1
        + edgePowMultiplicity (quarticEdge24 σ hσ) 1
        + edgePowMultiplicity (quarticEdge14 σ hσ) 1

private def quarticCycleSupport {n : ℕ}
    (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) (s : QuarticCycleShape) :
    Finset (Cn3Torus.Edge n) :=
  match s with
  | .first =>
      {quarticEdge12 σ hσ, quarticEdge23 σ hσ, quarticEdge34 σ hσ, quarticEdge14 σ hσ}
  | .second =>
      {quarticEdge12 σ hσ, quarticEdge24 σ hσ, quarticEdge34 σ hσ, quarticEdge13 σ hσ}
  | .third =>
      {quarticEdge13 σ hσ, quarticEdge23 σ hσ, quarticEdge24 σ hσ, quarticEdge14 σ hσ}

private lemma quarticCycleSupport_card {n : ℕ}
    (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) (s : QuarticCycleShape) :
    (quarticCycleSupport σ hσ s).card = 4 := by
  cases s
  · have h23_14 : quarticEdge23 σ hσ ≠ quarticEdge14 σ hσ := by
        intro h
        exact quarticEdge14_ne_23 σ hσ h.symm
    have h34_14 : quarticEdge34 σ hσ ≠ quarticEdge14 σ hσ := by
        intro h
        exact quarticEdge14_ne_34 σ hσ h.symm
    have h12_not :
        quarticEdge12 σ hσ ∉ ({quarticEdge23 σ hσ, quarticEdge34 σ hσ, quarticEdge14 σ hσ}
          : Finset (Cn3Torus.Edge n)) := by
      simp [quarticEdge12_ne_23, quarticEdge12_ne_34, quarticEdge12_ne_14]
    have h23_not :
        quarticEdge23 σ hσ ∉ ({quarticEdge34 σ hσ, quarticEdge14 σ hσ}
          : Finset (Cn3Torus.Edge n)) := by
      simp [quarticEdge23_ne_34, h23_14]
    have h34_not :
        quarticEdge34 σ hσ ∉ ({quarticEdge14 σ hσ} : Finset (Cn3Torus.Edge n)) := by
      simp [h34_14]
    calc
      (quarticCycleSupport σ hσ QuarticCycleShape.first).card
          = (insert (quarticEdge12 σ hσ)
              ({quarticEdge23 σ hσ, quarticEdge34 σ hσ, quarticEdge14 σ hσ}
                : Finset (Cn3Torus.Edge n))).card := by
              rfl
      _ = ({quarticEdge23 σ hσ, quarticEdge34 σ hσ, quarticEdge14 σ hσ}
            : Finset (Cn3Torus.Edge n)).card + 1 := by
              rw [Finset.card_insert_of_notMem h12_not]
      _ = (({quarticEdge34 σ hσ, quarticEdge14 σ hσ}
            : Finset (Cn3Torus.Edge n)).card + 1) + 1 := by
              rw [show ({quarticEdge23 σ hσ, quarticEdge34 σ hσ, quarticEdge14 σ hσ}
                  : Finset (Cn3Torus.Edge n))
                  = insert (quarticEdge23 σ hσ)
                      ({quarticEdge34 σ hσ, quarticEdge14 σ hσ}
                        : Finset (Cn3Torus.Edge n)) by rfl]
              rw [Finset.card_insert_of_notMem h23_not]
      _ = ((({quarticEdge14 σ hσ} : Finset (Cn3Torus.Edge n)).card + 1) + 1) + 1 := by
              rw [show ({quarticEdge34 σ hσ, quarticEdge14 σ hσ}
                  : Finset (Cn3Torus.Edge n))
                  = insert (quarticEdge34 σ hσ) ({quarticEdge14 σ hσ} : Finset (Cn3Torus.Edge n)) by rfl]
              rw [Finset.card_insert_of_notMem h34_not]
      _ = 4 := by simp
  · have h24_13 : quarticEdge24 σ hσ ≠ quarticEdge13 σ hσ := by
        intro h
        exact quarticEdge13_ne_24 σ hσ h.symm
    have h34_13 : quarticEdge34 σ hσ ≠ quarticEdge13 σ hσ := by
        intro h
        exact quarticEdge13_ne_34 σ hσ h.symm
    have h12_not :
        quarticEdge12 σ hσ ∉ ({quarticEdge24 σ hσ, quarticEdge34 σ hσ, quarticEdge13 σ hσ}
          : Finset (Cn3Torus.Edge n)) := by
      simp [quarticEdge12_ne_24, quarticEdge12_ne_34, quarticEdge12_ne_13]
    have h24_not :
        quarticEdge24 σ hσ ∉ ({quarticEdge34 σ hσ, quarticEdge13 σ hσ}
          : Finset (Cn3Torus.Edge n)) := by
      simp [quarticEdge24_ne_34, h24_13]
    have h34_not :
        quarticEdge34 σ hσ ∉ ({quarticEdge13 σ hσ} : Finset (Cn3Torus.Edge n)) := by
      simp [h34_13]
    calc
      (quarticCycleSupport σ hσ QuarticCycleShape.second).card
          = (insert (quarticEdge12 σ hσ)
              ({quarticEdge24 σ hσ, quarticEdge34 σ hσ, quarticEdge13 σ hσ}
                : Finset (Cn3Torus.Edge n))).card := by
              rfl
      _ = ({quarticEdge24 σ hσ, quarticEdge34 σ hσ, quarticEdge13 σ hσ}
            : Finset (Cn3Torus.Edge n)).card + 1 := by
              rw [Finset.card_insert_of_notMem h12_not]
      _ = (({quarticEdge34 σ hσ, quarticEdge13 σ hσ}
            : Finset (Cn3Torus.Edge n)).card + 1) + 1 := by
              rw [show ({quarticEdge24 σ hσ, quarticEdge34 σ hσ, quarticEdge13 σ hσ}
                  : Finset (Cn3Torus.Edge n))
                  = insert (quarticEdge24 σ hσ)
                      ({quarticEdge34 σ hσ, quarticEdge13 σ hσ}
                        : Finset (Cn3Torus.Edge n)) by rfl]
              rw [Finset.card_insert_of_notMem h24_not]
      _ = ((({quarticEdge13 σ hσ} : Finset (Cn3Torus.Edge n)).card + 1) + 1) + 1 := by
              rw [show ({quarticEdge34 σ hσ, quarticEdge13 σ hσ}
                  : Finset (Cn3Torus.Edge n))
                  = insert (quarticEdge34 σ hσ) ({quarticEdge13 σ hσ} : Finset (Cn3Torus.Edge n)) by rfl]
              rw [Finset.card_insert_of_notMem h34_not]
      _ = 4 := by simp
  · have h23_14 : quarticEdge23 σ hσ ≠ quarticEdge14 σ hσ := by
        intro h
        exact quarticEdge14_ne_23 σ hσ h.symm
    have h24_14 : quarticEdge24 σ hσ ≠ quarticEdge14 σ hσ := by
        intro h
        exact quarticEdge14_ne_24 σ hσ h.symm
    have h13_not :
        quarticEdge13 σ hσ ∉ ({quarticEdge23 σ hσ, quarticEdge24 σ hσ, quarticEdge14 σ hσ}
          : Finset (Cn3Torus.Edge n)) := by
      simp [quarticEdge13_ne_23, quarticEdge13_ne_24, quarticEdge13_ne_14]
    have h23_not :
        quarticEdge23 σ hσ ∉ ({quarticEdge24 σ hσ, quarticEdge14 σ hσ}
          : Finset (Cn3Torus.Edge n)) := by
      simp [quarticEdge23_ne_24, h23_14]
    have h24_not :
        quarticEdge24 σ hσ ∉ ({quarticEdge14 σ hσ} : Finset (Cn3Torus.Edge n)) := by
      simp [h24_14]
    calc
      (quarticCycleSupport σ hσ QuarticCycleShape.third).card
          = (insert (quarticEdge13 σ hσ)
              ({quarticEdge23 σ hσ, quarticEdge24 σ hσ, quarticEdge14 σ hσ}
                : Finset (Cn3Torus.Edge n))).card := by
              rfl
      _ = ({quarticEdge23 σ hσ, quarticEdge24 σ hσ, quarticEdge14 σ hσ}
            : Finset (Cn3Torus.Edge n)).card + 1 := by
              rw [Finset.card_insert_of_notMem h13_not]
      _ = (({quarticEdge24 σ hσ, quarticEdge14 σ hσ}
            : Finset (Cn3Torus.Edge n)).card + 1) + 1 := by
              rw [show ({quarticEdge23 σ hσ, quarticEdge24 σ hσ, quarticEdge14 σ hσ}
                  : Finset (Cn3Torus.Edge n))
                  = insert (quarticEdge23 σ hσ)
                      ({quarticEdge24 σ hσ, quarticEdge14 σ hσ}
                        : Finset (Cn3Torus.Edge n)) by rfl]
              rw [Finset.card_insert_of_notMem h23_not]
      _ = ((({quarticEdge14 σ hσ} : Finset (Cn3Torus.Edge n)).card + 1) + 1) + 1 := by
              rw [show ({quarticEdge24 σ hσ, quarticEdge14 σ hσ}
                  : Finset (Cn3Torus.Edge n))
                  = insert (quarticEdge24 σ hσ) ({quarticEdge14 σ hσ} : Finset (Cn3Torus.Edge n)) by rfl]
              rw [Finset.card_insert_of_notMem h24_not]
      _ = 4 := by simp

private lemma quarticCycleSupport_incident_card_eq_two {n : ℕ}
    (σ : SimpleCycle4Index n) (hσ : IsSimpleCycle4Index σ) (s : QuarticCycleShape)
    {i : Fin n} (hi : i ∈ quarticVertices σ) :
    2 ≤ ((quarticCycleSupport σ hσ s).filter (fun e => e ∈ Cn3Torus.edgesIncident n i)).card := by
  rcases (by simpa [quarticVertices] using hi) with rfl | rfl | rfl | rfl
  · cases s
    · have hsub :
          ({quarticEdge12 σ hσ, quarticEdge14 σ hσ} : Finset (Cn3Torus.Edge n)) ⊆
            (quarticCycleSupport σ hσ QuarticCycleShape.first).filter
              (fun e => e ∈ Cn3Torus.edgesIncident n (quarticV1 σ)) := by
        intro e he
        rcases (by simpa using he) with rfl | rfl
        · exact Finset.mem_filter.mpr ⟨by simp [quarticCycleSupport], Cn3Torus.edge_mem_edgesIncident_left _⟩
        · exact Finset.mem_filter.mpr ⟨by simp [quarticCycleSupport], Cn3Torus.edge_mem_edgesIncident_left _⟩
      have hcard : 2 ≤ ({quarticEdge12 σ hσ, quarticEdge14 σ hσ} : Finset (Cn3Torus.Edge n)).card := by
        simp [quarticEdge12_ne_14 σ hσ]
      exact le_trans hcard (Finset.card_le_card hsub)
    · have hsub :
          ({quarticEdge12 σ hσ, quarticEdge13 σ hσ} : Finset (Cn3Torus.Edge n)) ⊆
            (quarticCycleSupport σ hσ QuarticCycleShape.second).filter
              (fun e => e ∈ Cn3Torus.edgesIncident n (quarticV1 σ)) := by
        intro e he
        rcases (by simpa using he) with rfl | rfl
        · exact Finset.mem_filter.mpr ⟨by simp [quarticCycleSupport], Cn3Torus.edge_mem_edgesIncident_left _⟩
        · exact Finset.mem_filter.mpr ⟨by simp [quarticCycleSupport], Cn3Torus.edge_mem_edgesIncident_left _⟩
      have hcard : 2 ≤ ({quarticEdge12 σ hσ, quarticEdge13 σ hσ} : Finset (Cn3Torus.Edge n)).card := by
        simp [quarticEdge12_ne_13 σ hσ]
      exact le_trans hcard (Finset.card_le_card hsub)
    · have hsub :
          ({quarticEdge13 σ hσ, quarticEdge14 σ hσ} : Finset (Cn3Torus.Edge n)) ⊆
            (quarticCycleSupport σ hσ QuarticCycleShape.third).filter
              (fun e => e ∈ Cn3Torus.edgesIncident n (quarticV1 σ)) := by
        intro e he
        rcases (by simpa using he) with rfl | rfl
        · exact Finset.mem_filter.mpr ⟨by simp [quarticCycleSupport], Cn3Torus.edge_mem_edgesIncident_left _⟩
        · exact Finset.mem_filter.mpr ⟨by simp [quarticCycleSupport], Cn3Torus.edge_mem_edgesIncident_left _⟩
      have hcard : 2 ≤ ({quarticEdge13 σ hσ, quarticEdge14 σ hσ} : Finset (Cn3Torus.Edge n)).card := by
        simp [quarticEdge13_ne_14 σ hσ]
      exact le_trans hcard (Finset.card_le_card hsub)
  · cases s
    · have hsub :
          ({quarticEdge12 σ hσ, quarticEdge23 σ hσ} : Finset (Cn3Torus.Edge n)) ⊆
            (quarticCycleSupport σ hσ QuarticCycleShape.first).filter
              (fun e => e ∈ Cn3Torus.edgesIncident n (quarticV2 σ)) := by
        intro e he
        rcases (by simpa using he) with rfl | rfl
