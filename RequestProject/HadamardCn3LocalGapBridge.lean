private lemma quinticMomentTupleMultiplicity_eq_twoOneOneOneTuple_of_support_eq_values {n : ℕ}
    (p : EdgeQuintuple n) (d e f g : Cn3Torus.Edge n)
    (hsupp : quinticMomentTupleSupport p = ({d, e, f, g} : Finset (Cn3Torus.Edge n)))
    (hd2 : quinticMomentTupleMultiplicity p d = 2)
    (he1 : quinticMomentTupleMultiplicity p e = 1)
    (hf1 : quinticMomentTupleMultiplicity p f = 1)
    (hg1 : quinticMomentTupleMultiplicity p g = 1)
    (hde : d ≠ e) (hdf : d ≠ f) (hdg : d ≠ g)
    (hef : e ≠ f) (heg : e ≠ g) (hfg : f ≠ g) :
    quinticMomentTupleMultiplicity p
      = quinticMomentTupleMultiplicity (quinticTwoOneOneOneTuple d e f g) := by
  funext x
  by_cases hxd : x = d
  · subst x
    rw [hd2, quinticTwoOneOneOneTuple_multiplicity_d d e f g hde hdf hdg]
  · by_cases hxe : x = e
    · subst x
      rw [he1, quinticTwoOneOneOneTuple_multiplicity_e d e f g hde hef heg]
    · by_cases hxf : x = f
      · subst x
        rw [hf1, quinticTwoOneOneOneTuple_multiplicity_f d e f g hdf hef hfg]
      · by_cases hxg : x = g
        · subst x
          rw [hg1, quinticTwoOneOneOneTuple_multiplicity_g d e f g hdg heg hfg]
        · have hxnot : x ∉ quinticMomentTupleSupport p := by
            have hxnot' : x ∉ ({d, e, f, g} : Finset (Cn3Torus.Edge n)) := by
              simp [hxd, hxe, hxf, hxg]
            simpa [hsupp] using hxnot'
          have hxnotq :
              x ∉ quinticMomentTupleSupport (quinticTwoOneOneOneTuple d e f g) := by
            rw [quinticTwoOneOneOneTuple_support d e f g hde hdf hdg hef heg hfg]
            simp [hxd, hxe, hxf, hxg]
          rw [quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support p hxnot,
            quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support
              (quinticTwoOneOneOneTuple d e f g) hxnotq]

private lemma quinticTwoOneOneOneTuple_gate_one_implies_threeOneOne_gate_one {n : ℕ}
    (d e f g : Cn3Torus.Edge n)
    (hgate : quinticMomentTupleGate (quinticTwoOneOneOneTuple d e f g) = 1) :
    quinticMomentTupleGate (quinticThreeOneOneTuple e f g) = 1 := by
  rw [quinticMomentTupleGate_eq_one_iff]
  intro i
  have hi :=
    (quinticMomentTupleGate_eq_one_iff (quinticTwoOneOneOneTuple d e f g)).1 hgate i
  by_cases hd : d ∈ Cn3Torus.edgesIncident n i <;>
    by_cases he : e ∈ Cn3Torus.edgesIncident n i <;>
    by_cases hf : f ∈ Cn3Torus.edgesIncident n i <;>
    by_cases hg : g ∈ Cn3Torus.edgesIncident n i <;>
    simp [quinticTwoOneOneOneTuple, quinticThreeOneOneTuple, quinticMomentTupleMultiplicity,
      Cn3Torus.edgeNatRowSum_edgeMultiplicity5, hd, he, hf, hg,
      add_assoc, add_left_comm, add_comm] at hi ⊢
  all_goals
    first
      | exact hi
      | (simpa using hi)
      | decide
      | (norm_num at hi)
      | (rcases hi with ⟨k, hk⟩; omega)

private lemma quinticTwoOneOneOneTuple_multiplicity_eq_one_of_mem_support_ne_d {n : ℕ}
    (d e f g x : Cn3Torus.Edge n)
    (hde : d ≠ e) (hdf : d ≠ f) (hdg : d ≠ g)
    (hef : e ≠ f) (heg : e ≠ g) (hfg : f ≠ g)
    (hx : x ∈ quinticMomentTupleSupport (quinticTwoOneOneOneTuple d e f g))
    (hxd : x ≠ d) :
    quinticMomentTupleMultiplicity (quinticTwoOneOneOneTuple d e f g) x = 1 := by
  have hsupp :
      quinticMomentTupleSupport (quinticTwoOneOneOneTuple d e f g)
        = ({d, e, f, g} : Finset (Cn3Torus.Edge n)) :=
    quinticTwoOneOneOneTuple_support d e f g hde hdf hdg hef heg hfg
  have hx' : x ∈ ({d, e, f, g} : Finset (Cn3Torus.Edge n)) := by
    simpa [hsupp] using hx
  rcases (by simpa [hxd, or_assoc] using hx') with hxE | hxF | hxG
  · subst x
    exact quinticTwoOneOneOneTuple_multiplicity_e d e f g hde hef heg
  · subst x
    exact quinticTwoOneOneOneTuple_multiplicity_f d e f g hdf hef hfg
  · subst x
    exact quinticTwoOneOneOneTuple_multiplicity_g d e f g hdg heg hfg

private lemma quinticTwoOneOneOneTuple_oddEdgeSet {n : ℕ}
    (d e f g : Cn3Torus.Edge n)
    (hde : d ≠ e) (hdf : d ≠ f) (hdg : d ≠ g)
    (hef : e ≠ f) (heg : e ≠ g) (hfg : f ≠ g) :
    quinticMomentTupleOddEdgeSet (quinticTwoOneOneOneTuple d e f g)
      = ({e, f, g} : Finset (Cn3Torus.Edge n)) := by
  ext x
  rw [quinticMomentTupleOddEdgeSet]
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  by_cases hxd : x = d
  · subst x
    rw [quinticTwoOneOneOneTuple_multiplicity_d d e f g hde hdf hdg]
    simp [hde, hdf, hdg]
  · by_cases hxe : x = e
    · subst x
      rw [quinticTwoOneOneOneTuple_multiplicity_e d e f g hde hef heg]
      simp [hde]
    · by_cases hxf : x = f
      · subst x
        rw [quinticTwoOneOneOneTuple_multiplicity_f d e f g hdf hef hfg]
        simp [hdf, hef]
      · by_cases hxg : x = g
        · subst x
          rw [quinticTwoOneOneOneTuple_multiplicity_g d e f g hdg heg hfg]
          simp [hdg, heg, hfg]
        · rw [quinticTwoOneOneOneTuple_multiplicity_eq_zero_of_ne d e f g x hxd hxe hxf hxg]
          simp [hxe, hxf, hxg]

private lemma quinticThreeOneOneTuple_multiplicity_swap {n : ℕ}
    (e u v : Cn3Torus.Edge n) (heu : e ≠ u) (hev : e ≠ v) (huv : u ≠ v) :
    quinticMomentTupleMultiplicity (quinticThreeOneOneTuple e u v)
      = quinticMomentTupleMultiplicity (quinticThreeOneOneTuple e v u) := by
  apply quinticMomentTupleMultiplicity_eq_threeOneOneTuple_of_support_eq_values
    (p := quinticThreeOneOneTuple e u v) (e0 := e) (u0 := v) (v0 := u)
  · calc
      quinticMomentTupleSupport (quinticThreeOneOneTuple e u v)
        = ({e, u, v} : Finset (Cn3Torus.Edge n)) := quinticThreeOneOneTuple_support e u v heu hev huv
      _ = ({e, v, u} : Finset (Cn3Torus.Edge n)) := by simp [Finset.pair_comm]
  · exact quinticThreeOneOneTuple_multiplicity_e e u v heu hev
  · exact quinticThreeOneOneTuple_multiplicity_v e u v hev huv
  · exact quinticThreeOneOneTuple_multiplicity_u e u v heu huv
  · exact hev
  · exact heu
  · exact huv.symm

private lemma quinticThreeOneOneTuple_reorder_incidence {n : ℕ}
    (e f g : Cn3Torus.Edge n) (hef : e ≠ f) (heg : e ≠ g) (hfg : f ≠ g)
    (hgate : quinticMomentTupleGate (quinticThreeOneOneTuple e f g) = 1) :
    ∃ u v : Cn3Torus.Edge n,
      e ≠ u ∧ e ≠ v ∧ u ≠ v ∧
      quinticMomentTupleMultiplicity (quinticThreeOneOneTuple e f g)
        = quinticMomentTupleMultiplicity (quinticThreeOneOneTuple e u v) ∧
      u ∈ Cn3Torus.edgesIncident n e.1.1 ∧
      u ∉ Cn3Torus.edgesIncident n e.1.2 ∧
      v ∉ Cn3Torus.edgesIncident n e.1.1 ∧
      v ∈ Cn3Torus.edgesIncident n e.1.2 := by
  let q : EdgeQuintuple n := quinticThreeOneOneTuple e f g
  have hall :
      ∀ i : Fin n,
        Even
          ((if e ∈ Cn3Torus.edgesIncident n i then 3 else 0)
            + (if f ∈ Cn3Torus.edgesIncident n i then 1 else 0)
            + (if g ∈ Cn3Torus.edgesIncident n i then 1 else 0)) := by
    intro i
    have hi := ((quinticMomentTupleGate_eq_one_iff q).1 hgate i)
    by_cases hei : e ∈ Cn3Torus.edgesIncident n i
    · simpa [q, quinticThreeOneOneTuple, quinticMomentTupleMultiplicity,
        Cn3Torus.edgeNatRowSum_edgeMultiplicity5, hei, add_assoc, add_left_comm, add_comm] using hi
    · simpa [q, quinticThreeOneOneTuple, quinticMomentTupleMultiplicity,
        Cn3Torus.edgeNatRowSum_edgeMultiplicity5, hei, add_assoc, add_left_comm, add_comm] using hi
  have he_left : e ∈ Cn3Torus.edgesIncident n e.1.1 :=
    Cn3Torus.edge_mem_edgesIncident_left e
  have he_right : e ∈ Cn3Torus.edgesIncident n e.1.2 :=
    Cn3Torus.edge_mem_edgesIncident_right e
  have hxor_left :
      (f ∈ Cn3Torus.edgesIncident n e.1.1 ∧ g ∉ Cn3Torus.edgesIncident n e.1.1) ∨
        (f ∉ Cn3Torus.edgesIncident n e.1.1 ∧ g ∈ Cn3Torus.edgesIncident n e.1.1) :=
    even_three_one_one_xor he_left (hall e.1.1)
  have hxor_right :
      (f ∈ Cn3Torus.edgesIncident n e.1.2 ∧ g ∉ Cn3Torus.edgesIncident n e.1.2) ∨
        (f ∉ Cn3Torus.edgesIncident n e.1.2 ∧ g ∈ Cn3Torus.edgesIncident n e.1.2) :=
    even_three_one_one_xor he_right (hall e.1.2)
  rcases hxor_left with ⟨hf_left, hg_not_left⟩ | ⟨hf_not_left, hg_left⟩
  · rcases hxor_right with ⟨hf_right, hg_not_right⟩ | ⟨hf_not_right, hg_right⟩
    · have hfe : f = e := Cn3Torus.edge_eq_of_incident_both_endpoints e f hf_left hf_right
      exact (hef hfe.symm).elim
    · refine ⟨f, g, hef, heg, hfg, rfl, hf_left, hf_not_right, hg_not_left, hg_right⟩
  · rcases hxor_right with ⟨hf_right, hg_not_right⟩ | ⟨hf_not_right, hg_right⟩
    · refine ⟨g, f, heg, hef, hfg.symm, ?_, hg_left, hg_not_right, hf_not_left, hf_right⟩
      exact quinticThreeOneOneTuple_multiplicity_swap e f g hef heg hfg
    · have hge : g = e := Cn3Torus.edge_eq_of_incident_both_endpoints e g hg_left hg_right
      exact (heg hge.symm).elim

private lemma quintic_gate_support_four_multiplicity_shape_basic {n : ℕ} {p : EdgeQuintuple n}
    (hcard : (quinticMomentTupleSupport p).card = 4) :
    (∃ e ∈ quinticMomentTupleSupport p, quinticMomentTupleMultiplicity p e = 2) ∧
      ∀ e ∈ quinticMomentTupleSupport p,
        quinticMomentTupleMultiplicity p e = 1 ∨ quinticMomentTupleMultiplicity p e = 2 := by
  let S := quinticMomentTupleSupport p
  have hScard : S.card = 4 := by simpa [S] using hcard
  have hsumS : Finset.sum S (fun x => quinticMomentTupleMultiplicity p x) = 5 := by
    simpa [S] using quinticMomentTupleSupport_sum_multiplicity_eq_five p
  have hupper :
      ∀ e ∈ S, quinticMomentTupleMultiplicity p e ≤ 2 := by
    intro e he
    have hrest_ge :
        (S.erase e).card ≤ Finset.sum (S.erase e) (fun x => quinticMomentTupleMultiplicity p x) := by
      calc
        (S.erase e).card = Finset.sum (S.erase e) (fun _ => 1) := by simp
        _ ≤ Finset.sum (S.erase e) (fun x => quinticMomentTupleMultiplicity p x) := by
              refine Finset.sum_le_sum ?_
              intro x hx
              exact Nat.succ_le_of_lt ((mem_quinticMomentTupleSupport_iff p x).1 (Finset.mem_of_mem_erase hx))
    have hrest_card : (S.erase e).card = 3 := by
      have hcard' : (S.erase e).card + 1 = S.card := Finset.card_erase_add_one he
      omega
    have hsplit' :
        quinticMomentTupleMultiplicity p e
          + Finset.sum (S.erase e) (fun x => quinticMomentTupleMultiplicity p x)
            = Finset.sum S (fun x => quinticMomentTupleMultiplicity p x) := by
      simpa [add_comm, add_left_comm, add_assoc] using
        (S.sum_erase_add (fun x => quinticMomentTupleMultiplicity p x) he)
    have hsplit :
        quinticMomentTupleMultiplicity p e
          + Finset.sum (S.erase e) (fun x => quinticMomentTupleMultiplicity p x) = 5 := by
      rw [hsplit']
      exact hsumS
    have hrest_lb : 3 ≤ Finset.sum (S.erase e) (fun x => quinticMomentTupleMultiplicity p x) := by
      simpa [hrest_card] using hrest_ge
    omega
  have hvals :
      ∀ e ∈ S, quinticMomentTupleMultiplicity p e = 1 ∨ quinticMomentTupleMultiplicity p e = 2 := by
    intro e he
    have hpos : 1 ≤ quinticMomentTupleMultiplicity p e := by
      exact Nat.succ_le_of_lt ((mem_quinticMomentTupleSupport_iff p e).1 he)
    have hup : quinticMomentTupleMultiplicity p e ≤ 2 := hupper e he
    rcases lt_or_eq_of_le hup with hlt2 | h2
    · have h1 : quinticMomentTupleMultiplicity p e = 1 := by omega
      exact Or.inl h1
    · exact Or.inr h2
  have hexists :
      ∃ e ∈ S, quinticMomentTupleMultiplicity p e = 2 := by
    by_cases hex : ∃ e ∈ S, quinticMomentTupleMultiplicity p e = 2
    · exact hex
    · have hall_one : ∀ e ∈ S, quinticMomentTupleMultiplicity p e = 1 := by
        intro x hx
        have hne2 : quinticMomentTupleMultiplicity p x ≠ 2 := by
          intro hx2
          exact hex ⟨x, hx, hx2⟩
        rcases hvals x hx with h1 | h2
        · exact h1
        · exact False.elim (hne2 h2)
      have hsum4 : Finset.sum S (fun x => quinticMomentTupleMultiplicity p x) = 4 := by
        have hsum_card :
            Finset.sum S (fun x => quinticMomentTupleMultiplicity p x) = S.card * 1 := by
          simpa using (Finset.sum_const_nat (s := S) (m := 1) hall_one)
        simpa [hScard] using hsum_card
      have hfalse : False := by
        have hsumS' : 4 = 5 := by simpa [hsum4] using hsumS
        exact (Nat.succ_ne_self 4) (by simpa using hsumS'.symm)
      exact False.elim hfalse
  refine ⟨?_, ?_⟩
  · rcases hexists with ⟨e, he, h2⟩
    exact ⟨e, by simpa [S] using he, h2⟩
  · intro e he
    simpa [S] using hvals e (by simpa [S] using he)

private lemma quintic_gate_support_four_multiplicity_shape {n : ℕ} {p : EdgeQuintuple n}
    (hcard : (quinticMomentTupleSupport p).card = 4) :
    ∃ d e f g : Cn3Torus.Edge n,
      d ≠ e ∧ d ≠ f ∧ d ≠ g ∧ e ≠ f ∧ e ≠ g ∧ f ≠ g ∧
      quinticMomentTupleSupport p = ({d, e, f, g} : Finset (Cn3Torus.Edge n)) ∧
      quinticMomentTupleMultiplicity p d = 2 ∧
      quinticMomentTupleMultiplicity p e = 1 ∧
      quinticMomentTupleMultiplicity p f = 1 ∧
      quinticMomentTupleMultiplicity p g = 1 := by
  obtain ⟨a, b, c, d0, hab, hac, had, hbc, hbd, hcd, hsupp⟩ :=
    Finset.card_eq_four.mp hcard
  obtain ⟨hdbl, hhdbl_mem, hhdbl_two⟩ :=
    (quintic_gate_support_four_multiplicity_shape_basic (p := p) hcard).1
  have hvals :=
    (quintic_gate_support_four_multiplicity_shape_basic (p := p) hcard).2
  have hfinish :
      ∀ x y z w : Cn3Torus.Edge n,
        x ≠ y → x ≠ z → x ≠ w → y ≠ z → y ≠ w → z ≠ w →
        quinticMomentTupleSupport p = ({x, y, z, w} : Finset (Cn3Torus.Edge n)) →
        quinticMomentTupleMultiplicity p x = 2 →
        x ∈ quinticMomentTupleSupport p →
        y ∈ quinticMomentTupleSupport p →
        z ∈ quinticMomentTupleSupport p →
        w ∈ quinticMomentTupleSupport p →
        quinticMomentTupleMultiplicity p y = 1 ∧
          quinticMomentTupleMultiplicity p z = 1 ∧
          quinticMomentTupleMultiplicity p w = 1 := by
    intro x y z w hxy hxz hxw hyz hyw hzw hs hmx2 hxS hyS hzS hwS
    have hy_pos : 1 ≤ quinticMomentTupleMultiplicity p y := by
      exact Nat.succ_le_of_lt ((mem_quinticMomentTupleSupport_iff p y).1 hyS)
    have hz_pos : 1 ≤ quinticMomentTupleMultiplicity p z := by
      exact Nat.succ_le_of_lt ((mem_quinticMomentTupleSupport_iff p z).1 hzS)
    have hw_pos : 1 ≤ quinticMomentTupleMultiplicity p w := by
      exact Nat.succ_le_of_lt ((mem_quinticMomentTupleSupport_iff p w).1 hwS)
    have hy_le2 : quinticMomentTupleMultiplicity p y ≤ 2 := by
      rcases hvals y hyS with hy1 | hy2 <;> omega
    have hz_le2 : quinticMomentTupleMultiplicity p z ≤ 2 := by
      rcases hvals z hzS with hz1 | hz2 <;> omega
    have hw_le2 : quinticMomentTupleMultiplicity p w ≤ 2 := by
      rcases hvals w hwS with hw1 | hw2 <;> omega
    have hsum : quinticMomentTupleMultiplicity p x
        + quinticMomentTupleMultiplicity p y
        + quinticMomentTupleMultiplicity p z
        + quinticMomentTupleMultiplicity p w = 5 := by
      calc
        quinticMomentTupleMultiplicity p x
            + quinticMomentTupleMultiplicity p y
            + quinticMomentTupleMultiplicity p z
            + quinticMomentTupleMultiplicity p w
          = Finset.sum ({x, y, z, w} : Finset (Cn3Torus.Edge n))
              (fun t => quinticMomentTupleMultiplicity p t) := by
                simp [hxy, hxz, hxw, hyz, hyw, hzw, add_assoc, add_left_comm, add_comm]
        _ = Finset.sum (quinticMomentTupleSupport p)
              (fun t => quinticMomentTupleMultiplicity p t) := by
                rw [← hs]
        _ = 5 := quinticMomentTupleSupport_sum_multiplicity_eq_five p
    have hy1 : quinticMomentTupleMultiplicity p y = 1 := by
      omega
    have hz1 : quinticMomentTupleMultiplicity p z = 1 := by
      omega
    have hw1 : quinticMomentTupleMultiplicity p w = 1 := by
      omega
    exact ⟨hy1, hz1, hw1⟩
  have hcases : hdbl = a ∨ hdbl = b ∨ hdbl = c ∨ hdbl = d0 := by
    have : hdbl ∈ ({a, b, c, d0} : Finset (Cn3Torus.Edge n)) := by
      simpa [hsupp] using hhdbl_mem
    simpa [or_assoc] using this
  rcases hcases with hEq | hEq | hEq | hEq
  · subst hdbl
    have haS : a ∈ quinticMomentTupleSupport p := by simpa [hsupp]
    have hbS : b ∈ quinticMomentTupleSupport p := by simpa [hsupp, hab]
    have hcS : c ∈ quinticMomentTupleSupport p := by simpa [hsupp, hac, hbc]
    have hdS : d0 ∈ quinticMomentTupleSupport p := by
      simpa [hsupp, had, hbd, hcd]
    obtain ⟨hb1, hc1, hd1⟩ := hfinish a b c d0 hab hac had hbc hbd hcd hsupp hhdbl_two haS hbS hcS hdS
    exact ⟨a, b, c, d0, hab, hac, had, hbc, hbd, hcd, hsupp, hhdbl_two, hb1, hc1, hd1⟩
  · subst hdbl
    have hsupp' : quinticMomentTupleSupport p = ({b, a, c, d0} : Finset (Cn3Torus.Edge n)) := by
      ext t
      simp [hsupp, or_assoc, or_left_comm, or_comm]
    have hbS : b ∈ quinticMomentTupleSupport p := by simpa [hsupp']
    have haS : a ∈ quinticMomentTupleSupport p := by simpa [hsupp', hab]
    have hcS : c ∈ quinticMomentTupleSupport p := by simpa [hsupp', hbc, hac]
    have hdS : d0 ∈ quinticMomentTupleSupport p := by
      simpa [hsupp', hbd, had, hcd]
    obtain ⟨ha1, hc1, hd1⟩ := hfinish b a c d0 hab.symm hbc hbd hac had hcd hsupp' hhdbl_two hbS haS hcS hdS
    exact ⟨b, a, c, d0, hab.symm, hbc, hbd, hac, had, hcd, hsupp', hhdbl_two, ha1, hc1, hd1⟩
  · subst hdbl
    have hsupp' : quinticMomentTupleSupport p = ({c, a, b, d0} : Finset (Cn3Torus.Edge n)) := by
      ext t
      simp [hsupp, or_assoc, or_left_comm, or_comm]
    have hcS : c ∈ quinticMomentTupleSupport p := by simpa [hsupp']
    have haS : a ∈ quinticMomentTupleSupport p := by simpa [hsupp', hac]
    have hbS : b ∈ quinticMomentTupleSupport p := by simpa [hsupp', hbc, hab]
    have hdS : d0 ∈ quinticMomentTupleSupport p := by
      simpa [hsupp', hcd, had, hbd]
    obtain ⟨ha1, hb1, hd1⟩ := hfinish c a b d0 hac.symm hbc.symm hcd hab had hbd
      hsupp' hhdbl_two hcS haS hbS hdS
    exact ⟨c, a, b, d0, hac.symm, hbc.symm, hcd, hab, had, hbd, hsupp', hhdbl_two, ha1, hb1, hd1⟩
  · subst hdbl
    have hsupp' : quinticMomentTupleSupport p = ({d0, a, b, c} : Finset (Cn3Torus.Edge n)) := by
      ext t
      simp [hsupp, or_assoc, or_left_comm, or_comm]
    have hdS : d0 ∈ quinticMomentTupleSupport p := by simpa [hsupp']
    have haS : a ∈ quinticMomentTupleSupport p := by simpa [hsupp', had]
    have hbS : b ∈ quinticMomentTupleSupport p := by simpa [hsupp', hbd, hab]
    have hcS : c ∈ quinticMomentTupleSupport p := by
      simpa [hsupp', hcd, hac, hbc]
    obtain ⟨ha1, hb1, hc1⟩ := hfinish d0 a b c had.symm hbd.symm hcd.symm hab hac hbc
      hsupp' hhdbl_two hdS haS hbS hcS
    exact ⟨d0, a, b, c, had.symm, hbd.symm, hcd.symm, hab, hac, hbc,
      hsupp', hhdbl_two, ha1, hb1, hc1⟩

private lemma quinticMomentTupleMonomial_eq_coordMonomial {n : ℕ}
    (p : EdgeQuintuple n) (mu : Cn3Torus.Edge n → ℝ) :
    quinticMomentTupleMonomial p mu = coordMonomial (quinticMomentTupleMultiplicity p) mu := by
  let m0 : Cn3Torus.Edge n → ℕ := edgePowMultiplicity (p 0) 1
  let m1 : Cn3Torus.Edge n → ℕ := edgePowMultiplicity (p 1) 1
  let m2 : Cn3Torus.Edge n → ℕ := edgePowMultiplicity (p 2) 1
  let m3 : Cn3Torus.Edge n → ℕ := edgePowMultiplicity (p 3) 1
  let m4 : Cn3Torus.Edge n → ℕ := edgePowMultiplicity (p 4) 1
  have hm :
      quinticMomentTupleMultiplicity p
        = fun e => m0 e + m1 e + m2 e + m3 e + m4 e := by
    funext e
    simp [quinticMomentTupleMultiplicity, Cn3Torus.edgeMultiplicity5, m0, m1, m2, m3, m4,
      edgePowMultiplicity, add_assoc]
  calc
    quinticMomentTupleMonomial p mu
      = mu (p 0) * mu (p 1) * mu (p 2) * mu (p 3) * mu (p 4) := by
          simp [quinticMomentTupleMonomial, Fin.prod_univ_five, mul_assoc]
    _ = coordMonomial m0 mu * coordMonomial m1 mu * coordMonomial m2 mu
          * coordMonomial m3 mu * coordMonomial m4 mu := by
            simp [m0, m1, m2, m3, m4, coordMonomial_edgePowMultiplicity, mul_assoc]
    _ = coordMonomial (fun e => m0 e + m1 e + m2 e + m3 e + m4 e) mu := by
          calc
            coordMonomial m0 mu * coordMonomial m1 mu * coordMonomial m2 mu
                * coordMonomial m3 mu * coordMonomial m4 mu
              = ((((coordMonomial m0 mu * coordMonomial m1 mu)
                    * coordMonomial m2 mu) * coordMonomial m3 mu)
                    * coordMonomial m4 mu) := by ring
            _ = (((coordMonomial (fun e => m0 e + m1 e) mu)
                    * coordMonomial m2 mu) * coordMonomial m3 mu)
                    * coordMonomial m4 mu := by
                    rw [← coordMonomial_mul m0 m1 mu]
            _ = ((coordMonomial (fun e => m0 e + m1 e + m2 e) mu)
                    * coordMonomial m3 mu) * coordMonomial m4 mu := by
                    rw [← coordMonomial_mul (fun e => m0 e + m1 e) m2 mu]
            _ = (coordMonomial (fun e => m0 e + m1 e + m2 e + m3 e) mu)
                    * coordMonomial m4 mu := by
                    rw [← coordMonomial_mul (fun e => m0 e + m1 e + m2 e) m3 mu]
            _ = coordMonomial (fun e => m0 e + m1 e + m2 e + m3 e + m4 e) mu := by
                    rw [← coordMonomial_mul (fun e => m0 e + m1 e + m2 e + m3 e) m4 mu]
    _ = coordMonomial (quinticMomentTupleMultiplicity p) mu := by
          rw [hm]

private lemma quinticMomentTuple_pair_gaussian_zero_of_odd
    {n : ℕ} (p q : EdgeQuintuple n) (e : Cn3Torus.Edge n) (t : ℝ)
    (hodd :
      Odd ((quinticMomentTupleMultiplicity p + quinticMomentTupleMultiplicity q) e)) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = 0 := by
  let m : Cn3Torus.Edge n → ℕ := quinticMomentTupleMultiplicity p + quinticMomentTupleMultiplicity q
  have hmul :
      ∀ mu : Cn3Torus.Edge n → ℝ,
        quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
          = coordMonomial m mu := by
    intro mu
    dsimp [m]
    rw [quinticMomentTupleMonomial_eq_coordMonomial, quinticMomentTupleMonomial_eq_coordMonomial]
    simpa using
      (coordMonomial_mul (quinticMomentTupleMultiplicity p) (quinticMomentTupleMultiplicity q) mu)
  calc
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = ∫ mu : Cn3Torus.Edge n → ℝ,
          coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu) := by
            refine MeasureTheory.integral_congr_ae ?_
            exact Filter.Eventually.of_forall (fun mu => by
              simp [hmul mu])
    _ = 0 := gaussian_edge_coordMonomial_odd_zero e m t hodd

private lemma quintic_gate_support_five_pair_gaussian_zero_of_support_ne
    {n : ℕ} {p q : EdgeQuintuple n} (t : ℝ)
    (hp : p ∈ quinticGateSupportFiveTuples n)
    (hq : q ∈ quinticGateSupportFiveTuples n)
    (hsupp : quinticMomentTupleSupport p ≠ quinticMomentTupleSupport q) :
    ∫ mu : Cn3Torus.Edge n → ℝ,
        quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
          * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)
      = 0 := by
  rcases (mem_quinticGateSupportFiveTuples_iff p).1 hp with ⟨-, hp5⟩
  rcases (mem_quinticGateSupportFiveTuples_iff q).1 hq with ⟨-, hq5⟩
  have hex :
      ∃ e : Cn3Torus.Edge n,
        (e ∈ quinticMomentTupleSupport p ∧ e ∉ quinticMomentTupleSupport q) ∨
          (e ∈ quinticMomentTupleSupport q ∧ e ∉ quinticMomentTupleSupport p) := by
    by_contra hno
    apply hsupp
    ext e
    by_cases hep : e ∈ quinticMomentTupleSupport p <;>
      by_cases heq : e ∈ quinticMomentTupleSupport q <;> simp [hep, heq]
    · exfalso
      exact hno ⟨e, Or.inl ⟨hep, heq⟩⟩
    · exfalso
      exact hno ⟨e, Or.inr ⟨heq, hep⟩⟩
  rcases hex with ⟨e, hdiff | hdiff⟩
  · rcases hdiff with ⟨hep, heq⟩
    have hmp : quinticMomentTupleMultiplicity p e = 1 := quintic_gate_support_five_all_one hp5 e hep
    have hmq : quinticMomentTupleMultiplicity q e = 0 := by
      exact quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support q heq
    have hodd :
        Odd ((quinticMomentTupleMultiplicity p + quinticMomentTupleMultiplicity q) e) := by
      simp [hmp, hmq]
    exact quinticMomentTuple_pair_gaussian_zero_of_odd p q e t hodd
  · rcases hdiff with ⟨heq, hep⟩
    have hmq : quinticMomentTupleMultiplicity q e = 1 := quintic_gate_support_five_all_one hq5 e heq
    have hmp : quinticMomentTupleMultiplicity p e = 0 := by
      exact quinticMomentTupleMultiplicity_eq_zero_of_not_mem_support p hep
    have hodd :
        Odd ((quinticMomentTupleMultiplicity p + quinticMomentTupleMultiplicity q) e) := by
      simp [hmp, hmq, add_comm]
    exact quinticMomentTuple_pair_gaussian_zero_of_odd p q e t hodd

private lemma quinticMomentTuplePair_integrable
    {n : ℕ} (p q : EdgeQuintuple n) (t : ℝ) (ht : 0 < t) :
    MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      quinticMomentTupleMonomial p mu * quinticMomentTupleMonomial q mu
        * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) := by
  let m : Cn3Torus.Edge n → ℕ := quinticMomentTupleMultiplicity p + quinticMomentTupleMultiplicity q
  have hdeg :
      (∑ e : Cn3Torus.Edge n, m e) = 2 * 5 := by
    calc
      (∑ e : Cn3Torus.Edge n, m e)
        = (∑ e : Cn3Torus.Edge n, quinticMomentTupleMultiplicity p e)
            + ∑ e : Cn3Torus.Edge n, quinticMomentTupleMultiplicity q e := by
              simp [m, Finset.sum_add_distrib]
      _ = 5 + 5 := by
            rw [quinticMomentTupleMultiplicity_total_degree, quinticMomentTupleMultiplicity_total_degree]
      _ = 2 * 5 := by norm_num
  have hbase : MeasureTheory.Integrable (fun mu : Cn3Torus.Edge n → ℝ =>
      coordMonomial m mu * Real.exp (-2 * t * Cn3Torus.sqNormEdge n mu)) :=
    edge_coordMonomial_integrable m 5 (by norm_num) hdeg t ht
  refine hbase.congr ?_
  exact Filter.Eventually.of_forall (fun mu => by
    dsimp [m]
    rw [quinticMomentTupleMonomial_eq_coordMonomial, quinticMomentTupleMonomial_eq_coordMonomial]
    simpa using
      (coordMonomial_mul (quinticMomentTupleMultiplicity p) (quinticMomentTupleMultiplicity q) mu).symm)

private lemma momentX_five_matrixOfEdge_eq_sum_edgeQuintuples
    (n : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    momentX n (matrixOfEdge n mu) 5
      = ∑ p : EdgeQuintuple n, quinticMomentTupleMonomial p mu * quinticMomentTupleGate p := by
  rw [momentX_five_eq_edge_quintuple_sum]
  refine Finset.sum_congr rfl ?_
  intro p hp
  simp [quinticMomentTupleMonomial, quinticMomentTupleGate, edgeLam_matrixOfEdge, Fin.prod_univ_five]

private def quinticSTriangleMonomialOn {n : ℕ}
    (mu : Cn3Torus.Edge n → ℝ) (e : Cn3Torus.Edge n) (τ : TriangleTriple n) : ℝ :=
  mu e ^ (2 : Nat) * triangleMonomialOn mu τ

private inductive TriangleEdgeShape where
  | edge12
  | edge13
  | edge23
  deriving DecidableEq, Fintype

private lemma triangleEdgeShape_univ :
    (Finset.univ : Finset TriangleEdgeShape)
      = ({TriangleEdgeShape.edge12, TriangleEdgeShape.edge13, TriangleEdgeShape.edge23}
          : Finset TriangleEdgeShape) := by
  ext s
  cases s <;> simp

private lemma triangleEdgeShape_card :
    Fintype.card TriangleEdgeShape = 3 := by
  calc
    Fintype.card TriangleEdgeShape = ((Finset.univ : Finset TriangleEdgeShape).card : ℕ) := by
      simp
    _ = 3 := by
      rw [triangleEdgeShape_univ]
      simp

private def triangleEdgeOfShape {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    TriangleEdgeShape → Cn3Torus.Edge n
  | .edge12 => triangleEdge12 τ hτ
  | .edge13 => triangleEdge13 τ hτ
  | .edge23 => triangleEdge23 τ hτ

private def quinticTriangleRepeatMonomial {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape)
    (mu : Cn3Torus.Edge n → ℝ) : ℝ :=
  match s with
  | .edge12 =>
      mu (triangleEdge12 τ hτ) ^ (3 : Nat)
        * mu (triangleEdge13 τ hτ) * mu (triangleEdge23 τ hτ)
  | .edge13 =>
      mu (triangleEdge12 τ hτ)
        * mu (triangleEdge13 τ hτ) ^ (3 : Nat) * mu (triangleEdge23 τ hτ)
  | .edge23 =>
      mu (triangleEdge12 τ hτ)
        * mu (triangleEdge13 τ hτ) * mu (triangleEdge23 τ hτ) ^ (3 : Nat)

private def quinticTriangleRepeatMonomialOn {n : ℕ}
    (mu : Cn3Torus.Edge n → ℝ) (τ : TriangleTriple n) (s : TriangleEdgeShape) : ℝ := by
  classical
  exact if hτ : IsTriangleTriple τ then quinticTriangleRepeatMonomial τ hτ s mu else 0

private def triangleEdgeSet {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) : Finset (Cn3Torus.Edge n) :=
  {triangleEdge12 τ hτ, triangleEdge13 τ hτ, triangleEdge23 τ hτ}

private lemma triangleEdgeSet_card {n : ℕ} (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    (triangleEdgeSet τ hτ).card = 3 := by
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  simp [triangleEdgeSet, h12, h13, h23]

private def quinticTriangleRepeatMultiplicity {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) (s : TriangleEdgeShape) :
    Cn3Torus.Edge n → ℕ :=
  match s with
  | .edge12 =>
      edgePowMultiplicity (triangleEdge12 τ hτ) 3
        + edgePowMultiplicity (triangleEdge13 τ hτ) 1
        + edgePowMultiplicity (triangleEdge23 τ hτ) 1
  | .edge13 =>
      edgePowMultiplicity (triangleEdge12 τ hτ) 1
        + edgePowMultiplicity (triangleEdge13 τ hτ) 3
        + edgePowMultiplicity (triangleEdge23 τ hτ) 1
  | .edge23 =>
      edgePowMultiplicity (triangleEdge12 τ hτ) 1
        + edgePowMultiplicity (triangleEdge13 τ hτ) 1
        + edgePowMultiplicity (triangleEdge23 τ hτ) 3

private lemma quinticTriangleRepeatMultiplicity_edge12_self {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge12 (triangleEdge12 τ hτ) = 3 := by
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  simp [quinticTriangleRepeatMultiplicity, edgePowMultiplicity, h12, h12.symm, h13, h13.symm]

private lemma quinticTriangleRepeatMultiplicity_edge12_other13 {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge12 (triangleEdge13 τ hτ) = 1 := by
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  simp [quinticTriangleRepeatMultiplicity, edgePowMultiplicity, h12, h12.symm, h23, h23.symm]

private lemma quinticTriangleRepeatMultiplicity_edge12_other23 {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge12 (triangleEdge23 τ hτ) = 1 := by
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  simp [quinticTriangleRepeatMultiplicity, edgePowMultiplicity, h13, h13.symm, h23, h23.symm]

private lemma quinticTriangleRepeatMultiplicity_edge13_other12 {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge13 (triangleEdge12 τ hτ) = 1 := by
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h13 : triangleEdge12 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge12_ne_23 τ hτ
  simp [quinticTriangleRepeatMultiplicity, edgePowMultiplicity, h12, h12.symm, h13, h13.symm]

private lemma quinticTriangleRepeatMultiplicity_edge13_self {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
    quinticTriangleRepeatMultiplicity τ hτ TriangleEdgeShape.edge13 (triangleEdge13 τ hτ) = 3 := by
  have h12 : triangleEdge12 τ hτ ≠ triangleEdge13 τ hτ := triangleEdge12_ne_13 τ hτ
  have h23 : triangleEdge13 τ hτ ≠ triangleEdge23 τ hτ := triangleEdge13_ne_23 τ hτ
  simp [quinticTriangleRepeatMultiplicity, edgePowMultiplicity, h12, h12.symm, h23, h23.symm]

private lemma quinticTriangleRepeatMultiplicity_edge13_other23 {n : ℕ}
    (τ : TriangleTriple n) (hτ : IsTriangleTriple τ) :
