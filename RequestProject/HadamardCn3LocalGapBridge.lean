/-- Squaring the quartic bridge weight produces the manuscript `|e^u - 1|² e^{-2ts}`
integrand. -/
private lemma quartic_gap_weight_sq (n t : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    (|Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1|
        * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu)) ^ (2 : Nat)
      = |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1| ^ (2 : Nat)
          * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu) := by
  have hExp :
      Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu) *
        Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu)
        = Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu) := by
    rw [← Real.exp_add]
    congr 1
    ring
  rw [pow_two]
  calc
    (|Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1|
        * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu)) *
      (|Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1|
        * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu))
      = |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1|
          * |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1|
          * (Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu) *
              Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu)) := by
            ring
    _ = |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1|
          * |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1|
          * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu) := by
            rw [hExp]
    _ = |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1| ^ (2 : Nat)
          * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu) := by
            rw [pow_two]

/-- Removing the quintic phase costs only the size of the real quintic phase itself. -/
lemma correctedCoreIntegrand_sub_quarticCoreIntegrand_norm_le
    (n t : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    ‖correctedCoreIntegrand n t mu - quarticCoreIntegrand n t mu‖
      ≤ (4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n mu)|)
          * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
              + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
  rw [correctedCoreIntegrand_sub_quarticCoreIntegrand_norm_eq]
  have hphase :
      ‖Complex.exp ((((4 * t : ℕ) : ℂ) * (Complex.I * (quinticP5 n (matrixOfEdge n mu) : ℂ)))) - 1‖
        ≤ 4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n mu)| := by
    have h := complex_exp_mul_I_sub_one_norm_le_abs
      (((4 * t : ℕ) : ℝ) * quinticP5 n (matrixOfEdge n mu))
    simpa [abs_mul, Complex.norm_real, mul_assoc, mul_left_comm, mul_comm] using h
  have hexp_nonneg :
      0 ≤ Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
            + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
    positivity
  calc
    Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
          + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) *
        ‖Complex.exp ((((4 * t : ℕ) : ℂ) * (Complex.I * (quinticP5 n (matrixOfEdge n mu) : ℂ)))) - 1‖
      ≤ Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
            + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) *
          (4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n mu)|) := by
            simpa using mul_le_mul_of_nonneg_left hphase hexp_nonneg
    _ = (4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n mu)|)
          * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
              + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) := by
            ring_nf

/-- The real-part quintic bridge has a quadratic pointwise bound. This is the
refined replacement for the older norm-based bridge, and is the local input used
in the first-order expansion from the arXiv paper. -/
private lemma correctedCoreIntegrand_re_sub_quarticCoreIntegrand_abs_le
    (n t : ℕ) (mu : Cn3Torus.Edge n → ℝ) :
    |Complex.re (correctedCoreIntegrand n t mu)
        - Complex.re (quarticCoreIntegrand n t mu)|
      ≤ Real.exp
          (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
            + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
          * ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)
              * (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
            + (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
              * |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|) := by
  set A : ℝ :=
    Real.exp
      (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
        + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
  set x : ℝ := 4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)
  set y : ℝ := 4 * (t : ℝ) * quinticP5 n (matrixOfEdge n mu)
  have hA_nonneg : 0 ≤ A := by
    dsimp [A]
    positivity
  have hcorr :
      Complex.re (correctedCoreIntegrand n t mu) = A * Real.cos (x - y) := by
    have hcorr0 := correctedCoreIntegrand_re n t mu
    dsimp [A, x, y] at hcorr0 ⊢
    convert hcorr0 using 1 <;> ring
  have hquart :
      Complex.re (quarticCoreIntegrand n t mu) = A * Real.cos x := by
    have hquart0 := quarticCoreIntegrand_re n t mu
    dsimp [A, x] at hquart0 ⊢
    simpa using hquart0
  have hcos_sub_one_abs :
      |Real.cos y - 1| ≤ y ^ (2 : Nat) / 2 := by
    have hcos_lower : 1 - y ^ (2 : Nat) / 2 ≤ Real.cos y := by
      simpa using (Real.one_sub_sq_div_two_le_cos (x := y))
    have hnonpos : Real.cos y - 1 ≤ 0 := by
      linarith [Real.cos_le_one y]
    rw [abs_of_nonpos hnonpos]
    linarith
  have htrig :
      |Real.cos (x - y) - Real.cos x| ≤ y ^ (2 : Nat) / 2 + |x * y| := by
    have hid :
        Real.cos (x - y) - Real.cos x
          = Real.cos x * (Real.cos y - 1) + Real.sin x * Real.sin y := by
      rw [Real.cos_sub]
      ring
    calc
      |Real.cos (x - y) - Real.cos x|
        = |Real.cos x * (Real.cos y - 1) + Real.sin x * Real.sin y| := by
            rw [hid]
      _ ≤ |Real.cos x * (Real.cos y - 1)| + |Real.sin x * Real.sin y| := by
            simpa [Real.norm_eq_abs] using
              (norm_add_le (Real.cos x * (Real.cos y - 1)) (Real.sin x * Real.sin y))
      _ ≤ |Real.cos x| * |Real.cos y - 1| + |Real.sin x * Real.sin y| := by
            rw [abs_mul]
      _ ≤ 1 * (y ^ (2 : Nat) / 2) + |Real.sin x * Real.sin y| := by
            have hmul :
                |Real.cos x| * |Real.cos y - 1| ≤ 1 * (y ^ (2 : Nat) / 2) := by
              have hcx : |Real.cos x| ≤ 1 := Real.abs_cos_le_one x
              nlinarith [hcx, hcos_sub_one_abs, abs_nonneg (Real.cos x),
                abs_nonneg (Real.cos y - 1)]
            linarith
      _ ≤ y ^ (2 : Nat) / 2 + |x * y| := by
            have hsinxy : |Real.sin x * Real.sin y| ≤ |x * y| := by
              have hsx : |Real.sin x| ≤ |x| := by
                simpa using (Real.abs_sin_le_abs (x := x))
              have hsy : |Real.sin y| ≤ |y| := by
                simpa using (Real.abs_sin_le_abs (x := y))
              calc
                |Real.sin x * Real.sin y| = |Real.sin x| * |Real.sin y| := by rw [abs_mul]
                _ ≤ |x| * |y| := by
                      nlinarith [hsx, hsy, abs_nonneg (Real.sin x), abs_nonneg (Real.sin y),
                        abs_nonneg x, abs_nonneg y]
                _ = |x * y| := by simpa [abs_mul]
            nlinarith
  calc
    |Complex.re (correctedCoreIntegrand n t mu)
        - Complex.re (quarticCoreIntegrand n t mu)|
      = |A * (Real.cos (x - y) - Real.cos x)| := by
          rw [hcorr, hquart]
          ring_nf
    _ = A * |Real.cos (x - y) - Real.cos x| := by
          rw [abs_mul, abs_of_nonneg hA_nonneg]
    _ ≤ A * (y ^ (2 : Nat) / 2 + |x * y|) := by
          gcongr
    _ = A * ((8 : ℝ) * (t : ℝ) ^ (2 : Nat)
              * (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
            + (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
              * |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)|) := by
          have hy_sq :
              y ^ (2 : Nat)
                / 2
                = (8 : ℝ) * (t : ℝ) ^ (2 : Nat)
                    * (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat) := by
            dsimp [y]
            ring_nf
          have habs_xy :
              |x * y|
                = (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
                    * |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)| := by
            dsimp [x, y]
            have habs_x :
                |4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)|
                  = ((4 : ℝ) * (t : ℝ)) * |cubicT n (matrixOfEdge n mu)| := by
              rw [abs_mul, abs_mul, abs_of_nonneg (by norm_num : 0 ≤ (4 : ℝ)),
                abs_of_nonneg (by positivity : 0 ≤ (t : ℝ))]
            have habs_y :
                |4 * (t : ℝ) * quinticP5 n (matrixOfEdge n mu)|
                  = ((4 : ℝ) * (t : ℝ)) * |quinticP5 n (matrixOfEdge n mu)| := by
              rw [abs_mul, abs_mul, abs_of_nonneg (by norm_num : 0 ≤ (4 : ℝ)),
                abs_of_nonneg (by positivity : 0 ≤ (t : ℝ))]
            calc
              |(4 * (t : ℝ) * cubicT n (matrixOfEdge n mu))
                  * (4 * (t : ℝ) * quinticP5 n (matrixOfEdge n mu))|
                = |4 * (t : ℝ) * cubicT n (matrixOfEdge n mu)|
                    * |4 * (t : ℝ) * quinticP5 n (matrixOfEdge n mu)| := by
                      rw [abs_mul]
              _ = (((4 : ℝ) * (t : ℝ)) * |cubicT n (matrixOfEdge n mu)|)
                    * (((4 : ℝ) * (t : ℝ)) * |quinticP5 n (matrixOfEdge n mu)|) := by
                      rw [habs_x, habs_y]
              _ = (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
                    * (|cubicT n (matrixOfEdge n mu)| * |quinticP5 n (matrixOfEdge n mu)|) := by
                      ring_nf
              _ = (16 : ℝ) * (t : ℝ) ^ (2 : Nat)
                    * |cubicT n (matrixOfEdge n mu) * quinticP5 n (matrixOfEdge n mu)| := by
                      rw [← abs_mul]
          rw [hy_sq, habs_xy]

/-- Under the pure Gaussian core weight, removing the quintic phase from the cubic
oscillation costs only a quadratic quintic term plus the mixed cubic-quintic term. -/
private lemma correctedCore_integral_gap_le
    (n t : ℕ)
    (hbox : (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat))
    {A B : ℝ}
    (hA0 : 0 ≤ A)
    (hquintic :
      ∫ mu in edgeCoreRegion n (t : ℝ),
          (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
            * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
        ≤ A)
    (hquartic :
      ∫ mu in edgeCoreRegion n (t : ℝ),
          Real.exp (8 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
            * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
        ≤ B) :
    ∫ mu in edgeCoreRegion n (t : ℝ),
        ‖correctedCoreIntegrand n t mu - quarticCoreIntegrand n t mu‖
      ≤ ((16 * (t : ℝ) ^ (2 : Nat)) * A) ^ (1 / (2 : ℝ)) * B ^ (1 / (2 : ℝ)) := by
  let μ := MeasureTheory.volume.restrict (edgeCoreRegion n (t : ℝ))
  let h : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu
      + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) *
      ‖Complex.exp ((((4 * t : ℕ) : ℂ) * (Complex.I * (quinticP5 n (matrixOfEdge n mu) : ℂ)))) - 1‖
  let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    (4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n mu)|)
      * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu)
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu
      + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
  have hh_cont : Continuous h := by
    have hquintic : Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hquart : Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
      (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
    have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [h]
    fun_prop
  have hf_cont : Continuous f := by
    have hquintic : Continuous (fun mu : Cn3Torus.Edge n → ℝ => quinticP5 n (matrixOfEdge n mu)) :=
      (continuous_quinticP5 n).comp (continuous_matrixOfEdge n)
    have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [f]
    fun_prop
  have hg_cont : Continuous g := by
    have hquart : Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
      (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
    have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [g]
    fun_prop
  have hh_int : MeasureTheory.Integrable h μ := by
    simpa [μ, MeasureTheory.IntegrableOn] using
      (hh_cont.continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox)
  have hfg_int : MeasureTheory.Integrable (fun x => f x * g x) μ := by
    simpa [μ, MeasureTheory.IntegrableOn] using
      (((hf_cont.mul hg_cont).continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox))
  have hf_ae : MeasureTheory.AEStronglyMeasurable f μ := hf_cont.aestronglyMeasurable
  have hg_ae : MeasureTheory.AEStronglyMeasurable g μ := hg_cont.aestronglyMeasurable
  have hf_nonneg : 0 ≤ᵐ[μ] f := Filter.Eventually.of_forall (fun x => by
    dsimp [f]
    positivity)
  have hg_nonneg : 0 ≤ᵐ[μ] g := Filter.Eventually.of_forall (fun x => by
    dsimp [g]
    positivity)
  have hf_sq_int : MeasureTheory.Integrable (fun x => f x ^ (2 : Nat)) μ := by
    simpa [μ, MeasureTheory.IntegrableOn] using
      (((hf_cont.pow 2).continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox))
  have hg_sq_int : MeasureTheory.Integrable (fun x => g x ^ (2 : Nat)) μ := by
    simpa [μ, MeasureTheory.IntegrableOn] using
      (((hg_cont.pow 2).continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox))
  have hcs := cs_helper μ hf_ae hg_ae hf_nonneg hg_nonneg hf_sq_int hg_sq_int
  have hnorm_eq :
      (∫ x in edgeCoreRegion n (t : ℝ),
          ‖correctedCoreIntegrand n t x - quarticCoreIntegrand n t x‖)
        = ∫ x, h x ∂μ := by
    rw [show (∫ x in edgeCoreRegion n (t : ℝ),
          ‖correctedCoreIntegrand n t x - quarticCoreIntegrand n t x‖)
        = ∫ x, ‖correctedCoreIntegrand n t x - quarticCoreIntegrand n t x‖ ∂μ by rfl]
    refine MeasureTheory.integral_congr_ae ?_
    exact Filter.Eventually.of_forall (fun x => by
      dsimp [h]
      rw [correctedCoreIntegrand_sub_quarticCoreIntegrand_norm_eq])
  have hh_le : ∫ x, h x ∂μ ≤ ∫ x, f x * g x ∂μ := by
    exact MeasureTheory.integral_mono_ae hh_int hfg_int (Filter.Eventually.of_forall (fun x => by
      dsimp [h, f, g]
      have hphase :
          ‖Complex.exp ((((4 * t : ℕ) : ℂ) * (Complex.I * (quinticP5 n (matrixOfEdge n x) : ℂ)))) - 1‖
            ≤ 4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n x)| := by
        have h := complex_exp_mul_I_sub_one_norm_le_abs
          (((4 * t : ℕ) : ℝ) * quinticP5 n (matrixOfEdge n x))
        simpa [abs_mul, Complex.norm_real, mul_assoc, mul_left_comm, mul_comm] using h
      have hexp_nonneg :
          0 ≤ Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x
                + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) := by
        positivity
      have hExp :
          Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x
              + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x))
            = Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)
                * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x
                    + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) := by
        rw [← Real.exp_add]
        congr 1
        ring
      calc
        Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x
            + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) *
          ‖Complex.exp ((((4 * t : ℕ) : ℂ) * (Complex.I * (quinticP5 n (matrixOfEdge n x) : ℂ)))) - 1‖
          ≤ Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x
              + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) *
            (4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n x)|) := by
              exact mul_le_mul_of_nonneg_left hphase hexp_nonneg
        _ = ((4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n x)|)
              * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x))
            * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x
              + 4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) := by
              rw [hExp]
              ring))
  have hAeq :
      ∫ x, f x ^ (2 : Nat) ∂μ
        = (16 * (t : ℝ) ^ (2 : Nat)) *
            ∫ mu in edgeCoreRegion n (t : ℝ),
              (quinticP5 n (matrixOfEdge n mu)) ^ (2 : Nat)
                * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu) := by
    have hEq :
        ∫ x, f x ^ (2 : Nat) ∂μ
          = ∫ x,
              (16 * (t : ℝ) ^ (2 : Nat)) *
                ((quinticP5 n (matrixOfEdge n x)) ^ (2 : Nat)
                    * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x)) ∂μ := by
      refine MeasureTheory.integral_congr_ae ?_
      exact Filter.Eventually.of_forall (fun x => by
        dsimp [f]
        have hExp :
            Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x) *
              Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)
              = Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x) := by
          rw [← Real.exp_add]
          congr 1
          ring
        rw [pow_two]
        calc
          ((4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n x)|)
              * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)) *
            ((4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n x)|)
              * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x))
            = (4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n x)|)
                * (4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n x)|)
                * (Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)
                    * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)) := by
                    ring
          _ = (4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n x)|)
                * (4 * (t : ℝ) * |quinticP5 n (matrixOfEdge n x)|)
                * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x) := by
                  rw [hExp]
          _ = 16 * ((t : ℝ) ^ (2 : Nat)) * (|quinticP5 n (matrixOfEdge n x)| ^ (2 : Nat))
                * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x) := by
                  ring
          _ = (16 * (t : ℝ) ^ (2 : Nat)) *
                ((quinticP5 n (matrixOfEdge n x)) ^ (2 : Nat)
                    * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x)) := by
                  rw [sq_abs]
                  ring)
    rw [hEq, MeasureTheory.integral_const_mul]
  have hA : ∫ x, f x ^ (2 : Nat) ∂μ ≤ (16 * (t : ℝ) ^ (2 : Nat)) * A := by
    rw [hAeq]
    have hconst_nonneg : 0 ≤ 16 * (t : ℝ) ^ (2 : Nat) := by positivity
    exact mul_le_mul_of_nonneg_left hquintic hconst_nonneg
  have hBeq :
      ∫ x, g x ^ (2 : Nat) ∂μ
        = ∫ mu in edgeCoreRegion n (t : ℝ),
            Real.exp (8 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu))
              * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu) := by
    have hEq :
        ∫ x, g x ^ (2 : Nat) ∂μ
          = ∫ x,
              Real.exp (8 * (t : ℝ) * quarticCorr n (matrixOfEdge n x))
                * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x) ∂μ := by
      refine MeasureTheory.integral_congr_ae ?_
      exact Filter.Eventually.of_forall (fun x => by
        dsimp [g]
        rw [pow_two, ← Real.exp_add, ← Real.exp_add]
        congr 1
        ring)
    rw [hEq]
  have hB : ∫ x, g x ^ (2 : Nat) ∂μ ≤ B := by
    rw [hBeq]
    exact hquartic
  rw [hnorm_eq]
  calc
    ∫ x, h x ∂μ ≤ ∫ x, f x * g x ∂μ := hh_le
    _ ≤ (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := hcs
    _ ≤ ((16 * (t : ℝ) ^ (2 : Nat)) * A) ^ (1 / (2 : ℝ)) * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
      gcongr
    _ ≤ ((16 * (t : ℝ) ^ (2 : Nat)) * A) ^ (1 / (2 : ℝ)) * B ^ (1 / (2 : ℝ)) := by
      gcongr

/-- Bridge 3: removing the quartic correction from the repaired core costs only the
quartic `L²` error against the Gaussian scale. -/
private lemma quarticCore_integral_gap_le
    (n t : ℕ)
    (hbox : (dim n : ℝ) / (t : ℝ) ≤ Cn3Torus.delta ^ (2 : Nat))
    {c₄ C₄ : ℝ}
    (hquartic :
      (dim n : ℝ) / (t : ℝ) ≤ c₄ →
      (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ c₄ →
      ∫ mu in edgeCoreRegion n (t : ℝ),
          |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1| ^ (2 : Nat)
            * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu)
        ≤ (C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ))
    (hdim : (dim n : ℝ) / (t : ℝ) ≤ c₄)
    (hcube : (n : ℝ) * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat)) ≤ c₄) :
    ∫ mu in edgeCoreRegion n (t : ℝ),
        ‖quarticCoreIntegrand n t mu - cubicCoreIntegrand n t mu‖
      ≤ ((C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ))
            ^ (1 / (2 : ℝ))
          * (coreMass (dim n) (t : ℝ)) ^ (1 / (2 : ℝ)) := by
  let μ := MeasureTheory.volume.restrict (edgeCoreRegion n (t : ℝ))
  let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1|
      * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu)
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n mu)
  have hf_cont : Continuous f := by
    have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    have hquart :
        Continuous (fun mu : Cn3Torus.Edge n → ℝ => quarticCorr n (matrixOfEdge n mu)) :=
      (continuous_quarticCorr_local n).comp (continuous_matrixOfEdge n)
    dsimp [f]
    fun_prop
  have hg_cont : Continuous g := by
    have hsq : Continuous (fun mu : Cn3Torus.Edge n → ℝ => Cn3Torus.sqNormEdge n mu) :=
      Cn3Torus.continuous_sqNormEdge n
    dsimp [g]
    fun_prop
  have hf_ae : MeasureTheory.AEStronglyMeasurable f μ := hf_cont.aestronglyMeasurable
  have hg_ae : MeasureTheory.AEStronglyMeasurable g μ := hg_cont.aestronglyMeasurable
  have hf_nonneg : 0 ≤ᵐ[μ] f := Filter.Eventually.of_forall (fun x => by
    dsimp [f]
    positivity)
  have hg_nonneg : 0 ≤ᵐ[μ] g := Filter.Eventually.of_forall (fun x => by
    dsimp [g]
    positivity)
  have hf_sq_int : MeasureTheory.Integrable (fun x => f x ^ (2 : Nat)) μ := by
    simpa [μ, MeasureTheory.IntegrableOn] using
      (((hf_cont.pow 2).continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox))
  have hg_sq_int : MeasureTheory.Integrable (fun x => g x ^ (2 : Nat)) μ := by
    simpa [μ, MeasureTheory.IntegrableOn] using
      (((hg_cont.pow 2).continuousOn.integrableOn_compact (Cn3Torus.localBox_isCompact n)).mono_set
        (edgeCoreRegion_subset_localBox n hbox))
  have hcs := cs_helper μ hf_ae hg_ae hf_nonneg hg_nonneg hf_sq_int hg_sq_int
  have hnorm_eq :
      (∫ x in edgeCoreRegion n (t : ℝ),
          ‖quarticCoreIntegrand n t x - cubicCoreIntegrand n t x‖)
        = ∫ x, f x * g x ∂μ := by
    have hpoint : ∀ x : Cn3Torus.Edge n → ℝ,
        Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x) *
            |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) - 1|
          = f x * g x := by
      intro x
      have hExp :
          Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x)
            = Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)
                * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x) := by
        symm
        rw [← Real.exp_add]
        congr 1
        ring
      calc
        Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x) *
            |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) - 1|
          = |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) - 1|
              * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x) := by
                ring
        _ = |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) - 1|
              * (Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)
                  * Real.exp (-(t : ℝ) * Cn3Torus.sqNormEdge n x)) := by
                rw [hExp]
        _ = f x * g x := by
              simp [f, g, mul_assoc]
    have hEq :
        ∫ x,
            (Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x) *
              |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) - 1|) ∂μ
          = ∫ x, f x * g x ∂μ := by
      exact MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall hpoint)
    simpa [μ, quarticCoreIntegrand_sub_cubicCoreIntegrand_norm_eq] using hEq
  rw [hnorm_eq]
  have hAeq :
      ∫ x, f x ^ (2 : Nat) ∂μ
        = ∫ mu in edgeCoreRegion n (t : ℝ),
            |Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n mu)) - 1| ^ (2 : Nat)
              * Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu) := by
    have hEq :
        ∫ x, f x ^ (2 : Nat) ∂μ
          = ∫ x,
              (|Real.exp (4 * (t : ℝ) * quarticCorr n (matrixOfEdge n x)) - 1| ^ (2 : Nat) *
                Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x)) ∂μ := by
      exact MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun x => by
        dsimp [f]
        rw [quartic_gap_weight_sq]))
    simpa [μ] using hEq
  have hA :
      ∫ x, f x ^ (2 : Nat) ∂μ
        ≤ (C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ) := by
    rw [hAeq]
    exact hquartic hdim hcube
  have hBeq :
      ∫ x, g x ^ (2 : Nat) ∂μ
        = ∫ mu in edgeCoreRegion n (t : ℝ),
            Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n mu) := by
    have hEq :
        ∫ x, g x ^ (2 : Nat) ∂μ
          = ∫ x, Real.exp (-2 * (t : ℝ) * Cn3Torus.sqNormEdge n x) ∂μ := by
      exact MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun x => by
        dsimp [g]
        rw [pow_two, ← Real.exp_add]
        congr 1
        ring))
    simpa [μ] using hEq
  have hB : ∫ x, g x ^ (2 : Nat) ∂μ = coreMass (dim n) (t : ℝ) := by
    rw [hBeq]
    simpa using (coreMass_eq_edgeCoreRegion_gaussian_integral n (t : ℝ)).symm
  calc
    ∫ x, f x * g x ∂μ
      ≤ (∫ x, f x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ))
          * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := hcs
    _ ≤ ((C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ))
            ^ (1 / (2 : ℝ))
          * (∫ x, g x ^ (2 : Nat) ∂μ) ^ (1 / (2 : ℝ)) := by
            gcongr
    _ = ((C₄ * (((dim n : ℝ) / (t : ℝ)) ^ (2 : Nat))) * gaussianF (dim n) (t : ℝ))
            ^ (1 / (2 : ℝ))
          * (coreMass (dim n) (t : ℝ)) ^ (1 / (2 : ℝ)) := by
            rw [hB]

/-- A uniform small-ball decay bound for the edge characteristic function. -/
lemma small_ball_gaussian_decay_uniform :
    ∃ r₀ : ℝ, 0 < r₀ ∧ r₀ < π / 4 ∧
      ∀ n : ℕ, ∀ mu : Cn3Torus.Edge n → ℝ,
        Cn3Torus.sqNormEdge n mu ≤ r₀ ^ (2 : Nat) →
        ∀ t : ℕ, 1 ≤ t →
          ‖Cn3Torus.psi n mu‖ ^ (4 * t)
            ≤ Real.exp (-(3 * (t : ℝ) * Cn3Torus.sqNormEdge n mu / 2)) := by
  obtain ⟨Cq, hCq_pos, hquart⟩ := quarticCorr_pointwise_bound_uniform
  obtain ⟨c₂, C₂, hc₂_pos, hC₂_pos, hmodel⟩ := corrected_sixth_order_exp_form_edge_uniform
  let M : ℝ := Cq + C₂ + 1
  let S : ℝ := min (1 / (8 * M)) (min 1 c₂)
  let r₀ : ℝ := min (π / 8) (Real.sqrt S / 2)
  have hS_pos : 0 < S := by
    unfold S
    refine lt_min ?_ (lt_min (by norm_num) hc₂_pos)
    have hM_pos : 0 < M := by
      unfold M
      positivity
    exact one_div_pos.mpr (by positivity)
  have hr₀_pos : 0 < r₀ := by
    unfold r₀
    refine lt_min (by positivity [Real.pi_pos]) ?_
    positivity
  have hr₀_lt : r₀ < π / 4 := by
    unfold r₀
    exact lt_of_le_of_lt (min_le_left _ _) (by linarith [Real.pi_pos])
  have hr₀_sq : r₀ ^ (2 : Nat) ≤ S := by
    have h1 : r₀ ≤ Real.sqrt S / 2 := by
      unfold r₀
      exact min_le_right _ _
    have h2 : r₀ ^ (2 : Nat) ≤ (Real.sqrt S / 2) ^ (2 : Nat) := by
      exact pow_le_pow_left₀ hr₀_pos.le h1 2
    calc
      r₀ ^ (2 : Nat) ≤ (Real.sqrt S / 2) ^ (2 : Nat) := h2
      _ = S / 4 := by
            field_simp
            rw [Real.sq_sqrt hS_pos.le]
            ring
      _ ≤ S := by nlinarith [hS_pos]
  have hS_le_one : S ≤ 1 := by
    unfold S
    exact le_trans (min_le_right _ _) (min_le_left _ _)
  have hS_le_c₂ : S ≤ c₂ := by
    unfold S
    exact le_trans (min_le_right _ _) (min_le_right _ _)
  have hS_le_small : S ≤ 1 / (8 * M) := by
    unfold S
    exact min_le_left _ _
  refine ⟨r₀, hr₀_pos, hr₀_lt, ?_⟩
  intro n mu hmu t ht
  set s : ℝ := Cn3Torus.sqNormEdge n mu
  have hs_nonneg : 0 ≤ s := by
    dsimp [s]
    exact Cn3Torus.sqNormEdge_nonneg n mu
  have hs_small : s ≤ c₂ := by
    calc
      s ≤ r₀ ^ (2 : Nat) := hmu
      _ ≤ S := hr₀_sq
      _ ≤ c₂ := hS_le_c₂
  have hs_le_one : s ≤ 1 := by
    calc
      s ≤ r₀ ^ (2 : Nat) := hmu
      _ ≤ S := hr₀_sq
      _ ≤ 1 := hS_le_one
  obtain ⟨E₆, hE₆_bound, hpsi⟩ := hmodel n mu hs_small
  have hquart_abs :
      |quarticCorr n (matrixOfEdge n mu)| ≤ Cq * s ^ (2 : Nat) := by
    simpa [s, sNorm_matrixOfEdge_eq] using hquart n (matrixOfEdge n mu)
  have hquart_mu :
      quarticCorr n (matrixOfEdge n mu) ≤ Cq * s ^ (2 : Nat) := by
    exact (abs_le.mp hquart_abs).2
  have hEre :
      E₆.re ≤ C₂ * s ^ (3 : Nat) := by
    have hre_abs : |E₆.re| ≤ ‖E₆‖ := Complex.abs_re_le_norm E₆
    have hE₆_bound' : ‖E₆‖ ≤ C₂ * s ^ (3 : Nat) := by
      simpa [s] using hE₆_bound
    exact le_trans (abs_le.mp hre_abs).2 hE₆_bound'
  have hs_cube_le_sq : s ^ (3 : Nat) ≤ s ^ (2 : Nat) := by
    exact pow_le_pow_of_le_one hs_nonneg hs_le_one (by norm_num : 2 ≤ 3)
  have hmain :
      ‖Cn3Torus.psi n mu‖ ^ (4 * t)
        ≤ Real.exp
            (-2 * (t : ℝ) * s
              + 4 * (t : ℝ) * Cq * s ^ (2 : Nat)
              + 4 * (t : ℝ) * C₂ * s ^ (3 : Nat)) := by
    rw [hpsi, Complex.norm_exp]
    norm_num [s, ← Real.exp_nat_mul]
    nlinarith
  have hcoeff :
      4 * (Cq + C₂) * s ≤ 1 / 2 := by
    have hs_small' : s ≤ 1 / (8 * M) := by
      calc
        s ≤ r₀ ^ (2 : Nat) := hmu
        _ ≤ S := hr₀_sq
        _ ≤ 1 / (8 * M) := hS_le_small
    have hM_bound : (8 * M) * s ≤ 1 := by
      have hmul :
          (8 * M) * s ≤ (8 * M) * (1 / (8 * M)) := by
        refine mul_le_mul_of_nonneg_left hs_small' ?_
        unfold M
        positivity
      have hM_ne : M ≠ 0 := by
        unfold M
        linarith [hCq_pos, hC₂_pos]
      calc
        (8 * M) * s ≤ (8 * M) * (1 / (8 * M)) := hmul
        _ = 1 := by
              field_simp [hM_ne]
    have hsum_le : Cq + C₂ ≤ M := by
      unfold M
      linarith
    have hmul :
        4 * (Cq + C₂) * s ≤ 4 * M * s := by
      have := mul_le_mul_of_nonneg_right hsum_le (by positivity : 0 ≤ 4 * s)
      simpa [mul_assoc, mul_left_comm, mul_comm] using this
    have hhalf : 4 * M * s ≤ 1 / 2 := by
      have : (8 * M) * s ≤ 1 := hM_bound
      nlinarith
    exact le_trans hmul hhalf
  calc
    ‖Cn3Torus.psi n mu‖ ^ (4 * t)
      ≤ Real.exp
          (-2 * (t : ℝ) * s
            + 4 * (t : ℝ) * Cq * s ^ (2 : Nat)
            + 4 * (t : ℝ) * C₂ * s ^ (3 : Nat)) := hmain
    _ ≤ Real.exp (-2 * (t : ℝ) * s + 4 * (t : ℝ) * (Cq + C₂) * s ^ (2 : Nat)) := by
          apply Real.exp_le_exp.mpr
          have hterm :
              4 * (t : ℝ) * C₂ * s ^ (3 : Nat) ≤ 4 * (t : ℝ) * C₂ * s ^ (2 : Nat) := by
            gcongr
          nlinarith
    _ ≤ Real.exp (-(3 * (t : ℝ) * s / 2)) := by
          apply Real.exp_le_exp.mpr
          have hterm :
              4 * (t : ℝ) * (Cq + C₂) * s ^ (2 : Nat) ≤ (t : ℝ) * s / 2 := by
            have hmul :=
              mul_le_mul_of_nonneg_right hcoeff (by positivity : 0 ≤ (t : ℝ) * s)
            simpa [pow_two, div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using hmul
          nlinarith
    _ = Real.exp (-(3 * (t : ℝ) * Cn3Torus.sqNormEdge n mu / 2)) := by
          simp [s]

/-- The primary annulus contribution is uniformly exponentially small relative
to `coreMass`. -/
theorem edgePrimaryLocalAnnulus_integral_bound_coreMass_uniform :
    ∃ r₁ C₆ : ℝ, 0 < r₁ ∧ 0 < C₆ ∧ r₁ < π / 4 ∧
      ∀ n : ℕ, 1 ≤ dim n →
      ∀ {r delta : ℝ}, 0 < r → r ≤ r₁ →
      ∀ t : ℕ, 1 ≤ t →
        ∫ mu in ((edgeBox n delta ∩ edgeEuclidBall n r) \ edgeCoreRegion n (t : ℝ)),
            ‖Cn3Torus.psi n mu‖ ^ (4 * t)
          ≤ C₆ * Real.exp (-((dim n : ℝ) / 8)) * coreMass (dim n) (t : ℝ) := by
  obtain ⟨r₁, hr₁_pos, hr₁_small, hsmall⟩ := small_ball_gaussian_decay_uniform
  obtain ⟨C₆, hC₆_pos, hcore⟩ := gaussianF_le_const_mul_coreMass
  refine ⟨r₁, C₆, hr₁_pos, hC₆_pos, hr₁_small, ?_⟩
  intro n hd r delta hr_pos hr_le t ht
  let A : Set (Cn3Torus.Edge n → ℝ) :=
    ((edgeBox n delta ∩ edgeEuclidBall n r) \ edgeCoreRegion n (t : ℝ))
  let f : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu => ‖Cn3Torus.psi n mu‖ ^ (4 * t)
  let g : (Cn3Torus.Edge n → ℝ) → ℝ := fun mu =>
    Real.exp (-(↑t * Cn3Torus.sqNormEdge n mu))
  have hf_box :
      MeasureTheory.IntegrableOn f (edgeBox n delta) := by
    exact ((Cn3Torus.continuous_psi n).norm.pow (4 * t)).continuousOn.integrableOn_compact
      (edgeBox_isCompact n delta)
  have hf :
      MeasureTheory.IntegrableOn f A :=
    hf_box.mono_set (by
      intro x hx
      exact hx.1.1)
  have htR_pos : (0 : ℝ) < (t : ℝ) := by
    exact_mod_cast (Nat.succ_le_iff.mp ht)
  have hg_nonneg : ∀ mu : Cn3Torus.Edge n → ℝ, 0 ≤ g mu := by
    intro mu
    unfold g
    positivity
  have hg_int : MeasureTheory.Integrable g := by
    simpa [g] using gaussian_integrable_edge n (t : ℝ) htR_pos
  have hg :
      MeasureTheory.IntegrableOn
        (fun mu : Cn3Torus.Edge n → ℝ => Real.exp (-((dim n : ℝ) / 2)) * g mu) A := by
    exact (hg_int.const_mul (Real.exp (-((dim n : ℝ) / 2)))).integrableOn
  have hA_meas : MeasurableSet A := by
    unfold A
    exact ((edgeBox_isCompact n delta).measurableSet.inter (measurableSet_edgeEuclidBall n r)).diff
      (measurableSet_edgeCoreRegion n (t : ℝ))
  have hpoint :
      ∀ mu ∈ A, f mu ≤ Real.exp (-((dim n : ℝ) / 2)) * g mu := by
    intro mu hmu
    rcases hmu with ⟨⟨_, hball⟩, hnotcore⟩
    have hs_le_r : Cn3Torus.sqNormEdge n mu ≤ r ^ 2 :=
      (mem_edgeEuclidBall_iff n r mu).1 hball
    have hs_le_r₁ : Cn3Torus.sqNormEdge n mu ≤ r₁ ^ 2 := by
      nlinarith [hs_le_r, hr_pos, hr_le]
    have hdecay :
        ‖Cn3Torus.psi n mu‖ ^ (4 * t)
          ≤ Real.exp (-(3 * ↑t * Cn3Torus.sqNormEdge n mu / 2)) := by
      exact hsmall n mu hs_le_r₁ t ht
    have hs_gt : (dim n : ℝ) / (t : ℝ) < Cn3Torus.sqNormEdge n mu := by
      have hcore : ¬ Cn3Torus.sqNormEdge n mu ≤ (dim n : ℝ) / (t : ℝ) := by
        intro hle
        exact hnotcore ((mem_edgeCoreRegion_iff n (t : ℝ) mu).2 hle)
      exact lt_of_not_ge hcore
    have hexp :
        -(3 * ↑t * Cn3Torus.sqNormEdge n mu / 2)
          ≤ -((dim n : ℝ) / 2) - ↑t * Cn3Torus.sqNormEdge n mu := by
      have hts : (dim n : ℝ) < (t : ℝ) * Cn3Torus.sqNormEdge n mu := by
        simpa [mul_comm] using (div_lt_iff₀ htR_pos).1 hs_gt
      nlinarith
    calc
      f mu ≤ Real.exp (-(3 * ↑t * Cn3Torus.sqNormEdge n mu / 2)) := hdecay
      _ ≤ Real.exp (-((dim n : ℝ) / 2) - ↑t * Cn3Torus.sqNormEdge n mu) := by
            exact Real.exp_le_exp.mpr hexp
      _ = Real.exp (-((dim n : ℝ) / 2)) * g mu := by
            simp [g, sub_eq_add_neg, Real.exp_add]
  have hpoint_ae :
      ∀ᵐ mu : Cn3Torus.Edge n → ℝ ∂(MeasureTheory.volume.restrict A),
        f mu ≤ Real.exp (-((dim n : ℝ) / 2)) * g mu := by
    have hmeas :
        MeasurableSet
          {mu : Cn3Torus.Edge n → ℝ |
            f mu ≤ Real.exp (-((dim n : ℝ) / 2)) * g mu} := by
      exact measurableSet_le (((Cn3Torus.continuous_psi n).norm.pow (4 * t)).measurable)
        ((continuous_const.mul <|
          Real.continuous_exp.comp ((continuous_const.mul (Cn3Torus.continuous_sqNormEdge n)).neg)).measurable)
    rw [MeasureTheory.ae_restrict_iff hmeas]
    exact Filter.Eventually.of_forall (fun mu hmu => hpoint mu hmu)
  have hmono :
      ∫ mu in A, f mu
        ≤ ∫ mu in A, Real.exp (-((dim n : ℝ) / 2)) * g mu := by
    exact integral_mono_ae hf hg hpoint_ae
  have hgauss_on :
      ∫ mu in A, g mu ≤ ∫ mu, g mu := by
    have hind_int : MeasureTheory.Integrable (Set.indicator A g) := by
      exact hg_int.indicator hA_meas
    have hmono_ae :
        ∀ᵐ mu : Cn3Torus.Edge n → ℝ ∂MeasureTheory.volume,
          Set.indicator A g mu ≤ g mu := by
      exact Filter.Eventually.of_forall (fun mu => by
        by_cases hmu : mu ∈ A
        · simp [Set.indicator, hmu]
        · simp [Set.indicator, hmu, hg_nonneg mu])
    have hmono' := MeasureTheory.integral_mono_ae hind_int hg_int hmono_ae
    simpa [g, hA_meas, MeasureTheory.integral_indicator] using hmono'
  have hgauss_eval : ∫ mu, g mu = (π / (t : ℝ)) ^ ((dim n : ℝ) / 2) := by
    simpa [g] using gaussian_integral_formula_edge n (t : ℝ) htR_pos
  have hsplit :
      (π / (t : ℝ)) ^ ((dim n : ℝ) / 2)
        = (2 : ℝ) ^ ((dim n : ℝ) / 2) * gaussianF (dim n) (t : ℝ) := by
    have hbase : π / (t : ℝ) = 2 * (π / (2 * (t : ℝ))) := by
      field_simp [htR_pos.ne', Real.pi_ne_zero]
    rw [hbase, Real.mul_rpow (by positivity) (by positivity)]
    simp [gaussianF, mul_comm]
  have hpow :
      (2 : ℝ) ^ ((dim n : ℝ) / 2)
        = Real.exp (((dim n : ℝ) / 2) * Real.log 2) := by
    rw [Real.rpow_def_of_pos (by norm_num : 0 < (2 : ℝ))]
    ring
  have hlog :
      ((dim n : ℝ) / 2) * Real.log 2
        ≤ ((dim n : ℝ) / 2) * (3 / 4 : ℝ) := by
    have hdim_nonneg : 0 ≤ ((dim n : ℝ) / 2) := by positivity
    exact mul_le_mul_of_nonneg_left (le_of_lt Cn3Torus.log_two_lt_three_quarters) hdim_nonneg
  have h2pow_le :
      (2 : ℝ) ^ ((dim n : ℝ) / 2)
        ≤ Real.exp (((dim n : ℝ) / 2) * (3 / 4 : ℝ)) := by
    rw [hpow]
    exact Real.exp_le_exp.mpr hlog
  have hcoeff :
      Real.exp (-((dim n : ℝ) / 2)) * (2 : ℝ) ^ ((dim n : ℝ) / 2)
        ≤ Real.exp (-((dim n : ℝ) / 8)) := by
    calc
      Real.exp (-((dim n : ℝ) / 2)) * (2 : ℝ) ^ ((dim n : ℝ) / 2)
          ≤ Real.exp (-((dim n : ℝ) / 2))
              * Real.exp (((dim n : ℝ) / 2) * (3 / 4 : ℝ)) := by
                exact mul_le_mul_of_nonneg_left h2pow_le (by positivity)
      _ = Real.exp (-((dim n : ℝ) / 8)) := by
            rw [← Real.exp_add]
            congr 1
            ring
  have hgauss_nonneg : 0 ≤ gaussianF (dim n) (t : ℝ) := by
    exact Real.rpow_nonneg (by positivity) _
  have hgauss_core :
      gaussianF (dim n) (t : ℝ) ≤ C₆ * coreMass (dim n) (t : ℝ) :=
    hcore (dim n) (t : ℝ) hd (by exact_mod_cast ht)
  calc
    ∫ mu in A, f mu
      ≤ ∫ mu in A, Real.exp (-((dim n : ℝ) / 2)) * g mu := hmono
    _ = Real.exp (-((dim n : ℝ) / 2)) * ∫ mu in A, g mu := by
          rw [MeasureTheory.integral_const_mul]
    _ ≤ Real.exp (-((dim n : ℝ) / 2)) * ∫ mu, g mu := by
          exact mul_le_mul_of_nonneg_left hgauss_on (by positivity)
    _ = Real.exp (-((dim n : ℝ) / 2)) * (π / (t : ℝ)) ^ ((dim n : ℝ) / 2) := by
          rw [hgauss_eval]
    _ = (Real.exp (-((dim n : ℝ) / 2)) * (2 : ℝ) ^ ((dim n : ℝ) / 2))
          * gaussianF (dim n) (t : ℝ) := by
            rw [hsplit]
            ring
    _ ≤ Real.exp (-((dim n : ℝ) / 8)) * gaussianF (dim n) (t : ℝ) := by
          exact mul_le_mul_of_nonneg_right hcoeff hgauss_nonneg
    _ ≤ Real.exp (-((dim n : ℝ) / 8)) * (C₆ * coreMass (dim n) (t : ℝ)) := by
          exact mul_le_mul_of_nonneg_left hgauss_core (by positivity)
    _ = C₆ * Real.exp (-((dim n : ℝ) / 8)) * coreMass (dim n) (t : ℝ) := by
          ring

/-- The tex prefactor is always nonnegative. -/
lemma texPrefactor_nonneg (n : ℕ) : 0 ≤ Cn3Torus.texPrefactor n := by
  unfold Cn3Torus.texPrefactor
  positivity [Real.pi_pos]

/-- Real parts of complex set integrals are controlled by the integral of the complex
norm difference. -/
lemma abs_integral_re_sub_le_integral_norm
    (n : ℕ)
    {s : Set (Cn3Torus.Edge n → ℝ)}
    {f g : (Cn3Torus.Edge n → ℝ) → ℂ}
    (hf : MeasureTheory.IntegrableOn f s)
    (hg : MeasureTheory.IntegrableOn g s) :
    |(∫ x in s, Complex.re (f x)) - (∫ x in s, Complex.re (g x))|
      ≤ ∫ x in s, ‖f x - g x‖ := by
  have hre_f :
      (∫ x in s, Complex.re (f x)) = Complex.re (∫ x in s, f x) := integral_re hf
  have hre_g :
      (∫ x in s, Complex.re (g x)) = Complex.re (∫ x in s, g x) := integral_re hg
  have hsub :
      ∫ x in s, (f x - g x) = (∫ x in s, f x) - ∫ x in s, g x := by
    exact MeasureTheory.integral_sub hf hg
  have hnorm :
      ‖∫ x in s, (f x - g x)‖ ≤ ∫ x in s, ‖f x - g x‖ := by
    simpa using
      (MeasureTheory.norm_integral_le_integral_norm
        (μ := MeasureTheory.volume.restrict s) (f := fun x => f x - g x))
  have hre_sub :
      (∫ x in s, Complex.re (f x)) - (∫ x in s, Complex.re (g x))
        = (∫ x in s, f x).re - (∫ x in s, g x).re := by
    have htmp :
        (∫ x in s, Complex.re (f x)) - (∫ x in s, g x).re
          = (∫ x in s, f x).re - (∫ x in s, g x).re := by
      exact congrArg (fun z : ℝ => z - (∫ x in s, g x).re) hre_f
    calc
      (∫ x in s, Complex.re (f x)) - (∫ x in s, Complex.re (g x))
        = (∫ x in s, Complex.re (f x)) - (∫ x in s, g x).re := by rw [hre_g]
      _ = (∫ x in s, f x).re - (∫ x in s, g x).re := htmp
  have hsub_re :
      ((∫ x in s, f x) - ∫ x in s, g x).re
        = (∫ x in s, f x).re - (∫ x in s, g x).re := by
    simp [Complex.sub_re]
  calc
    |(∫ x in s, Complex.re (f x)) - (∫ x in s, Complex.re (g x))|
      = |Complex.re ((∫ x in s, f x) - ∫ x in s, g x)| := by
          rw [hre_sub, hsub_re]
    _ = |Complex.re (∫ x in s, (f x - g x))| := by rw [← hsub]
    _ ≤ ‖∫ x in s, (f x - g x)‖ := Complex.abs_re_le_norm _
    _ ≤ ∫ x in s, ‖f x - g x‖ := hnorm

/-- Special case of `abs_integral_re_sub_le_integral_norm` against zero. -/
lemma abs_integral_re_le_integral_norm
    (n : ℕ)
    {s : Set (Cn3Torus.Edge n → ℝ)}
    {f : (Cn3Torus.Edge n → ℝ) → ℂ}
    (hf : MeasureTheory.IntegrableOn f s) :
    |∫ x in s, Complex.re (f x)| ≤ ∫ x in s, ‖f x‖ := by
  have hre : (∫ x in s, Complex.re (f x)) = Complex.re (∫ x in s, f x) := integral_re hf
  have hnorm :
      ‖∫ x in s, f x‖ ≤ ∫ x in s, ‖f x‖ := by
    simpa using
      (MeasureTheory.norm_integral_le_integral_norm
        (μ := MeasureTheory.volume.restrict s) (f := f))
  calc
    |∫ x in s, Complex.re (f x)| = |Complex.re (∫ x in s, f x)| := by rw [hre]
    _ ≤ ‖∫ x in s, f x‖ := Complex.abs_re_le_norm _
    _ ≤ ∫ x in s, ‖f x‖ := hnorm

set_option maxHeartbeats 800000

/-- A strict geometric decay on the far shell is negligible relative to the Gaussian
scale at the `n^3` threshold. -/
private theorem exp_neg_mul_t_le_eps_gaussianScale_uniform_ge_three
    (a ε : ℝ) (ha : 0 < a) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, 3 ≤ n →
      ∀ t : ℕ, (t : ℝ) ≥ C * ↑n ^ 3 →
        Real.exp (-a * (t : ℝ)) ≤ ε * gaussianScale n ↑t := by
  let K : ℝ := max (Real.log (1 / ε)) 0
  let A : ℝ := 128 * Real.pi / a
  let U : ℝ := max (Real.log A) (max K 1)
  let C : ℝ := (16 / a) * Real.exp U
  refine ⟨C, by
    unfold C
    positivity [ha], ?_⟩
  intro n hn t ht
  have hA_pos : 0 < A := by
    unfold A
    positivity [Real.pi_pos, ha]
  have hU_log : Real.log A ≤ U := by
    unfold U
    exact le_max_left _ _
  have hU_K : K ≤ U := by
    unfold U
    exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hU_one : (1 : ℝ) ≤ U := by
    unfold U
    exact le_trans (le_max_right _ _) (le_max_right _ _)
  have hC_pos : 0 < C := by
    unfold C
    positivity [ha]
  have hC_ge_sixteen : 16 / a ≤ C := by
    have hexp_one : (1 : ℝ) ≤ Real.exp U := by
      have h0U : 0 ≤ U := by linarith
      have := Real.one_le_exp_iff.mpr h0U
      simpa using this
    calc
      16 / a = (16 / a) * 1 := by ring
      _ ≤ (16 / a) * Real.exp U := by
            gcongr
      _ = C := by
            unfold C
            ring
  have hU_le_scaledC : U ≤ (a / 16) * C := by
    have hU_le_exp : U ≤ Real.exp U := by
      have haux := Real.add_one_le_exp U
      linarith
    have hfac : (a / 16) * C = Real.exp U := by
      unfold C
      field_simp [ha.ne']
    rw [hfac]
    exact hU_le_exp
  have hn_pos : 0 < n := by omega
  have hnR_pos : (0 : ℝ) < n := by exact_mod_cast hn_pos
  have hn_log : Real.log n < (n : ℝ) / 2 := Cn3Torus.log_nat_lt_half n hn
  have hcube_threshold : C * (n : ℝ) ^ (3 : Nat) ≤ (t : ℝ) := by
    simpa using ht
  have ht_pos : (0 : ℝ) < (t : ℝ) := by
    have : 0 < C * (n : ℝ) ^ (3 : Nat) := by positivity [hC_pos, hnR_pos]
    linarith
  have hC_le_t : C ≤ (t : ℝ) := by
    have hn_cube_ge_one : (1 : ℝ) ≤ (n : ℝ) ^ (3 : Nat) := by
      calc
        (1 : ℝ) = (1 : ℝ) ^ (3 : Nat) := by norm_num
        _ ≤ (n : ℝ) ^ (3 : Nat) := by
            gcongr
            exact_mod_cast (show (1 : ℕ) ≤ n by omega)
    have htmp : C * 1 ≤ C * (n : ℝ) ^ (3 : Nat) := by
      exact mul_le_mul_of_nonneg_left hn_cube_ge_one hC_pos.le
    linarith
  set u : ℝ := (t : ℝ) / (C * (n : ℝ) ^ (3 : Nat))
  have hu_pos : 0 < u := by
    unfold u
    positivity [hC_pos, hnR_pos, ht_pos]
  have hu_ge_one : 1 ≤ u := by
    unfold u
    have hdiv :
        C * (n : ℝ) ^ (3 : Nat) / (C * (n : ℝ) ^ (3 : Nat))
          ≤ (t : ℝ) / (C * (n : ℝ) ^ (3 : Nat)) := by
      exact div_le_div_of_nonneg_right hcube_threshold (by positivity [hC_pos, hnR_pos])
    simpa [hC_pos.ne', hnR_pos.ne'] using hdiv
  have hlogu : Real.log u ≤ u := by
    have hlogu' : Real.log u ≤ u - 1 := Real.log_le_sub_one_of_pos hu_pos
    linarith
  have hlogt :
      Real.log (8 * Real.pi * (t : ℝ))
        = Real.log (8 * Real.pi * C) + 3 * Real.log n + Real.log u := by
    have hdecomp : 8 * Real.pi * (t : ℝ) = (8 * Real.pi * C) * ((n : ℝ) ^ (3 : Nat)) * u := by
      unfold u
      field_simp [hC_pos.ne', hnR_pos.ne']
    rw [hdecomp]
    rw [show (8 * Real.pi * C * (n : ℝ) ^ (3 : Nat) * u)
          = (8 * Real.pi * C) * (((n : ℝ) ^ (3 : Nat)) * u) by ring]
    rw [Real.log_mul (show (8 * Real.pi * C) ≠ 0 by positivity [Real.pi_pos, hC_pos])
      (show (((n : ℝ) ^ (3 : Nat)) * u) ≠ 0 by positivity [hnR_pos, hu_pos])]
    rw [Real.log_mul (show ((n : ℝ) ^ (3 : Nat)) ≠ 0 by positivity [hnR_pos]) hu_pos.ne']
    have hlogpow : Real.log ((n : ℝ) ^ (3 : Nat)) = 3 * Real.log n := by
      have hpow := Real.log_rpow hnR_pos (3 : ℝ)
      simpa using hpow
    rw [hlogpow]
    ring_nf
  have hlogC_eq : Real.log (8 * Real.pi * C) = Real.log A + U := by
    have hrewrite : 8 * Real.pi * C = A * Real.exp U := by
      unfold A C
      field_simp [ha.ne']
      ring
    rw [hrewrite, Real.log_mul (show A ≠ 0 by positivity [Real.pi_pos, ha]) (show Real.exp U ≠ 0 by positivity),
      Real.log_exp]
  have hlogC_le : Real.log (8 * Real.pi * C) ≤ 2 * U := by
    rw [hlogC_eq]
    nlinarith
  have hdim_term :
      ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C) ≤ a * (t : ℝ) / 48 := by
    have hU_nonneg : 0 ≤ U := by linarith [hU_one]
    have h1 :
        ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C) ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (2 * U) := by
      have hdim_nonneg : 0 ≤ ((dim n : ℝ) / 2) := by positivity
      calc
        ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
            ≤ ((dim n : ℝ) / 2) * (2 * U) := by
                exact mul_le_mul_of_nonneg_left hlogC_le hdim_nonneg
        _ ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (2 * U) := by
              gcongr
              exact dim_le_sq n
    have h2 : ((n : ℝ) ^ (2 : Nat) / 2) * (2 * U) = (n : ℝ) ^ (2 : Nat) * U := by ring
    have h3 : (n : ℝ) ^ (2 : Nat) * U ≤ ((n : ℝ) ^ (3 : Nat) / 3) * U := by
      have hn_three : (3 : ℝ) ≤ n := by exact_mod_cast hn
      have hpow :
          (n : ℝ) ^ (2 : Nat) ≤ (n : ℝ) ^ (3 : Nat) / 3 := by
        nlinarith [hn_three]
      exact mul_le_mul_of_nonneg_right hpow hU_nonneg
    have h4 : ((n : ℝ) ^ (3 : Nat) / 3) * U ≤ ((n : ℝ) ^ (3 : Nat) / 3) * ((a / 16) * C) := by
      gcongr
    have h5 : ((n : ℝ) ^ (3 : Nat) / 3) * ((a / 16) * C) = a * (C * (n : ℝ) ^ (3 : Nat)) / 48 := by
      ring
    calc
      ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
          ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (2 * U) := h1
      _ = (n : ℝ) ^ (2 : Nat) * U := h2
      _ ≤ ((n : ℝ) ^ (3 : Nat) / 3) * U := h3
      _ ≤ ((n : ℝ) ^ (3 : Nat) / 3) * ((a / 16) * C) := h4
      _ = a * (C * (n : ℝ) ^ (3 : Nat)) / 48 := h5
      _ ≤ a * (t : ℝ) / 48 := by gcongr
  have hlogn_term :
      ((dim n : ℝ) / 2) * (3 * Real.log n) ≤ 3 * a * (t : ℝ) / 64 := by
    have h1 :
        ((dim n : ℝ) / 2) * (3 * Real.log n) ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (3 * Real.log n) := by
      gcongr
      exact dim_le_sq n
    have h2 : ((n : ℝ) ^ (2 : Nat) / 2) * (3 * Real.log n) ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (3 * ((n : ℝ) / 2)) := by
      have hlogn_le : Real.log n ≤ (n : ℝ) / 2 := le_of_lt hn_log
      gcongr
    have h3 : ((n : ℝ) ^ (2 : Nat) / 2) * (3 * ((n : ℝ) / 2)) = (3 / 4 : ℝ) * (n : ℝ) ^ (3 : Nat) := by
      ring
    have h4 : (3 / 4 : ℝ) * (n : ℝ) ^ (3 : Nat) ≤ (3 / 4 : ℝ) * ((t : ℝ) / C) := by
      have htmp : (n : ℝ) ^ (3 : Nat) ≤ (t : ℝ) / C := by
        have htmp' : C * (n : ℝ) ^ (3 : Nat) ≤ (t : ℝ) := hcube_threshold
        rw [mul_comm] at htmp'
        exact (le_div_iff₀ hC_pos).2 htmp'
      gcongr
    have h5 : (3 / 4 : ℝ) * ((t : ℝ) / C) ≤ 3 * a * (t : ℝ) / 64 := by
      have hCbound : 3 / (4 * C) ≤ 3 * a / 64 := by
        have hInv : 1 / C ≤ a / 16 := by
          simpa [one_div, div_eq_mul_inv, ha.ne'] using
            (one_div_le_one_div_of_le (by positivity : (0 : ℝ) < 16 / a) hC_ge_sixteen)
        calc
          3 / (4 * C) = (3 / 4 : ℝ) * (1 / C) := by
                field_simp [hC_pos.ne']
          _ ≤ (3 / 4 : ℝ) * (a / 16) := by
                gcongr
          _ = 3 * a / 64 := by ring
      calc
        (3 / 4 : ℝ) * ((t : ℝ) / C) = (3 / (4 * C)) * (t : ℝ) := by
              field_simp [hC_pos.ne']
        _ ≤ (3 * a / 64) * (t : ℝ) := by
              exact mul_le_mul_of_nonneg_right hCbound (by positivity)
        _ = 3 * a * (t : ℝ) / 64 := by ring
    exact le_trans h1 (le_trans h2 (le_trans (by rw [h3]) (le_trans h4 h5)))
  have hlogu_term :
      ((dim n : ℝ) / 2) * Real.log u ≤ a * (t : ℝ) / 96 := by
    have h1 : ((dim n : ℝ) / 2) * Real.log u ≤ ((n : ℝ) ^ (2 : Nat) / 2) * u := by
      have hdim_nonneg : 0 ≤ ((dim n : ℝ) / 2) := by positivity
      calc
        ((dim n : ℝ) / 2) * Real.log u ≤ ((dim n : ℝ) / 2) * u := by
          exact mul_le_mul_of_nonneg_left hlogu hdim_nonneg
        _ ≤ ((n : ℝ) ^ (2 : Nat) / 2) * u := by
          gcongr
          exact dim_le_sq n
    have h2 : ((n : ℝ) ^ (2 : Nat) / 2) * u = (t : ℝ) / (2 * C * n) := by
      unfold u
      field_simp [hC_pos.ne', hnR_pos.ne']
    have h3 : (t : ℝ) / (2 * C * n) ≤ (t : ℝ) / (6 * C) := by
      have hn_three : (3 : ℝ) ≤ n := by exact_mod_cast hn
      field_simp [hC_pos.ne', hnR_pos.ne']
      nlinarith
    have h4 : (t : ℝ) / (6 * C) ≤ a * (t : ℝ) / 96 := by
      have htmp : 16 / a ≤ C := hC_ge_sixteen
      field_simp [ha.ne', hC_pos.ne']
      nlinarith
    exact le_trans h1 (le_trans (by rw [h2]) (le_trans h3 h4))
  have hK_term : K ≤ a * (t : ℝ) / 16 := by
    have h1 : K ≤ U := hU_K
    have h2 : U ≤ (a / 16) * C := hU_le_scaledC
    have h3 : (a / 16) * C ≤ a * (t : ℝ) / 16 := by
      nlinarith [hC_le_t]
    exact le_trans h1 (le_trans h2 h3)
  have hmain :
      K + ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ)) ≤ a * (t : ℝ) := by
    rw [hlogt]
    have hsplit :
        K + ((dim n : ℝ) / 2) * (Real.log (8 * Real.pi * C) + 3 * Real.log n + Real.log u)
          = K
              + ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
              + ((dim n : ℝ) / 2) * (3 * Real.log n)
              + ((dim n : ℝ) / 2) * Real.log u := by
      ring
    rw [hsplit]
    nlinarith [hK_term, hdim_term, hlogn_term, hlogu_term]
  have hneg :
      -a * (t : ℝ)
        ≤ -K - ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ)) := by
    nlinarith [hmain]
  have hmain_exp :
      Real.exp (-a * (t : ℝ))
        ≤ Real.exp (-K) * (8 * Real.pi * (t : ℝ)) ^ (-((dim n : ℝ) / 2)) := by
    calc
      Real.exp (-a * (t : ℝ))
          ≤ Real.exp (-K - ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))) := by
              exact Real.exp_le_exp.mpr hneg
      _ = Real.exp (-K) * (8 * Real.pi * (t : ℝ)) ^ (-((dim n : ℝ) / 2)) := by
            rw [show -K - ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))
                    = (-K) + (-((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))) by ring,
              Real.exp_add]
            congr 1
            rw [Real.rpow_def_of_pos (by positivity [Real.pi_pos, ht_pos])]
            ring_nf
  have hexpK : Real.exp (-K) ≤ ε := by
    have hK_ge : Real.log (1 / ε) ≤ K := by
      unfold K
      exact le_max_left _ _
    have hnegK : -K ≤ -Real.log (1 / ε) := by linarith
    calc
      Real.exp (-K) ≤ Real.exp (-Real.log (1 / ε)) := Real.exp_le_exp.mpr hnegK
      _ = ε := by
            rw [Real.exp_neg, Real.exp_log (one_div_pos.mpr hε)]
            field_simp [hε.ne']
  have htoScale : (8 * Real.pi * (t : ℝ)) ^ (-((Cn3Torus.d n : ℝ) / 2)) ≤ gaussianScale n ↑t := by
    unfold gaussianScale dim
    have hsub : n ≤ 2 * Nat.choose n 2 := Cn3Torus.n_le_two_mul_d n hn
    have hExp : ((2 * Nat.choose n 2 - n + 1 : Nat) : ℤ) = (2 * ↑(Nat.choose n 2) - ↑n + 1 : ℤ) := by
      rw [Nat.cast_add, Nat.cast_sub hsub, Nat.cast_one]
      norm_num
    have hcoeff_ge_one_nat : (1 : ℝ) ≤ (2 : ℝ) ^ (2 * Nat.choose n 2 - n + 1 : Nat) := by
      exact one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2)
    have hcoeff_ge_one : (1 : ℝ) ≤ (2 ^ (2 * Nat.choose n 2 - n + 1 : ℤ) : ℝ) := by
      rw [← hExp, zpow_natCast]
      simpa using hcoeff_ge_one_nat
    have hbase_nonneg_arg : 0 ≤ 8 * Real.pi * (t : ℝ) := by positivity [Real.pi_pos, ht_pos]
    have hbase_nonneg : 0 ≤ (8 * Real.pi * (t : ℝ)) ^ (-((Nat.choose n 2 : ℝ) / 2)) := by
      exact Real.rpow_nonneg hbase_nonneg_arg _
    have hmul :
        (8 * Real.pi * (t : ℝ)) ^ (-((Nat.choose n 2 : ℝ) / 2))
          ≤ (2 ^ (2 * Nat.choose n 2 - n + 1 : ℤ) : ℝ)
              * (8 * Real.pi * (t : ℝ)) ^ (-((Nat.choose n 2 : ℝ) / 2)) := by
      nlinarith
    have hrew : -((Nat.choose n 2 : ℝ) / 2) = -(↑(Nat.choose n 2)) / 2 := by ring
    simpa [hrew, Cn3Torus.d, mul_assoc, mul_left_comm, mul_comm] using hmul
  calc
    Real.exp (-a * (t : ℝ))
      ≤ Real.exp (-K) * (8 * Real.pi * (t : ℝ)) ^ (-((dim n : ℝ) / 2)) := hmain_exp
    _ ≤ ε * (8 * Real.pi * (t : ℝ)) ^ (-((dim n : ℝ) / 2)) := by
          exact mul_le_mul_of_nonneg_right hexpK (by positivity)
    _ ≤ ε * gaussianScale n ↑t := by
          exact mul_le_mul_of_nonneg_left htoScale hε.le

/-- A quantitative version of `exp_neg_mul_t_le_eps_gaussianScale_uniform_ge_three`
with an explicit `exp(-c n^2)` factor on the Gaussian scale. -/
theorem exp_neg_mul_t_le_exp_neg_nsq_mul_gaussianScale_uniform_ge_three
    (a : ℝ) (ha : 0 < a) :
    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧
      ∀ n : ℕ, 3 ≤ n →
      ∀ t : ℕ, (t : ℝ) ≥ C * ↑n ^ 3 →
        Real.exp (-a * (t : ℝ))
          ≤ Real.exp (-(c * (n : ℝ) ^ (2 : Nat))) * gaussianScale n ↑t := by
  let A : ℝ := 128 * Real.pi / a
  let U : ℝ := max (Real.log A) 1
  let C : ℝ := (16 / a) * Real.exp U
  let c : ℝ := a * C / 64
  refine ⟨c, C, ?_, ?_, ?_⟩
  · unfold c C
    positivity [ha]
  · unfold C
    positivity [ha]
  · intro n hn t ht
    have hA_pos : 0 < A := by
      unfold A
      positivity [Real.pi_pos, ha]
    have hU_log : Real.log A ≤ U := by
      unfold U
      exact le_max_left _ _
    have hU_one : (1 : ℝ) ≤ U := by
      unfold U
      exact le_max_right _ _
    have hC_pos : 0 < C := by
      unfold C
      positivity [ha]
    have hC_ge_sixteen : 16 / a ≤ C := by
      have hexp_one : (1 : ℝ) ≤ Real.exp U := by
        have h0U : 0 ≤ U := by linarith
        have := Real.one_le_exp_iff.mpr h0U
        simpa using this
      calc
        16 / a = (16 / a) * 1 := by ring
        _ ≤ (16 / a) * Real.exp U := by
              gcongr
        _ = C := by
              unfold C
              ring
    have hU_le_scaledC : U ≤ (a / 16) * C := by
      have hU_le_exp : U ≤ Real.exp U := by
        have haux := Real.add_one_le_exp U
        linarith
      have hfac : (a / 16) * C = Real.exp U := by
        unfold C
        field_simp [ha.ne']
      rw [hfac]
      exact hU_le_exp
    have hn_pos : 0 < n := by omega
    have hnR_pos : (0 : ℝ) < n := by exact_mod_cast hn_pos
    have hn_log : Real.log n < (n : ℝ) / 2 := Cn3Torus.log_nat_lt_half n hn
    have hn_three : (3 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    have hcube_threshold : C * (n : ℝ) ^ (3 : Nat) ≤ (t : ℝ) := by
      simpa [C] using ht
    have ht_pos : (0 : ℝ) < (t : ℝ) := by
      have : 0 < C * (n : ℝ) ^ (3 : Nat) := by positivity [hC_pos, hnR_pos]
      linarith
    set u : ℝ := (t : ℝ) / (C * (n : ℝ) ^ (3 : Nat))
    have hu_pos : 0 < u := by
      unfold u
      positivity [hC_pos, hnR_pos, ht_pos]
    have hu_ge_one : 1 ≤ u := by
      unfold u
      have hdiv :
          C * (n : ℝ) ^ (3 : Nat) / (C * (n : ℝ) ^ (3 : Nat))
            ≤ (t : ℝ) / (C * (n : ℝ) ^ (3 : Nat)) := by
        exact div_le_div_of_nonneg_right hcube_threshold (by positivity [hC_pos, hnR_pos])
      simpa [hC_pos.ne', hnR_pos.ne'] using hdiv
    have hlogu : Real.log u ≤ u := by
      have hlogu' : Real.log u ≤ u - 1 := Real.log_le_sub_one_of_pos hu_pos
      linarith
    have hlogt :
        Real.log (8 * Real.pi * (t : ℝ))
          = Real.log (8 * Real.pi * C) + 3 * Real.log n + Real.log u := by
      have hdecomp : 8 * Real.pi * (t : ℝ) = (8 * Real.pi * C) * ((n : ℝ) ^ (3 : Nat)) * u := by
        unfold u
        field_simp [hC_pos.ne', hnR_pos.ne']
      rw [hdecomp]
      rw [show (8 * Real.pi * C * (n : ℝ) ^ (3 : Nat) * u)
            = (8 * Real.pi * C) * (((n : ℝ) ^ (3 : Nat)) * u) by ring]
      rw [Real.log_mul (show (8 * Real.pi * C) ≠ 0 by positivity [Real.pi_pos, hC_pos])
        (show (((n : ℝ) ^ (3 : Nat)) * u) ≠ 0 by positivity [hnR_pos, hu_pos])]
      rw [Real.log_mul (show ((n : ℝ) ^ (3 : Nat)) ≠ 0 by positivity [hnR_pos]) hu_pos.ne']
      have hlogpow : Real.log ((n : ℝ) ^ (3 : Nat)) = 3 * Real.log n := by
        have hpow := Real.log_rpow hnR_pos (3 : ℝ)
        simpa using hpow
      rw [hlogpow]
      ring_nf
    have hlogC_eq : Real.log (8 * Real.pi * C) = Real.log A + U := by
      have hrewrite : 8 * Real.pi * C = A * Real.exp U := by
        unfold A C
        field_simp [ha.ne']
        ring
      rw [hrewrite, Real.log_mul (show A ≠ 0 by positivity [Real.pi_pos, ha])
        (show Real.exp U ≠ 0 by positivity), Real.log_exp]
    have hlogC_le : Real.log (8 * Real.pi * C) ≤ 2 * U := by
      rw [hlogC_eq]
      nlinarith
    have hdim_term :
        ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C) ≤ a * (t : ℝ) / 48 := by
      have hU_nonneg : 0 ≤ U := by linarith [hU_one]
      have h1 :
          ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C) ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (2 * U) := by
        have hdim_nonneg : 0 ≤ ((dim n : ℝ) / 2) := by positivity
        calc
          ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
              ≤ ((dim n : ℝ) / 2) * (2 * U) := by
                  exact mul_le_mul_of_nonneg_left hlogC_le hdim_nonneg
          _ ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (2 * U) := by
                gcongr
                exact dim_le_sq n
      have h2 : ((n : ℝ) ^ (2 : Nat) / 2) * (2 * U) = (n : ℝ) ^ (2 : Nat) * U := by ring
      have h3 : (n : ℝ) ^ (2 : Nat) * U ≤ ((n : ℝ) ^ (3 : Nat) / 3) * U := by
        have hpow :
            (n : ℝ) ^ (2 : Nat) ≤ (n : ℝ) ^ (3 : Nat) / 3 := by
          nlinarith [hn_three]
        exact mul_le_mul_of_nonneg_right hpow hU_nonneg
      have h4 : ((n : ℝ) ^ (3 : Nat) / 3) * U ≤ ((n : ℝ) ^ (3 : Nat) / 3) * ((a / 16) * C) := by
        gcongr
      have h5 : ((n : ℝ) ^ (3 : Nat) / 3) * ((a / 16) * C) = a * (C * (n : ℝ) ^ (3 : Nat)) / 48 := by
        ring
      calc
        ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
            ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (2 * U) := h1
        _ = (n : ℝ) ^ (2 : Nat) * U := h2
        _ ≤ ((n : ℝ) ^ (3 : Nat) / 3) * U := h3
        _ ≤ ((n : ℝ) ^ (3 : Nat) / 3) * ((a / 16) * C) := h4
        _ = a * (C * (n : ℝ) ^ (3 : Nat)) / 48 := h5
        _ ≤ a * (t : ℝ) / 48 := by gcongr
    have hlogn_term :
        ((dim n : ℝ) / 2) * (3 * Real.log n) ≤ 3 * a * (t : ℝ) / 64 := by
      have h1 :
          ((dim n : ℝ) / 2) * (3 * Real.log n) ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (3 * Real.log n) := by
        gcongr
        exact dim_le_sq n
      have h2 : ((n : ℝ) ^ (2 : Nat) / 2) * (3 * Real.log n) ≤ ((n : ℝ) ^ (2 : Nat) / 2) * (3 * ((n : ℝ) / 2)) := by
        have hlogn_le : Real.log n ≤ (n : ℝ) / 2 := le_of_lt hn_log
        gcongr
      have h3 : ((n : ℝ) ^ (2 : Nat) / 2) * (3 * ((n : ℝ) / 2)) = (3 / 4 : ℝ) * (n : ℝ) ^ (3 : Nat) := by
        ring
      have h4 : (3 / 4 : ℝ) * (n : ℝ) ^ (3 : Nat) ≤ (3 / 4 : ℝ) * ((t : ℝ) / C) := by
        have htmp : (n : ℝ) ^ (3 : Nat) ≤ (t : ℝ) / C := by
          have htmp' : C * (n : ℝ) ^ (3 : Nat) ≤ (t : ℝ) := hcube_threshold
          rw [mul_comm] at htmp'
          exact (le_div_iff₀ hC_pos).2 htmp'
        gcongr
      have h5 : (3 / 4 : ℝ) * ((t : ℝ) / C) ≤ 3 * a * (t : ℝ) / 64 := by
        have hCbound : 3 / (4 * C) ≤ 3 * a / 64 := by
          have hInv : 1 / C ≤ a / 16 := by
            simpa [one_div, div_eq_mul_inv, ha.ne'] using
              (one_div_le_one_div_of_le (by positivity : (0 : ℝ) < 16 / a) hC_ge_sixteen)
          calc
            3 / (4 * C) = (3 / 4 : ℝ) * (1 / C) := by
                  field_simp [hC_pos.ne']
            _ ≤ (3 / 4 : ℝ) * (a / 16) := by
                  gcongr
            _ = 3 * a / 64 := by ring
        calc
          (3 / 4 : ℝ) * ((t : ℝ) / C) = (3 / (4 * C)) * (t : ℝ) := by
                field_simp [hC_pos.ne']
          _ ≤ (3 * a / 64) * (t : ℝ) := by
                exact mul_le_mul_of_nonneg_right hCbound (by positivity)
          _ = 3 * a * (t : ℝ) / 64 := by ring
      exact le_trans h1 (le_trans h2 (le_trans (by rw [h3]) (le_trans h4 h5)))
    have hlogu_term :
        ((dim n : ℝ) / 2) * Real.log u ≤ a * (t : ℝ) / 96 := by
      have h1 : ((dim n : ℝ) / 2) * Real.log u ≤ ((n : ℝ) ^ (2 : Nat) / 2) * u := by
        have hdim_nonneg : 0 ≤ ((dim n : ℝ) / 2) := by positivity
        calc
          ((dim n : ℝ) / 2) * Real.log u ≤ ((dim n : ℝ) / 2) * u := by
            exact mul_le_mul_of_nonneg_left hlogu hdim_nonneg
          _ ≤ ((n : ℝ) ^ (2 : Nat) / 2) * u := by
            gcongr
            exact dim_le_sq n
      have h2 : ((n : ℝ) ^ (2 : Nat) / 2) * u = (t : ℝ) / (2 * C * n) := by
        unfold u
        field_simp [hC_pos.ne', hnR_pos.ne']
      have h3 : (t : ℝ) / (2 * C * n) ≤ (t : ℝ) / (6 * C) := by
        field_simp [hC_pos.ne', hnR_pos.ne']
        nlinarith
      have h4 : (t : ℝ) / (6 * C) ≤ a * (t : ℝ) / 96 := by
        have htmp : 16 / a ≤ C := hC_ge_sixteen
        field_simp [ha.ne', hC_pos.ne']
        nlinarith
      exact le_trans h1 (le_trans (by rw [h2]) (le_trans h3 h4))
    have hsq_term :
        c * (n : ℝ) ^ (2 : Nat) ≤ a * (t : ℝ) / 192 := by
      have hCn2 : C * (n : ℝ) ^ (2 : Nat) ≤ (t : ℝ) / 3 := by
        nlinarith [hcube_threshold, hn_three]
      have hc_eq : c * (n : ℝ) ^ (2 : Nat) = (a / 64) * (C * (n : ℝ) ^ (2 : Nat)) := by
        unfold c
        ring
      rw [hc_eq]
      calc
        (a / 64) * (C * (n : ℝ) ^ (2 : Nat))
          ≤ (a / 64) * ((t : ℝ) / 3) := by
              gcongr
        _ = a * (t : ℝ) / 192 := by ring
    have hmain :
        c * (n : ℝ) ^ (2 : Nat)
          + ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))
          ≤ a * (t : ℝ) := by
      rw [hlogt]
      have hsplit :
          c * (n : ℝ) ^ (2 : Nat)
            + ((dim n : ℝ) / 2) * (Real.log (8 * Real.pi * C) + 3 * Real.log n + Real.log u)
            = c * (n : ℝ) ^ (2 : Nat)
                + ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * C)
                + ((dim n : ℝ) / 2) * (3 * Real.log n)
                + ((dim n : ℝ) / 2) * Real.log u := by
        ring
      rw [hsplit]
      nlinarith [hsq_term, hdim_term, hlogn_term, hlogu_term]
    have hneg :
        -a * (t : ℝ)
          ≤ -(c * (n : ℝ) ^ (2 : Nat))
              - ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ)) := by
      nlinarith [hmain]
    have hmain_exp :
        Real.exp (-a * (t : ℝ))
          ≤ Real.exp (-(c * (n : ℝ) ^ (2 : Nat)))
              * (8 * Real.pi * (t : ℝ)) ^ (-((dim n : ℝ) / 2)) := by
      calc
        Real.exp (-a * (t : ℝ))
            ≤ Real.exp (-(c * (n : ℝ) ^ (2 : Nat))
                - ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))) := by
                  exact Real.exp_le_exp.mpr hneg
        _ = Real.exp (-(c * (n : ℝ) ^ (2 : Nat)))
              * (8 * Real.pi * (t : ℝ)) ^ (-((dim n : ℝ) / 2)) := by
              rw [show -(c * (n : ℝ) ^ (2 : Nat))
                      - ((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))
                      = (-(c * (n : ℝ) ^ (2 : Nat)))
                          + (-((dim n : ℝ) / 2) * Real.log (8 * Real.pi * (t : ℝ))) by ring,
                Real.exp_add]
              congr 1
              rw [Real.rpow_def_of_pos (by positivity [Real.pi_pos, ht_pos])]
              ring_nf
    have htoScale : (8 * Real.pi * (t : ℝ)) ^ (-((Cn3Torus.d n : ℝ) / 2)) ≤ gaussianScale n ↑t := by
      unfold gaussianScale dim
      have hsub : n ≤ 2 * Nat.choose n 2 := Cn3Torus.n_le_two_mul_d n hn
      have hExp : ((2 * Nat.choose n 2 - n + 1 : Nat) : ℤ) = (2 * ↑(Nat.choose n 2) - ↑n + 1 : ℤ) := by
        rw [Nat.cast_add, Nat.cast_sub hsub, Nat.cast_one]
        norm_num
      have hcoeff_ge_one_nat : (1 : ℝ) ≤ (2 : ℝ) ^ (2 * Nat.choose n 2 - n + 1 : Nat) := by
        exact one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2)
      have hcoeff_ge_one : (1 : ℝ) ≤ (2 ^ (2 * Nat.choose n 2 - n + 1 : ℤ) : ℝ) := by
        rw [← hExp, zpow_natCast]
        simpa using hcoeff_ge_one_nat
      have hbase_nonneg_arg : 0 ≤ 8 * Real.pi * (t : ℝ) := by positivity [Real.pi_pos, ht_pos]
      have hbase_nonneg : 0 ≤ (8 * Real.pi * (t : ℝ)) ^ (-((Nat.choose n 2 : ℝ) / 2)) := by
        exact Real.rpow_nonneg hbase_nonneg_arg _
      have hmul :
          (8 * Real.pi * (t : ℝ)) ^ (-((Nat.choose n 2 : ℝ) / 2))
            ≤ (2 ^ (2 * Nat.choose n 2 - n + 1 : ℤ) : ℝ)
                * (8 * Real.pi * (t : ℝ)) ^ (-((Nat.choose n 2 : ℝ) / 2)) := by
        nlinarith
      have hrew : -((Nat.choose n 2 : ℝ) / 2) = -(↑(Nat.choose n 2)) / 2 := by ring
      simpa [hrew, Cn3Torus.d, mul_assoc, mul_left_comm, mul_comm] using hmul
    calc
      Real.exp (-a * (t : ℝ))
        ≤ Real.exp (-(c * (n : ℝ) ^ (2 : Nat)))
            * (8 * Real.pi * (t : ℝ)) ^ (-((dim n : ℝ) / 2)) := hmain_exp
      _ ≤ Real.exp (-(c * (n : ℝ) ^ (2 : Nat))) * gaussianScale n ↑t := by
            exact mul_le_mul_of_nonneg_left htoScale (by positivity)

/-- A strict geometric decay on the far shell is bounded by an explicit
`exp(-c n^2)` multiple of the Gaussian scale at the `n^3` threshold. -/
lemma qpow_le_exp_neg_nsq_mul_gaussianScale_uniform_ge_three
    (q : ℝ) (hq_pos : 0 < q) (hq_lt : q < 1) :
    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧ ∀ n : ℕ, 3 ≤ n →
      ∀ t : ℕ, (t : ℝ) ≥ C * ↑n ^ 3 →
        q ^ (4 * t) ≤ Real.exp (-(c * (n : ℝ) ^ (2 : Nat))) * gaussianScale n ↑t := by
  have ha : 0 < -4 * Real.log q := by
    have hlog : Real.log q < 0 := Real.log_neg hq_pos hq_lt
    nlinarith
  obtain ⟨c, C, hc_pos, hC_pos, hmain⟩ :=
    exp_neg_mul_t_le_exp_neg_nsq_mul_gaussianScale_uniform_ge_three (-4 * Real.log q) ha
  refine ⟨c, C, hc_pos, hC_pos, ?_⟩
  intro n hn t ht
  have hpow :
      q ^ (4 * t) = Real.exp (-(-4 * Real.log q) * (t : ℝ)) := by
    rw [show -(-4 * Real.log q) * (t : ℝ) = ((4 * t : ℕ) : ℝ) * Real.log q by
          norm_num
          ring]
    symm
    rw [Real.exp_nat_mul]
    simp [Real.exp_log hq_pos]
  simpa [hpow] using hmain n hn t ht

/-- A stretched-exponential far-shell term with exponent `t / n^(2/3)` is still
negligible relative to the Gaussian scale at the `n^3` threshold, uniformly for
all `n ≥ 3`. -/
private theorem exp_neg_mul_t_div_n_two_thirds_le_eps_gaussianScale_uniform_ge_three
    (a ε : ℝ) (ha : 0 < a) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, 3 ≤ n →
      ∀ t : ℕ, (t : ℝ) ≥ C * ↑n ^ 3 →
        Real.exp (-(a * (t : ℝ) / ((n : ℝ) ^ (2 / 3 : ℝ))))
          ≤ ε * gaussianScale n ↑t := by
  let K : ℝ := max (Real.log (1 / ε)) 0
  let A : ℝ := 128 * Real.pi / a
  let U : ℝ := max (Real.log A) (max K 1)
  let C : ℝ := (16 / a) * Real.exp U
  refine ⟨C, by
    unfold C
    positivity [ha], ?_⟩
  intro n hn t ht
  have hA_pos : 0 < A := by
    unfold A
    positivity [Real.pi_pos, ha]
  have hU_log : Real.log A ≤ U := by
    unfold U
    exact le_max_left _ _
  have hU_K : K ≤ U := by
    unfold U
    exact le_trans (le_max_left _ _) (le_max_right _ _)
  have hU_one : (1 : ℝ) ≤ U := by
    unfold U
    exact le_trans (le_max_right _ _) (le_max_right _ _)
  have hC_pos : 0 < C := by
    unfold C
    positivity [ha]
  have hC_ge : 16 / a ≤ C := by
    have hexp_one : (1 : ℝ) ≤ Real.exp U := by
      have h0U : 0 ≤ U := by linarith
      simpa using Real.one_le_exp_iff.mpr h0U
    calc
      16 / a = (16 / a) * 1 := by ring
      _ ≤ (16 / a) * Real.exp U := by gcongr
      _ = C := by
            unfold C
            ring
  have hU_le_scaledC : U ≤ (a / 16) * C := by
    have hU_le_exp : U ≤ Real.exp U := by
      have haux := Real.add_one_le_exp U
      linarith
    have hfac : (a / 16) * C = Real.exp U := by
      unfold C
      field_simp [ha.ne']
    rw [hfac]
    exact hU_le_exp
  have hn_pos : 0 < n := by omega
  have hnR_pos : (0 : ℝ) < n := by exact_mod_cast hn_pos
  have hn_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast (show 1 ≤ n by omega)
  have hcube_threshold : C * (n : ℝ) ^ (3 : Nat) ≤ (t : ℝ) := by
    simpa using ht
  have ht_pos : (0 : ℝ) < (t : ℝ) := by
    have : 0 < C * (n : ℝ) ^ (3 : Nat) := by positivity [hC_pos, hnR_pos]
    linarith
  set u : ℝ := (t : ℝ) / (C * (n : ℝ) ^ (3 : Nat))
  have hu_pos : 0 < u := by
    unfold u
    positivity [hC_pos, hnR_pos, ht_pos]
  have hu_ge_one : 1 ≤ u := by
    unfold u
    have hdiv :
        C * (n : ℝ) ^ (3 : Nat) / (C * (n : ℝ) ^ (3 : Nat))
          ≤ (t : ℝ) / (C * (n : ℝ) ^ (3 : Nat)) := by
      exact div_le_div_of_nonneg_right hcube_threshold (by positivity [hC_pos, hnR_pos])
    simpa [hC_pos.ne', hnR_pos.ne'] using hdiv
  have hlogu : Real.log u ≤ u := by
    have hlogu' : Real.log u ≤ u - 1 := Real.log_le_sub_one_of_pos hu_pos
    linarith
  have hlogt :
      Real.log (8 * Real.pi * (t : ℝ))
        = Real.log (8 * Real.pi * C) + 3 * Real.log n + Real.log u := by
    have hdecomp : 8 * Real.pi * (t : ℝ) = (8 * Real.pi * C) * ((n : ℝ) ^ (3 : Nat)) * u := by
      unfold u
      field_simp [hC_pos.ne', hnR_pos.ne']
    rw [hdecomp]
    rw [show (8 * Real.pi * C * (n : ℝ) ^ (3 : Nat) * u)
          = (8 * Real.pi * C) * (((n : ℝ) ^ (3 : Nat)) * u) by ring]
    rw [Real.log_mul (show (8 * Real.pi * C) ≠ 0 by positivity [Real.pi_pos, hC_pos])
      (show (((n : ℝ) ^ (3 : Nat)) * u) ≠ 0 by positivity [hnR_pos, hu_pos])]
    rw [Real.log_mul (show ((n : ℝ) ^ (3 : Nat)) ≠ 0 by positivity [hnR_pos]) hu_pos.ne']
    have hlogpow : Real.log ((n : ℝ) ^ (3 : Nat)) = 3 * Real.log n := by
      have hpow := Real.log_rpow hnR_pos (3 : ℝ)
      simpa using hpow
    rw [hlogpow]
    ring_nf
  have hlogC_eq : Real.log (8 * Real.pi * C) = Real.log A + U := by
